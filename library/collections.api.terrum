// DESIGN ONLY: API signatures with selected implementations.
using Terrum;

namespace Terrum.Collections;

// `mut` requires writable receiver/storage places. `write` on a returned view
// exposes existing element-slot authority; generic T retains its qualification.
[CollectionBuilder(typeof(ListBuilder<>))]
public mut class List<T>
    where T : [ManagedStorable], [Copy], [Sized]
{
    private mut write ManagedBuffer<T> _items;
    private mut nuint _count;
    private mut uint64 _version;
    private write AccessState _access;

    public List()
    {
        _items = ManagedBuffer<T>.CreateEmpty();
        _count = 0;
        _version = 0;
        _access = new AccessState();
    }

    public nuint Count => _count;

    public bool TryGet(nuint index, init ref<T> value)
    {
        _access.RequireRead();

        if (index >= _count)
        {
            return false;
        }

        value = _items.ReadInitialized(index);

        return true;
    }

    public mut void Add(T value)
    {
        _access.RequireWrite();

        var nextCount = _count + 1;
        var nextVersion = _version + 1;

        EnsureCapacity(nextCount);
        _items.Initialize(_count, value);
        _count = nextCount;
        _version = nextVersion;
    }

    public T this[nuint index] { get; mut set; }

    public mut void Clear();

    public mut void RemoveAt(nuint index);

    // GetWriteAccess/TryGetWriteAccess are provisional names, not settled API spelling.
    [ViewOf(Access.Write)]
    public mut ListWriteAccess<T> GetWriteAccess();

    [ViewOf(Access.Write, To = nameof(access))]
    public mut bool TryGetWriteAccess(init ref<ListWriteAccess<T>> access);

    private mut void EnsureCapacity(nuint capacity);
}

public mut unique struct ListBuilder<T>
    where T : [ManagedStorable], [Copy], [Sized]
{
    public ListBuilder(nuint capacityHint);

    public mut bool TryAdd(T value);

    public mut bool TryBuild(init ref<write List<T>> value);
}

public mut unique struct ListWriteAccess<T>
    where T : [ManagedStorable], [Copy], [Sized]
{
    // View: this result cannot escape the guard or overlap another writable extraction.
    [ViewOf(Access.Write)]
    public write Span<T> Span { get; }
}

public mut class LinkedListNode<T>
    where T : [ManagedStorable], [Copy], [Sized]
{
    private mut LinkedList<T>? _owner;
    private mut write LinkedListNode<T>? _previous;
    private mut write LinkedListNode<T>? _next;
    private mut T _value;

    public LinkedListNode(T value)
    {
        _owner = null;
        _previous = null;
        _next = null;
        _value = value;
    }

    public T Value { get; mut set; }

    // Link traversal preserves the source node's access; a readonly node
    // cannot expose writable links.
    [MatchedAccess]
    public LinkedListNode<T>? Previous { get; }

    [MatchedAccess]
    public LinkedListNode<T>? Next { get; }
}

[CollectionBuilder(typeof(LinkedListBuilder<>))]
public mut class LinkedList<T>
    where T : [ManagedStorable], [Copy], [Sized]
{
    private mut write LinkedListNode<T>? _first;
    private mut write LinkedListNode<T>? _last;
    private mut nuint _count;
    private mut uint64 _version;
    private write AccessState _access;

    public LinkedList()
    {
        _first = null;
        _last = null;
        _count = 0;
        _version = 0;
        _access = new AccessState();
    }

    public nuint Count => _count;

    // Node handles inherit list access so readonly traversal cannot mutate
    // list-owned values or structural links.
    [MatchedAccess]
    public LinkedListNode<T>? First { get; }

    [MatchedAccess]
    public LinkedListNode<T>? Last { get; }

    public mut write LinkedListNode<T> AddLast(T value);

    public mut void AddLast(write LinkedListNode<T> node);

    public mut void AddAfter(write LinkedListNode<T> anchor, write LinkedListNode<T> node);

    public mut void Remove(write LinkedListNode<T> node);

    public mut void Clear();

    public LinkedListCursor<T> GetEnumerator();
}

// Builds privately in source order with a fresh node for each accepted element.
// Failure/abandonment detaches and releases the partial chain exactly once;
// TryBuild publishes the completed list and consumes the builder's ownership.
public mut unique struct LinkedListBuilder<T>
    where T : [ManagedStorable], [Copy], [Sized]
{
    // Capacity is only a hint, not contiguous-storage or eager-node allocation.
    public LinkedListBuilder(nuint capacityHint);

    public mut bool TryAdd(T value);

    public mut bool TryBuild(init ref<write LinkedList<T>> value);
}

public mut unique struct LinkedListCursor<T>
    where T : [ManagedStorable], [Copy], [Sized]
{
    public mut bool MoveNext();

    public T Current { get; }
}

// Internal storage contracts; not user-facing collection-policy parameters.
internal mut class ManagedBuffer<T>
    where T : [ManagedStorable], [Copy], [Sized]
{
    // Each list gets fresh zero-capacity storage with write access; this is not
    // a shared readonly empty singleton that can be upgraded by assignment.
    public static write ManagedBuffer<T> CreateEmpty();

    public T ReadInitialized(nuint index);

    public mut void Initialize(nuint index, T value);
}

internal mut class AccessState
{
    public AccessState();

    public void RequireRead();

    public void RequireWrite();
}
