// DESIGN ONLY: API signatures with selected implementations. Inventory across modules.
// Loan expressions in bodies retain legacy spelling and are schematic; the
// target call-site syntax is unresolved.
using Terrum.Threading.Tasks;

namespace Terrum;

// `mut` changes a descriptor place/receiver; `write` qualifies backing access.
// A generic element qualification (such as `write C`) is preserved separately.
public interface IContiguousSequence<T>
{
    Span<T> AsSpan();
}

// Language-defined view families; representation and conditional capabilities omitted.
public struct Span<T> : IContiguousSequence<T>
{
    public nuint Length { get; }

    // The setter writes through the backing view and is available only when
    // this descriptor carries write access; it does not rebind the descriptor.
    public T this[nuint index] { get; set; }

    [MatchedAccess]
    public Span<T> Slice(nuint start, nuint length);

    // Forwards existing backing, not the descriptor's own storage. Publishing
    // this refinement through generic member contracts still needs final syntax.
    Span<T> IContiguousSequence<T>.AsSpan();
}

// LOCAL PSEUDO-CODE: the type default and conditional extensions below spell
// one opted-in family; their grammar and custom participation remain open.
// Members: char8/char16/char32 and void (recorded encoding, not a code unit).
// Every member retains validated immutable text and its backing, access, root,
// lease and lifetime. Bare TextSpan is exactly TextSpan<void>.
// family TextSpan<TCodeUnit = void> {
//     members TextSpan<void>, TextSpan<char8>, TextSpan<char16>, TextSpan<char32>;
// }
public struct TextSpan<TCodeUnit = void> : IFormattable
{
    public bool IsEmpty { get; }
    public bool EqualsOrdinal(TextSpan other);
    // Whole-view equality to one scalar, not a prefix or folded match.
    public bool EqualsOrdinal(rune other);
    public int32 CompareOrdinal(TextSpan other);

    public bool TryFormat<TWriter>(write ref<TWriter> writer, TextSpan format)
        where TWriter : ITextWriter;
}

// LOCAL PSEUDO-CODE: family-owned conditional contracts, not extension lookup.
// Only typed members implement contiguous code-unit access.
// AsSpan forgets text validity but cannot gain write access to immutable backing.
public extension TextSpan<TCodeUnit> : IContiguousSequence<TCodeUnit>
    where TCodeUnit : [TextCodeUnit]
{
    public nuint Length { get; }

    public Span<TCodeUnit> AsSpan();

    // No copy/transcode; forwards the actual encoding and all dependencies.
    public TextSpan<void> AsTextSpan();
}

// LOCAL PSEUDO-CODE: a failed mismatch produces no typed view. Successful
// projection retains validated text, access and all backing dependencies;
// only then can the caller request the typed AsSpan().
public extension TextSpan<void>
{
    public bool TryProject<TRequested>(init ref<TextSpan<TRequested>> result)
        where TRequested : [TextCodeUnit];
}

// A rune is a Unicode scalar. Target-typed 'x' produces exactly one scalar;
// char8 accepts ASCII, char16 non-surrogate BMP, char32/rune any scalar.
// There is no default character-literal type. TextTarget character fragments
// use rune and forward directly to the same writer, without temporary Text.
public struct rune : IFormattable
{
    public bool TryFormat<TWriter>(write ref<TWriter> writer, TextSpan format)
        where TWriter : ITextWriter
    {
        require format.IsEmpty;

        return writer.TryWriteScalar(this);
    }
}

public struct InlineArray<T, const nuint N>
    where T : [Sized]
{
    // A writable element loan requires writable containing storage; a
    // write-qualified element cannot bypass that place permission.
    [MatchedAccess]
    public ref<T> this[nuint index] { get; }
}

// Target sketch: own<val<Text>> owns an inline Text payload; construction,
// conversion, cleanup and lifecycle contracts remain separate.
// This sketch's backing is contiguous; the final string representation remains open.
[TextBuilder(nameof(Text.Create))]
public class Text : IFormattable
{
    public TextSpan AsSpan();

    public bool TryFormat<TWriter>(write ref<TWriter> writer, TextSpan format)
        where TWriter : ITextWriter
    {
        return AsSpan().TryFormat(mut ref writer, format);
    }

    [TextTarget(nameof(content))]
    public static own<val<Text>> Create<TContent>(TContent content)
        where TContent : IFormattable;
}

public interface ITextWriter
{
    mut bool TryWrite(TextSpan text);

    mut bool TryWriteScalar(rune value);

    mut bool TryWriteFormatted<TValue>(ref<TValue> value, TextSpan format)
        where TValue : IFormattable;
}

public static class TextFormatting
{
    [TextTarget(nameof(content))]
    public static bool TryWrite<TWriter, TContent>(write ref<TWriter> writer, TContent content)
        where TWriter : ITextWriter
        where TContent : IFormattable
    {
        return writer.TryWriteFormatted(ref content, "");
    }
}

public mut unique struct SpanTextWriter<TCodeUnit> : ITextWriter
    where TCodeUnit : [TextCodeUnit]
{
    [Captures(nameof(destination))]
    public SpanTextWriter(write Span<TCodeUnit> destination);

    public nuint Written { get; }

    public mut bool TryWrite(TextSpan text);

    // Encodes one scalar directly; on insufficient capacity writes no units.
    public mut bool TryWriteScalar(rune value);

    public mut bool TryWriteFormatted<TValue>(ref<TValue> value, TextSpan format)
        where TValue : IFormattable;
}

public enum TerminalOutput : int32
{
    Standard = 0,
    Error = 1
}

// Standard-stream conveniences and writer access; input and terminal controls omitted.
public static class Terminal
{
    [TextTarget(nameof(content))]
    public static void Write<TContent>(TContent content, TerminalOutput output = TerminalOutput.Standard)
        where TContent : IFormattable;

    [TextTarget(nameof(content))]
    public static void WriteLine<TContent>(TContent content, TerminalOutput output = TerminalOutput.Standard)
        where TContent : IFormattable;

    [TextTarget(nameof(content))]
    public static Task WriteLineAsync<TContent>(TContent content, TerminalOutput output = TerminalOutput.Standard)
        where TContent : IFormattable;

    public static write TextWriter Output { get; }

    public static write TextWriter Error { get; }
}

public mut class TextWriter : ITextWriter
{
    public mut bool TryWrite(TextSpan text);

    public mut bool TryWriteScalar(rune value);

    public mut bool TryWriteFormatted<TValue>(ref<TValue> value, TextSpan format)
        where TValue : IFormattable;

    [TextTarget(nameof(content))]
    public mut void Write<TContent>(TContent content)
        where TContent : IFormattable;

    [TextTarget(nameof(content))]
    public mut void WriteLine<TContent>(TContent content)
        where TContent : IFormattable;

    [TextTarget(nameof(content))]
    public mut Task WriteLineAsync<TContent>(TContent content)
        where TContent : IFormattable;
}
