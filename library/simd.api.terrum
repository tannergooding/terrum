// DESIGN ONLY: conceptual SIMD contracts; family/witness syntax and target ABI are open.
// SIMD members are vector values with lane/mask ABI; TensorSpan is a separate
// higher-level logical view over storage, not another SIMD representation.
namespace Terrum.Numerics;

// Generic kernels may use a named generic functor checked at its definition
// site and specialized for registered SIMD family members. A closed scalar
// func callback does not itself promise a vector implementation, and a
// contextual generic lambda must satisfy the same operation/Copy constraints.
// Elementwise effects, call counts, inactive lanes, tails and FP ordering are
// separate kernel contracts; scalar arithmetic is not auto-vectorized here.

// LOCAL PSEUDO-CODE: explicit family registration, not an interface or naming
// convention. The checker validates each concrete width, element/mask pairing,
// static member, representation and ABI. The selected witness binds the
// associated element/mask relationship; it is not inferred backward from a
// non-injective projection or from a similar type name. All TVector
// operands/results have the same instantiation; comparisons return its TMask.
// fixed_simd_family<TVector, TElement, TMask>
//     where TElement : [SimdElement], [Copy]
//     where TVector : [Copy], IAdditionOperators<TVector, TVector, TVector>
//     where TMask : [Copy]
// {
//     each T : [SimdElement], [Copy], [Sized];
//     member simd64<T>  with simd64mask<T>,  width 64;
//     member simd128<T> with simd128mask<T>, width 128;
//     member simd256<T> with simd256mask<T>, width 256;
//     member simd512<T> with simd512mask<T>, width 512;
//
//     static on TVector {
//         nuint LaneCount;
//         TVector Splat(TElement value);
//         TVector Load(Span<TElement> source);
//         TVector LoadMasked(Span<TElement> source, TMask active, TElement inactive);
//         void Store(TVector value, write Span<TElement> destination);
//         void StoreMasked(TVector value, TMask active, write Span<TElement> destination);
//         TMask CompareEqual(TVector left, TVector right);
//         TMask CompareLessThan(TVector left, TVector right);
//         TVector Select(TMask condition, TVector whenTrue, TVector whenFalse);
//     }
//     static on TMask {
//         TMask First(nuint activeLanes);
//         bool Any(TMask value);
//         bool All(TMask value);
//     }
// }

// Concrete fixed-width values are sized when their complete lane layout
// permits it. Their ordinary addition witness is shared with unrelated types:
// both operands and result are the same exact vector instantiation.
public struct simd128<T> : IAdditionOperators<simd128<T>, simd128<T>, simd128<T>>
    where T : [SimdElement], [Copy], [Sized];

public struct simd128mask<T>
    where T : [SimdElement], [Copy], [Sized];

// Other registered fixed-width members have independently validated widths,
// element predicates and matching mask types. No mask is inferred from a name.
// Hardware-scalable simd<T> is a separate genuinely scalable, initially
// sizeless type, never an alias for a host-selected fixed width. Its ABI and
// predicate restrictions require a target-specific checked profile.
