// API design only. Omitted bodies are not foreign linkage declarations.
using Terrum;
namespace Terrum.CodeAnalysis.Hosting;

public interface ISourceInput
{
    // Strict decoding; failure is exceptional, not a replacement-character policy.
    own Text ReadUtf8(TextSpan path);
}

public interface ICancellation
{
    void ThrowIfCancellationRequested();
}

public interface IContentDigest
{
    // Exact code units, including malformed editor input, not repaired scalar text.
    void Append(Span<char16> codeUnits);
    void WriteDigest(write Span<uint8> destination);
}

public interface ICompilerOutput
{
    void WriteDiagnostic(TextSpan code, TextSpan message, SourceRange range);
}
