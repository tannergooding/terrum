// DESIGN ONLY: eager, nonmaterializing algorithms over borrowed contiguous views.
using Terrum;

namespace Terrum.Collections.Algorithms;

// IMapper and IPredicate below are explicit nominal functor protocols.
// A compiler-supplied func/fnptr witness would require the complete callable
// signature, effects, access, lifetime and ABI to match; it would not box or
// synthesize an allocated structural adapter. These scalar-oriented APIs do
// not imply generic SIMD behavior for a closed callback.

// Equality and key semantics are caller-selected capabilities, not inherited
// universal object defaults. A key comparer pairs equality with its hash policy.
public interface IEqualityComparer<T>
{
    bool Equals(ref<T> left, ref<T> right);
}

public interface IKeyComparer<T> : IEqualityComparer<T>
{
    uint64 GetHashCode(ref<T> value);
}

public interface IMapper<TSource, TResult>
{
    TResult Map(ref<TSource> value);
}

public interface IPredicate<T>
{
    bool Test(ref<T> value);
}

public static class SpanAlgorithms
{
    // Missing is a bool, not a sentinel. The comparer may be an inline struct:
    // constrained invocation never boxes it or snapshots source storage.
    public static bool TryIndexOf<T, TComparer>(
        Span<T> source, ref<T> value, write ref<TComparer> comparer, init ref<nuint> index)
        where TComparer : IEqualityComparer<T>;

    // Destination capacity is checked before invoking any callback. Source and
    // destination must not overlap, even for TSource == TResult; otherwise a
    // stateful mapper or result write can invalidate a later source read.
    // Exactly one callback per visited element; a callback failure can leave
    // a valid written prefix without rolling it back.
    public static void Select<TSource, TResult, TMapper>(
        Span<TSource> source, write Span<TResult> destination, write ref<TMapper> mapper)
        where TMapper : IMapper<TSource, TResult>;

    // Require destination.Length >= source.Length before calling predicate so a
    // stateful predicate is never replayed to count/filter. Disjoint buffers
    // work; exact same-start in-place compaction is also safe because every
    // predicate completes and its [Copy] input is read before each write,
    // with write index <= read index. Reject displaced overlap before callbacks.
    // Return written count; callback failure may leave an accepted prefix.
    public static nuint Where<T, TPredicate>(
        Span<T> source, write Span<T> destination, write ref<TPredicate> predicate)
        where T : [Copy]
        where TPredicate : IPredicate<T>;
}
