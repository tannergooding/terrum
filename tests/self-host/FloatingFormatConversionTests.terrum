namespace Terrum.CodeAnalysis.Tests;

public bool CheckFloatingFormatConversion()
{
    if (Float32BitsToFloat64Bits(0) != 0
        || Float32BitsToFloat64Bits(0x80000000) != 0x8000000000000000
        || Float32BitsToFloat64Bits(0x00800000) != 0x3810000000000000
        || Float32BitsToFloat64Bits(0x80800000) != 0xB810000000000000
        || Float32BitsToFloat64Bits(0x7F7FFFFF) != 0x47EFFFFFE0000000
        || Float32BitsToFloat64Bits(0xFF7FFFFF) != 0xC7EFFFFFE0000000
        || Float32BitsToFloat64Bits(0x7F800000) != 0x7FF0000000000000
        || Float32BitsToFloat64Bits(0xFF800000) != 0xFFF0000000000000)
    {
        return false;
    }

    mut int32 bitIndex = 0;
    mut uint32 subnormal = 1;
    while (bitIndex < 23)
    {
        uint64 expected = uint64(874 + bitIndex) << 52;
        if (Float32BitsToFloat64Bits(subnormal) != expected)
        {
            return false;
        }

        bitIndex = bitIndex + 1;
        subnormal = subnormal << 1;
    }

    uint64 widenedNan = Float32BitsToFloat64Bits(0x7F800001);
    uint64 widenedNanNegative = Float32BitsToFloat64Bits(0xFFC00001);
    if ((widenedNan & 0x7FF0000000000000) != 0x7FF0000000000000
        || (widenedNan & 0x000FFFFFFFFFFFFF) == 0
        || (widenedNanNegative & 0xFFF0000000000000) != 0xFFF0000000000000
        || (widenedNanNegative & 0x000FFFFFFFFFFFFF) == 0)
    {
        return false;
    }

    if (Float64BitsToFloat32Bits(0) != 0
        || Float64BitsToFloat32Bits(0x8000000000000000) != 0x80000000
        || Float64BitsToFloat32Bits(0x7FF0000000000000) != 0x7F800000
        || Float64BitsToFloat32Bits(0xFFF0000000000000) != 0xFF800000
        || Float64BitsToFloat32Bits(0x0000000000000001) != 0
        || Float64BitsToFloat32Bits(0x800FFFFFFFFFFFFF) != 0x80000000)
    {
        return false;
    }

    uint32 narrowedNan = Float64BitsToFloat32Bits(0x7FF0000000000001);
    uint32 narrowedNanNegative = Float64BitsToFloat32Bits(0xFFF8000000000001);
    if ((narrowedNan & 0x7F800000) != 0x7F800000
        || (narrowedNan & 0x007FFFFF) == 0
        || (narrowedNanNegative & 0xFF800000) != 0xFF800000
        || (narrowedNanNegative & 0x007FFFFF) == 0)
    {
        return false;
    }

    return Float64BitsToFloat32Bits(0x3FF000000FFFFFFF) == 0x3F800000
        && Float64BitsToFloat32Bits(0x3FF0000010000000) == 0x3F800000
        && Float64BitsToFloat32Bits(0x3FF0000010000001) == 0x3F800001
        && Float64BitsToFloat32Bits(0x3FF000002FFFFFFF) == 0x3F800001
        && Float64BitsToFloat32Bits(0x3FF0000030000000) == 0x3F800002
        && Float64BitsToFloat32Bits(0x3FF0000030000001) == 0x3F800002
        && Float64BitsToFloat32Bits(0x3FFFFFFFF0000000) == 0x40000000
        && Float64BitsToFloat32Bits(0x47EFFFFFF0000000) == 0x7F800000
        && Float64BitsToFloat32Bits(0x47EFFFFFEFFFFFFF) == 0x7F7FFFFF
        && Float64BitsToFloat32Bits(0x3690000000000000) == 0
        && Float64BitsToFloat32Bits(0x3690000000000001) == 1
        && Float64BitsToFloat32Bits(0x36A8000000000000) == 2
        && Float64BitsToFloat32Bits(0x36A7FFFFFFFFFFFF) == 1
        && Float64BitsToFloat32Bits(0x380FFFFFDFFFFFFF) == 0x007FFFFF
        && Float64BitsToFloat32Bits(0x380FFFFFE0000000) == 0x00800000
        && Float64BitsToFloat32Bits(0x380FFFFFE0000001) == 0x00800000
        && Float64BitsToFloat32Bits(0xBFF0000010000000) == 0xBF800000
        && Float64BitsToFloat32Bits(0xBFF0000010000001) == 0xBF800001
        && Float64BitsToFloat32Bits(0xB690000000000000) == 0x80000000
        && Float64BitsToFloat32Bits(0xB6A8000000000000) == 0x80000002;
}
