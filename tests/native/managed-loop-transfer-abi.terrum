ManagedNode MakeLoopNode(int32 value) {
    require ManagedNode.TryCreate(value, out var node);
    return node;
}

public int32 LoopTransfers() {
    require OwnedInt32Buffer.TryCreate(1, out var created);
    mut OwnedInt32Buffer buffer = move created;
    require buffer.TryAppend(42);
    var retained = MakeLoopNode(42);
    mut int32 iteration = 0;
    mut int32 trace = 0;
    mut bool valid = true;
    for (OwnedInt32Buffer loop = move buffer; iteration < 5; iteration = iteration + 1) {
        require valid && loop.Read(0) == 42;
        if (iteration > 0) {
            require ManagedHeap.Collect() == 1;
        }
        var discarded = MakeLoopNode(iteration);
        discarded.SetNext(discarded);
        mut int32 inner = 0;
        while (inner < 3) {
            inner = inner + 1;
            if (inner == 1) { continue; }
            break;
        }
        require inner == 2;
        try {
            try {
                if (iteration < 2) { continue; }
                break;
            } finally {
                if (trace == 0) {
                    trace = 1;
                } else if (trace == 12) {
                    trace = 121;
                } else if (trace == 1212) {
                    trace = 12121;
                } else {
                    valid = false;
                }
                if (loop.Count != 1) {
                    valid = false;
                }
            }
        } finally {
            if (trace == 1) {
                trace = 12;
            } else if (trace == 121) {
                trace = 1212;
            } else if (trace == 12121) {
                trace = 121212;
            } else {
                valid = false;
            }
            if (discarded.Value != iteration) {
                valid = false;
            }
            if (ManagedHeap.Collect() != 0) {
                valid = false;
            }
        }
    }
    require valid && iteration == 2 && trace == 121212;
    require ManagedHeap.Collect() == 1;
    return retained.Value;
}

public int32 CollectWithScalar(uint64 bits) {
    return ManagedHeap.Collect();
}
