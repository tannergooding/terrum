mut class Leaf {
    public mut int32 Value;
    [NoThrow] public Leaf(int32 value) { Value = value; }
}

mut class Pair {
    public write Leaf First;
    public Leaf Second;
    public ManagedNode Extra;
    [NoThrow] public Pair(write Leaf first, Leaf second, ManagedNode extra) {
        First = first;
        Second = second;
        Extra = extra;
    }
    [NoThrow] public int32 ReadFirst() { return First.Value; }
    public int32 Sum() { return First.Value + Second.Value + Extra.Value; }
}

struct FactoryPayload {
    public int64 First;
    public int32 Second;
    public int32 Third;
    [NoThrow] public FactoryPayload(int64 first) {
        First = first;
        Second = 20;
        Third = 22;
    }
}

class CollectingPair {
    public Leaf Left;
    public Leaf Right;
    public FactoryPayload Data;
    public int32 Marker;
    public uint64 Bits;
    public FactoryPayload First;
    public bool Ready;
    [NoThrow] public CollectingPair(int32 marker, uint64 bits, FactoryPayload first,
        bool ready, Leaf child, FactoryPayload data) {
        Left = child;
        ManagedHeap.Collect();
        Right = child;
        Data = data;
        Marker = marker;
        Bits = bits;
        First = first;
        Ready = ready;
    }
}

struct PointerBits {
    public uint64 Value;
    [NoThrow] public PointerBits(uint64 value) { Value = value; }
}

class ScalarBox {
    public PointerBits Bits;
    [NoThrow] public ScalarBox(PointerBits bits) { Bits = bits; }
}

class CopyBox {
    public FactoryPayload Value;
    [NoThrow] public CopyBox(int32 marker, bool ready, uint64 bits, FactoryPayload value) { Value = value; }
}

mut class ReplaceableEdge {
    public mut write Leaf Item;
    [NoThrow] public ReplaceableEdge(write Leaf item) { Item = item; }
}

write ReplaceableEdge CreateReplaceableEdge() {
    require Leaf.TryCreate(1, out var item);
    require ReplaceableEdge.TryCreate(item, out var edge);
    return edge;
}

int32 ReplaceAndCollect(write ReplaceableEdge edge) {
    require Leaf.TryCreate(7, out var replacement);
    edge.Item = replacement;
    require ManagedHeap.Collect() == 0;
    return 42;
}

public int32 AssignmentAcrossCollection() {
    var edge = CreateReplaceableEdge();
    edge.Item.Value = ReplaceAndCollect(edge);
    require edge.Item.Value == 7;
    require ManagedHeap.Collect() == 1;
    return 42;
}

Pair CreatePair() {
    require Leaf.TryCreate(10, out var first);
    require Leaf.TryCreate(20, out var second);
    require ManagedNode.TryCreate(12, out var extra);
    require Pair.TryCreate(first, second, extra, out var pair);
    return pair;
}

void DiscardLeaf() {
    require Leaf.TryCreate(0, out var discarded);
}

public int32 MixedEdges() {
    var pair = CreatePair();
    require ManagedHeap.Collect() == 0;
    require pair.ReadFirst() == 10;
    return pair.Sum();
}

public int32 AliasUpdates() {
    require Leaf.TryCreate(20, out var child);
    require ManagedNode.TryCreate(0, out var extra);
    extra.SetNext(extra);
    require Pair.TryCreate(child, child, extra, out var pair);
    write Leaf alias = pair.First;
    alias.Value = 21;
    require ManagedHeap.Collect() == 0;
    return pair.Sum();
}

public int32 DuringConstruction() {
    DiscardLeaf();
    require Leaf.TryCreate(42, out var child);
    require CollectingPair.TryCreate(42, 18446744073709551615,
        new FactoryPayload(9223372036854775807), true, child,
        new FactoryPayload(-9223372036854775808), out var pair);
    require ManagedHeap.Collect() == 0;
    require pair.Left.Value == pair.Right.Value;
    require pair.Data.First == -9223372036854775808 && pair.Data.Second == 20 && pair.Data.Third == 22;
    require pair.Marker == 42 && pair.Bits == 18446744073709551615 && pair.Ready;
    require pair.First.First == 9223372036854775807 && pair.First.Second == 20 && pair.First.Third == 22;
    return pair.Left.Value;
}

public int32 CreateLoose() {
    DiscardLeaf();
    DiscardLeaf();
    return 42;
}

public int32 ScalarNonRoot(uint64 bits) {
    require ScalarBox.TryCreate(new PointerBits(bits), out var box);
    require ManagedHeap.Collect() == 2;
    require box.Bits.Value == bits;
    return 42;
}

public int32 AllocationFailure() {
    if (CopyBox.TryCreate(42, true, 18446744073709551615, new FactoryPayload(42), out var unpublished)) {
        return 0;
    }
    require ManagedHeap.Collect() == 0;
    return 42;
}

public int32 RetainAcrossAllocationFailure() {
    require Leaf.TryCreate(42, out var retained);
    if (CollectingPair.TryCreate(42, 18446744073709551615,
        new FactoryPayload(9223372036854775807), true, retained,
        new FactoryPayload(42), out var unpublished)) {
        return 0;
    }
    require ManagedHeap.Collect() == 0;
    return retained.Value;
}

public int32 CollectWithScalar(uint64 bits) {
    return ManagedHeap.Collect();
}

public struct ExportValue {
    public int64 First;
    public int64 Second;
    public ExportValue(int64 first, int64 second) { First = first; Second = second; }
}

public struct ExportSmall {
    public int32 Value;
    public ExportSmall(int32 value) { Value = value; }
}

class ExportBox {
    public ExportValue Data;
    public ExportBox(ExportValue value) { Data = value; }
}

public ExportValue CopyExport(ExportValue value) {
    require ExportBox.TryCreate(value, out var box);
    return box.Data;
}

public ExportSmall CopySmall(ExportSmall value) { return value; }

public bool TryExport(ExportValue input, bool publish, out ExportValue result, out int32 count) {
    require ExportBox.TryCreate(input, out var box);
    result = box.Data;
    count = 42;
    return publish;
}

public bool TryExportScalar(int32 input, bool publish, out int32 result) {
    result = input;
    return publish;
}
