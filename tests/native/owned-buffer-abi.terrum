public bool TryAcquire(out OwnedInt32Buffer buffer) {
    return OwnedInt32Buffer.TryCreate(4, out buffer);
}

public OwnedInt32Buffer Relay(OwnedInt32Buffer buffer) {
    return move buffer;
}

public OwnedInt32Buffer Build() {
    require OwnedInt32Buffer.TryCreate(2, out var created);
    mut OwnedInt32Buffer buffer = move created;
    require buffer.TryAppend(40);
    require buffer.TryAppend(2);
    return move buffer;
}

public int32 Consume(OwnedInt32Buffer buffer) {
    ReadonlyInt32BufferView view = buffer.Slice(0, buffer.Count);
    mut int32 sum = 0;
    for (mut int32 index = 0; index < view.Length; index = index + 1) {
        sum = sum + view.Read(index);
    }
    return sum;
}

public int32 Rebuild() {
    require OwnedInt32Buffer.TryCreate(2, out var created);
    mut OwnedInt32Buffer buffer = move created;
    require buffer.TryAppend(20);
    require OwnedInt32Buffer.TryCreate(1, out buffer);
    require buffer.TryAppend(42);
    return buffer.Read(0);
}

public bool TryRebuild() {
    require OwnedInt32Buffer.TryCreate(2, out var created);
    mut OwnedInt32Buffer buffer = move created;
    return OwnedInt32Buffer.TryCreate(1, out buffer);
}

unique struct FieldOwner {
    private mut OwnedInt32Buffer _words;

    public FieldOwner(OwnedInt32Buffer words) { _words = move words; }
    public mut bool TryAppend(int32 value) { return _words.TryAppend(value); }
    public mut void Set(int32 index, int32 value) { _words.Set(index, value); }
    [NoThrow] public mut void Clear() { _words.Clear(); }
    public int32 Count() { return _words.Count; }
    public int32 Read(int32 index) { return _words.Read(index); }
}

public int32 FieldMutation() {
    require OwnedInt32Buffer.TryCreate(2, out var raw);
    mut FieldOwner owner = new FieldOwner(move raw);
    require owner.TryAppend(40);
    require owner.TryAppend(1);
    if (owner.TryAppend(99) || owner.Count() != 2) { return 1; }
    owner.Set(1, 2);
    if (owner.Read(0) + owner.Read(1) != 42) { return 2; }
    owner.Clear();
    if (owner.Count() != 0) { return 3; }
    require owner.TryAppend(42);
    return owner.Read(0);
}

unique struct FieldViewOwner {
    public int32 Guard;
    private mut OwnedInt32Buffer _words;

    public FieldViewOwner(OwnedInt32Buffer words) {
        Guard = 7;
        _words = move words;
    }
    public mut int32 Rewrite() {
        mut MutableInt32BufferView view = _words.SliceMutable(1, 1);
        view.Set(0, view.Read(0) + 1);
        return view.Read(0);
    }
    public mut void FailView() {
        mut MutableInt32BufferView view = _words.SliceMutable(1, 1);
        view.Set(0, 42);
        view.Set(1, 99);
    }
    public int32 Count() { return _words.Count; }
    public int32 Read(int32 index) { return _words.Read(index); }
}

public int32 FieldViewMutation() {
    require OwnedInt32Buffer.TryCreate(2, out var raw);
    mut OwnedInt32Buffer words = move raw;
    require words.TryAppend(40);
    require words.TryAppend(1);
    mut FieldViewOwner owner = new FieldViewOwner(move words);
    if (owner.Rewrite() != 2 || owner.Guard != 7) { return 0; }
    return owner.Read(0) + owner.Read(1);
}

public unique struct Envelope {
    public OwnedInt32Buffer Data;

    public Envelope(bool complete) {
        require OwnedInt32Buffer.TryCreate(1, out var created);
        mut OwnedInt32Buffer buffer = move created;
        require buffer.TryAppend(42);
        Data = move buffer;
        require complete;
    }
}

public int32 Composite() {
    Envelope value = new Envelope(true);
    ReadonlyInt32BufferView view = value.Data.Slice(0, value.Data.Count);
    return view.Read(0);
}

public OwnedInt32Buffer FormattingWorkspace() {
    require OwnedInt32Buffer.TryCreate(24, out var buffer);
    return move buffer;
}

public OwnedInt32Buffer FormatDigits(uint64 value, OwnedInt32Buffer buffer) {
    return Terrum.CodeAnalysis.Numerics64.FormatUInt64(value, move buffer);
}

public OwnedInt32Buffer FormatSignedDigits(int64 value, OwnedInt32Buffer buffer) {
    return Terrum.CodeAnalysis.Numerics64.FormatInt64(value, move buffer);
}
