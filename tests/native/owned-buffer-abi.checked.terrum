public int32 Recover() {
    unsafe {
        try {
            Envelope value = new Envelope(false);
        }
        catch {
            return 42;
        }
    }
    return 0;
}

public int32 RecoverFormatting() {
    unsafe {
        try {
            require OwnedInt32Buffer.TryCreate(19, out var workspace);
            OwnedInt32Buffer digits = FormatDigits(uint64.MaxValue, move workspace);
            return digits.Count;
        }
        catch {
            return 42;
        }
    }
}

public int32 RecoverField() {
    require OwnedInt32Buffer.TryCreate(1, out var raw);
    mut FieldOwner owner = new FieldOwner(move raw);
    require owner.TryAppend(40);
    unsafe {
        try {
            owner.Set(0, 42);
            owner.Set(1, 99);
        }
        catch {
            if (owner.Read(0) != 42 || owner.Count() != 1) { return 0; }
            return 42;
        }
    }
    return 0;
}

public int32 RecoverFieldView() {
    require OwnedInt32Buffer.TryCreate(2, out var raw);
    mut OwnedInt32Buffer words = move raw;
    require words.TryAppend(40);
    require words.TryAppend(1);
    mut FieldViewOwner owner = new FieldViewOwner(move words);
    unsafe {
        try { owner.FailView(); }
        catch {
            if (owner.Guard != 7 || owner.Count() != 2 || owner.Read(0) != 40) { return 0; }
            return owner.Read(1);
        }
    }
    return 0;
}
