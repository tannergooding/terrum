namespace Terrum.CodeAnalysis.Tests;

public bool CheckCharacterFacts()
{
    init int32 zero;
    init int32 nine;
    init int32 upperA;
    init int32 upperF;
    init int32 lowerA;
    init int32 lowerF;
    init int32 beforeDigits;
    init int32 afterDigits;
    init int32 beforeUpper;
    init int32 afterUpper;
    init int32 beforeLower;
    init int32 afterLower;

    if (!IsAsciiDigit(char16(48)) || !IsAsciiDigit(char16(57))
        || IsAsciiDigit(char16(47)) || IsAsciiDigit(char16(58))
        || !IsLineBreak(char16(10)) || !IsLineBreak(char16(13))
        || !IsLineBreak(char16(133)) || !IsLineBreak(char16(8232))
        || !IsLineBreak(char16(8233)) || IsLineBreak(char16(32)))
    {
        return false;
    }

    if (GetDecimalDigit(char16(48)) != 0 || GetDecimalDigit(char16(49)) != 1
        || GetDecimalDigit(char16(50)) != 2 || GetDecimalDigit(char16(51)) != 3
        || GetDecimalDigit(char16(52)) != 4 || GetDecimalDigit(char16(53)) != 5
        || GetDecimalDigit(char16(54)) != 6 || GetDecimalDigit(char16(55)) != 7
        || GetDecimalDigit(char16(56)) != 8 || GetDecimalDigit(char16(57)) != 9)
    {
        return false;
    }

    require TryGetHexDigit(char16(48), ref init zero);
    require TryGetHexDigit(char16(57), ref init nine);
    require TryGetHexDigit(char16(65), ref init upperA);
    require TryGetHexDigit(char16(70), ref init upperF);
    require TryGetHexDigit(char16(97), ref init lowerA);
    require TryGetHexDigit(char16(102), ref init lowerF);
    if (zero != 0 || nine != 9 || upperA != 10 || upperF != 15
        || lowerA != 10 || lowerF != 15
        || TryGetHexDigit(char16(47), ref init beforeDigits)
        || TryGetHexDigit(char16(58), ref init afterDigits)
        || TryGetHexDigit(char16(64), ref init beforeUpper)
        || TryGetHexDigit(char16(71), ref init afterUpper)
        || TryGetHexDigit(char16(96), ref init beforeLower)
        || TryGetHexDigit(char16(103), ref init afterLower))
    {
        return false;
    }

    for (mut int32 value = 0; value <= 65535; value = value + 1)
    {
        char16 codeUnit = char16(value);
        bool expectedDigit = value >= 48 && value <= 57;
        bool expectedLineBreak = value == 10 || value == 13 || value == 133
            || value == 8232 || value == 8233;
        if (IsAsciiDigit(codeUnit) != expectedDigit
            || IsLineBreak(codeUnit) != expectedLineBreak)
        {
            return false;
        }
        if (expectedDigit && GetDecimalDigit(codeUnit) != value - 48)
        {
            return false;
        }

        mut int32 expectedHex = -1;
        if (value >= 48 && value <= 57)
        {
            expectedHex = value - 48;
        }
        else if (value >= 65 && value <= 70)
        {
            expectedHex = value - 65 + 10;
        }
        else if (value >= 97 && value <= 102)
        {
            expectedHex = value - 97 + 10;
        }
        if (expectedHex >= 0)
        {
            init int32 actualHex;
            require TryGetHexDigit(codeUnit, ref init actualHex);
            if (actualHex != expectedHex)
            {
                return false;
            }
        }
        else
        {
            init int32 invalidHex;
            if (TryGetHexDigit(codeUnit, ref init invalidHex))
            {
                return false;
            }
        }
    }

    return true;
}
