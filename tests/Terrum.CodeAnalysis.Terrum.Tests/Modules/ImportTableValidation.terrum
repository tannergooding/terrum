namespace Terrum.CodeAnalysis;

public static bool TryValidateImportTable(int32 recordCount,
    int32 moduleCount, int32 stringCount, int32 moduleRefCount,
    int32 typeDefCount, int32 fieldDefCount, int32 methodDefCount,
    int32 propertyDefCount,
    int32 interfaceDefCount, int32 associatedTypeDefCount)
{
    if (recordCount < 0 || recordCount > 0xFF_FFFF
        || moduleCount <= 0 || moduleCount > 0xFF_FFFF
        || stringCount < 0 || stringCount > 0xFF_FFFF
        || moduleRefCount < 0 || moduleRefCount > 0xFF_FFFF
        || typeDefCount < 0 || typeDefCount > 0xFF_FFFF
        || fieldDefCount < 0 || fieldDefCount > 0xFF_FFFF
        || methodDefCount < 0 || methodDefCount > 0xFF_FFFF
        || interfaceDefCount < 0 || interfaceDefCount > 0xFF_FFFF
        || associatedTypeDefCount < 0 || associatedTypeDefCount > 0xFF_FFFF
        || recordCount * 12 != Host.Imports.Length
        || propertyDefCount < 0 || propertyDefCount > 0xFF_FFFF
        || moduleCount * 48 != Host.Modules.Length
        || moduleRefCount * 12 != Host.ModuleRefs.Length
        || typeDefCount * 44 != Host.TypeDefs.Length
        || fieldDefCount * 16 != Host.FieldDefs.Length
        || methodDefCount * 28 != Host.Methods.Length
        || interfaceDefCount * 48 != Host.InterfaceDefs.Length
        || associatedTypeDefCount * 12 != Host.AssociatedTypeDefs.Length
        || Host.Properties.Length != propertyDefCount * 20
        || Host.ImportExpectedDefinitions.Length != recordCount + 1
        || Host.ImportExpectedTargets.Length != recordCount + 1
        || Host.ImportExpectedPolicies.Length != recordCount + 1)
    {
        return false;
    }

    for (mut int32 slot = 0; slot <= recordCount; slot = slot + 1)
    {
        Host.ImportExpectedDefinitions[slot] = 0;
        Host.ImportExpectedTargets[slot] = 0;
        Host.ImportExpectedPolicies[slot] = 0;
    }

    if (recordCount != 0 && !TryValidateVariableTableIndex(stringCount, 8, 4))
    {
        return false;
    }

    for (mut int32 row = 1; row <= recordCount; row = row + 1)
    {
        init uint32 moduleRef;
        init uint32 key;
        init uint32 expected;
        init int32 keyOffset;
        init int32 keyLength;
        init int32 keyScalarCount;
        init int32 expectedModule;
        init uint32 body;
        init int32 referenceModule;
        init uint32 target;
        init uint32 policy;
        int32 rowStart = (row - 1) * 12;
        if (!TryReadImportTableWord(rowStart, 0, ref init moduleRef)
            || !TryReadImportTableWord(rowStart, 4, ref init key)
            || !TryReadImportTableWord(rowStart, 8, ref init expected))
        {
            return false;
        }
        if (moduleRef == 0 || moduleRef > uint32(moduleRefCount)
            || key == 0 || key > 0xFF_FFFF || key > uint32(stringCount))
        {
            return false;
        }
        if (!TryGetValidatedVariableTableRowExtent(stringCount, 8, 4, int32(key),
            ref init keyOffset, ref init keyLength))
        {
            return false;
        }
        if (!TryGetStringNameScalarCount((stringCount + 1) * 4 + int32(keyOffset),
            keyLength, ref init keyScalarCount))
        {
            return false;
        }
        if (!TryGetImportDefinitionModule(expected, moduleCount,
            typeDefCount, fieldDefCount, methodDefCount, propertyDefCount,
            interfaceDefCount, associatedTypeDefCount,
            ref init expectedModule, ref init body))
        {
            return false;
        }
        if (!TryGetImportModuleRefOwner(int32(moduleRef), moduleCount,
            moduleRefCount, ref init referenceModule)
            || expectedModule != referenceModule
            || ((expected >> 24 == 0x16 || expected >> 24 == 0x1E) && body != 0))
        {
            return false;
        }
        if (!TryReadModuleRefTableWord(int32(moduleRef), 4,
            ref init target)
            || !TryReadModuleRefTableWord(int32(moduleRef), 8,
                ref init policy))
        {
            return false;
        }

        Host.ImportExpectedDefinitions[row] = int32(expected);
        Host.ImportExpectedTargets[row] = int32(target);
        Host.ImportExpectedPolicies[row] = int32(policy);
    }

    if (!TrySortAndCheckImportExpectations(recordCount))
    {
        return false;
    }

    for (mut int32 row = 1; row <= recordCount; row = row + 1)
    {
        init uint32 expected;
        if (!TryReadImportTableWord((row - 1) * 12, 8, ref init expected))
        {
            return false;
        }
        if (expected >> 24 == 0x14)
        {
            init int32 fieldOwner;
            if (!TryGetFieldOwnerType(int32(expected & 0xFF_FFFF),
                typeDefCount, fieldDefCount, ref init fieldOwner)
                || !IsExpectedImportDefinition(
                    0x1300_0000 | uint32(fieldOwner), recordCount))
            {
                return false;
            }
        }
        else if (expected >> 24 == 0x20)
        {
            init int32 ownerType;
            if (!TryGetAssociatedTypeOwnerType(
                int32(expected & 0xFF_FFFF), typeDefCount,
                interfaceDefCount, associatedTypeDefCount,
                ref init ownerType)
                || !IsExpectedImportDefinition(
                    0x1300_0000 | uint32(ownerType), recordCount))
            {
                return false;
            }
        }
    }

    return true;
}

public static bool IsExpectedImportDefinition(uint32 reference, int32 recordCount)
{
    if (recordCount < 0
        || Host.ImportExpectedDefinitions.Length != recordCount + 1)
    {
        return false;
    }

    mut int32 low = 1;
    mut int32 high = recordCount;
    while (low <= high)
    {
        int32 middle = low + (high - low) / 2;
        uint32 candidate = uint32(Host.ImportExpectedDefinitions[middle]);
        if (candidate == reference)
        {
            return true;
        }
        if (candidate < reference)
        {
            low = middle + 1;
        }
        else
        {
            high = middle - 1;
        }
    }

    return false;
}

public static bool TryGetExpectedImportRequirements(uint32 reference,
    int32 recordCount, ref<init uint32> targetRequirement, ref<init uint32> runtimePolicy)
{
    if (recordCount < 0
        || Host.ImportExpectedDefinitions.Length != recordCount + 1
        || Host.ImportExpectedTargets.Length != recordCount + 1
        || Host.ImportExpectedPolicies.Length != recordCount + 1)
    {
        return false;
    }

    mut int32 low = 1;
    mut int32 high = recordCount;
    while (low <= high)
    {
        int32 middle = low + (high - low) / 2;
        uint32 candidate = uint32(Host.ImportExpectedDefinitions[middle]);
        if (candidate == reference)
        {
            *targetRequirement = uint32(Host.ImportExpectedTargets[middle]);
            *runtimePolicy = uint32(Host.ImportExpectedPolicies[middle]);
            return true;
        }
        if (candidate < reference)
        {
            low = middle + 1;
        }
        else
        {
            high = middle - 1;
        }
    }

    return false;
}

bool TryGetImportDefinitionModule(uint32 reference, int32 moduleCount,
    int32 typeDefCount, int32 fieldDefCount, int32 methodDefCount,
    int32 propertyDefCount,
    int32 interfaceDefCount, int32 associatedTypeDefCount,
    ref<init int32> ownerModule, ref<init uint32> body)
{
    uint32 table = reference >> 24;
    uint32 row = reference & 0xFF_FFFF;
    if (row == 0)
    {
        return false;
    }

    if (table == 0x13)
    {
        if (row > uint32(typeDefCount)
            || !TryGetImportTableOwnerModule(int32(row), moduleCount, typeDefCount, 36,
                ref init *ownerModule))
        {
            return false;
        }
        *body = 0;
        return true;
    }

    if (table == 0x16)
    {
        if (row > uint32(methodDefCount)
            || !TryGetImportTableOwnerModule(int32(row), moduleCount, methodDefCount, 40,
                ref init *ownerModule)
            || !TryReadMethodDefTableWord((int32(row) - 1) * 28, 24, ref init *body))
        {
            return false;
        }
        return true;
    }

    if (table == 0x14)
    {
        init int32 ownerType;
        if (!TryGetFieldOwnerType(int32(row), typeDefCount, fieldDefCount,
            ref init ownerType)
            || !TryGetImportTableOwnerModule(ownerType, moduleCount,
                typeDefCount, 36, ref init *ownerModule))
        {
            return false;
        }

        *body = 0;
        return true;
    }

    if (table == 0x1E)
    {
        init uint32 ownerType;
        init uint32 getter;
        if (row > uint32(propertyDefCount)
            || !TryReadPropertyTableWord((int32(row) - 1) * 20, 0, ref init ownerType)
            || !TryGetImportTableOwnerModule(int32(ownerType), moduleCount, typeDefCount, 36,
                ref init *ownerModule)
            || !TryReadPropertyTableWord((int32(row) - 1) * 20, 12, ref init getter)
            || !TryReadMethodDefTableWord((int32(getter) - 1) * 28, 24, ref init *body))
        {
            return false;
        }
        return true;
    }

    if (table == 0x20)
    {
        init int32 ownerType;
        if (!TryGetAssociatedTypeOwnerType(int32(row), typeDefCount,
            interfaceDefCount, associatedTypeDefCount, ref init ownerType)
            || !TryGetImportTableOwnerModule(ownerType, moduleCount,
                typeDefCount, 36, ref init *ownerModule))
        {
            return false;
        }

        *body = 0;
        return true;
    }

    return false;
}

bool TryGetAssociatedTypeOwnerType(int32 row, int32 typeDefCount,
    int32 interfaceDefCount, int32 associatedTypeDefCount,
    ref<init int32> ownerType)
{
    init uint32 ownerInterface;
    init uint32 declaredOwner;
    init uint32 associatedFirst;
    init uint32 associatedCount;
    init uint32 flags;
    if (row <= 0 || row > associatedTypeDefCount
        || interfaceDefCount <= 0
        || !TryReadAssociatedTypeDefTableWord((row - 1) * 12, 0,
            ref init ownerInterface)
        || ownerInterface == 0 || ownerInterface > uint32(interfaceDefCount)
        || !TryReadInterfaceDefTableWord(
            (int32(ownerInterface) - 1) * 48, 0, ref init declaredOwner)
        || declaredOwner == 0 || declaredOwner > uint32(typeDefCount)
        || !TryReadInterfaceDefTableWord(
            (int32(ownerInterface) - 1) * 48, 24, ref init associatedFirst)
        || !TryReadInterfaceDefTableWord(
            (int32(ownerInterface) - 1) * 48, 28, ref init associatedCount)
        || associatedFirst == 0 || associatedCount == 0
        || associatedFirst > uint32(associatedTypeDefCount)
        || associatedCount > uint32(associatedTypeDefCount) - associatedFirst + 1
        || uint32(row) < associatedFirst
        || uint32(row) - associatedFirst >= associatedCount
        || !TryReadTypeDefTableWord(
            (int32(declaredOwner) - 1) * 44, 8, ref init flags)
        || ((flags >> 2) & 3) != 3)
    {
        return false;
    }

    *ownerType = int32(declaredOwner);
    return true;
}

bool TryGetFieldOwnerType(int32 row, int32 typeDefCount,
    int32 fieldDefCount, ref<init int32> ownerType)
{
    init uint32 owner;
    if (row <= 0 || row > fieldDefCount
        || !TryReadFieldDefTableWord((row - 1) * 16, 0, ref init owner)
        || owner == 0 || owner > uint32(typeDefCount)
        || owner != uint32(Host.FieldOwners[row]))
    {
        return false;
    }

    *ownerType = int32(owner);
    return true;
}

bool TryGetImportTableOwnerModule(int32 row, int32 moduleCount,
    int32 tableCount, int32 cursorOffset, ref<init int32> ownerModule)
{
    mut int32 low = 1;
    mut int32 high = moduleCount;
    while (low <= high)
    {
        init uint32 start;
        int32 middle = low + (high - low) / 2;
        if (!TryReadModuleTableWord((middle - 1) * 48, cursorOffset,
            ref init start))
        {
            return false;
        }

        mut uint32 end = uint32(tableCount + 1);
        if (middle < moduleCount)
        {
            init uint32 nextStart;
            if (!TryReadModuleTableWord(middle * 48, cursorOffset, ref init nextStart))
            {
                return false;
            }
            end = nextStart;
        }

        if (uint32(row) < start)
        {
            high = middle - 1;
        }
        else if (uint32(row) >= end)
        {
            low = middle + 1;
        }
        else
        {
            *ownerModule = middle;
            return true;
        }
    }

    return false;
}

bool TryGetImportModuleRefOwner(int32 row, int32 moduleCount,
    int32 moduleRefCount, ref<init int32> ownerModule)
    => TryGetImportTableOwnerModule(row, moduleCount, moduleRefCount, 32,
        ref init *ownerModule);

bool TrySortAndCheckImportExpectations(int32 recordCount)
{
    mut int32 root = recordCount / 2;
    while (root > 0)
    {
        SiftImportExpectationHeap(root, recordCount);
        root = root - 1;
    }

    mut int32 heapEnd = recordCount;
    while (heapEnd > 1)
    {
        SwapImportExpectations(1, heapEnd);
        heapEnd = heapEnd - 1;
        SiftImportExpectationHeap(1, heapEnd);
    }

    for (mut int32 row = 2; row <= recordCount; row = row + 1)
    {
        if (Host.ImportExpectedDefinitions[row - 1]
            == Host.ImportExpectedDefinitions[row])
        {
            return false;
        }
    }

    return true;
}

void SiftImportExpectationHeap(int32 root, int32 heapEnd)
{
    mut int32 current = root;
    while (current <= heapEnd / 2)
    {
        mut int32 child = current * 2;
        if (child < heapEnd
            && Host.ImportExpectedDefinitions[child]
                < Host.ImportExpectedDefinitions[child + 1])
        {
            child = child + 1;
        }
        if (Host.ImportExpectedDefinitions[current]
            >= Host.ImportExpectedDefinitions[child])
        {
            break;
        }

        SwapImportExpectations(current, child);
        current = child;
    }
}

void SwapImportExpectations(int32 first, int32 second)
{
    mut int32 value = Host.ImportExpectedDefinitions[first];
    Host.ImportExpectedDefinitions[first] = Host.ImportExpectedDefinitions[second];
    Host.ImportExpectedDefinitions[second] = value;
    value = Host.ImportExpectedTargets[first];
    Host.ImportExpectedTargets[first] = Host.ImportExpectedTargets[second];
    Host.ImportExpectedTargets[second] = value;
    value = Host.ImportExpectedPolicies[first];
    Host.ImportExpectedPolicies[first] = Host.ImportExpectedPolicies[second];
    Host.ImportExpectedPolicies[second] = value;
}

bool TryReadImportTableWord(int32 rowStart, int32 offset, ref<init uint32> value)
{
    init int32 first;
    init int32 second;
    init int32 third;
    init int32 fourth;
    if (rowStart < 0 || rowStart > Host.Imports.Length - 12
        || offset < 0 || offset > 8
        || !TryReadImportTableByte(rowStart + offset, ref init first)
        || !TryReadImportTableByte(rowStart + offset + 1, ref init second)
        || !TryReadImportTableByte(rowStart + offset + 2, ref init third)
        || !TryReadImportTableByte(rowStart + offset + 3, ref init fourth))
    {
        return false;
    }

    *value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool TryReadImportTableByte(int32 offset, ref<init int32> value)
{
    if (offset < 0 || offset >= Host.Imports.Length)
    {
        return false;
    }

    int32 part = Host.Imports[offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    *value = part;
    return true;
}

bool TryReadInterfaceDefTableWord(int32 rowStart, int32 offset, ref<init uint32> value)
{
    init int32 first;
    init int32 second;
    init int32 third;
    init int32 fourth;
    if (rowStart < 0 || rowStart > Host.InterfaceDefs.Length - 48
        || offset < 0 || offset > 44
        || !TryReadInterfaceDefTableByte(rowStart + offset, ref init first)
        || !TryReadInterfaceDefTableByte(rowStart + offset + 1, ref init second)
        || !TryReadInterfaceDefTableByte(rowStart + offset + 2, ref init third)
        || !TryReadInterfaceDefTableByte(rowStart + offset + 3, ref init fourth))
    {
        return false;
    }

    *value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool TryReadInterfaceDefTableByte(int32 offset, ref<init int32> value)
{
    if (offset < 0 || offset >= Host.InterfaceDefs.Length)
    {
        return false;
    }

    int32 part = Host.InterfaceDefs[offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    *value = part;
    return true;
}

bool TryReadAssociatedTypeDefTableWord(int32 rowStart, int32 offset,
    ref<init uint32> value)
{
    init int32 first;
    init int32 second;
    init int32 third;
    init int32 fourth;
    if (rowStart < 0 || rowStart > Host.AssociatedTypeDefs.Length - 12
        || offset < 0 || offset > 8
        || !TryReadAssociatedTypeDefTableByte(rowStart + offset, ref init first)
        || !TryReadAssociatedTypeDefTableByte(rowStart + offset + 1, ref init second)
        || !TryReadAssociatedTypeDefTableByte(rowStart + offset + 2, ref init third)
        || !TryReadAssociatedTypeDefTableByte(rowStart + offset + 3, ref init fourth))
    {
        return false;
    }

    *value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool TryReadAssociatedTypeDefTableByte(int32 offset, ref<init int32> value)
{
    if (offset < 0 || offset >= Host.AssociatedTypeDefs.Length)
    {
        return false;
    }

    int32 part = Host.AssociatedTypeDefs[offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    *value = part;
    return true;
}

bool TryReadFieldDefTableWord(int32 rowStart, int32 offset, ref<init uint32> value)
{
    init int32 first;
    init int32 second;
    init int32 third;
    init int32 fourth;
    if (rowStart < 0 || rowStart > Host.FieldDefs.Length - 16
        || offset < 0 || offset > 12
        || !TryReadFieldDefTableByte(rowStart + offset, ref init first)
        || !TryReadFieldDefTableByte(rowStart + offset + 1, ref init second)
        || !TryReadFieldDefTableByte(rowStart + offset + 2, ref init third)
        || !TryReadFieldDefTableByte(rowStart + offset + 3, ref init fourth))
    {
        return false;
    }

    *value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool TryReadFieldDefTableByte(int32 offset, ref<init int32> value)
{
    if (offset < 0 || offset >= Host.FieldDefs.Length)
    {
        return false;
    }

    int32 part = Host.FieldDefs[offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    *value = part;
    return true;
}
