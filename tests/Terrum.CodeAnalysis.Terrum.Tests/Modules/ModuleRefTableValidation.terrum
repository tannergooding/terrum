namespace Terrum.CodeAnalysis;

public static bool TryValidateModuleRefTable(int32 recordCount, int32 moduleCount,
    int32 stringCount, int32 moduleRefCount, int32 typeDefCount, int32 methodDefCount,
    int32 sourceFileCount, int32 featureCount)
{
    if (recordCount < 0 || recordCount > 0xFF_FFFF
        || recordCount != moduleRefCount
        || recordCount * 12 != Host.ModuleRefs.Length)
    {
        return false;
    }

    if (!TryValidateModuleTable(moduleCount, stringCount, moduleRefCount,
        typeDefCount, methodDefCount, sourceFileCount, featureCount))
    {
        return false;
    }

    int32 stringIndexByteLength = (stringCount + 1) * 4;
    for (mut int32 module = 1; module <= moduleCount; module = module + 1)
    {
        init uint32 firstModuleRef;
        int32 moduleStart = (module - 1) * 48;
        if (!TryReadModuleTableWord(moduleStart, 32, ref init firstModuleRef))
        {
            return false;
        }

        mut uint32 endModuleRef = uint32(recordCount + 1);
        if (module < moduleCount)
        {
            init uint32 nextModuleRef;
            if (!TryReadModuleTableWord(module * 48, 32, ref init nextModuleRef))
            {
                return false;
            }
            endModuleRef = nextModuleRef;
        }

        for (mut int32 row = int32(firstModuleRef); row < int32(endModuleRef); row = row + 1)
        {
            init int32 producer;
            init uint32 target;
            init uint32 policy;
            init int32 selectedModule;
            if (!TryValidateModuleRefRow(row, stringCount,
                stringIndexByteLength, ref init producer, ref init target, ref init policy)
                || !TryFindModuleTableRowByIdentity(moduleCount, stringCount,
                    stringIndexByteLength, producer, ref init selectedModule))
            {
                return false;
            }

            if (selectedModule != 0)
            {
                init uint32 selectedTarget;
                init uint32 selectedPolicy;
                int32 selectedModuleStart = (selectedModule - 1) * 48;
                if (!TryReadModuleTableWord(selectedModuleStart, 8, ref init selectedTarget)
                    || !TryReadModuleTableWord(selectedModuleStart, 12, ref init selectedPolicy)
                    || target != selectedTarget || policy != selectedPolicy)
                {
                    return false;
                }
            }
        }
    }

    return true;
}

bool TryValidateModuleRefRow(int32 row, int32 stringCount,
    int32 stringIndexByteLength, ref<init int32> producerResult,
    ref<init uint32> targetResult, ref<init uint32> policyResult)
{
    init uint32 producer;
    init uint32 target;
    init uint32 policy;
    init int32 identityStart;
    init int32 identityLength;
    init int32 identityEncoding;
    init int32 identityContentLength;
    if (!TryReadModuleRefTableWord(row, 0, ref init producer)
        || !TryReadModuleRefTableWord(row, 4, ref init target)
        || !TryReadModuleRefTableWord(row, 8, ref init policy)
        || producer == 0 || producer > 0xFF_FFFF || producer > uint32(stringCount)
        || target > 1 || policy > 1)
    {
        return false;
    }

    if (!TryGetValidatedModuleIdentityExtent(stringCount, stringIndexByteLength,
            int32(producer), ref init identityStart, ref init identityLength,
            ref init identityEncoding, ref init identityContentLength)
        || !TryValidateModuleIdentityText(identityStart, identityContentLength, identityEncoding))
    {
        return false;
    }

    *producerResult = int32(producer);
    *targetResult = target;
    *policyResult = policy;
    return true;
}

bool TryReadModuleRefTableWord(int32 row, int32 offset, ref<init uint32> value)
{
    init int32 first;
    init int32 second;
    init int32 third;
    init int32 fourth;
    int32 rowStart = (row - 1) * 12;
    if (row <= 0 || rowStart < 0 || rowStart > Host.ModuleRefs.Length - 12
        || offset < 0 || offset > 8
        || !TryReadModuleRefTableByte(rowStart + offset, ref init first)
        || !TryReadModuleRefTableByte(rowStart + offset + 1, ref init second)
        || !TryReadModuleRefTableByte(rowStart + offset + 2, ref init third)
        || !TryReadModuleRefTableByte(rowStart + offset + 3, ref init fourth))
    {
        return false;
    }

    *value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool TryReadModuleRefTableByte(int32 offset, ref<init int32> value)
{
    if (offset < 0 || offset >= Host.ModuleRefs.Length)
    {
        return false;
    }

    int32 part = Host.ModuleRefs[offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    *value = part;
    return true;
}
