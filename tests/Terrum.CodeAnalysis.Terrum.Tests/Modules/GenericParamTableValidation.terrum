namespace Terrum.CodeAnalysis;

public static bool TryValidateGenericParamTable(int32 recordCount,
    int32 moduleCount, int32 stringCount, int32 moduleRefCount,
    int32 typeDefCount, int32 methodDefCount, int32 sourceFileCount,
    int32 featureCount, int32 fieldCount, int32 genericParamCount,
    int32 layoutCount, int32 contractCount, int32 methodSigCount,
    int32 typeSpecCount, int32 constraintCount, int32 bodyCount)
{
    if (recordCount < 0 || recordCount > 0xFF_FFFF
        || recordCount != genericParamCount
        || constraintCount < 0 || constraintCount > 0xFF_FFFF
        || typeSpecCount < 0 || typeSpecCount > 0xFF_FFFF
        || recordCount * 32 != Host.GenericParams.Length
        || Host.ConstraintOwners.Length != constraintCount + 1
        || !TryValidateMethodDefTable(methodDefCount, moduleCount, stringCount,
            moduleRefCount, typeDefCount, methodDefCount, sourceFileCount,
            featureCount, fieldCount, genericParamCount, layoutCount,
            contractCount, methodSigCount, bodyCount))
    {
        return false;
    }

    int32 stringIndexByteLength = (stringCount + 1) * 4;
    mut int32 declaredFormalCount = 0;
    for (mut int32 type = 1; type <= typeDefCount; type = type + 1)
    {
        init uint32 formalCount;
        if (!TryReadTypeDefTableWord((type - 1) * 44, 24, ref init formalCount)
            || formalCount > uint32(recordCount - declaredFormalCount))
        {
            return false;
        }
        declaredFormalCount = declaredFormalCount + int32(formalCount);
    }

    for (mut int32 method = 1; method <= methodDefCount; method = method + 1)
    {
        init uint32 signature;
        init uint32 firstFormal;
        init uint32 formalCount;
        if (!TryReadMethodDefTableWord((method - 1) * 28, 8, ref init signature)
            || signature == 0 || signature > uint32(methodSigCount)
            || !TryReadMethodSignatureWord((int32(signature) - 1) * 24, 16,
                ref init firstFormal)
            || !TryReadMethodSignatureWord((int32(signature) - 1) * 24, 20,
                ref init formalCount)
            || !IsValidGenericParamRange(firstFormal, formalCount, genericParamCount)
            || formalCount > uint32(recordCount - declaredFormalCount))
        {
            return false;
        }
        declaredFormalCount = declaredFormalCount + int32(formalCount);
    }

    if (declaredFormalCount != recordCount)
    {
        return false;
    }

    for (mut int32 constraint = 0; constraint <= constraintCount; constraint = constraint + 1)
    {
        Host.ConstraintOwners[constraint] = 0;
    }

    mut uint32 cachedOwner = 0;
    mut uint32 cachedFirstFormal = 0;
    mut uint32 cachedFormalCount = 0;
    for (mut int32 row = 1; row <= recordCount; row = row + 1)
    {
        init uint32 owner;
        init uint32 ordinal;
        init uint32 name;
        init uint32 firstConstraint;
        init uint32 constraintRangeCount;
        init int32 formalKind;
        init int32 ownershipDomain;
        init int32 nullabilityDomain;
        init int32 reserved;
        init uint32 constantTypeSpec;
        init uint32 defaultArgument;
        init int32 nameOffset;
        init int32 nameLength;
        init int32 nameScalarCount;
        int32 rowStart = (row - 1) * 32;
        if (!TryReadGenericParamTableWord(rowStart, 0, ref init owner)
            || !TryReadGenericParamTableWord(rowStart, 4, ref init ordinal)
            || !TryReadGenericParamTableWord(rowStart, 8, ref init name)
            || !TryReadGenericParamTableWord(rowStart, 12, ref init firstConstraint)
            || !TryReadGenericParamTableWord(rowStart, 16, ref init constraintRangeCount)
            || !TryReadGenericParamTableByte(rowStart + 20, ref init formalKind)
            || !TryReadGenericParamTableByte(rowStart + 21, ref init ownershipDomain)
            || !TryReadGenericParamTableByte(rowStart + 22, ref init nullabilityDomain)
            || !TryReadGenericParamTableByte(rowStart + 23, ref init reserved)
            || !TryReadGenericParamTableWord(rowStart, 24, ref init constantTypeSpec)
            || !TryReadGenericParamTableWord(rowStart, 28, ref init defaultArgument)
            || name == 0 || name > 0xFF_FFFF || name > uint32(stringCount)
            || !IsValidGenericParamRange(firstConstraint, constraintRangeCount, constraintCount)
            || reserved != 0
            || (formalKind == 1
                ? ownershipDomain < 1 || ownershipDomain > 3
                    || nullabilityDomain < 1 || nullabilityDomain > 2
                    || constantTypeSpec != 0
                    || (defaultArgument != 0 && defaultArgument > uint32(typeSpecCount))
                : formalKind == 2
                    ? ownershipDomain != 0 || nullabilityDomain != 0
                        || constantTypeSpec == 0
                        || constantTypeSpec > uint32(typeSpecCount)
                        || constraintRangeCount != 0 || defaultArgument != 0
                    : true))
        {
            return false;
        }

        uint32 ownerKind = owner >> 24;
        int32 ownerRow = int32(owner & 0x00FF_FFFF);
        if (ownerKind == 0x13 && ownerRow > 0 && ownerRow <= typeDefCount)
        {
            if (owner != cachedOwner)
            {
                init uint32 firstFormal;
                init uint32 formalCount;
                int32 ownerOffset = (ownerRow - 1) * 44;
                if (!TryReadTypeDefTableWord(ownerOffset, 20, ref init firstFormal)
                    || !TryReadTypeDefTableWord(ownerOffset, 24, ref init formalCount))
                {
                    return false;
                }

                cachedOwner = owner;
                cachedFirstFormal = firstFormal;
                cachedFormalCount = formalCount;
            }
        }
        else if (ownerKind == 0x16 && ownerRow > 0 && ownerRow <= methodDefCount)
        {
            if (owner != cachedOwner)
            {
                init uint32 signature;
                init uint32 firstFormal;
                init uint32 formalCount;
                int32 ownerOffset = (ownerRow - 1) * 28;
                if (!TryReadMethodDefTableWord(ownerOffset, 8, ref init signature)
                    || signature == 0 || signature > uint32(methodSigCount)
                    || !TryReadMethodSignatureWord((int32(signature) - 1) * 24, 16,
                        ref init firstFormal)
                    || !TryReadMethodSignatureWord((int32(signature) - 1) * 24, 20,
                        ref init formalCount))
                {
                    return false;
                }

                cachedOwner = owner;
                cachedFirstFormal = firstFormal;
                cachedFormalCount = formalCount;
            }
        }
        else
        {
            return false;
        }

        if (cachedFormalCount == 0 || uint32(row) < cachedFirstFormal
            || uint32(row) >= cachedFirstFormal + cachedFormalCount
            || ordinal != uint32(row) - cachedFirstFormal
            || !TryGetValidatedVariableTableRowExtent(stringCount, 8, 4, int32(name),
                ref init nameOffset, ref init nameLength)
            || !TryGetStringNameScalarCount(stringIndexByteLength + int32(nameOffset),
                nameLength, ref init nameScalarCount))
        {
            return false;
        }

        for (mut uint32 constraint = firstConstraint;
            constraint < firstConstraint + constraintRangeCount;
            constraint = constraint + 1)
        {
            int32 constraintRow = int32(constraint);
            if (Host.ConstraintOwners[constraintRow] != 0)
            {
                return false;
            }
            Host.ConstraintOwners[constraintRow] = row;
        }
    }

    for (mut int32 constraint = 1; constraint <= constraintCount; constraint = constraint + 1)
    {
        if (Host.ConstraintOwners[constraint] == 0)
        {
            return false;
        }
    }

    return true;
}

bool IsValidGenericParamRange(uint32 first, uint32 count, int32 total)
{
    if (count == 0)
    {
        return first == 0;
    }

    return first != 0 && first <= uint32(total)
        && count <= uint32(total) - first + 1;
}

bool TryReadGenericParamTableWord(int32 rowStart, int32 offset, ref<init uint32> value)
{
    init int32 first;
    init int32 second;
    init int32 third;
    init int32 fourth;
    if (rowStart < 0 || rowStart > Host.GenericParams.Length - 32
        || offset < 0 || offset > 28
        || !TryReadGenericParamTableByte(rowStart + offset, ref init first)
        || !TryReadGenericParamTableByte(rowStart + offset + 1, ref init second)
        || !TryReadGenericParamTableByte(rowStart + offset + 2, ref init third)
        || !TryReadGenericParamTableByte(rowStart + offset + 3, ref init fourth))
    {
        return false;
    }

    *value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool TryReadGenericParamTableByte(int32 offset, ref<init int32> value)
{
    if (offset < 0 || offset >= Host.GenericParams.Length)
    {
        return false;
    }

    int32 part = Host.GenericParams[offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    *value = part;
    return true;
}
