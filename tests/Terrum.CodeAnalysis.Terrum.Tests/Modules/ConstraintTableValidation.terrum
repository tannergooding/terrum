namespace Terrum.CodeAnalysis;

public static bool TryValidateConstraintTable(int32 recordCount,
    int32 moduleCount, int32 stringCount, int32 moduleRefCount,
    int32 typeDefCount, int32 methodDefCount, int32 sourceFileCount,
    int32 featureCount, int32 fieldCount, int32 genericParamCount,
    int32 layoutCount, int32 contractCount, int32 methodSigCount,
    int32 typeSpecCount, int32 constraintCount, int32 bodyCount)
{
    if (recordCount < 0 || recordCount > 0xFF_FFFF
        || recordCount != constraintCount
        || typeSpecCount < 0 || typeSpecCount > 0xFF_FFFF
        || recordCount * 12 != Host.Constraints.Length
        || !TryValidateGenericParamTable(genericParamCount, moduleCount, stringCount,
            moduleRefCount, typeDefCount, methodDefCount, sourceFileCount,
            featureCount, fieldCount, genericParamCount, layoutCount, contractCount,
            methodSigCount, typeSpecCount, constraintCount, bodyCount))
    {
        return false;
    }

    if (Host.AssociatedRelations.Length > 201326580)
    {
        return false;
    }

    int32 associatedRelationCount = Host.AssociatedRelations.Length / 12;
    if (associatedRelationCount * 12 != Host.AssociatedRelations.Length)
    {
        return false;
    }

    for (mut int32 row = 1; row <= recordCount; row = row + 1)
    {
        init uint32 owner;
        init int32 kind;
        init int32 flags;
        init uint32 payload;
        int32 rowStart = (row - 1) * 12;
        if (!TryReadConstraintTableWord(rowStart, 0, ref init owner)
            || !TryReadConstraintTableHalfWord(rowStart + 4, ref init kind)
            || !TryReadConstraintTableHalfWord(rowStart + 6, ref init flags)
            || !TryReadConstraintTableWord(rowStart, 8, ref init payload)
            || owner != uint32(Host.ConstraintOwners[row])
            || flags != 0 || payload == 0
            || (kind == 1 && payload > uint32(typeSpecCount))
            || (kind == 2 && payload > 3)
            || (kind != 1 && kind != 2 && kind != 3))
        {
            return false;
        }

        if (kind == 3)
        {
            if (owner == 0 || owner > uint32(genericParamCount))
            {
                return false;
            }

            int32 formalOffset = (int32(owner) - 1) * 32;
            if (Host.GenericParams[formalOffset + 20] != 1
                || payload > uint32(associatedRelationCount))
            {
                return false;
            }
        }
    }

    return true;
}

bool TryReadConstraintTableWord(int32 rowStart, int32 offset, ref<init uint32> value)
{
    init int32 first;
    init int32 second;
    init int32 third;
    init int32 fourth;
    if (rowStart < 0 || rowStart > Host.Constraints.Length - 12
        || offset < 0 || offset > 8
        || !TryReadConstraintTableByte(rowStart + offset, ref init first)
        || !TryReadConstraintTableByte(rowStart + offset + 1, ref init second)
        || !TryReadConstraintTableByte(rowStart + offset + 2, ref init third)
        || !TryReadConstraintTableByte(rowStart + offset + 3, ref init fourth))
    {
        return false;
    }

    *value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool TryReadConstraintTableHalfWord(int32 offset, ref<init int32> value)
{
    init int32 first;
    init int32 second;
    if (offset < 0 || offset > Host.Constraints.Length - 2
        || !TryReadConstraintTableByte(offset, ref init first)
        || !TryReadConstraintTableByte(offset + 1, ref init second))
    {
        return false;
    }

    *value = first | (second << 8);
    return true;
}

bool TryReadConstraintTableByte(int32 offset, ref<init int32> value)
{
    if (offset < 0 || offset >= Host.Constraints.Length)
    {
        return false;
    }

    int32 part = Host.Constraints[offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    *value = part;
    return true;
}
