namespace Terrum.CodeAnalysis;

public static bool TryValidatePropertyDefTable(int32 recordCount,
    int32 stringCount, int32 typeDefCount, int32 typeSpecCount,
    int32 methodDefCount, int32 methodSigCount)
{
    if (recordCount <= 0 || recordCount > 0xFF_FFFF
        || stringCount < 0 || stringCount > 0xFF_FFFF
        || typeDefCount < 0 || typeDefCount > 0xFF_FFFF
        || typeSpecCount < 0 || typeSpecCount > 0xFF_FFFF
        || methodDefCount < 0 || methodDefCount > 0xFF_FFFF
        || methodSigCount < 0 || methodSigCount > 0xFF_FFFF
        || recordCount * 20 != Host.Properties.Length
        || typeDefCount * 44 != Host.TypeDefs.Length
        || methodDefCount * 28 != Host.Methods.Length
        || methodSigCount * 24 != Host.Signatures.Length)
    {
        return false;
    }

    int32 stringIndexByteLength = (stringCount + 1) * 4;
    if (!TryValidateVariableTableIndex(stringCount, 8, 4))
    {
        return false;
    }

    for (mut int32 row = 1; row <= recordCount; row = row + 1)
    {
        init uint32 owner;
        init uint32 name;
        init uint32 type;
        init uint32 getter;
        init uint32 flags;
        init int32 nameOffset;
        init int32 nameLength;
        init int32 nameScalarCount;
        init uint32 getterOwner;
        init uint32 signature;
        init uint32 resultType;
        int32 rowStart = (row - 1) * 20;
        if (!TryReadPropertyTableWord(rowStart, 0, ref init owner)
            || !TryReadPropertyTableWord(rowStart, 4, ref init name)
            || !TryReadPropertyTableWord(rowStart, 8, ref init type)
            || !TryReadPropertyTableWord(rowStart, 12, ref init getter)
            || !TryReadPropertyTableWord(rowStart, 16, ref init flags)
            || owner == 0 || owner > uint32(typeDefCount)
            || name == 0 || name > 0xFF_FFFF || name > uint32(stringCount)
            || type == 0 || type > uint32(typeSpecCount)
            || getter == 0 || getter > uint32(methodDefCount)
            || flags > 2
            || !TryGetValidatedVariableTableRowExtent(stringCount, 8, 4, int32(name),
                ref init nameOffset, ref init nameLength)
            || !TryGetStringNameScalarCount(stringIndexByteLength + int32(nameOffset),
                nameLength, ref init nameScalarCount)
            || !TryReadPropertyMethodWord((int32(getter) - 1) * 28, 0,
                ref init getterOwner)
            || getterOwner != owner
            || !TryReadPropertyMethodWord((int32(getter) - 1) * 28, 8,
                ref init signature)
            || signature == 0 || signature > uint32(methodSigCount)
            || !TryReadPropertySignatureWord((int32(signature) - 1) * 24, 0,
                ref init resultType)
            || resultType != type)
        {
            return false;
        }
    }

    return true;
}

bool TryReadPropertyTableWord(int32 rowStart, int32 offset, ref<init uint32> value)
{
    init int32 first;
    init int32 second;
    init int32 third;
    init int32 fourth;
    if (rowStart < 0 || rowStart > Host.Properties.Length - 20
        || offset < 0 || offset > 16
        || !TryReadPropertyTableByte(rowStart + offset, ref init first)
        || !TryReadPropertyTableByte(rowStart + offset + 1, ref init second)
        || !TryReadPropertyTableByte(rowStart + offset + 2, ref init third)
        || !TryReadPropertyTableByte(rowStart + offset + 3, ref init fourth))
    {
        return false;
    }

    *value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool TryReadPropertyTableByte(int32 offset, ref<init int32> value)
{
    if (offset < 0 || offset >= Host.Properties.Length)
    {
        return false;
    }

    int32 part = Host.Properties[offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    *value = part;
    return true;
}

bool TryReadPropertyMethodWord(int32 rowStart, int32 offset, ref<init uint32> value)
{
    init int32 first;
    init int32 second;
    init int32 third;
    init int32 fourth;
    if (rowStart < 0 || rowStart > Host.Methods.Length - 28
        || offset < 0 || offset > 24
        || !TryReadPropertyMethodByte(rowStart + offset, ref init first)
        || !TryReadPropertyMethodByte(rowStart + offset + 1, ref init second)
        || !TryReadPropertyMethodByte(rowStart + offset + 2, ref init third)
        || !TryReadPropertyMethodByte(rowStart + offset + 3, ref init fourth))
    {
        return false;
    }

    *value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool TryReadPropertyMethodByte(int32 offset, ref<init int32> value)
{
    if (offset < 0 || offset >= Host.Methods.Length)
    {
        return false;
    }

    int32 part = Host.Methods[offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    *value = part;
    return true;
}

bool TryReadPropertySignatureWord(int32 rowStart, int32 offset, ref<init uint32> value)
{
    init int32 first;
    init int32 second;
    init int32 third;
    init int32 fourth;
    if (rowStart < 0 || rowStart > Host.Signatures.Length - 24
        || offset < 0 || offset > 20
        || !TryReadPropertySignatureByte(rowStart + offset, ref init first)
        || !TryReadPropertySignatureByte(rowStart + offset + 1, ref init second)
        || !TryReadPropertySignatureByte(rowStart + offset + 2, ref init third)
        || !TryReadPropertySignatureByte(rowStart + offset + 3, ref init fourth))
    {
        return false;
    }

    *value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool TryReadPropertySignatureByte(int32 offset, ref<init int32> value)
{
    if (offset < 0 || offset >= Host.Signatures.Length)
    {
        return false;
    }

    int32 part = Host.Signatures[offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    *value = part;
    return true;
}
