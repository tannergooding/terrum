namespace Terrum.CodeAnalysis;

public static bool TryValidateModuleTable(int32 recordCount, int32 stringCount,
    int32 moduleRefCount, int32 typeDefCount, int32 methodDefCount,
    int32 sourceFileCount, int32 featureCount)
{
    init int32 firstStringStart;
    init int32 firstStringLength;
    if (recordCount <= 0 || recordCount > 0xFF_FFFF
        || !IsValidModuleTableCount(moduleRefCount)
        || !IsValidModuleTableCount(typeDefCount)
        || !IsValidModuleTableCount(methodDefCount)
        || !IsValidModuleTableCount(sourceFileCount)
        || featureCount < -1 || featureCount > 0xFF_FFFF
        || recordCount * 48 != Host.Modules.Length
        || Host.IdentitySlots.Length != recordCount + 1
        || !TryGetVariableTableRowExtent(stringCount, 8, 4, 1,
            ref init firstStringStart, ref init firstStringLength))
    {
        return false;
    }

    int32 stringIndexByteLength = (stringCount + 1) * 4;
    for (mut int32 slot = 0; slot <= recordCount; slot = slot + 1)
    {
        Host.IdentitySlots[slot] = 0;
    }

    mut uint32 previousModuleRefStart = 0;
    mut uint32 previousTypeDefStart = 0;
    mut uint32 previousMethodDefStart = 0;
    mut uint32 previousSourceFileStart = 0;
    for (mut int32 row = 1; row <= recordCount; row = row + 1)
    {
        init uint32 moduleRefStart;
        init uint32 typeDefStart;
        init uint32 methodDefStart;
        init uint32 sourceFileStart;
        if (!TryValidateModuleRow(row, recordCount, stringCount, moduleRefCount,
            typeDefCount, methodDefCount, sourceFileCount, featureCount,
            stringIndexByteLength, previousModuleRefStart, previousTypeDefStart,
            previousMethodDefStart, previousSourceFileStart,
            ref init moduleRefStart, ref init typeDefStart,
            ref init methodDefStart, ref init sourceFileStart))
        {
            return false;
        }

        previousModuleRefStart = moduleRefStart;
        previousTypeDefStart = typeDefStart;
        previousMethodDefStart = methodDefStart;
        previousSourceFileStart = sourceFileStart;
    }

    return TrySortAndCheckModuleIdentities(recordCount, stringCount, stringIndexByteLength);
}

bool TryValidateModuleRow(int32 row, int32 recordCount, int32 stringCount,
    int32 moduleRefCount, int32 typeDefCount, int32 methodDefCount,
    int32 sourceFileCount, int32 featureCount, int32 stringIndexByteLength,
    uint32 previousModuleRefStart, uint32 previousTypeDefStart,
    uint32 previousMethodDefStart, uint32 previousSourceFileStart,
    ref<init uint32> moduleRefStartResult, ref<init uint32> typeDefStartResult,
    ref<init uint32> methodDefStartResult, ref<init uint32> sourceFileStartResult)
    ensure return ? (*moduleRefStartResult is init
        && *typeDefStartResult is init
        && *methodDefStartResult is init
        && *sourceFileStartResult is init) : true
{
    init uint32 identity;
    init uint32 governingRuleEdition;
    init uint32 targetRequirement;
    init uint32 runtimePolicy;
    init uint32 entryMethod;
    init uint32 moduleFlags;
    init uint32 featureFirst;
    init uint32 featureRangeCount;
    init uint32 moduleRefStart;
    init uint32 typeDefStart;
    init uint32 methodDefStart;
    init uint32 sourceFileStart;
    init int32 identityStart;
    init int32 identityLength;
    init int32 identityEncoding;
    init int32 identityContentLength;
    int32 rowStart = (row - 1) * 48;
    if (!TryReadModuleTableWord(rowStart, 0, ref init identity)
        || !TryReadModuleTableWord(rowStart, 4, ref init governingRuleEdition)
        || !TryReadModuleTableWord(rowStart, 8, ref init targetRequirement)
        || !TryReadModuleTableWord(rowStart, 12, ref init runtimePolicy)
        || !TryReadModuleTableWord(rowStart, 16, ref init entryMethod)
        || !TryReadModuleTableWord(rowStart, 20, ref init moduleFlags)
        || !TryReadModuleTableWord(rowStart, 24, ref init featureFirst)
        || !TryReadModuleTableWord(rowStart, 28, ref init featureRangeCount)
        || !TryReadModuleTableWord(rowStart, 32, ref init moduleRefStart)
        || !TryReadModuleTableWord(rowStart, 36, ref init typeDefStart)
        || !TryReadModuleTableWord(rowStart, 40, ref init methodDefStart)
        || !TryReadModuleTableWord(rowStart, 44, ref init sourceFileStart))
    {
        return false;
    }

    if (identity == 0 || identity > 0xFF_FFFF || identity > uint32(stringCount)
        || governingRuleEdition != 1
        || targetRequirement > 1 || runtimePolicy > 1
        || !IsValidModuleFeatureRange(featureFirst, featureRangeCount, featureCount)
        || moduleFlags != 0
        || !IsValidModuleCursor(moduleRefStart, moduleRefCount)
        || !IsValidModuleCursor(typeDefStart, typeDefCount)
        || !IsValidModuleCursor(methodDefStart, methodDefCount)
        || !IsValidModuleCursor(sourceFileStart, sourceFileCount))
    {
        return false;
    }

    if (row == 1)
    {
        if (moduleRefStart != 1 || typeDefStart != 1
            || methodDefStart != 1 || sourceFileStart != 1)
        {
            return false;
        }
    }
    else if (moduleRefStart < previousModuleRefStart
        || typeDefStart < previousTypeDefStart
        || methodDefStart < previousMethodDefStart
        || sourceFileStart < previousSourceFileStart)
    {
        return false;
    }

    mut uint32 methodEnd = uint32(methodDefCount + 1);
    if (row < recordCount)
    {
        init uint32 nextMethodStart;
        if (!TryReadModuleTableWord(row * 48, 40, ref init nextMethodStart))
        {
            return false;
        }
        methodEnd = nextMethodStart;
    }
    if (entryMethod != 0 && (entryMethod < methodDefStart || entryMethod >= methodEnd))
    {
        return false;
    }

    if (!TryGetValidatedModuleIdentityExtent(stringCount, stringIndexByteLength,
            int32(identity), ref init identityStart, ref init identityLength,
            ref init identityEncoding, ref init identityContentLength)
        || !TryValidateModuleIdentityText(identityStart, identityContentLength, identityEncoding))
    {
        return false;
    }

    Host.IdentitySlots[row] = row;
    *moduleRefStartResult = moduleRefStart;
    *typeDefStartResult = typeDefStart;
    *methodDefStartResult = methodDefStart;
    *sourceFileStartResult = sourceFileStart;
    return true;
}

bool TrySortAndCheckModuleIdentities(int32 recordCount, int32 stringCount,
    int32 stringIndexByteLength)
{
    mut int32 root = recordCount / 2;
    while (root > 0)
    {
        if (!TrySiftModuleIdentityHeap(root, recordCount, stringCount, stringIndexByteLength))
        {
            return false;
        }
        root = root - 1;
    }

    mut int32 heapEnd = recordCount;
    while (heapEnd > 1)
    {
        mut int32 value = Host.IdentitySlots[1];
        Host.IdentitySlots[1] = Host.IdentitySlots[heapEnd];
        Host.IdentitySlots[heapEnd] = value;
        heapEnd = heapEnd - 1;
        if (!TrySiftModuleIdentityHeap(1, heapEnd, stringCount, stringIndexByteLength))
        {
            return false;
        }
    }

    for (mut int32 row = 2; row <= recordCount; row = row + 1)
    {
        init int32 comparison;
        if (!TryCompareModuleRowsByIdentity(stringCount, stringIndexByteLength,
            Host.IdentitySlots[row - 1], Host.IdentitySlots[row], ref init comparison)
            || comparison == 0)
        {
            return false;
        }
    }

    return true;
}

bool TrySiftModuleIdentityHeap(int32 root, int32 heapEnd,
    int32 stringCount, int32 stringIndexByteLength)
{
    mut int32 current = root;
    while (current <= heapEnd / 2)
    {
        init int32 parentComparison;
        mut int32 child = current * 2;
        if (child < heapEnd)
        {
            init int32 childComparison;
            if (!TryCompareModuleRowsByIdentity(stringCount, stringIndexByteLength,
                Host.IdentitySlots[child], Host.IdentitySlots[child + 1], ref init childComparison))
            {
                return false;
            }
            if (childComparison < 0)
            {
                child = child + 1;
            }
        }

        if (!TryCompareModuleRowsByIdentity(stringCount, stringIndexByteLength,
            Host.IdentitySlots[current], Host.IdentitySlots[child], ref init parentComparison))
        {
            return false;
        }
        if (parentComparison >= 0)
        {
            break;
        }

        mut int32 value = Host.IdentitySlots[current];
        Host.IdentitySlots[current] = Host.IdentitySlots[child];
        Host.IdentitySlots[child] = value;
        current = child;
    }

    return true;
}

bool TryCompareModuleRowsByIdentity(int32 stringCount, int32 stringIndexByteLength,
    int32 firstModuleRow, int32 secondModuleRow, ref<init int32> comparison)
    ensure return ? *comparison is init : true
{
    init uint32 firstIdentity;
    init uint32 secondIdentity;
    if (firstModuleRow == secondModuleRow)
    {
        *comparison = 0;
        return true;
    }
    if (!TryReadModuleTableWord((firstModuleRow - 1) * 48, 0, ref init firstIdentity)
        || !TryReadModuleTableWord((secondModuleRow - 1) * 48, 0, ref init secondIdentity))
    {
        return false;
    }

    return TryCompareModuleIdentityRows(stringCount, stringIndexByteLength,
        int32(firstIdentity), int32(secondIdentity), ref init *comparison);
}

bool TryCompareModuleIdentityRows(int32 stringCount, int32 stringIndexByteLength,
    int32 firstRow, int32 secondRow, ref<init int32> comparison)
    ensure return ? *comparison is init : true
{
    init int32 firstStart;
    init int32 firstEncoding;
    init int32 firstContentLength;
    init int32 secondStart;
    init int32 secondEncoding;
    init int32 secondContentLength;
    if (firstRow == secondRow)
    {
        *comparison = 0;
        return true;
    }
    if (!TryGetModuleIdentityDecodeInfo(stringCount, stringIndexByteLength, firstRow,
            ref init firstStart, ref init firstEncoding, ref init firstContentLength)
        || !TryGetModuleIdentityDecodeInfo(stringCount, stringIndexByteLength, secondRow,
            ref init secondStart, ref init secondEncoding, ref init secondContentLength))
    {
        return false;
    }

    mut int32 firstPosition = 0;
    mut int32 secondPosition = 0;
    while (true)
    {
        init int32 firstScalar;
        init int32 firstBytesRead;
        init int32 secondScalar;
        init int32 secondBytesRead;
        if (firstPosition == firstContentLength || secondPosition == secondContentLength)
        {
            if (firstPosition == firstContentLength && secondPosition == secondContentLength)
            {
                *comparison = 0;
            }
            else if (firstPosition == firstContentLength)
            {
                *comparison = -1;
            }
            else
            {
                *comparison = 1;
            }
            return true;
        }

        if (!TryDecodeStringRowScalar(firstStart, firstPosition, firstContentLength, firstEncoding,
                ref init firstScalar, ref init firstBytesRead)
            || !TryDecodeStringRowScalar(secondStart, secondPosition, secondContentLength, secondEncoding,
                ref init secondScalar, ref init secondBytesRead))
        {
            return false;
        }
        if (firstScalar != secondScalar)
        {
            *comparison = firstScalar < secondScalar ? -1 : 1;
            return true;
        }

        firstPosition = firstPosition + firstBytesRead;
        secondPosition = secondPosition + secondBytesRead;
    }
}

// Requires the identity slots left sorted by TryValidateModuleTable.
bool TryFindModuleTableRowByIdentity(int32 moduleCount, int32 stringCount,
    int32 stringIndexByteLength, int32 identityStringRow, ref<init int32> moduleRow)
    ensure return ? *moduleRow is init : true
{
    if (identityStringRow <= 0 || identityStringRow > stringCount)
    {
        return false;
    }

    mut int32 low = 1;
    mut int32 high = moduleCount;
    while (low <= high)
    {
        init uint32 candidateIdentity;
        init int32 comparison;
        int32 middle = low + (high - low) / 2;
        int32 candidateModuleRow = Host.IdentitySlots[middle];
        if (!TryReadModuleTableWord((candidateModuleRow - 1) * 48, 0,
                ref init candidateIdentity)
            || !TryCompareModuleIdentityRows(stringCount, stringIndexByteLength,
                int32(candidateIdentity), identityStringRow, ref init comparison))
        {
            return false;
        }

        if (comparison == 0)
        {
            *moduleRow = candidateModuleRow;
            return true;
        }
        if (comparison < 0)
        {
            low = middle + 1;
        }
        else
        {
            high = middle - 1;
        }
    }

    *moduleRow = 0;
    return true;
}

// The outer pass validates the complete index and each referenced row before comparisons.
bool TryGetModuleIdentityDecodeInfo(int32 stringCount, int32 stringIndexByteLength,
    int32 row, ref<init int32> rowStart, ref<init int32> encoding,
    ref<init int32> contentByteLength)
    ensure return ? (*rowStart is init
        && *encoding is init
        && *contentByteLength is init) : true
{
    init uint32 startOffset;
    init uint32 endOffset;
    if (row < 1 || row > stringCount
        || !TryReadVariableTableOffset(row - 1, ref init startOffset)
        || !TryReadVariableTableOffset(row, ref init endOffset))
    {
        return false;
    }

    int32 start = stringIndexByteLength + int32(startOffset);
    int32 length = int32(endOffset - startOffset);
    if (length < 8 || start < 0 || start > Host.Rows.Length - length)
    {
        return false;
    }

    int32 rowEncoding = Host.Rows[start];
    if (rowEncoding < 0 || rowEncoding > 3)
    {
        return false;
    }

    mut int32 width = 1;
    if (rowEncoding == 2) { width = 2; }
    else if (rowEncoding == 3) { width = 4; }
    int32 units = Host.Rows[start + 1]
        | (Host.Rows[start + 2] << 8) | (Host.Rows[start + 3] << 16);
    *rowStart = start;
    *encoding = rowEncoding;
    *contentByteLength = units * width;
    return true;
}

bool TryValidateModuleIdentityText(int32 rowStart, int32 contentByteLength, int32 encoding)
{
    mut int32 position = 0;
    mut int32 scalarCount = 0;
    while (position < contentByteLength)
    {
        init int32 scalar;
        init int32 bytesRead;
        if (!TryDecodeStringRowScalar(rowStart, position, contentByteLength, encoding,
            ref init scalar, ref init bytesRead))
        {
            return false;
        }

        scalarCount = scalarCount + 1;
        position = position + bytesRead;
    }

    return scalarCount > 0;
}

bool TryGetValidatedModuleIdentityExtent(int32 stringCount, int32 stringIndexByteLength,
    int32 row, ref<init int32> rowStart, ref<init int32> rowLength,
    ref<init int32> encoding, ref<init int32> contentByteLength)
    ensure return ? (*rowStart is init
        && *rowLength is init
        && *encoding is init
        && *contentByteLength is init) : true
{
    init uint32 startOffset;
    init uint32 endOffset;
    init int32 rowEncoding;
    init int32 rowContentLength;
    if (row < 1 || row > stringCount
        || !TryReadVariableTableOffset(row - 1, ref init startOffset)
        || !TryReadVariableTableOffset(row, ref init endOffset))
    {
        return false;
    }

    int32 start = stringIndexByteLength + int32(startOffset);
    int32 length = int32(endOffset - startOffset);
    if (!TryGetStringRowLayout(start, length,
        ref init rowEncoding, ref init rowContentLength))
    {
        return false;
    }

    *rowStart = start;
    *rowLength = length;
    *encoding = rowEncoding;
    *contentByteLength = rowContentLength;
    return true;
}

bool TryReadModuleTableWord(int32 rowStart, int32 offset, ref<init uint32> value)
    ensure return ? *value is init : true
{
    init int32 first;
    init int32 second;
    init int32 third;
    init int32 fourth;
    if (rowStart < 0 || rowStart > Host.Modules.Length - 48 || offset < 0 || offset > 44
        || !TryReadModuleTableByte(rowStart + offset, ref init first)
        || !TryReadModuleTableByte(rowStart + offset + 1, ref init second)
        || !TryReadModuleTableByte(rowStart + offset + 2, ref init third)
        || !TryReadModuleTableByte(rowStart + offset + 3, ref init fourth))
    {
        return false;
    }

    *value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool TryReadModuleTableByte(int32 offset, ref<init int32> value)
    ensure return ? *value is init : true
{
    if (offset < 0 || offset >= Host.Modules.Length)
    {
        return false;
    }

    int32 part = Host.Modules[offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    *value = part;
    return true;
}

bool IsValidModuleFeatureRange(uint32 first, uint32 count, int32 featureCount)
{
    if (first == 0 && count == 0)
    {
        return true;
    }
    if (first == 0 || count == 0
        || first > 0xFF_FFFF || count > 0xFF_FFFF
        || count - 1 > 0xFF_FFFF - first)
    {
        return false;
    }

    return featureCount < 0
        || (first <= uint32(featureCount + 1)
            && count <= uint32(featureCount + 1) - first);
}

bool IsValidModuleCursor(uint32 start, int32 tableCount)
{
    return start != 0 && start <= uint32(tableCount + 1);
}

bool IsValidModuleTableCount(int32 count)
{
    return count >= 0 && count <= 0xFF_FFFF;
}
