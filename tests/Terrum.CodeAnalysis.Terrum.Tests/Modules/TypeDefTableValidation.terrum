namespace Terrum.CodeAnalysis;

public static bool TryValidateTypeDefTable(int32 recordCount, int32 moduleCount,
    int32 stringCount, int32 moduleRefCount, int32 typeDefCount, int32 methodDefCount,
    int32 sourceFileCount, int32 featureCount, int32 fieldCount, int32 genericParamCount,
    int32 layoutCount, int32 contractCount)
{
    if (recordCount < 0 || recordCount > 0xFF_FFFF
        || recordCount != typeDefCount
        || recordCount * 44 != Host.TypeDefs.Length
        || !IsValidTypeDefTableCount(fieldCount)
        || !IsValidTypeDefTableCount(genericParamCount)
        || !IsValidTypeDefTableCount(layoutCount)
        || !IsValidTypeDefTableCount(contractCount)
        || (recordCount == 0
            && (fieldCount != 0 || genericParamCount != 0
                || layoutCount != 0 || contractCount != 0))
        || Host.FieldOwners.Length != fieldCount + 1
        || !TryValidateModuleTable(moduleCount, stringCount, moduleRefCount,
            typeDefCount, methodDefCount, sourceFileCount, featureCount))
    {
        return false;
    }

    int32 stringIndexByteLength = (stringCount + 1) * 4;
    for (mut int32 field = 0; field <= fieldCount; field = field + 1)
    {
        Host.FieldOwners[field] = 0;
    }

    for (mut int32 row = 1; row <= recordCount; row = row + 1)
    {
        if (!TryValidateTypeDefRow(row, stringCount, stringIndexByteLength,
            fieldCount, genericParamCount, layoutCount, contractCount))
        {
            return false;
        }
    }

    for (mut int32 field = 1; field <= fieldCount; field = field + 1)
    {
        if (Host.FieldOwners[field] == 0)
        {
            return false;
        }
    }

    return true;
}

bool TryValidateTypeDefRow(int32 row, int32 stringCount, int32 stringIndexByteLength,
    int32 fieldCount, int32 genericParamCount, int32 layoutCount, int32 contractCount)
{
    init uint32 namespaceRow;
    init uint32 nameRow;
    init uint32 flags;
    init uint32 fieldFirst;
    init uint32 fieldRangeCount;
    init uint32 genericFirst;
    init uint32 genericRangeCount;
    init uint32 layoutFirst;
    init uint32 layoutRangeCount;
    init uint32 contractFirst;
    init uint32 contractRangeCount;
    init int32 namespaceStart;
    init int32 namespaceLength;
    init int32 namespaceEncoding;
    init int32 namespaceContentLength;
    init int32 nameStart;
    init int32 nameLength;
    init int32 nameEncoding;
    init int32 nameContentLength;
    init int32 namespaceScalarCount;
    int32 rowStart = (row - 1) * 44;
    if (!TryReadTypeDefTableWord(rowStart, 0, ref init namespaceRow)
        || !TryReadTypeDefTableWord(rowStart, 4, ref init nameRow)
        || !TryReadTypeDefTableWord(rowStart, 8, ref init flags)
        || !TryReadTypeDefTableWord(rowStart, 12, ref init fieldFirst)
        || !TryReadTypeDefTableWord(rowStart, 16, ref init fieldRangeCount)
        || !TryReadTypeDefTableWord(rowStart, 20, ref init genericFirst)
        || !TryReadTypeDefTableWord(rowStart, 24, ref init genericRangeCount)
        || !TryReadTypeDefTableWord(rowStart, 28, ref init layoutFirst)
        || !TryReadTypeDefTableWord(rowStart, 32, ref init layoutRangeCount)
        || !TryReadTypeDefTableWord(rowStart, 36, ref init contractFirst)
        || !TryReadTypeDefTableWord(rowStart, 40, ref init contractRangeCount)
        || namespaceRow == 0 || namespaceRow > 0xFF_FFFF
        || namespaceRow > uint32(stringCount)
        || nameRow == 0 || nameRow > 0xFF_FFFF || nameRow > uint32(stringCount)
        || flags > 0x0F || (flags & 3) == 3 || ((flags >> 2) & 3) == 0
        || !IsValidTypeDefTableRange(fieldFirst, fieldRangeCount, fieldCount)
        || !IsValidTypeDefTableRange(genericFirst, genericRangeCount, genericParamCount)
        || !IsValidTypeDefTableRange(contractFirst, contractRangeCount, contractCount)
        || !IsValidTypeDefTableRange(layoutFirst, layoutRangeCount, layoutCount))
    {
        return false;
    }

    if (!TryGetValidatedModuleIdentityExtent(stringCount, stringIndexByteLength,
            int32(namespaceRow), ref init namespaceStart, ref init namespaceLength,
            ref init namespaceEncoding, ref init namespaceContentLength)
        || !TryGetValidatedModuleIdentityExtent(stringCount, stringIndexByteLength,
            int32(nameRow), ref init nameStart, ref init nameLength,
            ref init nameEncoding, ref init nameContentLength)
        || !TryGetStringNamespaceScalarCount(namespaceStart, namespaceLength,
            ref init namespaceScalarCount)
        || !TryValidateModuleIdentityText(nameStart, nameContentLength, nameEncoding))
    {
        return false;
    }

    for (mut uint32 field = fieldFirst; field < fieldFirst + fieldRangeCount; field = field + 1)
    {
        if (Host.FieldOwners[int32(field)] != 0)
        {
            return false;
        }

        Host.FieldOwners[int32(field)] = row;
    }

    return true;
}

bool IsValidTypeDefTableRange(uint32 first, uint32 count, int32 total)
{
    if (count == 0)
    {
        return first == 0;
    }

    return first != 0 && first <= uint32(total)
        && count <= uint32(total) - first + 1;
}

bool IsValidTypeDefTableCount(int32 count)
    => count >= 0 && count <= 0xFF_FFFF;

bool TryReadTypeDefTableWord(int32 rowStart, int32 offset,
    ref<init uint32> value)
    ensure return ? *value is init : true
{
    init int32 first;
    init int32 second;
    init int32 third;
    init int32 fourth;
    if (rowStart < 0 || rowStart > Host.TypeDefs.Length - 44
        || offset < 0 || offset > 40
        || !TryReadTypeDefTableByte(rowStart + offset, ref init first)
        || !TryReadTypeDefTableByte(rowStart + offset + 1, ref init second)
        || !TryReadTypeDefTableByte(rowStart + offset + 2, ref init third)
        || !TryReadTypeDefTableByte(rowStart + offset + 3, ref init fourth))
    {
        return false;
    }

    *value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool TryReadTypeDefTableByte(int32 offset, ref<init int32> value)
    ensure return ? *value is init : true
{
    if (offset < 0 || offset >= Host.TypeDefs.Length)
    {
        return false;
    }

    int32 part = Host.TypeDefs[offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    *value = part;
    return true;
}
