namespace Terrum.CodeAnalysis;

public static bool TryValidateTypeSpecTable(int32 recordCount, int32 typeDefCount,
    int32 importCount, int32 genericParamCount)
{
    if (!IsValidTypeSpecCount(typeDefCount) || !IsValidTypeSpecCount(importCount)
        || !IsValidTypeSpecCount(genericParamCount)
        || recordCount <= 0 || recordCount > 16777215
        || recordCount > Host.TypeSpecs.Length / 4 - 1)
    {
        return false;
    }

    int32 indexByteLength = (recordCount + 1) * 4;
    int32 dataByteLength = Host.TypeSpecs.Length - indexByteLength;
    if (dataByteLength < 2
        || !TryReadTypeSpecTableOffset(0, init var firstOffset)
        || firstOffset != 0)
    {
        return false;
    }

    mut uint32 previousOffset = firstOffset;
    for (mut int32 row = 1; row <= recordCount; row = row + 1)
    {
        if (!TryReadTypeSpecTableOffset(row, init var nextOffset)
            || nextOffset > uint32(dataByteLength)
            || previousOffset > uint32(dataByteLength - 2)
            || nextOffset < previousOffset + 2)
        {
            return false;
        }

        int32 rowStart = indexByteLength + int32(previousOffset);
        int32 rowLength = int32(nextOffset - previousOffset);
        if (!TryValidateTypeSpecRow(row, indexByteLength,
                rowStart, rowLength, typeDefCount, importCount, genericParamCount))
        {
            return false;
        }

        previousOffset = nextOffset;
    }

    if (previousOffset != uint32(dataByteLength))
    {
        return false;
    }

    return true;
}

bool TryValidateTypeSpecRow(int32 row, int32 indexByteLength,
    int32 rowStart, int32 rowLength,
    int32 typeDefCount, int32 importCount, int32 genericParamCount)
{
    if (rowLength < 2
        || !TryReadTypeSpecByte(rowStart, rowLength, 0, init var form)
        || !TryReadTypeSpecByte(rowStart, rowLength, 1, init var qualifiers)
        || (qualifiers & 0xF8) != 0)
    {
        return false;
    }

    if (form == 1)
    {
        if (!TryReadTypeSpecByte(rowStart, rowLength, 2, init var code))
        {
            return false;
        }

        if (code <= 0x19)
        {
            return rowLength == 3 && qualifiers == 0;
        }
        if (!IsAssignedTypeSpecFamily(code) || rowLength != 4
            || !TryReadTypeSpecByte(rowStart, rowLength, 3, init var argumentCode)
            || argumentCode > 0x19
            || ((qualifiers & 0x02) != 0 && code != 0x8B && code != 0x8D))
        {
            return false;
        }

        return true;
    }

    if (form >= 2 && form <= 4)
    {
        if (rowLength != 6
            || !TryReadTypeSpecWord(rowStart, rowLength, 2, init var reference))
        {
            return false;
        }

        mut int32 tableCount = typeDefCount;
        if (form == 3) { tableCount = importCount; }
        else if (form == 4) { tableCount = genericParamCount; }
        return reference != 0 && reference <= uint32(tableCount);
    }

    if (form == 5)
    {
        if (rowLength < 10 || (rowLength - 6) % 4 != 0
            || !TryReadTypeSpecWord(rowStart, rowLength, 2, init var generic)
            || !IsEarlierTypeSpecRow(generic, row)
            || !TryGetTypeSpecForm(indexByteLength, int32(generic), init var genericForm)
            || (genericForm != 2 && genericForm != 3))
        {
            return false;
        }

        for (mut int32 offset = 6; offset < rowLength; offset = offset + 4)
        {
            if (!TryReadTypeSpecWord(rowStart, rowLength, offset, init var argument)
                || !TryValidateConstructedArgument(argument))
            {
                return false;
            }
        }

        return true;
    }

    if (form >= 6 && form <= 0x0B)
    {
        if (rowLength != 6
            || !TryReadTypeSpecWord(rowStart, rowLength, 2, init var inner)
            || !TryValidateTypeSpecRef(inner, indexByteLength, row, false))
        {
            return false;
        }

        if (form != 6 && IsNoncanonicalInlineTypeSpec(indexByteLength, inner))
        {
            return false;
        }

        return true;
    }

    if (form == 0x0C)
    {
        if (rowLength != 7
            || !TryReadTypeSpecByte(rowStart, rowLength, 2, init var familyCode)
            || !IsIndexedTypeSpecFamily(familyCode)
            || !TryReadTypeSpecWord(rowStart, rowLength, 3, init var argument)
            || !TryValidateTypeSpecRef(argument, indexByteLength, row, familyCode == 0x8A)
            || IsNoncanonicalInlineTypeSpec(indexByteLength, argument))
        {
            return false;
        }

        return true;
    }

    if (form == 0x0E)
    {
        if (rowLength != 6 || (qualifiers & 0xFE) != 0
            || !TryReadTypeSpecWord(rowStart, rowLength, 2, init var inner)
            || !TryValidateTypeSpecRef(inner, indexByteLength, row, false))
        {
            return false;
        }

        return true;
    }

    if (form == 0x0F)
    {
        return rowLength == 2 && qualifiers == 0;
    }

    return false;
}

bool IsEarlierTypeSpecRow(uint32 reference, int32 row)
{
    return reference != 0 && reference < uint32(row);
}

bool TryValidateConstructedArgument(uint32 reference)
{
    if (reference == 0)
    {
        return false;
    }

    if ((reference >> 24) == 0)
    {
        // The generic-aware pass selects the row table and checks its bounds.
        return true;
    }

    return TryValidateInlineTypeSpecRef(reference, false);
}

bool TryValidateTypeSpecRef(uint32 reference, int32 indexByteLength,
    int32 row, bool allowInitQualifier)
{
    if (reference == 0)
    {
        return false;
    }

    if ((reference >> 24) == 0)
    {
        return reference < uint32(row)
            && TryGetTypeSpecQualifiers(indexByteLength, int32(reference),
                init var qualifiers)
            && (allowInitQualifier || (qualifiers & 0x04) == 0);
    }

    return TryValidateInlineTypeSpecRef(reference, allowInitQualifier);
}

bool TryValidateInlineTypeSpecRef(uint32 reference, bool allowInitQualifier)
{
    if ((reference >> 24) == 0xF2)
    {
        return (reference & 0x00FF_FF00) == 0
            && (reference & 0xFF) <= 0x1A;
    }

    if ((reference >> 24) == 0xF3)
    {
        int32 qualifiers = int32((reference >> 16) & 0xFF);
        int32 familyCode = int32((reference >> 8) & 0xFF);
        int32 argumentCode = int32(reference & 0xFF);
        return IsAssignedTypeSpecFamily(familyCode)
            && argumentCode <= 0x19
            && (qualifiers & 0xF8) == 0
            && (allowInitQualifier || (qualifiers & 0x04) == 0)
            && ((qualifiers & 0x02) == 0 || familyCode == 0x8B || familyCode == 0x8D);
    }

    return false;
}

bool TryGetTypeSpecForm(int32 indexByteLength, int32 row,
    init ref<int32> form)
{
    if (!TryReadTypeSpecTableOffset(row - 1, init var startOffset)
        || !TryReadTypeSpecTableOffset(row, init var endOffset))
    {
        return false;
    }

    int32 rowStart = indexByteLength + int32(startOffset);
    int32 rowLength = int32(endOffset - startOffset);
    return TryReadTypeSpecByte(rowStart, rowLength, 0, init form);
}

bool TryGetTypeSpecQualifiers(int32 indexByteLength, int32 row,
    init ref<int32> qualifiers)
{
    if (row < 1
        || !TryReadTypeSpecTableOffset(row - 1, init var startOffset)
        || !TryReadTypeSpecTableOffset(row, init var endOffset))
    {
        return false;
    }

    int32 rowStart = indexByteLength + int32(startOffset);
    int32 rowLength = int32(endOffset - startOffset);
    return TryReadTypeSpecByte(rowStart, rowLength, 1, init qualifiers);
}

bool IsNoncanonicalInlineTypeSpec(int32 indexByteLength, uint32 reference)
{
    if ((reference >> 24) != 0)
    {
        return false;
    }

    if (!TryGetTypeSpecForm(indexByteLength, int32(reference), init var form))
    {
        return true;
    }
    if (form != 1)
    {
        return false;
    }
    if (!TryReadTypeSpecTableOffset(int32(reference) - 1, init var startOffset)
        || !TryReadTypeSpecTableOffset(int32(reference), init var endOffset))
    {
        return true;
    }

    int32 rowStart = indexByteLength + int32(startOffset);
    int32 rowLength = int32(endOffset - startOffset);
    if (rowLength != 3)
    {
        return false;
    }

    return !TryReadTypeSpecByte(rowStart, rowLength, 1, init var qualifiers)
        || qualifiers == 0;
}

bool IsAssignedTypeSpecFamily(int32 familyCode)
{
    return (familyCode >= 0x80 && familyCode <= 0x84)
        || familyCode == 0x8A
        || (familyCode >= 0x8B && familyCode <= 0x8F);
}

bool IsIndexedTypeSpecFamily(int32 familyCode)
{
    return (familyCode >= 0x80 && familyCode <= 0x84) || familyCode == 0x8A;
}

bool TryReadTypeSpecByte(int32 rowStart, int32 rowLength, int32 offset,
    init ref<int32> value)
{
    if (rowStart < 0 || rowLength < 0 || offset < 0 || offset >= rowLength
        || rowStart > Host.TypeSpecs.Length - rowLength)
    {
        return false;
    }

    int32 part = Host.TypeSpecs[rowStart + offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    value = part;
    return true;
}

bool TryReadTypeSpecWord(int32 rowStart, int32 rowLength, int32 offset,
    init ref<uint32> value)
{
    if (offset < 0 || offset > rowLength - 4
        || !TryReadTypeSpecByte(rowStart, rowLength, offset, init var first)
        || !TryReadTypeSpecByte(rowStart, rowLength, offset + 1, init var second)
        || !TryReadTypeSpecByte(rowStart, rowLength, offset + 2, init var third)
        || !TryReadTypeSpecByte(rowStart, rowLength, offset + 3, init var fourth))
    {
        return false;
    }

    value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool IsValidTypeSpecCount(int32 count)
{
    return count >= 0 && count <= 16777215;
}

bool TryGetTypeSpecRowExtent(int32 recordCount, int32 row,
    init ref<int32> rowStart, init ref<int32> rowLength)
{
    if (recordCount <= 0 || recordCount > 16777215
        || row <= 0 || row > recordCount
        || recordCount > Host.TypeSpecs.Length / 4 - 1)
    {
        return false;
    }

    int32 indexByteLength = (recordCount + 1) * 4;
    int32 dataByteLength = Host.TypeSpecs.Length - indexByteLength;
    if (!TryReadTypeSpecTableOffset(row - 1, init var startOffset)
        || !TryReadTypeSpecTableOffset(row, init var endOffset)
        || startOffset > endOffset || endOffset > uint32(dataByteLength))
    {
        return false;
    }

    rowStart = indexByteLength + int32(startOffset);
    rowLength = int32(endOffset - startOffset);
    return true;
}

bool TryReadTypeSpecTableOffset(int32 offsetIndex, init ref<uint32> offset)
{
    if (offsetIndex < 0 || offsetIndex >= Host.TypeSpecs.Length / 4)
    {
        return false;
    }

    int32 at = offsetIndex * 4;
    mut uint32 value = 0;
    for (mut int32 byteIndex = 0; byteIndex < 4; byteIndex = byteIndex + 1)
    {
        int32 part = Host.TypeSpecs[at + byteIndex];
        if (part < 0 || part > 255)
        {
            return false;
        }
        value = value | (uint32(part) << (byteIndex * 8));
    }

    offset = value;
    return true;
}

bool TryValidateTypeSpecTableIndex(int32 recordCount)
{
    if (recordCount <= 0 || recordCount > 16777215
        || recordCount > Host.TypeSpecs.Length / 4 - 1)
    {
        return false;
    }

    int32 indexByteLength = (recordCount + 1) * 4;
    int32 dataByteLength = Host.TypeSpecs.Length - indexByteLength;
    if (dataByteLength < 2
        || !TryReadTypeSpecTableOffset(0, init var firstOffset)
        || firstOffset != 0)
    {
        return false;
    }

    mut uint32 previous = firstOffset;
    for (mut int32 currentRow = 1; currentRow <= recordCount; currentRow = currentRow + 1)
    {
        if (!TryReadTypeSpecTableOffset(currentRow, init var next)
            || next > uint32(dataByteLength)
            || previous > uint32(dataByteLength - 2)
            || next < previous + 2)
        {
            return false;
        }
        previous = next;
    }

    return previous == uint32(dataByteLength);
}
