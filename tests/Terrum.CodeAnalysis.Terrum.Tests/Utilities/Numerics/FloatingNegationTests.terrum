namespace Terrum.CodeAnalysis.Tests;

public bool CheckFloatingNegation()
{
    return NegateFloat32Bits(0) == 0x80000000
        && NegateFloat32Bits(0x80000000) == 0
        && NegateFloat32Bits(0x7F800000) == 0xFF800000
        && NegateFloat32Bits(0x7FC12345) == 0xFFC12345
        && NegateFloat32Bits(0xFF800001) == 0x7F800001
        && NegateFloat32Bits(0x00000001) == 0x80000001
        && NegateFloat64Bits(0) == 0x8000000000000000
        && NegateFloat64Bits(0x8000000000000000) == 0
        && NegateFloat64Bits(0x7FF0000000000000) == 0xFFF0000000000000
        && NegateFloat64Bits(0x7FF8123456789ABC) == 0xFFF8123456789ABC
        && NegateFloat64Bits(0xFFF0000000000001) == 0x7FF0000000000001
        && NegateFloat64Bits(0x0000000000000001) == 0x8000000000000001;
}
