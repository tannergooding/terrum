namespace Terrum.CodeAnalysis;

int32 CheckSourceLines()
{
    mut int32 start = 0;
    mut int32 index = 0;
    mut bool more = true;
    while (more)
    {
        require TryReadSourceLine(start, init var content, init var includingBreak);
        require TryGetSourceLineExtent(index, init var extent);
        require index < Host.ExpectedLines.Length / 3;
        if (content.Start != Host.ExpectedLines[index * 3]
            || content.Length != Host.ExpectedLines[index * 3 + 1]
            || includingBreak.Start != content.Start
            || includingBreak.Length != Host.ExpectedLines[index * 3 + 2]
            || extent.Start != includingBreak.Start
            || extent.Length != includingBreak.Length)
        {
            return 1;
        }

        more = content.Length != includingBreak.Length;
        start = includingBreak.End;
        index = index + 1;
    }

    if (index != Host.ExpectedLines.Length / 3)
    {
        return 2;
    }

    if (TryGetSourceLineExtent(-1, init var beforeExtent)
        || TryGetSourceLineExtent(index, init var afterExtent)
        || TryGetSourceLineExtent(int32.MaxValue, init var maximumExtent))
    {
        return 9;
    }

    mut int32 at = 0;
    while (at <= Host.Source.Length)
    {
        require TryGetSourcePosition(at, init var line, init var character);
        if (line != Host.ExpectedPositions[at * 2]
            || character != Host.ExpectedPositions[at * 2 + 1])
        {
            return 3;
        }
        require TryGetSourceOffset(line, character, init var offset);
        if (offset != at)
        {
            return 6;
        }
        if (at < Host.Source.Length
            && Host.ExpectedPositions[(at + 1) * 2] != line
            && TryGetSourceOffset(line, character + 1, init var nextLineStart))
        {
            return 7;
        }
        at = at + 1;
    }

    require TryGetSourcePosition(Host.Source.Length, init var lastLine, init var lastCharacter);
    if (TryGetSourceOffset(lastLine, lastCharacter + 1, init var pastEnd)
        || TryGetSourceOffset(-1, 0, init var beforeOffset)
        || TryGetSourceOffset(Host.ExpectedLines.Length / 3, 0, init var afterOffset)
        || TryGetSourceOffset(0, -1, init var negativeCharacter)
        || TryGetSourceOffset(0, int32.MaxValue, init var hugeCharacter))
    {
        return 8;
    }

    if (TryReadSourceLine(-1, init var before, init var beforeBreak)
        || TryReadSourceLine(Host.Source.Length + 1, init var after, init var afterBreak)
        || TryReadSourceLine(int32.MaxValue, init var maximum, init var maximumBreak)
        || TryGetSourcePosition(-1, init var beforeLine, init var beforeCharacter)
        || TryGetSourcePosition(Host.Source.Length + 1, init var afterLine, init var afterCharacter)
        || TryGetSourcePosition(int32.MaxValue, init var maximumLine, init var maximumCharacter))
    {
        return 4;
    }

    require TryReadSourceLine(Host.Source.Length, init var empty, init var emptyBreak);
    if (empty.Start != Host.Source.Length || empty.Length != 0
        || emptyBreak.Start != Host.Source.Length || emptyBreak.Length != 0)
    {
        return 5;
    }

    return 0;
}
