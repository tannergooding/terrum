namespace Terrum.CodeAnalysis;

int32 CheckSourceLines()
{
    mut int32 start = 0;
    mut int32 index = 0;
    mut bool more = true;
    while (more)
    {
        init SourceRange content;
        init SourceRange includingBreak;
        init SourceRange extent;
        require TryReadSourceLine(start, ref init content,
            ref init includingBreak);
        require TryGetSourceLineExtent(index, ref init extent);
        require index < Host.ExpectedLines.Length / 3;
        if (content.Start != Host.ExpectedLines[index * 3]
            || content.Length != Host.ExpectedLines[index * 3 + 1]
            || includingBreak.Start != content.Start
            || includingBreak.Length != Host.ExpectedLines[index * 3 + 2]
            || extent.Start != includingBreak.Start
            || extent.Length != includingBreak.Length)
        {
            return 1;
        }

        more = content.Length != includingBreak.Length;
        start = includingBreak.End;
        index = index + 1;
    }

    if (index != Host.ExpectedLines.Length / 3)
    {
        return 2;
    }

    init SourceRange beforeExtent;
    init SourceRange afterExtent;
    init SourceRange maximumExtent;
    if (TryGetSourceLineExtent(-1, ref init beforeExtent)
        || TryGetSourceLineExtent(index, ref init afterExtent)
        || TryGetSourceLineExtent(int32.MaxValue, ref init maximumExtent))
    {
        return 9;
    }

    mut int32 at = 0;
    while (at <= Host.Source.Length)
    {
        init int32 line;
        init int32 character;
        init int32 offset;
        init int32 nextLineStart;
        require TryGetSourcePosition(at, ref init line, ref init character);
        if (line != Host.ExpectedPositions[at * 2]
            || character != Host.ExpectedPositions[at * 2 + 1])
        {
            return 3;
        }
        require TryGetSourceOffset(line, character, ref init offset);
        if (offset != at)
        {
            return 6;
        }
        if (at < Host.Source.Length
            && Host.ExpectedPositions[(at + 1) * 2] != line
            && TryGetSourceOffset(line, character + 1,
                ref init nextLineStart))
        {
            return 7;
        }
        at = at + 1;
    }

    init int32 lastLine;
    init int32 lastCharacter;
    require TryGetSourcePosition(Host.Source.Length, ref init lastLine,
        ref init lastCharacter);
    init int32 pastEnd;
    init int32 beforeOffset;
    init int32 afterOffset;
    init int32 negativeCharacter;
    init int32 hugeCharacter;
    if (TryGetSourceOffset(lastLine, lastCharacter + 1, ref init pastEnd)
        || TryGetSourceOffset(-1, 0, ref init beforeOffset)
        || TryGetSourceOffset(Host.ExpectedLines.Length / 3, 0,
            ref init afterOffset)
        || TryGetSourceOffset(0, -1, ref init negativeCharacter)
        || TryGetSourceOffset(0, int32.MaxValue, ref init hugeCharacter))
    {
        return 8;
    }

    init SourceRange before;
    init SourceRange beforeBreak;
    init SourceRange after;
    init SourceRange afterBreak;
    init SourceRange maximum;
    init SourceRange maximumBreak;
    init int32 beforeLine;
    init int32 beforeCharacter;
    init int32 afterLine;
    init int32 afterCharacter;
    init int32 maximumLine;
    init int32 maximumCharacter;
    if (TryReadSourceLine(-1, ref init before, ref init beforeBreak)
        || TryReadSourceLine(Host.Source.Length + 1, ref init after,
            ref init afterBreak)
        || TryReadSourceLine(int32.MaxValue, ref init maximum,
            ref init maximumBreak)
        || TryGetSourcePosition(-1, ref init beforeLine,
            ref init beforeCharacter)
        || TryGetSourcePosition(Host.Source.Length + 1, ref init afterLine,
            ref init afterCharacter)
        || TryGetSourcePosition(int32.MaxValue, ref init maximumLine,
            ref init maximumCharacter))
    {
        return 4;
    }

    init SourceRange empty;
    init SourceRange emptyBreak;
    require TryReadSourceLine(Host.Source.Length, ref init empty,
        ref init emptyBreak);
    if (empty.Start != Host.Source.Length || empty.Length != 0
        || emptyBreak.Start != Host.Source.Length || emptyBreak.Length != 0)
    {
        return 5;
    }

    return 0;
}
