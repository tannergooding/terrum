using Terrum;
namespace Terrum.CodeAnalysis.Tests;

public static bool CheckSourceRange()
{
    init SourceRange range;
    if (!SourceRange.TryCreate(2, 3, ref init range))
    {
        return false;
    }

    if (range.End != 5 || range.GetEnd() != range.End)
    {
        return false;
    }

    init SourceRange initialized;
    if (!SourceRange.TryCreate(2, 3, ref init initialized)
        || initialized.Start != range.Start || initialized.Length != range.Length
        || initialized.End != range.End)
    {
        return false;
    }

    init SourceRange negative;
    if (SourceRange.TryCreate(-1, 0, ref init negative))
    {
        return false;
    }

    init SourceRange overflowing;
    if (SourceRange.TryCreate(int32.MaxValue, 1, ref init overflowing))
    {
        return false;
    }

    init SourceRange negativeInit;
    init SourceRange overflowingInit;
    if (SourceRange.TryCreate(-1, 0, ref init negativeInit)
        || SourceRange.TryCreate(int32.MaxValue, 1,
            ref init overflowingInit))
    {
        return false;
    }

    init SourceRange end;
    if (!SourceRange.TryCreate(int32.MaxValue, 0, ref init end))
    {
        return false;
    }

    init SourceRange final;
    return end.End == int32.MaxValue
        && SourceRange.TryCreate(int32.MaxValue, 0, ref init final)
        && final.End == end.End;
}
