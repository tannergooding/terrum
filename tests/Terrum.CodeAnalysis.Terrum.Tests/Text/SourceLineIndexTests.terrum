namespace Terrum.CodeAnalysis.Tests;

public bool CheckSourceLineIndex()
{
    init SourceLineIndex index;
    init SourceRange firstExtent;
    init SourceRange firstContent;
    init SourceRange secondExtent;
    init SourceRange secondContent;
    init SourceRange finalExtent;
    init SourceRange finalContent;
    init int32 lineSix;
    init int32 characterSix;
    init int32 lineTwo;
    init int32 characterTwo;
    init int32 lineFour;
    init int32 characterFour;
    init int32 lineZero;
    init int32 characterZero;
    init int32 finalLine;
    init int32 finalCharacter;
    init int32 offsetTwo;
    init int32 offsetFour;
    init int32 offsetSix;
    init int32 offsetSeven;
    init int32 beforeLine;
    init int32 beforeCharacter;
    init int32 afterLine;
    init int32 afterCharacter;
    init int32 maximumLine;
    init int32 maximumCharacter;
    init int32 beforeOffset;
    init int32 afterOffset;
    init int32 negativeCharacter;
    init int32 excessiveCharacter;
    init int32 nextLineStart;
    init int32 afterSecondLine;
    init int32 afterEnd;
    init SourceRange beforeExtent;
    init SourceRange afterExtent;
    init SourceRange beforeContent;
    init SourceRange afterContent;

    if (Host.Source.Length == 0)
    {
        return CheckEmptySourceLineIndex();
    }
    if (Host.Source.Length == 3)
    {
        return CheckBreakOnlySourceLineIndex();
    }
    if (Host.Source.Length != 7)
    {
        return false;
    }

    require SourceLineIndex.TryCreate(ref init index);
    if (index.GetLineCount() != 3)
    {
        return false;
    }

    require index.TryGetLineExtent(0, ref init firstExtent);
    require index.TryGetLineContentExtent(0, ref init firstContent);
    require index.TryGetLineExtent(1, ref init secondExtent);
    require index.TryGetLineContentExtent(1, ref init secondContent);
    require index.TryGetLineExtent(2, ref init finalExtent);
    require index.TryGetLineContentExtent(2, ref init finalContent);
    if (firstExtent.Start != 0 || firstExtent.Length != 5
        || firstContent.Start != 0 || firstContent.Length != 3
        || secondExtent.Start != 5 || secondExtent.Length != 2
        || secondContent.Start != 5 || secondContent.Length != 1
        || finalExtent.Start != 7 || finalExtent.Length != 0
        || finalContent.Start != 7 || finalContent.Length != 0)
    {
        return false;
    }

    if (!index.TryGetPosition(6, ref init lineSix, ref init characterSix)
        || lineSix != 1 || characterSix != 1
        || !index.TryGetPosition(2, ref init lineTwo, ref init characterTwo)
        || lineTwo != 0 || characterTwo != 2
        || !index.TryGetPosition(4, ref init lineFour, ref init characterFour)
        || lineFour != 0 || characterFour != 4
        || !index.TryGetPosition(0, ref init lineZero, ref init characterZero)
        || lineZero != 0 || characterZero != 0
        || !index.TryGetPosition(7, ref init finalLine,
            ref init finalCharacter)
        || finalLine != 2 || finalCharacter != 0)
    {
        return false;
    }

    if (!index.TryGetOffset(0, 2, ref init offsetTwo) || offsetTwo != 2
        || !index.TryGetOffset(0, 4, ref init offsetFour) || offsetFour != 4
        || !index.TryGetOffset(1, 1, ref init offsetSix) || offsetSix != 6
        || !index.TryGetOffset(2, 0, ref init offsetSeven)
        || offsetSeven != 7)
    {
        return false;
    }

    if (index.TryGetPosition(-1, ref init beforeLine,
            ref init beforeCharacter)
        || index.TryGetPosition(8, ref init afterLine,
            ref init afterCharacter)
        || index.TryGetPosition(int32.MaxValue, ref init maximumLine,
            ref init maximumCharacter)
        || index.TryGetOffset(-1, 0, ref init beforeOffset)
        || index.TryGetOffset(3, 0, ref init afterOffset)
        || index.TryGetOffset(0, -1, ref init negativeCharacter)
        || index.TryGetOffset(0, int32.MaxValue,
            ref init excessiveCharacter)
        || index.TryGetOffset(0, 5, ref init nextLineStart)
        || index.TryGetOffset(1, 2, ref init afterSecondLine)
        || index.TryGetOffset(2, 1, ref init afterEnd)
        || index.TryGetLineExtent(-1, ref init beforeExtent)
        || index.TryGetLineExtent(3, ref init afterExtent)
        || index.TryGetLineContentExtent(-1, ref init beforeContent)
        || index.TryGetLineContentExtent(3, ref init afterContent))
    {
        return false;
    }

    return true;
}

bool CheckEmptySourceLineIndex()
{
    init SourceLineIndex index;
    init SourceRange extent;
    init SourceRange content;
    init int32 line;
    init int32 character;
    init int32 offset;
    init int32 beforeLine;
    init int32 beforeCharacter;
    init int32 afterLine;
    init int32 afterCharacter;
    init int32 afterOffset;
    init SourceRange beforeExtent;
    init SourceRange afterExtent;
    init SourceRange beforeContent;
    init SourceRange afterContent;

    require SourceLineIndex.TryCreate(ref init index);
    require index.TryGetLineExtent(0, ref init extent);
    require index.TryGetLineContentExtent(0, ref init content);
    return index.GetLineCount() == 1
        && extent.Start == 0 && extent.Length == 0
        && content.Start == 0 && content.Length == 0
        && index.TryGetPosition(0, ref init line, ref init character)
        && line == 0 && character == 0
        && index.TryGetOffset(0, 0, ref init offset) && offset == 0
        && !index.TryGetPosition(-1, ref init beforeLine,
            ref init beforeCharacter)
        && !index.TryGetPosition(1, ref init afterLine,
            ref init afterCharacter)
        && !index.TryGetOffset(0, 1, ref init afterOffset)
        && !index.TryGetLineExtent(-1, ref init beforeExtent)
        && !index.TryGetLineExtent(1, ref init afterExtent)
        && !index.TryGetLineContentExtent(-1, ref init beforeContent)
        && !index.TryGetLineContentExtent(1, ref init afterContent);
}

bool CheckBreakOnlySourceLineIndex()
{
    init SourceLineIndex index;
    init SourceRange firstExtent;
    init SourceRange firstContent;
    init SourceRange secondExtent;
    init SourceRange secondContent;
    init SourceRange finalExtent;
    init SourceRange finalContent;
    init int32 firstLine;
    init int32 firstCharacter;
    init int32 crlfLine;
    init int32 crlfCharacter;
    init int32 secondLine;
    init int32 secondCharacter;
    init int32 finalLine;
    init int32 finalCharacter;
    init int32 firstOffset;
    init int32 crlfOffset;
    init int32 nextLineStart;
    init int32 secondOffset;
    init int32 nextFinalLine;
    init int32 finalOffset;
    init int32 afterEnd;
    init int32 beforeLine;
    init int32 beforeCharacter;
    init int32 afterLine;
    init int32 afterCharacter;

    require SourceLineIndex.TryCreate(ref init index);
    require index.TryGetLineExtent(0, ref init firstExtent);
    require index.TryGetLineContentExtent(0, ref init firstContent);
    require index.TryGetLineExtent(1, ref init secondExtent);
    require index.TryGetLineContentExtent(1, ref init secondContent);
    require index.TryGetLineExtent(2, ref init finalExtent);
    require index.TryGetLineContentExtent(2, ref init finalContent);
    if (index.GetLineCount() != 3
        || firstExtent.Start != 0 || firstExtent.Length != 2
        || firstContent.Start != 0 || firstContent.Length != 0
        || secondExtent.Start != 2 || secondExtent.Length != 1
        || secondContent.Start != 2 || secondContent.Length != 0
        || finalExtent.Start != 3 || finalExtent.Length != 0
        || finalContent.Start != 3 || finalContent.Length != 0)
    {
        return false;
    }

    return index.TryGetPosition(0, ref init firstLine,
            ref init firstCharacter)
        && firstLine == 0 && firstCharacter == 0
        && index.TryGetPosition(1, ref init crlfLine,
            ref init crlfCharacter)
        && crlfLine == 0 && crlfCharacter == 1
        && index.TryGetPosition(2, ref init secondLine,
            ref init secondCharacter)
        && secondLine == 1 && secondCharacter == 0
        && index.TryGetPosition(3, ref init finalLine,
            ref init finalCharacter)
        && finalLine == 2 && finalCharacter == 0
        && index.TryGetOffset(0, 0, ref init firstOffset)
        && firstOffset == 0
        && index.TryGetOffset(0, 1, ref init crlfOffset)
        && crlfOffset == 1
        && !index.TryGetOffset(0, 2, ref init nextLineStart)
        && index.TryGetOffset(1, 0, ref init secondOffset)
        && secondOffset == 2
        && !index.TryGetOffset(1, 1, ref init nextFinalLine)
        && index.TryGetOffset(2, 0, ref init finalOffset)
        && finalOffset == 3
        && !index.TryGetOffset(2, 1, ref init afterEnd)
        && !index.TryGetPosition(-1, ref init beforeLine,
            ref init beforeCharacter)
        && !index.TryGetPosition(4, ref init afterLine,
            ref init afterCharacter);
}
