<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\Terrum.CodeAnalysis.Tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sources\Terrum.CodeAnalysis\Terrum.CodeAnalysis.csproj" />
    <ProjectReference Include="..\..\sources\terrumc\terrumc.csproj" ReferenceOutputAssembly="false" />
    <None Include="Fixtures\Native\*.trmn" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Native\*.trng" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Keep unconverted prototypes out while retaining the tracked generic import regression tests. -->
  <ItemGroup>
    <Compile Remove="BoundTreeTraversalTests.cs;CliTests.Dx11Sample.cs;CliTests.NativeInputElement.cs;NativeSourceImportTests.Blob.cs;NativeSourceImportTests.Dx11*.cs;NativeSourceImportTests.InputElement.cs;NativeSourceImportTests.NativeWindowMessage.cs;NativeSourceImportTests.SampleArray.cs;NativeSourceImportTests.ShaderCompile.cs;NativeSourceImportTests.Vertex3.cs;NativeSourceImportTests.Win32Window*.cs;NativeSourceImportTests.WindowLifetime.cs" />
  </ItemGroup>

</Project>
