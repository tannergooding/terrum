namespace Terrum.CodeAnalysis;

public static bool TryFloat32BitsToInt32(uint32 bits, init ref<int32> result)
{
    uint64 magnitude = Float32BitsToMagnitudeOrMax(bits);
    if (magnitude == uint64.MaxValue)
    {
        return false;
    }

    bool negative = (bits & uint32(0x80000000)) != 0 && magnitude != 0;
    if (negative)
    {
        if (magnitude > uint64(0x80000000))
        {
            return false;
        }

        if (magnitude == uint64(0x80000000))
        {
            result = int32.MinValue;
        }
        else
        {
            result = -int32(magnitude);
        }
    }
    else
    {
        if (magnitude > uint64(int32.MaxValue))
        {
            return false;
        }

        result = int32(magnitude);
    }

    return true;
}

public static bool TryFloat32BitsToUInt32(uint32 bits, init ref<uint32> result)
{
    uint64 magnitude = Float32BitsToMagnitudeOrMax(bits);
    if (magnitude == uint64.MaxValue)
    {
        return false;
    }
    bool negative = (bits & uint32(0x80000000)) != 0 && magnitude != 0;
    if (negative || magnitude > uint64(uint32.MaxValue))
    {
        return false;
    }

    result = uint32(magnitude);
    return true;
}

