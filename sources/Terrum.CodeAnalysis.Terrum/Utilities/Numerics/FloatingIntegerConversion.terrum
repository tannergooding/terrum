uint64 Float32BitsToMagnitudeOrMax(uint32 bits)
{
    uint32 exponentField = (bits >> 23) & uint32(0xFF);
    if (exponentField == uint32(0xFF))
    {
        return uint64.MaxValue;
    }

    if (exponentField == 0)
    {
        return 0;
    }

    uint64 significand = uint64(bits & uint32(0x7FFFFF)) | uint64(0x800000);
    int32 exponent = int32(exponentField) - 127;
    return TruncateMagnitudeOrMax(significand, exponent, 23);
}

uint64 Float64BitsToMagnitudeOrMax(uint64 bits)
{
    uint64 exponentField = (bits >> 52) & uint64(0x7FF);
    if (exponentField == uint64(0x7FF))
    {
        return uint64.MaxValue;
    }

    if (exponentField == 0)
    {
        return 0;
    }

    uint64 significand = (bits & uint64(0x000FFFFFFFFFFFFF)) | uint64(0x0010000000000000);
    int32 exponent = int32(exponentField) - 1023;
    return TruncateMagnitudeOrMax(significand, exponent, 52);
}

uint64 TruncateMagnitudeOrMax(
    uint64 significand,
    int32 exponent,
    int32 fractionBits)
{
    if (exponent < 0)
    {
        return 0;
    }
    if (exponent >= 64)
    {
        return uint64.MaxValue;
    }

    // The largest float64 below 2^64 is 2^64 - 2^11; float32 is farther away, so MaxValue is a disjoint sentinel.
    mut uint64 truncated = 0;
    if (exponent < fractionBits)
    {
        truncated = significand >> (fractionBits - exponent);
    }
    else
    {
        truncated = significand << (exponent - fractionBits);
    }
    return truncated;
}
