namespace Terrum;

T SelectCopy<T>(bool takeFirst, T first, T second)
{
    if (takeFirst)
    {
        return first;
    }

    return second;
}

bool TrySelectCopyInit<T>(int32 index, T first, T second, ref<init T> result)
{
    if (index == 0)
    {
        *result = first;
        return true;
    }
    if (index == 1)
    {
        *result = second;
        return true;
    }

    return false;
}

bool TrySelectCopy<T>(int32 index, T first, T second, out T result)
{
    init T selected;
    if (!TrySelectCopyInit(index, first, second, ref init selected))
    {
        return false;
    }

    result = selected;
    return true;
}
