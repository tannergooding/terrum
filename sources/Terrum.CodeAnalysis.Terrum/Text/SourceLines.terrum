namespace Terrum.CodeAnalysis;

public bool TryGetSourcePosition(int32 position, init ref<int32> line, init ref<int32> character)
{
    if (position < 0 || position > GetSourceTextLength())
    {
        return false;
    }

    mut int32 start = 0;
    mut int32 index = 0;
    while (true)
    {
        require TryReadSourceLine(start, init var content, init var includingBreak);
        int32 next = includingBreak.End;

        // Break units belong to their preceding line; a trailing break adds an empty line.
        if (position < next || content.Length == includingBreak.Length)
        {
            line = index;
            character = position - start;

            return true;
        }

        start = next;
        index = index + 1;
    }
}

public bool TryGetSourceOffset(int32 line, int32 character, init ref<int32> offset)
{
    if (line < 0 || character < 0)
    {
        return false;
    }

    mut int32 start = 0;
    mut int32 index = 0;
    while (true)
    {
        require TryReadSourceLine(start, init var content, init var includingBreak);
        bool finalLine = content.Length == includingBreak.Length;
        if (index == line)
        {
            if (finalLine)
            {
                if (character > content.Length)
                {
                    return false;
                }
            }
            else if (character >= includingBreak.Length)
            {
                return false;
            }
            offset = start + character;
            return true;
        }
        if (finalLine)
        {
            return false;
        }
        start = includingBreak.End;
        index = index + 1;
    }
}

public bool TryGetSourceLineExtent(int32 line, init ref<SourceRange> includingBreak)
{
    if (line < 0)
    {
        return false;
    }

    mut int32 start = 0;
    mut int32 index = 0;
    while (true)
    {
        require TryReadSourceLine(start, init var content, init var range);
        if (index == line)
        {
            includingBreak = range;
            return true;
        }
        if (content.Length == range.Length)
        {
            return false;
        }
        start = range.End;
        index = index + 1;
    }
}
