namespace Terrum.CodeAnalysis;

public bool TryGetSourceDiagnosticLocation(int32 position,
    ref<init int32> line, ref<init int32> column)
{
    if (position < 0 || position > Host.Source.Length)
    {
        return false;
    }

    init SourceLineIndex index;
    if (!SourceLineIndex.TryCreate(ref init index))
    {
        return false;
    }

    init int32 zeroBasedLine;
    init int32 zeroBasedColumn;
    if (!index.TryGetPosition(position, ref init zeroBasedLine,
        ref init zeroBasedColumn))
    {
        return false;
    }

    *line = zeroBasedLine + 1;
    *column = zeroBasedColumn + 1;
    return true;
}
