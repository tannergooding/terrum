            return 3;
        }
        verifiedBlockCount = verifiedBlockCount + bodyBlockCount;
        expectedBlockFirst = expectedBlockFirst + bodyBlockCount;
        mut int32 pendingRelationHomeId = -1;
        mut int32 operationBlockLocal = 0;
        mut int32 operationBlockOffset = blockFirst * 16;
        mut int32 operationBlockFirst
