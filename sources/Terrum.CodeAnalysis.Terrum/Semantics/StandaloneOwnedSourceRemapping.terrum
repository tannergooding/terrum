namespace Terrum.CodeAnalysis;

int32 GetStandaloneRewrittenLocalRange(int32 oldFirst,
    int32 oldCount, int32 localCount, int32 emptyRangeFirst,
    ref<init int32> newFirstResult)
    ensure return == 0 ? *newFirstResult is init : true
{
    if (localCount < 0 || oldFirst < 0 || oldCount < 0
        || oldFirst > localCount - oldCount
        || emptyRangeFirst < 0 || emptyRangeFirst > localCount)
    {
        return 3;
    }
    if (oldCount == 0)
    {
        *newFirstResult = emptyRangeFirst;
        return 0;
    }

    mut int32 minimum = int32.MaxValue;
    mut int32 maximum = -1;
    for (mut int32 ordinal = 0;
        ordinal < oldCount;
        ordinal = ordinal + 1)
    {
        int32 oldLocalId = oldFirst + ordinal;
        if (oldLocalId >= Host.StandaloneRewriteLocalIds.Length)
        {
            return 3;
        }
        int32 newLocalId
            = Host.StandaloneRewriteLocalIds[oldLocalId];
        if (newLocalId < 0 || newLocalId >= localCount)
        {
            return 3;
        }
        if (newLocalId < minimum)
        {
            minimum = newLocalId;
        }
        if (newLocalId > maximum)
        {
            maximum = newLocalId;
        }
    }
    if (maximum - minimum + 1 != oldCount)
    {
        return 3;
    }
    *newFirstResult = minimum;
    return 0;
}

public static int32 RewriteStandaloneOwnedCallNodes()
{
    if (Host.StandaloneRewriteStatus.Length != 1
        || Host.StandaloneModuleCount.Length != 1
        || !ValidateStandaloneSourceCallBuffers()
        || !ValidateStandaloneNormalizationBuffers()
        || !ValidateStandaloneRewriteBuffers())
    {
        return 3;
    }

    ClearStandaloneRewriteOutputs();
    if (ValidateStandaloneMethodImportInput() != 0
        || Host.StandaloneSourceProgramStatus[0] != 0
        || Host.StandaloneNormalizedProgramStatus[0] != 0
        || VerifyStandaloneDirectCalls() != 0
        || !ValidateStandaloneRewriteMaps())
    {
        return FailStandaloneRewrite(3);
    }
    for (mut int32 index = 0;
        index < Host.StandaloneInvokeUseCounts.Length;
        index = index + 1)
    {
        Host.StandaloneInvokeUseCounts[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneInvokeInputUseCounts.Length;
        index = index + 1)
    {
        Host.StandaloneInvokeInputUseCounts[index] = 0;
    }
    if (VerifyStandaloneNormalizedProgram() != 0)
    {
        return FailStandaloneRewrite(3);
    }

    int32 moduleCount = Host.StandaloneModuleCount[0];
    for (mut int32 oldModuleId = 0;
        oldModuleId < moduleCount;
        oldModuleId = oldModuleId + 1)
    {
        int32 newModuleId
            = Host.StandaloneRewriteModuleIds[oldModuleId];
        int32 sourceOffset = (oldModuleId + 1) * 8;
        int32 targetOffset = (newModuleId + 1) * 8;
        for (mut int32 field = 0; field < 8; field = field + 1)
        {
            Host.StandaloneRewrittenModuleDirectory[
                targetOffset + field]
                = Host.StandaloneModuleDirectory[
                    sourceOffset + field];
        }
    }

    int32 localCallableCount
        = Host.StandaloneLocalCallableCount[0];
    for (mut int32 oldLocalId = 0;
        oldLocalId < localCallableCount;
        oldLocalId = oldLocalId + 1)
    {
        int32 sourceOffset = oldLocalId * 3;
        int32 newLocalId
            = Host.StandaloneRewriteLocalCallableIds[oldLocalId];
        int32 ownerModuleId
            = Host.StandaloneLocalCallables[sourceOffset];
        if (ownerModuleId < 0 || ownerModuleId >= moduleCount)
        {
            return FailStandaloneRewrite(3);
        }
        int32 targetOffset = newLocalId * 3;
        Host.StandaloneRewrittenLocalCallables[targetOffset]
            = Host.StandaloneRewriteModuleIds[ownerModuleId];
        Host.StandaloneRewrittenLocalCallables[targetOffset + 1]
            = Host.StandaloneRewriteCallableIds[
                Host.StandaloneLocalCallables[sourceOffset + 1]];
        Host.StandaloneRewrittenLocalCallables[targetOffset + 2]
            = Host.StandaloneRewriteBodyIds[
                Host.StandaloneLocalCallables[sourceOffset + 2]];
    }

    int32 importedCallableCount
        = Host.StandaloneSourceImportedCallableCount[0];
    for (mut int32 oldImportedId = 0;
        oldImportedId < importedCallableCount;
        oldImportedId = oldImportedId + 1)
    {
        int32 sourceOffset = oldImportedId * 8;
        int32 newImportedId
            = Host.StandaloneRewriteImportedCallableIds[oldImportedId];
        int32 usingModuleId
            = Host.StandaloneSourceImportedCallables[sourceOffset];
        int32 providerModuleId
            = Host.StandaloneSourceImportedCallables[
                sourceOffset + 1];
        int32 expectedCallableId
            = Host.StandaloneSourceImportedCallables[
                sourceOffset + 4];
        if (usingModuleId < 0 || usingModuleId >= moduleCount
            || providerModuleId < 0 || providerModuleId >= moduleCount
            || expectedCallableId < 0
            || expectedCallableId >= Host.StandaloneResolvedRootCount[0]
            || expectedCallableId
                >= Host.StandaloneRewriteCallableCount[0])
        {
            return FailStandaloneRewrite(3);
        }
        int32 rootOffset = expectedCallableId * 20;

        int32 targetOffset = newImportedId * 8;
        Host.StandaloneRewrittenImportedCallables[targetOffset]
            = Host.StandaloneRewriteModuleIds[usingModuleId];
        Host.StandaloneRewrittenImportedCallables[targetOffset + 1]
            = Host.StandaloneRewriteModuleIds[providerModuleId];
        Host.StandaloneRewrittenImportedCallables[targetOffset + 2]
            = Host.StandaloneSourceImportedCallables[
                sourceOffset + 2];
        Host.StandaloneRewrittenImportedCallables[targetOffset + 3]
            = Host.StandaloneSourceImportedCallables[
                sourceOffset + 3];
        Host.StandaloneRewrittenImportedCallables[targetOffset + 4]
            = Host.StandaloneRewriteCallableIds[
                expectedCallableId];
        Host.StandaloneRewrittenCallableParameterCounts[
            Host.StandaloneRewriteCallableIds[expectedCallableId]]
            = int32(Host.StandaloneResolvedRoots[
                rootOffset + 11]);
        Host.StandaloneRewrittenImportedCallables[targetOffset + 5]
            = Host.StandaloneSourceImportedCallables[
                sourceOffset + 5];
        Host.StandaloneRewrittenImportedCallables[targetOffset + 6]
            = Host.StandaloneSourceImportedCallables[
                sourceOffset + 6];
        Host.StandaloneRewrittenImportedCallables[targetOffset + 7]
            = Host.StandaloneSourceImportedCallables[
                sourceOffset + 7];
    }

    int32 callableCount = Host.StandaloneRewriteCallableCount[0];
    for (mut int32 oldCallableId = 0;
        oldCallableId < callableCount;
        oldCallableId = oldCallableId + 1)
    {
        int32 newCallableId
            = Host.StandaloneRewriteCallableIds[oldCallableId];
        int32 oldTypeId
            = Host.StandaloneCallableTypeIds[oldCallableId];
        if (oldTypeId == 0)
        {
            Host.StandaloneRewrittenCallableTypeIds[newCallableId] = 0;
            Host.StandaloneRewrittenCallableEffects[newCallableId] = 0;
            continue;
        }
        if (oldTypeId < 0
            || oldTypeId > Host.StandaloneTypeFactCount[0])
        {
            return FailStandaloneRewrite(3);
        }
        Host.StandaloneRewrittenCallableTypeIds[newCallableId]
            = Host.StandaloneRewriteTypeIds[oldTypeId];
        Host.StandaloneRewrittenCallableEffects[newCallableId]
            = Host.StandaloneCallableEffects[oldCallableId];
    }

    int32 typeCount = Host.StandaloneTypeFactCount[0];
    for (mut int32 oldTypeId = 1;
        oldTypeId <= typeCount;
        oldTypeId = oldTypeId + 1)
    {
        int32 sourceOffset = oldTypeId * 3;
        int32 targetOffset
            = Host.StandaloneRewriteTypeIds[oldTypeId] * 3;
        for (mut int32 field = 0; field < 3; field = field + 1)
        {
            Host.StandaloneRewrittenTypeFacts[targetOffset + field]
                = Host.StandaloneTypeFacts[sourceOffset + field];
        }
    }

    for (mut int32 parameterRow = 0;
        parameterRow < Host.StandaloneParameterTypeIds.Length;
        parameterRow = parameterRow + 1)
    {
        int32 typeId
            = Host.StandaloneParameterTypeIds[parameterRow];
        if (typeId < 0 || typeId > typeCount)
        {
            return FailStandaloneRewrite(3);
        }
        Host.StandaloneRewrittenParameterTypeIds[parameterRow]
            = typeId == 0 ? 0
                : Host.StandaloneRewriteTypeIds[typeId];
    }

    int32 sourceLocalCallableCount
        = Host.StandaloneLocalCallableCount[0];
    for (mut int32 oldLocalId = 0;
        oldLocalId < sourceLocalCallableCount;
        oldLocalId = oldLocalId + 1)
    {
        int32 newLocalId
            = Host.StandaloneRewriteLocalCallableIds[oldLocalId];
        int32 sourceOffset = oldLocalId * 12;
        int32 targetOffset = newLocalId * 12;
        for (mut int32 field = 0; field < 12; field = field + 1)
        {
            Host.StandaloneRewrittenSourceCallableInfo[
                targetOffset + field]
                = Host.StandaloneSourceCallableInfo[
                    sourceOffset + field];
        }
        int32 resultTypeId
            = Host.StandaloneSourceCallableInfo[sourceOffset + 4];
        int32 oldBodyId
            = Host.StandaloneSourceCallableInfo[sourceOffset + 7];
        int32 expectedCallableId
            = Host.StandaloneSourceCallableInfo[sourceOffset + 11];
        if (resultTypeId <= 0 || resultTypeId > typeCount
            || oldBodyId < 0
            || oldBodyId >= Host.StandaloneSourceBodyCount[0]
            || expectedCallableId < 0
            || expectedCallableId >= callableCount)
        {
            return FailStandaloneRewrite(3);
        }
        Host.StandaloneRewrittenSourceCallableInfo[
            targetOffset + 4]
            = Host.StandaloneRewriteTypeIds[resultTypeId];
        Host.StandaloneRewrittenSourceCallableInfo[
            targetOffset + 7]
            = Host.StandaloneRewriteLocalCallableIds[oldLocalId];
        Host.StandaloneRewrittenSourceCallableInfo[
            targetOffset + 11]
            = Host.StandaloneRewriteCallableIds[
                expectedCallableId];
        Host.StandaloneRewrittenCallableParameterCounts[
            Host.StandaloneRewriteCallableIds[expectedCallableId]]
            = Host.StandaloneSourceCallableInfo[sourceOffset + 6];
    }

    int32 sourceParameterCount
        = Host.StandaloneSourceParameterCount[0];
    for (mut int32 parameterRow = 0;
        parameterRow < sourceParameterCount;
        parameterRow = parameterRow + 1)
    {
        int32 sourceOffset = parameterRow * 4;
        int32 bodyId
            = Host.StandaloneSourceParameters[sourceOffset];
        int32 typeId
            = Host.StandaloneSourceParameters[sourceOffset + 1];
        if (bodyId < 0 || bodyId >= sourceLocalCallableCount
            || typeId <= 0 || typeId > typeCount)
        {
            return FailStandaloneRewrite(3);
        }
        int32 targetOffset = parameterRow * 4;
        Host.StandaloneRewrittenSourceParameters[targetOffset]
            = Host.StandaloneRewriteLocalCallableIds[bodyId];
        Host.StandaloneRewrittenSourceParameters[targetOffset + 1]
            = Host.StandaloneRewriteTypeIds[typeId];
        Host.StandaloneRewrittenSourceParameters[targetOffset + 2]
            = Host.StandaloneSourceParameters[sourceOffset + 2];
        Host.StandaloneRewrittenSourceParameters[targetOffset + 3]
            = Host.StandaloneSourceParameters[sourceOffset + 3];
    }

    int32 bodyCount = Host.StandaloneSourceBodyCount[0];
    for (mut int32 oldBodyId = 0;
        oldBodyId < bodyCount;
        oldBodyId = oldBodyId + 1)
    {
        int32 newBodyId
            = Host.StandaloneRewriteBodyIds[oldBodyId];
        int32 sourceOffset = oldBodyId * 12;
        int32 targetOffset = newBodyId * 12;
        for (mut int32 field = 0; field < 12; field = field + 1)
        {
            Host.StandaloneRewrittenSourceBodies[
                targetOffset + field]
                = Host.StandaloneSourceBodies[sourceOffset + field];
        }
        Host.StandaloneRewrittenSourceBodies[targetOffset]
            = newBodyId;
        int32 callFirst
            = Host.StandaloneSourceBodies[sourceOffset + 5];
        int32 callCount
            = Host.StandaloneSourceBodies[sourceOffset + 6];
        for (mut int32 callLocal = 0;
            callLocal < callCount;
            callLocal = callLocal + 1)
        {
            Host.StandaloneRewrittenDirectCallBodyIds[
                callFirst + callLocal] = newBodyId;
        }
    }

    int32 expressionCount
        = Host.StandaloneSourceExpressionCount[0];
    for (mut int32 oldBodyId = 0;
        oldBodyId < bodyCount;
        oldBodyId = oldBodyId + 1)
    {
        int32 bodyOffset = oldBodyId * 12;
        int32 expressionFirst
            = Host.StandaloneSourceBodies[bodyOffset + 3];
        int32 bodyExpressionCount
            = Host.StandaloneSourceBodies[bodyOffset + 4];
        int32 newBodyId
            = Host.StandaloneRewriteBodyIds[oldBodyId];
        for (mut int32 expressionLocal = 0;
            expressionLocal < bodyExpressionCount;
            expressionLocal = expressionLocal + 1)
        {
            int32 oldExpressionId
                = expressionFirst + expressionLocal;
            int32 newExpressionId
                = Host.StandaloneRewriteExpressionIds[
                    oldExpressionId];
            int32 sourceOffset = oldExpressionId * 8;
            int32 targetOffset = newExpressionId * 8;
            for (mut int32 field = 0; field < 8; field = field + 1)
            {
                Host.StandaloneRewrittenSourceExpressions[
                    targetOffset + field]
                    = Host.StandaloneSourceExpressions[
                        sourceOffset + field];
            }
            int32 typeId
                = Host.StandaloneSourceExpressions[
                    sourceOffset + 1];
            if (typeId <= 0 || typeId > typeCount)
            {
                return FailStandaloneRewrite(3);
            }
            Host.StandaloneRewrittenSourceExpressions[
                targetOffset + 1]
                = Host.StandaloneRewriteTypeIds[typeId];
            Host.StandaloneRewrittenSourceExpressions[
                targetOffset + 7] = newBodyId;
            if (Host.StandaloneSourceExpressions[
                    sourceOffset] == 5
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 26)
            {
                int32 placeId
                    = Host.StandaloneSourceExpressions[
                        sourceOffset + 2];
                if (placeId < 0
                    || placeId
                        >= Host.StandaloneSourcePlaceCount[0])
                {
                    return FailStandaloneRewrite(3);
                }
                int32 placeKind
                    = Host.StandaloneSourcePlaces[placeId * 5 + 2];
                if (placeKind
                    != (Host.StandaloneSourceExpressions[
                        sourceOffset] == 5 ? 1 : 3))
                {
                    return FailStandaloneRewrite(3);
                }
                Host.StandaloneRewrittenSourceExpressions[
                    targetOffset + 2]
                    = Host.StandaloneRewritePlaceIds[placeId];
            }
            else if (Host.StandaloneSourceExpressions[
                    sourceOffset] == 6
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 8
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 9
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 10
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 11)
            {
                int32 childExpressionId
                    = Host.StandaloneSourceExpressions[
                        sourceOffset + 2];
                if (childExpressionId < 0
                    || childExpressionId >= expressionLocal)
                {
                    return FailStandaloneRewrite(3);
                }
                int32 childGlobalId
                    = expressionFirst + childExpressionId;
                int32 newChildGlobalId
                    = Host.StandaloneRewriteExpressionIds[
                        childGlobalId];
                int32 newExpressionFirst
                    = Host.StandaloneRewrittenSourceBodies[
                        newBodyId * 12 + 3];
                Host.StandaloneRewrittenSourceExpressions[
                    targetOffset + 2]
                    = newChildGlobalId - newExpressionFirst;
            }
            else if (Host.StandaloneSourceExpressions[
                    sourceOffset] == 34)
            {
                int32 conditionExpressionId
                    = Host.StandaloneSourceExpressions[
                        sourceOffset + 2];
                int32 trueExpressionId
                    = Host.StandaloneSourceExpressions[
                        sourceOffset + 3];
                int32 falseExpressionId
                    = Host.StandaloneSourceExpressions[
                        sourceOffset + 4];
                if (conditionExpressionId < 0
                    || conditionExpressionId >= expressionLocal
                    || trueExpressionId < 0
                    || trueExpressionId >= expressionLocal
                    || falseExpressionId < 0
                    || falseExpressionId >= expressionLocal
                    || conditionExpressionId == trueExpressionId
                    || conditionExpressionId == falseExpressionId
                    || trueExpressionId == falseExpressionId)
                {
                    return FailStandaloneRewrite(3);
                }
                int32 newExpressionFirst
                    = Host.StandaloneRewrittenSourceBodies[
                        newBodyId * 12 + 3];
                int32 conditionGlobalId
                    = expressionFirst + conditionExpressionId;
                int32 trueGlobalId
                    = expressionFirst + trueExpressionId;
                int32 falseGlobalId
                    = expressionFirst + falseExpressionId;
                Host.StandaloneRewrittenSourceExpressions[
                    targetOffset + 2]
                    = Host.StandaloneRewriteExpressionIds[
                        conditionGlobalId] - newExpressionFirst;
                Host.StandaloneRewrittenSourceExpressions[
                    targetOffset + 3]
                    = Host.StandaloneRewriteExpressionIds[
                        trueGlobalId] - newExpressionFirst;
                Host.StandaloneRewrittenSourceExpressions[
                    targetOffset + 4]
                    = Host.StandaloneRewriteExpressionIds[
                        falseGlobalId] - newExpressionFirst;
            }
            else if (Host.StandaloneSourceExpressions[
                    sourceOffset] == 12
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 13
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 14
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 15
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 16
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 17
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 18
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 19
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 20
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 21
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 22
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 23
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 24
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 25
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 31
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 32
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 33
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 35
                || Host.StandaloneSourceExpressions[
                    sourceOffset] == 36)
            {
                int32 leftExpressionId
                    = Host.StandaloneSourceExpressions[
                        sourceOffset + 2];
                int32 rightExpressionId
                    = Host.StandaloneSourceExpressions[
                        sourceOffset + 3];
                if (leftExpressionId < 0
                    || leftExpressionId >= expressionLocal
                    || rightExpressionId < 0
                    || rightExpressionId >= expressionLocal
                    || leftExpressionId == rightExpressionId)
                {
                    return FailStandaloneRewrite(3);
                }
                int32 newExpressionFirst
                    = Host.StandaloneRewrittenSourceBodies[
                        newBodyId * 12 + 3];
                int32 leftGlobalId
                    = expressionFirst + leftExpressionId;
                int32 rightGlobalId
                    = expressionFirst + rightExpressionId;
                int32 newLeftGlobalId
                    = Host.StandaloneRewriteExpressionIds[
                        leftGlobalId];
                int32 newRightGlobalId
                    = Host.StandaloneRewriteExpressionIds[
                        rightGlobalId];
                Host.StandaloneRewrittenSourceExpressions[
                    targetOffset + 2]
                    = newLeftGlobalId - newExpressionFirst;
                Host.StandaloneRewrittenSourceExpressions[
                    targetOffset + 3]
                    = newRightGlobalId - newExpressionFirst;
            }
        }
    }

    int32 directCallCount
        = Host.StandaloneSourceDirectCallCount[0];
    for (mut int32 callIndex = 0;
        callIndex < directCallCount;
        callIndex = callIndex + 1)
    {
        int32 sourceOffset = callIndex * 7;
        int32 targetKind
            = Host.StandaloneSourceDirectCalls[sourceOffset];
        int32 targetIndex
            = Host.StandaloneSourceDirectCalls[sourceOffset + 1];
        int32 expectedCallableId
            = Host.StandaloneSourceDirectCalls[sourceOffset + 2];
        int32 resultTypeId
            = Host.StandaloneSourceDirectCalls[sourceOffset + 3];
        init int32 rewrittenTargetIndex;
        int32 targetStatus = RewriteStandaloneCallableTarget(
            targetKind, targetIndex, expectedCallableId,
            ref init rewrittenTargetIndex);
        if (targetStatus != 0
            || resultTypeId <= 0 || resultTypeId > typeCount)
        {
            return FailStandaloneRewrite(targetStatus == 0
                ? 3 : targetStatus);
        }
        int32 targetOffset = callIndex * 7;
        for (mut int32 field = 0; field < 7; field = field + 1)
        {
            Host.StandaloneRewrittenSourceDirectCalls[
                targetOffset + field]
                = Host.StandaloneSourceDirectCalls[
                    sourceOffset + field];
        }
        Host.StandaloneRewrittenSourceDirectCalls[
            targetOffset] = targetKind;
        Host.StandaloneRewrittenSourceDirectCalls[
            targetOffset + 1] = rewrittenTargetIndex;
        Host.StandaloneRewrittenSourceDirectCalls[
            targetOffset + 2]
            = Host.StandaloneRewriteCallableIds[
                expectedCallableId];
        Host.StandaloneRewrittenSourceDirectCalls[
            targetOffset + 3]
            = Host.StandaloneRewriteTypeIds[resultTypeId];
    }
    for (mut int32 callIndex = 0;
        callIndex < directCallCount;
        callIndex = callIndex + 1)
    {
        Host.StandaloneRewrittenDirectCallInvokeMap[callIndex]
            = Host.StandaloneDirectCallInvokeMap[callIndex];
        Host.StandaloneRewrittenDirectCallTraversal[callIndex]
            = Host.StandaloneDirectCallTraversal[callIndex];
    }
    Host.StandaloneRewrittenDirectCallTraversalCount[0]
        = Host.StandaloneDirectCallTraversalCount[0];

    int32 argumentCount
        = Host.StandaloneSourceCallArgumentCount[0];
    for (mut int32 argumentIndex = 0;
        argumentIndex < argumentCount;
        argumentIndex = argumentIndex + 1)
    {
        int32 sourceOffset = argumentIndex * 3;
        int32 expressionId
            = Host.StandaloneSourceCallArguments[sourceOffset];
        int32 parameterOrdinal
            = Host.StandaloneSourceCallArguments[
                sourceOffset + 1];
        int32 sourceUse
            = Host.StandaloneSourceCallArguments[
                sourceOffset + 2];
        int32 ownerBody = -1;
        int32 expressionFirst = -1;
        for (mut int32 bodyId = 0;
            bodyId < bodyCount;
            bodyId = bodyId + 1)
        {
            int32 bodyOffset = bodyId * 12;
            int32 first = Host.StandaloneSourceBodies[
                bodyOffset + 7];
            int32 count = Host.StandaloneSourceBodies[
                bodyOffset + 8];
            if (argumentIndex >= first
                && argumentIndex < first + count)
            {
                ownerBody = bodyId;
                expressionFirst = Host.StandaloneSourceBodies[
                    bodyOffset + 3];
                break;
            }
        }
        if (ownerBody < 0 || expressionId < 0
            || expressionId
                >= Host.StandaloneSourceBodies[
                    ownerBody * 12 + 4])
        {
            return FailStandaloneRewrite(3);
        }
        int32 oldExpressionId = expressionFirst + expressionId;
        int32 newExpressionId
            = Host.StandaloneRewriteExpressionIds[oldExpressionId];
        int32 newExpressionFirst
            = Host.StandaloneRewrittenSourceBodies[
                Host.StandaloneRewriteBodyIds[ownerBody] * 12 + 3];
        int32 newLocalExpression = newExpressionId
            - newExpressionFirst;
        if (newLocalExpression < 0
            || newLocalExpression
                >= Host.StandaloneRewrittenSourceBodies[
                    Host.StandaloneRewriteBodyIds[ownerBody] * 12 + 4])
        {
            return FailStandaloneRewrite(3);
        }
        int32 targetOffset = argumentIndex * 3;
        Host.StandaloneRewrittenSourceCallArguments[
            targetOffset] = newLocalExpression;
        Host.StandaloneRewrittenSourceCallArguments[
            targetOffset + 1] = parameterOrdinal;
        Host.StandaloneRewrittenSourceCallArguments[
            targetOffset + 2] = sourceUse;
    }

    int32 statementCount
        = Host.StandaloneSourceStatementCount[0];
    for (mut int32 statementIndex = 0;
        statementIndex < statementCount;
        statementIndex = statementIndex + 1)
    {
        int32 ownerBody = -1;
        int32 expressionFirst = -1;
        int32 bodyStatementFirst = -1;
        for (mut int32 bodyId = 0;
            bodyId < bodyCount;
            bodyId = bodyId + 1)
        {
            int32 bodyOffset = bodyId * 12;
            int32 first = Host.StandaloneSourceBodies[
                bodyOffset + 9];
            int32 count = Host.StandaloneSourceBodies[
                bodyOffset + 10];
            if (statementIndex >= first
                && statementIndex < first + count)
            {
                ownerBody = bodyId;
                expressionFirst = Host.StandaloneSourceBodies[
                    bodyOffset + 3];
                bodyStatementFirst = first;
                break;
            }
        }
        if (ownerBody < 0 || bodyStatementFirst < 0)
        {
            return FailStandaloneRewrite(3);
        }
        int32 sourceOffset = statementIndex * 3;
        int32 targetOffset = statementIndex * 3;
        for (mut int32 field = 0; field < 3; field = field + 1)
        {
            Host.StandaloneRewrittenSourceStatements[
                targetOffset + field]
                = Host.StandaloneSourceStatements[
                    sourceOffset + field];
        }
        int32 expressionId
            = Host.StandaloneSourceStatements[sourceOffset + 1];
        if (Host.StandaloneSourceStatements[sourceOffset] == 4)
        {
            int32 localId
                = Host.StandaloneSourceStatements[sourceOffset + 2];
            if (localId < 0
                || localId >= Host.StandaloneSourceLocalCount[0])
            {
                return FailStandaloneRewrite(3);
            }
            Host.StandaloneRewrittenSourceStatements[
                targetOffset + 2]
                = Host.StandaloneRewriteLocalIds[localId];
        }
        else if (Host.StandaloneSourceStatements[sourceOffset] == 5)
        {
            int32 placeId
                = Host.StandaloneSourceStatements[sourceOffset + 2];
            if (placeId < 0
                || placeId >= Host.StandaloneSourcePlaceCount[0])
            {
                return FailStandaloneRewrite(3);
            }
            Host.StandaloneRewrittenSourceStatements[
                targetOffset + 2]
                = Host.StandaloneRewritePlaceIds[placeId];
        }
        if (expressionId >= 0)
        {
            if (expressionId
                >= Host.StandaloneSourceBodies[
                    ownerBody * 12 + 4])
            {
                return FailStandaloneRewrite(3);
            }
            int32 oldExpressionId = expressionFirst + expressionId;
            int32 newExpressionId
                = Host.StandaloneRewriteExpressionIds[
                    oldExpressionId];
            int32 newExpressionFirst
                = Host.StandaloneRewrittenSourceBodies[
                    Host.StandaloneRewriteBodyIds[
                        ownerBody] * 12 + 3];
            Host.StandaloneRewrittenSourceStatements[
                targetOffset + 1]
                = newExpressionId - newExpressionFirst;
        }
    }

    int32 sourceArenaStatus
        = RewriteStandaloneSourceArenas();
    if (sourceArenaStatus != 0)
    {
        return FailStandaloneRewrite(sourceArenaStatus);
    }

    for (mut int32 oldBodyId = 0;
        oldBodyId < bodyCount;
        oldBodyId = oldBodyId + 1)
    {
        int32 newBodyId
            = Host.StandaloneRewriteBodyIds[oldBodyId];
        int32 sourceOffset = oldBodyId * 12;
        int32 targetOffset = newBodyId * 12;
        for (mut int32 field = 0; field < 12; field = field + 1)
        {
            Host.StandaloneRewrittenNormalizedBodies[
                targetOffset + field]
                = Host.StandaloneNormalizedBodies[
                    sourceOffset + field];
        }
        Host.StandaloneRewrittenNormalizedBodies[
            targetOffset] = newBodyId;
    }

    for (mut int32 bodyId = 0;
        bodyId < bodyCount;
        bodyId = bodyId + 1)
    {
        Host.StandaloneRewrittenNormalizedBodyBlockRanges[
            bodyId * 2] = -1;
    }
    for (mut int32 oldBodyId = 0;
        oldBodyId < bodyCount;
        oldBodyId = oldBodyId + 1)
    {
        int32 newBodyId
            = Host.StandaloneRewriteBodyIds[oldBodyId];
        if (newBodyId < 0 || newBodyId >= bodyCount
            || Host.StandaloneRewrittenNormalizedBodyBlockRanges[
                newBodyId * 2] != -1)
        {
            return FailStandaloneRewrite(3);
        }
        Host.StandaloneRewrittenNormalizedBodyBlockRanges[
            newBodyId * 2] = oldBodyId;
    }
    mut int32 rewrittenBlockCount = 0;
    for (mut int32 newBodyId = 0;
        newBodyId < bodyCount;
        newBodyId = newBodyId + 1)
    {
        int32 oldBodyId
            = Host.StandaloneRewrittenNormalizedBodyBlockRanges[
                newBodyId * 2];
        if (oldBodyId < 0 || oldBodyId >= bodyCount)
        {
            return FailStandaloneRewrite(3);
        }
        int32 rangeOffset = oldBodyId * 2;
        int32 oldBlockFirst
            = Host.StandaloneNormalizedBodyBlockRanges[
                rangeOffset];
        int32 bodyBlockCount
            = Host.StandaloneNormalizedBodyBlockRanges[
                rangeOffset + 1];
        if (oldBlockFirst < 0 || bodyBlockCount <= 0
            || oldBlockFirst
                > Host.StandaloneNormalizedBlockCount[0]
                    - bodyBlockCount
            || rewrittenBlockCount
                > Host.StandaloneRewrittenNormalizedBlocks.Length / 16
                    - bodyBlockCount)
        {
            return FailStandaloneRewrite(3);
        }
        for (mut int32 localBlockId = 0;
            localBlockId < bodyBlockCount;
            localBlockId = localBlockId + 1)
        {
            int32 sourceOffset
                = (oldBlockFirst + localBlockId) * 16;
            int32 targetOffset
                = (rewrittenBlockCount + localBlockId) * 16;
            for (mut int32 field = 0; field < 16;
                field = field + 1)
            {
                Host.StandaloneRewrittenNormalizedBlocks[
                    targetOffset + field]
                    = Host.StandaloneNormalizedBlocks[
                        sourceOffset + field];
            }
            Host.StandaloneRewrittenNormalizedBlocks[targetOffset]
                = newBodyId;
        }
        Host.StandaloneRewrittenNormalizedBodyBlockRanges[
            newBodyId * 2] = rewrittenBlockCount;
        Host.StandaloneRewrittenNormalizedBodyBlockRanges[
            newBodyId * 2 + 1] = bodyBlockCount;
        rewrittenBlockCount = rewrittenBlockCount + bodyBlockCount;
    }
    if (rewrittenBlockCount
        != Host.StandaloneNormalizedBlockCount[0])
    {
        return FailStandaloneRewrite(3);
    }

    for (mut int32 homeIndex = 0;
        homeIndex < Host.StandaloneNormalizedHomeCount[0];
        homeIndex = homeIndex + 1)
    {
        int32 sourceOffset = homeIndex * 5;
        int32 targetOffset = homeIndex * 5;
        for (mut int32 field = 0; field < 5; field = field + 1)
        {
            Host.StandaloneRewrittenNormalizedHomes[
                targetOffset + field]
                = Host.StandaloneNormalizedHomes[
                    sourceOffset + field];
        }
        int32 oldBodyId
            = Host.StandaloneNormalizedHomes[sourceOffset];
        int32 typeId
            = Host.StandaloneNormalizedHomes[sourceOffset + 3];
        if (oldBodyId < 0 || oldBodyId >= bodyCount
            || typeId <= 0 || typeId > typeCount)
        {
            return FailStandaloneRewrite(3);
        }
        Host.StandaloneRewrittenNormalizedHomes[
            targetOffset] = Host.StandaloneRewriteBodyIds[oldBodyId];
        Host.StandaloneRewrittenNormalizedHomes[
            targetOffset + 3] = Host.StandaloneRewriteTypeIds[typeId];
    }

    for (mut int32 constantIndex = 0;
        constantIndex < Host.StandaloneNormalizedConstantCount[0];
        constantIndex = constantIndex + 1)
    {
        int32 sourceOffset = constantIndex * 4;
        int32 targetOffset = constantIndex * 4;
        int32 bodyId
            = Host.StandaloneNormalizedConstants[sourceOffset];
        int32 typeId
            = Host.StandaloneNormalizedConstants[sourceOffset + 1];
        if (bodyId < 0 || bodyId >= bodyCount
            || typeId <= 0 || typeId > typeCount)
        {
            return FailStandaloneRewrite(3);
        }
        Host.StandaloneRewrittenNormalizedConstants[
            targetOffset] = Host.StandaloneRewriteBodyIds[bodyId];
        Host.StandaloneRewrittenNormalizedConstants[
            targetOffset + 1]
            = Host.StandaloneRewriteTypeIds[typeId];
        Host.StandaloneRewrittenNormalizedConstants[
            targetOffset + 2]
            = Host.StandaloneNormalizedConstants[sourceOffset + 2];
        Host.StandaloneRewrittenNormalizedConstants[
            targetOffset + 3]
            = Host.StandaloneNormalizedConstants[sourceOffset + 3];
    }

    int32 invokeCount = Host.StandaloneInvokeCount[0];
    for (mut int32 invokeIndex = 0;
        invokeIndex < invokeCount;
        invokeIndex = invokeIndex + 1)
    {
        int32 sourceOffset = invokeIndex * 10;
        int32 targetKind
            = Host.StandaloneInvokes[sourceOffset];
        int32 targetIndex
            = Host.StandaloneInvokes[sourceOffset + 1];
        int32 expectedCallableId
            = Host.StandaloneInvokes[sourceOffset + 2];
        init int32 rewrittenTargetIndex;
        int32 targetStatus = RewriteStandaloneCallableTarget(
            targetKind, targetIndex, expectedCallableId,
            ref init rewrittenTargetIndex);
        if (targetStatus != 0)
        {
            return FailStandaloneRewrite(targetStatus);
        }
        int32 targetOffset = invokeIndex * 10;
        for (mut int32 field = 0; field < 10; field = field + 1)
        {
            Host.StandaloneRewrittenInvokes[targetOffset + field]
                = Host.StandaloneInvokes[sourceOffset + field];
        }
        Host.StandaloneRewrittenInvokes[targetOffset]
            = targetKind;
        Host.StandaloneRewrittenInvokes[targetOffset + 1]
            = rewrittenTargetIndex;
        Host.StandaloneRewrittenInvokes[targetOffset + 2]
            = Host.StandaloneRewriteCallableIds[
                expectedCallableId];
    }
    for (mut int32 inputIndex = 0;
        inputIndex < Host.StandaloneInvokeInputCount[0];
        inputIndex = inputIndex + 1)
    {
        int32 offset = inputIndex * 3;
        Host.StandaloneRewrittenInvokeInputs[offset]
            = Host.StandaloneInvokeInputs[offset];
        Host.StandaloneRewrittenInvokeInputs[offset + 1]
            = Host.StandaloneInvokeInputs[offset + 1];
        Host.StandaloneRewrittenInvokeInputs[offset + 2]
            = Host.StandaloneInvokeInputs[offset + 2];
    }

    for (mut int32 operationIndex = 0;
        operationIndex
            < Host.StandaloneNormalizedOperationCount[0];
        operationIndex = operationIndex + 1)
    {
        int32 sourceOffset = operationIndex * 5;
        int32 targetOffset = operationIndex * 5;
        int32 bodyId
            = Host.StandaloneNormalizedOperations[sourceOffset + 4];
        if (bodyId < 0 || bodyId >= bodyCount)
        {
            return FailStandaloneRewrite(3);
        }
        for (mut int32 field = 0; field < 5; field = field + 1)
        {
            Host.StandaloneRewrittenNormalizedOperations[
                targetOffset + field]
                = Host.StandaloneNormalizedOperations[
                    sourceOffset + field];
        }
        Host.StandaloneRewrittenNormalizedOperations[
            targetOffset + 4]
            = Host.StandaloneRewriteBodyIds[bodyId];
        int32 operationKind
            = Host.StandaloneNormalizedOperations[sourceOffset];
        if (operationKind == 30 || operationKind == 31)
        {
            int32 localId
                = Host.StandaloneNormalizedOperations[
                    sourceOffset + 3];
            if (localId < 0 || localId >= localCount)
            {
                return FailStandaloneRewrite(3);
            }
            Host.StandaloneRewrittenNormalizedOperations[
                targetOffset + 3]
                = Host.StandaloneRewriteLocalIds[localId];
        }
    }

    Host.StandaloneRewrittenModuleCount[0] = moduleCount;
    Host.StandaloneRewrittenLocalCallableCount[0]
        = localCallableCount;
    Host.StandaloneRewrittenImportedCallableCount[0]
        = importedCallableCount;
    Host.StandaloneRewrittenCallableCount[0] = callableCount;
    Host.StandaloneRewrittenTypeFactCount[0] = typeCount;
    Host.StandaloneRewrittenParameterTypeCount[0]
        = Host.StandaloneParameterTypeIds.Length;
    Host.StandaloneRewrittenSourceBodyCount[0] = bodyCount;
    Host.StandaloneRewrittenNormalizedBodyCount[0] = bodyCount;
    Host.StandaloneRewrittenNormalizedBlockCount[0]
        = rewrittenBlockCount;
    Host.StandaloneRewrittenSourceParameterCount[0]
        = Host.StandaloneSourceParameterCount[0];
    Host.StandaloneRewrittenSourceExpressionCount[0]
        = expressionCount;
    Host.StandaloneRewrittenSourceStatementCount[0]
        = Host.StandaloneSourceStatementCount[0];
    Host.StandaloneRewrittenSourceDirectCallCount[0]
        = Host.StandaloneSourceDirectCallCount[0];
    Host.StandaloneRewrittenSourceCallArgumentCount[0]
        = Host.StandaloneSourceCallArgumentCount[0];
    Host.StandaloneRewrittenNormalizedHomeCount[0]
        = Host.StandaloneNormalizedHomeCount[0];
    Host.StandaloneRewrittenNormalizedConstantCount[0]
        = Host.StandaloneNormalizedConstantCount[0];
    Host.StandaloneRewrittenInvokeCount[0] = invokeCount;
    Host.StandaloneRewrittenInvokeInputCount[0]
        = Host.StandaloneInvokeInputCount[0];
    Host.StandaloneRewrittenNormalizedOperationCount[0]
        = Host.StandaloneNormalizedOperationCount[0];

    int32 verificationStatus = VerifyStandaloneRewrittenCallNodes();
    if (verificationStatus != 0)
    {
        return FailStandaloneRewrite(verificationStatus);
    }
    verificationStatus = VerifyStandaloneRewrittenSourceArenas();
    if (verificationStatus != 0)
    {
        return FailStandaloneRewrite(verificationStatus);
    }
    Host.StandaloneRewriteStatus[0] = 0;
    return 0;
}

int32 RewriteStandaloneSourceArenas()
{
    int32 bodyCount = Host.StandaloneSourceBodyCount[0];
    int32 scopeCount = Host.StandaloneSourceLexicalScopeCount[0];
    int32 localCount = Host.StandaloneSourceLocalCount[0];
    int32 placeCount = Host.StandaloneSourcePlaceCount[0];
    int32 ifNodeCount = Host.StandaloneSourceIfNodeCount[0];
    int32 ifChildCount = Host.StandaloneSourceIfChildCount[0];
    int32 typeCount = Host.StandaloneTypeFactCount[0];
    if (scopeCount < bodyCount || bodyCount < 0
        || scopeCount < 0 || localCount < 0 || placeCount < 0
        || ifNodeCount < 0 || ifChildCount < 0
        || ifNodeCount > Host.StandaloneSourceIfNodes.Length / 5
        || ifChildCount > Host.StandaloneSourceIfChildren.Length)
    {
        return 3;
    }

    for (mut int32 oldBodyId = 0;
        oldBodyId < bodyCount;
        oldBodyId = oldBodyId + 1)
    {
        int32 newBodyId
            = Host.StandaloneRewriteBodyIds[oldBodyId];
        int32 scopeId
            = Host.StandaloneSourceBodyScopeIds[oldBodyId];
        int32 localRangeOffset = oldBodyId * 2;
        int32 localFirst
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset];
        int32 localCountForBody
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset + 1];
        int32 placeRangeOffset = oldBodyId * 2;
        int32 placeFirst
            = Host.StandaloneSourceBodyPlaceRanges[
                placeRangeOffset];
        int32 placeCountForBody
            = Host.StandaloneSourceBodyPlaceRanges[
                placeRangeOffset + 1];
        init int32 newLocalFirst;
        int32 localRangeStatus = GetStandaloneRewrittenLocalRange(
            localFirst, localCountForBody, localCount, 0,
            ref init newLocalFirst);
        if (newBodyId < 0 || newBodyId >= bodyCount
            || scopeId < 0 || scopeId >= scopeCount
            || Host.StandaloneSourceLexicalScopes[
                scopeId * 5 + 1] != oldBodyId
            || localFirst < 0 || localCountForBody < 0
            || localFirst > localCount - localCountForBody
            || localRangeStatus != 0
            || placeFirst < 0 || placeCountForBody < 0
            || placeFirst > placeCount - placeCountForBody)
        {
            return 3;
        }
        Host.StandaloneRewrittenSourceBodyScopeIds[newBodyId]
            = Host.StandaloneRewriteScopeIds[scopeId];
        Host.StandaloneRewrittenSourceBodyLocalRanges[
            newBodyId * 2] = newLocalFirst;
        Host.StandaloneRewrittenSourceBodyLocalRanges[
            newBodyId * 2 + 1] = localCountForBody;
        Host.StandaloneRewrittenSourceBodyPlaceRanges[
            newBodyId * 2] = placeFirst;
        Host.StandaloneRewrittenSourceBodyPlaceRanges[
            newBodyId * 2 + 1] = placeCountForBody;
    }

    for (mut int32 oldScopeId = 0;
        oldScopeId < scopeCount;
        oldScopeId = oldScopeId + 1)
    {
        int32 newScopeId
            = Host.StandaloneRewriteScopeIds[oldScopeId];
        int32 sourceOffset = oldScopeId * 5;
        int32 targetOffset = newScopeId * 5;
        int32 oldBodyId
            = Host.StandaloneSourceLexicalScopes[
                sourceOffset + 1];
        int32 parentScopeId
            = Host.StandaloneSourceLexicalScopes[sourceOffset];
        if (oldBodyId < 0 || oldBodyId >= bodyCount)
        {
            return 3;
        }
        int32 scopeLocalFirst
            = Host.StandaloneSourceLexicalScopes[
                sourceOffset + 2];
        int32 scopeLocalCount
            = Host.StandaloneSourceLexicalScopes[
                sourceOffset + 3];
        int32 bodyLocalRangeOffset = oldBodyId * 2;
        int32 bodyLocalFirst
            = Host.StandaloneSourceBodyLocalRanges[
                bodyLocalRangeOffset];
        int32 bodyLocalCount
            = Host.StandaloneSourceBodyLocalRanges[
                bodyLocalRangeOffset + 1];
        int32 newBodyId
            = Host.StandaloneRewriteBodyIds[oldBodyId];
        if (newBodyId < 0 || newBodyId >= bodyCount)
        {
            return 3;
        }
        init int32 newScopeLocalFirst;
        int32 scopeLocalRangeStatus = GetStandaloneRewrittenLocalRange(
            scopeLocalFirst, scopeLocalCount, localCount,
            Host.StandaloneRewrittenSourceBodyLocalRanges[
                newBodyId * 2],
            ref init newScopeLocalFirst);
        if (parentScopeId < -1
            || parentScopeId >= scopeCount
            || bodyLocalFirst < 0 || bodyLocalCount < 0
            || bodyLocalFirst > localCount - bodyLocalCount
            || scopeLocalFirst < bodyLocalFirst
            || scopeLocalCount < 0
            || scopeLocalFirst
                > bodyLocalFirst + bodyLocalCount - scopeLocalCount
            || (parentScopeId >= 0
                && Host.StandaloneSourceLexicalScopes[
                    parentScopeId * 5 + 1] != oldBodyId)
            || scopeLocalRangeStatus != 0)
        {
            return 3;
        }
        Host.StandaloneRewrittenSourceLexicalScopes[
            targetOffset] = parentScopeId < 0
                ? -1
                : Host.StandaloneRewriteScopeIds[parentScopeId];
        Host.StandaloneRewrittenSourceLexicalScopes[
            targetOffset + 1]
            = Host.StandaloneRewriteBodyIds[oldBodyId];
        Host.StandaloneRewrittenSourceLexicalScopes[
            targetOffset + 2]
            = newScopeLocalFirst;
        Host.StandaloneRewrittenSourceLexicalScopes[
            targetOffset + 3]
            = Host.StandaloneSourceLexicalScopes[
                sourceOffset + 3];
        Host.StandaloneRewrittenSourceLexicalScopes[
            targetOffset + 4]
            = Host.StandaloneSourceLexicalScopes[
                sourceOffset + 4];
    }

    for (mut int32 oldLocalId = 0;
        oldLocalId < localCount;
        oldLocalId = oldLocalId + 1)
    {
        int32 newLocalId
            = Host.StandaloneRewriteLocalIds[oldLocalId];
        int32 sourceOffset = oldLocalId * 10;
        int32 targetOffset = newLocalId * 10;
        int32 oldBodyId
            = Host.StandaloneSourceLocals[sourceOffset];
        int32 oldScopeId
            = Host.StandaloneSourceLocals[sourceOffset + 1];
        int32 typeId
            = Host.StandaloneSourceLocals[sourceOffset + 2];
        if (oldBodyId < 0 || oldBodyId >= bodyCount
            || oldScopeId < 0 || oldScopeId >= scopeCount
            || typeId <= 0 || typeId > typeCount
            || Host.StandaloneSourceLexicalScopes[
                oldScopeId * 5 + 1] != oldBodyId)
        {
            return 3;
        }
        for (mut int32 field = 0; field < 10; field = field + 1)
        {
            Host.StandaloneRewrittenSourceLocals[
                targetOffset + field]
                = Host.StandaloneSourceLocals[
                    sourceOffset + field];
        }
        Host.StandaloneRewrittenSourceLocals[targetOffset]
            = Host.StandaloneRewriteBodyIds[oldBodyId];
        Host.StandaloneRewrittenSourceLocals[targetOffset + 1]
            = Host.StandaloneRewriteScopeIds[oldScopeId];
        Host.StandaloneRewrittenSourceLocals[targetOffset + 2]
            = Host.StandaloneRewriteTypeIds[typeId];
        Host.StandaloneRewrittenSourceLocalStates[newLocalId]
            = Host.StandaloneSourceLocalStates[oldLocalId];
        Host.StandaloneRewrittenNormalizedSourceLocalHomeIds[
            newLocalId]
            = Host.StandaloneNormalizedSourceLocalHomeIds[
                oldLocalId];
    }

    for (mut int32 oldPlaceId = 0;
        oldPlaceId < placeCount;
        oldPlaceId = oldPlaceId + 1)
    {
        int32 newPlaceId
            = Host.StandaloneRewritePlaceIds[oldPlaceId];
        int32 sourceOffset = oldPlaceId * 5;
        int32 targetOffset = newPlaceId * 5;
        int32 oldBodyId
            = Host.StandaloneSourcePlaces[sourceOffset];
        int32 typeId
            = Host.StandaloneSourcePlaces[sourceOffset + 1];
        int32 placeKind
            = Host.StandaloneSourcePlaces[sourceOffset + 2];
        int32 targetIndex
            = Host.StandaloneSourcePlaces[sourceOffset + 3];
        if (oldBodyId < 0 || oldBodyId >= bodyCount
            || typeId <= 0 || typeId > typeCount
            || placeKind < 1 || placeKind > 4
            || targetIndex < 0)
        {
            return 3;
        }
        if (placeKind == 4)
        {
            int32 parameterCount
                = Host.StandaloneSourceCallableInfo[
                    oldBodyId * 12 + 6];
            int32 parameterRow
                = Host.StandaloneSourceCallableInfo[
                    oldBodyId * 12 + 5]
                    + targetIndex;
            if (targetIndex >= parameterCount
                || parameterRow < 0
                || parameterRow
                    >= Host.StandaloneSourceParameterCount[0]
                || Host.StandaloneSourceParameters[
                    parameterRow * 4] != oldBodyId
                || Host.StandaloneSourceParameters[
                    parameterRow * 4 + 1] != typeId)
            {
                return 3;
            }
        }
        else
        {
            if (targetIndex >= localCount)
            {
                return 3;
            }
            int32 localOffset = targetIndex * 10;
            int32 localBindingKind
                = Host.StandaloneSourceLocals[localOffset + 3];
            int32 localState
                = Host.StandaloneSourceLocalStates[targetIndex];
            if (Host.StandaloneSourceLocals[localOffset] != oldBodyId
                || Host.StandaloneSourceLocals[
                    localOffset + 2] != typeId
                || localState < 0 || localState > 1
                || (placeKind == 1 && localState != 1)
                || (placeKind == 2 && localBindingKind == 0))
            {
                return 3;
            }
        }
        for (mut int32 field = 0; field < 5; field = field + 1)
        {
            Host.StandaloneRewrittenSourcePlaces[
                targetOffset + field]
                = Host.StandaloneSourcePlaces[
                    sourceOffset + field];
        }
        Host.StandaloneRewrittenSourcePlaces[targetOffset]
            = Host.StandaloneRewriteBodyIds[oldBodyId];
        Host.StandaloneRewrittenSourcePlaces[targetOffset + 1]
            = Host.StandaloneRewriteTypeIds[typeId];
        if (placeKind != 4)
        {
            Host.StandaloneRewrittenSourcePlaces[targetOffset + 3]
                = Host.StandaloneRewriteLocalIds[targetIndex];
        }
    }

    for (mut int32 ifNodeId = 0;
        ifNodeId < ifNodeCount;
        ifNodeId = ifNodeId + 1)
    {
        int32 sourceOffset = ifNodeId * 5;
        int32 targetOffset = ifNodeId * 5;
        int32 bodyId
            = Host.StandaloneSourceIfNodes[sourceOffset];
        int32 trueFirst
            = Host.StandaloneSourceIfNodes[sourceOffset + 1];
        int32 trueCount
            = Host.StandaloneSourceIfNodes[sourceOffset + 2];
        int32 falseFirst
            = Host.StandaloneSourceIfNodes[sourceOffset + 3];
        int32 falseCount
            = Host.StandaloneSourceIfNodes[sourceOffset + 4];
        if (bodyId < 0 || bodyId >= bodyCount
            || trueFirst < 0 || trueCount < 0
            || trueFirst > ifChildCount - trueCount
            || falseFirst < 0 || falseCount < 0
            || falseFirst > ifChildCount - falseCount)
        {
            return 3;
        }
        Host.StandaloneRewrittenSourceIfNodes[targetOffset]
            = Host.StandaloneRewriteBodyIds[bodyId];
        Host.StandaloneRewrittenSourceIfNodes[targetOffset + 1]
            = trueFirst;
        Host.StandaloneRewrittenSourceIfNodes[targetOffset + 2]
            = trueCount;
        Host.StandaloneRewrittenSourceIfNodes[targetOffset + 3]
            = falseFirst;
        Host.StandaloneRewrittenSourceIfNodes[targetOffset + 4]
            = falseCount;
    }
    for (mut int32 childId = 0;
        childId < ifChildCount;
        childId = childId + 1)
    {
        Host.StandaloneRewrittenSourceIfChildren[childId]
            = Host.StandaloneSourceIfChildren[childId];
    }
    for (mut int32 statementId = 0;
        statementId < Host.StandaloneSourceStatementCount[0];
        statementId = statementId + 1)
    {
        Host.StandaloneRewrittenSourceStatementParentIds[statementId]
            = Host.StandaloneSourceStatementParentIds[statementId];
    }

    Host.StandaloneRewrittenSourceLexicalScopeCount[0] = scopeCount;
    Host.StandaloneRewrittenSourceLocalCount[0] = localCount;
    Host.StandaloneRewrittenSourcePlaceCount[0] = placeCount;
    Host.StandaloneRewrittenSourceIfNodeCount[0] = ifNodeCount;
    Host.StandaloneRewrittenSourceIfChildCount[0] = ifChildCount;
    return 0;
}

int32 VerifyStandaloneRewrittenSourceArenas()
{
    int32 bodyCount = Host.StandaloneSourceBodyCount[0];
    int32 scopeCount = Host.StandaloneSourceLexicalScopeCount[0];
    int32 localCount = Host.StandaloneSourceLocalCount[0];
    int32 placeCount = Host.StandaloneSourcePlaceCount[0];
    int32 expressionCount
        = Host.StandaloneSourceExpressionCount[0];
    int32 statementCount
        = Host.StandaloneSourceStatementCount[0];
    int32 ifNodeCount
        = Host.StandaloneSourceIfNodeCount[0];
    int32 ifChildCount
        = Host.StandaloneSourceIfChildCount[0];
    if (Host.StandaloneRewrittenSourceBodyCount[0] != bodyCount
        || Host.StandaloneRewrittenSourceLexicalScopeCount[0]
            != scopeCount
        || Host.StandaloneRewrittenSourceLocalCount[0] != localCount
        || Host.StandaloneRewrittenSourcePlaceCount[0] != placeCount
        || Host.StandaloneRewrittenSourceIfNodeCount[0]
            != Host.StandaloneSourceIfNodeCount[0]
        || Host.StandaloneRewrittenSourceIfChildCount[0]
            != Host.StandaloneSourceIfChildCount[0])
    {
        return 3;
    }

    for (mut int32 oldBodyId = 0;
        oldBodyId < bodyCount;
        oldBodyId = oldBodyId + 1)
    {
        int32 newBodyId
            = Host.StandaloneRewriteBodyIds[oldBodyId];
        int32 oldScopeId
            = Host.StandaloneSourceBodyScopeIds[oldBodyId];
        if (oldScopeId < 0 || oldScopeId >= scopeCount)
        {
            return 3;
        }
        int32 newScopeId
            = Host.StandaloneRewriteScopeIds[oldScopeId];
        int32 oldRangeOffset = oldBodyId * 2;
        int32 newRangeOffset = newBodyId * 2;
        int32 oldBodyLocalFirst
            = Host.StandaloneSourceBodyLocalRanges[oldRangeOffset];
        int32 oldBodyLocalCount
            = Host.StandaloneSourceBodyLocalRanges[oldRangeOffset + 1];
        init int32 expectedBodyLocalFirst;
        int32 bodyLocalRangeStatus = GetStandaloneRewrittenLocalRange(
            oldBodyLocalFirst, oldBodyLocalCount, localCount, 0,
            ref init expectedBodyLocalFirst);
        int32 oldRootLocalFirst
            = Host.StandaloneSourceLexicalScopes[
                oldScopeId * 5 + 2];
        int32 oldRootLocalCount
            = Host.StandaloneSourceLexicalScopes[
                oldScopeId * 5 + 3];
        init int32 expectedRootLocalFirst;
        int32 rootLocalRangeStatus = GetStandaloneRewrittenLocalRange(
