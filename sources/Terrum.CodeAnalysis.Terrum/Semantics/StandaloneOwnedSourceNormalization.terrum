int32 NormalizeStandaloneSourceLazyBooleanChainValue(int32 bodyId,
    int32 expressionId, int32 expressionKind, int32 operandCount,
    int32 lastOperandId, int32 boolTypeId, int32 resultHomeId,
    ref<init int32> selectorKindResult,
    ref<init int32> sourceUseResult,
    ref<init int32> selectorIndexResult,
    ref<init bool> terminatedResult)
    ensure return == 0 ? (*selectorKindResult is init
        && *sourceUseResult is init
        && *selectorIndexResult is init
        && *terminatedResult is init) : true
{
    int32 bodyBlockFirst
        = Host.StandaloneNormalizedBodyBlockRanges[bodyId * 2];
    if (operandCount < 3 || operandCount > 32767
        || bodyBlockFirst < 0
        || (expressionKind != 35 && expressionKind != 36)
        || Host.StandaloneNormalizedBlockCount[0] != bodyBlockFirst)
    {
        return 2;
    }

    int32 rightValueBlockId = expressionKind == 35
        ? operandCount - 1 : operandCount;
    int32 shortCircuitBlockId = expressionKind == 35
        ? operandCount : operandCount - 1;
    int32 returnBlockId = operandCount + 1;
    int32 finalBodyBlockCount = operandCount + 2;
    int32 initialBlockCount
        = Host.StandaloneNormalizedBlockCount[0];
    init int32 nextOperandOrdinal;
    int32 conditionStatus
        = NormalizeStandaloneSourceLazyBooleanConditions(
            bodyId, expressionId,
            expressionKind, operandCount, lastOperandId, boolTypeId,
            finalBodyBlockCount, shortCircuitBlockId,
            rightValueBlockId, 0, 0,
            ref init nextOperandOrdinal);
    if (conditionStatus != 0)
    {
        return conditionStatus;
    }
    if (nextOperandOrdinal != operandCount - 1
        || Host.StandaloneNormalizedBlockCount[0]
            != initialBlockCount + operandCount - 1)
    {
        return 3;
    }

    int32 constantFirst
        = Host.StandaloneNormalizedBodies[bodyId * 12 + 3];
    if (expressionKind == 36)
    {
        int32 constantStatus
            = AppendStandaloneNormalizedLazyBooleanConstantBlock(
                bodyId, boolTypeId, constantFirst,
                resultHomeId,
                1, shortCircuitBlockId, returnBlockId);
        if (constantStatus != 0)
        {
            return constantStatus;
        }
    }

    int32 operationFirst
        = Host.StandaloneNormalizedOperationCount[0];
    init int32 resultSelectorKind;
    init int32 resultSourceUse;
    init int32 resultSelectorIndex;
    init bool resultTerminated;
    int32 resultStatus = NormalizeStandaloneSourceExpression(
        bodyId, lastOperandId, 1,
        ref init resultSelectorKind, ref init resultSourceUse,
        ref init resultSelectorIndex, ref init resultTerminated);
    if (resultStatus != 0)
    {
        return resultStatus;
    }
    int32 lastOperandOffset
        = (Host.StandaloneSourceBodies[bodyId * 12 + 3]
            + lastOperandId) * 8;
    if (Host.StandaloneSourceExpressions[lastOperandOffset + 1]
        != boolTypeId)
    {
        return 3;
    }
    int32 resultOperationCount
        = Host.StandaloneNormalizedOperationCount[0] - operationFirst;
    if (resultTerminated)
    {
        init int32 noReturnBlockIndex;
        int32 noReturnStatus = AppendStandaloneNormalizedReturnBlock(
            bodyId, rightValueBlockId, operationFirst,
            resultOperationCount, 1,
            ref init noReturnBlockIndex);
        if (noReturnStatus != 0)
        {
            return noReturnStatus;
        }
    }
    else
    {
        if (resultSelectorKind != 2 || resultSourceUse != 1
            || resultSelectorIndex < 0)
        {
            return 2;
        }
        int32 copyStatus = AppendStandaloneNormalizedOperation(
            bodyId, 38, resultSelectorIndex,
            resultHomeId, 0);
        if (copyStatus != 0)
        {
            return copyStatus;
        }
        resultOperationCount
            = Host.StandaloneNormalizedOperationCount[0] - operationFirst;
        init int32 resultBlockIndex;
        int32 resultBlockStatus
            = AppendStandaloneNormalizedBlock(
                bodyId, rightValueBlockId, operationFirst,
                resultOperationCount, 3, 0, 0, 0,
                returnBlockId, -1, 0, 0, 0, -1, -1, 0,
                ref init resultBlockIndex);
        if (resultBlockStatus != 0)
        {
            return resultBlockStatus;
        }
    }

    if (expressionKind == 35)
    {
        int32 constantStatus
            = AppendStandaloneNormalizedLazyBooleanConstantBlock(
                bodyId, boolTypeId, constantFirst,
                resultHomeId,
                0, shortCircuitBlockId, returnBlockId);
        if (constantStatus != 0)
        {
            return constantStatus;
        }
    }

    if (Host.StandaloneNormalizedBlockCount[0]
        != initialBlockCount + operandCount + 1)
    {
        return 3;
    }
    *selectorKindResult = 2;
    *sourceUseResult = 1;
    *selectorIndexResult = resultHomeId;
    *terminatedResult = false;
    return 0;
}

int32 NormalizeStandaloneSourceLazyBooleanValue(int32 bodyId,
    int32 expressionId, int32 depth,
    ref<init int32> selectorKindResult,
    ref<init int32> sourceUseResult,
    ref<init int32> selectorIndexResult,
    ref<init bool> terminatedResult)
    ensure return == 0 ? (*selectorKindResult is init
        && *sourceUseResult is init
        && *selectorIndexResult is init
        && *terminatedResult is init) : true
{
    if (bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || expressionId < 0
        || expressionId
            >= Host.StandaloneSourceBodies[bodyId * 12 + 4])
    {
        return 2;
    }
    int32 expressionOffset
        = (Host.StandaloneSourceBodies[bodyId * 12 + 3]
            + expressionId) * 8;
    int32 expressionKind
        = Host.StandaloneSourceExpressions[expressionOffset];
    int32 boolTypeId
        = Host.StandaloneSourceExpressions[expressionOffset + 1];
    int32 leftExpressionId
        = Host.StandaloneSourceExpressions[expressionOffset + 2];
    int32 rightExpressionId
        = Host.StandaloneSourceExpressions[expressionOffset + 3];
    int32 bodyBlockFirst
        = Host.StandaloneNormalizedBodyBlockRanges[bodyId * 2];
    if ((expressionKind != 35 && expressionKind != 36)
        || bodyBlockFirst < 0
        || Host.StandaloneNormalizedBlockCount[0] != bodyBlockFirst
        || !IsStandaloneLogicalNotType(boolTypeId)
        || leftExpressionId < 0
        || leftExpressionId >= expressionId
        || rightExpressionId < 0
        || rightExpressionId >= expressionId)
    {
        return 2;
    }

    init int32 leafCount;
    init bool homogeneous;
    int32 treeStatus = CountStandaloneSourceLazyBooleanTree(
        bodyId, expressionId, expressionKind, 0,
        ref init leafCount, ref init homogeneous);
    if (treeStatus != 0)
    {
        return treeStatus;
    }
    if (!homogeneous)
    {
        return NormalizeStandaloneSourceMixedLazyBooleanValue(
            bodyId, expressionId, leafCount, boolTypeId,
            ref init *selectorKindResult,
            ref init *sourceUseResult,
            ref init *selectorIndexResult,
            ref init *terminatedResult);
    }

    init int32 operandCount;
    init int32 lastOperandId;
    int32 operandCountStatus
        = CountStandaloneSourceLazyBooleanOperands(
            bodyId, expressionId, expressionKind, 0,
            ref init operandCount, ref init lastOperandId);
    if (operandCountStatus != 0)
    {
        return operandCountStatus;
    }
    if (operandCount > 2)
    {
        int32 homeFirst
            = Host.StandaloneNormalizedBodies[bodyId * 12 + 1];
        init int32 resultHomeId;
        int32 resultHomeStatus = AppendStandaloneNormalizedHome(
            bodyId, homeFirst, 3, boolTypeId, 0,
            ref init resultHomeId);
        if (resultHomeStatus != 0)
        {
            return resultHomeStatus;
        }
        return NormalizeStandaloneSourceLazyBooleanChainValue(
            bodyId, expressionId, expressionKind, operandCount,
            lastOperandId, boolTypeId, resultHomeId,
            ref init *selectorKindResult,
            ref init *sourceUseResult,
            ref init *selectorIndexResult,
            ref init *terminatedResult);
    }
    if (operandCount != 2)
    {
        return 2;
    }

    init int32 conditionSelectorKind;
    init int32 conditionSourceUse;
    init int32 conditionSelectorIndex;
    init bool conditionTerminated;
    int32 conditionStatus = NormalizeStandaloneSourceExpression(
        bodyId, leftExpressionId, depth + 1,
        ref init conditionSelectorKind,
        ref init conditionSourceUse,
        ref init conditionSelectorIndex,
        ref init conditionTerminated);
    if (conditionStatus != 0)
    {
        return conditionStatus;
    }
    if (conditionTerminated || conditionSelectorKind != 2
        || conditionSourceUse != 1 || conditionSelectorIndex < 0)
    {
        return 2;
    }

    int32 homeFirst
        = Host.StandaloneNormalizedBodies[bodyId * 12 + 1];
    int32 operationFirst
        = Host.StandaloneNormalizedBodies[bodyId * 12 + 9];
    int32 conditionOperationCount
        = Host.StandaloneNormalizedOperationCount[0]
            - operationFirst;
    if (conditionOperationCount < 0)
    {
        return 3;
    }
    init int32 resultHomeId;
    int32 resultHomeStatus = AppendStandaloneNormalizedHome(
        bodyId, homeFirst, 3, boolTypeId, 0,
        ref init resultHomeId);
    if (resultHomeStatus != 0)
    {
        return resultHomeStatus;
    }
    init int32 conditionBlockIndex;
    int32 conditionBlockStatus
        = AppendStandaloneNormalizedBlock(
            bodyId, 0, operationFirst, conditionOperationCount,
            4, 0, 0, 0, 1, 2, 2, conditionSelectorIndex,
            boolTypeId, 4, -1, 0,
            ref init conditionBlockIndex);
    if (conditionBlockStatus != 0)
    {
        return conditionBlockStatus;
    }

    int32 constantFirst
        = Host.StandaloneNormalizedBodies[bodyId * 12 + 3];
    int32 rightBranch = expressionKind == 35 ? 0 : 1;
    for (mut int32 branchIndex = 0;
        branchIndex < 2;
        branchIndex = branchIndex + 1)
    {
        int32 branchOperationFirst
            = Host.StandaloneNormalizedOperationCount[0];
        if (branchIndex == rightBranch)
        {
            init int32 branchSelectorKind;
            init int32 branchSourceUse;
            init int32 branchSelectorIndex;
            init bool branchTerminated;
            int32 branchStatus = NormalizeStandaloneSourceExpression(
                bodyId, rightExpressionId, depth + 1,
                ref init branchSelectorKind,
                ref init branchSourceUse,
                ref init branchSelectorIndex,
                ref init branchTerminated);
            if (branchStatus != 0)
            {
                return branchStatus;
            }
            if (branchTerminated)
            {
                int32 branchOperationCount
                    = Host.StandaloneNormalizedOperationCount[0]
                        - branchOperationFirst;
                init int32 noReturnBlockIndex;
                int32 noReturnBlockStatus
                    = AppendStandaloneNormalizedReturnBlock(
                        bodyId, branchIndex + 1, branchOperationFirst,
                        branchOperationCount, 1,
                        ref init noReturnBlockIndex);
                if (noReturnBlockStatus != 0)
                {
                    return noReturnBlockStatus;
                }
                continue;
            }
            if (branchSelectorKind != 2 || branchSourceUse != 1
                || branchSelectorIndex < 0)
            {
                return 2;
            }
            int32 copyStatus = AppendStandaloneNormalizedOperation(
                bodyId, 38, branchSelectorIndex, resultHomeId, 0);
            if (copyStatus != 0)
            {
                return copyStatus;
            }
        }
        else
        {
            init int32 constantId;
            int32 constantStatus
                = AppendStandaloneNormalizedConstant(
                    bodyId, constantFirst, boolTypeId,
                    expressionKind == 36 ? 1 : 0, 0,
                    ref init constantId);
            if (constantStatus != 0)
            {
                return constantStatus;
            }
            int32 operationStatus
                = AppendStandaloneNormalizedOperation(
                    bodyId, 1, constantId, 0, 0);
            if (operationStatus != 0)
            {
                return operationStatus;
            }
            operationStatus
                = AppendStandaloneNormalizedOperation(
                    bodyId, 2, resultHomeId, 0, 0);
            if (operationStatus != 0)
            {
                return operationStatus;
            }
        }
        int32 branchOperationCount
            = Host.StandaloneNormalizedOperationCount[0]
                - branchOperationFirst;
        if (branchOperationCount == 0)
        {
            return 3;
        }
        init int32 branchBlockIndex;
        int32 branchBlockStatus
            = AppendStandaloneNormalizedBlock(
                bodyId, branchIndex + 1, branchOperationFirst,
                branchOperationCount, 3, 0, 0, 0, 3, -1,
                0, 0, 0, -1, -1, 0,
                ref init branchBlockIndex);
        if (branchBlockStatus != 0)
        {
            return branchBlockStatus;
        }
    }

    *selectorKindResult = 2;
    *sourceUseResult = 1;
    *selectorIndexResult = resultHomeId;
    *terminatedResult = false;
    return 0;
}

int32 NormalizeStandaloneSourceExpression(int32 bodyId,
    int32 expressionId, int32 depth,
    ref<init int32> selectorKindResult,
    ref<init int32> sourceUseResult,
    ref<init int32> selectorIndexResult,
    ref<init bool> terminatedResult)
    ensure return == 0 ? (*selectorKindResult is init
        && *sourceUseResult is init
        && *selectorIndexResult is init
        && *terminatedResult is init) : true
{
    if (depth > 64 || bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0])
    {
        return 3;
    }
    int32 bodyOffset = bodyId * 12;
    int32 expressionFirst
        = Host.StandaloneSourceBodies[bodyOffset + 3];
    int32 expressionCount
        = Host.StandaloneSourceBodies[bodyOffset + 4];
    if (expressionId < 0 || expressionId >= expressionCount)
    {
        return 3;
    }
    int32 expressionIndex = expressionFirst + expressionId;
    int32 expressionOffset = expressionIndex * 8;
    int32 expressionKind
        = Host.StandaloneSourceExpressions[expressionOffset];
    int32 typeId
        = Host.StandaloneSourceExpressions[expressionOffset + 1];
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0])
    {
        return 3;
    }

    if (expressionKind == 34)
    {
        return NormalizeStandaloneSourceConditionalValue(
            bodyId, expressionId, depth,
            ref init *selectorKindResult,
            ref init *sourceUseResult,
            ref init *selectorIndexResult,
            ref init *terminatedResult);
    }
    if (expressionKind == 35 || expressionKind == 36)
    {
        return NormalizeStandaloneSourceLazyBooleanValue(
            bodyId, expressionId, depth,
            ref init *selectorKindResult,
            ref init *sourceUseResult,
            ref init *selectorIndexResult,
            ref init *terminatedResult);
    }
    if (expressionKind == 1 || expressionKind == 4)
    {
        return NormalizeStandaloneParameterExpression(bodyId,
            expressionKind, typeId,
            Host.StandaloneSourceExpressions[expressionOffset + 2],
            ref init *selectorKindResult,
            ref init *sourceUseResult,
            ref init *selectorIndexResult,
            ref init *terminatedResult);
    }
    if (expressionKind == 2)
    {
        if (GetStandaloneSourceUse(typeId) != 1)
        {
            return 3;
        }
        int32 constantFirst
            = Host.StandaloneNormalizedBodies[bodyId * 12 + 3];
        int32 homeFirst
            = Host.StandaloneNormalizedBodies[bodyId * 12 + 1];
        init int32 constantId;
        int32 constantStatus = AppendStandaloneNormalizedConstant(
            bodyId, constantFirst, typeId,
            Host.StandaloneSourceExpressions[expressionOffset + 4],
            Host.StandaloneSourceExpressions[expressionOffset + 5],
            ref init constantId);
        if (constantStatus != 0)
        {
            return constantStatus;
        }
        init int32 homeId;
        int32 homeStatus = AppendStandaloneNormalizedHome(
            bodyId, homeFirst, 3, typeId, 0,
            ref init homeId);
        if (homeStatus != 0)
        {
            return homeStatus;
        }
        int32 loadStatus = AppendStandaloneNormalizedOperation(
            bodyId, 1, constantId, 0, 0);
        if (loadStatus != 0)
        {
            return loadStatus;
        }
        int32 storeStatus = AppendStandaloneNormalizedOperation(
            bodyId, 2, homeId, 0, 0);
        if (storeStatus != 0)
        {
            return storeStatus;
        }
        *selectorKindResult = 2;
        *sourceUseResult = 1;
        *selectorIndexResult = homeId;
        *terminatedResult = false;
        return 0;
    }
    if (expressionKind == 5)
    {
        int32 placeId
            = Host.StandaloneSourceExpressions[expressionOffset + 2];
        int32 bodyPlaceRangeOffset = bodyId * 2;
        int32 bodyPlaceFirst
            = Host.StandaloneSourceBodyPlaceRanges[
                bodyPlaceRangeOffset];
        int32 bodyPlaceCount
            = Host.StandaloneSourceBodyPlaceRanges[
                bodyPlaceRangeOffset + 1];
        if (placeId < bodyPlaceFirst
            || placeId >= bodyPlaceFirst + bodyPlaceCount)
        {
            return 3;
        }
        int32 placeOffset = placeId * 5;
        int32 localId
            = Host.StandaloneSourcePlaces[placeOffset + 3];
        int32 localRangeOffset = bodyId * 2;
        int32 localFirst
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset];
        int32 localCount
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset + 1];
        if (Host.StandaloneSourcePlaces[placeOffset] != bodyId
            || Host.StandaloneSourcePlaces[placeOffset + 1] != typeId
            || Host.StandaloneSourcePlaces[placeOffset + 2] != 1
