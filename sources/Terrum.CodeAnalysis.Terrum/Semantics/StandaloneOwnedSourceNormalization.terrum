    init int32 leafCount;
    init bool homogeneous;
    int32 treeStatus = CountStandaloneSourceLazyBooleanTree(
        bodyId, expressionId, expressionKind, 0,
        ref init leafCount, ref init homogeneous);
    if (treeStatus != 0)
    {
        return treeStatus;
    }
    if (!homogeneous)
    {
        return NormalizeStandaloneSourceMixedLazyBooleanValue(
            bodyId, expressionId, leafCount, boolTypeId,
            ref init *selectorKindResult,
            ref init *sourceUseResult,
            ref init *selectorIndexResult,
            ref init *terminatedResult);
    }

    init int32 operandCount;
    init int32 lastOperandId;
    int32 operandCountStatus
        = CountStandaloneSourceLazyBooleanOperands(
            bodyId, expressionId, expressionKind, 0,
            ref init operandCount, ref init lastOperandId);
    if (operandCountStatus != 0)
    {
        return operandCountStatus;
    }
    if (operandCount > 2)
    {
        int32 homeFirst
            = Host.StandaloneNormalizedBodies[bodyId * 12 + 1];
        init int32 resultHomeId;
        int32 resultHomeStatus = AppendStandaloneNormalizedHome(
            bodyId, homeFirst, 3, boolTypeId, 0,
            ref init resultHomeId);
        if (resultHomeStatus != 0)
        {
            return resultHomeStatus;
        }
        return NormalizeStandaloneSourceLazyBooleanChainValue(
            bodyId, expressionId, expressionKind, operandCount,
            lastOperandId, boolTypeId, resultHomeId,
            ref init *selectorKindResult,
            ref init *sourceUseResult,
            ref init *selectorIndexResult,
            ref init *terminatedResult);
    }
    if (operandCount != 2)
    {
        return 2;
    }

    init int32 conditionSelectorKind;
    init int32 conditionSourceUse;
    init int32 conditionSelectorIndex;
    init bool conditionTerminated;
    int32 conditionStatus = NormalizeStandaloneSourceExpression(
        bodyId, leftExpressionId, depth + 1,
        ref init conditionSelectorKind,
        ref init conditionSourceUse,
        ref init conditionSelectorIndex,
        ref init conditionTerminated);
    if (conditionStatus != 0)
    {
        return conditionStatus;
    }
    if (conditionTerminated || conditionSelectorKind != 2
        || conditionSourceUse != 1 || conditionSelectorIndex < 0)
    {
        return 2;
    }

    int32 homeFirst
        = Host.StandaloneNormalizedBodies[bodyId * 12 + 1];
    int32 operationFirst
        = Host.StandaloneNormalizedBodies[bodyId * 12 + 9];
    int32 conditionOperationCount
        = Host.StandaloneNormalizedOperationCount[0]
            - operationFirst;
    if (conditionOperationCount < 0)
    {
        return 3;
    }
    init int32 resultHomeId;
    int32 resultHomeStatus = AppendStandaloneNormalizedHome(
        bodyId, homeFirst, 3, boolTypeId, 0,
        ref init resultHomeId);
    if (resultHomeStatus != 0)
    {
        return resultHomeStatus;
    }
    init int32 conditionBlockIndex;
    int32 conditionBlockStatus
        = AppendStandaloneNormalizedBlock(
            bodyId, 0, operationFirst, conditionOperationCount,
            4, 0, 0, 0, 1, 2, 2, conditionSelectorIndex,
            boolTypeId, 4, -1, 0,
            ref init conditionBlockIndex);
    if (conditionBlockStatus != 0)
    {
        return conditionBlockStatus;
    }

    int32 constantFirst
        = Host.StandaloneNormalizedBodies[bodyId * 12 + 3];
    int32 rightBranch = expressionKind == 35 ? 0 : 1;
    for (mut int32 branchIndex = 0;
        branchIndex < 2;
        branchIndex = branchIndex + 1)
    {
        int32 branchOperationFirst
            = Host.StandaloneNormalizedOperationCount[0];
        if (branchIndex == rightBranch)
        {
            init int32 branchSelectorKind;
            init int32 branchSourceUse;
            init int32 branchSelectorIndex;
            init bool branchTerminated;
            int32 branchStatus = NormalizeStandaloneSourceExpression(
                bodyId, rightExpressionId, depth + 1,
                ref init branchSelectorKind,
                ref init branchSourceUse,
                ref init branchSelectorIndex,
                ref init branchTerminated);
            if (branchStatus != 0)
            {
                return branchStatus;
            }
            if (branchTerminated)
            {
                int32 branchOperationCount
                    = Host.StandaloneNormalizedOperationCount[0]
                        - branchOperationFirst;
                init int32 noReturnBlockIndex;
                int32 noReturnBlockStatus
                    = AppendStandaloneNormalizedReturnBlock(
                        bodyId, branchIndex + 1, branchOperationFirst,
                        branchOperationCount, 1,
                        ref init noReturnBlockIndex);
                if (noReturnBlockStatus != 0)
                {
                    return noReturnBlockStatus;
                }
                continue;
            }
            if (branchSelectorKind != 2 || branchSourceUse != 1
                || branchSelectorIndex < 0)
            {
                return 2;
            }
            int32 copyStatus = AppendStandaloneNormalizedOperation(
                bodyId, 38, branchSelectorIndex, resultHomeId, 0);
            if (copyStatus != 0)
            {
                return copyStatus;
            }
        }
        else
        {
            init int32 constantId;
            int32 constantStatus
                = AppendStandaloneNormalizedConstant(
                    bodyId, constantFirst, boolTypeId,
                    expressionKind == 36 ? 1 : 0, 0,
                    ref init constantId);
            if (constantStatus != 0)
            {
                return constantStatus;
            }
            int32 operationStatus
                = AppendStandaloneNormalizedOperation(
                    bodyId, 1, constantId, 0, 0);
            if (operationStatus != 0)
            {
                return operationStatus;
            }
            operationStatus
                = AppendStandaloneNormalizedOperation(
                    bodyId, 2, resultHomeId, 0, 0);
            if (operationStatus != 0)
            {
                return operationStatus;
            }
        }
        int32 branchOperationCount
            = Host.StandaloneNormalizedOperationCount[0]
                - branchOperationFirst;
        if (branchOperationCount == 0)
        {
            return 3;
        }
        init int32 branchBlockIndex;
        int32 branchBlockStatus
            = AppendStandaloneNormalizedBlock(
                bodyId, branchIndex + 1, branchOperationFirst,
                branchOperationCount, 3, 0, 0, 0, 3, -1,
                0, 0, 0, -1, -1, 0,
                ref init branchBlockIndex);
        if (branchBlockStatus != 0)
        {
            return branchBlockStatus;
        }
    }

    *selectorKindResult = 2;
    *sourceUseResult = 1;
    *selectorIndexResult = resultHomeId;
    *terminatedResult = false;
    return 0;
}

int32 NormalizeStandaloneSourceExpression(int32 bodyId,
    int32 expressionId, int32 depth,
    ref<init int32> selectorKindResult,
    ref<init int32> sourceUseResult,
    ref<init int32> selectorIndexResult,
    ref<init bool> terminatedResult)
    ensure return == 0 ? (*selectorKindResult is init
        && *sourceUseResult is init
        && *selectorIndexResult is init
        && *terminatedResult is init) : true
{
    if (depth > 64 || bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0])
    {
        return 3;
    }
    int32 bodyOffset = bodyId * 12;
    int32 expressionFirst
        = Host.StandaloneSourceBodies[bodyOffset + 3];
    int32 expressionCount
        = Host.StandaloneSourceBodies[bodyOffset + 4];
    if (expressionId < 0 || expressionId >= expressionCount)
    {
        return 3;
    }
    int32 expressionIndex = expressionFirst + expressionId;
    int32 expressionOffset = expressionIndex * 8;
    int32 expressionKind
        = Host.StandaloneSourceExpressions[expressionOffset];
    int32 typeId
        = Host.StandaloneSourceExpressions[expressionOffset + 1];
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0])
    {
        return 3;
    }

    if (expressionKind == 7)
    {
        if (!IsStandaloneUnitType(typeId)
            || GetStandaloneSourceUse(typeId) != 0
            || Host.StandaloneSourceExpressions[
                expressionOffset + 2] != 0
            || Host.StandaloneSourceExpressions[
                expressionOffset + 3] != 0
            || Host.StandaloneSourceExpressions[
                expressionOffset + 4] != 0
            || Host.StandaloneSourceExpressions[
                expressionOffset + 5] != 0
            || Host.StandaloneSourceExpressions[
                expressionOffset + 6] != -1)
        {
            return 3;
        }
        *selectorKindResult = 0;
        *sourceUseResult = 0;
        *selectorIndexResult = 0;
        *terminatedResult = false;
        return 0;
    }

    if (expressionKind == 34)
    {
        return NormalizeStandaloneSourceConditionalValue(
            bodyId, expressionId, depth,
            ref init *selectorKindResult,
            ref init *sourceUseResult,
            ref init *selectorIndexResult,
            ref init *terminatedResult);
    }
    if (expressionKind == 35 || expressionKind == 36)
    {
        return NormalizeStandaloneSourceLazyBooleanValue(
            bodyId, expressionId, depth,
            ref init *selectorKindResult,
            ref init *sourceUseResult,
            ref init *selectorIndexResult,
            ref init *terminatedResult);
    }
    if (expressionKind == 1 || expressionKind == 4)
    {
        return NormalizeStandaloneParameterExpression(bodyId,
            expressionKind, typeId,
            Host.StandaloneSourceExpressions[expressionOffset + 2],
            ref init *selectorKindResult,
            ref init *sourceUseResult,
            ref init *selectorIndexResult,
            ref init *terminatedResult);
    }
    if (expressionKind == 2)
    {
        if (GetStandaloneSourceUse(typeId) != 1)
        {
            return 3;
        }
        int32 constantFirst
            = Host.StandaloneNormalizedBodies[bodyId * 12 + 3];
        int32 homeFirst
            = Host.StandaloneNormalizedBodies[bodyId * 12 + 1];
        init int32 constantId;
        int32 constantStatus = AppendStandaloneNormalizedConstant(
            bodyId, constantFirst, typeId,
            Host.StandaloneSourceExpressions[expressionOffset + 4],
            Host.StandaloneSourceExpressions[expressionOffset + 5],
            ref init constantId);
        if (constantStatus != 0)
        {
            return constantStatus;
        }
        init int32 homeId;
        int32 homeStatus = AppendStandaloneNormalizedHome(
            bodyId, homeFirst, 3, typeId, 0,
            ref init homeId);
        if (homeStatus != 0)
        {
            return homeStatus;
        }
        int32 loadStatus = AppendStandaloneNormalizedOperation(
            bodyId, 1, constantId, 0, 0);
        if (loadStatus != 0)
        {
            return loadStatus;
        }
        int32 storeStatus = AppendStandaloneNormalizedOperation(
            bodyId, 2, homeId, 0, 0);
        if (storeStatus != 0)
        {
            return storeStatus;
        }
        *selectorKindResult = 2;
        *sourceUseResult = 1;
        *selectorIndexResult = homeId;
        *terminatedResult = false;
        return 0;
    }
    if (expressionKind == 5)
    {
        int32 placeId
            = Host.StandaloneSourceExpressions[expressionOffset + 2];
        int32 bodyPlaceRangeOffset = bodyId * 2;
        int32 bodyPlaceFirst
            = Host.StandaloneSourceBodyPlaceRanges[
                bodyPlaceRangeOffset];
        int32 bodyPlaceCount
            = Host.StandaloneSourceBodyPlaceRanges[
                bodyPlaceRangeOffset + 1];
        if (placeId < bodyPlaceFirst
            || placeId >= bodyPlaceFirst + bodyPlaceCount)
        {
            return 3;
        }
        int32 placeOffset = placeId * 5;
        int32 localId
            = Host.StandaloneSourcePlaces[placeOffset + 3];
        int32 localRangeOffset = bodyId * 2;
        int32 localFirst
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset];
        int32 localCount
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset + 1];
        if (Host.StandaloneSourcePlaces[placeOffset] != bodyId
            || Host.StandaloneSourcePlaces[placeOffset + 1] != typeId
            || Host.StandaloneSourcePlaces[placeOffset + 2] != 1
            || localId < localFirst
            || localId >= localFirst + localCount
            || Host.StandaloneSourceLocalStates[localId] != 1
            || Host.StandaloneSourceLocals[localId * 10 + 2]
                != typeId)
        {
            return 3;
        }

        int32 bindingKind
            = Host.StandaloneSourceLocals[localId * 10 + 3];
        int32 sourceUse = GetStandaloneSourceUse(typeId);
        int32 homeId
            = Host.StandaloneNormalizedSourceLocalHomeIds[localId];
        if (sourceUse == 0)
        {
            if (homeId != 0)
            {
                return 3;
            }
            *selectorKindResult = 0;
            *sourceUseResult = 0;
            *selectorIndexResult = 0;
        }
        else
        {
            int32 homeFirst
                = Host.StandaloneNormalizedBodies[
                    bodyId * 12 + 1];
            int32 bodyHomeCount
                = Host.StandaloneNormalizedHomeCount[0] - homeFirst;
            if (sourceUse != 1 || homeId < 0
                || homeId >= bodyHomeCount)
            {
                return 3;
            }
            int32 homeOffset = (homeFirst + homeId) * 5;
            if (Host.StandaloneNormalizedHomes[homeOffset] != bodyId
                || Host.StandaloneNormalizedHomes[
                    homeOffset + 3] != typeId)
            {
                return 3;
            }
            if (bindingKind == 1 || bindingKind == 3)
            {
                init int32 snapshotHomeId;
                int32 snapshotStatus
                    = AppendStandaloneNormalizedHome(
                        bodyId, homeFirst, 3, typeId, 0,
                        ref init snapshotHomeId);
                if (snapshotStatus != 0)
                {
                    return snapshotStatus;
                }
                int32 copyStatus
                    = AppendStandaloneNormalizedOperation(
                        bodyId, 31, homeId, snapshotHomeId,
                        localId);
                if (copyStatus != 0)
                {
                    return copyStatus;
                }
                *selectorKindResult = 2;
                *sourceUseResult = sourceUse;
                *selectorIndexResult = snapshotHomeId;
                *terminatedResult = false;
                return 0;
            }
            *selectorKindResult = 2;
            *sourceUseResult = sourceUse;
            *selectorIndexResult = homeId;
        }
        *terminatedResult = false;
        return 0;
    }
    if (expressionKind == 26)
    {
        int32 placeId
            = Host.StandaloneSourceExpressions[expressionOffset + 2];
        int32 stateAtTest
            = Host.StandaloneSourceExpressions[expressionOffset + 3];
        int32 bodyPlaceRangeOffset = bodyId * 2;
        int32 bodyPlaceFirst
            = Host.StandaloneSourceBodyPlaceRanges[
                bodyPlaceRangeOffset];
        int32 bodyPlaceCount
            = Host.StandaloneSourceBodyPlaceRanges[
                bodyPlaceRangeOffset + 1];
        if (!IsStandaloneLogicalNotType(typeId)
            || placeId < bodyPlaceFirst
            || placeId >= bodyPlaceFirst + bodyPlaceCount
            || (stateAtTest != 0 && stateAtTest != 1)
            || Host.StandaloneSourceExpressions[
                expressionOffset + 4] != 0
            || Host.StandaloneSourceExpressions[
                expressionOffset + 5] != 0
            || Host.StandaloneSourceExpressions[
                expressionOffset + 6] != -1)
        {
            return 3;
        }
        int32 placeOffset = placeId * 5;
        int32 placeKind
            = Host.StandaloneSourcePlaces[placeOffset + 2];
        int32 targetIndex
            = Host.StandaloneSourcePlaces[placeOffset + 3];
        int32 placeTypeId
            = Host.StandaloneSourcePlaces[placeOffset + 1];
        if (Host.StandaloneSourcePlaces[placeOffset] != bodyId
            || (placeKind != 3 && placeKind != 4))
        {
            return 3;
        }
        if (placeKind == 3)
        {
            int32 localRangeOffset = bodyId * 2;
            int32 localFirst
                = Host.StandaloneSourceBodyLocalRanges[
                    localRangeOffset];
            int32 localCount
                = Host.StandaloneSourceBodyLocalRanges[
                    localRangeOffset + 1];
            if (targetIndex < localFirst
                || targetIndex >= localFirst + localCount
                || Host.StandaloneSourceLocals[
                    targetIndex * 10 + 2] != placeTypeId)
            {
                return 3;
            }
        }
        else
        {
            int32 parameterFirst
                = Host.StandaloneSourceCallableInfo[
                    bodyId * 12 + 5];
            int32 parameterCount
                = Host.StandaloneSourceCallableInfo[
                    bodyId * 12 + 6];
            if (targetIndex < 0 || targetIndex >= parameterCount
                || stateAtTest != 1)
            {
                return 3;
            }
            int32 parameterRow = parameterFirst + targetIndex;
            if (parameterRow < 0
                || parameterRow
                    >= Host.StandaloneSourceParameterCount[0]
                || Host.StandaloneSourceParameters[
                    parameterRow * 4] != bodyId
                || Host.StandaloneSourceParameters[
                    parameterRow * 4 + 1] != placeTypeId)
            {
                return 3;
            }
        }

        int32 constantFirst
            = Host.StandaloneNormalizedBodies[bodyId * 12 + 3];
        int32 homeFirst
            = Host.StandaloneNormalizedBodies[bodyId * 12 + 1];
        init int32 constantId;
        int32 constantStatus = AppendStandaloneNormalizedConstant(
            bodyId, constantFirst, typeId,
            stateAtTest == 0 ? 1 : 0, 0,
            ref init constantId);
        if (constantStatus != 0)
        {
            return constantStatus;
        }
        init int32 resultHomeId;
        int32 homeStatus = AppendStandaloneNormalizedHome(
            bodyId, homeFirst, 3, typeId, 0,
            ref init resultHomeId);
        if (homeStatus != 0)
        {
            return homeStatus;
        }
        int32 operationStatus = AppendStandaloneNormalizedOperation(
            bodyId, 1, constantId, 0, 0);
        if (operationStatus != 0)
        {
            return operationStatus;
        }
        operationStatus = AppendStandaloneNormalizedOperation(
            bodyId, 2, resultHomeId, 0, 0);
        if (operationStatus != 0)
        {
            return operationStatus;
        }
        *selectorKindResult = 2;
        *sourceUseResult = 1;
        *selectorIndexResult = resultHomeId;
        *terminatedResult = false;
        return 0;
    }
    if (expressionKind == 6 || expressionKind == 8)
    {
        int32 operandExpressionId
            = Host.StandaloneSourceExpressions[
                expressionOffset + 2];
        if ((expressionKind == 6
                && !IsStandaloneUnaryPlusType(typeId))
            || (expressionKind == 8
                && !IsStandaloneSourceConstructionType(typeId))
            || operandExpressionId < 0
            || operandExpressionId >= expressionId)
        {
            return 3;
        }
        init int32 operandSelectorKind;
        init int32 operandSourceUse;
        init int32 operandSelectorIndex;
        init bool operandTerminated;
        int32 operandStatus = NormalizeStandaloneSourceExpression(
            bodyId, operandExpressionId, depth + 1,
            ref init operandSelectorKind,
            ref init operandSourceUse,
            ref init operandSelectorIndex,
            ref init operandTerminated);
        if (operandStatus != 0)
        {
            return operandStatus;
        }
        if (operandTerminated)
        {
            *selectorKindResult = 0;
            *sourceUseResult = 0;
            *selectorIndexResult = 0;
            *terminatedResult = true;
            return 0;
        }
        *selectorKindResult = operandSelectorKind;
        *sourceUseResult = operandSourceUse;
        *selectorIndexResult = operandSelectorIndex;
        *terminatedResult = false;
        return 0;
    }
    if (expressionKind >= 27 && expressionKind <= 30)
    {
        int32 operandExpressionId
            = Host.StandaloneSourceExpressions[
                expressionOffset + 2];
        int32 writePlaceId
            = Host.StandaloneSourceExpressions[
                expressionOffset + 3];
        if (!IsStandaloneArithmeticType(typeId)
            || operandExpressionId < 0
            || operandExpressionId >= expressionId)
        {
            return 3;
        }
        init int32 operandSelectorKind;
        init int32 operandSourceUse;
        init int32 operandSelectorIndex;
        init bool operandTerminated;
        int32 operandStatus = NormalizeStandaloneSourceExpression(
            bodyId, operandExpressionId, depth + 1,
            ref init operandSelectorKind,
            ref init operandSourceUse,
            ref init operandSelectorIndex,
            ref init operandTerminated);
        if (operandStatus != 0)
        {
            return operandStatus;
        }
        if (operandTerminated)
        {
            *selectorKindResult = 0;
            *sourceUseResult = 0;
            *selectorIndexResult = 0;
            *terminatedResult = true;
            return 0;
        }
        if (operandSelectorKind != 2 || operandSourceUse != 1
            || operandSelectorIndex < 0
            || writePlaceId < 0
            || writePlaceId
                >= Host.StandaloneSourcePlaceCount[0])
        {
            return 3;
        }
        int32 writePlaceOffset = writePlaceId * 5;
        int32 localId
            = Host.StandaloneSourcePlaces[writePlaceOffset + 3];
        int32 localOffset = localId * 10;
        int32 localHomeId
            = localId >= 0
                && localId
                    < Host.StandaloneSourceLocalCount[0]
                ? Host.StandaloneNormalizedSourceLocalHomeIds[
                    localId] : -1;
        int32 homeFirst
            = Host.StandaloneNormalizedBodies[bodyId * 12 + 1];
        int32 bodyHomeCount
            = Host.StandaloneNormalizedHomeCount[0] - homeFirst;
        int32 operandHomeOffset
            = (homeFirst + operandSelectorIndex) * 5;
        if (Host.StandaloneSourcePlaces[writePlaceOffset] != bodyId
            || Host.StandaloneSourcePlaces[
                writePlaceOffset + 1] != typeId
            || Host.StandaloneSourcePlaces[
                writePlaceOffset + 2] != 2
            || localId < 0
            || localId
                >= Host.StandaloneSourceLocalCount[0]
            || Host.StandaloneSourceLocals[localOffset] != bodyId
            || Host.StandaloneSourceLocals[
                localOffset + 2] != typeId
            || (Host.StandaloneSourceLocals[
                    localOffset + 3] != 1
                && Host.StandaloneSourceLocals[
                    localOffset + 3] != 3)
            || Host.StandaloneSourceLocalStates[localId] != 1
            || localHomeId < 0
            || localHomeId >= bodyHomeCount
            || operandSelectorIndex >= bodyHomeCount
            || Host.StandaloneNormalizedHomes[
                operandHomeOffset] != bodyId
            || Host.StandaloneNormalizedHomes[
                operandHomeOffset + 3] != typeId)
        {
            return 3;
        }

        int32 typeCode
            = Host.StandaloneTypeFacts[typeId * 3 + 1];
        mut int32 oneLow = 1;
        mut int32 oneHigh = 0;
        if (typeCode == 0x14)
        {
            oneLow = 0x3F800000;
        }
        else if (typeCode == 0x15)
        {
            oneLow = 0;
            oneHigh = 0x3FF00000;
        }
        int32 constantFirst
            = Host.StandaloneNormalizedBodies[bodyId * 12 + 3];
        init int32 oneConstantId;
        int32 constantStatus
            = AppendStandaloneNormalizedConstant(
                bodyId, constantFirst, typeId, oneLow, oneHigh,
                ref init oneConstantId);
        if (constantStatus != 0)
        {
            return constantStatus;
        }
        init int32 oneHomeId;
        int32 oneHomeStatus = AppendStandaloneNormalizedHome(
            bodyId, homeFirst, 3, typeId, 0,
            ref init oneHomeId);
        if (oneHomeStatus != 0)
        {
            return oneHomeStatus;
        }
        int32 operationStatus
            = AppendStandaloneNormalizedOperation(
                bodyId, 1, oneConstantId, 0, 0);
        if (operationStatus != 0)
        {
            return operationStatus;
        }
        operationStatus = AppendStandaloneNormalizedOperation(
            bodyId, 2, oneHomeId, 0, 0);
        if (operationStatus != 0)
        {
            return operationStatus;
        }

        init int32 resultHomeId;
        int32 resultHomeStatus = AppendStandaloneNormalizedHome(
            bodyId, homeFirst, 3, typeId, 0,
            ref init resultHomeId);
        if (resultHomeStatus != 0)
        {
            return resultHomeStatus;
        }
        bool increment
            = expressionKind == 27 || expressionKind == 29;
        int32 operationKind;
        if (typeCode == 0x14 || typeCode == 0x15)
        {
            operationKind = increment ? 25 : 26;
        }
        else if (Host.StandaloneSourceArithmeticProfile[0] == 0)
        {
            operationKind = increment ? 17 : 18;
        }
        else
        {
            operationKind = increment ? 20 : 21;
        }
        operationStatus = AppendStandaloneNormalizedOperation(
            bodyId, operationKind, operandSelectorIndex,
            oneHomeId, resultHomeId);
        if (operationStatus != 0)
        {
            return operationStatus;
        }
        operationStatus = AppendStandaloneNormalizedOperation(
            bodyId, 30, resultHomeId, localHomeId, localId);
        if (operationStatus != 0)
        {
            return operationStatus;
        }
        *selectorKindResult = 2;
        *sourceUseResult = 1;
        *selectorIndexResult
            = expressionKind == 27 || expressionKind == 28
                ? resultHomeId : operandSelectorIndex;
        *terminatedResult = false;
        return 0;
    }
    if (expressionKind == 12 || expressionKind == 13
        || expressionKind == 14 || expressionKind == 15
        || expressionKind == 16 || expressionKind == 17
        || expressionKind == 18 || expressionKind == 19
        || expressionKind == 20 || expressionKind == 21
        || expressionKind == 22 || expressionKind == 23
        || expressionKind == 24 || expressionKind == 25
        || (expressionKind >= 31 && expressionKind <= 33))
    {
        int32 leftExpressionId
            = Host.StandaloneSourceExpressions[
                expressionOffset + 2];
        int32 rightExpressionId
            = Host.StandaloneSourceExpressions[
                expressionOffset + 3];
        bool comparison
            = expressionKind >= 15 && expressionKind <= 20;
        bool arithmetic
            = expressionKind >= 21 && expressionKind <= 25;
        bool shift
            = expressionKind >= 31 && expressionKind <= 33;
        if ((comparison
                && !IsStandaloneLogicalNotType(typeId))
            || (arithmetic
                && !IsStandaloneArithmeticType(typeId))
            || (shift
                && !IsStandaloneSourceShiftDataType(typeId))
            || (!comparison && !arithmetic
                && !shift
                && !IsStandaloneNotType(typeId))
            || leftExpressionId < 0
            || leftExpressionId >= expressionId
            || rightExpressionId < 0
            || rightExpressionId >= expressionId)
        {
            return 3;
        }
        int32 operandTypeId
            = Host.StandaloneSourceExpressions[
                (expressionFirst + leftExpressionId) * 8 + 1];
        int32 rightOperandTypeId
            = Host.StandaloneSourceExpressions[
                (expressionFirst + rightExpressionId) * 8 + 1];
        bool equality
            = expressionKind == 15 || expressionKind == 16;
        bool unitEquality
            = equality && IsStandaloneUnitType(operandTypeId);
        bool countTypeValid
            = IsStandaloneShiftCountType(rightOperandTypeId);
        if (rightOperandTypeId != operandTypeId)
        {
            if (!shift || !countTypeValid)
            {
                return 3;
            }
        }

        init int32 leftSelectorKind;
        init int32 leftSourceUse;
        init int32 leftSelectorIndex;
        init bool leftTerminated;
        int32 leftStatus = NormalizeStandaloneSourceExpression(
            bodyId, leftExpressionId, depth + 1,
            ref init leftSelectorKind, ref init leftSourceUse,
            ref init leftSelectorIndex, ref init leftTerminated);
        if (leftStatus != 0)
        {
            return leftStatus;
        }
        if (leftTerminated)
        {
            *selectorKindResult = 0;
            *sourceUseResult = 0;
            *selectorIndexResult = 0;
            *terminatedResult = true;
            return 0;
        }
        if (unitEquality)
        {
            if (leftSelectorKind != 0 || leftSourceUse != 0
                || leftSelectorIndex != 0)
            {
                return 3;
            }
        }
        else if (leftSelectorKind != 2 || leftSourceUse != 1
            || leftSelectorIndex < 0)
        {
            return 2;
        }

        init int32 rightSelectorKind;
        init int32 rightSourceUse;
        init int32 rightSelectorIndex;
        init bool rightTerminated;
        int32 rightStatus = NormalizeStandaloneSourceExpression(
            bodyId, rightExpressionId, depth + 1,
            ref init rightSelectorKind, ref init rightSourceUse,
            ref init rightSelectorIndex, ref init rightTerminated);
        if (rightStatus != 0)
        {
            return rightStatus;
        }
        if (rightTerminated)
        {
            *selectorKindResult = 0;
            *sourceUseResult = 0;
            *selectorIndexResult = 0;
            *terminatedResult = true;
            return 0;
        }
        if (unitEquality)
        {
            if (rightSelectorKind != 0 || rightSourceUse != 0
                || rightSelectorIndex != 0)
            {
                return 3;
            }
        }
        else if (rightSelectorKind != 2 || rightSourceUse != 1
            || rightSelectorIndex < 0)
        {
            return 2;
        }

        int32 sourceUse = GetStandaloneSourceUse(typeId);
        int32 homeFirst
            = Host.StandaloneNormalizedBodies[
                bodyId * 12 + 1];
        int32 bodyHomeCount
            = Host.StandaloneNormalizedHomeCount[0] - homeFirst;
        if (sourceUse != 1)
        {
            return 3;
        }
        if (unitEquality)
        {
            int32 constantFirst
                = Host.StandaloneNormalizedBodies[
                    bodyId * 12 + 3];
            init int32 constantId;
            int32 constantStatus
                = AppendStandaloneNormalizedConstant(
                    bodyId, constantFirst, typeId,
                    expressionKind == 15 ? 1 : 0, 0,
                    ref init constantId);
            if (constantStatus != 0)
            {
                return constantStatus;
            }
            init int32 resultHomeId;
            int32 homeStatus = AppendStandaloneNormalizedHome(
                bodyId, homeFirst, 3, typeId, 0,
                ref init resultHomeId);
            if (homeStatus != 0)
            {
                return homeStatus;
            }
            int32 operationStatus
                = AppendStandaloneNormalizedOperation(
                    bodyId, 1, constantId, 0, 0);
            if (operationStatus != 0)
            {
                return operationStatus;
            }
            operationStatus = AppendStandaloneNormalizedOperation(
                bodyId, 2, resultHomeId, 0, 0);
            if (operationStatus != 0)
            {
                return operationStatus;
            }
            *selectorKindResult = 2;
            *sourceUseResult = sourceUse;
            *selectorIndexResult = resultHomeId;
            *terminatedResult = false;
            return 0;
        }
        if (leftSelectorIndex >= bodyHomeCount
            || rightSelectorIndex >= bodyHomeCount)
        {
            return 3;
        }
        int32 leftHomeOffset
            = (homeFirst + leftSelectorIndex) * 5;
        int32 rightHomeOffset
            = (homeFirst + rightSelectorIndex) * 5;
        bool booleanEquality
            = equality
                && IsStandaloneLogicalNotType(operandTypeId);
        bool validOperandTypes
            = comparison
                ? (equality
                    ? IsStandaloneComparisonEqualityType(
                        operandTypeId)
                    : IsStandaloneComparisonDataType(
                        operandTypeId))
                : shift
                    ? operandTypeId == typeId && countTypeValid
                    : operandTypeId == typeId;
        if (Host.StandaloneNormalizedHomes[
                leftHomeOffset] != bodyId
            || Host.StandaloneNormalizedHomes[
                rightHomeOffset] != bodyId
            || Host.StandaloneNormalizedHomes[
                leftHomeOffset + 3] != operandTypeId
            || Host.StandaloneNormalizedHomes[
                rightHomeOffset + 3] != rightOperandTypeId
            || !validOperandTypes
        {
            return 3;
        }

        init int32 resultHomeId;
        int32 resultHomeStatus;
        int32 operationStatus;
        if (!comparison && !arithmetic && !shift)
        {
            resultHomeStatus = AppendStandaloneNormalizedHome(
                bodyId, homeFirst, 3, typeId, 0,
                ref init resultHomeId);
            if (resultHomeStatus != 0)
            {
                return resultHomeStatus;
            }
            int32 operationKind = expressionKind == 12 ? 10
                : expressionKind == 13 ? 11 : 12;
            operationStatus = AppendStandaloneNormalizedOperation(
                bodyId, operationKind, leftSelectorIndex,
                rightSelectorIndex, resultHomeId);
            if (operationStatus != 0)
            {
                return operationStatus;
            }
        }
        else if (arithmetic)
        {
            resultHomeStatus = AppendStandaloneNormalizedHome(
                bodyId, homeFirst, 3, typeId, 0,
                ref init resultHomeId);
            if (resultHomeStatus != 0)
            {
                return resultHomeStatus;
            }
            int32 typeCode
                = Host.StandaloneTypeFacts[
                    operandTypeId * 3 + 1];
            int32 operationKind;
            if (typeCode == 0x14 || typeCode == 0x15)
            {
                operationKind = expressionKind == 21 ? 25
                    : expressionKind == 22 ? 26
                        : expressionKind == 23 ? 27
                            : expressionKind == 24 ? 28 : 29;
            }
            else if (expressionKind == 24)
            {
                operationKind = 23;
            }
            else if (expressionKind == 25)
            {
                operationKind = 24;
            }
            else if (Host.StandaloneSourceArithmeticProfile[0] == 0)
            {
                operationKind = expressionKind == 21 ? 17
                    : expressionKind == 22 ? 18 : 19;
            }
            else
            {
                operationKind = expressionKind == 21 ? 20
                    : expressionKind == 22 ? 21 : 22;
            }
            operationStatus = AppendStandaloneNormalizedOperation(
                bodyId, operationKind, leftSelectorIndex,
                rightSelectorIndex, resultHomeId);
            if (operationStatus != 0)
            {
                return operationStatus;
            }
        }
        else if (shift)
        {
            resultHomeStatus = AppendStandaloneNormalizedHome(
                bodyId, homeFirst, 3, typeId, 0,
                ref init resultHomeId);
            if (resultHomeStatus != 0)
            {
                return resultHomeStatus;
            }
            int32 operationKind = expressionKind == 31 ? 35
                : expressionKind == 32 ? 36 : 37;
            operationStatus = AppendStandaloneNormalizedOperation(
                bodyId, operationKind, leftSelectorIndex,
                rightSelectorIndex, resultHomeId);
            if (operationStatus != 0)
            {
                return operationStatus;
            }
        }
        else if (booleanEquality)
        {
            resultHomeStatus = AppendStandaloneNormalizedHome(
                bodyId, homeFirst, 3, typeId, 0,
                ref init resultHomeId);
            if (resultHomeStatus != 0)
            {
                return resultHomeStatus;
            }
            int32 operationKind
                = expressionKind == 15 ? 13 : 14;
            operationStatus = AppendStandaloneNormalizedOperation(
                bodyId, operationKind, leftSelectorIndex,
                rightSelectorIndex, resultHomeId);
            if (operationStatus != 0)
            {
                return operationStatus;
            }
        }
        else
        {
            init int32 relationTypeId;
            int32 relationTypeStatus
                = InternStandaloneCallableTypeFact(
                    0, 0x0B, false, ref init relationTypeId);
            if (relationTypeStatus != 0)
            {
                return relationTypeStatus;
            }
            init int32 relationHomeId;
            int32 relationHomeStatus
                = AppendStandaloneNormalizedHome(
                    bodyId, homeFirst, 3, relationTypeId, 0,
                    ref init relationHomeId);
            if (relationHomeStatus != 0)
            {
                return relationHomeStatus;
            }
            resultHomeStatus = AppendStandaloneNormalizedHome(
                bodyId, homeFirst, 3, typeId, 0,
                ref init resultHomeId);
            if (resultHomeStatus != 0)
            {
                return resultHomeStatus;
            }
            operationStatus = AppendStandaloneNormalizedOperation(
                bodyId, 15, leftSelectorIndex,
                rightSelectorIndex, relationHomeId);
            if (operationStatus != 0)
            {
                return operationStatus;
            }
            int32 predicate = expressionKind == 15 ? 2
                : expressionKind == 16 ? 13
                    : expressionKind == 17 ? 1
                        : expressionKind == 18 ? 3
                            : expressionKind == 19 ? 4 : 6;
            operationStatus = AppendStandaloneNormalizedOperation(
                bodyId, 16, relationHomeId, predicate,
                resultHomeId);
            if (operationStatus != 0)
            {
                return operationStatus;
            }
        }
        *selectorKindResult = 2;
        *sourceUseResult = sourceUse;
        *selectorIndexResult = resultHomeId;
        *terminatedResult = false;
        return 0;
    }
    if (expressionKind == 9 || expressionKind == 10
        || expressionKind == 11)
    {
        int32 operandExpressionId
            = Host.StandaloneSourceExpressions[
                expressionOffset + 2];
        if ((expressionKind == 9
                && !IsStandaloneUnaryMinusType(typeId))
            || (expressionKind == 10
                && !IsStandaloneLogicalNotType(typeId))
            || (expressionKind == 11
                && !IsStandaloneBitwiseNotType(typeId))
            || operandExpressionId < 0
            || operandExpressionId >= expressionId)
        {
            return 3;
        }
        init int32 operandSelectorKind;
        init int32 operandSourceUse;
        init int32 operandSelectorIndex;
        init bool operandTerminated;
        int32 operandStatus = NormalizeStandaloneSourceExpression(
            bodyId, operandExpressionId, depth + 1,
            ref init operandSelectorKind,
            ref init operandSourceUse,
            ref init operandSelectorIndex,
            ref init operandTerminated);
        if (operandStatus != 0)
        {
            return operandStatus;
        }
        if (operandTerminated)
        {
            *selectorKindResult = 0;
            *sourceUseResult = 0;
            *selectorIndexResult = 0;
            *terminatedResult = true;
            return 0;
        }
        if (operandSelectorKind != 2 || operandSourceUse != 1
            || operandSelectorIndex < 0)
        {
            return 2;
        }
        int32 sourceUse = GetStandaloneSourceUse(typeId);
        int32 homeFirst
            = Host.StandaloneNormalizedBodies[
                bodyId * 12 + 1];
        int32 bodyHomeCount
            = Host.StandaloneNormalizedHomeCount[0] - homeFirst;
        if (sourceUse != 1
            || operandSelectorIndex >= bodyHomeCount)
        {
            return 3;
        }
        int32 sourceHomeOffset
            = (homeFirst + operandSelectorIndex) * 5;
        if (Host.StandaloneNormalizedHomes[
                sourceHomeOffset] != bodyId
            || Host.StandaloneNormalizedHomes[
                sourceHomeOffset + 3] != typeId)
        {
            return 3;
        }
        int32 typeCode
            = Host.StandaloneTypeFacts[typeId * 3 + 1];
        int32 operationKind;
        if (expressionKind == 10 || expressionKind == 11)
        {
            operationKind = 9;
        }
        else if (typeCode == 0x14 || typeCode == 0x15)
        {
            operationKind = 8;
        }
        else if (Host.StandaloneSourceArithmeticProfile[0] == 0)
        {
            operationKind = 6;
        }
        else
        {
            operationKind = 7;
        }
        init int32 resultHomeId;
        int32 homeStatus = AppendStandaloneNormalizedHome(
            bodyId, homeFirst, 3, typeId, 0,
            ref init resultHomeId);
        if (homeStatus != 0)
        {
            return homeStatus;
        }
        int32 operationStatus = AppendStandaloneNormalizedOperation(
            bodyId, operationKind, operandSelectorIndex,
            resultHomeId, 0);
        if (operationStatus != 0)
        {
            return operationStatus;
        }
        *selectorKindResult = 2;
        *sourceUseResult = sourceUse;
        *selectorIndexResult = resultHomeId;
        *terminatedResult = false;
        return 0;
    }
    if (expressionKind == 7)
    {
        if (!IsStandaloneUnitType(typeId))
        {
            return 3;
        }
        *selectorKindResult = 0;
        *sourceUseResult = 0;
        *selectorIndexResult = 0;
        *terminatedResult = false;
        return 0;
    }
    if (expressionKind == 3)
    {
        return NormalizeStandaloneCallExpression(bodyId,
            Host.StandaloneSourceExpressions[expressionOffset + 2],
            depth, ref init *selectorKindResult,
            ref init *sourceUseResult,
            ref init *selectorIndexResult,
            ref init *terminatedResult);
    }
    return 3;
}

int32 NormalizeStandaloneParameterExpression(int32 bodyId,
    int32 expressionKind, int32 typeId, int32 parameterOrdinal,
    ref<init int32> selectorKindResult,
    ref<init int32> sourceUseResult,
    ref<init int32> selectorIndexResult,
    ref<init bool> terminatedResult)
    ensure return == 0 ? (*selectorKindResult is init
        && *sourceUseResult is init
        && *selectorIndexResult is init
        && *terminatedResult is init) : true
{
    int32 infoOffset = bodyId * 12;
    int32 parameterFirst
        = Host.StandaloneSourceCallableInfo[infoOffset + 5];
    int32 parameterCount
        = Host.StandaloneSourceCallableInfo[infoOffset + 6];
    if (parameterOrdinal < 0 || parameterOrdinal >= parameterCount)
    {
        return 3;
    }
    int32 parameterRow = parameterFirst + parameterOrdinal;
    int32 parameterOffset = parameterRow * 4;
    if (Host.StandaloneSourceParameters[parameterOffset] != bodyId
        || Host.StandaloneSourceParameters[
            parameterOffset + 1] != typeId)
    {
        return 3;
    }
    int32 sourceUse = GetStandaloneSourceUse(typeId);
    if (expressionKind == 4)
    {
        if (sourceUse != 5)
        {
            return 3;
        }
    }
    else if (sourceUse != 0 && sourceUse != 1)
    {
        return 2;
    }

    if (sourceUse == 0)
    {
        *selectorKindResult = 0;
        *sourceUseResult = 0;
        *selectorIndexResult = 0;
    }
    else
    {
        int32 homeId
            = Host.StandaloneNormalizedParameterHomeIds[parameterRow];
        if (homeId < 0
            || homeId
                >= Host.StandaloneNormalizedHomeCount[0]
                    - Host.StandaloneNormalizedBodies[
                        bodyId * 12 + 1])
        {
            return 3;
        }
        *selectorKindResult = 2;
        *sourceUseResult = sourceUse;
        *selectorIndexResult = homeId;
    }
    *terminatedResult = false;
    return 0;
}

int32 NormalizeStandaloneCallExpression(int32 bodyId,
    int32 callLocalIndex, int32 depth,
    ref<init int32> selectorKindResult,
    ref<init int32> sourceUseResult,
    ref<init int32> selectorIndexResult,
    ref<init bool> terminatedResult)
    ensure return == 0 ? (*selectorKindResult is init
        && *sourceUseResult is init
        && *selectorIndexResult is init
        && *terminatedResult is init) : true
{
    int32 sourceBodyOffset = bodyId * 12;
    int32 bodyCallFirst
        = Host.StandaloneSourceBodies[sourceBodyOffset + 5];
    int32 bodyCallCount
        = Host.StandaloneSourceBodies[sourceBodyOffset + 6];
    if (callLocalIndex < 0 || callLocalIndex >= bodyCallCount)
    {
        return 3;
    }
    int32 callIndex = bodyCallFirst + callLocalIndex;
    int32 callOffset = callIndex * 7;
    int32 targetKind
        = Host.StandaloneSourceDirectCalls[callOffset];
    int32 targetIndex
        = Host.StandaloneSourceDirectCalls[callOffset + 1];
    int32 expectedCallableId
        = Host.StandaloneSourceDirectCalls[callOffset + 2];
    int32 resultTypeId
        = Host.StandaloneSourceDirectCalls[callOffset + 3];
    int32 argumentFirst
        = Host.StandaloneSourceDirectCalls[callOffset + 4];
    int32 argumentCount
        = Host.StandaloneSourceDirectCalls[callOffset + 5];
    int32 locationId
        = Host.StandaloneSourceDirectCalls[callOffset + 6];
    init int32 resolvedCallableId;
    init int32 targetResultTypeId;
    init int32 parameterCount;
    int32 signatureStatus = TryGetStandaloneCallableSignature(
        targetKind, targetIndex, ref init resolvedCallableId,
        ref init targetResultTypeId, ref init parameterCount);
    if (signatureStatus != 0)
    {
        return signatureStatus;
    }
    if (resolvedCallableId != expectedCallableId
        || expectedCallableId < 0
        || expectedCallableId >= Host.StandaloneCallableEffects.Length
        || targetResultTypeId != resultTypeId
        || parameterCount != argumentCount)
    {
        return 3;
    }

    int32 bodyArgumentFirst
        = Host.StandaloneSourceBodies[sourceBodyOffset + 7];
    int32 bodyArgumentCount
        = Host.StandaloneSourceBodies[sourceBodyOffset + 8];
    if (argumentFirst < 0 || argumentCount < 0
        || argumentFirst > bodyArgumentCount - argumentCount)
    {
        return 3;
    }
    for (mut int32 ordinal = 0;
        ordinal < argumentCount;
        ordinal = ordinal + 1)
    {
        int32 argumentIndex
            = bodyArgumentFirst + argumentFirst + ordinal;
        int32 argumentOffset = argumentIndex * 3;
        int32 parameterOrdinal
            = Host.StandaloneSourceCallArguments[
                argumentOffset + 1];
        int32 expectedSourceUse
            = Host.StandaloneSourceCallArguments[
                argumentOffset + 2];
        if (parameterOrdinal < 0
            || parameterOrdinal >= parameterCount)
        {
            return 3;
        }
        init int32 parameterTypeId;
        int32 parameterTypeStatus = GetStandaloneCallParameterTypeId(
            targetKind, targetIndex, parameterOrdinal,
            ref init parameterTypeId);
        if (parameterTypeStatus != 0)
        {
            return parameterTypeStatus;
        }
        init int32 argumentSelectorKind;
        init int32 argumentSourceUse;
        init int32 argumentSelectorIndex;
        init bool argumentTerminated;
        int32 argumentStatus = NormalizeStandaloneSourceExpression(
            bodyId,
            Host.StandaloneSourceCallArguments[argumentOffset],
            depth + 1, ref init argumentSelectorKind,
            ref init argumentSourceUse,
            ref init argumentSelectorIndex,
            ref init argumentTerminated);
        if (argumentStatus != 0)
        {
            return argumentStatus;
        }
        if (argumentTerminated)
        {
            *selectorKindResult = 0;
            *sourceUseResult = 0;
            *selectorIndexResult = 0;
            *terminatedResult = true;
            return 0;
        }
        if (argumentSourceUse != expectedSourceUse
            || Host.StandaloneSourceExpressions[
                (Host.StandaloneSourceBodies[
                    sourceBodyOffset + 3]
                    + Host.StandaloneSourceCallArguments[
                        argumentOffset]) * 8 + 1]
                != parameterTypeId
            || (argumentSelectorKind == 0
                && (expectedSourceUse != 0
                    || argumentSelectorIndex != 0))
            || (argumentSelectorKind != 0
                && argumentSelectorKind != 2))
        {
            return 3;
        }
        int32 scratchArgumentIndex
            = bodyArgumentFirst + argumentFirst + parameterOrdinal;
        int32 scratchOffset = scratchArgumentIndex * 3;
        Host.StandaloneNormalizedInputScratch[scratchOffset]
            = argumentSelectorKind;
        Host.StandaloneNormalizedInputScratch[scratchOffset + 1]
            = expectedSourceUse;
        Host.StandaloneNormalizedInputScratch[scratchOffset + 2]
            = argumentSelectorIndex;
    }

    int32 bodyInputFirst
        = Host.StandaloneNormalizedBodies[
            bodyId * 12 + 7];
    int32 inputGlobalFirst
        = Host.StandaloneInvokeInputCount[0];
    int32 inputLocalFirst = argumentCount == 0 ? 0
        : inputGlobalFirst - bodyInputFirst;
    if (inputLocalFirst < 0
        || inputLocalFirst > 65535
        || inputGlobalFirst
            > Host.StandaloneInvokeInputs.Length / 3
                - argumentCount)
    {
        return 3;
    }
    for (mut int32 ordinal = 0;
        ordinal < argumentCount;
        ordinal = ordinal + 1)
    {
        int32 formalArgumentIndex
            = bodyArgumentFirst + argumentFirst + ordinal;
        int32 scratchOffset = formalArgumentIndex * 3;
        int32 inputOffset = (inputGlobalFirst + ordinal) * 3;
        Host.StandaloneInvokeInputs[inputOffset]
            = Host.StandaloneNormalizedInputScratch[scratchOffset];
        Host.StandaloneInvokeInputs[inputOffset + 1]
            = Host.StandaloneNormalizedInputScratch[
                scratchOffset + 1];
        Host.StandaloneInvokeInputs[inputOffset + 2]
            = Host.StandaloneNormalizedInputScratch[
                scratchOffset + 2];
    }
    Host.StandaloneInvokeInputCount[0]
        = inputGlobalFirst + argumentCount;

    bool doesNotReturn
        = (Host.StandaloneCallableEffects[expectedCallableId] & 2) != 0;
    bool unitResult = IsStandaloneUnitType(resultTypeId);
    int32 resultKind = 0;
    int32 resultIndex = 0;
    if (!doesNotReturn && !unitResult)
    {
        int32 homeFirst
            = Host.StandaloneNormalizedBodies[
                bodyId * 12 + 1];
        init int32 resultHome;
        int32 homeStatus = AppendStandaloneNormalizedHome(
            bodyId, homeFirst, 3, resultTypeId, 0,
            ref init resultHome);
        if (homeStatus != 0)
        {
            return homeStatus;
        }
        resultKind = 2;
        resultIndex = resultHome;
    }

    int32 invokeGlobal = Host.StandaloneInvokeCount[0];
    if (invokeGlobal >= Host.StandaloneInvokes.Length / 10)
    {
        return 3;
    }
    int32 invokeLocal = invokeGlobal
        - Host.StandaloneNormalizedBodies[
            bodyId * 12 + 5];
    if (invokeLocal < 0 || invokeLocal >= 65536)
    {
        return 3;
    }
    int32 invokeOffset = invokeGlobal * 10;
    Host.StandaloneInvokes[invokeOffset] = targetKind;
    Host.StandaloneInvokes[invokeOffset + 1] = targetIndex;
    Host.StandaloneInvokes[invokeOffset + 2]
        = expectedCallableId;
    Host.StandaloneInvokes[invokeOffset + 3] = inputLocalFirst;
    Host.StandaloneInvokes[invokeOffset + 4] = argumentCount;
    Host.StandaloneInvokes[invokeOffset + 5] = resultKind;
    Host.StandaloneInvokes[invokeOffset + 6] = resultIndex;
    Host.StandaloneInvokes[invokeOffset + 7] = 0;
    Host.StandaloneInvokes[invokeOffset + 8] = 0;
    Host.StandaloneInvokes[invokeOffset + 9] = locationId;
    Host.StandaloneInvokeCount[0] = invokeGlobal + 1;
    Host.StandaloneDirectCallInvokeMap[callIndex] = invokeGlobal;
    Host.StandaloneInvokeUseCounts[invokeGlobal] = 1;
    int32 operationStatus = AppendStandaloneNormalizedOperation(
        bodyId, 3, invokeLocal, 0, 0);
    if (operationStatus != 0)
    {
        return operationStatus;
    }
    if (doesNotReturn)
    {
        *selectorKindResult = 0;
        *sourceUseResult = 0;
        *selectorIndexResult = 0;
        *terminatedResult = true;
        return 0;
    }
    if (unitResult)
    {
        *selectorKindResult = 0;
        *sourceUseResult = 0;
        *selectorIndexResult = 0;
    }
    else
    {
        *selectorKindResult = 2;
        *sourceUseResult = 1;
        *selectorIndexResult = resultIndex;
    }
    *terminatedResult = false;
    return 0;
}

int32 VerifyStandaloneNormalizedBodyBlocks(int32 bodyId,
    int32 blockFirst, int32 bodyBlockCount, int32 bodyOperationFirst,
    int32 bodyOperationCount, int32 bodyHomeFirst,
    int32 bodyHomeCount, int32 bodyInvokeCount,
    int32 returnTypeId)
{
    int32 blockCount
        = Host.StandaloneNormalizedBlockCount[0];
    if (blockFirst < 0 || bodyBlockCount <= 0
        || blockFirst > blockCount - bodyBlockCount
        || bodyOperationFirst < 0 || bodyOperationCount < 0
        || bodyHomeFirst < 0 || bodyHomeCount < 0)
    {
        return 3;
    }

    mut int32 expectedOperationFirst = bodyOperationFirst;
    for (mut int32 localBlockId = 0;
        localBlockId < bodyBlockCount;
        localBlockId = localBlockId + 1)
    {
        int32 blockOffset = (blockFirst + localBlockId) * 16;
        int32 blockBodyId
            = Host.StandaloneNormalizedBlocks[blockOffset];
        int32 blockLocalId
            = Host.StandaloneNormalizedBlocks[blockOffset + 1];
        int32 operationFirst
            = Host.StandaloneNormalizedBlocks[blockOffset + 2];
        int32 operationCount
            = Host.StandaloneNormalizedBlocks[blockOffset + 3];
        int32 terminatorKind
            = Host.StandaloneNormalizedBlocks[blockOffset + 4];
        int32 selectorKind
            = Host.StandaloneNormalizedBlocks[blockOffset + 5];
        int32 selectorIndex
            = Host.StandaloneNormalizedBlocks[blockOffset + 6];
        int32 selectorTypeId
            = Host.StandaloneNormalizedBlocks[blockOffset + 7];
        int32 target0
            = Host.StandaloneNormalizedBlocks[blockOffset + 8];
        int32 target1
            = Host.StandaloneNormalizedBlocks[blockOffset + 9];
        int32 conditionSelectorKind
            = Host.StandaloneNormalizedBlocks[blockOffset + 10];
        int32 conditionSelectorIndex
            = Host.StandaloneNormalizedBlocks[blockOffset + 11];
        int32 conditionTypeId
            = Host.StandaloneNormalizedBlocks[blockOffset + 12];
        int32 conditionalEdgeRecordIndex
            = Host.StandaloneNormalizedBlocks[blockOffset + 13];
        int32 noReturnInvokeLocalId
            = Host.StandaloneNormalizedBlocks[blockOffset + 14];
        if (blockBodyId != bodyId || blockLocalId != localBlockId
            || operationFirst != expectedOperationFirst
            || operationCount < 0
            || operationFirst
                > bodyOperationFirst + bodyOperationCount
                    - operationCount
            || (terminatorKind != 1 && terminatorKind != 2
                && terminatorKind != 3 && terminatorKind != 4)
            || (selectorKind != 0 && selectorKind != 2)
            || (selectorKind == 0 && selectorIndex != 0)
            || target0 < -1 || target1 < -1
            || conditionSelectorKind < 0
            || conditionSelectorKind > 2
            || (conditionSelectorKind == 0
                && conditionSelectorIndex != 0)
            || conditionalEdgeRecordIndex < -1
            || noReturnInvokeLocalId < -1
            || Host.StandaloneNormalizedBlocks[
                blockOffset + 15] != 0)
        {
            return 3;
        }

        if (terminatorKind == 1)
        {
            if (operationCount == 0 || target0 != -1 || target1 != -1
                || conditionSelectorKind != 0
                || conditionTypeId != 0
                || conditionalEdgeRecordIndex != -1
                || noReturnInvokeLocalId != -1)
            {
                return 3;
            }
            int32 lastOperationOffset
                = (operationFirst + operationCount - 1) * 5;
            int32 lastOperationKind
                = Host.StandaloneNormalizedOperations[
                    lastOperationOffset];
            if (IsStandaloneUnitType(returnTypeId))
            {
                if (selectorKind != 0 || selectorIndex != 0
                    || selectorTypeId != returnTypeId
                    || lastOperationKind != 5)
                {
                    return 3;
                }
            }
            else if (selectorKind != 2
                || selectorIndex < 0
                || selectorIndex >= bodyHomeCount
                || selectorTypeId != returnTypeId
                || lastOperationKind != 4
                || Host.StandaloneNormalizedOperations[
                    lastOperationOffset + 1] != selectorIndex)
            {
                return 3;
            }
        }
        else if (terminatorKind == 2)
        {
            if (operationCount == 0 || selectorKind != 0
                || selectorIndex != 0 || selectorTypeId != 0
                || target0 != -1 || target1 != -1
                || conditionSelectorKind != 0
                || conditionTypeId != 0
                || conditionalEdgeRecordIndex != -1
                || noReturnInvokeLocalId < 0
                || noReturnInvokeLocalId >= bodyInvokeCount)
            {
                return 3;
            }
            int32 lastOperationOffset
                = (operationFirst + operationCount - 1) * 5;
            if (Host.StandaloneNormalizedOperations[
                    lastOperationOffset] != 3
                || Host.StandaloneNormalizedOperations[
                    lastOperationOffset + 1]
                    != noReturnInvokeLocalId)
            {
                return 3;
            }
        }
        else if (terminatorKind == 3)
        {
            if (selectorKind != 0 || selectorIndex != 0
                || selectorTypeId != 0
                || target0 < 0 || target0 >= bodyBlockCount
                || target1 != -1
                || conditionSelectorKind != 0
                || conditionTypeId != 0
                || conditionalEdgeRecordIndex != -1
                || noReturnInvokeLocalId != -1)
            {
                return 3;
            }
        }
        else
        {
            if (selectorKind != 0 || selectorIndex != 0
                || selectorTypeId != 0
                || target0 < 0 || target0 >= bodyBlockCount
                || target1 < 0 || target1 >= bodyBlockCount
                || target0 == target1
                || conditionSelectorKind != 2
                || conditionSelectorIndex < 0
                || conditionSelectorIndex >= bodyHomeCount
                || !IsStandaloneLogicalNotType(conditionTypeId)
                || conditionalEdgeRecordIndex < bodyBlockCount
                || conditionalEdgeRecordIndex > 0xFFFF
                || noReturnInvokeLocalId != -1)
            {
                return 3;
            }
            int32 conditionHomeOffset
                = (bodyHomeFirst + conditionSelectorIndex) * 5;
            if (Host.StandaloneNormalizedHomes[
                    conditionHomeOffset] != bodyId
                || Host.StandaloneNormalizedHomes[
                    conditionHomeOffset + 3] != conditionTypeId
                || Host.StandaloneNormalizedHomes[
                    conditionHomeOffset + 2] != 0)
            {
                return 3;
            }
        }
        expectedOperationFirst = expectedOperationFirst
            + operationCount;
    }
    return expectedOperationFirst
            == bodyOperationFirst + bodyOperationCount
        ? 0 : 3;
}

int32 VerifyStandaloneNormalizedProgram()
{
    int32 bodyCount = Host.StandaloneNormalizedBodyCount[0];
    int32 blockCount = Host.StandaloneNormalizedBlockCount[0];
    int32 homeCount = Host.StandaloneNormalizedHomeCount[0];
    int32 constantCount
        = Host.StandaloneNormalizedConstantCount[0];
    int32 invokeCount = Host.StandaloneInvokeCount[0];
    int32 inputCount = Host.StandaloneInvokeInputCount[0];
    int32 operationCount
        = Host.StandaloneNormalizedOperationCount[0];
    if (bodyCount != Host.StandaloneSourceBodyCount[0]
        || bodyCount < 0
        || bodyCount > Host.StandaloneNormalizedBodies.Length / 12
        || blockCount < bodyCount
        || blockCount < 0
        || blockCount > Host.StandaloneNormalizedBlocks.Length / 16
        || bodyCount
            > Host.StandaloneNormalizedBodyBlockRanges.Length / 2
        || homeCount < 0
        || homeCount > Host.StandaloneNormalizedHomes.Length / 5
        || constantCount < 0
        || constantCount
            > Host.StandaloneNormalizedConstants.Length / 4
        || invokeCount < 0
        || invokeCount > Host.StandaloneInvokes.Length / 10
        || inputCount < 0
        || inputCount > Host.StandaloneInvokeInputs.Length / 3
        || operationCount < 0
        || operationCount
            > Host.StandaloneNormalizedOperations.Length / 5)
    {
        return 3;
    }

    mut int32 expectedBlockFirst = 0;
    for (mut int32 bodyId = 0;
        bodyId < bodyCount;
        bodyId = bodyId + 1)
    {
        int32 bodyOffset = bodyId * 12;
        int32 homeFirst
            = Host.StandaloneNormalizedBodies[bodyOffset + 1];
        int32 bodyHomeCount
            = Host.StandaloneNormalizedBodies[bodyOffset + 2];
        int32 constantFirst
            = Host.StandaloneNormalizedBodies[bodyOffset + 3];
        int32 bodyConstantCount
            = Host.StandaloneNormalizedBodies[bodyOffset + 4];
        int32 invokeFirst
            = Host.StandaloneNormalizedBodies[bodyOffset + 5];
        int32 bodyInvokeCount
            = Host.StandaloneNormalizedBodies[bodyOffset + 6];
        int32 inputFirst
            = Host.StandaloneNormalizedBodies[bodyOffset + 7];
        int32 bodyInputCount
            = Host.StandaloneNormalizedBodies[bodyOffset + 8];
        int32 operationFirst
            = Host.StandaloneNormalizedBodies[bodyOffset + 9];
        int32 bodyOperationCount
            = Host.StandaloneNormalizedBodies[bodyOffset + 10];
        int32 terminalKind
            = Host.StandaloneNormalizedBodies[bodyOffset + 11];
        int32 blockRangeOffset = bodyId * 2;
        int32 blockFirst
            = Host.StandaloneNormalizedBodyBlockRanges[
                blockRangeOffset];
        int32 bodyBlockCount
            = Host.StandaloneNormalizedBodyBlockRanges[
                blockRangeOffset + 1];
        if (Host.StandaloneNormalizedBodies[bodyOffset] != bodyId
            || homeFirst < 0 || bodyHomeCount < 0
            || homeFirst > homeCount - bodyHomeCount
            || constantFirst < 0 || bodyConstantCount < 0
            || constantFirst > constantCount - bodyConstantCount
            || invokeFirst < 0 || bodyInvokeCount < 0
            || invokeFirst > invokeCount - bodyInvokeCount
            || inputFirst < 0 || bodyInputCount < 0
            || inputFirst > inputCount - bodyInputCount
            || operationFirst < 0 || bodyOperationCount < 0
            || operationFirst
                > operationCount - bodyOperationCount
            || blockFirst != expectedBlockFirst
            || bodyBlockCount <= 0
            || blockFirst < 0
            || blockFirst > blockCount - bodyBlockCount
            || (terminalKind != 0 && terminalKind != 1
                && terminalKind != 2))
        {
            return 3;
        }

        int32 sourceInfoOffset = bodyId * 12;
        int32 returnTypeId
            = Host.StandaloneSourceCallableInfo[
                sourceInfoOffset + 4];
        int32 blockStatus = VerifyStandaloneNormalizedBodyBlocks(
            bodyId, blockFirst, bodyBlockCount, operationFirst,
            bodyOperationCount, homeFirst, bodyHomeCount,
            bodyInvokeCount, returnTypeId);
        if (blockStatus != 0)
        {
            return blockStatus;
        }
        if (terminalKind == 1)
        {
            for (mut int32 localBlock = 0;
                localBlock < bodyBlockCount;
                localBlock = localBlock + 1)
            {
                if (Host.StandaloneNormalizedBlocks[
                        (blockFirst + localBlock) * 16 + 4] == 1)
                {
                    return 3;
                }
            }
        }
        else if (terminalKind == 2)
        {
            for (mut int32 localBlock = 0;
                localBlock < bodyBlockCount;
                localBlock = localBlock + 1)
            {
                if (Host.StandaloneNormalizedBlocks[
                        (blockFirst + localBlock) * 16 + 4] == 1)
                {
                    return 3;
                }
            }
        }

        int32 parameterFirst
            = Host.StandaloneSourceCallableInfo[
                sourceInfoOffset + 5];
        int32 parameterCount
            = Host.StandaloneSourceCallableInfo[
                sourceInfoOffset + 6];
        for (mut int32 ordinal = 0;
            ordinal < parameterCount;
            ordinal = ordinal + 1)
        {
            int32 parameterRow = parameterFirst + ordinal;
            int32 parameterTypeId
                = Host.StandaloneSourceParameters[
                    parameterRow * 4 + 1];
            int32 expectedUse
                = GetStandaloneSourceUse(parameterTypeId);
            int32 homeId
                = Host.StandaloneNormalizedParameterHomeIds[
                    parameterRow];
            if (expectedUse < 0
                || (expectedUse != 0
                    && expectedUse != 1
                    && expectedUse != 5))
            {
                return 3;
            }
            if (expectedUse == 0)
            {
                if (homeId != -1)
                {
                    return 3;
                }
                continue;
            }
            if (homeId < 0 || homeId >= bodyHomeCount)
            {
                return 3;
            }
            int32 homeOffset = (homeFirst + homeId) * 5;
            if (Host.StandaloneNormalizedHomes[homeOffset] != bodyId
                || Host.StandaloneNormalizedHomes[
                    homeOffset + 1] != 2
                || Host.StandaloneNormalizedHomes[
                    homeOffset + 3] != parameterTypeId
                || Host.StandaloneNormalizedHomes[
                    homeOffset + 4] != ordinal)
            {
                return 3;
            }
        }

        int32 localRangeOffset = bodyId * 2;
        int32 localFirst
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset];
        int32 localCount
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset + 1];
        int32 sourceLocalCount
            = Host.StandaloneSourceLocalCount[0];
        if (localFirst < 0 || localCount < 0
            || localFirst > sourceLocalCount - localCount)
        {
            return 3;
        }
        for (mut int32 localOrdinal = 0;
            localOrdinal < localCount;
            localOrdinal = localOrdinal + 1)
        {
            int32 localId = localFirst + localOrdinal;
            int32 localTypeId
                = Host.StandaloneSourceLocals[localId * 10 + 2];
            int32 bindingKind
                = Host.StandaloneSourceLocals[localId * 10 + 3];
            int32 localState
                = Host.StandaloneSourceLocalStates[localId];
            int32 homeId
                = Host.StandaloneNormalizedSourceLocalHomeIds[
                    localId];
            int32 localUse
                = GetStandaloneSourceUse(localTypeId);
            if (Host.StandaloneSourceLocals[localId * 10] != bodyId
                || localUse < 0
                || bindingKind < 0 || bindingKind > 3
                || (localState != 0 && localState != 1)
                || (localState == 0 && homeId != -1))
            {
                return 3;
            }
            if (localState == 1 && homeId < 0)
            {
                if (homeId != -1
                    || (terminalKind != 1 && terminalKind != 2))
                {
                    return 3;
                }
                continue;
            }
            if (localState == 1 && localUse == 0)
            {
                if (homeId != 0)
                {
                    return 3;
                }
                continue;
            }
            if (localState == 1)
            {
                if (localUse != 1 || homeId >= bodyHomeCount)
                {
                    return 3;
                }
                int32 homeOffset = (homeFirst + homeId) * 5;
                if (Host.StandaloneNormalizedHomes[
                        homeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        homeOffset + 3] != localTypeId
                    || (bindingKind != 0
                        && Host.StandaloneNormalizedHomes[
                            homeOffset + 1] != 3)
                    || (bindingKind != 0
                        && Host.StandaloneNormalizedHomes[
                            homeOffset + 2]
                            != (bindingKind == 2 ? 0 : 1)))
                {
                    return 3;
                }
            }
        }

        for (mut int32 constantLocal = 0;
            constantLocal < bodyConstantCount;
            constantLocal = constantLocal + 1)
        {
            int32 constantOffset
                = (constantFirst + constantLocal) * 4;
            int32 typeId
                = Host.StandaloneNormalizedConstants[
                    constantOffset + 1];
            int32 valueLow
                = Host.StandaloneNormalizedConstants[
                    constantOffset + 2];
            int32 valueHigh
                = Host.StandaloneNormalizedConstants[
                    constantOffset + 3];
            if (Host.StandaloneNormalizedConstants[
                    constantOffset] != bodyId
                || typeId <= 0
                || typeId > Host.StandaloneTypeFactCount[0]
                || Host.StandaloneTypeFacts[typeId * 3] != 0)
            {
                return 3;
            }
            int32 typeCode
                = Host.StandaloneTypeFacts[typeId * 3 + 1];
            if (typeCode == 1)
            {
                if (valueHigh != 0
                    || (valueLow != 0 && valueLow != 1))
                {
                    return 3;
                }
            }
            else
            {
                uint64 magnitude = uint64(uint32(valueLow))
                    | (uint64(uint32(valueHigh)) << 32);
                if (!IsStandaloneScalarLiteralBitsValid(
                        typeCode, magnitude))
                {
                    return 3;
                }
            }
        }

        int32 bodyCallFirst
            = Host.StandaloneSourceBodies[bodyId * 12 + 5];
        int32 bodyCallCount
            = Host.StandaloneSourceBodies[bodyId * 12 + 6];
        int32 observedInvokeCount = 0;
        for (mut int32 callLocalIndex = 0;
            callLocalIndex < bodyCallCount;
            callLocalIndex = callLocalIndex + 1)
        {
            int32 callIndex = bodyCallFirst + callLocalIndex;
            int32 mappedInvoke
                = Host.StandaloneDirectCallInvokeMap[callIndex];
            if (mappedInvoke < 0)
            {
                if (mappedInvoke != -1)
                {
                    return 3;
                }
                continue;
            }
            if (mappedInvoke < invokeFirst
                || mappedInvoke >= invokeFirst + bodyInvokeCount)
            {
                return 3;
            }
            observedInvokeCount = observedInvokeCount + 1;
            int32 callOffset = callIndex * 7;
            int32 invokeOffset = mappedInvoke * 10;
            for (mut int32 field = 0; field < 3; field = field + 1)
            {
                if (Host.StandaloneSourceDirectCalls[
                        callOffset + field]
                    != Host.StandaloneInvokes[invokeOffset + field])
                {
                    return 3;
                }
            }
            int32 argumentFirst
                = Host.StandaloneSourceDirectCalls[callOffset + 4];
            int32 argumentCount
                = Host.StandaloneSourceDirectCalls[callOffset + 5];
            int32 invokeInputFirst
                = Host.StandaloneInvokes[invokeOffset + 3];
            int32 invokeInputCount
                = Host.StandaloneInvokes[invokeOffset + 4];
            if (argumentCount != invokeInputCount
                || invokeInputCount < 0
                || invokeInputFirst < 0
                || invokeInputFirst
                    > bodyInputCount - invokeInputCount)
            {
                return 3;
            }
            int32 bodyArgumentFirst
                = Host.StandaloneSourceBodies[bodyId * 12 + 7];
            for (mut int32 ordinal = 0;
                ordinal < argumentCount;
                ordinal = ordinal + 1)
            {
                int32 argumentIndex
                    = bodyArgumentFirst + argumentFirst + ordinal;
                int32 argumentOffset = argumentIndex * 3;
                int32 inputOffset
                    = (inputFirst + invokeInputFirst
                        + parameterOrdinal) * 3;
                int32 normalizedInputIndex
                    = inputFirst + invokeInputFirst
                        + parameterOrdinal;
                int32 argumentExpressionId
                    = Host.StandaloneSourceCallArguments[
                        argumentOffset];
                int32 parameterOrdinal
                    = Host.StandaloneSourceCallArguments[
                        argumentOffset + 1];
                int32 expectedSourceUse
                    = Host.StandaloneSourceCallArguments[
                        argumentOffset + 2];
                if (parameterOrdinal < 0
                    || parameterOrdinal >= argumentCount)
                {
                    return 3;
                }
                int32 expressionTypeId
                    = Host.StandaloneSourceExpressions[
                        (Host.StandaloneSourceBodies[
                            bodyId * 12 + 3]
                            + argumentExpressionId) * 8 + 1];
                int32 selectorKind
                    = Host.StandaloneInvokeInputs[inputOffset];
                int32 sourceUse
                    = Host.StandaloneInvokeInputs[inputOffset + 1];
                int32 selectorIndex
                    = Host.StandaloneInvokeInputs[inputOffset + 2];
                if (sourceUse != expectedSourceUse)
                {
                    return 3;
                }
                if (Host.StandaloneInvokeInputUseCounts[
                        normalizedInputIndex] != 0)
                {
                    return 3;
                }
                Host.StandaloneInvokeInputUseCounts[
                    normalizedInputIndex] = 1;
                if (selectorKind == 0)
                {
                    if (sourceUse != 0 || selectorIndex != 0
                        || !IsStandaloneUnitType(expressionTypeId))
                    {
                        return 3;
                    }
                }
                else if (selectorKind == 2)
                {
                    if (selectorIndex < 0
                        || selectorIndex >= bodyHomeCount)
                    {
                        return 3;
                    }
                    int32 homeOffset
                        = (homeFirst + selectorIndex) * 5;
                    if (Host.StandaloneNormalizedHomes[
                            homeOffset] != bodyId
                        || Host.StandaloneNormalizedHomes[
                            homeOffset + 3] != expressionTypeId
                        || GetStandaloneSourceUse(expressionTypeId)
                            != sourceUse)
                    {
                        return 3;
                    }
                }
                else
                {
                    return 3;
                }
            }

            int32 expectedCallableId
                = Host.StandaloneInvokes[invokeOffset + 2];
            if (expectedCallableId < 0
                || expectedCallableId
                    >= Host.StandaloneCallableEffects.Length)
            {
                return 3;
            }
            int32 resultTypeId
                = Host.StandaloneSourceDirectCalls[callOffset + 3];
            bool doesNotReturn
                = (Host.StandaloneCallableEffects[
                    expectedCallableId] & 2) != 0;
            bool unitResult = IsStandaloneUnitType(resultTypeId);
            int32 resultKind
                = Host.StandaloneInvokes[invokeOffset + 5];
            int32 resultIndex
                = Host.StandaloneInvokes[invokeOffset + 6];
            if ((doesNotReturn || unitResult)
                ? resultKind != 0 || resultIndex != 0
                : resultKind != 2 || resultIndex < 0
                    || resultIndex >= bodyHomeCount)
            {
                return 3;
            }
            if (resultKind == 2)
            {
                int32 resultHomeOffset
                    = (homeFirst + resultIndex) * 5;
                if (Host.StandaloneNormalizedHomes[
                        resultHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 1] != 3
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 3] != resultTypeId)
                {
                    return 3;
                }
            }
            if (Host.StandaloneInvokes[invokeOffset + 7] != 0
                || Host.StandaloneInvokes[invokeOffset + 8] != 0
                || Host.StandaloneInvokeUseCounts[mappedInvoke] != 1)
            {
                return 3;
            }
            Host.StandaloneInvokeUseCounts[mappedInvoke] = 2;
        }
        if (observedInvokeCount != bodyInvokeCount)
        {
            return 3;
        }
        for (mut int32 inputLocal = 0;
            inputLocal < bodyInputCount;
            inputLocal = inputLocal + 1)
        {
            if (Host.StandaloneInvokeInputUseCounts[
                    inputFirst + inputLocal] != 1)
            {
                return 3;
            }
        }

        int32 finalOperationKind = 0;
        mut int32 pendingRelationHomeId = -1;
        mut int32 operationBlockLocal = 0;
        mut int32 operationBlockOffset = blockFirst * 16;
        mut int32 operationBlockOperationFirst
            = Host.StandaloneNormalizedBlocks[
                operationBlockOffset + 2];
        mut int32 operationBlockOperationCount
            = Host.StandaloneNormalizedBlocks[
                operationBlockOffset + 3];
        mut int32 operationBlockTerminatorKind
            = Host.StandaloneNormalizedBlocks[
                operationBlockOffset + 4];
        for (mut int32 localOperation = 0;
            localOperation < bodyOperationCount;
            localOperation = localOperation + 1)
        {
            while (operationFirst + localOperation
                >= operationBlockOperationFirst
                    + operationBlockOperationCount)
            {
                operationBlockLocal = operationBlockLocal + 1;
                if (operationBlockLocal >= bodyBlockCount)
                {
                    return 3;
                }
                operationBlockOffset
                    = (blockFirst + operationBlockLocal) * 16;
                operationBlockOperationFirst
                    = Host.StandaloneNormalizedBlocks[
                        operationBlockOffset + 2];
                operationBlockOperationCount
                    = Host.StandaloneNormalizedBlocks[
                        operationBlockOffset + 3];
                operationBlockTerminatorKind
                    = Host.StandaloneNormalizedBlocks[
                        operationBlockOffset + 4];
            }
            bool operationIsBlockTerminator
                = operationFirst + localOperation + 1
                    == operationBlockOperationFirst
                        + operationBlockOperationCount;
            int32 operationOffset
                = (operationFirst + localOperation) * 5;
            int32 kind
                = Host.StandaloneNormalizedOperations[
                    operationOffset];
            int32 operand0
                = Host.StandaloneNormalizedOperations[
                    operationOffset + 1];
            int32 operand1
                = Host.StandaloneNormalizedOperations[
                    operationOffset + 2];
            int32 operand2
                = Host.StandaloneNormalizedOperations[
                    operationOffset + 3];
            if (Host.StandaloneNormalizedOperations[
                    operationOffset + 4] != bodyId)
            {
                return 3;
            }
            if (pendingRelationHomeId >= 0 && kind != 16)
            {
                return 3;
            }
            if (kind == 15)
            {
                if (pendingRelationHomeId >= 0)
                {
                    return 3;
                }
                pendingRelationHomeId = operand2;
            }
            else if (kind == 16)
            {
                if (pendingRelationHomeId < 0
                    || operand0 != pendingRelationHomeId)
                {
                    return 3;
                }
                pendingRelationHomeId = -1;
            }
            finalOperationKind = kind;
            if (kind == 1)
            {
                if (operand0 < 0
                    || operand0 >= bodyConstantCount
                    || operand1 != 0
                    || operand2 != 0
                    || Host.StandaloneNormalizedConstants[
                        (constantFirst + operand0) * 4] != bodyId)
                {
                    return 3;
                }
            }
            else if (kind == 2)
            {
                if (operand0 < 0 || operand0 >= bodyHomeCount
                    || operand1 != 0 || operand2 != 0
                    || localOperation == 0)
                {
                    return 3;
                }
                int32 previousOffset
                    = (operationFirst + localOperation - 1) * 5;
                if (Host.StandaloneNormalizedOperations[
                        previousOffset] != 1)
                {
                    return 3;
                }
                int32 constantLocal
                    = Host.StandaloneNormalizedOperations[
                        previousOffset + 1];
                int32 constantType
                    = Host.StandaloneNormalizedConstants[
                        (constantFirst + constantLocal) * 4 + 1];
                int32 homeType
                    = Host.StandaloneNormalizedHomes[
                        (homeFirst + operand0) * 5 + 3];
                int32 homeOffset = (homeFirst + operand0) * 5;
                if (constantType != homeType
                    || Host.StandaloneNormalizedHomes[
                        homeOffset + 1] != 3
                    || Host.StandaloneNormalizedHomes[
                        homeOffset + 2] != 0)
                {
                    return 3;
                }
            }
            else if (kind == 3)
            {
                if (operand0 < 0 || operand0 >= bodyInvokeCount
                    || operand1 != 0 || operand2 != 0)
                {
                    return 3;
                }
                int32 invokeGlobal = invokeFirst + operand0;
                if (Host.StandaloneInvokeUseCounts[
                        invokeGlobal] != 2)
                {
                    return 3;
                }
                int32 invokedExpectedId
                    = Host.StandaloneInvokes[
                        invokeGlobal * 10 + 2];
                if (invokedExpectedId < 0
                    || invokedExpectedId
                        >= Host.StandaloneCallableEffects.Length)
                {
                    return 3;
                }
                bool invokedDoesNotReturn
                    = (Host.StandaloneCallableEffects[
                        invokedExpectedId] & 2) != 0;
                if (invokedDoesNotReturn
                    && (!operationIsBlockTerminator
                        || operationBlockTerminatorKind != 2))
                {
                    return 3;
                }
                Host.StandaloneInvokeUseCounts[invokeGlobal] = 3;
            }
            else if (kind == 4)
            {
                if (operand0 < 0 || operand0 >= bodyHomeCount
                    || operand1 != 0 || operand2 != 0
                    || !operationIsBlockTerminator
                    || operationBlockTerminatorKind != 1
                    || Host.StandaloneNormalizedHomes[
                        (homeFirst + operand0) * 5 + 3]
                        != Host.StandaloneSourceCallableInfo[
                            bodyId * 12 + 4])
                {
                    return 3;
                }
            }
            else if (kind == 5)
            {
                if (operand0 != 0 || operand1 != 0
                    || operand2 != 0
                    || !operationIsBlockTerminator
                    || operationBlockTerminatorKind != 1
                    || !IsStandaloneUnitType(
                        Host.StandaloneSourceCallableInfo[
                            bodyId * 12 + 4]))
                {
                    return 3;
                }
            }
            else if (kind == 6 || kind == 7 || kind == 8
                || kind == 9)
            {
                if (operand0 < 0 || operand0 >= bodyHomeCount
                    || operand1 < 0 || operand1 >= bodyHomeCount
                    || operand0 == operand1 || operand2 != 0)
                {
                    return 3;
                }
                int32 sourceHomeOffset
                    = (homeFirst + operand0) * 5;
                int32 resultHomeOffset
                    = (homeFirst + operand1) * 5;
                int32 typeId
                    = Host.StandaloneNormalizedHomes[
                        sourceHomeOffset + 3];
                int32 typeCode
                    = Host.StandaloneTypeFacts[typeId * 3 + 1];
                if (Host.StandaloneNormalizedHomes[
                        sourceHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 3] != typeId
                    || Host.StandaloneNormalizedHomes[
                        sourceHomeOffset + 2] != 0
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 1] != 3
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 2] != 0
                    || (kind == 9
                        ? !IsStandaloneNotType(typeId)
                        : !IsStandaloneUnaryMinusType(typeId))
                    || (kind == 6
                        && (typeCode == 0x14 || typeCode == 0x15
                            || Host.StandaloneSourceArithmeticProfile[0]
                                != 0))
                    || (kind == 7
                        && (typeCode == 0x14 || typeCode == 0x15
                            || Host.StandaloneSourceArithmeticProfile[0]
                                != 1))
                    || (kind == 8
                        && typeCode != 0x14 && typeCode != 0x15))
                {
                    return 3;
                }
            }
            else if (kind >= 10 && kind <= 14)
            {
                if (operand0 < 0 || operand0 >= bodyHomeCount
                    || operand1 < 0 || operand1 >= bodyHomeCount
                    || operand2 < 0 || operand2 >= bodyHomeCount
                    || operand2 == operand0 || operand2 == operand1)
                {
                    return 3;
                }
                int32 leftHomeOffset
                    = (homeFirst + operand0) * 5;
                int32 rightHomeOffset
                    = (homeFirst + operand1) * 5;
                int32 resultHomeOffset
                    = (homeFirst + operand2) * 5;
                int32 typeId
                    = Host.StandaloneNormalizedHomes[
                        leftHomeOffset + 3];
                bool bitwise = kind <= 12;
                if ((bitwise
                        ? !IsStandaloneNotType(typeId)
                        : !IsStandaloneLogicalNotType(typeId))
                    || Host.StandaloneNormalizedHomes[
                        leftHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        rightHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        rightHomeOffset + 3] != typeId
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 3] != typeId
                    || Host.StandaloneNormalizedHomes[
                        leftHomeOffset + 2] != 0
                    || Host.StandaloneNormalizedHomes[
                        rightHomeOffset + 2] != 0
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 1] != 3
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 2] != 0)
                {
                    return 3;
                }
            }
            else if (kind == 15)
            {
                if (operand0 < 0 || operand0 >= bodyHomeCount
                    || operand1 < 0 || operand1 >= bodyHomeCount
                    || operand2 < 0 || operand2 >= bodyHomeCount
                    || operand2 == operand0
                    || operand2 == operand1)
                {
                    return 3;
                }
                int32 leftHomeOffset
                    = (homeFirst + operand0) * 5;
                int32 rightHomeOffset
                    = (homeFirst + operand1) * 5;
                int32 relationHomeOffset
                    = (homeFirst + operand2) * 5;
                int32 operandTypeId
                    = Host.StandaloneNormalizedHomes[
                        leftHomeOffset + 3];
                int32 relationTypeId
                    = Host.StandaloneNormalizedHomes[
                        relationHomeOffset + 3];
                if (!IsStandaloneComparisonDataType(
                        operandTypeId)
                    || relationTypeId <= 0
                    || relationTypeId
                        > Host.StandaloneTypeFactCount[0]
                    || Host.StandaloneNormalizedHomes[
                        leftHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        rightHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        relationHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        rightHomeOffset + 3] != operandTypeId
                    || Host.StandaloneTypeFacts[
                        relationTypeId * 3] != 0
                    || Host.StandaloneTypeFacts[
                        relationTypeId * 3 + 1] != 0x0B
                    || Host.StandaloneNormalizedHomes[
                        leftHomeOffset + 2] != 0
                    || Host.StandaloneNormalizedHomes[
                        rightHomeOffset + 2] != 0
                    || Host.StandaloneNormalizedHomes[
                        relationHomeOffset + 1] != 3
                    || Host.StandaloneNormalizedHomes[
                        relationHomeOffset + 2] != 0)
                {
                    return 3;
                }
            }
            else if (kind == 16)
            {
                if (operand0 < 0 || operand0 >= bodyHomeCount
                    || operand1 < 0 || operand1 > 15
                    || operand2 < 0 || operand2 >= bodyHomeCount
                    || operand0 == operand2)
                {
                    return 3;
                }
                int32 relationHomeOffset
                    = (homeFirst + operand0) * 5;
                int32 resultHomeOffset
                    = (homeFirst + operand2) * 5;
                int32 relationTypeId
                    = Host.StandaloneNormalizedHomes[
                        relationHomeOffset + 3];
                int32 resultTypeId
                    = Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 3];
                if (relationTypeId <= 0
                    || relationTypeId
                        > Host.StandaloneTypeFactCount[0]
                    || Host.StandaloneNormalizedHomes[
                        relationHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset] != bodyId
                    || Host.StandaloneTypeFacts[
                        relationTypeId * 3] != 0
                    || Host.StandaloneTypeFacts[
                        relationTypeId * 3 + 1] != 0x0B
                    || !IsStandaloneLogicalNotType(resultTypeId)
                    || Host.StandaloneNormalizedHomes[
                        relationHomeOffset + 2] != 0
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 1] != 3
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 2] != 0)
                {
                    return 3;
                }
            }
            else if (kind >= 17 && kind <= 29)
            {
                if (operand0 < 0 || operand0 >= bodyHomeCount
                    || operand1 < 0 || operand1 >= bodyHomeCount
                    || operand2 < 0 || operand2 >= bodyHomeCount
                    || operand2 == operand0 || operand2 == operand1)
                {
                    return 3;
                }
                int32 leftHomeOffset
                    = (homeFirst + operand0) * 5;
                int32 rightHomeOffset
                    = (homeFirst + operand1) * 5;
                int32 resultHomeOffset
                    = (homeFirst + operand2) * 5;
                int32 typeId
                    = Host.StandaloneNormalizedHomes[
                        leftHomeOffset + 3];
                if (typeId <= 0
                    || typeId > Host.StandaloneTypeFactCount[0])
                {
                    return 3;
                }
                int32 typeCode
                    = Host.StandaloneTypeFacts[typeId * 3 + 1];
                bool integerType
                    = IsStandaloneIntegerArithmeticType(typeId);
                bool floatingType
                    = IsStandaloneArithmeticType(typeId)
                        && IsStandaloneFloatingSourceType(typeCode);
                bool checkedInteger = kind >= 17 && kind <= 19;
                bool wrappingInteger = kind >= 20 && kind <= 22;
                if ((kind <= 24
                        ? !integerType : !floatingType)
                    || (checkedInteger
                        && Host.StandaloneSourceArithmeticProfile[0]
                            != 0)
                    || (wrappingInteger
                        && Host.StandaloneSourceArithmeticProfile[0]
                            != 1)
                    || GetStandaloneSourceUse(typeId) != 1
                    || Host.StandaloneNormalizedHomes[
                        leftHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        rightHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        rightHomeOffset + 3] != typeId
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 3] != typeId
                    || Host.StandaloneNormalizedHomes[
                        leftHomeOffset + 2] != 0
                    || Host.StandaloneNormalizedHomes[
                        rightHomeOffset + 2] != 0
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 1] != 3
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 2] != 0)
                {
                    return 3;
                }
            }
            else if (kind == 38)
            {
                if (operand0 < 0 || operand0 >= bodyHomeCount
                    || operand1 < 0 || operand1 >= bodyHomeCount
                    || operand0 == operand1 || operand2 != 0)
                {
                    return 3;
                }
                int32 sourceHomeOffset
                    = (homeFirst + operand0) * 5;
                int32 destinationHomeOffset
                    = (homeFirst + operand1) * 5;
                int32 typeId
                    = Host.StandaloneNormalizedHomes[
                        sourceHomeOffset + 3];
                if (GetStandaloneSourceUse(typeId) != 1
                    || Host.StandaloneNormalizedHomes[
                        sourceHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        destinationHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        destinationHomeOffset + 1] != 3
                    || Host.StandaloneNormalizedHomes[
                        destinationHomeOffset + 2] != 0
                    || Host.StandaloneNormalizedHomes[
                        destinationHomeOffset + 3] != typeId)
                {
                    return 3;
                }
            }
            else if (kind == 30 || kind == 31)
            {
                if (operand0 < 0 || operand0 >= bodyHomeCount
                    || operand1 < 0 || operand1 >= bodyHomeCount
                    || operand0 == operand1
                    || operand2 < localFirst
                    || operand2 >= localFirst + localCount)
                {
                    return 3;
                }
                int32 localOffset = operand2 * 10;
                int32 typeId
                    = Host.StandaloneSourceLocals[localOffset + 2];
                int32 bindingKind
                    = Host.StandaloneSourceLocals[localOffset + 3];
                int32 localHomeId
                    = Host.StandaloneNormalizedSourceLocalHomeIds[
                        operand2];
                int32 sourceHomeOffset
                    = (homeFirst + operand0) * 5;
                int32 destinationHomeOffset
                    = (homeFirst + operand1) * 5;
                if (Host.StandaloneSourceLocals[localOffset] != bodyId
                    || (kind == 30
                        ? (bindingKind < 1 || bindingKind > 3)
                            || Host.StandaloneSourceLocalStates[
                                operand2] != 1
                        : (bindingKind != 1 && bindingKind != 3)
                            || Host.StandaloneSourceLocalStates[
                                operand2] != 1)
                    || GetStandaloneSourceUse(typeId) != 1
                    || Host.StandaloneNormalizedHomes[
                        sourceHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        destinationHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        sourceHomeOffset + 3] != typeId
                    || Host.StandaloneNormalizedHomes[
                        destinationHomeOffset + 3] != typeId
                    || Host.StandaloneNormalizedHomes[
                        destinationHomeOffset + 1] != 3
                    || Host.StandaloneNormalizedHomes[
                        destinationHomeOffset + 2]
                        != (kind == 30
                            ? (bindingKind == 2 ? 0 : 1)
                            : 0)
                    || (kind == 31
                        && Host.StandaloneNormalizedHomes[
                            sourceHomeOffset + 2] != 1)
                    || (kind == 30
                        ? localHomeId != operand1
                        : localHomeId != operand0))
                {
                    return 3;
                }
            }
            else if (kind >= 35 && kind <= 37)
            {
                if (operand0 < 0 || operand0 >= bodyHomeCount
                    || operand1 < 0 || operand1 >= bodyHomeCount
                    || operand2 < 0 || operand2 >= bodyHomeCount
                    || operand0 == operand1
                    || operand0 == operand2
                    || operand1 == operand2)
                {
                    return 3;
                }
                int32 leftHomeOffset
                    = (homeFirst + operand0) * 5;
                int32 countHomeOffset
                    = (homeFirst + operand1) * 5;
                int32 resultHomeOffset
                    = (homeFirst + operand2) * 5;
                int32 dataTypeId
                    = Host.StandaloneNormalizedHomes[
                        leftHomeOffset + 3];
                int32 countTypeId
                    = Host.StandaloneNormalizedHomes[
                        countHomeOffset + 3];
                if (!IsStandaloneSourceShiftDataType(dataTypeId)
                    || !IsStandaloneShiftCountType(countTypeId)
                    || GetStandaloneSourceUse(dataTypeId) != 1
                    || GetStandaloneSourceUse(countTypeId) != 1
                    || Host.StandaloneNormalizedHomes[
                        leftHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        countHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset] != bodyId
                    || Host.StandaloneNormalizedHomes[
                        leftHomeOffset + 2] != 0
                    || Host.StandaloneNormalizedHomes[
                        countHomeOffset + 2] != 0
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 3] != dataTypeId
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 1] != 3
                    || Host.StandaloneNormalizedHomes[
                        resultHomeOffset + 2] != 0)
                {
                    return 3;
                }
            }
            else
            {
                return 3;
            }
        }
        if (pendingRelationHomeId >= 0)
        {
            return 3;
        }
        if (terminalKind == 1 && finalOperationKind != 3)
        {
            return 3;
        }
        if (terminalKind == 0
            && !IsStandaloneUnitType(
                Host.StandaloneSourceCallableInfo[bodyId * 12 + 4])
            && finalOperationKind != 4)
        {
            return 3;
        }
        if (finalOperationKind == 3 && bodyOperationCount > 0)
        {
            int32 finalInvokeLocal
                = Host.StandaloneNormalizedOperations[
                    (operationFirst + bodyOperationCount - 1) * 5 + 1];
            int32 finalExpectedId
                = Host.StandaloneInvokes[
                    (invokeFirst + finalInvokeLocal) * 10 + 2];
            bool finalDoesNotReturn
                = (Host.StandaloneCallableEffects[
                    finalExpectedId] & 2) != 0;
            if ((terminalKind == 1) != finalDoesNotReturn)
            {
                return 3;
            }
        }
        expectedBlockFirst = blockFirst + bodyBlockCount;
    }

    if (expectedBlockFirst != blockCount)
    {
        return 3;
    }
    for (mut int32 invokeIndex = 0;
        invokeIndex < invokeCount;
        invokeIndex = invokeIndex + 1)
    {
        if (Host.StandaloneInvokeUseCounts[invokeIndex] != 3)
        {
            return 3;
        }
    }
    return 0;
}
