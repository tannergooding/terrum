        return 3;
    }

    int32 constantFirst
        = Host.StandaloneNormalizedBodies[bodyId * 12 + 3];
    int32 trueStatus
        = AppendStandaloneNormalizedLazyBooleanConstantBlock(
            bodyId, boolTypeId, constantFirst, resultHomeId,
            1, leafCount, leafCount + 2);
    if (trueStatus != 0)
    {
        return trueStatus;
    }
    int32 falseStatus
        = AppendStandaloneNormalizedLazyBooleanConstantBlock(
            bodyId, boolTypeId, constantFirst, resultHomeId,
            0, leafCount + 1, leafCount + 2);
    if (falseStatus != 0)
    {
        return falseStatus;
    }
    if (Host.StandaloneNormalizedBlockCount[0]
        != bodyBlockFirst + leafCount + 2)
    {
        return 3;
    }

    *selectorKindResult = 2;
    *sourceUseResult = 1;
    *selectorIndexResult = resultHomeId;
    *terminatedResult = false;
