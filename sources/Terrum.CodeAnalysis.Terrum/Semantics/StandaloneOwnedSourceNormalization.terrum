namespace Terrum.CodeAnalysis;

public static int32 NormalizeStandaloneOwnedSourceProgram()
{
    if (Host.StandaloneNormalizedProgramStatus.Length != 1
        || !ValidateStandaloneSourceCallBuffers()
        || !ValidateStandaloneNormalizationBuffers())
    {
        return 3;
    }

    ClearStandaloneNormalizedProgram();
    if (ValidateStandaloneMethodImportInput() != 0
        || Host.StandaloneSourceProgramStatus[0] != 0
        || VerifyStandaloneDirectCalls() != 0)
    {
        return FailStandaloneNormalization(3);
    }

    int32 traversalStatus = BuildStandaloneDirectCallTraversal();
    if (traversalStatus != 0)
    {
        return FailStandaloneNormalization(traversalStatus);
    }

    int32 bodyCount = Host.StandaloneSourceBodyCount[0];
    for (mut int32 bodyId = 0;
        bodyId < bodyCount;
        bodyId = bodyId + 1)
    {
        int32 sourceBodyOffset = bodyId * 12;
        int32 normalizedBodyOffset = bodyId * 12;
        int32 homeFirst = Host.StandaloneNormalizedHomeCount[0];
        int32 constantFirst
            = Host.StandaloneNormalizedConstantCount[0];
        int32 invokeFirst = Host.StandaloneInvokeCount[0];
        int32 inputFirst = Host.StandaloneInvokeInputCount[0];
        int32 operationFirst
            = Host.StandaloneNormalizedOperationCount[0];
        int32 blockFirst
            = Host.StandaloneNormalizedBlockCount[0];
        Host.StandaloneNormalizedBodyBlockRanges[
            bodyId * 2] = blockFirst;
        Host.StandaloneNormalizedBodyBlockRanges[
            bodyId * 2 + 1] = 0;
        Host.StandaloneNormalizedBodies[
            normalizedBodyOffset] = bodyId;
        Host.StandaloneNormalizedBodies[
            normalizedBodyOffset + 1] = homeFirst;
        Host.StandaloneNormalizedBodies[
            normalizedBodyOffset + 3] = constantFirst;
        Host.StandaloneNormalizedBodies[
            normalizedBodyOffset + 5] = invokeFirst;
        Host.StandaloneNormalizedBodies[
            normalizedBodyOffset + 7] = inputFirst;
        Host.StandaloneNormalizedBodies[
            normalizedBodyOffset + 9] = operationFirst;

        int32 parameterFirst
            = Host.StandaloneSourceCallableInfo[bodyId * 12 + 5];
        int32 parameterCount
            = Host.StandaloneSourceCallableInfo[bodyId * 12 + 6];
        for (mut int32 ordinal = 0;
            ordinal < parameterCount;
            ordinal = ordinal + 1)
        {
            int32 parameterRow = parameterFirst + ordinal;
            int32 parameterOffset = parameterRow * 4;
            int32 typeId
                = Host.StandaloneSourceParameters[
                    parameterOffset + 1];
            int32 sourceUse = GetStandaloneSourceUse(typeId);
            if (Host.StandaloneSourceParameters[
                    parameterOffset] != bodyId
                || sourceUse < 0)
            {
                return FailStandaloneNormalization(3);
            }

            if (sourceUse == 0)
            {
                Host.StandaloneNormalizedParameterHomeIds[
                    parameterRow] = -1;
                continue;
            }
            if (sourceUse != 1 && sourceUse != 5)
            {
                return FailStandaloneNormalization(2);
            }

            init int32 homeId;
            int32 homeStatus = AppendStandaloneNormalizedHome(
                bodyId, homeFirst, 2, typeId, ordinal,
                ref init homeId);
            if (homeStatus != 0)
            {
                return FailStandaloneNormalization(homeStatus);
            }
            Host.StandaloneNormalizedParameterHomeIds[
                parameterRow] = homeId;
        }

        int32 statementFirst
            = Host.StandaloneSourceBodies[sourceBodyOffset + 9];
        int32 statementCount
            = Host.StandaloneSourceBodies[sourceBodyOffset + 10];
        mut int32 terminalKind = 0;
        for (mut int32 statementIndex = 0;
            statementIndex < statementCount;
            statementIndex = statementIndex + 1)
        {
            int32 statementId = statementFirst + statementIndex;
            int32 statementOffset = statementId * 3;
            if (Host.StandaloneSourceStatementParentIds[
                    statementId] >= 0)
            {
                continue;
            }
            if (Host.StandaloneSourceStatements[
                    statementOffset] == 6)
            {
                int32 ifStatus
                    = NormalizeStandaloneSourceIfReturns(
                        bodyId, statementId);
                if (ifStatus != 0)
                {
                    return FailStandaloneNormalization(ifStatus);
                }
                continue;
            }
            int32 statementStatus = NormalizeStandaloneSourceStatement(
                bodyId, statementOffset, ref init terminalKind);
            if (statementStatus != 0)
            {
                return FailStandaloneNormalization(statementStatus);
            }
            if (terminalKind != 0)
            {
                break;
            }
        }

        int32 returnTypeId
            = Host.StandaloneSourceCallableInfo[bodyId * 12 + 4];
        if (terminalKind == 0 && IsStandaloneUnitType(returnTypeId))
        {
            int32 currentOperationCount
                = Host.StandaloneNormalizedOperationCount[0]
                    - operationFirst;
            bool hasUnitReturn = currentOperationCount > 0
                && Host.StandaloneNormalizedOperations[
                    (operationFirst + currentOperationCount - 1) * 5]
                    == 5;
            if (!hasUnitReturn)
            {
                int32 returnStatus
                    = AppendStandaloneNormalizedOperation(
                        bodyId, 5, 0, 0, 0);
                if (returnStatus != 0)
                {
                    return FailStandaloneNormalization(returnStatus);
                }
            }
        }

        int32 homeCount
            = Host.StandaloneNormalizedHomeCount[0] - homeFirst;
        int32 constantCount
            = Host.StandaloneNormalizedConstantCount[0]
                - constantFirst;
        int32 invokeCount
            = Host.StandaloneInvokeCount[0] - invokeFirst;
        int32 inputCount
            = Host.StandaloneInvokeInputCount[0] - inputFirst;
        int32 operationCount
            = Host.StandaloneNormalizedOperationCount[0]
                - operationFirst;
        if (homeCount < 0 || homeCount > 65536
            || constantCount < 0 || constantCount > 65536
            || invokeCount < 0 || invokeCount > 65536
            || inputCount < 0 || inputCount > 65536
            || operationCount < 0)
        {
            return FailStandaloneNormalization(3);
        }

        int32 blockCount
            = Host.StandaloneNormalizedBlockCount[0] - blockFirst;
        if (blockCount == 0)
        {
            init int32 blockIndex;
            int32 blockStatus
                = AppendStandaloneNormalizedReturnBlock(
                    bodyId, 0, operationFirst, operationCount,
                    terminalKind, ref init blockIndex);
            if (blockStatus != 0)
            {
                return FailStandaloneNormalization(blockStatus);
            }
            blockCount = 1;
        }
        else
        {
            int32 lastBlockOffset
                = (blockFirst + blockCount - 1) * 16;
            int32 lastOperationFirst
                = Host.StandaloneNormalizedBlocks[
                    lastBlockOffset + 2];
            int32 lastOperationCount
                = Host.StandaloneNormalizedBlocks[
                    lastBlockOffset + 3];
            int32 trailingOperationFirst
                = lastOperationFirst + lastOperationCount;
            int32 operationEnd = operationFirst + operationCount;
            if (trailingOperationFirst < operationFirst
                || trailingOperationFirst > operationEnd)
            {
                return FailStandaloneNormalization(3);
            }
            if (trailingOperationFirst < operationEnd)
            {
                int32 trailingOperationCount
                    = operationEnd - trailingOperationFirst;
                init int32 blockIndex;
                int32 blockStatus
                    = AppendStandaloneNormalizedReturnBlock(
                        bodyId, blockCount, trailingOperationFirst,
                        trailingOperationCount, terminalKind,
                        ref init blockIndex);
                if (blockStatus != 0)
                {
                    return FailStandaloneNormalization(blockStatus);
                }
                blockCount
                    = Host.StandaloneNormalizedBlockCount[0]
                        - blockFirst;
            }
        }
        if (blockCount <= 0
            || bodyId * 2 + 1
                >= Host.StandaloneNormalizedBodyBlockRanges.Length)
        {
            return FailStandaloneNormalization(3);
        }
        Host.StandaloneNormalizedBodyBlockRanges[bodyId * 2]
            = blockFirst;
        Host.StandaloneNormalizedBodyBlockRanges[bodyId * 2 + 1]
            = blockCount;

        Host.StandaloneNormalizedBodies[
            normalizedBodyOffset + 2] = homeCount;
        Host.StandaloneNormalizedBodies[
            normalizedBodyOffset + 4] = constantCount;
        Host.StandaloneNormalizedBodies[
            normalizedBodyOffset + 6] = invokeCount;
        Host.StandaloneNormalizedBodies[
            normalizedBodyOffset + 8] = inputCount;
        Host.StandaloneNormalizedBodies[
            normalizedBodyOffset + 10] = operationCount;
        Host.StandaloneNormalizedBodies[
            normalizedBodyOffset + 11] = terminalKind;
        Host.StandaloneNormalizedBodyCount[0] = bodyId + 1;
    }

    int32 verificationStatus = VerifyStandaloneNormalizedProgram();
    if (verificationStatus != 0)
    {
        return FailStandaloneNormalization(verificationStatus);
    }
    Host.StandaloneNormalizedProgramStatus[0] = 0;
    return 0;
}

bool ValidateStandaloneNormalizationBuffers()
{
    if (Host.Source.Length < 0
        || Host.Source.Length > 16384
        || Host.Source.Length > (int32.MaxValue / 15) - 1)
    {
        return false;
    }
    int32 tokenCapacity = Host.Source.Length + 1;
    return Host.StandaloneNormalizedProgramStatus.Length == 1
        && Host.StandaloneNormalizedBodyCount.Length == 1
        && Host.StandaloneNormalizedBodies.Length
            == tokenCapacity * 12
        && Host.StandaloneNormalizedBlockCount.Length == 1
        && Host.StandaloneNormalizedBlocks.Length
            == tokenCapacity * 16
        && Host.StandaloneNormalizedBodyBlockRanges.Length
            == tokenCapacity * 2
        && Host.StandaloneNormalizedHomeCount.Length == 1
        && Host.StandaloneNormalizedHomes.Length
            == tokenCapacity * 10
        && Host.StandaloneNormalizedParameterHomeIds.Length
            == tokenCapacity
        && Host.StandaloneNormalizedSourceLocalHomeIds.Length
            == tokenCapacity
        && Host.StandaloneNormalizedConstantCount.Length == 1
        && Host.StandaloneNormalizedConstants.Length
            == tokenCapacity * 4
        && Host.StandaloneInvokeCount.Length == 1
        && Host.StandaloneInvokes.Length
            == tokenCapacity * 10
        && Host.StandaloneInvokeUseCounts.Length
            == tokenCapacity
        && Host.StandaloneInvokeInputCount.Length == 1
        && Host.StandaloneInvokeInputs.Length
            == tokenCapacity * 3
        && Host.StandaloneInvokeInputUseCounts.Length
            == tokenCapacity
        && Host.StandaloneNormalizedInputScratch.Length
            == tokenCapacity * 3
        && Host.StandaloneNormalizedOperationCount.Length == 1
        && Host.StandaloneNormalizedOperations.Length
            == tokenCapacity * 15
        && Host.StandaloneDirectCallInvokeMap.Length
            == tokenCapacity
        && Host.StandaloneDirectCallTraversalCount.Length == 1
        && Host.StandaloneDirectCallTraversal.Length
            == tokenCapacity
        && Host.StandaloneDirectCallTraversalSeen.Length
            == tokenCapacity
        && Host.StandaloneDirectCallTraversalExpressionStates.Length
            == tokenCapacity
        && Host.StandaloneLazyBooleanLeafCounts.Length
            == tokenCapacity;
}

void ClearStandaloneNormalizedProgram()
{
    Host.StandaloneNormalizedProgramStatus[0] = 0;
    Host.StandaloneNormalizedBodyCount[0] = 0;
    Host.StandaloneNormalizedBlockCount[0] = 0;
    Host.StandaloneNormalizedHomeCount[0] = 0;
    Host.StandaloneNormalizedConstantCount[0] = 0;
    Host.StandaloneInvokeCount[0] = 0;
    Host.StandaloneInvokeInputCount[0] = 0;
    Host.StandaloneNormalizedOperationCount[0] = 0;
    Host.StandaloneDirectCallTraversalCount[0] = 0;
    for (mut int32 index = 0;
        index < Host.StandaloneNormalizedBodies.Length;
        index = index + 1)
    {
        Host.StandaloneNormalizedBodies[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneNormalizedBlocks.Length;
        index = index + 1)
    {
        Host.StandaloneNormalizedBlocks[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneNormalizedBodyBlockRanges.Length;
        index = index + 1)
    {
        Host.StandaloneNormalizedBodyBlockRanges[index] = -1;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneNormalizedHomes.Length;
        index = index + 1)
    {
        Host.StandaloneNormalizedHomes[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneNormalizedParameterHomeIds.Length;
        index = index + 1)
    {
        Host.StandaloneNormalizedParameterHomeIds[index] = -1;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneNormalizedSourceLocalHomeIds.Length;
        index = index + 1)
    {
        Host.StandaloneNormalizedSourceLocalHomeIds[index] = -1;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneNormalizedConstants.Length;
        index = index + 1)
    {
        Host.StandaloneNormalizedConstants[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneInvokes.Length;
        index = index + 1)
    {
        Host.StandaloneInvokes[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneInvokeUseCounts.Length;
        index = index + 1)
    {
        Host.StandaloneInvokeUseCounts[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneInvokeInputs.Length;
        index = index + 1)
    {
        Host.StandaloneInvokeInputs[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneInvokeInputUseCounts.Length;
        index = index + 1)
    {
        Host.StandaloneInvokeInputUseCounts[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneNormalizedInputScratch.Length;
        index = index + 1)
    {
        Host.StandaloneNormalizedInputScratch[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneNormalizedOperations.Length;
        index = index + 1)
    {
        Host.StandaloneNormalizedOperations[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDirectCallInvokeMap.Length;
        index = index + 1)
    {
        Host.StandaloneDirectCallInvokeMap[index] = -1;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDirectCallTraversal.Length;
        index = index + 1)
    {
        Host.StandaloneDirectCallTraversal[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDirectCallTraversalSeen.Length;
        index = index + 1)
    {
        Host.StandaloneDirectCallTraversalSeen[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDirectCallTraversalExpressionStates.Length;
        index = index + 1)
    {
        Host.StandaloneDirectCallTraversalExpressionStates[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneLazyBooleanLeafCounts.Length;
        index = index + 1)
    {
        Host.StandaloneLazyBooleanLeafCounts[index] = 0;
    }
}

int32 FailStandaloneNormalization(int32 status)
{
    ClearStandaloneNormalizedProgram();
    Host.StandaloneNormalizedProgramStatus[0] = status;
    return status;
}

int32 BuildStandaloneDirectCallTraversal()
{
    int32 bodyCount = Host.StandaloneSourceBodyCount[0];
    for (mut int32 bodyId = 0;
        bodyId < bodyCount;
        bodyId = bodyId + 1)
    {
        int32 sourceBodyOffset = bodyId * 12;
        int32 expressionFirst
            = Host.StandaloneSourceBodies[sourceBodyOffset + 3];
        int32 expressionCount
            = Host.StandaloneSourceBodies[sourceBodyOffset + 4];
        int32 statementFirst
            = Host.StandaloneSourceBodies[sourceBodyOffset + 9];
        int32 statementCount
            = Host.StandaloneSourceBodies[sourceBodyOffset + 10];
        for (mut int32 statementIndex = 0;
            statementIndex < statementCount;
            statementIndex = statementIndex + 1)
        {
            int32 statementOffset
                = (statementFirst + statementIndex) * 3;
            int32 expressionId
                = Host.StandaloneSourceStatements[
                    statementOffset + 1];
            if (expressionId < 0)
            {
                continue;
            }
            int32 visitStatus = VisitStandaloneSourceExpression(
                bodyId, expressionFirst, expressionCount,
                expressionId, 0);
            if (visitStatus != 0)
            {
                return visitStatus;
            }
        }
    }

    if (Host.StandaloneDirectCallTraversalCount[0]
        != Host.StandaloneSourceDirectCallCount[0])
    {
        return 3;
    }
    for (mut int32 callIndex = 0;
        callIndex < Host.StandaloneSourceDirectCallCount[0];
        callIndex = callIndex + 1)
    {
        if (Host.StandaloneDirectCallTraversalSeen[callIndex] != 1)
        {
            return 3;
        }
    }
    return 0;
}

int32 VisitStandaloneSourceExpression(int32 bodyId,
    int32 expressionFirst, int32 expressionCount,
    int32 expressionId, int32 depth)
{
    if (depth > 64 || expressionId < 0
        || expressionId >= expressionCount)
    {
        return 3;
    }
    int32 expressionIndex = expressionFirst + expressionId;
    if (expressionIndex < expressionFirst
        || expressionIndex
            >= Host.StandaloneSourceExpressionCount[0]
        || Host.StandaloneDirectCallTraversalExpressionStates[
            expressionIndex] != 0)
    {
        return 3;
    }
    Host.StandaloneDirectCallTraversalExpressionStates[
        expressionIndex] = 1;
    int32 expressionOffset = expressionIndex * 8;
    int32 expressionKind
        = Host.StandaloneSourceExpressions[expressionOffset];
    if (expressionKind == 3)
    {
        int32 bodyOffset = bodyId * 12;
        int32 bodyCallFirst
            = Host.StandaloneSourceBodies[bodyOffset + 5];
        int32 bodyCallCount
            = Host.StandaloneSourceBodies[bodyOffset + 6];
        int32 callLocalIndex
            = Host.StandaloneSourceExpressions[
                expressionOffset + 2];
        if (callLocalIndex < 0
            || callLocalIndex >= bodyCallCount)
        {
            return 3;
        }
        int32 callIndex = bodyCallFirst + callLocalIndex;
        if (callIndex < 0
            || callIndex
                >= Host.StandaloneSourceDirectCallCount[0]
            || Host.StandaloneDirectCallTraversalSeen[
                callIndex] != 0)
        {
            return 3;
        }
        int32 traversalCount
            = Host.StandaloneDirectCallTraversalCount[0];
        if (traversalCount
            >= Host.StandaloneDirectCallTraversal.Length)
        {
            return 3;
        }
        Host.StandaloneDirectCallTraversal[traversalCount]
            = callIndex;
        Host.StandaloneDirectCallTraversalSeen[callIndex] = 1;
        Host.StandaloneDirectCallTraversalCount[0]
            = traversalCount + 1;

        int32 callOffset = callIndex * 7;
        int32 argumentFirst
            = Host.StandaloneSourceDirectCalls[callOffset + 4];
        int32 argumentCount
            = Host.StandaloneSourceDirectCalls[callOffset + 5];
        int32 bodyArgumentFirst
            = Host.StandaloneSourceBodies[bodyOffset + 7];
        int32 bodyArgumentCount
            = Host.StandaloneSourceBodies[bodyOffset + 8];
        if (argumentFirst < 0 || argumentCount < 0
            || argumentFirst > bodyArgumentCount - argumentCount)
        {
            return 3;
        }
        for (mut int32 ordinal = 0;
            ordinal < argumentCount;
            ordinal = ordinal + 1)
        {
            int32 argumentIndex
                = bodyArgumentFirst + argumentFirst + ordinal;
            int32 argumentOffset = argumentIndex * 3;
            int32 childExpressionId
                = Host.StandaloneSourceCallArguments[
                    argumentOffset];
            int32 visitStatus = VisitStandaloneSourceExpression(
                bodyId, expressionFirst, expressionCount,
                childExpressionId, depth + 1);
            if (visitStatus != 0)
            {
                return visitStatus;
            }
        }
    }
    else if (expressionKind == 6 || expressionKind == 8
        || expressionKind == 9 || expressionKind == 10
        || expressionKind == 11
        || (expressionKind >= 27 && expressionKind <= 30))
    {
        int32 childExpressionId
            = Host.StandaloneSourceExpressions[
                expressionOffset + 2];
        int32 visitStatus = VisitStandaloneSourceExpression(
            bodyId, expressionFirst, expressionCount,
            childExpressionId, depth + 1);
        if (visitStatus != 0)
        {
            return visitStatus;
        }
    }
    else if (expressionKind == 34)
    {
        int32 conditionExpressionId
            = Host.StandaloneSourceExpressions[
                expressionOffset + 2];
        int32 trueExpressionId
            = Host.StandaloneSourceExpressions[
                expressionOffset + 3];
        int32 falseExpressionId
            = Host.StandaloneSourceExpressions[
                expressionOffset + 4];
        int32 visitStatus = VisitStandaloneSourceExpression(
            bodyId, expressionFirst, expressionCount,
            conditionExpressionId, depth + 1);
        if (visitStatus != 0)
        {
            return visitStatus;
        }
        visitStatus = VisitStandaloneSourceExpression(
            bodyId, expressionFirst, expressionCount,
            trueExpressionId, depth + 1);
        if (visitStatus != 0)
        {
            return visitStatus;
        }
        visitStatus = VisitStandaloneSourceExpression(
            bodyId, expressionFirst, expressionCount,
            falseExpressionId, depth + 1);
        if (visitStatus != 0)
        {
            return visitStatus;
        }
    }
    else if (expressionKind == 12 || expressionKind == 13
        || expressionKind == 14 || expressionKind == 15
        || expressionKind == 16 || expressionKind == 17
        || expressionKind == 18 || expressionKind == 19
        || expressionKind == 20 || expressionKind == 21
        || expressionKind == 22 || expressionKind == 23
        || expressionKind == 24 || expressionKind == 25
        || (expressionKind >= 31 && expressionKind <= 33)
        || expressionKind == 35 || expressionKind == 36)
    {
        int32 leftExpressionId
            = Host.StandaloneSourceExpressions[
                expressionOffset + 2];
        int32 rightExpressionId
            = Host.StandaloneSourceExpressions[
                expressionOffset + 3];
        int32 visitStatus = VisitStandaloneSourceExpression(
            bodyId, expressionFirst, expressionCount,
            leftExpressionId, depth + 1);
        if (visitStatus != 0)
        {
            return visitStatus;
        }
        visitStatus = VisitStandaloneSourceExpression(
            bodyId, expressionFirst, expressionCount,
            rightExpressionId, depth + 1);
        if (visitStatus != 0)
        {
            return visitStatus;
        }
    }
    Host.StandaloneDirectCallTraversalExpressionStates[
        expressionIndex] = 2;
    return 0;
}

int32 AppendStandaloneNormalizedHome(int32 bodyId,
    int32 homeFirst, int32 role, int32 typeId, int32 formalOrdinal,
    ref<init int32> homeIdResult)
    ensure return == 0 ? *homeIdResult is init : true
{
    int32 count = Host.StandaloneNormalizedHomeCount[0];
    if (count < homeFirst
        || count >= Host.StandaloneNormalizedHomes.Length / 5)
    {
        return 3;
    }
    int32 homeId = count - homeFirst;
    if (homeId < 0 || homeId >= 65536
        || typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0]
        || (role != 2 && role != 3))
    {
        return 3;
    }
    int32 offset = count * 5;
    Host.StandaloneNormalizedHomes[offset] = bodyId;
    Host.StandaloneNormalizedHomes[offset + 1] = role;
    Host.StandaloneNormalizedHomes[offset + 2] = 0;
    Host.StandaloneNormalizedHomes[offset + 3] = typeId;
    Host.StandaloneNormalizedHomes[offset + 4]
        = role == 2 ? formalOrdinal : 0;
    *homeIdResult = homeId;
    Host.StandaloneNormalizedHomeCount[0] = count + 1;
    return 0;
}

int32 AppendStandaloneNormalizedRebindableHome(int32 bodyId,
    int32 homeFirst, int32 typeId,
    ref<init int32> homeIdResult)
    ensure return == 0 ? *homeIdResult is init : true
{
    int32 status = AppendStandaloneNormalizedHome(
        bodyId, homeFirst, 3, typeId, 0,
        ref init *homeIdResult);
    if (status != 0)
    {
        return status;
    }
    int32 offset = (homeFirst + *homeIdResult) * 5;
    Host.StandaloneNormalizedHomes[offset + 2] = 1;
    return 0;
}

int32 AppendStandaloneNormalizedConstant(int32 bodyId,
    int32 constantFirst, int32 typeId, int32 valueLow,
    int32 valueHigh, ref<init int32> constantIdResult)
    ensure return == 0 ? *constantIdResult is init : true
{
    int32 count = Host.StandaloneNormalizedConstantCount[0];
    if (count < constantFirst
        || count >= Host.StandaloneNormalizedConstants.Length / 4
        || typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0])
    {
        return 3;
    }
    int32 constantId = count - constantFirst;
    if (constantId < 0 || constantId >= 65536)
    {
        return 3;
    }
    int32 offset = count * 4;
    Host.StandaloneNormalizedConstants[offset] = bodyId;
    Host.StandaloneNormalizedConstants[offset + 1] = typeId;
    Host.StandaloneNormalizedConstants[offset + 2] = valueLow;
    Host.StandaloneNormalizedConstants[offset + 3] = valueHigh;
    *constantIdResult = constantId;
    Host.StandaloneNormalizedConstantCount[0] = count + 1;
    return 0;
}

int32 AppendStandaloneNormalizedOperation(int32 bodyId,
    int32 kind, int32 operand0, int32 operand1, int32 operand2)
{
    int32 count = Host.StandaloneNormalizedOperationCount[0];
    if (count < 0
        || count >= Host.StandaloneNormalizedOperations.Length / 5
        || bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0])
    {
        return 3;
    }
    int32 offset = count * 5;
    Host.StandaloneNormalizedOperations[offset] = kind;
    Host.StandaloneNormalizedOperations[offset + 1] = operand0;
    Host.StandaloneNormalizedOperations[offset + 2] = operand1;
    Host.StandaloneNormalizedOperations[offset + 3] = operand2;
    Host.StandaloneNormalizedOperations[offset + 4] = bodyId;
    Host.StandaloneNormalizedOperationCount[0] = count + 1;
    return 0;
}

int32 AppendStandaloneNormalizedBlock(int32 bodyId,
    int32 blockId, int32 operationFirst, int32 operationCount,
    int32 terminatorKind, int32 selectorKind, int32 selectorIndex,
    int32 selectorTypeId, int32 target0, int32 target1,
    int32 conditionSelectorKind, int32 conditionSelectorIndex,
    int32 conditionTypeId, int32 conditionalEdgeRecordIndex,
    int32 noReturnInvokeLocalId, int32 flags,
    ref<init int32> blockIndexResult)
    ensure return == 0 ? *blockIndexResult is init : true
{
    int32 count = Host.StandaloneNormalizedBlockCount[0];
    if (count < 0
        || count >= Host.StandaloneNormalizedBlocks.Length / 16
        || bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || blockId < 0 || blockId > 0xFFFF
        || operationFirst < 0 || operationCount < 0
        || operationFirst
            > Host.StandaloneNormalizedOperationCount[0]
                - operationCount
        || (terminatorKind != 1 && terminatorKind != 2
            && terminatorKind != 3 && terminatorKind != 4)
        || (selectorKind != 0 && selectorKind != 2)
        || (selectorKind == 0 && selectorIndex != 0)
        || target0 < -1 || target0 > 0xFFFF
        || target1 < -1 || target1 > 0xFFFF
        || conditionSelectorKind < 0 || conditionSelectorKind > 2
        || (conditionSelectorKind == 0
            && conditionSelectorIndex != 0)
        || conditionSelectorIndex < 0
        || conditionSelectorIndex > 0xFFFF
        || conditionalEdgeRecordIndex < -1
        || conditionalEdgeRecordIndex > 0xFFFF
        || noReturnInvokeLocalId < -1
        || noReturnInvokeLocalId > 0xFFFF
        || flags != 0)
    {
        return 3;
    }

    int32 offset = count * 16;
    Host.StandaloneNormalizedBlocks[offset] = bodyId;
    Host.StandaloneNormalizedBlocks[offset + 1] = blockId;
    Host.StandaloneNormalizedBlocks[offset + 2] = operationFirst;
    Host.StandaloneNormalizedBlocks[offset + 3] = operationCount;
    Host.StandaloneNormalizedBlocks[offset + 4] = terminatorKind;
    Host.StandaloneNormalizedBlocks[offset + 5] = selectorKind;
    Host.StandaloneNormalizedBlocks[offset + 6] = selectorIndex;
    Host.StandaloneNormalizedBlocks[offset + 7] = selectorTypeId;
    Host.StandaloneNormalizedBlocks[offset + 8] = target0;
    Host.StandaloneNormalizedBlocks[offset + 9] = target1;
    Host.StandaloneNormalizedBlocks[offset + 10]
        = conditionSelectorKind;
    Host.StandaloneNormalizedBlocks[offset + 11]
        = conditionSelectorIndex;
    Host.StandaloneNormalizedBlocks[offset + 12] = conditionTypeId;
    Host.StandaloneNormalizedBlocks[offset + 13]
        = conditionalEdgeRecordIndex;
    Host.StandaloneNormalizedBlocks[offset + 14]
        = noReturnInvokeLocalId;
    Host.StandaloneNormalizedBlocks[offset + 15] = flags;
    Host.StandaloneNormalizedBlockCount[0] = count + 1;
    *blockIndexResult = count;
    return 0;
}

int32 AppendStandaloneNormalizedReturnBlock(int32 bodyId,
    int32 blockId, int32 operationFirst, int32 operationCount,
    int32 terminalKind, ref<init int32> blockIndexResult)
    ensure return == 0 ? *blockIndexResult is init : true
{
    int32 returnTypeId
        = Host.StandaloneSourceCallableInfo[bodyId * 12 + 4];
    if (operationCount <= 0
        || terminalKind < 0 || terminalKind > 1)
    {
        return 3;
    }
    int32 lastOperationOffset
        = (operationFirst + operationCount - 1) * 5;
    int32 finalOperationKind
        = Host.StandaloneNormalizedOperations[
            lastOperationOffset];
    if (terminalKind == 1)
    {
        if (finalOperationKind != 3)
        {
            return 3;
        }
        return AppendStandaloneNormalizedBlock(bodyId, blockId,
            operationFirst, operationCount, 2, 0, 0, 0, -1, -1,
            0, 0, 0, -1,
            Host.StandaloneNormalizedOperations[
                lastOperationOffset + 1],
            0, ref init *blockIndexResult);
    }
    if (IsStandaloneUnitType(returnTypeId))
    {
        if (finalOperationKind != 5)
        {
            return 3;
        }
        return AppendStandaloneNormalizedBlock(bodyId, blockId,
            operationFirst, operationCount, 1, 0, 0, returnTypeId,
            -1, -1, 0, 0, 0, -1, -1, 0,
            ref init *blockIndexResult);
    }
    if (finalOperationKind != 4)
    {
        return 3;
    }
    return AppendStandaloneNormalizedBlock(bodyId, blockId,
        operationFirst, operationCount, 1, 2,
        Host.StandaloneNormalizedOperations[lastOperationOffset + 1],
        returnTypeId, -1, -1, 0, 0, 0, -1, -1, 0,
        ref init *blockIndexResult);
}

int32 NormalizeStandaloneSourceIfReturns(int32 bodyId,
    int32 ifStatementId)
{
    int32 bodyBlockFirst
        = Host.StandaloneNormalizedBodyBlockRanges[bodyId * 2];
    if (bodyBlockFirst < 0
        || Host.StandaloneNormalizedBlockCount[0] != bodyBlockFirst)
    {
        return 2;
    }
    int32 statementOffset = ifStatementId * 3;
    int32 conditionExpressionId
        = Host.StandaloneSourceStatements[statementOffset + 1];
    int32 ifNodeId
        = Host.StandaloneSourceStatements[statementOffset + 2];
    if (conditionExpressionId < 0
        || ifNodeId < 0 || ifNodeId
            >= Host.StandaloneSourceIfNodeCount[0]
        || Host.StandaloneSourceIfNodes[ifNodeId * 5] != bodyId)
    {
        return 3;
    }
    int32 ifNodeOffset = ifNodeId * 5;
    int32 trueFirst
        = Host.StandaloneSourceIfNodes[ifNodeOffset + 1];
    int32 trueCount
        = Host.StandaloneSourceIfNodes[ifNodeOffset + 2];
    int32 falseFirst
        = Host.StandaloneSourceIfNodes[ifNodeOffset + 3];
    int32 falseCount
        = Host.StandaloneSourceIfNodes[ifNodeOffset + 4];
    if (trueCount <= 0 || falseCount < 0
        || trueFirst < 0 || falseFirst < 0
        || trueFirst + trueCount
            > Host.StandaloneSourceIfChildCount[0]
        || falseFirst + falseCount
            > Host.StandaloneSourceIfChildCount[0]
        || trueFirst + trueCount != falseFirst)
    {
        return 3;
    }
    int32 trueStatementId
        = Host.StandaloneSourceIfChildren[trueFirst];
    int32 falseStatementId = falseCount == 0
        ? -1 : Host.StandaloneSourceIfChildren[falseFirst];
    if (trueStatementId < 0
        || trueStatementId
            >= Host.StandaloneSourceStatementCount[0]
        || (falseCount != 0
            && (falseStatementId < 0
                || falseStatementId
                    >= Host.StandaloneSourceStatementCount[0])))
    {
        return 3;
    }
    int32 trueStatementKind
        = Host.StandaloneSourceStatements[trueStatementId * 3];
    int32 falseStatementKind = falseCount == 0
        ? -1
        : Host.StandaloneSourceStatements[falseStatementId * 3];
    bool trueReturns
        = trueCount == 1 && trueStatementKind == 1;
    bool falseReturns
        = falseCount == 1 && falseStatementKind == 1;
    bool bothReturns
        = trueReturns && falseReturns;
    mut bool trueAssignments = trueCount > 0;
    mut bool falseAssignments = falseCount > 0;
    mut bool bothAssignments = true;
    for (mut int32 branchIndex = 0;
        branchIndex < 2;
        branchIndex = branchIndex + 1)
    {
        int32 childFirst = branchIndex == 0 ? trueFirst : falseFirst;
        int32 childCount = branchIndex == 0 ? trueCount : falseCount;
        for (mut int32 childIndex = 0;
            childIndex < childCount;
            childIndex = childIndex + 1)
        {
            int32 childStatementId
                = Host.StandaloneSourceIfChildren[
                    childFirst + childIndex];
            if (childStatementId < 0
                || childStatementId
                    >= Host.StandaloneSourceStatementCount[0]
                || Host.StandaloneSourceStatements[
                    childStatementId * 3] != 5)
            {
                bothAssignments = false;
                if (branchIndex == 0)
                {
                    trueAssignments = false;
                }
                else
                {
                    falseAssignments = false;
                }
            }
        }
    }
    bothAssignments = bothAssignments
        && (falseCount != 0 || trueAssignments);
    bool oneReturnOneAssignments
        = (trueReturns && falseAssignments)
            || (falseReturns && trueAssignments);
    bool oneReturnNoElse
        = trueReturns && falseCount == 0;
    if (!bothReturns && !bothAssignments
        && !oneReturnOneAssignments && !oneReturnNoElse)
    {
        return 3;
    }
    if (bothAssignments || oneReturnOneAssignments)
    {
        int32 localId = -1;
        int32 localTypeId = -1;
        int32 assignmentBranchIndex
            = trueReturns ? 1 : 0;
        for (mut int32 branchOrdinal = 0;
            branchOrdinal < (bothAssignments ? 2 : 1);
            branchOrdinal = branchOrdinal + 1)
        {
            int32 branchIndex = bothAssignments
                ? branchOrdinal : assignmentBranchIndex;
            int32 childFirst
                = branchIndex == 0 ? trueFirst : falseFirst;
            int32 childCount
                = branchIndex == 0 ? trueCount : falseCount;
            for (mut int32 childIndex = 0;
                childIndex < childCount;
                childIndex = childIndex + 1)
            {
                int32 childStatementId
                    = Host.StandaloneSourceIfChildren[
                        childFirst + childIndex];
                int32 childPlaceId
                    = Host.StandaloneSourceStatements[
                        childStatementId * 3 + 2];
                if (childPlaceId < 0
                    || childPlaceId
                        >= Host.StandaloneSourcePlaceCount[0])
                {
                    return 3;
                }
                int32 childPlaceOffset = childPlaceId * 5;
                int32 childLocalId
                    = Host.StandaloneSourcePlaces[
                        childPlaceOffset + 3];
                int32 childTypeId
                    = Host.StandaloneSourcePlaces[
                        childPlaceOffset + 1];
                if (Host.StandaloneSourcePlaces[
                        childPlaceOffset] != bodyId
                    || Host.StandaloneSourcePlaces[
                        childPlaceOffset + 2] != 2
                    || (localId >= 0
                        && (localId != childLocalId
                            || localTypeId != childTypeId)))
                {
                    return 3;
                }
                localId = childLocalId;
                localTypeId = childTypeId;
            }
        }
        int32 localRangeOffset = bodyId * 2;
        int32 localFirst
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset];
        int32 localCount
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset + 1];
        if (localId < localFirst
            || localId >= localFirst + localCount)
        {
            return 3;
        }
        int32 localOffset = localId * 10;
        int32 bindingKind
            = Host.StandaloneSourceLocals[localOffset + 3];
        if (Host.StandaloneSourceLocals[localOffset] != bodyId
            || (bindingKind != 1 && bindingKind != 2
                && bindingKind != 3)
            || (bindingKind == 2
                && (falseCount == 0 || trueCount != 1
                    || falseCount != 1))
            || Host.StandaloneSourceLocalStates[localId] != 1
            || Host.StandaloneSourceLocals[localOffset + 2]
                != localTypeId)
        {
            return 3;
        }
    }

    int32 conditionExpressionOffset
        = (Host.StandaloneSourceBodies[bodyId * 12 + 3]
            + conditionExpressionId) * 8;
    int32 conditionTypeId
        = Host.StandaloneSourceExpressions[
            conditionExpressionOffset + 1];
    if (!IsStandaloneLogicalNotType(conditionTypeId))
    {
        return 3;
    }
    int32 conditionExpressionKind
        = Host.StandaloneSourceExpressions[conditionExpressionOffset];
    if (conditionExpressionKind == 35
        || conditionExpressionKind == 36)
    {
        if (bothReturns)
        {
            return NormalizeStandaloneSourceLazyBooleanIfReturns(
                bodyId, ifStatementId, conditionExpressionId,
                trueStatementId, falseStatementId);
        }
        if (bothAssignments)
        {
            return NormalizeStandaloneSourceLazyBooleanIfAssignments(
                bodyId, ifStatementId, ifNodeId,
                conditionExpressionId, trueFirst, trueCount,
                falseFirst, falseCount);
        }
        if (oneReturnOneAssignments || oneReturnNoElse)
        {
            return NormalizeStandaloneSourceLazyBooleanIfTerminalArm(
                bodyId, ifStatementId, conditionExpressionId,
                trueFirst, trueCount, falseFirst, falseCount,
                trueReturns, falseReturns);
        }
        return 2;
    }
    int32 conditionOperationFirst
        = Host.StandaloneNormalizedBodies[bodyId * 12 + 9];
    init int32 conditionSelectorKind;
    init int32 conditionSourceUse;
    init int32 conditionSelectorIndex;
    init bool conditionTerminated;
    int32 conditionStatus = NormalizeStandaloneSourceExpression(
        bodyId, conditionExpressionId, 1,
        ref init conditionSelectorKind,
        ref init conditionSourceUse,
        ref init conditionSelectorIndex,
        ref init conditionTerminated);
    if (conditionStatus != 0)
    {
        return conditionStatus;
    }
    if (conditionTerminated)
    {
        return 2;
    }
    if (conditionSelectorKind != 2 || conditionSourceUse != 1
        || conditionSelectorIndex < 0)
    {
        return 3;
    }
    bool hasNormalContinuation
        = bothAssignments || oneReturnOneAssignments
            || oneReturnNoElse;
    int32 conditionOperationCount
        = Host.StandaloneNormalizedOperationCount[0]
            - conditionOperationFirst;
    init int32 conditionBlockIndex;
    int32 conditionBlockStatus
        = AppendStandaloneNormalizedBlock(
            bodyId, 0, conditionOperationFirst,
            conditionOperationCount, 4, 0, 0, 0, 1, 2,
            2, conditionSelectorIndex, conditionTypeId,
            hasNormalContinuation ? 4 : 3, -1, 0,
            ref init conditionBlockIndex);
    if (conditionBlockStatus != 0)
    {
        return conditionBlockStatus;
    }

    for (mut int32 branchIndex = 0;
        branchIndex < 2;
        branchIndex = branchIndex + 1)
    {
        int32 childFirst = branchIndex == 0 ? trueFirst : falseFirst;
        int32 childCount = branchIndex == 0 ? trueCount : falseCount;
        bool branchReturns
            = bothReturns
                || (oneReturnOneAssignments
                    && (branchIndex == 0
                        ? trueReturns : falseReturns)
                || (oneReturnNoElse && branchIndex == 0);
        int32 branchOperationFirst
            = Host.StandaloneNormalizedOperationCount[0];
        mut int32 branchTerminalKind = 0;
        for (mut int32 childIndex = 0;
            childIndex < childCount;
            childIndex = childIndex + 1)
        {
            int32 childStatementId
                = Host.StandaloneSourceIfChildren[
                    childFirst + childIndex];
            int32 childStatementOffset = childStatementId * 3;
            if (childStatementId < 0
                || childStatementId
                    >= Host.StandaloneSourceStatementCount[0]
                || Host.StandaloneSourceStatementParentIds[
                    childStatementId] != ifStatementId
                || Host.StandaloneSourceStatements[
                    childStatementOffset]
                    != (branchReturns ? 1 : 5))
            {
                return 3;
            }
            init int32 childTerminalKind;
            int32 branchStatus = NormalizeStandaloneSourceStatement(
                bodyId, childStatementOffset,
                ref init childTerminalKind);
            if (branchStatus != 0)
            {
                return branchStatus;
            }
            if (!branchReturns && childTerminalKind != 0)
            {
                return 3;
            }
            branchTerminalKind = childTerminalKind;
        }
        int32 branchOperationCount
            = Host.StandaloneNormalizedOperationCount[0]
                - branchOperationFirst;
        init int32 branchBlockIndex;
        int32 branchBlockStatus;
        if (!branchReturns)
        {
            branchBlockStatus
                = AppendStandaloneNormalizedBlock(
                    bodyId, branchIndex + 1, branchOperationFirst,
                    branchOperationCount, 3, 0, 0, 0, 3, -1,
                    0, 0, 0, -1, -1, 0,
                    ref init branchBlockIndex);
        }
        else
        {
            branchBlockStatus
                = AppendStandaloneNormalizedReturnBlock(
                    bodyId, branchIndex + 1, branchOperationFirst,
                    branchOperationCount, branchTerminalKind,
                    ref init branchBlockIndex);
        }
        if (branchBlockStatus != 0)
        {
            return branchBlockStatus;
        }
    }
    return 0;
}

int32 NormalizeStandaloneSourceLazyBooleanIfReturns(int32 bodyId,
    int32 ifStatementId, int32 conditionExpressionId,
    int32 trueStatementId, int32 falseStatementId)
{
    if (bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0])
    {
        return 3;
    }
    int32 bodyBlockFirst
        = Host.StandaloneNormalizedBodyBlockRanges[bodyId * 2];
    int32 bodyExpressionFirst
        = Host.StandaloneSourceBodies[bodyId * 12 + 3];
    int32 bodyExpressionCount
        = Host.StandaloneSourceBodies[bodyId * 12 + 4];
    if (bodyBlockFirst < 0
        || Host.StandaloneNormalizedBlockCount[0] != bodyBlockFirst
        || conditionExpressionId < 0
        || conditionExpressionId >= bodyExpressionCount
        || trueStatementId < 0
        || trueStatementId >= Host.StandaloneSourceStatementCount[0]
        || falseStatementId < 0
        || falseStatementId >= Host.StandaloneSourceStatementCount[0]
        || Host.StandaloneSourceStatementParentIds[
            trueStatementId] != ifStatementId
        || Host.StandaloneSourceStatementParentIds[
            falseStatementId] != ifStatementId
        || Host.StandaloneSourceStatements[trueStatementId * 3] != 1
        || Host.StandaloneSourceStatements[falseStatementId * 3] != 1)
    {
        return 3;
    }

    int32 conditionExpressionOffset
        = (bodyExpressionFirst + conditionExpressionId) * 8;
    int32 conditionKind
        = Host.StandaloneSourceExpressions[conditionExpressionOffset];
    int32 conditionTypeId
        = Host.StandaloneSourceExpressions[
            conditionExpressionOffset + 1];
    if ((conditionKind != 35 && conditionKind != 36)
        || !IsStandaloneLogicalNotType(conditionTypeId))
    {
        return 3;
    }

    init int32 leafCount;
    init bool homogeneous;
    int32 countStatus = CountStandaloneSourceLazyBooleanTree(
        bodyId, conditionExpressionId, conditionKind, 0,
        ref init leafCount, ref init homogeneous);
    if (countStatus != 0)
    {
        return countStatus;
    }
    int32 finalBodyBlockCount = leafCount + 2;
    if (leafCount < 2
        || finalBodyBlockCount > 0x1_0000
        || leafCount > 0x1_0000 - finalBodyBlockCount)
    {
        return 3;
    }

    init int32 nextBlockOrdinal;
    init int32 nextEdgeOrdinal;
    int32 decisionStatus = NormalizeStandaloneSourceLazyBooleanDecision(
        bodyId, conditionExpressionId, conditionTypeId,
        leafCount, leafCount + 1, leafCount, finalBodyBlockCount,
        0, 0, 0, ref init nextBlockOrdinal,
        ref init nextEdgeOrdinal);
    if (decisionStatus != 0)
    {
        return decisionStatus;
    }
    if (nextBlockOrdinal != leafCount
        || nextEdgeOrdinal != leafCount
        || Host.StandaloneNormalizedBlockCount[0]
            != bodyBlockFirst + leafCount)
    {
        return 3;
    }

    for (mut int32 branchIndex = 0;
        branchIndex < 2;
        branchIndex = branchIndex + 1)
    {
        int32 childStatementId = branchIndex == 0
            ? trueStatementId : falseStatementId;
        int32 childStatementOffset = childStatementId * 3;
        int32 returnExpressionId
            = Host.StandaloneSourceStatements[childStatementOffset + 1];
        if (returnExpressionId >= 0)
        {
            if (returnExpressionId >= bodyExpressionCount)
            {
                return 3;
            }
            int32 returnExpressionKind
                = Host.StandaloneSourceExpressions[
                    (bodyExpressionFirst + returnExpressionId) * 8];
            if (returnExpressionKind == 34
                || returnExpressionKind == 35
                || returnExpressionKind == 36)
            {
                return 2;
            }
        }

        int32 operationFirst
            = Host.StandaloneNormalizedOperationCount[0];
        init int32 terminalKind;
        int32 returnStatus = NormalizeStandaloneSourceStatement(
            bodyId, childStatementOffset,
            ref init terminalKind);
        if (returnStatus != 0)
        {
            return returnStatus;
        }
        int32 operationCount
            = Host.StandaloneNormalizedOperationCount[0]
                - operationFirst;
        init int32 returnBlockIndex;
        int32 returnBlockStatus
            = AppendStandaloneNormalizedReturnBlock(
                bodyId, leafCount + branchIndex, operationFirst,
                operationCount, terminalKind,
                ref init returnBlockIndex);
        if (returnBlockStatus != 0)
        {
            return returnBlockStatus;
        }
    }
    if (Host.StandaloneNormalizedBlockCount[0]
        != bodyBlockFirst + finalBodyBlockCount)
    {
        return 3;
    }
    return 0;
}

int32 NormalizeStandaloneSourceLazyBooleanIfAssignments(int32 bodyId,
    int32 ifStatementId, int32 ifNodeId,
    int32 conditionExpressionId, int32 trueFirst, int32 trueCount,
    int32 falseFirst, int32 falseCount)
{
    if (bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || ifStatementId < 0
        || ifStatementId >= Host.StandaloneSourceStatementCount[0]
        || ifNodeId < 0
        || ifNodeId >= Host.StandaloneSourceIfNodeCount[0]
        || trueCount <= 0 || falseCount < 0
        || trueFirst < 0 || falseFirst < 0
        || trueFirst > Host.StandaloneSourceIfChildCount[0] - trueCount
        || falseFirst > Host.StandaloneSourceIfChildCount[0] - falseCount
        || trueFirst + trueCount != falseFirst
        || Host.StandaloneSourceIfNodes[ifNodeId * 5] != bodyId
        || Host.StandaloneSourceIfNodes[ifNodeId * 5 + 1] != trueFirst
        || Host.StandaloneSourceIfNodes[ifNodeId * 5 + 2] != trueCount
        || Host.StandaloneSourceIfNodes[ifNodeId * 5 + 3] != falseFirst
        || Host.StandaloneSourceIfNodes[ifNodeId * 5 + 4] != falseCount)
    {
        return 3;
    }

    int32 bodyBlockFirst
        = Host.StandaloneNormalizedBodyBlockRanges[bodyId * 2];
    int32 conditionExpressionCount
        = Host.StandaloneSourceBodies[bodyId * 12 + 4];
    int32 bodyExpressionFirst
        = Host.StandaloneSourceBodies[bodyId * 12 + 3];
    if (bodyBlockFirst < 0
        || Host.StandaloneNormalizedBlockCount[0] != bodyBlockFirst
        || conditionExpressionId < 0
        || conditionExpressionId >= conditionExpressionCount)
    {
        return 3;
    }
    int32 conditionExpressionOffset
        = (bodyExpressionFirst + conditionExpressionId) * 8;
    int32 conditionKind
        = Host.StandaloneSourceExpressions[conditionExpressionOffset];
    int32 conditionTypeId
        = Host.StandaloneSourceExpressions[
            conditionExpressionOffset + 1];
    if ((conditionKind != 35 && conditionKind != 36)
        || !IsStandaloneLogicalNotType(conditionTypeId))
    {
        return 3;
    }

    init int32 leafCount;
    init bool homogeneous;
    int32 countStatus = CountStandaloneSourceLazyBooleanTree(
        bodyId, conditionExpressionId, conditionKind, 0,
        ref init leafCount, ref init homogeneous);
    if (countStatus != 0)
    {
        return countStatus;
    }
    int32 joinBlockId = leafCount + 2;
    int32 finalBodyBlockCount = leafCount + 3;
    if (leafCount < 2
        || finalBodyBlockCount > 0x1_0000
        || leafCount > 0x1_0000 - finalBodyBlockCount)
    {
        return 3;
    }

    init int32 nextBlockOrdinal;
    init int32 nextEdgeOrdinal;
    int32 decisionStatus = NormalizeStandaloneSourceLazyBooleanDecision(
        bodyId, conditionExpressionId, conditionTypeId,
        leafCount, leafCount + 1, leafCount, finalBodyBlockCount,
        0, 0, 0, ref init nextBlockOrdinal,
        ref init nextEdgeOrdinal);
    if (decisionStatus != 0)
    {
        return decisionStatus;
    }
    if (nextBlockOrdinal != leafCount
        || nextEdgeOrdinal != leafCount
        || Host.StandaloneNormalizedBlockCount[0]
            != bodyBlockFirst + leafCount)
    {
        return 3;
    }

    for (mut int32 branchIndex = 0;
        branchIndex < 2;
        branchIndex = branchIndex + 1)
    {
        int32 childFirst = branchIndex == 0 ? trueFirst : falseFirst;
        int32 childCount = branchIndex == 0 ? trueCount : falseCount;
        int32 branchOperationFirst
            = Host.StandaloneNormalizedOperationCount[0];
        for (mut int32 childIndex = 0;
            childIndex < childCount;
            childIndex = childIndex + 1)
        {
            int32 childStatementId
                = Host.StandaloneSourceIfChildren[
                    childFirst + childIndex];
            if (childStatementId < 0
                || childStatementId
                    >= Host.StandaloneSourceStatementCount[0]
                || Host.StandaloneSourceStatementParentIds[
                    childStatementId] != ifStatementId
                || Host.StandaloneSourceStatements[
                    childStatementId * 3] != 5)
            {
                return 3;
            }
            init int32 terminalKind;
            int32 childStatus = NormalizeStandaloneSourceStatement(
                bodyId, childStatementId * 3,
                ref init terminalKind);
            if (childStatus != 0 || terminalKind != 0)
            {
                return childStatus != 0 ? childStatus : 3;
            }
        }

        int32 branchOperationCount
            = Host.StandaloneNormalizedOperationCount[0]
                - branchOperationFirst;
        init int32 branchBlockIndex;
        int32 branchStatus = AppendStandaloneNormalizedBlock(
            bodyId, leafCount + branchIndex, branchOperationFirst,
            branchOperationCount, 3, 0, 0, 0, joinBlockId, -1,
            0, 0, 0, -1, -1, 0,
            ref init branchBlockIndex);
        if (branchStatus != 0)
        {
            return branchStatus;
        }
        if (branchBlockIndex
            != bodyBlockFirst + leafCount + branchIndex)
        {
            return 3;
        }
    }
    if (Host.StandaloneNormalizedBlockCount[0]
        != bodyBlockFirst + leafCount + 2)
    {
        return 3;
    }
    return 0;
}

int32 NormalizeStandaloneSourceLazyBooleanIfTerminalArm(
    int32 bodyId, int32 ifStatementId, int32 conditionExpressionId,
    int32 trueFirst, int32 trueCount, int32 falseFirst, int32 falseCount,
    bool trueReturns, bool falseReturns)
{
    int32 ifNodeId = ifStatementId >= 0
        && ifStatementId < Host.StandaloneSourceStatementCount[0]
        ? Host.StandaloneSourceStatements[ifStatementId * 3 + 2] : -1;
    if (bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || ifStatementId < 0
        || ifStatementId >= Host.StandaloneSourceStatementCount[0]
        || ifNodeId < 0
        || ifNodeId >= Host.StandaloneSourceIfNodeCount[0]
        || trueReturns == falseReturns
        || trueCount <= 0 || falseCount < 0
        || trueFirst < 0 || falseFirst < 0
        || trueFirst > Host.StandaloneSourceIfChildCount[0] - trueCount
        || falseFirst > Host.StandaloneSourceIfChildCount[0] - falseCount
        || trueFirst + trueCount != falseFirst)
    {
        return 3;
    }

    int32 bodyBlockFirst
        = Host.StandaloneNormalizedBodyBlockRanges[bodyId * 2];
    int32 expressionFirst
        = Host.StandaloneSourceBodies[bodyId * 12 + 3];
    int32 expressionCount
        = Host.StandaloneSourceBodies[bodyId * 12 + 4];
    if (bodyBlockFirst < 0
        || Host.StandaloneNormalizedBlockCount[0] != bodyBlockFirst
        || conditionExpressionId < 0
        || conditionExpressionId >= expressionCount
        || Host.StandaloneSourceIfNodes[ifNodeId * 5] != bodyId
        || Host.StandaloneSourceIfNodes[ifNodeId * 5 + 1] != trueFirst
        || Host.StandaloneSourceIfNodes[ifNodeId * 5 + 2] != trueCount
        || Host.StandaloneSourceIfNodes[ifNodeId * 5 + 3] != falseFirst
        || Host.StandaloneSourceIfNodes[ifNodeId * 5 + 4] != falseCount)
    {
        return 3;
    }

    int32 conditionOffset
        = (expressionFirst + conditionExpressionId) * 8;
    int32 conditionKind
        = Host.StandaloneSourceExpressions[conditionOffset];
    int32 conditionTypeId
        = Host.StandaloneSourceExpressions[conditionOffset + 1];
    if ((conditionKind != 35 && conditionKind != 36)
        || !IsStandaloneLogicalNotType(conditionTypeId))
    {
        return 3;
    }
    init int32 leafCount;
    init bool homogeneous;
    int32 countStatus = CountStandaloneSourceLazyBooleanTree(
        bodyId, conditionExpressionId, conditionKind, 0,
        ref init leafCount, ref init homogeneous);
    if (countStatus != 0)
    {
        return countStatus;
    }

    int32 joinBlockId = leafCount + 2;
    int32 finalBodyBlockCount = leafCount + 3;
    if (leafCount < 2
        || finalBodyBlockCount > 0x1_0000
        || leafCount > 0x1_0000 - finalBodyBlockCount)
    {
        return 3;
    }
    init int32 nextBlockOrdinal;
    init int32 nextEdgeOrdinal;
    int32 decisionStatus = NormalizeStandaloneSourceLazyBooleanDecision(
        bodyId, conditionExpressionId, conditionTypeId,
        leafCount, leafCount + 1, leafCount, finalBodyBlockCount,
        0, 0, 0, ref init nextBlockOrdinal,
        ref init nextEdgeOrdinal);
    if (decisionStatus != 0)
    {
        return decisionStatus;
    }
    if (nextBlockOrdinal != leafCount
        || nextEdgeOrdinal != leafCount
        || Host.StandaloneNormalizedBlockCount[0]
            != bodyBlockFirst + leafCount)
    {
        return 3;
    }

    for (mut int32 branchIndex = 0;
        branchIndex < 2;
        branchIndex = branchIndex + 1)
    {
        bool branchReturns = branchIndex == 0
            ? trueReturns : falseReturns;
        int32 childFirst = branchIndex == 0
            ? trueFirst : falseFirst;
        int32 childCount = branchIndex == 0
            ? trueCount : falseCount;
        if (branchReturns && childCount != 1)
        {
            return 3;
        }
        int32 operationFirst
            = Host.StandaloneNormalizedOperationCount[0];
        mut int32 branchTerminalKind = 0;
        for (mut int32 childIndex = 0;
            childIndex < childCount;
            childIndex = childIndex + 1)
        {
            int32 childStatementId
                = Host.StandaloneSourceIfChildren[
                    childFirst + childIndex];
            int32 childStatementOffset = childStatementId * 3;
            if (childStatementId < 0
                || childStatementId
                    >= Host.StandaloneSourceStatementCount[0]
                || Host.StandaloneSourceStatementParentIds[
                    childStatementId] != ifStatementId
                || Host.StandaloneSourceStatements[
                    childStatementOffset]
                    != (branchReturns ? 1 : 5))
            {
                return 3;
            }
            init int32 childTerminalKind;
            int32 childStatus = NormalizeStandaloneSourceStatement(
                bodyId, childStatementOffset,
                ref init childTerminalKind);
            if (childStatus != 0)
            {
                return childStatus;
            }
            if (!branchReturns && childTerminalKind != 0)
            {
                return 3;
            }
            branchTerminalKind = childTerminalKind;
        }

        int32 operationCount
            = Host.StandaloneNormalizedOperationCount[0]
                - operationFirst;
        init int32 branchBlockIndex;
        int32 branchStatus;
        if (branchReturns)
        {
            branchStatus
                = AppendStandaloneNormalizedReturnBlock(
                    bodyId, leafCount + branchIndex, operationFirst,
                    operationCount, branchTerminalKind,
                    ref init branchBlockIndex);
        }
        else
        {
            branchStatus
                = AppendStandaloneNormalizedBlock(
                    bodyId, leafCount + branchIndex, operationFirst,
                    operationCount, 3, 0, 0, 0, joinBlockId, -1,
                    0, 0, 0, -1, -1, 0,
                    ref init branchBlockIndex);
        }
        if (branchStatus != 0)
        {
            return branchStatus;
        }
        if (branchBlockIndex
            != bodyBlockFirst + leafCount + branchIndex)
        {
            return 3;
        }
    }
    if (Host.StandaloneNormalizedBlockCount[0]
        != bodyBlockFirst + leafCount + 2)
    {
        return 3;
    }
    return 0;
}

int32 NormalizeStandaloneSourceStatement(int32 bodyId,
    int32 statementOffset, ref<init int32> terminalKind)
    ensure return == 0 ? *terminalKind is init : true
{
    *terminalKind = 0;
    int32 statementKind
        = Host.StandaloneSourceStatements[statementOffset];
    int32 expressionId
        = Host.StandaloneSourceStatements[statementOffset + 1];
    if (statementKind == 4)
    {
        int32 localId
            = Host.StandaloneSourceStatements[statementOffset + 2];
        int32 localRangeOffset = bodyId * 2;
        int32 localFirst
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset];
        int32 localCount
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset + 1];
        if (localId < localFirst
            || localId >= localFirst + localCount)
        {
            return 3;
        }
        int32 localOffset = localId * 10;
        int32 bindingKind
            = Host.StandaloneSourceLocals[localOffset + 3];
        int32 typeId
            = Host.StandaloneSourceLocals[localOffset + 2];
        int32 homeFirst
            = Host.StandaloneNormalizedBodies[bodyId * 12 + 1];
        if (Host.StandaloneSourceLocals[localOffset] != bodyId
            || typeId <= 0
            || typeId > Host.StandaloneTypeFactCount[0])
        {
            return 3;
        }
        if (expressionId < 0)
        {
            if (bindingKind != 2 && bindingKind != 3)
            {
                return 3;
            }
            return 0;
        }
        if (expressionId
            >= Host.StandaloneSourceBodies[bodyId * 12 + 4]
            || (bindingKind != 0 && bindingKind != 1)
            || Host.StandaloneSourceLocalStates[localId] != 1)
        {
            return 3;
        }

        init int32 selectorKind;
        init int32 sourceUse;
        init int32 selectorIndex;
        init bool terminated;
        int32 expressionStatus = NormalizeStandaloneSourceExpression(
            bodyId, expressionId, 0,
            ref init selectorKind, ref init sourceUse,
            ref init selectorIndex, ref init terminated);
        if (expressionStatus != 0)
        {
            return expressionStatus;
        }
        if (terminated)
        {
            *terminalKind = 1;
            return 0;
        }
        int32 expectedUse = GetStandaloneSourceUse(typeId);
        if (expectedUse == 0)
        {
            if (selectorKind != 0 || sourceUse != 0
                || selectorIndex != 0)
            {
                return 3;
            }
            Host.StandaloneNormalizedSourceLocalHomeIds[localId] = 0;
            return 0;
        }
        if (expectedUse != 1 || selectorKind != 2
            || sourceUse != 1 || selectorIndex < 0)
        {
            return 2;
        }
        if (bindingKind == 1)
        {
            init int32 mutableHomeId;
            int32 mutableHomeStatus
                = AppendStandaloneNormalizedRebindableHome(
                    bodyId, homeFirst, typeId,
                    ref init mutableHomeId);
            if (mutableHomeStatus != 0)
            {
                return mutableHomeStatus;
            }
            Host.StandaloneNormalizedSourceLocalHomeIds[localId]
                = mutableHomeId;
            int32 copyStatus = AppendStandaloneNormalizedOperation(
                bodyId, 30, selectorIndex, mutableHomeId, localId);
            if (copyStatus != 0)
            {
                return copyStatus;
            }
            return 0;
        }
        Host.StandaloneNormalizedSourceLocalHomeIds[localId]
            = selectorIndex;
        return 0;
    }
    if (statementKind == 5)
    {
        int32 placeId
            = Host.StandaloneSourceStatements[statementOffset + 2];
        if (placeId < 0
            || placeId >= Host.StandaloneSourcePlaceCount[0])
        {
            return 3;
        }
        int32 placeOffset = placeId * 5;
        int32 localId
            = Host.StandaloneSourcePlaces[placeOffset + 3];
        int32 localRangeOffset = bodyId * 2;
        int32 localFirst
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset];
        int32 localCount
            = Host.StandaloneSourceBodyLocalRanges[
                localRangeOffset + 1];
        if (localId < localFirst
            || localId >= localFirst + localCount)
        {
            return 3;
        }
        int32 localOffset = localId * 10;
        int32 typeId
            = Host.StandaloneSourceLocals[localOffset + 2];
        int32 bindingKind
            = Host.StandaloneSourceLocals[localOffset + 3];
        int32 destinationHomeId
            = Host.StandaloneNormalizedSourceLocalHomeIds[localId];
        if (Host.StandaloneSourcePlaces[placeOffset] != bodyId
            || Host.StandaloneSourcePlaces[placeOffset + 2] != 2
            || Host.StandaloneSourcePlaces[placeOffset + 1] != typeId
            || Host.StandaloneSourceLocals[localOffset] != bodyId
            || (bindingKind != 1 && bindingKind != 2
                && bindingKind != 3)
            || (bindingKind == 1 && destinationHomeId < 0)
            || expressionId < 0)
        {
            return 3;
        }

        init int32 selectorKind;
        init int32 sourceUse;
        init int32 selectorIndex;
        init bool terminated;
        int32 expressionDepth
            = Host.StandaloneSourceStatementParentIds[
                statementOffset / 3] < 0 ? 0 : 1;
        int32 expressionStatus = NormalizeStandaloneSourceExpression(
            bodyId, expressionId, expressionDepth,
            ref init selectorKind,
            ref init sourceUse, ref init selectorIndex,
            ref init terminated);
        if (expressionStatus != 0)
        {
            return expressionStatus;
        }
        if (terminated)
        {
            *terminalKind = 1;
            return 0;
        }
        int32 expectedUse = GetStandaloneSourceUse(typeId);
        if (expectedUse == 0)
        {
            if (selectorKind != 0 || sourceUse != 0
                || selectorIndex != 0)
            {
                return 3;
            }
            if (destinationHomeId < 0)
            {
                Host.StandaloneNormalizedSourceLocalHomeIds[localId] = 0;
            }
            return 0;
        }
        if (expectedUse != 1 || selectorKind != 2
            || sourceUse != 1 || selectorIndex < 0)
        {
            return 2;
        }
        if (destinationHomeId < 0)
        {
            init int32 initializedHomeId;
            int32 homeStatus;
            if (bindingKind == 2)
            {
                homeStatus = AppendStandaloneNormalizedHome(
                    bodyId,
                    Host.StandaloneNormalizedBodies[
                        bodyId * 12 + 1],
                    3, typeId, 0, ref init initializedHomeId);
            }
            else
            {
                homeStatus
                    = AppendStandaloneNormalizedRebindableHome(
                        bodyId,
                        Host.StandaloneNormalizedBodies[
                            bodyId * 12 + 1],
                        typeId, ref init initializedHomeId);
            }
            if (homeStatus != 0)
            {
                return homeStatus;
            }
            destinationHomeId = initializedHomeId;
            Host.StandaloneNormalizedSourceLocalHomeIds[localId]
                = destinationHomeId;
        }
        return AppendStandaloneNormalizedOperation(
            bodyId, 30, selectorIndex, destinationHomeId, localId);
    }
    if (statementKind == 1 && expressionId < 0)
    {
        if (!IsStandaloneUnitType(
                Host.StandaloneSourceCallableInfo[bodyId * 12 + 4]))
        {
            return 3;
        }
        return AppendStandaloneNormalizedOperation(
            bodyId, 5, 0, 0, 0);
    }
    if (expressionId < 0)
    {
        return 3;
    }

    init int32 selectorKind;
    init int32 sourceUse;
    init int32 selectorIndex;
    init bool terminated;
    int32 expressionStatus = NormalizeStandaloneSourceExpression(
        bodyId, expressionId, statementKind == 1 ? 0 : 1,
        ref init selectorKind,
        ref init sourceUse, ref init selectorIndex,
        ref init terminated);
    if (expressionStatus != 0)
    {
        return expressionStatus;
    }
    if (terminated)
    {
        *terminalKind = 1;
        return 0;
    }

    if (statementKind == 1)
    {
        int32 resultTypeId
            = Host.StandaloneSourceCallableInfo[bodyId * 12 + 4];
        if (IsStandaloneUnitType(resultTypeId))
        {
            if (selectorKind != 0 || sourceUse != 0
                || selectorIndex != 0)
            {
                return 3;
            }
            return AppendStandaloneNormalizedOperation(
                bodyId, 5, 0, 0, 0);
        }
        if (selectorKind != 2 || sourceUse != 1)
        {
            return 3;
        }
        int32 returnOperationFirst
            = Host.StandaloneNormalizedOperationCount[0];
        int32 returnStatus = AppendStandaloneNormalizedOperation(
            bodyId, 4, selectorIndex, 0, 0);
        if (returnStatus != 0)
        {
            return returnStatus;
        }
        int32 expressionGlobalId
            = Host.StandaloneSourceBodies[bodyId * 12 + 3]
                + expressionId;
        if (Host.StandaloneSourceExpressions[
                expressionGlobalId * 8] == 34
            || Host.StandaloneSourceExpressions[
                expressionGlobalId * 8] == 35
            || Host.StandaloneSourceExpressions[
                expressionGlobalId * 8] == 36)
        {
            int32 bodyBlockFirst
                = Host.StandaloneNormalizedBodyBlockRanges[
                    bodyId * 2];
            int32 bodyBlockCount
                = Host.StandaloneNormalizedBlockCount[0]
                    - bodyBlockFirst;
            int32 returnOperationCount
                = Host.StandaloneNormalizedOperationCount[0]
                    - returnOperationFirst;
            if (bodyBlockCount < 3 || returnOperationCount != 1)
            {
                return 3;
            }
            init int32 returnBlockIndex;
            return AppendStandaloneNormalizedReturnBlock(
                bodyId, bodyBlockCount, returnOperationFirst,
                returnOperationCount, 0,
                ref init returnBlockIndex);
        }
        return 0;
    }
    if (statementKind == 2)
    {
        int32 expressionOffset
            = (Host.StandaloneSourceBodies[bodyId * 12 + 3]
                + expressionId) * 8;
        int32 expressionTypeId
            = Host.StandaloneSourceExpressions[expressionOffset + 1];
        if (IsStandaloneUnitType(expressionTypeId))
        {
            return 0;
        }
        init bool expressionDoesNotReturn;
        if (TryGetStandaloneSourceExpressionDoesNotReturn(bodyId,
                expressionId, ref init expressionDoesNotReturn) != 0
            || !expressionDoesNotReturn)
        {
            return 3;
        }
        return 0;
    }
    if (statementKind == 3)
    {
        return 0;
    }
    return 3;
}

int32 CountStandaloneSourceConditionalTree(int32 bodyId,
    int32 expressionId, int32 resultTypeId, int32 depth,
    ref<init int32> blockCountResult,
    ref<init int32> edgeCountResult,
    ref<init bool> hasNormalResult)
    ensure return == 0 ? (*blockCountResult is init
        && *edgeCountResult is init
        && *hasNormalResult is init) : true
{
    if (depth > 64 || bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || expressionId < 0
        || expressionId
            >= Host.StandaloneSourceBodies[bodyId * 12 + 4])
    {
        return 3;
    }

    int32 expressionOffset
        = (Host.StandaloneSourceBodies[bodyId * 12 + 3]
            + expressionId) * 8;
    int32 expressionKind
        = Host.StandaloneSourceExpressions[expressionOffset];
    int32 expressionTypeId
        = Host.StandaloneSourceExpressions[expressionOffset + 1];
    if (expressionTypeId != resultTypeId)
    {
        return 3;
    }
    if (expressionKind != 34)
    {
        if (expressionKind == 35 || expressionKind == 36
            || GetStandaloneSourceUse(expressionTypeId) != 1)
        {
            return 2;
        }
        init bool expressionDoesNotReturn;
        int32 doesNotReturnStatus
            = TryGetStandaloneSourceExpressionDoesNotReturn(
                bodyId, expressionId,
                ref init expressionDoesNotReturn);
        if (doesNotReturnStatus != 0)
        {
            return doesNotReturnStatus;
        }
        *blockCountResult = 1;
        *edgeCountResult = 0;
        *hasNormalResult = !expressionDoesNotReturn;
        return 0;
    }

    int32 conditionExpressionId
        = Host.StandaloneSourceExpressions[expressionOffset + 2];
    int32 trueExpressionId
        = Host.StandaloneSourceExpressions[expressionOffset + 3];
    int32 falseExpressionId
        = Host.StandaloneSourceExpressions[expressionOffset + 4];
    if (conditionExpressionId < 0
        || conditionExpressionId >= expressionId
        || trueExpressionId < 0 || trueExpressionId >= expressionId
        || falseExpressionId < 0 || falseExpressionId >= expressionId)
    {
        return 3;
    }

    int32 bodyExpressionFirst
        = Host.StandaloneSourceBodies[bodyId * 12 + 3];
    int32 conditionOffset
        = (bodyExpressionFirst + conditionExpressionId) * 8;
    int32 conditionKind
        = Host.StandaloneSourceExpressions[conditionOffset];
    int32 conditionTypeId
        = Host.StandaloneSourceExpressions[conditionOffset + 1];
    if (!IsStandaloneLogicalNotType(conditionTypeId))
    {
        return 2;
    }
    if (conditionKind == 35 || conditionKind == 36)
    {
        init int32 conditionLeafCount;
        init bool homogeneous;
        int32 conditionStatus = CountStandaloneSourceLazyBooleanTree(
            bodyId, conditionExpressionId, conditionKind, depth + 1,
            ref init conditionLeafCount, ref init homogeneous);
        if (conditionStatus != 0)
        {
            return conditionStatus;
        }

        init int32 trueBlockCount;
        init int32 trueEdgeCount;
        init bool trueHasNormal;
        int32 trueStatus = CountStandaloneSourceConditionalTree(
            bodyId, trueExpressionId, resultTypeId, depth + 1,
            ref init trueBlockCount, ref init trueEdgeCount,
            ref init trueHasNormal);
        if (trueStatus != 0)
        {
            return trueStatus;
        }
        init int32 falseBlockCount;
        init int32 falseEdgeCount;
        init bool falseHasNormal;
        int32 falseStatus = CountStandaloneSourceConditionalTree(
            bodyId, falseExpressionId, resultTypeId, depth + 1,
            ref init falseBlockCount, ref init falseEdgeCount,
            ref init falseHasNormal);
        if (falseStatus != 0)
        {
            return falseStatus;
        }
        if (trueBlockCount > int32.MaxValue - falseBlockCount
            || trueBlockCount + falseBlockCount
                > int32.MaxValue - conditionLeafCount
            || trueEdgeCount > int32.MaxValue - falseEdgeCount
            || trueEdgeCount + falseEdgeCount
                > int32.MaxValue - conditionLeafCount)
        {
            return 3;
        }

        *blockCountResult
            = conditionLeafCount + trueBlockCount + falseBlockCount;
        *edgeCountResult
            = conditionLeafCount + trueEdgeCount + falseEdgeCount;
        *hasNormalResult = trueHasNormal || falseHasNormal;
        return 0;
    }
    if (conditionKind == 34)
    {
        return 2;
    }
    init bool conditionDoesNotReturn;
    int32 conditionDoesNotReturnStatus
        = TryGetStandaloneSourceExpressionDoesNotReturn(
            bodyId, conditionExpressionId,
            ref init conditionDoesNotReturn);
    if (conditionDoesNotReturnStatus != 0
        || conditionDoesNotReturn)
    {
        return conditionDoesNotReturnStatus != 0
            ? conditionDoesNotReturnStatus : 2;
    }

    init int32 trueBlockCount;
    init int32 trueEdgeCount;
    init bool trueHasNormal;
    int32 trueStatus = CountStandaloneSourceConditionalTree(
        bodyId, trueExpressionId, resultTypeId, depth + 1,
        ref init trueBlockCount, ref init trueEdgeCount,
        ref init trueHasNormal);
    if (trueStatus != 0)
    {
        return trueStatus;
    }
    init int32 falseBlockCount;
    init int32 falseEdgeCount;
    init bool falseHasNormal;
    int32 falseStatus = CountStandaloneSourceConditionalTree(
        bodyId, falseExpressionId, resultTypeId, depth + 1,
        ref init falseBlockCount, ref init falseEdgeCount,
        ref init falseHasNormal);
    if (falseStatus != 0)
    {
        return falseStatus;
    }
    if (trueBlockCount > int32.MaxValue - falseBlockCount - 1
        || trueEdgeCount > int32.MaxValue - falseEdgeCount - 1)
    {
        return 3;
    }

    *blockCountResult = 1 + trueBlockCount + falseBlockCount;
    *edgeCountResult = 1 + trueEdgeCount + falseEdgeCount;
    *hasNormalResult = trueHasNormal || falseHasNormal;
    return 0;
}

int32 SetStandaloneNormalizedConditionalTargets(int32 bodyId,
    int32 blockIndex, int32 trueTarget, int32 falseTarget)
{
    if (blockIndex < 0
        || blockIndex >= Host.StandaloneNormalizedBlockCount[0]
        || trueTarget < 0 || trueTarget > 0xFFFF
        || falseTarget < 0 || falseTarget > 0xFFFF)
    {
        return 3;
    }

    int32 offset = blockIndex * 16;
    if (Host.StandaloneNormalizedBlocks[offset] != bodyId
        || Host.StandaloneNormalizedBlocks[offset + 4] != 4
        || Host.StandaloneNormalizedBlocks[offset + 8] != -1
        || Host.StandaloneNormalizedBlocks[offset + 9] != -1)
    {
        return 3;
    }
    Host.StandaloneNormalizedBlocks[offset + 8] = trueTarget;
    Host.StandaloneNormalizedBlocks[offset + 9] = falseTarget;
    return 0;
}

int32 NormalizeStandaloneSourceConditionalTree(int32 bodyId,
    int32 expressionId, int32 resultTypeId, int32 resultHomeId,
    int32 finalBodyBlockCount, int32 returnBlockId, int32 depth,
    int32 blockOrdinal, int32 edgeOrdinal,
    ref<init int32> entryBlockIdResult,
    ref<init int32> nextBlockOrdinalResult,
    ref<init int32> nextEdgeOrdinalResult,
    ref<init bool> hasNormalResult)
    ensure return == 0 ? (*entryBlockIdResult is init
        && *nextBlockOrdinalResult is init
        && *nextEdgeOrdinalResult is init
        && *hasNormalResult is init) : true
{
    if (depth > 64 || bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || expressionId < 0
        || expressionId
            >= Host.StandaloneSourceBodies[bodyId * 12 + 4]
        || finalBodyBlockCount <= 0
        || finalBodyBlockCount > 0x1_0000
        || blockOrdinal < 0
        || blockOrdinal >= finalBodyBlockCount
        || edgeOrdinal < 0
        || edgeOrdinal
            > 0x1_0000 - finalBodyBlockCount)
    {
        return 3;
    }

    int32 expressionOffset
        = (Host.StandaloneSourceBodies[bodyId * 12 + 3]
            + expressionId) * 8;
    int32 expressionKind
        = Host.StandaloneSourceExpressions[expressionOffset];
    int32 expressionTypeId
        = Host.StandaloneSourceExpressions[expressionOffset + 1];
    if (expressionTypeId != resultTypeId)
    {
        return 3;
    }

    if (expressionKind == 34)
    {
        int32 conditionExpressionId
            = Host.StandaloneSourceExpressions[expressionOffset + 2];
        int32 trueExpressionId
            = Host.StandaloneSourceExpressions[expressionOffset + 3];
        int32 falseExpressionId
            = Host.StandaloneSourceExpressions[expressionOffset + 4];
        if (conditionExpressionId < 0
            || conditionExpressionId >= expressionId
            || trueExpressionId < 0 || trueExpressionId >= expressionId
            || falseExpressionId < 0 || falseExpressionId >= expressionId)
        {
            return 3;
        }

        int32 bodyExpressionFirst
            = Host.StandaloneSourceBodies[bodyId * 12 + 3];
        int32 conditionOffset
            = (bodyExpressionFirst + conditionExpressionId) * 8;
        int32 conditionKind
            = Host.StandaloneSourceExpressions[conditionOffset];
        int32 conditionTypeId
            = Host.StandaloneSourceExpressions[conditionOffset + 1];
        if (!IsStandaloneLogicalNotType(conditionTypeId)
            || conditionKind == 34)
        {
            return 2;
        }

        if (conditionKind == 35 || conditionKind == 36)
        {
            init int32 conditionLeafCount;
            init bool homogeneous;
            int32 conditionStatus
                = CountStandaloneSourceLazyBooleanTree(
                    bodyId, conditionExpressionId, conditionKind,
                    depth + 1,
                    ref init conditionLeafCount,
                    ref init homogeneous);
            if (conditionStatus != 0)
            {
                return conditionStatus;
            }
            init int32 trueBlockCount;
            init int32 trueEdgeCount;
            init bool trueHasNormal;
            int32 trueCountStatus
                = CountStandaloneSourceConditionalTree(
                    bodyId, trueExpressionId, resultTypeId,
                    depth + 1, ref init trueBlockCount,
                    ref init trueEdgeCount,
                    ref init trueHasNormal);
            if (trueCountStatus != 0)
            {
                return trueCountStatus;
            }
            init int32 falseBlockCount;
            init int32 falseEdgeCount;
            init bool falseHasNormal;
            int32 falseCountStatus
                = CountStandaloneSourceConditionalTree(
                    bodyId, falseExpressionId, resultTypeId,
                    depth + 1, ref init falseBlockCount,
                    ref init falseEdgeCount,
                    ref init falseHasNormal);
            if (falseCountStatus != 0)
            {
                return falseCountStatus;
            }
            if (conditionLeafCount < 2
                || trueBlockCount <= 0 || falseBlockCount <= 0
                || trueBlockCount
                    > int32.MaxValue - falseBlockCount
                || trueBlockCount + falseBlockCount
                    > int32.MaxValue - conditionLeafCount
                || trueEdgeCount
                    > int32.MaxValue - falseEdgeCount
                || trueEdgeCount + falseEdgeCount
                    > int32.MaxValue - conditionLeafCount)
            {
                return 3;
            }

            int32 subtreeBlockCount = conditionLeafCount
                + trueBlockCount + falseBlockCount;
            int32 subtreeEdgeCount = conditionLeafCount
                + trueEdgeCount + falseEdgeCount;
            int32 availableEdgeCount
                = 0x1_0000 - finalBodyBlockCount;
            if (subtreeBlockCount > finalBodyBlockCount
                || blockOrdinal
                    > finalBodyBlockCount - subtreeBlockCount
                || subtreeEdgeCount > availableEdgeCount
                || edgeOrdinal
                    > availableEdgeCount - subtreeEdgeCount)
            {
                return 3;
            }

            int32 trueTarget = blockOrdinal + conditionLeafCount;
            int32 falseTarget = trueTarget + trueBlockCount;
            if (trueTarget > 0xFFFF || falseTarget > 0xFFFF)
            {
                return 3;
            }
            init int32 afterDecisionBlock;
            init int32 afterDecisionEdge;
            int32 decisionStatus
                = NormalizeStandaloneSourceLazyBooleanDecision(
                    bodyId, conditionExpressionId, conditionTypeId,
                    trueTarget, falseTarget, conditionLeafCount,
                    finalBodyBlockCount, depth + 1,
                    blockOrdinal, edgeOrdinal,
                    ref init afterDecisionBlock,
                    ref init afterDecisionEdge);
            if (decisionStatus != 0)
            {
                return decisionStatus;
            }
            if (afterDecisionBlock
                    != blockOrdinal + conditionLeafCount
                || afterDecisionEdge
                    != edgeOrdinal + conditionLeafCount)
            {
                return 3;
            }

            init int32 trueEntryBlock;
            init int32 afterTrueBlock;
            init int32 afterTrueEdge;
            init bool actualTrueHasNormal;
            int32 trueStatus = NormalizeStandaloneSourceConditionalTree(
                bodyId, trueExpressionId, resultTypeId, resultHomeId,
                finalBodyBlockCount, returnBlockId, depth + 1,
                afterDecisionBlock, afterDecisionEdge,
                ref init trueEntryBlock, ref init afterTrueBlock,
                ref init afterTrueEdge,
                ref init actualTrueHasNormal);
            if (trueStatus != 0)
            {
                return trueStatus;
            }
            init int32 falseEntryBlock;
            init int32 afterFalseBlock;
            init int32 afterFalseEdge;
            init bool actualFalseHasNormal;
            int32 falseStatus = NormalizeStandaloneSourceConditionalTree(
                bodyId, falseExpressionId, resultTypeId, resultHomeId,
                finalBodyBlockCount, returnBlockId, depth + 1,
                afterTrueBlock, afterTrueEdge,
                ref init falseEntryBlock, ref init afterFalseBlock,
                ref init afterFalseEdge,
                ref init actualFalseHasNormal);
            if (falseStatus != 0)
            {
                return falseStatus;
            }
            if (trueEntryBlock != trueTarget
                || falseEntryBlock != falseTarget
                || afterFalseBlock
                    != blockOrdinal + subtreeBlockCount
                || afterFalseEdge
                    != edgeOrdinal + subtreeEdgeCount
                || actualTrueHasNormal != trueHasNormal
                || actualFalseHasNormal != falseHasNormal
                || (actualTrueHasNormal || actualFalseHasNormal)
                    != (trueHasNormal || falseHasNormal))
            {
                return 3;
            }

            *entryBlockIdResult = blockOrdinal;
            *nextBlockOrdinalResult = afterFalseBlock;
            *nextEdgeOrdinalResult = afterFalseEdge;
            *hasNormalResult = trueHasNormal || falseHasNormal;
            return 0;
        }

        int32 operationFirst = blockOrdinal == 0
            ? Host.StandaloneNormalizedBodies[bodyId * 12 + 9]
            : Host.StandaloneNormalizedOperationCount[0];
        init int32 conditionSelectorKind;
        init int32 conditionSourceUse;
        init int32 conditionSelectorIndex;
        init bool conditionTerminated;
        int32 conditionStatus = NormalizeStandaloneSourceExpression(
            bodyId, conditionExpressionId, depth + 1,
            ref init conditionSelectorKind,
            ref init conditionSourceUse,
            ref init conditionSelectorIndex,
            ref init conditionTerminated);
        if (conditionStatus != 0)
        {
            return conditionStatus;
        }
        if (conditionTerminated || conditionSelectorKind != 2
            || conditionSourceUse != 1
            || conditionSelectorIndex < 0)
        {
            return 2;
        }

        int32 operationCount
            = Host.StandaloneNormalizedOperationCount[0]
                - operationFirst;
        if (edgeOrdinal > 0xFFFF - finalBodyBlockCount)
        {
            return 3;
        }
        init int32 branchBlockIndex;
        int32 branchStatus = AppendStandaloneNormalizedBlock(
            bodyId, blockOrdinal, operationFirst, operationCount,
            4, 0, 0, 0, -1, -1, 2, conditionSelectorIndex,
            conditionTypeId, finalBodyBlockCount + edgeOrdinal,
            -1, 0, ref init branchBlockIndex);
        if (branchStatus != 0)
        {
            return branchStatus;
        }

        init int32 trueEntryBlock;
        init int32 afterTrueBlock;
        init int32 afterTrueEdge;
        init bool trueHasNormal;
        int32 trueStatus = NormalizeStandaloneSourceConditionalTree(
            bodyId, trueExpressionId, resultTypeId, resultHomeId,
            finalBodyBlockCount, returnBlockId, depth + 1,
            blockOrdinal + 1, edgeOrdinal + 1,
            ref init trueEntryBlock, ref init afterTrueBlock,
            ref init afterTrueEdge, ref init trueHasNormal);
        if (trueStatus != 0)
        {
            return trueStatus;
        }
        init int32 falseEntryBlock;
        init int32 afterFalseBlock;
        init int32 afterFalseEdge;
        init bool falseHasNormal;
        int32 falseStatus = NormalizeStandaloneSourceConditionalTree(
            bodyId, falseExpressionId, resultTypeId, resultHomeId,
            finalBodyBlockCount, returnBlockId, depth + 1,
            afterTrueBlock, afterTrueEdge,
            ref init falseEntryBlock, ref init afterFalseBlock,
            ref init afterFalseEdge, ref init falseHasNormal);
        if (falseStatus != 0)
        {
            return falseStatus;
        }
        int32 patchStatus = SetStandaloneNormalizedConditionalTargets(
            bodyId, branchBlockIndex, trueEntryBlock, falseEntryBlock);
        if (patchStatus != 0)
        {
            return patchStatus;
        }

        *entryBlockIdResult = blockOrdinal;
        *nextBlockOrdinalResult = afterFalseBlock;
        *nextEdgeOrdinalResult = afterFalseEdge;
        *hasNormalResult = trueHasNormal || falseHasNormal;
        return 0;
    }

    if (expressionKind == 35 || expressionKind == 36
        || GetStandaloneSourceUse(expressionTypeId) != 1)
    {
        return 2;
    }
    int32 operationFirst
        = Host.StandaloneNormalizedOperationCount[0];
    init int32 selectorKind;
    init int32 sourceUse;
    init int32 selectorIndex;
    init bool terminated;
    int32 expressionStatus = NormalizeStandaloneSourceExpression(
        bodyId, expressionId, depth + 1,
        ref init selectorKind, ref init sourceUse,
        ref init selectorIndex, ref init terminated);
    if (expressionStatus != 0)
    {
        return expressionStatus;
    }
    int32 operationCount
        = Host.StandaloneNormalizedOperationCount[0] - operationFirst;
    if (terminated)
    {
        init int32 noReturnBlockIndex;
        int32 noReturnStatus = AppendStandaloneNormalizedReturnBlock(
            bodyId, blockOrdinal, operationFirst,
            operationCount, 1, ref init noReturnBlockIndex);
        if (noReturnStatus != 0)
        {
            return noReturnStatus;
        }
        *entryBlockIdResult = blockOrdinal;
        *nextBlockOrdinalResult = blockOrdinal + 1;
        *nextEdgeOrdinalResult = edgeOrdinal;
        *hasNormalResult = false;
        return 0;
    }
    if (selectorKind != 2 || sourceUse != 1
        || selectorIndex < 0 || returnBlockId < 0)
    {
        return 2;
    }

    int32 copyStatus = AppendStandaloneNormalizedOperation(
        bodyId, 38, selectorIndex, resultHomeId, 0);
    if (copyStatus != 0)
    {
        return copyStatus;
    }
    operationCount
        = Host.StandaloneNormalizedOperationCount[0] - operationFirst;
    init int32 valueBlockIndex;
    int32 valueBlockStatus = AppendStandaloneNormalizedBlock(
        bodyId, blockOrdinal, operationFirst, operationCount,
        3, 0, 0, 0, returnBlockId, -1, 0, 0, 0, -1, -1, 0,
        ref init valueBlockIndex);
    if (valueBlockStatus != 0)
    {
        return valueBlockStatus;
    }
    *entryBlockIdResult = blockOrdinal;
    *nextBlockOrdinalResult = blockOrdinal + 1;
    *nextEdgeOrdinalResult = edgeOrdinal;
    *hasNormalResult = true;
    return 0;
}

int32 NormalizeStandaloneSourceConditionalValue(int32 bodyId,
    int32 expressionId, int32 depth,
    ref<init int32> selectorKindResult,
    ref<init int32> sourceUseResult,
    ref<init int32> selectorIndexResult,
    ref<init bool> terminatedResult)
    ensure return == 0 ? (*selectorKindResult is init
        && *sourceUseResult is init
        && *selectorIndexResult is init
        && *terminatedResult is init) : true
{
    if (bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || expressionId < 0
        || expressionId
            >= Host.StandaloneSourceBodies[bodyId * 12 + 4])
    {
        return 2;
    }
    int32 expressionOffset
        = (Host.StandaloneSourceBodies[bodyId * 12 + 3]
            + expressionId) * 8;
    int32 resultTypeId
        = Host.StandaloneSourceExpressions[expressionOffset + 1];
    int32 conditionExpressionId
        = Host.StandaloneSourceExpressions[expressionOffset + 2];
    int32 trueExpressionId
        = Host.StandaloneSourceExpressions[expressionOffset + 3];
    int32 falseExpressionId
        = Host.StandaloneSourceExpressions[expressionOffset + 4];
    int32 bodyBlockFirst
        = Host.StandaloneNormalizedBodyBlockRanges[bodyId * 2];
    if (Host.StandaloneSourceExpressions[expressionOffset] != 34
        || bodyBlockFirst < 0
        || Host.StandaloneNormalizedBlockCount[0] != bodyBlockFirst
        || GetStandaloneSourceUse(resultTypeId) != 1
        || conditionExpressionId < 0
        || conditionExpressionId >= expressionId
        || trueExpressionId < 0
        || trueExpressionId >= expressionId
        || falseExpressionId < 0
        || falseExpressionId >= expressionId)
    {
        return 2;
    }

    int32 conditionFirst
        = Host.StandaloneSourceBodies[bodyId * 12 + 3];
    int32 conditionTypeId
        = Host.StandaloneSourceExpressions[
            (conditionFirst + conditionExpressionId) * 8 + 1];
    if (!IsStandaloneLogicalNotType(conditionTypeId))
    {
        return 3;
    }
    int32 conditionExpressionKind
        = Host.StandaloneSourceExpressions[
            (conditionFirst + conditionExpressionId) * 8];
    int32 trueExpressionKind
        = Host.StandaloneSourceExpressions[
            (conditionFirst + trueExpressionId) * 8];
    int32 falseExpressionKind
        = Host.StandaloneSourceExpressions[
            (conditionFirst + falseExpressionId) * 8];
    if (conditionExpressionKind == 35
        || conditionExpressionKind == 36
        || trueExpressionKind == 34 || falseExpressionKind == 34)
    {
        init int32 expressionBlockCount;
        init int32 conditionalEdgeCount;
        init bool hasNormalArm;
        int32 treeStatus = CountStandaloneSourceConditionalTree(
            bodyId, expressionId, resultTypeId, 0,
            ref init expressionBlockCount,
            ref init conditionalEdgeCount,
            ref init hasNormalArm);
        if (treeStatus != 0)
        {
            return treeStatus;
        }
        if (expressionBlockCount <= 0
            || expressionBlockCount
                > 0x1_0000 - (hasNormalArm ? 1 : 0))
        {
            return 3;
        }
        int32 finalBodyBlockCount
            = expressionBlockCount + (hasNormalArm ? 1 : 0);
        if (finalBodyBlockCount > 0x1_0000
            || conditionalEdgeCount < 1
            || conditionalEdgeCount
                > 0x1_0000 - finalBodyBlockCount)
        {
            return 3;
        }

        int32 homeFirst
            = Host.StandaloneNormalizedBodies[bodyId * 12 + 1];
        init int32 resultHomeId;
        int32 resultHomeStatus = AppendStandaloneNormalizedHome(
            bodyId, homeFirst, 3, resultTypeId, 0,
            ref init resultHomeId);
        if (resultHomeStatus != 0)
        {
            return resultHomeStatus;
        }
        int32 returnBlockId
            = hasNormalArm ? expressionBlockCount : -1;
        init int32 entryBlockId;
        init int32 nextBlockOrdinal;
        init int32 nextEdgeOrdinal;
        init bool actualHasNormalArm;
        int32 normalizeTreeStatus
            = NormalizeStandaloneSourceConditionalTree(
                bodyId, expressionId, resultTypeId, resultHomeId,
                finalBodyBlockCount, returnBlockId, 0, 0, 0,
                ref init entryBlockId,
                ref init nextBlockOrdinal,
                ref init nextEdgeOrdinal,
                ref init actualHasNormalArm);
        if (normalizeTreeStatus != 0)
        {
            return normalizeTreeStatus;
        }
        if (entryBlockId != 0
            || nextBlockOrdinal != expressionBlockCount
            || nextEdgeOrdinal != conditionalEdgeCount
            || actualHasNormalArm != hasNormalArm
            || Host.StandaloneNormalizedBlockCount[0]
                - bodyBlockFirst != expressionBlockCount)
        {
            return 3;
        }

        if (hasNormalArm)
        {
            *selectorKindResult = 2;
            *sourceUseResult = 1;
            *selectorIndexResult = resultHomeId;
            *terminatedResult = false;
        }
        else
        {
            *selectorKindResult = 0;
            *sourceUseResult = 0;
            *selectorIndexResult = 0;
            *terminatedResult = true;
        }
        return 0;
    }

    init int32 conditionSelectorKind;
    init int32 conditionSourceUse;
    init int32 conditionSelectorIndex;
    init bool conditionTerminated;
    int32 conditionStatus = NormalizeStandaloneSourceExpression(
        bodyId, conditionExpressionId, depth + 1,
        ref init conditionSelectorKind,
        ref init conditionSourceUse,
        ref init conditionSelectorIndex,
        ref init conditionTerminated);
    if (conditionStatus != 0)
    {
        return conditionStatus;
    }
    if (conditionTerminated || conditionSelectorKind != 2
        || conditionSourceUse != 1 || conditionSelectorIndex < 0)
    {
        return 2;
    }

    int32 homeFirst
        = Host.StandaloneNormalizedBodies[bodyId * 12 + 1];
    int32 operationFirst
        = Host.StandaloneNormalizedBodies[bodyId * 12 + 9];
    int32 conditionOperationCount
        = Host.StandaloneNormalizedOperationCount[0]
            - operationFirst;
    if (conditionOperationCount < 0)
    {
        return 3;
    }
    init int32 resultHomeId;
    int32 resultHomeStatus = AppendStandaloneNormalizedHome(
        bodyId, homeFirst, 3, resultTypeId, 0,
        ref init resultHomeId);
    if (resultHomeStatus != 0)
    {
        return resultHomeStatus;
    }
    init int32 conditionBlockIndex;
    int32 conditionBlockStatus
        = AppendStandaloneNormalizedBlock(
            bodyId, 0, operationFirst, conditionOperationCount,
            4, 0, 0, 0, 1, 2, 2, conditionSelectorIndex,
            conditionTypeId, 4, -1, 0,
            ref init conditionBlockIndex);
    if (conditionBlockStatus != 0)
    {
        return conditionBlockStatus;
    }

    for (mut int32 branchIndex = 0;
        branchIndex < 2;
        branchIndex = branchIndex + 1)
    {
        int32 branchExpressionId = branchIndex == 0
            ? trueExpressionId : falseExpressionId;
        int32 branchOperationFirst
            = Host.StandaloneNormalizedOperationCount[0];
        init int32 branchSelectorKind;
        init int32 branchSourceUse;
        init int32 branchSelectorIndex;
        init bool branchTerminated;
        int32 branchStatus = NormalizeStandaloneSourceExpression(
            bodyId, branchExpressionId, depth + 1,
            ref init branchSelectorKind, ref init branchSourceUse,
            ref init branchSelectorIndex,
            ref init branchTerminated);
        if (branchStatus != 0)
        {
            return branchStatus;
        }
        if (branchTerminated)
        {
            int32 branchOperationCount
                = Host.StandaloneNormalizedOperationCount[0]
                    - branchOperationFirst;
            init int32 noReturnBlockIndex;
            int32 noReturnBlockStatus
                = AppendStandaloneNormalizedReturnBlock(
                    bodyId, branchIndex + 1, branchOperationFirst,
                    branchOperationCount, 1,
                    ref init noReturnBlockIndex);
            if (noReturnBlockStatus != 0)
            {
                return noReturnBlockStatus;
            }
            continue;
        }
        if (branchSelectorKind != 2 || branchSourceUse != 1
            || branchSelectorIndex < 0)
        {
            return 2;
        }
        hasNormalArm = true;
        int32 copyStatus = AppendStandaloneNormalizedOperation(
            bodyId, 38, branchSelectorIndex, resultHomeId, 0);
        if (copyStatus != 0)
        {
            return copyStatus;
        }
        int32 branchOperationCount
            = Host.StandaloneNormalizedOperationCount[0]
                - branchOperationFirst;
        init int32 branchBlockIndex;
        int32 branchBlockStatus
            = AppendStandaloneNormalizedBlock(
                bodyId, branchIndex + 1, branchOperationFirst,
                branchOperationCount, 3, 0, 0, 0, 3, -1,
                0, 0, 0, -1, -1, 0,
                ref init branchBlockIndex);
        if (branchBlockStatus != 0)
        {
            return branchBlockStatus;
        }
    }

    if (!hasNormalArm)
    {
        *selectorKindResult = 0;
        *sourceUseResult = 0;
        *selectorIndexResult = 0;
        *terminatedResult = true;
        return 0;
    }
    *selectorKindResult = 2;
    *sourceUseResult = 1;
    *selectorIndexResult = resultHomeId;
    *terminatedResult = false;
    return 0;
}

int32 CountStandaloneSourceLazyBooleanOperands(int32 bodyId,
    int32 expressionId, int32 expressionKind, int32 depth,
    ref<init int32> operandCountResult,
    ref<init int32> lastOperandIdResult)
    ensure return == 0 ? (*operandCountResult is init
        && *lastOperandIdResult is init) : true
{
    if (depth > 64 || bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || expressionId < 0
        || expressionId
            >= Host.StandaloneSourceBodies[bodyId * 12 + 4]
        || (expressionKind != 35 && expressionKind != 36))
    {
        return 3;
    }

    int32 expressionOffset
        = (Host.StandaloneSourceBodies[bodyId * 12 + 3]
            + expressionId) * 8;
    if (Host.StandaloneSourceExpressions[expressionOffset]
        != expressionKind)
    {
        *operandCountResult = 1;
        *lastOperandIdResult = expressionId;
        return 0;
    }

    int32 leftExpressionId
        = Host.StandaloneSourceExpressions[expressionOffset + 2];
    int32 rightExpressionId
        = Host.StandaloneSourceExpressions[expressionOffset + 3];
    if (leftExpressionId < 0 || leftExpressionId >= expressionId
        || rightExpressionId < 0 || rightExpressionId >= expressionId)
    {
        return 3;
    }

    init int32 leftOperandCount;
    init int32 leftLastOperandId;
    int32 leftStatus = CountStandaloneSourceLazyBooleanOperands(
        bodyId, leftExpressionId, expressionKind, depth + 1,
        ref init leftOperandCount, ref init leftLastOperandId);
    if (leftStatus != 0)
    {
        return leftStatus;
    }
    init int32 rightOperandCount;
    init int32 rightLastOperandId;
    int32 rightStatus = CountStandaloneSourceLazyBooleanOperands(
        bodyId, rightExpressionId, expressionKind, depth + 1,
        ref init rightOperandCount, ref init rightLastOperandId);
    if (rightStatus != 0)
    {
        return rightStatus;
    }
    if (leftOperandCount > 32767 - rightOperandCount)
    {
        return 3;
    }

    *operandCountResult = leftOperandCount + rightOperandCount;
    *lastOperandIdResult = rightLastOperandId;
    return 0;
}

int32 CountStandaloneSourceLazyBooleanTree(int32 bodyId,
    int32 expressionId, int32 rootKind, int32 depth,
    ref<init int32> leafCountResult,
    ref<init bool> homogeneousResult)
    ensure return == 0 ? (*leafCountResult is init
        && *homogeneousResult is init) : true
{
    if (depth > 64 || bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || expressionId < 0
        || expressionId
            >= Host.StandaloneSourceBodies[bodyId * 12 + 4]
        || (rootKind != 35 && rootKind != 36))
    {
        return 3;
    }

    int32 expressionFirst
        = Host.StandaloneSourceBodies[bodyId * 12 + 3];
    int32 globalExpressionId = expressionFirst + expressionId;
    if (globalExpressionId < expressionFirst
        || globalExpressionId
            >= Host.StandaloneSourceExpressionCount[0]
        || globalExpressionId
            >= Host.StandaloneLazyBooleanLeafCounts.Length)
    {
        return 3;
    }
    int32 expressionOffset = globalExpressionId * 8;
    int32 expressionKind
        = Host.StandaloneSourceExpressions[expressionOffset];
    int32 typeId
        = Host.StandaloneSourceExpressions[expressionOffset + 1];
    if (!IsStandaloneLogicalNotType(typeId))
    {
        return 3;
    }
    if (expressionKind != 35 && expressionKind != 36)
    {
        if (expressionKind == 34)
        {
            return 2;
        }
        Host.StandaloneLazyBooleanLeafCounts[
            globalExpressionId] = 1;
        *leafCountResult = 1;
        *homogeneousResult = true;
        return 0;
    }

    int32 leftExpressionId
        = Host.StandaloneSourceExpressions[expressionOffset + 2];
    int32 rightExpressionId
        = Host.StandaloneSourceExpressions[expressionOffset + 3];
    if (leftExpressionId < 0 || leftExpressionId >= expressionId
        || rightExpressionId < 0 || rightExpressionId >= expressionId
        || leftExpressionId == rightExpressionId)
    {
        return 3;
    }
    init int32 leftLeafCount;
    init bool leftHomogeneous;
    int32 leftStatus = CountStandaloneSourceLazyBooleanTree(
        bodyId, leftExpressionId, rootKind, depth + 1,
        ref init leftLeafCount, ref init leftHomogeneous);
    if (leftStatus != 0)
    {
        return leftStatus;
    }
    init int32 rightLeafCount;
    init bool rightHomogeneous;
    int32 rightStatus = CountStandaloneSourceLazyBooleanTree(
        bodyId, rightExpressionId, rootKind, depth + 1,
        ref init rightLeafCount, ref init rightHomogeneous);
    if (rightStatus != 0)
    {
        return rightStatus;
    }
    if (leftLeafCount <= 0
        || leftLeafCount > 32767 - rightLeafCount)
    {
        return 3;
    }

    int32 leafCount = leftLeafCount + rightLeafCount;
    Host.StandaloneLazyBooleanLeafCounts[globalExpressionId]
        = leafCount;
    *leafCountResult = leafCount;
    *homogeneousResult = expressionKind == rootKind
        && leftHomogeneous && rightHomogeneous;
    return 0;
}

int32 NormalizeStandaloneSourceLazyBooleanConditions(int32 bodyId,
    int32 expressionId, int32 expressionKind, int32 operandCount,
    int32 lastOperandId, int32 boolTypeId,
    int32 finalBodyBlockCount, int32 shortCircuitBlockId,
    int32 rightValueBlockId, int32 depth, int32 operandOrdinal,
    ref<init int32> nextOperandOrdinalResult)
    ensure return == 0 ? *nextOperandOrdinalResult is init : true
{
    if (depth > 64 || bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || expressionId < 0
        || expressionId
            >= Host.StandaloneSourceBodies[bodyId * 12 + 4])
    {
        return 3;
    }

    int32 expressionOffset
        = (Host.StandaloneSourceBodies[bodyId * 12 + 3]
            + expressionId) * 8;
    int32 currentKind
        = Host.StandaloneSourceExpressions[expressionOffset];
    if (currentKind == expressionKind)
    {
        if (Host.StandaloneSourceExpressions[
                expressionOffset + 1] != boolTypeId)
        {
            return 3;
        }
        int32 leftExpressionId
            = Host.StandaloneSourceExpressions[expressionOffset + 2];
        int32 rightExpressionId
            = Host.StandaloneSourceExpressions[expressionOffset + 3];
        if (leftExpressionId < 0 || leftExpressionId >= expressionId
            || rightExpressionId < 0 || rightExpressionId >= expressionId)
        {
            return 3;
        }

        init int32 afterLeftOrdinal;
        int32 leftStatus
            = NormalizeStandaloneSourceLazyBooleanConditions(
                bodyId, leftExpressionId, expressionKind, operandCount,
                lastOperandId, boolTypeId, finalBodyBlockCount,
                shortCircuitBlockId, rightValueBlockId, depth + 1,
                operandOrdinal, ref init afterLeftOrdinal);
        if (leftStatus != 0)
        {
            return leftStatus;
        }
        return NormalizeStandaloneSourceLazyBooleanConditions(
            bodyId, rightExpressionId, expressionKind, operandCount,
            lastOperandId, boolTypeId, finalBodyBlockCount,
            shortCircuitBlockId, rightValueBlockId, depth + 1,
            afterLeftOrdinal, ref init *nextOperandOrdinalResult);
    }

    if (expressionId == lastOperandId)
    {
        *nextOperandOrdinalResult = operandOrdinal;
        return 0;
    }
    if (operandOrdinal < 0 || operandOrdinal >= operandCount - 1
        || Host.StandaloneSourceExpressions[
            expressionOffset + 1] != boolTypeId)
    {
        return 3;
    }

    int32 operationFirst = operandOrdinal == 0
        ? Host.StandaloneNormalizedBodies[bodyId * 12 + 9]
        : Host.StandaloneNormalizedOperationCount[0];
    if (Host.StandaloneSourceExpressions[expressionOffset + 1]
        != boolTypeId)
    {
        return 3;
    }
    init int32 selectorKind;
    init int32 sourceUse;
    init int32 selectorIndex;
    init bool terminated;
    int32 expressionStatus = NormalizeStandaloneSourceExpression(
        bodyId, expressionId, depth + 1,
        ref init selectorKind, ref init sourceUse,
        ref init selectorIndex, ref init terminated);
    if (expressionStatus != 0)
    {
        return expressionStatus;
    }
    if (terminated || selectorKind != 2 || sourceUse != 1
        || selectorIndex < 0)
    {
        return 2;
    }

    int32 operationCount
        = Host.StandaloneNormalizedOperationCount[0] - operationFirst;
    int32 nextTarget = operandOrdinal + 1 < operandCount - 1
        ? operandOrdinal + 1 : rightValueBlockId;
    int32 trueTarget = expressionKind == 35
        ? nextTarget : shortCircuitBlockId;
    int32 falseTarget = expressionKind == 35
        ? shortCircuitBlockId : nextTarget;
    init int32 blockIndex;
    int32 blockStatus = AppendStandaloneNormalizedBlock(
        bodyId, operandOrdinal, operationFirst, operationCount,
        4, 0, 0, 0, trueTarget, falseTarget, 2, selectorIndex,
        boolTypeId, finalBodyBlockCount + operandOrdinal, -1, 0,
        ref init blockIndex);
    if (blockStatus != 0)
    {
        return blockStatus;
    }

    *nextOperandOrdinalResult = operandOrdinal + 1;
    return 0;
}

int32 AppendStandaloneNormalizedLazyBooleanConstantBlock(int32 bodyId,
    int32 boolTypeId, int32 constantFirst, int32 resultHomeId,
    int32 constantValue, int32 blockId, int32 returnBlockId)
{
    int32 operationFirst
        = Host.StandaloneNormalizedOperationCount[0];
    init int32 constantId;
    int32 constantStatus = AppendStandaloneNormalizedConstant(
        bodyId, constantFirst, boolTypeId, constantValue, 0,
        ref init constantId);
    if (constantStatus != 0)
    {
        return constantStatus;
    }
    int32 operationStatus = AppendStandaloneNormalizedOperation(
        bodyId, 1, constantId, 0, 0);
    if (operationStatus != 0)
    {
        return operationStatus;
    }
    operationStatus = AppendStandaloneNormalizedOperation(
        bodyId, 2, resultHomeId, 0, 0);
    if (operationStatus != 0)
    {
        return operationStatus;
    }
    int32 operationCount
        = Host.StandaloneNormalizedOperationCount[0] - operationFirst;
    init int32 blockIndex;
    return AppendStandaloneNormalizedBlock(
        bodyId, blockId, operationFirst, operationCount, 3,
        0, 0, 0, returnBlockId, -1, 0, 0, 0, -1, -1, 0,
        ref init blockIndex);
}

int32 NormalizeStandaloneSourceLazyBooleanDecision(int32 bodyId,
    int32 expressionId, int32 boolTypeId, int32 trueTarget,
    int32 falseTarget, int32 leafCount, int32 finalBodyBlockCount,
    int32 depth,
    int32 blockOrdinal, int32 edgeOrdinal,
    ref<init int32> nextBlockOrdinalResult,
    ref<init int32> nextEdgeOrdinalResult)
    ensure return == 0 ? (*nextBlockOrdinalResult is init
        && *nextEdgeOrdinalResult is init) : true
{
    if (depth > 64 || bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || expressionId < 0
        || expressionId
            >= Host.StandaloneSourceBodies[bodyId * 12 + 4]
        || trueTarget < 0 || trueTarget > 0xFFFF
        || falseTarget < 0 || falseTarget > 0xFFFF
        || leafCount < 1 || leafCount > 32767
        || finalBodyBlockCount <= 0
        || finalBodyBlockCount > 0x1_0000
        || blockOrdinal < 0
        || blockOrdinal >= finalBodyBlockCount
        || leafCount > finalBodyBlockCount - blockOrdinal
        || edgeOrdinal < 0
        || edgeOrdinal
            > 0x1_0000 - finalBodyBlockCount
        || leafCount
            > 0x1_0000 - finalBodyBlockCount - edgeOrdinal
        || trueTarget >= finalBodyBlockCount
        || falseTarget >= finalBodyBlockCount)
    {
        return 3;
    }

    int32 expressionFirst
        = Host.StandaloneSourceBodies[bodyId * 12 + 3];
    int32 expressionOffset
        = (expressionFirst + expressionId) * 8;
    int32 expressionKind
        = Host.StandaloneSourceExpressions[expressionOffset];
    int32 expressionTypeId
        = Host.StandaloneSourceExpressions[expressionOffset + 1];
    if (expressionTypeId != boolTypeId)
    {
        return 3;
    }
    if (expressionKind == 35 || expressionKind == 36)
    {
        int32 leftExpressionId
            = Host.StandaloneSourceExpressions[expressionOffset + 2];
        int32 rightExpressionId
            = Host.StandaloneSourceExpressions[expressionOffset + 3];
        int32 leftGlobalExpressionId
            = expressionFirst + leftExpressionId;
        if (leftExpressionId < 0
            || leftExpressionId >= expressionId
            || rightExpressionId < 0
            || rightExpressionId >= expressionId
            || leftExpressionId == rightExpressionId
            || leftGlobalExpressionId < expressionFirst
            || leftGlobalExpressionId
                >= Host.StandaloneLazyBooleanLeafCounts.Length)
        {
            return 3;
        }
        int32 leftLeafCount
            = Host.StandaloneLazyBooleanLeafCounts[
                leftGlobalExpressionId];
        int32 rightLeafCount = leafCount - leftLeafCount;
        int32 rightEntry = blockOrdinal + leftLeafCount;
        if (leftLeafCount <= 0 || rightLeafCount <= 0
            || rightEntry <= blockOrdinal
            || rightEntry >= blockOrdinal + leafCount)
        {
            return 3;
        }

        int32 leftTrueTarget = expressionKind == 35
            ? rightEntry : trueTarget;
        int32 leftFalseTarget = expressionKind == 35
            ? falseTarget : rightEntry;
        init int32 afterLeftBlock;
        init int32 afterLeftEdge;
        int32 leftStatus = NormalizeStandaloneSourceLazyBooleanDecision(
            bodyId, leftExpressionId, boolTypeId,
            leftTrueTarget, leftFalseTarget, leftLeafCount,
            finalBodyBlockCount,
            depth + 1, blockOrdinal, edgeOrdinal,
            ref init afterLeftBlock, ref init afterLeftEdge);
        if (leftStatus != 0)
        {
            return leftStatus;
        }
        if (afterLeftBlock != rightEntry
            || afterLeftEdge != edgeOrdinal + leftLeafCount)
        {
            return 3;
        }
        return NormalizeStandaloneSourceLazyBooleanDecision(
            bodyId, rightExpressionId, boolTypeId,
            trueTarget, falseTarget, rightLeafCount,
            finalBodyBlockCount,
            depth + 1, rightEntry, afterLeftEdge,
            ref init *nextBlockOrdinalResult,
            ref init *nextEdgeOrdinalResult);
    }
    if (expressionKind == 34)
    {
        return 2;
    }

    int32 bodyBlockFirst
        = Host.StandaloneNormalizedBodyBlockRanges[bodyId * 2];
    if (bodyBlockFirst < 0
        || Host.StandaloneNormalizedBlockCount[0]
            != bodyBlockFirst + blockOrdinal)
    {
        return 3;
    }
    int32 operationFirst = blockOrdinal == 0
        ? Host.StandaloneNormalizedBodies[bodyId * 12 + 9]
        : Host.StandaloneNormalizedOperationCount[0];
    init int32 selectorKind;
    init int32 sourceUse;
    init int32 selectorIndex;
    init bool terminated;
    int32 expressionStatus = NormalizeStandaloneSourceExpression(
        bodyId, expressionId, depth + 1,
        ref init selectorKind, ref init sourceUse,
        ref init selectorIndex, ref init terminated);
    if (expressionStatus != 0)
    {
        return expressionStatus;
    }
    if (Host.StandaloneNormalizedBlockCount[0]
            != bodyBlockFirst + blockOrdinal
        || terminated || selectorKind != 2 || sourceUse != 1
        || selectorIndex < 0)
    {
        return 2;
    }
    int32 operationCount
        = Host.StandaloneNormalizedOperationCount[0] - operationFirst;
    int32 edgeRecordIndex = finalBodyBlockCount + edgeOrdinal;
    if (operationCount < 0 || edgeRecordIndex > 0xFFFF)
    {
        return 3;
    }
    init int32 blockIndex;
    int32 blockStatus = AppendStandaloneNormalizedBlock(
        bodyId, blockOrdinal, operationFirst, operationCount,
        4, 0, 0, 0, trueTarget, falseTarget, 2, selectorIndex,
        boolTypeId, edgeRecordIndex, -1, 0,
        ref init blockIndex);
    if (blockStatus != 0)
    {
        return blockStatus;
    }
    if (blockIndex != bodyBlockFirst + blockOrdinal)
    {
        return 3;
    }

    *nextBlockOrdinalResult = blockOrdinal + 1;
    *nextEdgeOrdinalResult = edgeOrdinal + 1;
    return 0;
}

int32 NormalizeStandaloneSourceMixedLazyBooleanValue(int32 bodyId,
    int32 expressionId, int32 leafCount, int32 boolTypeId,
    ref<init int32> selectorKindResult,
    ref<init int32> sourceUseResult,
    ref<init int32> selectorIndexResult,
    ref<init bool> terminatedResult)
    ensure return == 0 ? (*selectorKindResult is init
        && *sourceUseResult is init
        && *selectorIndexResult is init
        && *terminatedResult is init) : true
{
    int32 bodyBlockFirst
        = Host.StandaloneNormalizedBodyBlockRanges[bodyId * 2];
    int32 finalBodyBlockCount = leafCount + 3;
    if (bodyBlockFirst < 0
        || Host.StandaloneNormalizedBlockCount[0] != bodyBlockFirst
        || leafCount < 3
        || finalBodyBlockCount > 0x1_0000
        || leafCount > 0x1_0000 - finalBodyBlockCount)
    {
        return 3;
    }

    int32 homeFirst
        = Host.StandaloneNormalizedBodies[bodyId * 12 + 1];
    init int32 resultHomeId;
    int32 resultHomeStatus = AppendStandaloneNormalizedHome(
        bodyId, homeFirst, 3, boolTypeId, 0,
        ref init resultHomeId);
    if (resultHomeStatus != 0)
