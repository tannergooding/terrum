        }
        if (childKind == 12 || childKind == 13)
        {
            int32 conditionExpressionId
                = Host.StandaloneSourceStatements[
                    childStatementOffset + 1];
            if ((childIndex != 0
                    && childIndex != childCount - 1)
                || bodyBlockCount < 1 || bodyBlockCount > 2
                || (bodyBlockCount == 1 && childCount != 1)
                || (bodyBlockCount == 2 && childCount < 2)
                || Host.StandaloneSourceStatements[
                    childStatementOffset + 2] != loopNodeId
                || conditionExpressionId < 0
                || conditionExpressionId
                    >= Host.StandaloneSourceBodies[bodyId * 12 + 4])
            {
                return 3;
            }
            int32 conditionExpressionOffset
                = (Host.StandaloneSourceBodies[bodyId * 12 + 3]
                    + conditionExpressionId) * 8;
            int32 conditionTypeId
                = Host.StandaloneSourceExpressions[
                    conditionExpressionOffset + 1];
            int32 conditionKind
                = Host.StandaloneSourceExpressions[
                    conditionExpressionOffset];
            int32 edgeRecordIndex
                = finalBodyBlockCount + conditionBlockCount;
            if (!IsStandaloneLogicalNotType(conditionTypeId)
                || conditionKind == 34
                || conditionKind == 35
                || conditionKind == 36
                || edgeRecordIndex < 0
                || edgeRecordIndex > 0xFFFF)
            {
                return 3;
            }
            int32 conditionOperationFirst
                = Host.StandaloneNormalizedOperationCount[0];
            init int32 conditionSelectorKind;
            init int32 conditionSourceUse;
            init int32 conditionSelectorIndex;
            init bool conditionTerminated;
            int32 conditionStatus
                = NormalizeStandaloneSourceExpression(
                    bodyId, conditionExpressionId, 1,
                    ref init conditionSelectorKind,
                    ref init conditionSourceUse,
                    ref init conditionSelectorIndex,
                    ref init conditionTerminated);
            if (conditionStatus != 0)
            {
                return conditionStatus;
            }
            if (conditionTerminated
                || conditionSelectorKind != 2
                || conditionSourceUse != 1
                || conditionSelectorIndex < 0)
            {
                return 2;
            }
            int32 conditionOperationCount
                = Host.StandaloneNormalizedOperationCount[0]
                    - conditionOperationFirst;
            int32 conditionalContinueTarget
                = bodyBlockCount == 2 && childIndex == 0
                    ? bodyBlockId + 1 : continueTarget;
            int32 conditionalTransferTarget
                = childKind == 12 ? exitBlockId : continueTarget;
            int32 conditionalBlockId
                = childIndex == 0
                    ? bodyBlockId : bodyBlockId + 1;
            if (childIndex > 0)
            {
                if (bodyBlockCount != 2
                    || childIndex != childCount - 1
                    || Host.StandaloneNormalizedBlockCount[0]
                        != expectedBlockCountBeforeBody)
                {
                    return 3;
                }
                int32 priorOperationCount
                    = conditionOperationFirst - bodyOperationFirst;
                init int32 priorAssignmentBlockIndex;
                int32 priorAssignmentBlockStatus
                    = AppendStandaloneNormalizedBlock(
                        bodyId, bodyBlockId, bodyOperationFirst,
                        priorOperationCount,
                        3, 0, 0, 0, bodyBlockId + 1, -1,
                        0, 0, 0, -1, -1, 0,
                        ref init priorAssignmentBlockIndex);
                if (priorAssignmentBlockStatus != 0)
                {
                    return priorAssignmentBlockStatus;
                }
                if (priorAssignmentBlockIndex
                    != bodyBlockFirst + bodyBlockId)
                {
                    return 3;
                }
            }
            if (childKind == 13
                && (bodyBlockCount == 1 || childIndex > 0))
            {
                init int32 continueBlockIndex;
                int32 continueBlockStatus
                    = AppendStandaloneNormalizedBlock(
                        bodyId, conditionalBlockId,
                        conditionOperationFirst,
                        conditionOperationCount,
                        3, 0, 0, 0, continueTarget, -1,
                        0, 0, 0, -1, -1, 0,
                        ref init continueBlockIndex);
                if (continueBlockStatus != 0)
                {
                    return continueBlockStatus;
                }
                return continueBlockIndex
                    == bodyBlockFirst + conditionalBlockId ? 0 : 3;
            }
            init int32 conditionalBlockIndex;
            int32 conditionalBlockStatus
                = AppendStandaloneNormalizedBlock(
                    bodyId, conditionalBlockId,
                    conditionOperationFirst,
                    conditionOperationCount,
                    4, 0, 0, 0, conditionalTransferTarget,
                    conditionalContinueTarget,
                    2, conditionSelectorIndex, conditionTypeId,
                    edgeRecordIndex, -1, 0,
                    ref init conditionalBlockIndex);
            if (conditionalBlockStatus != 0)
            {
                return conditionalBlockStatus;
            }
            if (conditionalBlockIndex
                != bodyBlockFirst + conditionalBlockId)
            {
                return 3;
            }
            if (bodyBlockCount == 1)
            {
                return 0;
            }
            if (childIndex > 0)
            {
                return 0;
            }
            if (Host.StandaloneNormalizedBlockCount[0]
                != expectedBlockCountBeforeBody + 1)
            {
                return 3;
            }
            int32 assignmentOperationFirst
                = Host.StandaloneNormalizedOperationCount[0];
            for (mut int32 assignmentOrdinal = 1;
                assignmentOrdinal < childCount;
                assignmentOrdinal = assignmentOrdinal + 1)
            {
                int32 assignmentStatementId
                    = Host.StandaloneSourceIfChildren[
                        childFirst + assignmentOrdinal];
                if (assignmentStatementId < 0
                    || assignmentStatementId
                        >= Host.StandaloneSourceStatementCount[0])
                {
                    return 3;
                }
                int32 assignmentStatementOffset
                    = assignmentStatementId * 3;
                if (Host.StandaloneSourceStatementParentIds[
                        assignmentStatementId] != statementId
                    || Host.StandaloneSourceStatements[
                        assignmentStatementOffset] != 5)
                {
                    return 3;
                }
                init int32 assignmentTerminalKind;
                int32 assignmentStatus
                    = NormalizeStandaloneSourceStatement(
                        bodyId, assignmentStatementOffset,
                        ref init assignmentTerminalKind);
                if (assignmentStatus != 0
                    || assignmentTerminalKind != 0
                    || Host.StandaloneNormalizedBlockCount[0]
                        != expectedBlockCountBeforeBody + 1)
                {
                    return assignmentStatus != 0
                        ? assignmentStatus : 2;
                }
            }
            int32 assignmentOperationCount
                = Host.StandaloneNormalizedOperationCount[0]
                    - assignmentOperationFirst;
            init int32 assignmentBlockIndex;
            int32 assignmentBlockStatus
                = AppendStandaloneNormalizedBlock(
                    bodyId, bodyBlockId + 1,
                    assignmentOperationFirst,
                    assignmentOperationCount,
                    3, 0, 0, 0, continueTarget, -1,
                    0, 0, 0, -1, -1, 0,
                    ref init assignmentBlockIndex);
            if (assignmentBlockStatus != 0)
            {
                return assignmentBlockStatus;
            }
            return assignmentBlockIndex
                == bodyBlockFirst + bodyBlockId + 1 ? 0 : 3;
        }
        if (childKind == 8 || childKind == 9)
        {
            if (sawLoopTransfer
                || childIndex != childCount - 1
                || Host.StandaloneSourceStatements[
                    childStatementOffset + 1] != -1
                || Host.StandaloneSourceStatements[
                    childStatementOffset + 2] != loopNodeId)
            {
                return 3;
            }
            sawLoopTransfer = true;
            bodyEndTarget = childKind == 8
                ? exitBlockId : continueTarget;
            continue;
        }
        if (sawLoopTransfer || childKind != 5)
        {
            return 3;
        }
        init int32 childTerminalKind;
        int32 childStatus = NormalizeStandaloneSourceStatement(
            bodyId, childStatementOffset,
            ref init childTerminalKind);
        if (childStatus != 0 || childTerminalKind != 0
            || Host.StandaloneNormalizedBlockCount[0]
                != currentBlockCountBeforeBody)
        {
            return childStatus != 0 ? childStatus : 2;
        }
    }
    int32 bodyOperationCount
        = Host.StandaloneNormalizedOperationCount[0]
            - bodyOperationFirst;
    init int32 bodyBlockIndex;
    int32 bodyBlockStatus = AppendStandaloneNormalizedBlock(
        bodyId, finalBodyBlockId,
        bodyOperationFirst, bodyOperationCount,
        3, 0, 0, 0, bodyEndTarget, -1, 0, 0, 0, -1, -1, 0,
        ref init bodyBlockIndex);
    if (bodyBlockStatus != 0)
    {
        return bodyBlockStatus;
    }
    return bodyBlockIndex == bodyBlockFirst + finalBodyBlockId ? 0 : 3;
}

int32 GetStandaloneSourceNestedWhileBodyBlockCount(int32 bodyId,
    int32 statementId, int32 loopNodeId, bool hasFollowingStatements,
    ref<init int32> blockCountResult)
    ensure return == 0 ? *blockCountResult is init : true
{
    if (bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || statementId < 0
        || statementId >= Host.StandaloneSourceStatementCount[0]
        || Host.StandaloneSourceStatements[statementId * 3] != 7
        || loopNodeId < 0
        || loopNodeId >= Host.StandaloneSourceIfNodeCount[0]
        || Host.StandaloneSourceStatements[
            statementId * 3 + 2] != loopNodeId
        || Host.StandaloneSourceIfNodes[loopNodeId * 5] != bodyId)
    {
        return 3;
    }
    int32 loopNodeOffset = loopNodeId * 5;
    int32 childFirst
        = Host.StandaloneSourceIfNodes[loopNodeOffset + 1];
    int32 childCount
        = Host.StandaloneSourceIfNodes[loopNodeOffset + 2];
    int32 falseFirst
        = Host.StandaloneSourceIfNodes[loopNodeOffset + 3];
    int32 falseCount
        = Host.StandaloneSourceIfNodes[loopNodeOffset + 4];
    if (childFirst < 0 || childCount < 1
        || falseCount != 0
        || childFirst
            > Host.StandaloneSourceIfChildCount[0] - childCount
        || falseFirst != childFirst + childCount)
    {
        return 3;
    }
    int32 transferStatementId
        = Host.StandaloneSourceIfChildren[
            childFirst + childCount - 1];
    if (transferStatementId < 0
        || transferStatementId
            >= Host.StandaloneSourceStatementCount[0]
        || Host.StandaloneSourceStatementParentIds[
            transferStatementId] != statementId
        || (Host.StandaloneSourceStatements[
                transferStatementId * 3] != 8
            && Host.StandaloneSourceStatements[
                transferStatementId * 3] != 9)
        || Host.StandaloneSourceStatements[
            transferStatementId * 3 + 1] != -1
        || Host.StandaloneSourceStatements[
            transferStatementId * 3 + 2] != loopNodeId)
    {
        return 3;
    }
    for (mut int32 childOrdinal = 0;
        childOrdinal < childCount - 1;
        childOrdinal = childOrdinal + 1)
    {
        int32 assignmentStatementId
            = Host.StandaloneSourceIfChildren[
                childFirst + childOrdinal];
        if (assignmentStatementId < 0
            || assignmentStatementId
                >= Host.StandaloneSourceStatementCount[0]
            || Host.StandaloneSourceStatementParentIds[
                assignmentStatementId] != statementId
            || Host.StandaloneSourceStatements[
                assignmentStatementId * 3] != 5)
        {
            return 3;
        }
    }
    if (childCount == 1)
    {
        *blockCountResult
            = (Host.StandaloneSourceStatements[
                transferStatementId * 3] == 9
                && hasFollowingStatements) ? 2 : 1;
    }
    else
    {
        *blockCountResult = hasFollowingStatements ? 3 : 2;
    }
    return 0;
}

