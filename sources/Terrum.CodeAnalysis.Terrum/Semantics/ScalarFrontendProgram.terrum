namespace Terrum.CodeAnalysis;

// Each complete-program frame contains token bounds, a source span, a 712-word
// body, and 64 zero-based target identities (-1 for nodes other than operation 105).
// Complete programs and their frames use v88. Operation 105 stores up to four
// source-order roots and source-to-formal mappings; callable flags are source-audited.
// Active tree payload words 21/22 carry the optional namespace-name span.
// The 32 frames are followed by 61 words reserved for temporary alias indexing.
int32 FindScalarProgramFunction(Token name)
{
    for (mut int32 index = 0; index < Host.FrontendProgram[2]; index = index + 1)
    {
        init SourceRange span;
        int32 header = 8 + index * 780;
        require SourceRange.TryCreate(Host.FrontendProgram[header + 9],
            Host.FrontendProgram[header + 10], ref init span);
        if (SameTokenSpelling(new Token(2, span), name)) { return index; }
    }
    return -1;
}

SourceRange ReadScalarProgramNamespace(Span<Token> tokenView, int32 count,
    write ref<init bool> hasNamespace, write ref<init int32> declarationStart,
    write ref<init int32> declarationEnd,
    write ref<init SourceRange> namespaceName)
{
    init SourceRange empty;
    init Token keyword;
    init Token firstName;
    init SourceRange qualifiedName;
    init Token terminator;
    require SourceRange.TryCreate(0, 0, ref init empty);
    *hasNamespace = false;
    *declarationStart = 0;
    *declarationEnd = count - 1;
    *namespaceName = empty;
    mut int32 namespaceIndex = -1;
    mut int32 usingIndex = -1;
    mut int32 namespaceCount = 0;
    for (mut int32 index = 0; index < count - 1; index = index + 1)
    {
        init Token token;
        require TryGetScalarWindowToken(tokenView, 0, count, false, index, ref init token);
        if (token.Kind == 6)
        {
            namespaceCount = namespaceCount + 1;
            if (namespaceCount > 1)
            {
                return token.Range;
            }
            namespaceIndex = index;
        }
        if (token.Kind == 5 && usingIndex < 0)
        {
            usingIndex = index;
        }
    }
    if (usingIndex >= 0)
    {
        init Token usingToken;
        require TryGetScalarWindowToken(tokenView, 0, count, false, usingIndex, ref init usingToken);
        return usingToken.Range;
    }
    if (namespaceIndex < 0)
    {
        return empty;
    }
    if (namespaceIndex != 0)
    {
        init Token misplacedNamespace;
        require TryGetScalarWindowToken(tokenView, 0, count, false, namespaceIndex,
            ref init misplacedNamespace);
        return misplacedNamespace.Range;
    }

    *hasNamespace = true;
    require TryGetScalarWindowToken(tokenView, 0, count, false, 0, ref init keyword);
    if (!TryGetScalarWindowToken(tokenView, 0, count, false, 1, ref init firstName)
        || firstName.Kind != 2)
    {
        return keyword.Range;
    }
    mut SourceRange lastName = firstName.Range;
    mut int32 at = 2;
    while (at < count - 1)
    {
        init Token segment;
        init Token separator;
        if (!TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init separator)
            || separator.Kind != 54)
        {
            break;
        }
        at = at + 1;
        if (!TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init segment)
            || segment.Kind != 2)
        {
            return separator.Range;
        }
        lastName = segment.Range;
        at = at + 1;
    }
    if (!SourceRange.TryCreate(firstName.Range.Start,
            lastName.End - firstName.Range.Start, ref init qualifiedName))
    {
        return keyword.Range;
    }
    *namespaceName = qualifiedName;
    if (!TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init terminator))
    {
        return keyword.Range;
    }
    if (terminator.Kind == 52)
    {
        *declarationStart = at + 1;
        *hasNamespace = true;
        return empty;
    }
    if (terminator.Kind != 48)
    {
        return terminator.Range;
    }

    *hasNamespace = true;
    *declarationStart = at + 1;
    mut int32 depth = 1;
    at = at + 1;
    while (at < count - 1 && depth != 0)
    {
        init Token token;
        require TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init token);
        if (token.Kind == 48) { depth = depth + 1; }
        if (token.Kind == 49) { depth = depth - 1; }
        at = at + 1;
    }
    if (depth != 0)
    {
        return terminator.Range;
    }
    *declarationEnd = at - 1;
    if (*declarationEnd != count - 2)
    {
        init Token trailing;
        if (TryGetScalarWindowToken(tokenView, 0, count, false,
                *declarationEnd + 1, ref init trailing))
        {
            return trailing.Range;
        }
        return terminator.Range;
    }
    return empty;
}

int32 CountScalarProgramNamespaces(Span<Token> tokenView, int32 count)
{
    mut int32 namespaces = 0;
    for (mut int32 index = 0; index < count - 1; index = index + 1)
    {
        init Token token;
        require TryGetScalarWindowToken(tokenView, 0, count, false, index, ref init token);
        if (token.Kind == 6) { namespaces = namespaces + 1; }
    }
    return namespaces;
}

bool ScalarProgramHasFileScopedNamespace(Span<Token> tokenView, int32 count)
{
    for (mut int32 at = 0; at < count - 1; at = at + 1)
    {
        init Token token;
        init Token name;
        init Token terminator;
        require TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init token);
        if (token.Kind != 6) { continue; }
        mut int32 cursor = at + 1;
        if (!TryGetScalarWindowToken(tokenView, 0, count, false,
                cursor, ref init name)
            || name.Kind != 2)
        {
            return false;
        }
        cursor = cursor + 1;
        while (cursor < count - 1)
        {
            init Token separator;
            if (!TryGetScalarWindowToken(tokenView, 0, count, false,
                    cursor, ref init separator)
                || separator.Kind != 54)
            {
                break;
            }
            cursor = cursor + 2;
        }
        return TryGetScalarWindowToken(tokenView, 0, count, false,
                cursor, ref init terminator)
            && terminator.Kind == 52;
    }
    return false;
}

bool TryInventoryScalarProgramScope(Span<Token> tokenView, int32 count,
    int32 declarationStart, int32 declarationEnd, SourceRange namespaceName,
    bool hasNamespace, int32 aliasCount, int32 initialFunctionCount,
    bool initialHasFourParameterFunction, write ref<init int32> functionCount,
    write ref<init bool> hasFourParameterFunction,
    write ref<init bool> useLegacyFallback,
    write ref<init SourceRange> error, write ref<init int32> errorCode)
{
    init SourceRange empty;
    require SourceRange.TryCreate(0, 0, ref init empty);
    mut int32 start = declarationStart;
    mut int32 functions = initialFunctionCount;
    mut bool hasFour = initialHasFourParameterFunction;
    mut bool legacyFallback = false;
    mut SourceRange errorSpan = empty;
    mut int32 errorCodeValue = 1;
    while (start < declarationEnd)
    {
        init int32 afterAlias;
        init ScalarFrontendResult header;
        init int32 headerEnd;
        init Token opening;
        init Token first;
        init Token last;
        if (TrySkipScalarAlias(tokenView, count, declarationEnd, start, ref init afterAlias))
        {
            if (aliasCount == 0)
            {
                init Token aliasStart;
                require TryGetScalarWindowToken(tokenView, 0, count, false, start, ref init aliasStart);
                errorSpan = aliasStart.Range;
                *functionCount = functions;
                *hasFourParameterFunction = hasFour;
                *useLegacyFallback = legacyFallback;
                *error = errorSpan;
                *errorCode = errorCodeValue;
                return true;
            }
            start = afterAlias;
            continue;
        }
        if (!ScalarFrontendState.TryCreate(start, count - 1, true, empty, out var probe)
            || !probe.TryInventoryHeader(ref init header, ref init headerEnd, tokenView))
        {
            return false;
        }
        if (!header.IsValid)
        {
            if (functions == 0 && aliasCount == 0 && !hasNamespace)
            {
                legacyFallback = true;
                *functionCount = functions;
                *hasFourParameterFunction = hasFour;
                *useLegacyFallback = legacyFallback;
                *error = errorSpan;
                *errorCode = errorCodeValue;
                return true;
            }
            errorSpan = header.ErrorSpan;
            errorCodeValue = header.ErrorCode;
            *functionCount = functions;
            *hasFourParameterFunction = hasFour;
            *useLegacyFallback = legacyFallback;
            *error = errorSpan;
            *errorCode = errorCodeValue;
            return true;
        }
        if (header.ParameterCount == 4) { hasFour = true; }
        int32 body = start + headerEnd;
        require TryGetScalarWindowToken(tokenView, 0, count, false, body, ref init opening);
        mut int32 end = body;
        if (opening.Kind == 82)
        {
            while (end < declarationEnd)
            {
                init Token token;
                require TryGetScalarWindowToken(tokenView, 0, count, false, end, ref init token);
                end = end + 1;
                if (token.Kind == 52) { break; }
            }
        }
        else if (opening.Kind == 48)
        {
            mut int32 depth = 1;
            end = body + 1;
            while (end < declarationEnd && depth != 0)
            {
                init Token token;
                require TryGetScalarWindowToken(tokenView, 0, count, false, end, ref init token);
                if (token.Kind == 48) { depth = depth + 1; }
                if (token.Kind == 49) { depth = depth - 1; }
                end = end + 1;
            }
            if (depth != 0)
            {
                errorSpan = opening.Range;
                *functionCount = functions;
                *hasFourParameterFunction = hasFour;
                *useLegacyFallback = legacyFallback;
                *error = errorSpan;
                *errorCode = errorCodeValue;
                return true;
            }
        }
        else
        {
            errorSpan = opening.Range;
            *functionCount = functions;
            *hasFourParameterFunction = hasFour;
            *useLegacyFallback = legacyFallback;
            *error = errorSpan;
            *errorCode = errorCodeValue;
            return true;
        }
        if (functions == 32)
        {
            errorSpan = header.Name;
            *functionCount = functions;
            *hasFourParameterFunction = hasFour;
            *useLegacyFallback = legacyFallback;
            *error = errorSpan;
            *errorCode = errorCodeValue;
            return true;
        }
        int32 frame = 4 + functions * 780;
        require TryGetScalarWindowToken(tokenView, 0, count, false, start, ref init first);
        require TryGetScalarWindowToken(tokenView, 0, count, false, end - 1, ref init last);
        Host.FrontendProgram[frame] = start;
        Host.FrontendProgram[frame + 1] = end;
        Host.FrontendProgram[frame + 2] = first.Range.Start;
        Host.FrontendProgram[frame + 3] = last.Range.End - first.Range.Start;
        WriteScalarFrontendHeader(header, true);
        Host.Frontend[5] = header.ReturnType;
        int32 headerOffset = frame + 4;
        for (mut int32 word = 0; word < 37; word = word + 1)
        {
            Host.FrontendProgram[headerOffset + word] = Host.Frontend[word];
            Host.Frontend[word] = 0;
        }
        Host.FrontendProgram[headerOffset + 21] = namespaceName.Start;
        Host.FrontendProgram[headerOffset + 22] = namespaceName.Length;
        functions = functions + 1;
        start = end;
    }
    *functionCount = functions;
    *hasFourParameterFunction = hasFour;
    *useLegacyFallback = legacyFallback;
    *error = errorSpan;
    *errorCode = errorCodeValue;
    return true;
}

bool TryInventoryRepeatedScalarProgramNamespaceBlocks(Span<Token> tokenView, int32 count,
    write ref<init int32> functionCount,
    write ref<init bool> hasFourParameterFunction,
    write ref<init SourceRange> namespaceName,
    write ref<init int32> aliasCount,
    write ref<init SourceRange> error, write ref<init int32> errorCode)
{
    init SourceRange empty;
    init int32 rootAliasCount;
    require SourceRange.TryCreate(0, 0, ref init empty);
    mut int32 functions = 0;
    mut bool hasFour = false;
    mut bool hasNamespace = false;
    mut SourceRange firstNamespace = empty;
    mut int32 aliasCountValue = 0;
    mut SourceRange errorValue = empty;
    mut int32 errorCodeValue = 1;
    var rootAliasError = BuildScalarAliasTable(tokenView, count,
        0, count - 1, 0, 0, true, ref init rootAliasCount);
    if (rootAliasError.Length != 0)
    {
        errorValue = rootAliasError;
        *functionCount = functions;
        *hasFourParameterFunction = hasFour;
        *namespaceName = firstNamespace;
        *aliasCount = aliasCountValue;
        *error = errorValue;
        *errorCode = errorCodeValue;
        return true;
    }
    aliasCountValue = rootAliasCount;
    mut int32 at = 0;
    while (at < count - 1)
    {
        init Token keyword;
        init int32 updatedFunctions;
        init bool updatedHasFour;
        init bool useLegacy;
        init SourceRange inventoryError;
        init int32 inventoryErrorCode;
        if (!TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init keyword))
        {
            return false;
        }
        if (keyword.Kind == 6)
        {
            init int32 namespaceFunctions;
            init bool namespaceHasFour;
            init SourceRange updatedFirstNamespace;
            init int32 updatedAliasCount;
            init int32 next;
            init SourceRange namespaceError;
            init int32 namespaceErrorCode;
            var aliasError = BuildScalarAliasTableForNamespaceParts(
                tokenView, count, at, rootAliasCount);
            if (aliasError.Length != 0)
            {
                errorValue = aliasError;
                *functionCount = functions;
                *hasFourParameterFunction = hasFour;
                *namespaceName = firstNamespace;
                *aliasCount = aliasCountValue;
                *error = errorValue;
                *errorCode = errorCodeValue;
                return true;
            }
            int32 blockAliasCount
                = Host.FrontendProgram[Host.FrontendProgram.Length - 1];
            if (!TryInventoryScalarProgramNamespaceTree(tokenView, count, at, 1,
                    functions, hasFour, firstNamespace, blockAliasCount, true,
                    ref init namespaceFunctions, ref init namespaceHasFour,
                    ref init updatedFirstNamespace, ref init updatedAliasCount,
                    ref init next, ref init namespaceError, ref init namespaceErrorCode))
            {
                return false;
            }
            if (namespaceError.Length != 0)
            {
                errorValue = namespaceError;
                errorCodeValue = namespaceErrorCode;
                *functionCount = functions;
                *hasFourParameterFunction = hasFour;
                *namespaceName = firstNamespace;
                *aliasCount = aliasCountValue;
                *error = errorValue;
                *errorCode = errorCodeValue;
                return true;
            }
            functions = namespaceFunctions;
            hasFour = namespaceHasFour;
            firstNamespace = updatedFirstNamespace;
            if (updatedAliasCount > aliasCountValue)
            {
                aliasCountValue = updatedAliasCount;
            }
            RestoreScalarAliasTable(rootAliasCount);
            hasNamespace = true;
            at = next;
            continue;
        }

        mut int32 scopeEnd = at;
        mut int32 depth = 0;
        while (scopeEnd < count - 1)
        {
            init Token scopeToken;
            require TryGetScalarWindowToken(tokenView, 0, count, false,
                scopeEnd, ref init scopeToken);
            if (depth == 0 && scopeToken.Kind == 6)
            {
                break;
            }
            if (scopeToken.Kind == 48) { depth = depth + 1; }
            if (scopeToken.Kind == 49)
            {
                if (depth == 0)
                {
                    errorValue = scopeToken.Range;
                    *functionCount = functions;
                    *hasFourParameterFunction = hasFour;
                    *namespaceName = firstNamespace;
                    *aliasCount = aliasCountValue;
                    *error = errorValue;
                    *errorCode = errorCodeValue;
                    return true;
                }
                depth = depth - 1;
            }
            scopeEnd = scopeEnd + 1;
        }
        if (depth != 0)
        {
            errorValue = keyword.Range;
            *functionCount = functions;
            *hasFourParameterFunction = hasFour;
            *namespaceName = firstNamespace;
            *aliasCount = aliasCountValue;
            *error = errorValue;
            *errorCode = errorCodeValue;
            return true;
        }
        if (scopeEnd == at)
        {
            errorValue = keyword.Range;
            *functionCount = functions;
            *hasFourParameterFunction = hasFour;
            *namespaceName = firstNamespace;
            *aliasCount = aliasCountValue;
            *error = errorValue;
            *errorCode = errorCodeValue;
            return true;
        }
        if (!TryInventoryScalarProgramScope(tokenView, count, at, scopeEnd,
                empty, false, rootAliasCount, functions, hasFour,
                ref init updatedFunctions, ref init updatedHasFour,
                ref init useLegacy, ref init inventoryError,
                ref init inventoryErrorCode))
        {
            return false;
        }
        if (useLegacy)
        {
            errorValue = keyword.Range;
            *functionCount = functions;
            *hasFourParameterFunction = hasFour;
            *namespaceName = firstNamespace;
            *aliasCount = aliasCountValue;
            *error = errorValue;
            *errorCode = errorCodeValue;
            return true;
        }
        if (inventoryError.Length != 0)
        {
            errorValue = inventoryError;
            errorCodeValue = inventoryErrorCode;
            *functionCount = functions;
            *hasFourParameterFunction = hasFour;
            *namespaceName = firstNamespace;
            *aliasCount = aliasCountValue;
            *error = errorValue;
            *errorCode = errorCodeValue;
            return true;
        }
        functions = updatedFunctions;
        hasFour = updatedHasFour;
        at = scopeEnd;
    }
    if (!hasNamespace || at != count - 1)
    {
        init Token trailing;
        if (TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init trailing))
        {
            errorValue = trailing.Range;
        }
        *functionCount = functions;
        *hasFourParameterFunction = hasFour;
        *namespaceName = firstNamespace;
        *aliasCount = aliasCountValue;
        *error = errorValue;
        *errorCode = errorCodeValue;
        return true;
    }
    *functionCount = functions;
    *hasFourParameterFunction = hasFour;
    *namespaceName = firstNamespace;
    *aliasCount = aliasCountValue;
    *error = errorValue;
    *errorCode = errorCodeValue;
    return true;
}

SourceRange BuildScalarAliasTableForNamespaceParts(Span<Token> tokenView,
    int32 count, int32 namespaceStart, int32 initialAliasCount)
{
    init SourceRange empty;
    require SourceRange.TryCreate(0, 0, ref init empty);
    if (ScalarNamespaceNameEnd(tokenView, count, namespaceStart,
            count - 1) < 0
        || ScalarNamespaceBlockEnd(tokenView, count, namespaceStart,
            count - 1) < 0)
    {
        init Token targetKeyword;
        require TryGetScalarWindowToken(tokenView, 0, count, false,
            namespaceStart, ref init targetKeyword);
        return targetKeyword.Range;
    }

    var aliasError = CollectScalarNamespaceAliases(tokenView, count,
        0, count - 1, namespaceStart, -1, initialAliasCount,
        initialAliasCount, 0);
    if (aliasError.Length != 0)
    {
        return aliasError;
    }

    return ResolveScalarAliases(
        Host.FrontendProgram[Host.FrontendProgram.Length - 1],
        initialAliasCount);
}

SourceRange CollectScalarNamespaceAliases(Span<Token> tokenView,
    int32 count, int32 scopeStart, int32 scopeEnd,
    int32 targetNamespaceStart, int32 parentNamespaceStart,
    int32 initialAliasCount, int32 duplicateStart,
    int32 namespaceDepth)
{
    init SourceRange empty;
    require SourceRange.TryCreate(0, 0, ref init empty);
    mut int32 currentAliasCount = initialAliasCount;
    mut int32 scan = scopeStart;
    mut int32 depth = 0;
    while (scan < scopeEnd)
    {
        init Token token;
        require TryGetScalarWindowToken(tokenView, 0, count, false,
            scan, ref init token);
        if (depth == 0 && token.Kind == 6)
        {
            init Token opening;
            if (namespaceDepth >= 8)
            {
                return token.Range;
            }
            var nameEnd = ScalarNamespaceNameEnd(tokenView, count,
                scan, scopeEnd);
            if (nameEnd < 0
                || !TryGetScalarWindowToken(tokenView, 0, count, false,
                    nameEnd, ref init opening)
                || opening.Kind != 48)
            {
                return token.Range;
            }

            var blockEnd = ScalarNamespaceBlockEnd(tokenView, count,
                scan, scopeEnd);
            if (blockEnd < 0)
            {
                return opening.Range;
            }
            int32 bodyStart = nameEnd + 1;
            if (SameScalarNamespaceIdentity(tokenView, count,
                    targetNamespaceStart, scan,
                    parentNamespaceStart))
            {
                init int32 updatedAliasCount;
                var aliasError = BuildScalarAliasTable(tokenView, count,
                    bodyStart, blockEnd - 1, currentAliasCount,
                    duplicateStart, false,
                    ref init updatedAliasCount);
                if (aliasError.Length != 0)
                {
                    return aliasError;
                }
                currentAliasCount = updatedAliasCount;
            }

            var nestedError = CollectScalarNamespaceAliases(tokenView,
                count, bodyStart, blockEnd - 1, targetNamespaceStart,
                scan, currentAliasCount, duplicateStart,
                namespaceDepth + 1);
            if (nestedError.Length != 0)
            {
                return nestedError;
            }
            currentAliasCount
                = Host.FrontendProgram[
                    Host.FrontendProgram.Length - 1];
            scan = blockEnd;
            continue;
        }

        if (token.Kind == 48) { depth = depth + 1; }
        if (token.Kind == 49)
        {
            if (depth == 0)
            {
                return token.Range;
            }
            depth = depth - 1;
        }
        scan = scan + 1;
    }

    if (depth != 0)
    {
        init Token first;
        require TryGetScalarWindowToken(tokenView, 0, count, false,
            scopeStart, ref init first);
        return first.Range;
    }

    Host.FrontendProgram[Host.FrontendProgram.Length - 1]
        = currentAliasCount;
    return empty;
}

int32 ScalarNamespaceNameEnd(Span<Token> tokenView, int32 count,
    int32 namespaceStart, int32 scopeEnd)
{
    init Token keyword;
    init Token firstName;
    if (!TryGetScalarWindowToken(tokenView, 0, count, false,
            namespaceStart, ref init keyword)
        || keyword.Kind != 6)
    {
        return -1;
    }
    mut int32 cursor = namespaceStart + 1;
    if (cursor >= scopeEnd
        || !TryGetScalarWindowToken(tokenView, 0, count, false,
            cursor, ref init firstName)
        || firstName.Kind != 2)
    {
        return -1;
    }
    cursor = cursor + 1;
    while (cursor < scopeEnd)
    {
        init Token segment;
        init Token separator;
        if (!TryGetScalarWindowToken(tokenView, 0, count, false,
                cursor, ref init separator)
            || separator.Kind != 54)
        {
            break;
        }
        cursor = cursor + 1;
        if (cursor >= scopeEnd
            || !TryGetScalarWindowToken(tokenView, 0, count, false,
                cursor, ref init segment)
            || segment.Kind != 2)
        {
            return -1;
        }
        cursor = cursor + 1;
    }
    return cursor;
}

int32 ScalarNamespaceBlockEnd(Span<Token> tokenView, int32 count,
    int32 namespaceStart, int32 scopeEnd)
{
    init Token opening;
    var nameEnd = ScalarNamespaceNameEnd(tokenView, count,
        namespaceStart, scopeEnd);
    if (nameEnd < 0
        || !TryGetScalarWindowToken(tokenView, 0, count, false,
            nameEnd, ref init opening)
        || opening.Kind != 48)
    {
        return -1;
    }

    int32 bodyStart = nameEnd + 1;
    mut int32 blockEnd = bodyStart;
    mut int32 depth = 1;
    while (blockEnd < scopeEnd && depth != 0)
    {
        init Token blockToken;
        require TryGetScalarWindowToken(tokenView, 0, count, false,
            blockEnd, ref init blockToken);
        if (blockToken.Kind == 48) { depth = depth + 1; }
        if (blockToken.Kind == 49) { depth = depth - 1; }
        blockEnd = blockEnd + 1;
    }
    return depth == 0 ? blockEnd : -1;
}

int32 FindParentScalarNamespaceBlock(Span<Token> tokenView, int32 count,
    int32 targetNamespaceStart)
    => FindParentScalarNamespaceBlockInScope(tokenView, count, 0,
        count - 1, targetNamespaceStart, -1, 0);

int32 FindParentScalarNamespaceBlockInScope(Span<Token> tokenView,
    int32 count, int32 scopeStart, int32 scopeEnd,
    int32 targetNamespaceStart, int32 enclosingNamespaceStart,
    int32 namespaceDepth)
{
    mut int32 scan = scopeStart;
    mut int32 depth = 0;
    while (scan < targetNamespaceStart && scan < scopeEnd)
    {
        init Token token;
        require TryGetScalarWindowToken(tokenView, 0, count, false,
            scan, ref init token);
        if (depth == 0 && token.Kind == 6)
        {
            var nameEnd = ScalarNamespaceNameEnd(tokenView, count,
                scan, scopeEnd);
            var blockEnd = ScalarNamespaceBlockEnd(tokenView, count,
                scan, scopeEnd);
            if (nameEnd < 0 || blockEnd < 0)
            {
                return -2;
            }
            if (targetNamespaceStart > scan
                && targetNamespaceStart < blockEnd)
            {
                if (namespaceDepth >= 8)
                {
                    return -2;
                }
                return FindParentScalarNamespaceBlockInScope(tokenView,
                    count, nameEnd + 1, blockEnd - 1,
                    targetNamespaceStart, scan, namespaceDepth + 1);
            }
            scan = blockEnd;
            continue;
        }
        if (token.Kind == 48) { depth = depth + 1; }
        if (token.Kind == 49)
        {
            if (depth == 0)
            {
                return -2;
            }
            depth = depth - 1;
        }
        scan = scan + 1;
    }
    return depth == 0 ? enclosingNamespaceStart : -2;
}

int32 ScalarNamespaceLocalSegmentCount(Span<Token> tokenView,
    int32 count, int32 namespaceStart, int32 scopeEnd)
{
    var nameEnd = ScalarNamespaceNameEnd(tokenView, count,
        namespaceStart, scopeEnd);
    if (nameEnd < 0) { return -1; }
    mut int32 cursor = namespaceStart + 1;
    mut int32 segmentCount = 0;
    while (cursor < nameEnd)
    {
        init Token segment;
        require TryGetScalarWindowToken(tokenView, 0, count, false,
            cursor, ref init segment);
        if (segment.Kind != 2) { return -1; }
        segmentCount = segmentCount + 1;
        cursor = cursor + 1;
        if (cursor < nameEnd)
        {
            init Token separator;
            require TryGetScalarWindowToken(tokenView, 0, count, false,
                cursor, ref init separator);
            if (separator.Kind != 54) { return -1; }
            cursor = cursor + 1;
        }
    }
    return segmentCount;
}

int32 ScalarNamespacePathSegmentCount(Span<Token> tokenView,
    int32 count, int32 namespaceStart, int32 parentNamespaceStart)
{
    var localCount = ScalarNamespaceLocalSegmentCount(tokenView, count,
        namespaceStart, count - 1);
    if (localCount < 0) { return -1; }
    if (parentNamespaceStart < 0) { return localCount; }
    var parentParent = FindParentScalarNamespaceBlock(tokenView, count,
        parentNamespaceStart);
    if (parentParent == -2) { return -1; }
    var parentCount = ScalarNamespacePathSegmentCount(tokenView, count,
        parentNamespaceStart, parentParent);
    return parentCount < 0 ? -1 : parentCount + localCount;
}

Token ScalarNamespaceLocalSegment(Span<Token> tokenView, int32 count,
    int32 namespaceStart, int32 segmentOrdinal)
{
    init SourceRange empty;
    mut int32 cursor = namespaceStart + 1;
    mut int32 currentOrdinal = 0;
    while (cursor < count - 1)
    {
        init Token segment;
        init Token separator;
        require TryGetScalarWindowToken(tokenView, 0, count, false,
            cursor, ref init segment);
        if (segment.Kind != 2) { require false; }
        if (currentOrdinal == segmentOrdinal) { return segment; }
        currentOrdinal = currentOrdinal + 1;
        cursor = cursor + 1;
        if (!TryGetScalarWindowToken(tokenView, 0, count, false,
                cursor, ref init separator)
            || separator.Kind != 54)
        {
            break;
        }
        cursor = cursor + 1;
    }
    require false;
    require SourceRange.TryCreate(0, 0, ref init empty);
    return new Token(0, empty);
}

Token ScalarNamespacePathSegment(Span<Token> tokenView, int32 count,
    int32 namespaceStart, int32 parentNamespaceStart,
    int32 segmentOrdinal)
{
    if (parentNamespaceStart < 0)
    {
        return ScalarNamespaceLocalSegment(tokenView, count,
            namespaceStart, segmentOrdinal);
    }

    var parentParent = FindParentScalarNamespaceBlock(tokenView, count,
        parentNamespaceStart);
    require parentParent != -2;
    var parentCount = ScalarNamespacePathSegmentCount(tokenView, count,
        parentNamespaceStart, parentParent);
    require parentCount >= 0;
    return segmentOrdinal < parentCount
        ? ScalarNamespacePathSegment(tokenView, count,
            parentNamespaceStart, parentParent, segmentOrdinal)
        : ScalarNamespaceLocalSegment(tokenView, count, namespaceStart,
            segmentOrdinal - parentCount);
}

bool SameScalarNamespaceIdentity(Span<Token> tokenView, int32 count,
    int32 targetNamespaceStart, int32 candidateNamespaceStart,
    int32 candidateParentNamespaceStart)
{
    var targetParent = FindParentScalarNamespaceBlock(tokenView, count,
        targetNamespaceStart);
    if (targetParent == -2) { return false; }
    var targetCount = ScalarNamespacePathSegmentCount(tokenView, count,
        targetNamespaceStart, targetParent);
    var candidateCount = ScalarNamespacePathSegmentCount(tokenView, count,
        candidateNamespaceStart, candidateParentNamespaceStart);
    if (targetCount < 0 || targetCount != candidateCount)
    {
        return false;
    }
    for (mut int32 ordinal = 0; ordinal < targetCount;
        ordinal = ordinal + 1)
    {
        var targetSegment = ScalarNamespacePathSegment(tokenView, count,
            targetNamespaceStart, targetParent, ordinal);
        var candidateSegment = ScalarNamespacePathSegment(tokenView, count,
            candidateNamespaceStart, candidateParentNamespaceStart,
            ordinal);
        if (!SameTokenSpelling(targetSegment, candidateSegment))
        {
            return false;
        }
    }
    return true;
}

bool TryInventoryScalarProgramNamespaceSegment(Span<Token> tokenView, int32 count,
    int32 declarationStart, int32 declarationEnd, SourceRange currentNamespace,
    int32 initialFunctionCount, bool initialHasFourParameterFunction,
    SourceRange initialNamespaceName, int32 initialAliasCount,
    write ref<init int32> functionCount,
    write ref<init bool> hasFourParameterFunction,
    write ref<init SourceRange> namespaceName,
    write ref<init int32> aliasCount,
    write ref<init SourceRange> error, write ref<init int32> errorCode)
{
    init SourceRange empty;
    init int32 updatedFunctions;
    init bool updatedHasFour;
    init bool useLegacy;
    init SourceRange inventoryError;
    init int32 inventoryErrorCode;
    require SourceRange.TryCreate(0, 0, ref init empty);
    if (declarationStart >= declarationEnd)
    {
        *functionCount = initialFunctionCount;
        *hasFourParameterFunction = initialHasFourParameterFunction;
        *namespaceName = initialNamespaceName;
        *aliasCount = initialAliasCount;
        *error = empty;
        *errorCode = 1;
        return true;
    }
    if (!TryInventoryScalarProgramScope(tokenView, count, declarationStart,
            declarationEnd, currentNamespace, true, initialAliasCount,
            initialFunctionCount, initialHasFourParameterFunction,
            ref init updatedFunctions, ref init updatedHasFour,
            ref init useLegacy, ref init inventoryError,
            ref init inventoryErrorCode))
    {
        return false;
    }
    if (useLegacy)
    {
        *error = currentNamespace;
        *functionCount = initialFunctionCount;
        *hasFourParameterFunction = initialHasFourParameterFunction;
        *namespaceName = initialNamespaceName;
        *aliasCount = initialAliasCount;
        *errorCode = 1;
        return true;
    }
    if (inventoryError.Length != 0)
    {
        *error = inventoryError;
        *errorCode = inventoryErrorCode;
        *functionCount = initialFunctionCount;
        *hasFourParameterFunction = initialHasFourParameterFunction;
        *namespaceName = initialNamespaceName;
        *aliasCount = initialAliasCount;
        return true;
    }
    *functionCount = updatedFunctions;
    *hasFourParameterFunction = updatedHasFour;
    *namespaceName = initialNamespaceName.Length == 0
        ? currentNamespace : initialNamespaceName;
    *aliasCount = initialAliasCount;
    *error = empty;
    *errorCode = 1;
    return true;
}

bool TryInventoryScalarProgramNamespaceTree(Span<Token> tokenView, int32 count,
    int32 at, int32 nestingDepth, int32 initialFunctionCount,
    bool initialHasFourParameterFunction, SourceRange initialNamespaceName,
    int32 initialAliasCount, bool currentNamespaceAliasesPrebuilt,
    write ref<init int32> functionCount,
    write ref<init bool> hasFourParameterFunction,
    write ref<init SourceRange> namespaceName,
    write ref<init int32> aliasCount, write ref<init int32> next,
    write ref<init SourceRange> error, write ref<init int32> errorCode)
{
    init SourceRange empty;
    init Token keyword;
    init Token firstName;
    init SourceRange currentNamespace;
    init Token opening;
    require SourceRange.TryCreate(0, 0, ref init empty);
    if (!TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init keyword)
        || keyword.Kind != 6
        || !TryGetScalarWindowToken(tokenView, 0, count, false, at + 1, ref init firstName)
        || firstName.Kind != 2)
    {
        return false;
    }
    if (nestingDepth > 8)
    {
        *error = keyword.Range;
        *functionCount = initialFunctionCount;
        *hasFourParameterFunction = initialHasFourParameterFunction;
        *namespaceName = initialNamespaceName;
        *aliasCount = initialAliasCount;
        *next = at;
        *errorCode = 1;
        return true;
    }
    mut SourceRange lastName = firstName.Range;
    mut int32 cursor = at + 2;
    while (cursor < count - 1)
    {
        init Token segment;
        init Token separator;
        if (!TryGetScalarWindowToken(tokenView, 0, count, false,
                cursor, ref init separator)
            || separator.Kind != 54)
        {
            break;
        }
        cursor = cursor + 1;
        if (!TryGetScalarWindowToken(tokenView, 0, count, false, cursor, ref init segment)
            || segment.Kind != 2)
        {
            *error = separator.Range;
            *functionCount = initialFunctionCount;
            *hasFourParameterFunction = initialHasFourParameterFunction;
            *namespaceName = initialNamespaceName;
            *aliasCount = initialAliasCount;
            *next = at;
            *errorCode = 1;
            return true;
        }
        lastName = segment.Range;
        cursor = cursor + 1;
    }
    if (!SourceRange.TryCreate(firstName.Range.Start,
            lastName.End - firstName.Range.Start, ref init currentNamespace)
        || !TryGetScalarWindowToken(tokenView, 0, count, false, cursor, ref init opening)
        || opening.Kind != 48)
    {
        *error = keyword.Range;
        *functionCount = initialFunctionCount;
        *hasFourParameterFunction = initialHasFourParameterFunction;
        *namespaceName = initialNamespaceName;
        *aliasCount = initialAliasCount;
        *next = at;
        *errorCode = 1;
        return true;
    }
    int32 bodyStart = cursor + 1;
    mut int32 namespaceEnd = bodyStart;
    mut int32 namespaceBraceDepth = 1;
    while (namespaceEnd < count - 1 && namespaceBraceDepth != 0)
    {
        init Token namespaceToken;
        require TryGetScalarWindowToken(tokenView, 0, count, false,
            namespaceEnd, ref init namespaceToken);
        if (namespaceToken.Kind == 48) { namespaceBraceDepth = namespaceBraceDepth + 1; }
        if (namespaceToken.Kind == 49) { namespaceBraceDepth = namespaceBraceDepth - 1; }
        namespaceEnd = namespaceEnd + 1;
    }
    if (namespaceBraceDepth != 0)
    {
        *error = opening.Range;
        *functionCount = initialFunctionCount;
        *hasFourParameterFunction = initialHasFourParameterFunction;
        *namespaceName = initialNamespaceName;
        *aliasCount = initialAliasCount;
        *next = at;
        *errorCode = 1;
        return true;
    }
    mut int32 activeAliasCount = initialAliasCount;
    if (!currentNamespaceAliasesPrebuilt)
    {
        var aliasError = BuildScalarAliasTableForNamespaceParts(
            tokenView, count, at, initialAliasCount);
        if (aliasError.Length != 0)
        {
            *error = aliasError;
            *functionCount = initialFunctionCount;
            *hasFourParameterFunction = initialHasFourParameterFunction;
            *namespaceName = initialNamespaceName;
            *aliasCount = initialAliasCount;
            *next = at;
            *errorCode = 1;
            return true;
        }
        activeAliasCount = Host.FrontendProgram[
            Host.FrontendProgram.Length - 1];
    }
    mut int32 scan = bodyStart;
    mut int32 segmentStart = bodyStart;
    mut int32 depth = 0;
    mut int32 functions = initialFunctionCount;
    mut bool hasFour = initialHasFourParameterFunction;
    mut SourceRange firstNamespace = initialNamespaceName;
    mut int32 aliases = activeAliasCount;
    mut int32 subtreeAliases = activeAliasCount;
    while (scan < count - 1)
    {
        init Token token;
        require TryGetScalarWindowToken(tokenView, 0, count, false, scan, ref init token);
        if (depth == 0 && token.Kind == 49)
        {
            if (segmentStart < scan)
            {
                init int32 updatedFunctions;
                init bool updatedHasFour;
                init SourceRange updatedNamespace;
                init int32 updatedAliases;
                init SourceRange segmentError;
                init int32 segmentErrorCode;
                if (!TryInventoryScalarProgramNamespaceSegment(tokenView, count,
                        segmentStart, scan, currentNamespace, functions, hasFour,
                        firstNamespace, aliases, ref init updatedFunctions,
                        ref init updatedHasFour, ref init updatedNamespace,
                        ref init updatedAliases, ref init segmentError,
                        ref init segmentErrorCode))
                {
                    return false;
                }
                if (segmentError.Length != 0)
                {
                    *error = segmentError;
                    *errorCode = segmentErrorCode;
                    *functionCount = initialFunctionCount;
                    *hasFourParameterFunction = initialHasFourParameterFunction;
                    *namespaceName = initialNamespaceName;
                    *aliasCount = initialAliasCount;
                    *next = at;
                    return true;
                }
                functions = updatedFunctions;
                hasFour = updatedHasFour;
                firstNamespace = updatedNamespace;
                aliases = updatedAliases;
            }
            *functionCount = functions;
            *hasFourParameterFunction = hasFour;
            *namespaceName = firstNamespace;
            *aliasCount = subtreeAliases;
            *next = scan + 1;
            *error = empty;
            *errorCode = 1;
            return true;
        }
        if (depth == 0 && token.Kind == 6)
        {
            init int32 childFunctions;
            init bool childHasFour;
            init SourceRange childNamespace;
            init int32 childAliases;
            init int32 childNext;
            init SourceRange childError;
            init int32 childErrorCode;
            if (segmentStart < scan)
            {
                init int32 updatedFunctions;
                init bool updatedHasFour;
                init SourceRange updatedNamespace;
                init int32 updatedAliases;
                init SourceRange segmentError;
                init int32 segmentErrorCode;
                if (!TryInventoryScalarProgramNamespaceSegment(tokenView, count,
                        segmentStart, scan, currentNamespace, functions, hasFour,
                        firstNamespace, aliases, ref init updatedFunctions,
                        ref init updatedHasFour, ref init updatedNamespace,
                        ref init updatedAliases, ref init segmentError,
                        ref init segmentErrorCode))
                {
                    return false;
                }
                if (segmentError.Length != 0)
                {
                    *error = segmentError;
                    *errorCode = segmentErrorCode;
                    *functionCount = initialFunctionCount;
                    *hasFourParameterFunction = initialHasFourParameterFunction;
                    *namespaceName = initialNamespaceName;
                    *aliasCount = initialAliasCount;
                    *next = at;
                    return true;
                }
                functions = updatedFunctions;
                hasFour = updatedHasFour;
                firstNamespace = updatedNamespace;
                aliases = updatedAliases;
            }
            if (!TryInventoryScalarProgramNamespaceTree(tokenView, count, scan,
                    nestingDepth + 1, functions, hasFour, firstNamespace, aliases,
                    false,
                    ref init childFunctions, ref init childHasFour,
                    ref init childNamespace, ref init childAliases,
                    ref init childNext, ref init childError, ref init childErrorCode))
            {
                return false;
            }
            if (childError.Length != 0)
            {
                *error = childError;
                *errorCode = childErrorCode;
                *functionCount = initialFunctionCount;
                *hasFourParameterFunction = initialHasFourParameterFunction;
                *namespaceName = initialNamespaceName;
                *aliasCount = initialAliasCount;
                *next = at;
                return true;
            }
            functions = childFunctions;
            hasFour = childHasFour;
            firstNamespace = childNamespace;
            if (childAliases > subtreeAliases)
            {
                subtreeAliases = childAliases;
            }
            RestoreScalarAliasTable(aliases);
            scan = childNext;
            segmentStart = childNext;
            continue;
        }
        if (token.Kind == 48) { depth = depth + 1; }
        if (token.Kind == 49) { depth = depth - 1; }
        scan = scan + 1;
    }
    *error = opening.Range;
    *functionCount = initialFunctionCount;
    *hasFourParameterFunction = initialHasFourParameterFunction;
    *namespaceName = initialNamespaceName;
    *aliasCount = initialAliasCount;
    *next = at;
    *errorCode = 1;
    return true;
}

bool TryBuildScalarAliasTableForFunction(Span<Token> tokenView, int32 count,
    int32 scopeStart, int32 scopeEnd, int32 targetTokenStart,
    int32 initialAliasCount, bool namespaceAliasesPrebuilt,
    write ref<init bool> found, write ref<init SourceRange> error)
{
    init SourceRange empty;
    require SourceRange.TryCreate(0, 0, ref init empty);
    mut int32 activeAliasCount = initialAliasCount;
    if (!namespaceAliasesPrebuilt)
    {
        init int32 updatedAliasCount;
        var aliasError = BuildScalarAliasTable(tokenView, count,
            scopeStart, scopeEnd, initialAliasCount,
            initialAliasCount, true,
            ref init updatedAliasCount);
        if (aliasError.Length != 0)
        {
            *found = false;
            *error = aliasError;
            return true;
        }
        activeAliasCount = updatedAliasCount;
    }

    mut int32 scan = scopeStart;
    mut int32 depth = 0;
    while (scan < scopeEnd)
    {
        init Token token;
        require TryGetScalarWindowToken(tokenView, 0, count, false,
            scan, ref init token);
        if (depth == 0 && token.Kind == 6)
        {
            init Token firstName;
            init Token opening;
            mut int32 cursor = scan + 1;
            if (!TryGetScalarWindowToken(tokenView, 0, count, false,
                    cursor, ref init firstName) || firstName.Kind != 2)
            {
                *found = false;
                *error = token.Range;
                return true;
            }
            cursor = cursor + 1;
            while (cursor < scopeEnd)
            {
                init Token segment;
                init Token separator;
                if (!TryGetScalarWindowToken(tokenView, 0, count, false,
                        cursor, ref init separator)
                    || separator.Kind != 54)
                {
                    break;
                }
                cursor = cursor + 1;
                if (!TryGetScalarWindowToken(tokenView, 0, count, false,
                        cursor, ref init segment) || segment.Kind != 2)
                {
                    *found = false;
                    *error = separator.Range;
                    return true;
                }
                cursor = cursor + 1;
            }
            if (!TryGetScalarWindowToken(tokenView, 0, count, false,
                    cursor, ref init opening) || opening.Kind != 48)
            {
                *found = false;
                *error = token.Range;
                return true;
            }
            int32 bodyStart = cursor + 1;
            mut int32 childEnd = bodyStart;
            mut int32 childDepth = 1;
            while (childEnd < scopeEnd && childDepth != 0)
            {
                init Token childToken;
                require TryGetScalarWindowToken(tokenView, 0, count, false,
                    childEnd, ref init childToken);
                if (childToken.Kind == 48) { childDepth = childDepth + 1; }
                if (childToken.Kind == 49) { childDepth = childDepth - 1; }
                childEnd = childEnd + 1;
            }
            if (childDepth != 0)
            {
                *found = false;
                *error = opening.Range;
                return true;
            }
            if (targetTokenStart >= scan && targetTokenStart < childEnd)
            {
                init bool childFound;
                init SourceRange childError;
                var namespaceAliasError
                    = BuildScalarAliasTableForNamespaceParts(
                        tokenView, count, scan, activeAliasCount);
                if (namespaceAliasError.Length != 0)
                {
                    *found = false;
                    *error = namespaceAliasError;
                    return true;
                }
                int32 childAliasCount = Host.FrontendProgram[
                    Host.FrontendProgram.Length - 1];
                if (!TryBuildScalarAliasTableForFunction(tokenView, count,
                        bodyStart, childEnd - 1, targetTokenStart,
                        childAliasCount, true,
                        ref init childFound,
                        ref init childError))
                {
                    return false;
                }
                *found = childFound;
                *error = childError;
                if (!(*found) && (*error).Length == 0)
                {
                    RestoreScalarAliasTable(initialAliasCount);
                }
                return true;
            }
            scan = childEnd;
            continue;
        }
        if (token.Kind == 48) { depth = depth + 1; }
        if (token.Kind == 49) { depth = depth - 1; }
        scan = scan + 1;
    }
    *found = targetTokenStart >= scopeStart && targetTokenStart < scopeEnd;
    *error = empty;
    if (!(*found))
    {
        RestoreScalarAliasTable(initialAliasCount);
    }
    return true;
}

int32 CacheScalarProgramFunctionName(int32 ordinal, SourceRange name)
{
    mut int32 spellingStart = name.Start;
    if (name.Length > 0 && Host.Source[spellingStart] == char16(64))
    {
        spellingStart = spellingStart + 1;
    }
    // Modulo reduction after every UTF-16 unit bounds the polynomial hash for long names.
    mut int32 hash = 0;
    for (mut int32 offset = 0; offset < name.End - spellingStart; offset = offset + 1)
    {
        hash = (hash * 31 + int32(Host.Source[spellingStart + offset])) % 65521;
    }

    mut int32 bucket = hash % 64;
    for (mut int32 probe = 0; probe < 64; probe = probe + 1)
    {
        int32 entry = bucket * 4;
        if (Host.Frontend[entry] == 0)
        {
            Host.Frontend[entry] = ordinal + 1;
            Host.Frontend[entry + 1] = name.Start;
            Host.Frontend[entry + 2] = name.Length;
            Host.Frontend[entry + 3] = hash;
            return -1;
        }
        if (Host.Frontend[entry + 3] == hash)
        {
            init SourceRange cachedName;
            require SourceRange.TryCreate(Host.Frontend[entry + 1],
                Host.Frontend[entry + 2], ref init cachedName);
            if (SameTokenSpelling(new Token(2, cachedName), new Token(2, name)))
            {
                return Host.Frontend[entry] - 1;
            }
        }
        bucket = bucket + 1;
        if (bucket == 64) { bucket = 0; }
    }
    require false;
    return -1;
}

bool ScalarProgramDefersCompletion()
{
    mut bool hasNonReturningFunction = false;
    for (mut int32 index = 0; index < Host.FrontendProgram[2]; index = index + 1)
    {
        int32 header = 8 + index * 780;
        int32 flags = Host.FrontendProgram[header + 2];
        if ((flags & 10) != 0 || Host.FrontendProgram[header + 16] != 0
            || Host.FrontendProgram[header + 17] != 0)
        {
            return false;
        }
        if ((flags & 4) != 0) { hasNonReturningFunction = true; }
    }
    return hasNonReturningFunction;
}

bool ScalarProgramError(int32 code, SourceRange span, ref<init bool> handled)
{
    for (mut int32 index = 0; index < Host.FrontendProgram.Length; index = index + 1)
    {
        Host.FrontendProgram[index] = 0;
    }
    for (mut int32 index = 0; index < Host.Frontend.Length; index = index + 1)
    {
        Host.Frontend[index] = 0;
    }
    Host.Frontend[0] = 87;
    Host.Frontend[1] = 2;
    Host.Frontend[2] = code;
    Host.Frontend[3] = span.Start;
    Host.Frontend[4] = span.Length;
    *handled = true;
    return true;
}

void ClearScalarAliasTable(int32 count)
{
    for (mut int32 word = 0; word <= count * 5; word = word + 1)
    {
        Host.FrontendProgram[Host.FrontendProgram.Length - 1 - word] = 0;
    }
}

void RestoreScalarAliasTable(int32 count)
{
    for (mut int32 aliasIndex = count; aliasIndex < 12; aliasIndex = aliasIndex + 1)
    {
        int32 entry = Host.FrontendProgram.Length - 1 - (aliasIndex + 1) * 5;
        for (mut int32 word = 0; word < 5; word = word + 1)
        {
            Host.FrontendProgram[entry + word] = 0;
        }
    }
    Host.FrontendProgram[Host.FrontendProgram.Length - 1] = count;
}

// Alias scratch follows all 32 function frames, so aliases cannot overwrite a
// final call-target slot when the complete source exceeds the former token bound.
// An empty returned span means the alias table was built successfully.
SourceRange BuildScalarAliasTable(Span<Token> tokenView, int32 count, int32 programDeclarationStart,
    int32 programDeclarationEnd, int32 initialAliasCount,
    int32 duplicateStart, bool resolveAliases,
    write ref<init int32> aliasCount)
{
    init SourceRange empty;
    require SourceRange.TryCreate(0, 0, ref init empty);
    *aliasCount = initialAliasCount;
    Host.FrontendProgram[Host.FrontendProgram.Length - 1] = initialAliasCount;
    mut int32 at = programDeclarationStart;
    while (at < programDeclarationEnd)
    {
        init Token aliasToken;
        init Token opening;
        int32 declarationStart = at;
        mut bool hasAttributes = false;
        while (at < programDeclarationEnd)
        {
            init Token closeAttribute;
            init Token attribute;
            if (!TryGetScalarWindowToken(tokenView, 0, count, false, at,
                    ref init attribute)
                || attribute.Kind != 50)
            {
                break;
            }
            hasAttributes = true;
            at = at + 1;
            while (at < programDeclarationEnd)
            {
                init Token part;
                if (!TryGetScalarWindowToken(tokenView, 0, count, false, at,
                        ref init part)
                    || part.Kind == 51)
                {
                    break;
                }
                at = at + 1;
            }
            if (at >= programDeclarationEnd
                || !TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init closeAttribute)
                || closeAttribute.Kind != 51)
            {
                init Token startToken;
                require TryGetScalarWindowToken(tokenView, 0, count, false,
                    declarationStart, ref init startToken);
                return startToken.Range;
            }
            at = at + 1;
        }

        mut int32 visibility = 0;
        while (at < programDeclarationEnd)
        {
            init Token modifier;
            if (!TryGetScalarWindowToken(tokenView, 0, count, false, at,
                    ref init modifier)
                || modifier.Kind != 7 && modifier.Kind != 8)
            {
                break;
            }
            if (visibility != 0)
            {
                return modifier.Range;
            }
            visibility = modifier.Kind;
            at = at + 1;
        }

        if (at < programDeclarationEnd
            && TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init aliasToken)
            && aliasToken.Kind == 102)
        {
            init Token name;
            init Token equals;
            init Token target;
            init Token semicolon;
            if (hasAttributes || visibility == 7)
            {
                return aliasToken.Range;
            }
            if (*aliasCount == 12)
            {
                return aliasToken.Range;
            }
            at = at + 1;
            if (!TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init name)
                || name.Kind != 2
                || !TryGetScalarWindowToken(tokenView, 0, count, false, at + 1, ref init equals)
                || equals.Kind != 64
                || !TryGetScalarWindowToken(tokenView, 0, count, false, at + 2, ref init target)
                || target.Kind != 2
                || !TryGetScalarWindowToken(tokenView, 0, count, false, at + 3, ref init semicolon)
                || semicolon.Kind != 52)
            {
                return aliasToken.Range;
            }
            for (mut int32 index = duplicateStart; index < *aliasCount;
                index = index + 1)
            {
                init SourceRange priorName;
                int32 entry = Host.FrontendProgram.Length - 1 - (index + 1) * 5;
                require SourceRange.TryCreate(Host.FrontendProgram[entry],
                    Host.FrontendProgram[entry + 1], ref init priorName);
                if (SameTokenSpelling(name, new Token(2, priorName)))
                {
                    return name.Range;
                }
            }
            int32 entry = Host.FrontendProgram.Length - 1 - (*aliasCount + 1) * 5;
            Host.FrontendProgram[entry] = name.Range.Start;
            Host.FrontendProgram[entry + 1] = name.Range.Length;
            Host.FrontendProgram[entry + 2] = target.Range.Start;
            Host.FrontendProgram[entry + 3] = target.Range.Length;
            Host.FrontendProgram[entry + 4] = 0;
            *aliasCount = *aliasCount + 1;
            at = at + 4;
            continue;
        }

        at = declarationStart;
        mut int32 body = at;
        while (body < programDeclarationEnd)
        {
            init Token headerToken;
            if (!TryGetScalarWindowToken(tokenView, 0, count, false, body,
                    ref init headerToken)
                || headerToken.Kind == 82 || headerToken.Kind == 48)
            {
                break;
            }
            body = body + 1;
        }
        if (body >= programDeclarationEnd)
        {
            init Token startToken;
            require TryGetScalarWindowToken(tokenView, 0, count, false, at,
                ref init startToken);
            return startToken.Range;
        }
        require TryGetScalarWindowToken(tokenView, 0, count, false, body, ref init opening);
        if (opening.Kind == 82)
        {
            at = body + 1;
            while (at < programDeclarationEnd)
            {
                init Token arrowToken;
                if (!TryGetScalarWindowToken(tokenView, 0, count, false, at,
                        ref init arrowToken)
                    || arrowToken.Kind == 52)
                {
                    break;
                }
                at = at + 1;
            }
            if (at >= programDeclarationEnd)
            {
                return opening.Range;
            }
            at = at + 1;
        }
        else
        {
            mut int32 depth = 1;
            at = body + 1;
            while (at < programDeclarationEnd && depth != 0)
            {
                init Token blockToken;
                require TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init blockToken);
                if (blockToken.Kind == 48) { depth = depth + 1; }
                if (blockToken.Kind == 49) { depth = depth - 1; }
                at = at + 1;
            }
            if (depth != 0)
            {
                return opening.Range;
            }
        }
    }

    Host.FrontendProgram[Host.FrontendProgram.Length - 1] = *aliasCount;
    return resolveAliases
        ? ResolveScalarAliases(*aliasCount, duplicateStart) : empty;
}

SourceRange ResolveScalarAliases(int32 aliasCount,
    int32 firstAliasToResolve)
{
    init SourceRange empty;
    require SourceRange.TryCreate(0, 0, ref init empty);
    require Host.FrontendProgram.Length == 25025 && aliasCount >= 0
        && aliasCount <= 12 && firstAliasToResolve >= 0
        && firstAliasToResolve <= aliasCount;
    for (mut int32 index = firstAliasToResolve; index < aliasCount;
        index = index + 1)
    {
        var errorSpan = ResolveScalarAlias(index, 0, aliasCount);
        if (errorSpan.Length != 0)
        {
            return errorSpan;
        }
    }
    return empty;
}

SourceRange ResolveScalarAlias(int32 index, int32 depth, int32 aliasCount)
{
    init SourceRange empty;
    init SourceRange nameSpan;
    init SourceRange targetSpan;
    init int32 primitive;
    require SourceRange.TryCreate(0, 0, ref init empty);
    require Host.FrontendProgram.Length == 25025 && aliasCount >= 0 && aliasCount <= 12
        && index >= 0 && index < aliasCount;
    int32 entry = Host.FrontendProgram.Length - 1 - (index + 1) * 5;
    require entry >= 0 && entry + 4 < Host.FrontendProgram.Length;
    int32 selected = Host.FrontendProgram[entry + 4];
    if (selected > 0 && selected <= 8)
    {
        return empty;
    }
    require SourceRange.TryCreate(Host.FrontendProgram[entry],
        Host.FrontendProgram[entry + 1], ref init nameSpan);
    if (selected != 0 || depth >= 12)
    {
        return nameSpan;
    }
    Host.FrontendProgram[entry + 4] = -1;
    require SourceRange.TryCreate(Host.FrontendProgram[entry + 2],
        Host.FrontendProgram[entry + 3], ref init targetSpan);
    var target = new Token(2, targetSpan);
    if (TryGetPrimitiveScalarType(target, ref init primitive))
    {
        Host.FrontendProgram[entry + 4] = primitive;
        return empty;
    }
    for (mut int32 candidate = aliasCount - 1; candidate >= 0;
        candidate = candidate - 1)
    {
        init SourceRange candidateName;
        int32 candidateEntry = Host.FrontendProgram.Length - 1 - (candidate + 1) * 5;
        require candidateEntry >= 0 && candidateEntry + 4 < Host.FrontendProgram.Length;
        require SourceRange.TryCreate(Host.FrontendProgram[candidateEntry],
            Host.FrontendProgram[candidateEntry + 1], ref init candidateName);
        if (SameTokenSpelling(target, new Token(2, candidateName)))
        {
            var errorSpan = ResolveScalarAlias(candidate, depth + 1,
                aliasCount);
            if (errorSpan.Length != 0)
            {
                return errorSpan;
            }
            Host.FrontendProgram[entry + 4] =
                Host.FrontendProgram[candidateEntry + 4];
            return empty;
        }
    }
    return targetSpan;
}

bool TrySkipScalarAlias(Span<Token> tokenView, int32 count, int32 programEnd,
    int32 start, ref<init int32> end)
{
    init Token aliasToken;
    mut int32 at = start;
    while (at < programEnd)
    {
        init Token modifier;
        if (!TryGetScalarWindowToken(tokenView, 0, count, false, at,
                ref init modifier)
            || modifier.Kind != 7 && modifier.Kind != 8)
        {
            break;
        }
        at = at + 1;
    }
    if (at >= programEnd
        || !TryGetScalarWindowToken(tokenView, 0, count, false, at, ref init aliasToken)
        || aliasToken.Kind != 102)
    {
        return false;
    }
    while (at < programEnd)
    {
        init Token token;
        if (!TryGetScalarWindowToken(tokenView, 0, count, false, at,
                ref init token)
            || token.Kind == 52)
        {
            break;
        }
        at = at + 1;
    }
    if (at >= programEnd)
    {
        return false;
    }
    at = at + 1;
    *end = at;
    return true;
}

bool TryPublishScalarFrontendProgram(Span<Token> tokenView, int32 count,
    SourceRange spacingError, ref<init bool> handled)
{
    init SourceRange empty;
    for (mut int32 word = 0; word < Host.FrontendProgram.Length; word = word + 1)
    {
        Host.FrontendProgram[word] = 0;
    }
    if (spacingError.Length != 0) { return ScalarProgramError(1, spacingError, ref init *handled); }
    require SourceRange.TryCreate(0, 0, ref init empty);
    mut bool hasNamespace = false;
    mut SourceRange namespaceName = empty;
    mut int32 aliasCount = 0;
    mut int32 functions = 0;
    mut bool hasFourParameterFunction = false;
    bool hasBlockNamespace = CountScalarProgramNamespaces(tokenView, count) > 0
        && !ScalarProgramHasFileScopedNamespace(tokenView, count);
    if (hasBlockNamespace)
    {
        init int32 repeatedFunctions;
        init bool repeatedHasFourParameterFunction;
        init SourceRange repeatedNamespaceName;
        init int32 repeatedAliasCount;
        init SourceRange repeatedError;
        init int32 repeatedErrorCode;
        if (!TryInventoryRepeatedScalarProgramNamespaceBlocks(tokenView, count,
                ref init repeatedFunctions, ref init repeatedHasFourParameterFunction,
            ref init repeatedNamespaceName, ref init repeatedAliasCount,
                ref init repeatedError, ref init repeatedErrorCode))
        {
            return false;
        }
        if (repeatedError.Length != 0)
        {
            return ScalarProgramError(repeatedErrorCode, repeatedError, ref init *handled);
        }
        functions = repeatedFunctions;
        hasFourParameterFunction = repeatedHasFourParameterFunction;
        namespaceName = repeatedNamespaceName;
        aliasCount = repeatedAliasCount;
        hasNamespace = true;
    }
    else
    {
        init bool singleHasNamespace;
        init int32 declarationStart;
        init int32 declarationEnd;
        init SourceRange singleNamespaceName;
        init int32 singleAliasCount;
        var namespaceError = ReadScalarProgramNamespace(tokenView, count,
            ref init singleHasNamespace, ref init declarationStart,
            ref init declarationEnd, ref init singleNamespaceName);
        if (namespaceError.Length != 0)
        {
            return ScalarProgramError(1, namespaceError, ref init *handled);
        }
        hasNamespace = singleHasNamespace;
        namespaceName = singleNamespaceName;
        var aliasError = BuildScalarAliasTable(tokenView, count, declarationStart,
            declarationEnd, 0, 0, true, ref init singleAliasCount);
        if (aliasError.Length != 0)
        {
            return ScalarProgramError(1, aliasError, ref init *handled);
        }
        aliasCount = singleAliasCount;
        mut int32 start = declarationStart;
        while (start < declarationEnd)
        {
            init int32 afterAlias;
            init ScalarFrontendResult header;
            init int32 headerEnd;
            init Token opening;
            init Token first;
            init Token last;
            if (TrySkipScalarAlias(tokenView, count, declarationEnd, start, ref init afterAlias))
            {
                start = afterAlias;
                continue;
            }
            if (!ScalarFrontendState.TryCreate(start, count - 1, true, empty, out var probe)
                || !probe.TryInventoryHeader(ref init header, ref init headerEnd, tokenView))
            {
                return false;
            }
            if (!header.IsValid)
            {
                // A single declaration retains the legacy parser's diagnostics.
                if (functions == 0 && aliasCount == 0 && !hasNamespace)
                {
                    for (mut int32 word = 0; word < Host.Frontend.Length; word = word + 1) { Host.Frontend[word] = 0; }
                    *handled = false;
                    return true;
                }
                return ScalarProgramError(header.ErrorCode, header.ErrorSpan, ref init *handled);
            }
            if (header.ParameterCount == 4) { hasFourParameterFunction = true; }
            int32 body = start + headerEnd;
            require TryGetScalarWindowToken(tokenView, 0, count, false, body, ref init opening);
            mut int32 end = body;
            if (opening.Kind == 82)
            {
                while (end < declarationEnd)
                {
                    init Token token;
                    require TryGetScalarWindowToken(tokenView, 0, count, false, end, ref init token);
                    end = end + 1;
                    if (token.Kind == 52) { break; }
                }
            }
            else if (opening.Kind == 48)
            {
                mut int32 depth = 1;
                end = body + 1;
                while (end < declarationEnd && depth != 0)
                {
                    init Token token;
                    require TryGetScalarWindowToken(tokenView, 0, count, false, end, ref init token);
                    if (token.Kind == 48) { depth = depth + 1; }
                    if (token.Kind == 49) { depth = depth - 1; }
                    end = end + 1;
                }
                if (depth != 0) { return ScalarProgramError(1, opening.Range, ref init *handled); }
            }
            else
            {
                return ScalarProgramError(1, opening.Range, ref init *handled);
            }
            if (functions == 32) { return ScalarProgramError(1, header.Name, ref init *handled); }
            int32 frame = 4 + functions * 780;
            require TryGetScalarWindowToken(tokenView, 0, count, false, start, ref init first);
            require TryGetScalarWindowToken(tokenView, 0, count, false, end - 1, ref init last);
            Host.FrontendProgram[frame] = start;
            Host.FrontendProgram[frame + 1] = end;
            Host.FrontendProgram[frame + 2] = first.Range.Start;
            Host.FrontendProgram[frame + 3] = last.Range.End - first.Range.Start;
            WriteScalarFrontendHeader(header, true);
            Host.Frontend[5] = header.ReturnType;
            for (mut int32 word = 0; word < 37; word = word + 1)
            {
                Host.FrontendProgram[frame + 4 + word] = Host.Frontend[word];
                Host.Frontend[word] = 0;
            }
            Host.FrontendProgram[frame + 4 + 21] = namespaceName.Start;
            Host.FrontendProgram[frame + 4 + 22] = namespaceName.Length;
            functions = functions + 1;
            start = end;
        }
    }
    mut bool hasSwitch = false;
    for (mut int32 index = 0; index < count - 1; index = index + 1)
    {
        init Token token;
        require TryGetScalarWindowToken(tokenView, 0, count, false, index, ref init token);
        if (token.Kind == 35) { hasSwitch = true; }
    }
    if (functions == 0 && hasNamespace)
    {
        return ScalarProgramError(1, namespaceName, ref init *handled);
    }
    if (functions == 0 || functions < 2 && aliasCount == 0 && !hasSwitch
        && !hasFourParameterFunction && !hasNamespace)
    {
        for (mut int32 word = 0; word < Host.FrontendProgram.Length; word = word + 1)
        {
            Host.FrontendProgram[word] = 0;
        }
        *handled = false;
        return true;
    }
    Host.FrontendProgram[0] = 88;
    Host.FrontendProgram[2] = functions;
    for (mut int32 index = 0; index < functions; index = index + 1)
    {
        for (mut int32 node = 0; node < 64; node = node + 1)
        {
            Host.FrontendProgram[4 + index * 780 + 716 + node] = -1;
        }
    }
    // Sixty-four buckets keep this temporary span/ordinal index at or below half load.
    for (mut int32 word = 0; word < 256; word = word + 1) { Host.Frontend[word] = 0; }
    for (mut int32 index = 0; index < functions; index = index + 1)
    {
        init SourceRange name;
        int32 header = 8 + index * 780;
        require SourceRange.TryCreate(Host.FrontendProgram[header + 9],
            Host.FrontendProgram[header + 10], ref init name);
        if (CacheScalarProgramFunctionName(index, name) >= 0)
        {
            return ScalarProgramError(4, name, ref init *handled);
        }
    }
    for (mut int32 word = 0; word < 256; word = word + 1) { Host.Frontend[word] = 0; }
    if (!TokenIntegerSnapshot.TryValidate(count))
    {
        return false;
    }
    for (mut int32 index = 0; index < functions; index = index + 1)
    {
        init ScalarFrontendResult treeResult;
        init SourceRange functionNamespaceName;
        int32 frame = 4 + index * 780;
        Host.FrontendProgram[3] = index;
        for (mut int32 word = 0; word < Host.Frontend.Length; word = word + 1) { Host.Frontend[word] = 0; }
        int32 tokenStart = Host.FrontendProgram[frame];
        int32 tokenEnd = Host.FrontendProgram[frame + 1];
        if (aliasCount != 0 && hasBlockNamespace)
        {
            init bool foundAliasScope;
            init SourceRange aliasScopeError;
            RestoreScalarAliasTable(0);
            if (!TryBuildScalarAliasTableForFunction(tokenView, count, 0,
                    count - 1, tokenStart, 0, false,
                    ref init foundAliasScope,
                    ref init aliasScopeError))
            {
                return false;
            }
            if (aliasScopeError.Length != 0)
            {
                return ScalarProgramError(1, aliasScopeError, ref init *handled);
            }
            if (!foundAliasScope)
            {
                init Token functionToken;
                require TryGetScalarWindowToken(tokenView, 0, count, false,
                    tokenStart, ref init functionToken);
                return ScalarProgramError(1, functionToken.Range, ref init *handled);
            }
        }
        if (!ScalarFrontendState.TryCreate(tokenStart, tokenEnd, true, empty, out var tree)
            || !tree.TryParseTree(ref init treeResult, tokenView))
        {
            return false;
        }
        mut ScalarFrontendResult result = treeResult;
        if (!result.IsValid)
        {
            init ScalarFrontendResult completed;
            for (mut int32 word = 0; word < Host.Frontend.Length; word = word + 1) { Host.Frontend[word] = 0; }
            for (mut int32 node = 0; node < 64; node = node + 1)
            {
                Host.FrontendProgram[frame + 4 + 712 + node] = -1;
            }
            if (!ScalarFrontendState.TryCreate(tokenStart, tokenEnd, true, empty, out var structured)
                || !structured.TryParseStructuredReturns(ref init completed, tokenView))
            {
                return false;
            }
            result = completed;
        }
        if (!result.IsValid)
        {
            return ScalarProgramError(result.ErrorCode, result.ErrorSpan, ref init *handled);
        }
        WriteScalarFrontendHeader(result, true);
        Host.Frontend[0] = 88;
        Host.Frontend[1] = 1;
        Host.Frontend[5] = result.ReturnType;
        require SourceRange.TryCreate(Host.FrontendProgram[frame + 4 + 21],
            Host.FrontendProgram[frame + 4 + 22], ref init functionNamespaceName);
        Host.Frontend[21] = functionNamespaceName.Start;
        Host.Frontend[22] = functionNamespaceName.Length;
        Host.Frontend[15] = result.HasCondition ? (result.HasFallthrough ? 2 : 1) : 0;
        for (mut int32 word = 0; word < 712; word = word + 1)
        {
            Host.FrontendProgram[frame + 4 + word] = Host.Frontend[word];
        }
        if (aliasCount != 0 && hasBlockNamespace)
        {
            RestoreScalarAliasTable(0);
        }
    }
    for (mut int32 word = 0; word < Host.Frontend.Length; word = word + 1) { Host.Frontend[word] = 0; }
    // Clear temporary alias entries before publishing the complete-program buffer.
    if (aliasCount != 0) { ClearScalarAliasTable(aliasCount); }
    Host.FrontendProgram[1] = 1;
    Host.FrontendProgram[3] = 0;
    *handled = true;
    return true;
}
