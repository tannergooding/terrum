namespace Terrum.CodeAnalysis;

bool ValidateStandaloneDecoderBuffers()
{
    int32 methodCapacity
        = Host.StandaloneDecoderMethods.Length / 16;
    int32 bodyCapacity
        = Host.StandaloneDecoderBodies.Length / 34;
    int32 importCapacity
        = Host.StandaloneDecoderImportedCallables.Length / 16;
    return Host.StandaloneDecoderStatus.Length == 1
        && Host.StandaloneModuleDirectoryMode.Length == 1
        && Host.StandaloneModuleDirectoryMode[0] == 1
        && Host.StandaloneDecoderSelectedModuleId.Length == 1
        && Host.StandaloneDecoderMethodCount.Length == 1
        && Host.StandaloneDecoderMethods.Length % 16 == 0
        && Host.StandaloneDecoderBodyCount.Length == 1
        && Host.StandaloneDecoderBodies.Length % 34 == 0
        && bodyCapacity <= methodCapacity
        && Host.StandaloneDecoderBodyOwners.Length > 0
        && Host.StandaloneDecoderBodyOwnershipValidated.Length
            == Host.StandaloneRequest[4]
        && Host.StandaloneDecoderHomeCount.Length == 1
        && Host.StandaloneDecoderHomes.Length % 3 == 0
        && Host.StandaloneDecoderFormalHomeBodies.Length > 0
        && Host.StandaloneDecoderTypeMapCount.Length == 1
        && Host.StandaloneDecoderTypeMapTypeIds.Length > 0
        && Host.StandaloneDecoderMethodMapCount.Length == 1
        && Host.StandaloneDecoderMethodMapTargets.Length % 4 == 0
        && Host.StandaloneDecoderConstantMapCount.Length == 1
        && Host.StandaloneDecoderConstantMapEntries.Length % 3 == 0
        && Host.StandaloneDecoderCallCount.Length == 1
        && Host.StandaloneDecoderTargetPlanBuilt.Length == 1
        && Host.StandaloneDecoderTargetBodiesValidated.Length == 1
        && Host.StandaloneDecoderCalls.Length % 22 == 0
        && Host.StandaloneDecoderCallInputCount.Length == 1
        && Host.StandaloneDecoderCallInputs.Length % 4 == 0
        && Host.StandaloneDecoderRegisterTypeIds.Length % 14 == 0
        && Host.StandaloneDecoderRegisterTypeIds.Length / 14
            >= bodyCapacity
        && Host.StandaloneDecoderLocalCallableCount.Length == 1
        && Host.StandaloneDecoderLocalCallables.Length % 4 == 0
        && Host.StandaloneDecoderImportedCallableCount.Length == 1
        && Host.StandaloneDecoderImportedCallables.Length % 16 == 0
        && Host.StandaloneDecoderImportMapCount.Length == 1
        && Host.StandaloneDecoderImportMap.Length % 4 == 0
        && Host.StandaloneDecoderExpectedGroupCallableIds.Length
            == Host.StandaloneResolvedImports.Length / 32 + 1
        && Host.StandaloneDecoderExpectedGroupRepresentativeImportIds.Length
            == Host.StandaloneResolvedImports.Length / 32 + 1
        && Host.StandaloneDecoderMethodLookupSlots.Length
            == methodCapacity * 2 + 1
        && Host.StandaloneDecoderImportLookupSlots.Length
            == importCapacity * 2 + 1
        && Host.StandaloneDecoderModuleLookupSlots.Length
            == Host.StandaloneModuleDirectory.Length / 8 * 2 + 1
        && Host.StandaloneMethodRoots.Length == 0
        && Host.StandaloneResolvedRoots.Length == 0;
}

void ClearStandaloneDecoderOutputs()
{
    Host.StandaloneDecoderStatus[0] = 0;
    Host.StandaloneDecoderSelectedModuleId[0] = -1;
    Host.StandaloneDecoderMethodCount[0] = 0;
    Host.StandaloneDecoderBodyCount[0] = 0;
    Host.StandaloneDecoderHomeCount[0] = 0;
    Host.StandaloneDecoderTypeMapCount[0] = 0;
    Host.StandaloneDecoderMethodMapCount[0] = 0;
    Host.StandaloneDecoderConstantMapCount[0] = 0;
    Host.StandaloneDecoderCallCount[0] = 0;
    Host.StandaloneDecoderTargetPlanBuilt[0] = 0;
    Host.StandaloneDecoderTargetBodiesValidated[0] = 0;
    Host.StandaloneDecoderCallInputCount[0] = 0;
    Host.StandaloneDecoderLocalCallableCount[0] = 0;
    Host.StandaloneDecoderImportedCallableCount[0] = 0;
    Host.StandaloneDecoderImportMapCount[0] = 0;

    for (mut int32 index = 0;
        index < Host.StandaloneDecoderMethods.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderMethods[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderBodies.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderBodies[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderBodyOwners.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderBodyOwners[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderBodyOwnershipValidated.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderBodyOwnershipValidated[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderHomes.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderHomes[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderFormalHomeBodies.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderFormalHomeBodies[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderTypeMapTypeIds.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderTypeMapTypeIds[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderMethodMapTargets.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderMethodMapTargets[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderConstantMapEntries.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderConstantMapEntries[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderCalls.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderCalls[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderCallInputs.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderCallInputs[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderRegisterTypeIds.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderRegisterTypeIds[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderLocalCallables.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderLocalCallables[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderImportedCallables.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderImportedCallables[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderImportMap.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderImportMap[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderExpectedGroupCallableIds.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderExpectedGroupCallableIds[index] = -1;
        Host.StandaloneDecoderExpectedGroupRepresentativeImportIds[index]
            = -1;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderMethodLookupSlots.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderMethodLookupSlots[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderImportLookupSlots.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderImportLookupSlots[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneDecoderModuleLookupSlots.Length;
        index = index + 1)
    {
        Host.StandaloneDecoderModuleLookupSlots[index] = 0;
    }
}

int32 GetStandaloneDecoderModuleHash(int32 artifactOrdinal,
    int32 moduleRow)
{
    mut int32 hash = 0x6A09_E667;
    hash = ((hash << 5) | (hash >>> 27)) ^ artifactOrdinal;
    hash = ((hash << 5) | (hash >>> 27)) ^ moduleRow;
    return hash;
}

int32 BuildStandaloneDecoderModuleLookup()
{
    int32 moduleCount = Host.StandaloneModuleCount[0];
    int32 capacity
        = Host.StandaloneDecoderModuleLookupSlots.Length;
    if (moduleCount <= 0
        || moduleCount > Host.StandaloneModuleDirectory.Length / 8
        || capacity <= 0)
    {
        return 3;
    }

    for (mut int32 directoryRow = 1;
        directoryRow <= moduleCount;
        directoryRow = directoryRow + 1)
    {
        int32 offset = directoryRow * 8;
        int32 artifactOrdinal
            = Host.StandaloneModuleDirectory[offset];
        int32 moduleRow
            = Host.StandaloneModuleDirectory[offset + 1];
        if (artifactOrdinal < 0 || moduleRow <= 0
            || artifactOrdinal >= Host.StandaloneRequest[4])
        {
            return 3;
        }

        int32 slot = GetStandaloneDecoderHashSlot(
            GetStandaloneDecoderModuleHash(artifactOrdinal, moduleRow),
            capacity);
        if (slot < 0)
        {
            return 3;
        }
        mut bool inserted = false;
        for (mut int32 probe = 0;
            probe < capacity;
            probe = probe + 1)
        {
            int32 storedRow
                = Host.StandaloneDecoderModuleLookupSlots[slot];
            if (storedRow == 0)
            {
                Host.StandaloneDecoderModuleLookupSlots[slot]
                    = directoryRow;
                inserted = true;
                break;
            }
            int32 storedOffset = storedRow * 8;
            if (Host.StandaloneModuleDirectory[storedOffset]
                    == artifactOrdinal
                && Host.StandaloneModuleDirectory[storedOffset + 1]
                    == moduleRow)
            {
                return 3;
            }
            slot = slot + 1;
            if (slot == capacity)
            {
                slot = 0;
            }
        }
        if (!inserted)
        {
            return 3;
        }
    }
    return 0;
}

int32 FindStandaloneDecoderModuleDirectoryRow(int32 artifactOrdinal,
    int32 moduleRow)
{
    int32 capacity
        = Host.StandaloneDecoderModuleLookupSlots.Length;
    if (artifactOrdinal < 0
        || artifactOrdinal >= Host.StandaloneRequest[4]
        || moduleRow <= 0 || capacity <= 0)
    {
        return 0;
    }

    int32 slot = GetStandaloneDecoderHashSlot(
        GetStandaloneDecoderModuleHash(artifactOrdinal, moduleRow),
        capacity);
    if (slot < 0)
    {
        return 0;
    }
    for (mut int32 probe = 0;
        probe < capacity;
        probe = probe + 1)
    {
        int32 directoryRow
            = Host.StandaloneDecoderModuleLookupSlots[slot];
        if (directoryRow == 0)
        {
            return 0;
        }
        int32 offset = directoryRow * 8;
        if (Host.StandaloneModuleDirectory[offset] == artifactOrdinal
            && Host.StandaloneModuleDirectory[offset + 1] == moduleRow)
        {
            return directoryRow;
        }
        slot = slot + 1;
        if (slot == capacity)
        {
            slot = 0;
        }
    }
    return 0;
}

int32 GetStandaloneDecoderImportHash(int32 artifactOrdinal,
    int32 moduleRow, int32 importRow)
{
    mut int32 hash = 0x51ED_270B;
    hash = ((hash << 5) | (hash >>> 27)) ^ artifactOrdinal;
    hash = ((hash << 5) | (hash >>> 27)) ^ moduleRow;
    hash = ((hash << 5) | (hash >>> 27)) ^ importRow;
    return hash;
}

int32 GetStandaloneDecoderMethodHash(int32 moduleId, int32 methodDefRow)
{
    mut int32 hash = 0x2C1B_3C6D;
    hash = ((hash << 5) | (hash >>> 27)) ^ moduleId;
    hash = ((hash << 5) | (hash >>> 27)) ^ methodDefRow;
    return hash;
}

int32 GetStandaloneDecoderHashSlot(int32 hash, int32 capacity)
{
    if (capacity <= 0)
    {
        return -1;
    }
    return int32(uint32(hash) % uint32(capacity));
}

int32 AddStandaloneDecoderMethodLookup(int32 moduleId,
    int32 methodDefRow, int32 methodRecordId)
{
    int32 capacity
        = Host.StandaloneDecoderMethodLookupSlots.Length;
    if (moduleId < 0 || methodDefRow <= 0 || methodRecordId < 0
        || methodRecordId >= Host.StandaloneDecoderMethods.Length / 16
        || capacity <= 0)
    {
        return 3;
    }
    int32 hash
        = GetStandaloneDecoderMethodHash(moduleId, methodDefRow);
    int32 slot = GetStandaloneDecoderHashSlot(hash, capacity);
    if (slot < 0)
    {
        return 3;
    }

    for (mut int32 probe = 0;
        probe < capacity;
        probe = probe + 1)
    {
        int32 storedMethod
            = Host.StandaloneDecoderMethodLookupSlots[slot];
        if (storedMethod == 0)
        {
            Host.StandaloneDecoderMethodLookupSlots[slot]
                = methodRecordId + 1;
            return 0;
        }
        int32 storedOffset = (storedMethod - 1) * 16;
        if (Host.StandaloneDecoderMethods[storedOffset] == moduleId
            && Host.StandaloneDecoderMethods[storedOffset + 3]
                == methodDefRow)
        {
            return 3;
        }
        slot = slot + 1;
        if (slot == capacity)
        {
            slot = 0;
        }
    }
    return 3;
}

int32 FindStandaloneDecoderMethodRecord(int32 moduleId,
    int32 methodDefRow)
{
    int32 capacity
        = Host.StandaloneDecoderMethodLookupSlots.Length;
    if (moduleId < 0 || methodDefRow <= 0 || capacity <= 0)
    {
        return -1;
    }
    int32 hash
        = GetStandaloneDecoderMethodHash(moduleId, methodDefRow);
    int32 slot = GetStandaloneDecoderHashSlot(hash, capacity);
    if (slot < 0)
    {
        return -1;
    }

    for (mut int32 probe = 0;
        probe < capacity;
        probe = probe + 1)
    {
        int32 storedMethod
            = Host.StandaloneDecoderMethodLookupSlots[slot];
        if (storedMethod == 0)
        {
            return -1;
        }
        int32 methodRecordId = storedMethod - 1;
        int32 storedOffset = methodRecordId * 16;
        if (Host.StandaloneDecoderMethods[storedOffset] == moduleId
            && Host.StandaloneDecoderMethods[storedOffset + 3]
                == methodDefRow)
        {
            return methodRecordId;
        }
        slot = slot + 1;
        if (slot == capacity)
        {
            slot = 0;
        }
    }
    return -1;
}

int32 AddStandaloneDecoderImportMap(int32 artifactOrdinal,
    int32 moduleRow, int32 importRow, int32 catalogOrdinal)
{
    int32 mapCount = Host.StandaloneDecoderImportMapCount[0];
    int32 mapCapacity
        = Host.StandaloneDecoderImportMap.Length / 4;
    int32 slotCapacity
        = Host.StandaloneDecoderImportLookupSlots.Length;
    if (mapCount < 0 || mapCount >= mapCapacity
        || slotCapacity <= 0 || artifactOrdinal < 0
        || moduleRow <= 0 || importRow <= 0 || catalogOrdinal < 0)
    {
        return 3;
    }

    int32 hash
        = GetStandaloneDecoderImportHash(artifactOrdinal,
            moduleRow, importRow);
    int32 slot = GetStandaloneDecoderHashSlot(hash, slotCapacity);
    if (slot < 0)
    {
        return 3;
    }
    for (mut int32 probe = 0;
        probe < slotCapacity;
        probe = probe + 1)
    {
        int32 storedImport
            = Host.StandaloneDecoderImportLookupSlots[slot];
        if (storedImport == 0)
        {
            int32 mapOffset = mapCount * 4;
            Host.StandaloneDecoderImportMap[mapOffset]
                = artifactOrdinal;
            Host.StandaloneDecoderImportMap[mapOffset + 1]
                = moduleRow;
            Host.StandaloneDecoderImportMap[mapOffset + 2]
                = importRow;
            Host.StandaloneDecoderImportMap[mapOffset + 3]
                = catalogOrdinal;
            Host.StandaloneDecoderImportLookupSlots[slot]
                = mapCount + 1;
            Host.StandaloneDecoderImportMapCount[0] = mapCount + 1;
            return 0;
        }

        int32 storedOffset = (storedImport - 1) * 4;
        if (Host.StandaloneDecoderImportMap[storedOffset]
                == artifactOrdinal
            && Host.StandaloneDecoderImportMap[storedOffset + 1]
                == moduleRow
            && Host.StandaloneDecoderImportMap[storedOffset + 2]
                == importRow)
        {
            return 3;
        }
        slot = slot + 1;
        if (slot == slotCapacity)
        {
            slot = 0;
        }
    }
    return 3;
}

int32 FindStandaloneDecoderImport(int32 artifactOrdinal,
    int32 moduleRow, int32 importRow)
{
    int32 slotCapacity
        = Host.StandaloneDecoderImportLookupSlots.Length;
    if (artifactOrdinal < 0
        || artifactOrdinal >= Host.StandaloneRequest[4]
        || moduleRow <= 0 || importRow <= 0 || slotCapacity <= 0)
    {
        return -1;
    }
    int32 hash
        = GetStandaloneDecoderImportHash(artifactOrdinal,
            moduleRow, importRow);
    int32 slot = GetStandaloneDecoderHashSlot(hash, slotCapacity);
    if (slot < 0)
    {
        return -1;
    }
    for (mut int32 probe = 0;
        probe < slotCapacity;
        probe = probe + 1)
    {
        int32 storedImport
            = Host.StandaloneDecoderImportLookupSlots[slot];
        if (storedImport == 0)
        {
            return -1;
        }
        int32 mapOffset = (storedImport - 1) * 4;
        if (Host.StandaloneDecoderImportMap[mapOffset]
                == artifactOrdinal
            && Host.StandaloneDecoderImportMap[mapOffset + 1]
                == moduleRow
            && Host.StandaloneDecoderImportMap[mapOffset + 2]
                == importRow)
        {
            return Host.StandaloneDecoderImportMap[mapOffset + 3];
        }
        slot = slot + 1;
        if (slot == slotCapacity)
        {
            slot = 0;
        }
    }
    return -1;
}

int32 FindStandaloneDecoderExpectedGroup(int32 artifactOrdinal,
    int32 moduleRow, int32 methodDefRow)
{
    int32 importCount = Host.StandaloneDecoderImportedCallableCount[0];
    if (artifactOrdinal < 0
        || artifactOrdinal >= Host.StandaloneRequest[4]
        || moduleRow <= 0 || methodDefRow <= 0
        || importCount < 0
        || importCount
            > Host.StandaloneResolvedExpectedImportOrder.Length)
    {
        return -1;
    }

    mut int32 low = 1;
    mut int32 high = importCount;
    while (low <= high)
    {
        int32 middle = low + (high - low) / 2;
        int32 catalogOrdinal
            = Host.StandaloneResolvedExpectedImportOrder[middle] - 1;
        if (catalogOrdinal < 0 || catalogOrdinal >= importCount)
        {
            return -1;
        }
        int32 offset = catalogOrdinal * 32;
        int32 candidateArtifact
            = Host.StandaloneResolvedImports[offset];
        int32 candidateModule
            = Host.StandaloneResolvedImports[offset + 1];
        int32 candidateMethod
            = Host.StandaloneResolvedImports[offset + 5];
        if (candidateArtifact == artifactOrdinal
            && candidateModule == moduleRow
            && candidateMethod == methodDefRow)
        {
            int32 expectedGroupId
                = Host.StandaloneResolvedImports[offset + 20];
            return expectedGroupId > 0
                && expectedGroupId
                    <= Host.StandaloneResolvedExpectedImportCount[0]
                ? expectedGroupId : -1;
        }
        if (candidateArtifact < artifactOrdinal
            || (candidateArtifact == artifactOrdinal
                && candidateModule < moduleRow)
            || (candidateArtifact == artifactOrdinal
                && candidateModule == moduleRow
                && candidateMethod < methodDefRow))
        {
            low = middle + 1;
        }
        else
        {
            high = middle - 1;
        }
    }
    return 0;
}

int32 GetStandaloneDecoderRepresentativeImportId(int32 expectedGroupId)
{
    if (expectedGroupId <= 0
        || expectedGroupId
            >= Host.StandaloneDecoderExpectedGroupCallableIds.Length)
    {
        return -1;
    }

    int32 importId
        = Host.StandaloneDecoderExpectedGroupRepresentativeImportIds[
            expectedGroupId];
    if (importId < 0
        || importId
            >= Host.StandaloneDecoderImportedCallableCount[0]
        || Host.StandaloneDecoderImportedCallables[
            importId * 16 + 3]
            != Host.StandaloneDecoderExpectedGroupCallableIds[
                expectedGroupId])
    {
        return -1;
    }
    return importId;
}

int32 BuildStandaloneDecoderImportedCallables()
{
    int32 importCount = Host.StandaloneResolvedImportCount[0];
    int32 expectedImportCount
        = Host.StandaloneResolvedExpectedImportCount[0];
    int32 importCapacity
        = Host.StandaloneDecoderImportedCallables.Length / 16;
    if (importCount < 0 || importCount > importCapacity
        || expectedImportCount < 0
        || expectedImportCount
            >= Host.StandaloneDecoderExpectedGroupCallableIds.Length
        || Host.StandaloneResolvedImports.Length % 32 != 0
        || importCount > Host.StandaloneResolvedImports.Length / 32)
    {
        return 3;
    }

    Host.StandaloneDecoderImportedCallableCount[0] = importCount;
    for (mut int32 catalogOrdinal = 0;
        catalogOrdinal < importCount;
        catalogOrdinal = catalogOrdinal + 1)
    {
        int32 sourceOffset = catalogOrdinal * 32;
        int32 artifactOrdinal
            = Host.StandaloneResolvedImports[sourceOffset];
        int32 moduleRow
            = Host.StandaloneResolvedImports[sourceOffset + 1];
        int32 importRow
            = Host.StandaloneResolvedImports[sourceOffset + 2];
        int32 providerDirectoryRow
            = Host.StandaloneResolvedImports[sourceOffset + 4];
        int32 expectedMethodDefRow
            = Host.StandaloneResolvedImports[sourceOffset + 5];
        int32 expectedCallableSlot
            = Host.StandaloneResolvedImports[sourceOffset + 13];
        int32 expectedGroupId
            = Host.StandaloneResolvedImports[sourceOffset + 20];
        int32 providerMethodDefRow
            = Host.StandaloneResolvedImports[sourceOffset + 21];
        int32 providerMethodSigRow
            = Host.StandaloneResolvedImports[sourceOffset + 23];
        int32 providerParamFirst
            = Host.StandaloneResolvedImports[sourceOffset + 24];
        int32 providerParamCount
            = Host.StandaloneResolvedImports[sourceOffset + 25];
        int32 providerContractFirst
            = Host.StandaloneResolvedImports[sourceOffset + 26];
        int32 providerContractCount
            = Host.StandaloneResolvedImports[sourceOffset + 27];
        int32 providerBodyRow
            = Host.StandaloneResolvedImports[sourceOffset + 28];
        int32 providerCallableSlot
            = Host.StandaloneResolvedImports[sourceOffset + 29];
        if (artifactOrdinal < 0
            || artifactOrdinal >= Host.StandaloneRequest[4]
            || moduleRow <= 0 || importRow <= 0
            || providerDirectoryRow <= 0
            || providerDirectoryRow >= Host.StandaloneModuleDirectory.Length / 8
            || expectedMethodDefRow <= 0 || expectedGroupId <= 0
            || expectedGroupId > expectedImportCount
            || expectedCallableSlot < 0
            || expectedCallableSlot >= Host.StandaloneCallableTypeIds.Length
            || expectedCallableSlot >= Host.StandaloneCallableEffects.Length
            || providerMethodDefRow <= 0 || providerMethodSigRow <= 0
            || providerParamFirst < 0 || providerParamCount < 0
            || providerContractFirst < 0 || providerContractCount < 0
            || providerBodyRow < 0 || providerCallableSlot < 0
            || providerCallableSlot
                >= Host.StandaloneCallableTypeIds.Length)
        {
            return 3;
        }

        int32 importerDirectoryRow
            = FindStandaloneDecoderModuleDirectoryRow(
                artifactOrdinal, moduleRow);
        if (importerDirectoryRow <= 0)
        {
            return 3;
        }
        int32 importerModuleId = importerDirectoryRow - 1;
        int32 providerModuleId = providerDirectoryRow - 1;
        int32 providerOffset = providerDirectoryRow * 8;
        int32 expectedCallableId = expectedGroupId - 1;
        int32 existingGroupCallable
            = Host.StandaloneDecoderExpectedGroupCallableIds[
                expectedGroupId];
        if (existingGroupCallable != -1
            && existingGroupCallable != expectedCallableId)
        {
            return 3;
        }
        Host.StandaloneDecoderExpectedGroupCallableIds[
            expectedGroupId] = expectedCallableId;

        int32 targetOffset = catalogOrdinal * 16;
        Host.StandaloneDecoderImportedCallables[targetOffset]
            = catalogOrdinal;
        Host.StandaloneDecoderImportedCallables[targetOffset + 1]
            = importerModuleId;
        Host.StandaloneDecoderImportedCallables[targetOffset + 2]
            = providerModuleId;
        Host.StandaloneDecoderImportedCallables[targetOffset + 3]
            = expectedCallableId;
        Host.StandaloneDecoderImportedCallables[targetOffset + 4]
            = artifactOrdinal;
        Host.StandaloneDecoderImportedCallables[targetOffset + 5]
            = moduleRow;
        Host.StandaloneDecoderImportedCallables[targetOffset + 6]
            = importRow;
        Host.StandaloneDecoderImportedCallables[targetOffset + 7]
            = expectedMethodDefRow;
        Host.StandaloneDecoderImportedCallables[targetOffset + 8]
            = Host.StandaloneModuleDirectory[providerOffset];
        Host.StandaloneDecoderImportedCallables[targetOffset + 9]
            = Host.StandaloneModuleDirectory[providerOffset + 1];
        Host.StandaloneDecoderImportedCallables[targetOffset + 10]
            = providerMethodDefRow;
        Host.StandaloneDecoderImportedCallables[targetOffset + 11]
            = providerBodyRow;
        Host.StandaloneDecoderImportedCallables[targetOffset + 12]
            = expectedCallableSlot;
        Host.StandaloneDecoderImportedCallables[targetOffset + 13]
            = providerCallableSlot;
        Host.StandaloneDecoderImportedCallables[targetOffset + 14]
            = providerParamFirst;
        Host.StandaloneDecoderImportedCallables[targetOffset + 15]
            = providerParamCount;
        int32 representativeImport
            = Host.StandaloneDecoderExpectedGroupRepresentativeImportIds[
                expectedGroupId];
        if (representativeImport < 0
            || importRow
                < Host.StandaloneDecoderImportedCallables[
                    representativeImport * 16 + 6])
        {
            Host.StandaloneDecoderExpectedGroupRepresentativeImportIds[
                expectedGroupId] = catalogOrdinal;
        }

        int32 mapStatus = AddStandaloneDecoderImportMap(
            artifactOrdinal, moduleRow, importRow, catalogOrdinal);
        if (mapStatus != 0)
        {
            return mapStatus;
        }
    }
    return 0;
}

int32 BuildStandaloneDecoderModuleCatalog()
{
    if (!ValidateStandaloneDecoderBuffers())
    {
        return 3;
    }
    ClearStandaloneDecoderOutputs();
    if (Host.StandaloneRequest[5] != 0
        || Host.StandaloneRequest[4] <= 0)
    {
        return 3;
    }

    int32 bindStatus = BindStandaloneMethodRoots();
    if (bindStatus != 0)
    {
        return bindStatus;
    }
    if (Host.StandaloneResolvedRootCount[0] != 0)
    {
        return 3;
    }

    int32 moduleLookupStatus = BuildStandaloneDecoderModuleLookup();
    if (moduleLookupStatus != 0)
    {
        return moduleLookupStatus;
    }

    init int32 selectedDirectoryRow;
    if (!TryFindStandaloneModuleDirectoryRow(
            Host.StandaloneRequest[2], Host.StandaloneRequest[3],
            ref init selectedDirectoryRow)
        || selectedDirectoryRow <= 0)
    {
        return 1;
    }
    int32 selectedDirectoryOffset = selectedDirectoryRow * 8;
    if (Host.StandaloneModuleDirectory[selectedDirectoryOffset] != 0)
    {
        return 2;
    }
    int32 selectedModuleId = selectedDirectoryRow - 1;
    int32 selectedModuleRow
        = Host.StandaloneModuleDirectory[
            selectedDirectoryOffset + 1];
    if (selectedModuleId < 0 || selectedModuleRow <= 0)
    {
        return 3;
    }

    int32 importStatus = BuildStandaloneDecoderImportedCallables();
    if (importStatus != 0)
    {
        return importStatus;
    }

    init int32 artifactStart;
    init int32 artifactLength;
    if (!TryGetStandaloneArtifactExtent(0,
            ref init artifactStart, ref init artifactLength)
        || !TryValidateStandaloneArtifactDirectory(0))
    {
        return 3;
    }

    int32 moduleEntry = FindStandaloneArtifactSection(0x0001);
    int32 methodEntry = FindStandaloneArtifactSection(0x0016);
    int32 signatureEntry = FindStandaloneArtifactSection(0x0017);
    int32 methodDefCount = GetStandaloneArtifactSectionCount(0x0016);
    int32 signatureCount = GetStandaloneArtifactSectionCount(0x0017);
    int32 parameterCount = GetStandaloneArtifactSectionCount(0x0018);
    int32 moduleCount = GetStandaloneArtifactSectionCount(0x0001);
    if (moduleEntry == 0 || methodEntry == 0 || signatureEntry == 0
        || selectedModuleRow > moduleCount)
    {
        return 3;
    }
    int32 moduleStart = Host.StandaloneSectionStarts[moduleEntry];
    int32 methodStart = Host.StandaloneSectionStarts[methodEntry];
    int32 methodLength = Host.StandaloneSectionLengths[methodEntry];
    int32 signatureStart
        = Host.StandaloneSectionStarts[signatureEntry];
    int32 signatureLength
        = Host.StandaloneSectionLengths[signatureEntry];
    if (int64(methodLength) != int64(methodDefCount) * 28
        || int64(signatureLength) != int64(signatureCount) * 24)
    {
        return 3;
    }

    init int32 methodFirst;
    init int32 methodEnd;
    if (!TryGetStandaloneModuleMethodDefRange(artifactStart,
            artifactLength, moduleStart, moduleCount,
            methodDefCount, selectedModuleRow,
            ref init methodFirst, ref init methodEnd)
        || methodEnd < methodFirst
        || methodEnd - methodFirst
            > Host.StandaloneDecoderMethods.Length / 16)
    {
        return 3;
    }

    int32 scratchCallableSlot
        = Host.StandaloneCallableTypeIds.Length - 1;
    int32 importCapacity
        = Host.StandaloneResolvedImports.Length / 32;
    int32 providerCallableEnd
        = importCapacity
            + Host.StandaloneResolvedProviderGroupCount[0];
    if (scratchCallableSlot < providerCallableEnd
        || scratchCallableSlot < 0
        || scratchCallableSlot
            >= Host.StandaloneCallableEffects.Length)
    {
        return 3;
    }

    int32 methodRecordCount = 0;
    int32 localCallableCount = 0;
    for (mut int32 methodDefRow = methodFirst;
        methodDefRow < methodEnd;
        methodDefRow = methodDefRow + 1)
    {
        int32 methodOffset
            = methodStart + ((methodDefRow - 1) * 28);
        init uint32 ownerTypeDef;
        init uint32 nameStringRow;
        init uint32 methodSigRow;
        init uint32 methodFlags;
        init uint32 contractFirst;
        init uint32 methodContractCount;
        init uint32 bodyRow;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, methodOffset, ref init ownerTypeDef)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, methodOffset + 4,
                ref init nameStringRow)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, methodOffset + 8,
                ref init methodSigRow)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, methodOffset + 12,
                ref init methodFlags)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, methodOffset + 16,
                ref init contractFirst)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, methodOffset + 20,
                ref init methodContractCount)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, methodOffset + 24, ref init bodyRow)
            || ownerTypeDef != 0 || nameStringRow == 0
            || methodSigRow == 0
            || methodSigRow > uint32(signatureCount)
            || (methodFlags != 0 && methodFlags != 2)
            || bodyRow > uint32(GetStandaloneArtifactSectionCount(0x0020))
            || !IsStandaloneMetadataRange(contractFirst,
                methodContractCount,
                GetStandaloneArtifactSectionCount(0x001B)))
        {
            return 3;
        }

        if (!TryValidateStandaloneStringName(0, artifactStart,
                artifactLength,
                Host.StandaloneSectionStarts[
                    FindStandaloneArtifactSection(0x0002)],
                Host.StandaloneSectionLengths[
                    FindStandaloneArtifactSection(0x0002)],
                GetStandaloneArtifactSectionCount(0x0002),
                int32(nameStringRow)))
        {
            return 3;
        }

        int32 expectedGroupId
            = FindStandaloneDecoderExpectedGroup(0,
                selectedModuleRow, methodDefRow);
        if (expectedGroupId < 0)
        {
            return 3;
        }

        int32 callableKind;
        int32 callableId;
        int32 resultTypeId;
        int32 effectMask;
        int32 paramFirst;
        int32 paramCount;
        int32 decodedContractFirst;
        int32 decodedContractCount;
        int32 decodedBodyRow;
        if (bodyRow == 0)
        {
            if (expectedGroupId == 0 || methodFlags != 2)
            {
                return 2;
            }
            int32 importedId = -1;
            for (mut int32 candidate = 0;
                candidate
                    < Host.StandaloneDecoderImportedCallableCount[0];
                candidate = candidate + 1)
            {
                int32 importedOffset = candidate * 16;
                if (Host.StandaloneDecoderImportedCallables[
                        importedOffset + 4] == 0
                    && Host.StandaloneDecoderImportedCallables[
                        importedOffset + 5] == selectedModuleRow
                    && Host.StandaloneDecoderImportedCallables[
                        importedOffset + 7] == methodDefRow)
                {
                    if (importedId >= 0)
                    {
                        int32 previousOffset = importedId * 16;
                        if (Host.StandaloneDecoderImportedCallables[
                                previousOffset + 3]
                            != Host.StandaloneDecoderImportedCallables[
                                importedOffset + 3])
                        {
                            return 3;
                        }
                    }
                    else
                    {
                        importedId = candidate;
                    }
                }
            }
            if (importedId < 0)
            {
                return 3;
            }
            int32 importedOffset = importedId * 16;
            int32 expectedCallableSlot
                = Host.StandaloneDecoderImportedCallables[
                    importedOffset + 12];
            callableKind = 2;
            callableId = expectedGroupId - 1;
            resultTypeId
                = Host.StandaloneCallableTypeIds[expectedCallableSlot];
            effectMask
                = Host.StandaloneCallableEffects[expectedCallableSlot];
            paramFirst
                = Host.StandaloneResolvedImports[
                    Host.StandaloneDecoderImportedCallables[
                        importedOffset] * 32 + 8];
            paramCount
                = Host.StandaloneResolvedImports[
                    Host.StandaloneDecoderImportedCallables[
                        importedOffset] * 32 + 9];
            decodedContractFirst
                = Host.StandaloneResolvedImports[
                    Host.StandaloneDecoderImportedCallables[
                        importedOffset] * 32 + 10];
            decodedContractCount
                = Host.StandaloneResolvedImports[
                    Host.StandaloneDecoderImportedCallables[
                        importedOffset] * 32 + 11];
            decodedBodyRow = 0;
            if (int32(methodSigRow)
                    != Host.StandaloneResolvedImports[
                        Host.StandaloneDecoderImportedCallables[
                            importedOffset] * 32 + 6]
                || int32(contractFirst) != decodedContractFirst
                || int32(methodContractCount) != decodedContractCount
                || resultTypeId <= 0 || (effectMask & ~6) != 0)
            {
                return 3;
            }
        }
        else
        {
            if (expectedGroupId != 0)
            {
                return 3;
            }
            int32 signatureOffset
                = signatureStart + ((int32(methodSigRow) - 1) * 24);
            init uint32 resultTypeSpecRef;
            init uint32 receiverTypeSpecRef;
            init uint32 parameterFirst;
            init uint32 signatureParameterCount;
            init uint32 genericFirst;
            init uint32 genericCount;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, signatureOffset,
                    ref init resultTypeSpecRef)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, signatureOffset + 4,
                    ref init receiverTypeSpecRef)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, signatureOffset + 8,
                    ref init parameterFirst)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, signatureOffset + 12,
                    ref init signatureParameterCount)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, signatureOffset + 16,
                    ref init genericFirst)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, signatureOffset + 20,
                    ref init genericCount)
                || resultTypeSpecRef == 0
                || !IsStandaloneMetadataRange(parameterFirst,
                    signatureParameterCount, parameterCount)
                || !IsStandaloneMetadataRange(genericFirst,
                    genericCount,
                    GetStandaloneArtifactSectionCount(0x0019)))
            {
                return 3;
            }
            if (receiverTypeSpecRef != 0 || genericCount != 0)
            {
                return 2;
            }

            int32 typeStatus = ValidateStandaloneMethodCallableTypes(
                0, scratchCallableSlot, artifactStart, artifactLength,
                int32(methodSigRow), resultTypeSpecRef,
                int32(parameterFirst), int32(signatureParameterCount));
            if (typeStatus != 0)
            {
                return typeStatus;
            }
            int32 contractStatus = ValidateStandaloneMethodContracts(
                0, selectedModuleRow, scratchCallableSlot,
                artifactStart, artifactLength, methodDefRow,
                parameterFirst, signatureParameterCount,
                contractFirst, methodContractCount);
            if (contractStatus != 0)
            {
                return contractStatus;
            }

            callableKind = 1;
            callableId = localCallableCount;
            resultTypeId
                = Host.StandaloneCallableTypeIds[scratchCallableSlot];
            effectMask
                = Host.StandaloneCallableEffects[scratchCallableSlot];
            paramFirst = int32(parameterFirst);
            paramCount = int32(signatureParameterCount);
            decodedContractFirst = int32(contractFirst);
            decodedContractCount = int32(methodContractCount);
            decodedBodyRow = int32(bodyRow);
        }

        if (methodRecordCount
                >= Host.StandaloneDecoderMethods.Length / 16
            || (callableKind == 1
                && localCallableCount
                    >= Host.StandaloneDecoderLocalCallables.Length / 4))
        {
            return 3;
        }

        int32 methodRecordOffset = methodRecordCount * 16;
        Host.StandaloneDecoderMethods[methodRecordOffset]
            = selectedModuleId;
        Host.StandaloneDecoderMethods[methodRecordOffset + 1]
            = Host.StandaloneModuleDirectory[
                (selectedModuleId + 1) * 8];
        Host.StandaloneDecoderMethods[methodRecordOffset + 2]
            = selectedModuleRow;
        Host.StandaloneDecoderMethods[methodRecordOffset + 3]
            = methodDefRow;
        Host.StandaloneDecoderMethods[methodRecordOffset + 4]
            = int32(methodSigRow);
        Host.StandaloneDecoderMethods[methodRecordOffset + 5]
            = resultTypeId;
        Host.StandaloneDecoderMethods[methodRecordOffset + 6]
            = paramFirst;
        Host.StandaloneDecoderMethods[methodRecordOffset + 7]
            = paramCount;
        Host.StandaloneDecoderMethods[methodRecordOffset + 8]
            = decodedContractFirst;
        Host.StandaloneDecoderMethods[methodRecordOffset + 9]
            = decodedContractCount;
        Host.StandaloneDecoderMethods[methodRecordOffset + 10]
            = decodedBodyRow;
        Host.StandaloneDecoderMethods[methodRecordOffset + 11]
            = int32(methodFlags);
        Host.StandaloneDecoderMethods[methodRecordOffset + 12]
            = callableId;
        Host.StandaloneDecoderMethods[methodRecordOffset + 13]
            = callableKind;
        Host.StandaloneDecoderMethods[methodRecordOffset + 14]
            = expectedGroupId;
        Host.StandaloneDecoderMethods[methodRecordOffset + 15]
            = effectMask;

        int32 lookupStatus = AddStandaloneDecoderMethodLookup(
            selectedModuleId, methodDefRow, methodRecordCount);
        if (lookupStatus != 0)
        {
            return lookupStatus;
        }
        if (callableKind == 1)
        {
            int32 localOffset = localCallableCount * 4;
            Host.StandaloneDecoderLocalCallables[localOffset]
                = selectedModuleId;
            Host.StandaloneDecoderLocalCallables[localOffset + 1]
                = localCallableCount;
            Host.StandaloneDecoderLocalCallables[localOffset + 2]
                = int32(bodyRow);
            Host.StandaloneDecoderLocalCallables[localOffset + 3]
                = methodRecordCount;
            localCallableCount = localCallableCount + 1;
        }
        methodRecordCount = methodRecordCount + 1;
    }

    Host.StandaloneDecoderSelectedModuleId[0] = selectedModuleId;
    Host.StandaloneDecoderMethodCount[0] = methodRecordCount;
    Host.StandaloneDecoderLocalCallableCount[0] = localCallableCount;
    int32 bodyStatus = DecodeStandaloneBodyLayouts();
    if (bodyStatus != 0)
    {
        ClearStandaloneDecoderOutputs();
        Host.StandaloneDecoderStatus[0] = bodyStatus;
        return bodyStatus;
    }
    int32 bodyMapStatus = DecodeStandaloneBodyMaps();
    if (bodyMapStatus != 0)
    {
        ClearStandaloneDecoderOutputs();
        Host.StandaloneDecoderStatus[0] = bodyMapStatus;
        return bodyMapStatus;
    }
    int32 bodyRecordStatus = DecodeStandaloneBodyRecords();
    if (bodyRecordStatus != 0)
    {
        ClearStandaloneDecoderOutputs();
        Host.StandaloneDecoderStatus[0] = bodyRecordStatus;
        return bodyRecordStatus;
    }
    return 0;
}

int32 ValidateStandaloneDecoderBodyOwners(int32 artifactStart,
    int32 artifactLength, int32 bodyTableCount)
{
    int32 methodEntry = FindStandaloneArtifactSection(0x0016);
    int32 methodCount = GetStandaloneArtifactSectionCount(0x0016);
    if (bodyTableCount < 0
        || bodyTableCount
            >= Host.StandaloneDecoderBodyOwners.Length
        || methodCount < 0
        || methodCount > Host.StandaloneDecoderBodyOwners.Length - 1
        || int64(methodCount) * 28
            != int64(Host.StandaloneSectionLengths[methodEntry]))
    {
        return 3;
    }

    int32 methodStart = methodCount == 0 ? 0
        : Host.StandaloneSectionStarts[methodEntry];
    for (mut int32 methodRow = 1;
        methodRow <= methodCount;
        methodRow = methodRow + 1)
    {
        init uint32 bodyRow;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength,
                methodStart + ((methodRow - 1) * 28) + 24,
                ref init bodyRow))
        {
            return 3;
        }
        if (bodyRow == 0)
        {
            continue;
        }
        if (bodyRow > uint32(bodyTableCount)
            || bodyRow >= uint32(
                Host.StandaloneDecoderBodyOwners.Length)
            || Host.StandaloneDecoderBodyOwners[int32(bodyRow)] != 0)
        {
            return 3;
        }
        Host.StandaloneDecoderBodyOwners[int32(bodyRow)] = methodRow;
    }

    for (mut int32 bodyRow = 1;
        bodyRow <= bodyTableCount;
        bodyRow = bodyRow + 1)
    {
        if (Host.StandaloneDecoderBodyOwners[bodyRow] == 0)
        {
            return 3;
        }
    }
    return 0;
}

int32 DecodeStandaloneBodyLayouts()
{
    int32 methodCount = Host.StandaloneDecoderMethodCount[0];
    int32 selectedModuleId
        = Host.StandaloneDecoderSelectedModuleId[0];
    if (methodCount < 0
        || methodCount > Host.StandaloneDecoderMethods.Length / 16
        || selectedModuleId < 0
        || selectedModuleId
            >= Host.StandaloneModuleCount[0])
    {
        return 3;
    }

    int32 moduleDirectoryOffset = (selectedModuleId + 1) * 8;
    int32 artifactOrdinal
        = Host.StandaloneModuleDirectory[moduleDirectoryOffset];
    int32 moduleRow
        = Host.StandaloneModuleDirectory[moduleDirectoryOffset + 1];
    if (artifactOrdinal < 0 || moduleRow <= 0
        || !TryValidateStandaloneArtifactDirectory(artifactOrdinal))
    {
        return 3;
    }

    init int32 artifactStart;
    init int32 artifactLength;
    if (!TryGetStandaloneArtifactExtent(artifactOrdinal,
            ref init artifactStart, ref init artifactLength))
    {
        return 3;
    }

    int32 bodyEntry = FindStandaloneArtifactSection(0x0020);
    int32 bodyTableCount = GetStandaloneArtifactSectionCount(0x0020);
    if (bodyTableCount < 0 || bodyTableCount > 0xFF_FFFF
        || (bodyTableCount != 0 && bodyEntry == 0))
    {
        return 3;
    }
    int32 bodySectionStart
        = bodyEntry == 0 ? 0
            : Host.StandaloneSectionStarts[bodyEntry];
    int32 bodySectionLength
        = bodyEntry == 0 ? 0
            : Host.StandaloneSectionLengths[bodyEntry];
    if ((bodyEntry != 0
            && !TryValidateStandaloneVariableTableIndex(artifactStart,
                artifactLength, bodySectionStart, bodySectionLength,
                bodyTableCount, 17, 1))
        || (bodyEntry == 0 && bodyTableCount != 0))
    {
        return 3;
    }
    int32 ownerStatus = ValidateStandaloneDecoderBodyOwners(
        artifactStart, artifactLength, bodyTableCount);
    if (ownerStatus != 0)
    {
        return ownerStatus;
    }
    if (artifactOrdinal >= Host.StandaloneDecoderBodyOwnershipValidated.Length)
    {
        return 3;
    }
    Host.StandaloneDecoderBodyOwnershipValidated[artifactOrdinal] = 1;
    if (bodyTableCount == 0)
    {
        return Host.StandaloneDecoderLocalCallableCount[0] == 0
            ? 0 : 3;
    }

    mut int32 decodedBodyCount = 0;
    for (mut int32 methodRecordId = 0;
        methodRecordId < methodCount;
        methodRecordId = methodRecordId + 1)
    {
        int32 methodOffset = methodRecordId * 16;
        int32 methodCallableKind
            = Host.StandaloneDecoderMethods[methodOffset + 13];
        int32 bodyRow
            = Host.StandaloneDecoderMethods[methodOffset + 10];
        if (methodCallableKind == 2)
        {
            if (bodyRow != 0)
            {
                return 3;
            }
            continue;
        }
        if (methodCallableKind != 1
            || bodyRow <= 0 || bodyRow > bodyTableCount)
        {
            return 3;
        }
        if (Host.StandaloneDecoderBodyOwners[bodyRow]
            != Host.StandaloneDecoderMethods[methodOffset + 3])
        {
            return 3;
        }

        init int32 bodyStart;
        init int32 bodyLength;
        if (!TryGetStandaloneVariableTableRowExtent(artifactStart,
                artifactLength, bodySectionStart, bodySectionLength,
                bodyTableCount, 17, 1, bodyRow,
                ref init bodyStart, ref init bodyLength)
            || bodyLength < 17)
        {
            return 3;
        }

        init int32 implementationKind;
        init int32 instructionEncoding;
        init int32 mapMask;
        init uint32 reserved;
        if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, bodyStart,
                ref init implementationKind)
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, bodyStart + 1,
                ref init instructionEncoding)
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, bodyStart + 2, ref init mapMask)
            || !TryReadStandaloneArtifactAbsoluteHalfWord(
                artifactStart, artifactLength, bodyStart + 3,
                ref init reserved))
        {
            return 3;
        }
        if (implementationKind != 1 || instructionEncoding != 1)
        {
            return 2;
        }
        if ((mapMask & 0xE0) != 0 || reserved != 0)
        {
            return 3;
        }

        init uint32 homeCountValue;
        init uint32 typeMapCountValue;
        init uint32 methodMapCountValue;
        init uint32 fieldMapCountValue;
        init uint32 constantMapCountValue;
        mut uint32 homeCount = 0;
        mut uint32 typeMapCount = 0;
        mut uint32 methodMapCount = 0;
        mut uint32 fieldMapCount = 0;
        mut uint32 constantMapCount = 0;
        mut int32 cursor = bodyStart + 5;
        if ((mapMask & 1) != 0)
        {
            if (!TryReadStandaloneArtifactAbsoluteWord(
                    artifactStart, artifactLength, cursor,
                    ref init homeCountValue))
            {
                return 3;
            }
            homeCount = homeCountValue;
            cursor = cursor + 4;
        }
        if ((mapMask & 2) != 0)
        {
            if (!TryReadStandaloneArtifactAbsoluteWord(
                    artifactStart, artifactLength, cursor,
                    ref init typeMapCountValue))
            {
                return 3;
            }
            typeMapCount = typeMapCountValue;
            cursor = cursor + 4;
        }
        if ((mapMask & 4) != 0)
        {
            if (!TryReadStandaloneArtifactAbsoluteWord(
                    artifactStart, artifactLength, cursor,
                    ref init methodMapCountValue))
            {
                return 3;
            }
            methodMapCount = methodMapCountValue;
            cursor = cursor + 4;
        }
        if ((mapMask & 8) != 0)
        {
            if (!TryReadStandaloneArtifactAbsoluteWord(
                    artifactStart, artifactLength, cursor,
                    ref init fieldMapCountValue))
            {
                return 3;
            }
            fieldMapCount = fieldMapCountValue;
            cursor = cursor + 4;
        }
        if ((mapMask & 16) != 0)
        {
            if (!TryReadStandaloneArtifactAbsoluteWord(
                    artifactStart, artifactLength, cursor,
                    ref init constantMapCountValue))
            {
                return 3;
            }
            constantMapCount = constantMapCountValue;
            cursor = cursor + 4;
        }

        init uint32 blockCountValue;
        init uint32 recordCountValue;
        init uint32 codeLengthValue;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, cursor, ref init blockCountValue)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, cursor + 4, ref init recordCountValue)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, cursor + 8, ref init codeLengthValue))
        {
            return 3;
        }
        cursor = cursor + 12;

        if (homeCount > 0x1_0000
            || typeMapCount > 0x1_0000
            || methodMapCount > 0x1_0000
            || fieldMapCount > 0x1_0000
            || constantMapCount > 0x1_0000
            || blockCountValue == 0 || blockCountValue > 0x1_0000
            || recordCountValue == 0 || recordCountValue > 0x1_0000
            || codeLengthValue == 0
            || codeLengthValue > uint32(bodyLength))
        {
            return 3;
        }

        int32 blockCount = int32(blockCountValue);
        int32 recordCount = int32(recordCountValue);
        int32 codeLength = int32(codeLengthValue);
        int64 mapLength = int64(homeCount) * 8
            + int64(typeMapCount) * 4
            + int64(methodMapCount) * 4
            + int64(fieldMapCount) * 4
            + int64(constantMapCount) * 8;
        int64 blockStartValue = int64(cursor) + mapLength;
        int64 recordIndexStartValue
            = blockStartValue + int64(blockCount) * 12;
        int64 recordDataStartValue
            = recordIndexStartValue + (int64(recordCount) + 1) * 4;
        int64 bodyEndValue = int64(bodyStart) + bodyLength;
        int64 codeStartValue = bodyEndValue - codeLength;
        if (blockStartValue > bodyEndValue
            || recordIndexStartValue > bodyEndValue
            || recordDataStartValue > codeStartValue
            || codeStartValue < int64(bodyStart) + cursor
            || bodyEndValue > int64(artifactStart) + artifactLength
            || recordDataStartValue > int64(0x7FFF_FFFF)
            || codeStartValue > int64(0x7FFF_FFFF))
        {
            return 3;
        }

        int32 blockStart = int32(blockStartValue);
        int32 recordIndexStart = int32(recordIndexStartValue);
        int32 recordDataStart = int32(recordDataStartValue);
        int32 codeStart = int32(codeStartValue);
        int32 recordDataLength = codeStart - recordDataStart;
        if (recordDataLength < recordCount * 4)
        {
            return 3;
        }

        mut uint32 previousCodeEnd = 0;
        for (mut int32 blockIndex = 0;
            blockIndex < blockCount;
            blockIndex = blockIndex + 1)
        {
            int32 blockOffset = blockStart + blockIndex * 12;
            init uint32 codeOffset;
            init uint32 blockCodeLength;
            init uint32 entryStateRecord;
            init uint32 blockFlags;
            if (!TryReadStandaloneArtifactAbsoluteWord(
                    artifactStart, artifactLength, blockOffset,
                    ref init codeOffset)
                || !TryReadStandaloneArtifactAbsoluteWord(
                    artifactStart, artifactLength, blockOffset + 4,
                    ref init blockCodeLength)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength, blockOffset + 8,
                    ref init entryStateRecord)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength, blockOffset + 10,
                    ref init blockFlags)
                || codeOffset != previousCodeEnd
                || blockCodeLength == 0
                || codeOffset > codeLength
                || blockCodeLength > uint32(codeLength) - codeOffset
                || entryStateRecord >= uint32(recordCount)
                || blockFlags != 0)
            {
                return 3;
            }
            previousCodeEnd = codeOffset + blockCodeLength;
        }
        if (previousCodeEnd != uint32(codeLength))
        {
            return 3;
        }

        mut uint32 previousRecordOffset = 0;
        for (mut int32 recordOffsetIndex = 0;
            recordOffsetIndex <= recordCount;
            recordOffsetIndex = recordOffsetIndex + 1)
        {
            init uint32 recordOffsetValue;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength,
                    recordIndexStart + recordOffsetIndex * 4,
                    ref init recordOffsetValue)
                || recordOffsetValue > uint32(recordDataLength)
                || (recordOffsetIndex == 0
                    && recordOffsetValue != 0)
                || (recordOffsetIndex > 0
                    && (recordOffsetValue <= previousRecordOffset
                        || recordOffsetValue - previousRecordOffset < 4)))
            {
                return 3;
            }
            previousRecordOffset = recordOffsetValue;
        }
        if (previousRecordOffset != uint32(recordDataLength))
        {
            return 3;
        }

        if (decodedBodyCount
                >= Host.StandaloneDecoderBodies.Length / 34)
        {
            return 3;
        }
        int32 bodyOutputOffset = decodedBodyCount * 34;
        Host.StandaloneDecoderBodies[bodyOutputOffset]
            = methodRecordId;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 1]
            = artifactOrdinal;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 2] = moduleRow;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 3]
            = Host.StandaloneDecoderMethods[methodOffset + 3];
        Host.StandaloneDecoderBodies[bodyOutputOffset + 4] = bodyRow;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 5] = bodyStart;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 6] = bodyLength;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 7] = mapMask;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 8]
            = int32(homeCount);
        Host.StandaloneDecoderBodies[bodyOutputOffset + 9]
            = cursor;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 10]
            = int32(typeMapCount);
        Host.StandaloneDecoderBodies[bodyOutputOffset + 11]
            = Host.StandaloneDecoderBodies[bodyOutputOffset + 9]
                + int32(homeCount) * 8;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 12]
            = int32(methodMapCount);
        Host.StandaloneDecoderBodies[bodyOutputOffset + 13]
            = Host.StandaloneDecoderBodies[bodyOutputOffset + 11]
                + int32(typeMapCount) * 4;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 14]
            = int32(fieldMapCount);
        Host.StandaloneDecoderBodies[bodyOutputOffset + 15]
            = Host.StandaloneDecoderBodies[bodyOutputOffset + 13]
                + int32(methodMapCount) * 4;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 16]
            = int32(constantMapCount);
        Host.StandaloneDecoderBodies[bodyOutputOffset + 17]
            = Host.StandaloneDecoderBodies[bodyOutputOffset + 15]
                + int32(fieldMapCount) * 4;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 18]
            = Host.StandaloneDecoderBodies[bodyOutputOffset + 17]
                + int32(constantMapCount) * 8;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 19] = blockCount;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 20] = blockStart;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 21] = recordCount;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 22]
            = recordIndexStart;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 23]
            = recordDataStart;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 24]
            = recordDataLength;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 25] = codeStart;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 26] = codeLength;
        Host.StandaloneDecoderBodies[bodyOutputOffset + 27]
            = Host.StandaloneDecoderSelectedModuleId[0];
        decodedBodyCount = decodedBodyCount + 1;
    }

    Host.StandaloneDecoderBodyCount[0] = decodedBodyCount;
    return 0;
}

int32 DecodeStandaloneDecoderTypeSpecTypeId(int32 artifactStart,
    int32 artifactLength, int32 typeSpecStart, int32 typeSpecLength,
    int32 typeSpecCount, uint32 typeSpecRef,
    bool allowInitReference, bool allowUnit,
    ref<init int32> typeIdResult)
    ensure return == 0 ? *typeIdResult is init : true
{
    init int32 typeCode;
    init bool isInitReference;
    init bool isWritable;
    int32 status = TryGetStandaloneCallableType(artifactStart,
        artifactLength, typeSpecStart, typeSpecLength, typeSpecCount,
        typeSpecRef, allowInitReference, allowUnit,
        ref init typeCode, ref init isInitReference,
        ref init isWritable);
    if (status != 0)
    {
        return status;
    }

    return InternStandaloneCallableTypeFact(
        isInitReference ? 1 : 0, typeCode, isWritable,
        ref init *typeIdResult);
}

int32 DecodeStandaloneDecoderBodyTypeMapTypeId(int32 artifactStart,
    int32 artifactLength, int32 typeSpecStart, int32 typeSpecLength,
    int32 typeSpecCount, uint32 token,
    ref<init int32> typeIdResult)
    ensure return == 0 ? *typeIdResult is init : true
{
    uint32 tokenKind = token & 0xFF00_0000;
    uint32 typeSpecRef;
    if (tokenKind == 0x1100_0000)
    {
        typeSpecRef = token & 0x00FF_FFFF;
        if (typeSpecRef == 0 || typeSpecRef > uint32(typeSpecCount))
        {
            return 3;
        }
    }
    else if (tokenKind == 0xF200_0000)
    {
        typeSpecRef = token;
    }
    else if (tokenKind == 0x1300_0000
        || tokenKind == 0x1C00_0000
        || tokenKind == 0xF300_0000)
    {
        return (token & 0x00FF_FFFF) == 0 ? 3 : 2;
    }
    else
    {
        return 3;
    }

    return DecodeStandaloneDecoderTypeSpecTypeId(
        artifactStart, artifactLength, typeSpecStart, typeSpecLength,
        typeSpecCount, typeSpecRef, allowInitReference: true,
        allowUnit: true, ref init *typeIdResult);
}

int32 GetStandaloneDecoderScalarWidth(int32 typeId)
{
    if (typeId <= 0 || typeId * 3 + 1
        >= Host.StandaloneTypeFacts.Length
        || Host.StandaloneTypeFacts[typeId * 3] != 0)
    {
        return -1;
    }
    int32 typeCode
        = Host.StandaloneTypeFacts[typeId * 3 + 1];
    if (typeCode == 0)
    {
        return 0;
    }
    if (typeCode == 1 || typeCode == 2
        || typeCode == 6 || typeCode == 0x0B)
    {
        return 1;
    }
    if (typeCode == 3 || typeCode == 7 || typeCode == 0x0C)
    {
        return 2;
    }
    if (typeCode == 4 || typeCode == 5 || typeCode == 8
        || typeCode == 0x0D || typeCode == 0x14)
    {
        return 4;
    }
    if (typeCode == 9 || typeCode == 0x0E
        || typeCode == 0x10 || typeCode == 0x11
        || typeCode == 0x15)
    {
        return 8;
    }
    return -1;
}

int32 ValidateStandaloneDecoderScalarConstant(int32 artifactStart,
    int32 artifactLength, int32 typeSpecStart, int32 typeSpecLength,
    int32 typeSpecCount, int32 constantSourceStart,
    int32 constantSourceCount, int32 frozenNodeStart,
    int32 frozenNodeCount, int32 blobSectionStart,
    int32 blobSectionLength, int32 blobCount,
    uint32 typeSpecRef, int32 constantSourceRow,
    ref<init int32> typeIdResult, ref<init int32> blobRowResult)
    ensure return == 0
        ? (*typeIdResult is init && *blobRowResult is init) : true
{
    if (constantSourceRow <= 0
        || constantSourceRow > constantSourceCount
        || constantSourceStart == 0 || frozenNodeStart == 0
        || frozenNodeCount <= 0)
    {
        return 3;
    }

    int32 mapTypeId;
    int32 typeStatus = DecodeStandaloneDecoderTypeSpecTypeId(
        artifactStart, artifactLength, typeSpecStart, typeSpecLength,
        typeSpecCount, typeSpecRef, allowInitReference: false,
        allowUnit: true, ref init mapTypeId);
    if (typeStatus != 0)
    {
        return typeStatus;
    }

    int32 sourceOffset
        = constantSourceStart + ((constantSourceRow - 1) * 8);
    init uint32 sourceKind;
    init uint32 payloadRow;
    if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, sourceOffset, ref init sourceKind)
        || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, sourceOffset + 4, ref init payloadRow)
        || payloadRow == 0 || payloadRow > 0x00FF_FFFF)
    {
        return 3;
    }
    if (sourceKind != 1)
    {
        return sourceKind == 2 || sourceKind == 3 ? 2 : 3;
    }
    if (payloadRow > uint32(frozenNodeCount))
    {
        return 3;
    }

    int32 nodeOffset
        = frozenNodeStart + ((int32(payloadRow) - 1) * 24);
    init uint32 nodeTypeSpecRef;
    init int32 nodeKind;
    init int32 nodeFlags;
    init uint32 nodeReserved;
    init uint32 scalarBlobRow;
    init uint32 childFirst;
    init uint32 childCount;
    init uint32 activeUnionCase;
    if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, nodeOffset, ref init nodeTypeSpecRef)
        || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
            artifactLength, nodeOffset + 4, ref init nodeKind)
        || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
            artifactLength, nodeOffset + 5, ref init nodeFlags)
        || !TryReadStandaloneArtifactAbsoluteHalfWord(artifactStart,
            artifactLength, nodeOffset + 6, ref init nodeReserved)
        || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, nodeOffset + 8, ref init scalarBlobRow)
        || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, nodeOffset + 12, ref init childFirst)
        || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, nodeOffset + 16, ref init childCount)
        || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, nodeOffset + 20, ref init activeUnionCase)
        || nodeTypeSpecRef == 0
        || nodeFlags != 0 || nodeReserved != 0)
    {
        return 3;
    }
    if (nodeKind != 1)
    {
        return nodeKind >= 2 && nodeKind <= 6 ? 2 : 3;
    }
    if (childFirst != 0 || childCount != 0 || activeUnionCase != 0)
    {
        return 3;
    }

    int32 nodeTypeId;
    typeStatus = DecodeStandaloneDecoderTypeSpecTypeId(
        artifactStart, artifactLength, typeSpecStart, typeSpecLength,
        typeSpecCount, nodeTypeSpecRef, allowInitReference: false,
        allowUnit: true, ref init nodeTypeId);
    if (typeStatus != 0)
    {
        return typeStatus;
    }
    if (mapTypeId != nodeTypeId)
    {
        return 3;
    }

    int32 scalarWidth = GetStandaloneDecoderScalarWidth(mapTypeId);
    if (scalarWidth < 0
        || scalarBlobRow > uint32(blobCount)
        || (scalarWidth == 0 && scalarBlobRow != 0)
        || (scalarWidth != 0 && scalarBlobRow == 0))
    {
        return scalarWidth < 0 ? 2 : 3;
    }

    if (scalarWidth != 0)
    {
        if (blobSectionStart == 0 || blobCount <= 0)
        {
            return 3;
        }
        init int32 blobRowStart;
        init int32 blobRowLength;
        if (!TryGetStandaloneVariableTableRowExtent(artifactStart,
                artifactLength, blobSectionStart, blobSectionLength,
                blobCount, 1, 1, int32(scalarBlobRow),
                ref init blobRowStart, ref init blobRowLength)
            || blobRowLength != scalarWidth)
        {
            return 3;
        }
        int32 typeCode
            = Host.StandaloneTypeFacts[mapTypeId * 3 + 1];
        if (typeCode == 1)
        {
            init int32 booleanValue;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, blobRowStart,
                    ref init booleanValue)
                || booleanValue > 1)
            {
                return 3;
            }
        }
        else if (typeCode == 5)
        {
            init uint32 scalarValue;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, blobRowStart,
                    ref init scalarValue)
                || scalarValue > 0x10_FFFF
                || (scalarValue >= 0xD800
                    && scalarValue <= 0xDFFF))
            {
                return 3;
            }
        }
    }

    *typeIdResult = mapTypeId;
    *blobRowResult = int32(scalarBlobRow);
    return 0;
}

int32 DecodeStandaloneBodyMaps()
{
    int32 bodyCount = Host.StandaloneDecoderBodyCount[0];
    if (bodyCount < 0
        || bodyCount > Host.StandaloneDecoderBodies.Length / 34)
    {
        return 3;
    }
    if (bodyCount == 0)
    {
        return 0;
    }

    mut bool hasConstants = false;
    for (mut int32 bodyId = 0;
        bodyId < bodyCount;
        bodyId = bodyId + 1)
    {
        if (Host.StandaloneDecoderBodies[bodyId * 34 + 16] != 0)
        {
            hasConstants = true;
            break;
        }
    }

    int32 firstBodyOffset = 0;
    int32 artifactOrdinal
        = Host.StandaloneDecoderBodies[firstBodyOffset + 1];
    int32 moduleRow
        = Host.StandaloneDecoderBodies[firstBodyOffset + 2];
    init int32 artifactStart;
    init int32 artifactLength;
    if (artifactOrdinal < 0 || moduleRow <= 0
        || !TryValidateStandaloneArtifactDirectory(artifactOrdinal)
        || !TryGetStandaloneArtifactExtent(artifactOrdinal,
            ref init artifactStart, ref init artifactLength))
    {
        return 3;
    }

    int32 typeSpecEntry = FindStandaloneArtifactSection(0x0011);
    int32 typeSpecCount = GetStandaloneArtifactSectionCount(0x0011);
    int32 typeSpecStart = typeSpecEntry == 0 ? 0
        : Host.StandaloneSectionStarts[typeSpecEntry];
    int32 typeSpecLength = typeSpecEntry == 0 ? 0
        : Host.StandaloneSectionLengths[typeSpecEntry];
    if ((typeSpecEntry == 0) != (typeSpecCount == 0)
        || (typeSpecCount != 0
            && !TryValidateStandaloneVariableTableIndex(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, 2, 1)))
    {
        return 3;
    }

    int32 blobEntry = FindStandaloneArtifactSection(0x0003);
    int32 blobCount = GetStandaloneArtifactSectionCount(0x0003);
    int32 blobSectionStart = blobEntry == 0 ? 0
        : Host.StandaloneSectionStarts[blobEntry];
    int32 blobSectionLength = blobEntry == 0 ? 0
        : Host.StandaloneSectionLengths[blobEntry];
    if ((blobEntry == 0) != (blobCount == 0)
        || (blobEntry != 0
            && !TryValidateStandaloneVariableTableIndex(artifactStart,
                artifactLength, blobSectionStart, blobSectionLength,
                blobCount, 1, 1)))
    {
        return 3;
    }

    int32 constantSourceEntry
        = FindStandaloneArtifactSection(0x0030);
    int32 constantSourceCount
        = GetStandaloneArtifactSectionCount(0x0030);
    int32 constantSourceStart = constantSourceEntry == 0 ? 0
        : Host.StandaloneSectionStarts[constantSourceEntry];
    int32 frozenNodeEntry
        = FindStandaloneArtifactSection(0x003F);
    int32 frozenNodeCount
        = GetStandaloneArtifactSectionCount(0x003F);
    int32 frozenNodeStart = frozenNodeEntry == 0 ? 0
        : Host.StandaloneSectionStarts[frozenNodeEntry];
    if (hasConstants
        && (constantSourceEntry == 0 || constantSourceCount <= 0
            || frozenNodeEntry == 0 || frozenNodeCount <= 0))
    {
        return 3;
    }
    if (hasConstants)
    {
        init bool hasTypedFrozenValues;
        if (!TryRequireStandaloneModuleFeature(artifactStart,
                artifactLength, moduleRow, 11,
                ref init hasTypedFrozenValues)
            || !hasTypedFrozenValues)
        {
            return 3;
        }
    }

    for (mut int32 bodyId = 0;
        bodyId < bodyCount;
        bodyId = bodyId + 1)
    {
        int32 bodyOffset = bodyId * 34;
        if (Host.StandaloneDecoderBodies[bodyOffset + 1]
                != artifactOrdinal
            || Host.StandaloneDecoderBodies[bodyOffset + 2]
                != moduleRow)
        {
            return 3;
        }

        int32 homeCount
            = Host.StandaloneDecoderBodies[bodyOffset + 8];
        int32 typeMapCount
            = Host.StandaloneDecoderBodies[bodyOffset + 10];
        int32 methodMapCount
            = Host.StandaloneDecoderBodies[bodyOffset + 12];
        int32 fieldMapCount
            = Host.StandaloneDecoderBodies[bodyOffset + 14];
        int32 constantMapCount
            = Host.StandaloneDecoderBodies[bodyOffset + 16];
        if (homeCount < 0 || typeMapCount < 0
            || methodMapCount < 0 || fieldMapCount < 0
            || constantMapCount < 0)
        {
            return 3;
        }
        if (fieldMapCount != 0)
        {
            return 2;
        }

        int32 homeFirst = Host.StandaloneDecoderHomeCount[0];
        int32 typeFirst = Host.StandaloneDecoderTypeMapCount[0];
        int32 methodFirst = Host.StandaloneDecoderMethodMapCount[0];
        int32 constantFirst
            = Host.StandaloneDecoderConstantMapCount[0];
        if (homeFirst < 0
            || homeFirst > Host.StandaloneDecoderHomes.Length / 3
                - homeCount
            || typeFirst < 0
            || typeFirst
                > Host.StandaloneDecoderTypeMapTypeIds.Length
                    - typeMapCount
            || methodFirst < 0
            || methodFirst
                > Host.StandaloneDecoderMethodMapTargets.Length / 4
                    - methodMapCount
            || constantFirst < 0
            || constantFirst
                > Host.StandaloneDecoderConstantMapEntries.Length / 3
                    - constantMapCount)
        {
            return 3;
        }
        Host.StandaloneDecoderBodies[bodyOffset + 28] = homeFirst;
        Host.StandaloneDecoderBodies[bodyOffset + 29] = typeFirst;
        Host.StandaloneDecoderBodies[bodyOffset + 30] = methodFirst;
        Host.StandaloneDecoderBodies[bodyOffset + 31] = constantFirst;

        int32 typeMapStart
            = Host.StandaloneDecoderBodies[bodyOffset + 11];
        for (mut int32 typeMapIndex = 0;
            typeMapIndex < typeMapCount;
            typeMapIndex = typeMapIndex + 1)
        {
            init uint32 typeToken;
            if (!TryReadStandaloneArtifactAbsoluteWord(
                    artifactStart, artifactLength,
                    typeMapStart + typeMapIndex * 4,
                    ref init typeToken))
            {
                return 3;
            }
            init int32 typeId;
            int32 typeStatus
                = DecodeStandaloneDecoderBodyTypeMapTypeId(
                    artifactStart, artifactLength, typeSpecStart,
                    typeSpecLength, typeSpecCount, typeToken,
                    ref init typeId);
            if (typeStatus != 0)
            {
                return typeStatus;
            }
            Host.StandaloneDecoderTypeMapTypeIds[
                typeFirst + typeMapIndex] = typeId;
        }
        Host.StandaloneDecoderTypeMapCount[0]
            = typeFirst + typeMapCount;

        int32 methodRecordId
            = Host.StandaloneDecoderBodies[bodyOffset];
        if (methodRecordId < 0
            || methodRecordId
                >= Host.StandaloneDecoderMethodCount[0])
        {
            return 3;
        }
        int32 methodRecordOffset = methodRecordId * 16;
        int32 methodArtifactOrdinal
            = Host.StandaloneDecoderMethods[methodRecordOffset + 1];
        int32 methodParamFirst
            = Host.StandaloneDecoderMethods[methodRecordOffset + 6];
        int32 methodParamCount
            = Host.StandaloneDecoderMethods[methodRecordOffset + 7];
        if (methodArtifactOrdinal != artifactOrdinal)
        {
            return 3;
        }
        int32 homeMapStart
            = Host.StandaloneDecoderBodies[bodyOffset + 9];
        for (mut int32 homeIndex = 0;
            homeIndex < homeCount;
            homeIndex = homeIndex + 1)
        {
            int32 homeOffset = homeMapStart + homeIndex * 8;
            init int32 role;
            init int32 flags;
            init uint32 typeMapIndex;
            init uint32 formalOrdinal;
            init uint32 reserved;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, homeOffset, ref init role)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, homeOffset + 1, ref init flags)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength, homeOffset + 2,
                    ref init typeMapIndex)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength, homeOffset + 4,
                    ref init formalOrdinal)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength, homeOffset + 6,
                    ref init reserved)
                || typeMapIndex >= uint32(typeMapCount)
                || reserved != 0)
            {
                return 3;
            }

            if ((role == 1 && (flags != 0 || formalOrdinal != 0))
                || (role == 2 && flags != 0)
                || (role == 3
                    && ((flags & ~1) != 0 || formalOrdinal != 0))
                || (role < 1 || role > 3))
            {
                return 3;
            }
            int32 typeId
                = Host.StandaloneDecoderTypeMapTypeIds[
                    typeFirst + int32(typeMapIndex)];
            if (typeId <= 0)
            {
                return 3;
            }

            if (role == 1)
            {
                return 3;
            }
            if (role == 2)
            {
                if (formalOrdinal >= uint32(methodParamCount)
                    || formalOrdinal
                        >= uint32(
                            Host.StandaloneDecoderFormalHomeBodies.Length)
                    || Host.StandaloneDecoderFormalHomeBodies[
                        int32(formalOrdinal)] == bodyId + 1)
                {
                    return 3;
                }
                int32 parameterRow = methodParamFirst
                    + int32(formalOrdinal);
                int32 globalParameterRow
                    = Host.StandaloneArtifactParameterStarts[
                        methodArtifactOrdinal] + parameterRow;
                if (globalParameterRow <= 0
                    || globalParameterRow
                        >= Host.StandaloneParameterTypeIds.Length
                    || Host.StandaloneParameterTypeIds[
                        globalParameterRow] != typeId)
                {
                    return 3;
                }
                Host.StandaloneDecoderFormalHomeBodies[
                    int32(formalOrdinal)] = bodyId + 1;
            }

            int32 homeOutputOffset = (homeFirst + homeIndex) * 3;
            Host.StandaloneDecoderHomes[homeOutputOffset]
                = role | (flags << 8);
            Host.StandaloneDecoderHomes[homeOutputOffset + 1] = typeId;
            Host.StandaloneDecoderHomes[homeOutputOffset + 2]
                = int32(formalOrdinal);
        }
        Host.StandaloneDecoderHomeCount[0] = homeFirst + homeCount;

        int32 methodMapStart
            = Host.StandaloneDecoderBodies[bodyOffset + 13];
        int32 artifactMethodCount
            = GetStandaloneArtifactSectionCount(0x0016);
        int32 artifactImportCount
            = GetStandaloneArtifactSectionCount(0x001C);
        int32 moduleId
            = Host.StandaloneDecoderBodies[bodyOffset + 27];
        for (mut int32 methodMapIndex = 0;
            methodMapIndex < methodMapCount;
            methodMapIndex = methodMapIndex + 1)
        {
            init uint32 methodToken;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength,
                    methodMapStart + methodMapIndex * 4,
                    ref init methodToken))
            {
                return 3;
            }
            uint32 tokenKind = methodToken & 0xFF00_0000;
            uint32 tokenRow = methodToken & 0x00FF_FFFF;
            if (tokenRow == 0)
            {
                return 3;
            }

            int32 targetKind;
            int32 targetId;
            int32 targetViewId;
            int32 targetMethodRecordId;
            if (tokenKind == 0x1600_0000)
            {
                if (tokenRow > uint32(artifactMethodCount))
                {
                    return 3;
                }
                int32 targetMethodRecord
                    = FindStandaloneDecoderMethodRecord(
                        moduleId, int32(tokenRow));
                if (targetMethodRecord < 0)
                {
                    return 2;
                }
                int32 targetMethodOffset = targetMethodRecord * 16;
                targetViewId = targetMethodRecord;
                targetMethodRecordId = targetMethodRecord;
                int32 targetCallableKind
                    = Host.StandaloneDecoderMethods[
                        targetMethodOffset + 13];
                if (targetCallableKind == 1)
                {
                    targetKind = 1;
                    targetId = Host.StandaloneDecoderMethods[
                        targetMethodOffset + 12];
                }
                else if (targetCallableKind == 2)
                {
                    int32 expectedGroupId
                        = Host.StandaloneDecoderMethods[
                            targetMethodOffset + 14];
                    if (GetStandaloneDecoderRepresentativeImportId(
                            expectedGroupId) < 0)
                    {
                        return 3;
                    }
                    targetKind = 2;
                    targetId = expectedGroupId - 1;
                }
                else
                {
                    return 3;
                }
            }
            else if (tokenKind == 0x1C00_0000)
            {
                if (tokenRow > uint32(artifactImportCount))
                {
                    return 3;
                }
                int32 importId = FindStandaloneDecoderImport(
                    artifactOrdinal, moduleRow, int32(tokenRow));
                if (importId < 0
                    || importId
                        >= Host.StandaloneDecoderImportedCallableCount[0])
                {
                    return 3;
                }
                int32 importedOffset = importId * 16;
                if (Host.StandaloneDecoderImportedCallables[
                        importedOffset + 4] != artifactOrdinal
                    || Host.StandaloneDecoderImportedCallables[
                        importedOffset + 5] != moduleRow
                    || Host.StandaloneDecoderImportedCallables[
                        importedOffset + 6] != int32(tokenRow))
                {
                    return 3;
                }
                targetKind = 2;
                targetId = Host.StandaloneDecoderImportedCallables[
                    importedOffset + 3];
                targetViewId = importId;
                targetMethodRecordId
                    = FindStandaloneDecoderMethodRecord(
                        Host.StandaloneDecoderImportedCallables[
                            importedOffset + 1],
                        Host.StandaloneDecoderImportedCallables[
                            importedOffset + 7]);
                if (targetMethodRecordId < 0
                    || Host.StandaloneDecoderMethods[
                        targetMethodRecordId * 16 + 13] != 2
                    || Host.StandaloneDecoderMethods[
                        targetMethodRecordId * 16 + 14] != targetId + 1)
                {
                    return 3;
                }
            }
            else
            {
                return 3;
            }
            if ((targetKind == 1
                    && (targetId < 0
                        || targetId
                            >= Host.StandaloneDecoderLocalCallableCount[0]))
                || (targetKind == 2
                    && (targetId < 0
                        || targetId
                            >= Host.StandaloneResolvedExpectedImportCount[0])))
            {
                return 3;
            }

            int32 targetOffset
                = (methodFirst + methodMapIndex) * 4;
            Host.StandaloneDecoderMethodMapTargets[targetOffset]
                = targetKind;
            Host.StandaloneDecoderMethodMapTargets[targetOffset + 1]
                = targetId;
            Host.StandaloneDecoderMethodMapTargets[targetOffset + 2]
                = targetViewId;
            Host.StandaloneDecoderMethodMapTargets[targetOffset + 3]
                = targetMethodRecordId;
        }
        Host.StandaloneDecoderMethodMapCount[0]
            = methodFirst + methodMapCount;

        int32 constantMapStart
            = Host.StandaloneDecoderBodies[bodyOffset + 17];
        for (mut int32 constantIndex = 0;
            constantIndex < constantMapCount;
            constantIndex = constantIndex + 1)
        {
            int32 constantOffset
                = constantMapStart + constantIndex * 8;
            init uint32 typeSpecRef;
            init uint32 sourceRow;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, constantOffset,
                    ref init typeSpecRef)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, constantOffset + 4,
                    ref init sourceRow)
                || sourceRow > 0x7FFF_FFFF)
            {
                return 3;
            }
            init int32 typeId;
            init int32 blobRow;
            int32 constantStatus
                = ValidateStandaloneDecoderScalarConstant(
                    artifactStart, artifactLength, typeSpecStart,
                    typeSpecLength, typeSpecCount, constantSourceStart,
                    constantSourceCount, frozenNodeStart,
                    frozenNodeCount, blobSectionStart,
                    blobSectionLength, blobCount, typeSpecRef,
                    int32(sourceRow), ref init typeId,
                    ref init blobRow);
            if (constantStatus != 0)
            {
                return constantStatus;
            }
            int32 constantOutputOffset
                = (constantFirst + constantIndex) * 3;
            Host.StandaloneDecoderConstantMapEntries[
                constantOutputOffset] = typeId;
            Host.StandaloneDecoderConstantMapEntries[
                constantOutputOffset + 1] = int32(sourceRow);
            Host.StandaloneDecoderConstantMapEntries[
                constantOutputOffset + 2] = blobRow;
        }
        Host.StandaloneDecoderConstantMapCount[0]
            = constantFirst + constantMapCount;
    }
    return 0;
}

int32 GetStandaloneDecoderMethodParameterTypeId(int32 methodRecordId,
    int32 parameterOrdinal, ref<init int32> typeIdResult)
    ensure return == 0 ? *typeIdResult is init : true
{
    if (methodRecordId < 0
        || methodRecordId >= Host.StandaloneDecoderMethodCount[0])
    {
        return 3;
    }

    int32 methodOffset = methodRecordId * 16;
    int32 parameterFirst
        = Host.StandaloneDecoderMethods[methodOffset + 6];
    int32 parameterCount
        = Host.StandaloneDecoderMethods[methodOffset + 7];
    int32 artifactOrdinal
        = Host.StandaloneDecoderMethods[methodOffset + 1];
    if (parameterOrdinal < 0 || parameterOrdinal >= parameterCount
        || parameterFirst <= 0 || artifactOrdinal < 0
        || artifactOrdinal >= Host.StandaloneRequest[4])
    {
        return 3;
    }

    int32 globalParameterRow
        = Host.StandaloneArtifactParameterStarts[artifactOrdinal]
            + parameterFirst + parameterOrdinal;
    if (globalParameterRow <= 0
        || globalParameterRow >= Host.StandaloneParameterTypeIds.Length)
    {
        return 3;
    }
    int32 typeId
        = Host.StandaloneParameterTypeIds[globalParameterRow];
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0])
    {
        return 3;
    }
    *typeIdResult = typeId;
    return 0;
}

int32 ValidateStandaloneDecoderProviderBody(int32 artifactOrdinal,
    int32 moduleRow, int32 methodDefRow, int32 methodSigRow,
    int32 bodyRow, int32 moduleId,
    ref<init int32> bodyStartResult,
    ref<init int32> bodyLengthResult)
    ensure return == 0
        ? (*bodyStartResult is init && *bodyLengthResult is init) : true
{
    if (artifactOrdinal < 0
        || artifactOrdinal >= Host.StandaloneRequest[4]
        || moduleRow <= 0 || methodDefRow <= 0
        || methodSigRow <= 0 || bodyRow <= 0
        || moduleId < 0
        || !TryValidateStandaloneArtifactDirectory(artifactOrdinal))
    {
        return 3;
    }

    int32 directoryRow
        = FindStandaloneDecoderModuleDirectoryRow(
            artifactOrdinal, moduleRow);
    if (directoryRow <= 0 || directoryRow - 1 != moduleId)
    {
        return 3;
    }
    init int32 artifactStart;
    init int32 artifactLength;
    if (!TryGetStandaloneArtifactExtent(artifactOrdinal,
            ref init artifactStart, ref init artifactLength))
    {
        return 3;
    }

    int32 moduleEntry = FindStandaloneArtifactSection(0x0001);
    int32 moduleCount = GetStandaloneArtifactSectionCount(0x0001);
    int32 methodEntry = FindStandaloneArtifactSection(0x0016);
    int32 methodCount = GetStandaloneArtifactSectionCount(0x0016);
    int32 moduleStart = moduleEntry == 0 ? 0
        : Host.StandaloneSectionStarts[moduleEntry];
    int32 methodSectionStart = methodEntry == 0 ? 0
        : Host.StandaloneSectionStarts[methodEntry];
    if (moduleEntry == 0 || methodEntry == 0
        || moduleRow > moduleCount || methodDefRow > methodCount
        || int64(moduleCount) * 48
            != int64(Host.StandaloneSectionLengths[moduleEntry])
        || int64(methodCount) * 28
            != int64(Host.StandaloneSectionLengths[methodEntry]))
    {
        return 3;
    }

    int32 moduleOffset = moduleStart + ((moduleRow - 1) * 48);
    init uint32 methodFirst;
    if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, moduleOffset + 40,
            ref init methodFirst))
    {
        return 3;
    }
    int32 methodEnd = methodCount + 1;
    if (moduleRow < moduleCount)
    {
        init uint32 nextMethodFirst;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, moduleStart + (moduleRow * 48) + 40,
                ref init nextMethodFirst)
            || nextMethodFirst > uint32(methodCount + 1))
        {
            return 3;
        }
        methodEnd = int32(nextMethodFirst);
    }
    if (methodFirst == 0
        || methodDefRow < int32(methodFirst)
        || methodDefRow >= methodEnd)
    {
        return 3;
    }

    int32 methodOffset
        = methodSectionStart + ((methodDefRow - 1) * 28);
    init uint32 actualMethodSigRow;
    init uint32 actualBodyRow;
    if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, methodOffset + 8,
            ref init actualMethodSigRow)
        || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, methodOffset + 24,
            ref init actualBodyRow)
        || actualMethodSigRow != uint32(methodSigRow)
        || actualBodyRow != uint32(bodyRow))
    {
        return 3;
    }

    int32 bodyEntry = FindStandaloneArtifactSection(0x0020);
    int32 bodyTableCount = GetStandaloneArtifactSectionCount(0x0020);
    if (bodyEntry == 0 || bodyRow > bodyTableCount)
    {
        return 3;
    }
    int32 bodySectionStart
        = Host.StandaloneSectionStarts[bodyEntry];
    int32 bodySectionLength
        = Host.StandaloneSectionLengths[bodyEntry];
    if (Host.StandaloneDecoderBodyOwnershipValidated[
            artifactOrdinal] == 0)
    {
        if (!TryValidateStandaloneVariableTableIndex(artifactStart,
                artifactLength, bodySectionStart, bodySectionLength,
                bodyTableCount, 1, 1))
        {
            return 3;
        }
        for (mut int32 index = 0;
            index < Host.StandaloneDecoderBodyOwners.Length;
            index = index + 1)
        {
            Host.StandaloneDecoderBodyOwners[index] = 0;
        }
        int32 ownerStatus = ValidateStandaloneDecoderBodyOwners(
            artifactStart, artifactLength, bodyTableCount);
        if (ownerStatus != 0
            || Host.StandaloneDecoderBodyOwners[bodyRow]
                != methodDefRow)
        {
            return ownerStatus != 0 ? ownerStatus : 3;
        }
        Host.StandaloneDecoderBodyOwnershipValidated[
            artifactOrdinal] = 1;
    }

    init int32 bodyStart;
    init int32 bodyLength;
    if (!TryGetStandaloneVariableTableRowExtent(artifactStart,
            artifactLength, bodySectionStart, bodySectionLength,
            bodyTableCount, 1, 1, bodyRow,
            ref init bodyStart, ref init bodyLength)
        || bodyLength <= 0)
    {
        return 3;
    }
    init int32 implementationKind;
    if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
            artifactLength, bodyStart,
            ref init implementationKind)
        || implementationKind < 1 || implementationKind > 5)
    {
        return 3;
    }
    if (implementationKind == 1)
    {
        if (bodyLength < 17)
        {
            return 3;
        }
        init int32 instructionEncoding;
        init int32 mapMask;
        init uint32 reserved;
        if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, bodyStart + 1,
                ref init instructionEncoding)
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, bodyStart + 2, ref init mapMask)
            || !TryReadStandaloneArtifactAbsoluteHalfWord(
                artifactStart, artifactLength, bodyStart + 3,
                ref init reserved)
            || instructionEncoding != 1
            || (mapMask & 0xE0) != 0 || reserved != 0)
        {
            return 3;
        }
    }

    *bodyStartResult = bodyStart;
    *bodyLengthResult = bodyLength;
    return 0;
}

int32 ResolveStandaloneDecoderCallTargetPlan(int32 bodyOffset,
    int32 methodMapIndex, int32 targetKind, int32 targetId,
    int32 targetViewId, int32 targetMethodRecordId,
    int32 artifactStart, int32 artifactLength,
    ref<init int32> targetArtifactOrdinalResult,
    ref<init int32> targetModuleIdResult,
    ref<init int32> targetModuleRowResult,
    ref<init int32> targetMethodDefRowResult,
    ref<init int32> targetMethodSigRowResult,
    ref<init int32> targetBodyRowResult,
    ref<init int32> targetBodyStartResult,
    ref<init int32> targetBodyLengthResult)
    ensure return == 0
        ? (*targetArtifactOrdinalResult is init
            && *targetModuleIdResult is init
            && *targetModuleRowResult is init
            && *targetMethodDefRowResult is init
            && *targetMethodSigRowResult is init
            && *targetBodyRowResult is init
            && *targetBodyStartResult is init
            && *targetBodyLengthResult is init) : true
{
    if (targetKind == 1)
    {
        int32 localCallableCount
            = Host.StandaloneDecoderLocalCallableCount[0];
        if (targetId < 0 || targetId >= localCallableCount
            || targetViewId < 0
            || targetMethodRecordId < 0
            || targetMethodRecordId
                >= Host.StandaloneDecoderMethodCount[0])
        {
            return 3;
        }

        int32 localOffset = targetId * 4;
        int32 methodOffset = targetMethodRecordId * 16;
        int32 moduleId
            = Host.StandaloneDecoderLocalCallables[localOffset];
        int32 bodyRow
            = Host.StandaloneDecoderLocalCallables[localOffset + 2];
        int32 methodRecord
            = Host.StandaloneDecoderLocalCallables[localOffset + 3];
        if (methodRecord != targetMethodRecordId
            || Host.StandaloneDecoderMethods[methodOffset + 13] != 1
            || Host.StandaloneDecoderMethods[methodOffset + 12] != targetId
            || Host.StandaloneDecoderMethods[methodOffset] != moduleId
            || targetViewId != targetMethodRecordId
            || bodyRow <= 0
            || targetId >= Host.StandaloneDecoderBodyCount[0])
        {
            return 3;
        }

        int32 bodyDescriptorOffset = targetId * 34;
        if (Host.StandaloneDecoderBodies[bodyDescriptorOffset]
                != targetMethodRecordId
            || Host.StandaloneDecoderBodies[bodyDescriptorOffset + 4]
                != bodyRow
            || Host.StandaloneDecoderBodies[bodyDescriptorOffset + 1]
                != Host.StandaloneDecoderMethods[methodOffset + 1]
            || Host.StandaloneDecoderBodies[bodyDescriptorOffset + 2]
                != Host.StandaloneDecoderMethods[methodOffset + 2]
            || Host.StandaloneDecoderBodies[bodyDescriptorOffset + 27]
                != moduleId)
        {
            return 3;
        }

        *targetArtifactOrdinalResult
            = Host.StandaloneDecoderMethods[methodOffset + 1];
        *targetModuleIdResult = moduleId;
        *targetModuleRowResult
            = Host.StandaloneDecoderMethods[methodOffset + 2];
        *targetMethodDefRowResult
            = Host.StandaloneDecoderMethods[methodOffset + 3];
        *targetMethodSigRowResult
            = Host.StandaloneDecoderMethods[methodOffset + 4];
        *targetBodyRowResult = bodyRow;
        *targetBodyStartResult
            = Host.StandaloneDecoderBodies[bodyDescriptorOffset + 5];
        *targetBodyLengthResult
            = Host.StandaloneDecoderBodies[bodyDescriptorOffset + 6];
        return 0;
    }

    if (targetKind != 2 || targetId < 0
        || targetMethodRecordId < 0
        || targetMethodRecordId
            >= Host.StandaloneDecoderMethodCount[0])
    {
        return 3;
    }

    int32 callerArtifactOrdinal
        = Host.StandaloneDecoderBodies[bodyOffset + 1];
    int32 callerModuleRow
        = Host.StandaloneDecoderBodies[bodyOffset + 2];
    int32 callerModuleId
        = Host.StandaloneDecoderBodies[bodyOffset + 27];
    int32 methodMapStart
        = Host.StandaloneDecoderBodies[bodyOffset + 13];
    init uint32 methodToken;
    if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength,
            methodMapStart + (methodMapIndex * 4),
            ref init methodToken))
    {
        return 3;
    }

    uint32 tokenKind = methodToken & 0xFF00_0000;
    uint32 tokenRow = methodToken & 0x00FF_FFFF;
    int32 importId;
    if (tokenKind == 0x1C00_0000)
    {
        importId = targetViewId;
        if (importId < 0
            || importId
                >= Host.StandaloneDecoderImportedCallableCount[0]
            || tokenRow == 0)
        {
            return 3;
        }
    }
    else if (tokenKind == 0x1600_0000)
    {
        if (targetViewId != targetMethodRecordId
            || tokenRow
                != uint32(Host.StandaloneDecoderMethods[
                    targetMethodRecordId * 16 + 3]))
        {
            return 3;
        }
        int32 expectedGroupId
            = Host.StandaloneDecoderMethods[
                targetMethodRecordId * 16 + 14];
        importId
            = GetStandaloneDecoderRepresentativeImportId(
                expectedGroupId);
        if (importId < 0)
        {
            return 3;
        }
    }
    else
    {
        return 3;
    }

    int32 importedOffset = importId * 16;
    int32 catalogOrdinal
        = Host.StandaloneDecoderImportedCallables[importedOffset];
    int32 expectedCallableId
        = Host.StandaloneDecoderImportedCallables[
            importedOffset + 3];
    if (expectedCallableId != targetId
        || Host.StandaloneDecoderImportedCallables[
            importedOffset + 1] != callerModuleId
        || Host.StandaloneDecoderImportedCallables[
            importedOffset + 4] != callerArtifactOrdinal
        || Host.StandaloneDecoderImportedCallables[
            importedOffset + 5] != callerModuleRow
        || (tokenKind == 0x1C00_0000
            && Host.StandaloneDecoderImportedCallables[
                importedOffset + 6] != int32(tokenRow))
        || Host.StandaloneDecoderImportedCallables[
            importedOffset + 7]
            != Host.StandaloneDecoderMethods[
                targetMethodRecordId * 16 + 3]
        || catalogOrdinal < 0
        || catalogOrdinal
            >= Host.StandaloneResolvedImportCount[0])
    {
        return 3;
    }

    int32 resolvedOffset = catalogOrdinal * 32;
    int32 providerDirectoryRow
        = Host.StandaloneResolvedImports[resolvedOffset + 4];
    int32 providerArtifactOrdinal
        = Host.StandaloneDecoderImportedCallables[
            importedOffset + 8];
    int32 providerModuleRow
        = Host.StandaloneDecoderImportedCallables[
            importedOffset + 9];
    int32 providerModuleId
        = Host.StandaloneDecoderImportedCallables[
            importedOffset + 2];
    int32 providerMethodDefRow
        = Host.StandaloneDecoderImportedCallables[
            importedOffset + 10];
    int32 providerBodyRow
        = Host.StandaloneDecoderImportedCallables[
            importedOffset + 11];
    int32 providerMethodSigRow
        = Host.StandaloneResolvedImports[resolvedOffset + 23];
    int32 expectedProviderBodyRow
        = Host.StandaloneResolvedImports[resolvedOffset + 28];
    if (providerArtifactOrdinal < 0
        || providerModuleRow <= 0 || providerModuleId < 0
        || providerMethodDefRow <= 0 || providerBodyRow < 0
        || providerBodyRow != expectedProviderBodyRow
        || providerMethodSigRow <= 0
        || providerDirectoryRow != providerModuleId + 1
        || providerDirectoryRow
            >= Host.StandaloneModuleDirectory.Length / 8
        || Host.StandaloneModuleDirectory[
            providerDirectoryRow * 8] != providerArtifactOrdinal
        || Host.StandaloneModuleDirectory[
            providerDirectoryRow * 8 + 1] != providerModuleRow)
    {
        return 3;
    }

    *targetArtifactOrdinalResult = providerArtifactOrdinal;
    *targetModuleIdResult = providerModuleId;
    *targetModuleRowResult = providerModuleRow;
    *targetMethodDefRowResult = providerMethodDefRow;
    *targetMethodSigRowResult = providerMethodSigRow;
    *targetBodyRowResult = providerBodyRow;
    *targetBodyStartResult = 0;
    *targetBodyLengthResult = 0;
    return 0;
}

int32 DecodeStandaloneCallSiteRecord(int32 bodyId,
    int32 bodyOffset, int32 recordIndex, int32 recordStart,
    int32 recordLength, int32 artifactStart, int32 artifactLength)
{
    if (recordLength < 20)
    {
        return 3;
    }

    init int32 targetKind;
    init int32 resultKind;
    init uint32 flags;
    init uint32 targetIndex;
    init uint32 resultIndex;
    init uint32 inputCountValue;
    init uint32 preparationCountValue;
    if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
            artifactLength, recordStart + 4, ref init targetKind)
        || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
            artifactLength, recordStart + 5, ref init resultKind)
        || !TryReadStandaloneArtifactAbsoluteHalfWord(
            artifactStart, artifactLength, recordStart + 6,
            ref init flags)
        || !TryReadStandaloneArtifactAbsoluteHalfWord(
            artifactStart, artifactLength, recordStart + 8,
            ref init targetIndex)
        || !TryReadStandaloneArtifactAbsoluteHalfWord(
            artifactStart, artifactLength, recordStart + 10,
            ref init resultIndex)
        || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, recordStart + 12,
            ref init inputCountValue)
        || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, recordStart + 16,
            ref init preparationCountValue)
        || flags != 0
        || (targetKind < 1 || targetKind > 3)
        || resultKind > 2
        || (resultKind == 0 && resultIndex != 0))
    {
        return 3;
    }

    int64 expectedLength = 20 + int64(inputCountValue) * 4
        + int64(preparationCountValue) * 2;
    if (expectedLength != int64(recordLength))
    {
        return 3;
    }
    if (targetKind != 1 || preparationCountValue != 0)
    {
        return 2;
    }

    int32 methodMapCount
        = Host.StandaloneDecoderBodies[bodyOffset + 12];
    if (targetIndex >= uint32(methodMapCount))
    {
        return 3;
    }
    int32 methodMapGlobalFirst
        = Host.StandaloneDecoderBodies[bodyOffset + 30];
    int32 targetOffset
        = (methodMapGlobalFirst + int32(targetIndex)) * 4;
    int32 resolvedTargetKind
        = Host.StandaloneDecoderMethodMapTargets[targetOffset];
    int32 resolvedTargetId
        = Host.StandaloneDecoderMethodMapTargets[targetOffset + 1];
    int32 targetViewId
        = Host.StandaloneDecoderMethodMapTargets[targetOffset + 2];
    int32 targetMethodRecordId
        = Host.StandaloneDecoderMethodMapTargets[targetOffset + 3];
    if ((resolvedTargetKind != 1 && resolvedTargetKind != 2)
        || resolvedTargetId < 0
        || targetMethodRecordId < 0
        || targetMethodRecordId
            >= Host.StandaloneDecoderMethodCount[0])
    {
        return 3;
    }

    int32 targetMethodOffset = targetMethodRecordId * 16;
    int32 callerMethodRecordId
        = Host.StandaloneDecoderBodies[bodyOffset];
    int32 bodyArtifactOrdinal
        = Host.StandaloneDecoderBodies[bodyOffset + 1];
    if (callerMethodRecordId < 0
        || callerMethodRecordId
            >= Host.StandaloneDecoderMethodCount[0]
        || Host.StandaloneDecoderMethods[targetMethodRecordId * 16]
            != Host.StandaloneDecoderBodies[bodyOffset + 27]
        || Host.StandaloneDecoderMethods[targetMethodRecordId * 16 + 2]
            != Host.StandaloneDecoderBodies[bodyOffset + 2]
        || Host.StandaloneDecoderMethods[
            targetMethodRecordId * 16 + 1] != bodyArtifactOrdinal)
    {
        return 3;
    }
    int32 callerEffectMask
        = Host.StandaloneDecoderMethods[
            callerMethodRecordId * 16 + 15];
    int32 targetEffectMask
        = Host.StandaloneDecoderMethods[targetMethodOffset + 15];
    if ((targetEffectMask & 4) != 0
        && (callerEffectMask & 4) == 0)
    {
        return 3;
    }

    int32 targetResultTypeId
        = Host.StandaloneDecoderMethods[targetMethodOffset + 5];
    if (targetResultTypeId <= 0
        || targetResultTypeId > Host.StandaloneTypeFactCount[0]
        || Host.StandaloneTypeFacts[targetResultTypeId * 3] != 0)
    {
        return 2;
    }
    int32 resultTypeCode
        = Host.StandaloneTypeFacts[targetResultTypeId * 3 + 1];
    int32 resultWidth
        = GetStandaloneDecoderScalarWidth(targetResultTypeId);
    if (resultWidth < 0)
    {
        return 2;
    }
    bool doesNotReturn = (targetEffectMask & 2) != 0;
    bool isUnitResult = resultTypeCode == 0;
    if ((resultKind == 0
            && !doesNotReturn && !isUnitResult)
        || (resultKind != 0 && doesNotReturn)
        || (resultKind != 0 && isUnitResult))
    {
        return 3;
    }
    if (resultKind == 1
        && (resultIndex > 15 || resultIndex == 14))
    {
        return 3;
    }
    if (resultKind == 2)
    {
        int32 homeCount
            = Host.StandaloneDecoderBodies[bodyOffset + 8];
        if (resultIndex >= uint32(homeCount))
        {
            return 3;
        }
        int32 homeGlobalFirst
            = Host.StandaloneDecoderBodies[bodyOffset + 28];
        if (Host.StandaloneDecoderHomes[
                (homeGlobalFirst + int32(resultIndex)) * 3 + 1]
            != targetResultTypeId)
        {
            return 3;
        }
    }

    int32 targetParameterCount
        = Host.StandaloneDecoderMethods[targetMethodOffset + 7];
    if (inputCountValue != uint32(targetParameterCount)
        || inputCountValue > 0x7FFF_FFFF)
    {
        return 3;
    }
    int32 inputCount = int32(inputCountValue);
    int32 inputFirst = Host.StandaloneDecoderCallInputCount[0];
    int32 inputCapacity
        = Host.StandaloneDecoderCallInputs.Length / 4;
    if (inputFirst < 0 || inputFirst > inputCapacity - inputCount)
    {
        return 3;
    }

    int32 inputStart = recordStart + 20;
    for (mut int32 inputOrdinal = 0;
        inputOrdinal < inputCount;
        inputOrdinal = inputOrdinal + 1)
    {
        int32 inputOffset = inputStart + inputOrdinal * 4;
        init int32 selectorKind;
        init int32 sourceUse;
        init uint32 selectorIndex;
        if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, inputOffset,
                ref init selectorKind)
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, inputOffset + 1,
                ref init sourceUse)
            || !TryReadStandaloneArtifactAbsoluteHalfWord(
                artifactStart, artifactLength, inputOffset + 2,
                ref init selectorIndex)
            || selectorKind < 0 || selectorKind > 2)
        {
            return 3;
        }

        init int32 formalTypeId;
        int32 parameterStatus
            = GetStandaloneDecoderMethodParameterTypeId(
                targetMethodRecordId, inputOrdinal,
                ref init formalTypeId);
        if (parameterStatus != 0)
        {
            return parameterStatus;
        }
        int32 formalTypeKind
            = Host.StandaloneTypeFacts[formalTypeId * 3];
        int32 formalTypeCode
            = Host.StandaloneTypeFacts[formalTypeId * 3 + 1];
        if ((formalTypeKind == 0
                && GetStandaloneDecoderScalarWidth(formalTypeId) < 0)
            || (formalTypeKind == 1
                && !IsStandaloneCallableScalarCode(formalTypeCode))
            || formalTypeKind < 0 || formalTypeKind > 1)
        {
            return 2;
        }

        if (selectorKind == 0)
        {
            if (sourceUse != 0 || selectorIndex != 0
                || formalTypeKind != 0 || formalTypeCode != 0)
            {
                return 3;
            }
        }
        else if (selectorKind == 1)
        {
            if (selectorIndex > 15 || formalTypeCode == 0
                || (formalTypeKind == 0 && sourceUse != 1)
                || (formalTypeKind == 1 && sourceUse != 5))
            {
                return 3;
            }
        }
        else
        {
            int32 homeCount
                = Host.StandaloneDecoderBodies[bodyOffset + 8];
            if (selectorIndex >= uint32(homeCount))
            {
                return 3;
            }
            int32 homeGlobalFirst
                = Host.StandaloneDecoderBodies[bodyOffset + 28];
            int32 homeTypeId
                = Host.StandaloneDecoderHomes[
                    (homeGlobalFirst + int32(selectorIndex)) * 3 + 1];
            if (homeTypeId != formalTypeId
                || (formalTypeKind == 0 && formalTypeCode == 0)
                || (formalTypeKind == 0 && sourceUse != 1)
                || (formalTypeKind == 1 && sourceUse != 5))
            {
                return 3;
            }
        }

        int32 decodedInputOffset = (inputFirst + inputOrdinal) * 4;
        Host.StandaloneDecoderCallInputs[decodedInputOffset]
            = selectorKind;
        Host.StandaloneDecoderCallInputs[decodedInputOffset + 1]
            = sourceUse;
        Host.StandaloneDecoderCallInputs[decodedInputOffset + 2]
            = int32(selectorIndex);
        Host.StandaloneDecoderCallInputs[decodedInputOffset + 3]
            = formalTypeId;
    }

    int32 callCount = Host.StandaloneDecoderCallCount[0];
    int32 callCapacity = Host.StandaloneDecoderCalls.Length / 22;
    if (callCount < 0 || callCount >= callCapacity)
    {
        return 3;
    }
    int32 callOffset = callCount * 22;
    Host.StandaloneDecoderCalls[callOffset] = bodyId;
    Host.StandaloneDecoderCalls[callOffset + 1] = recordIndex;
    Host.StandaloneDecoderCalls[callOffset + 2] = int32(targetIndex);
    Host.StandaloneDecoderCalls[callOffset + 3] = resolvedTargetKind;
    Host.StandaloneDecoderCalls[callOffset + 4] = resolvedTargetId;
    Host.StandaloneDecoderCalls[callOffset + 5] = targetViewId;
    Host.StandaloneDecoderCalls[callOffset + 6] = targetMethodRecordId;
    Host.StandaloneDecoderCalls[callOffset + 7] = resultKind;
    Host.StandaloneDecoderCalls[callOffset + 8] = int32(resultIndex);
    Host.StandaloneDecoderCalls[callOffset + 9] = inputFirst;
    Host.StandaloneDecoderCalls[callOffset + 10] = inputCount;
    Host.StandaloneDecoderCalls[callOffset + 11]
        = int32(preparationCountValue);
    Host.StandaloneDecoderCalls[callOffset + 12] = recordStart;
    Host.StandaloneDecoderCalls[callOffset + 13] = recordLength;
    for (mut int32 field = 14; field < 22; field = field + 1)
    {
        Host.StandaloneDecoderCalls[callOffset + field] = -1;
    }
    Host.StandaloneDecoderCallInputCount[0] = inputFirst + inputCount;
    Host.StandaloneDecoderCallCount[0] = callCount + 1;
    return 0;
}

int32 DecodeStandaloneBodyRecords()
{
    int32 bodyCount = Host.StandaloneDecoderBodyCount[0];
    if (bodyCount < 0
        || bodyCount > Host.StandaloneDecoderBodies.Length / 34)
    {
        return 3;
    }
    if (bodyCount == 0)
    {
        return 0;
    }

    int32 firstBodyOffset = 0;
    int32 artifactOrdinal
        = Host.StandaloneDecoderBodies[firstBodyOffset + 1];
    init int32 artifactStart;
    init int32 artifactLength;
    if (artifactOrdinal < 0
        || !TryValidateStandaloneArtifactDirectory(artifactOrdinal)
        || !TryGetStandaloneArtifactExtent(artifactOrdinal,
            ref init artifactStart, ref init artifactLength))
    {
        return 3;
    }

    for (mut int32 bodyId = 0;
        bodyId < bodyCount;
        bodyId = bodyId + 1)
    {
        int32 bodyOffset = bodyId * 34;
        int32 recordCount
            = Host.StandaloneDecoderBodies[bodyOffset + 21];
        int32 blockCount
            = Host.StandaloneDecoderBodies[bodyOffset + 19];
        int32 recordIndexStart
            = Host.StandaloneDecoderBodies[bodyOffset + 22];
        int32 recordDataStart
            = Host.StandaloneDecoderBodies[bodyOffset + 23];
        int32 recordDataLength
            = Host.StandaloneDecoderBodies[bodyOffset + 24];
        if (Host.StandaloneDecoderBodies[bodyOffset + 1]
                != artifactOrdinal)
        {
            return 3;
        }
        if (blockCount != 1)
        {
            return 2;
        }
        if (recordCount <= 0
            || recordIndexStart < 0 || recordDataStart < 0
            || recordDataLength < 0)
        {
            return 3;
        }

        int32 blockStart
            = Host.StandaloneDecoderBodies[bodyOffset + 20];
        init uint32 blockEntryRecord;
        if (!TryReadStandaloneArtifactAbsoluteHalfWord(
                artifactStart, artifactLength, blockStart + 8,
                ref init blockEntryRecord)
            || blockEntryRecord >= uint32(recordCount))
        {
            return 3;
        }

        int32 callFirst = Host.StandaloneDecoderCallCount[0];
        Host.StandaloneDecoderBodies[bodyOffset + 32] = callFirst;
        mut bool entryStateFound = false;
        for (mut int32 recordIndex = 0;
            recordIndex < recordCount;
            recordIndex = recordIndex + 1)
        {
            init uint32 recordStartOffset;
            init uint32 recordEndOffset;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, recordIndexStart + recordIndex * 4,
                    ref init recordStartOffset)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength,
                    recordIndexStart + (recordIndex + 1) * 4,
                    ref init recordEndOffset)
                || recordStartOffset > recordEndOffset
                || recordEndOffset > uint32(recordDataLength))
            {
                return 3;
            }
            int32 recordStart
                = recordDataStart + int32(recordStartOffset);
            int32 recordLength
                = int32(recordEndOffset - recordStartOffset);
            if (recordLength < 4)
            {
                return 3;
            }

            init int32 recordKind;
            init int32 recordFlags;
            init uint32 recordReserved;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, recordStart,
                    ref init recordKind)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, recordStart + 1,
                    ref init recordFlags)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength, recordStart + 2,
                    ref init recordReserved)
                || recordFlags != 0 || recordReserved != 0)
            {
                return 3;
            }

            if (recordKind == 1)
            {
                if (recordLength < 8)
                {
                    return 3;
                }
                init uint32 registerCount;
                if (!TryReadStandaloneArtifactAbsoluteWord(
                        artifactStart, artifactLength, recordStart + 4,
                        ref init registerCount)
                    || int64(recordLength)
                        != 8 + int64(registerCount) * 5
                    || registerCount > 14)
                {
                    return 3;
                }
                if (registerCount != 0)
                {
                    return 2;
                }
                if (recordIndex == int32(blockEntryRecord))
                {
                    entryStateFound = true;
                }
            }
            else if (recordKind == 2)
            {
                int32 callStatus = DecodeStandaloneCallSiteRecord(
                    bodyId, bodyOffset, recordIndex, recordStart,
                    recordLength, artifactStart, artifactLength);
                if (callStatus != 0)
                {
                    return callStatus;
                }
            }
            else if (recordKind >= 3 && recordKind <= 0x0B)
            {
                return 2;
            }
            else
            {
                return 3;
            }
        }

        if (!entryStateFound)
        {
            return 3;
        }
        Host.StandaloneDecoderBodies[bodyOffset + 33]
            = Host.StandaloneDecoderCallCount[0] - callFirst;
        int32 codeStatus = ValidateStandaloneBodyCode(
            bodyId, bodyOffset, artifactStart, artifactLength);
        if (codeStatus != 0)
        {
            return codeStatus;
        }
    }
    return 0;
}

int32 FindStandaloneDecoderCallRecord(int32 bodyOffset,
    int32 recordIndex)
{
    int32 callFirst
        = Host.StandaloneDecoderBodies[bodyOffset + 32];
    int32 callCount
        = Host.StandaloneDecoderBodies[bodyOffset + 33];
    if (callFirst < 0 || callCount < 0
        || callCount > Host.StandaloneDecoderCalls.Length / 22 - callFirst)
    {
        return -1;
    }

    mut int32 low = 0;
    mut int32 high = callCount - 1;
    while (low <= high)
    {
        int32 middle = low + (high - low) / 2;
        int32 callId = callFirst + middle;
        int32 callOffset = callId * 22;
        int32 candidateBody
            = Host.StandaloneDecoderCalls[callOffset];
        int32 candidateRecord
            = Host.StandaloneDecoderCalls[callOffset + 1];
        if (candidateBody != bodyOffset / 34)
        {
            return -1;
        }
        if (candidateRecord == recordIndex)
        {
            return callId;
        }
        if (candidateRecord < recordIndex)
        {
            low = middle + 1;
        }
        else
        {
            high = middle - 1;
        }
    }
    return -1;
}

bool IsStandaloneDecoderRegisterValueType(int32 typeId)
{
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0])
    {
        return false;
    }
    int32 typeKind
        = Host.StandaloneTypeFacts[typeId * 3];
    int32 typeCode
        = Host.StandaloneTypeFacts[typeId * 3 + 1];
    if (typeKind == 0)
    {
        return typeCode != 0
            && GetStandaloneDecoderScalarWidth(typeId) > 0;
    }
    return typeKind == 1
        && IsStandaloneCallableScalarCode(typeCode);
}

int32 SetStandaloneDecoderRegisterType(int32 bodyId,
    int32 registerIndex, int32 typeId)
{
    if (bodyId < 0
        || bodyId >= Host.StandaloneDecoderBodies.Length / 34
        || registerIndex < 0 || registerIndex > 13)
    {
        return 3;
    }
    if (!IsStandaloneDecoderRegisterValueType(typeId))
    {
        return 2;
    }
    Host.StandaloneDecoderRegisterTypeIds[
        bodyId * 14 + registerIndex] = typeId;
    return 0;
}

int32 ValidateStandaloneDecoderHomeStore(int32 bodyId,
    int32 bodyOffset, int32 homeIndex, int32 sourceRegister)
{
    int32 homeCount
        = Host.StandaloneDecoderBodies[bodyOffset + 8];
    if (homeIndex < 0 || homeIndex >= homeCount
        || sourceRegister < 0 || sourceRegister > 13)
    {
        return 3;
    }

    int32 homeFirst
        = Host.StandaloneDecoderBodies[bodyOffset + 28];
    int32 homeOffset = (homeFirst + homeIndex) * 3;
    int32 homeFlagsAndRole
        = Host.StandaloneDecoderHomes[homeOffset];
    int32 homeRole = homeFlagsAndRole & 0xFF;
    int32 homeFlags = homeFlagsAndRole >>> 8;
    int32 homeTypeId
        = Host.StandaloneDecoderHomes[homeOffset + 1];
    if (homeRole != 3 || (homeFlags & ~1) != 0)
    {
        return 3;
    }
    if (homeTypeId <= 0
        || homeTypeId > Host.StandaloneTypeFactCount[0]
        || Host.StandaloneTypeFacts[homeTypeId * 3] != 0
        || !IsStandaloneDecoderRegisterValueType(homeTypeId))
    {
        return 2;
    }
    return Host.StandaloneDecoderRegisterTypeIds[
            bodyId * 14 + sourceRegister] == homeTypeId
        ? 0 : 3;
}

int32 ValidateStandaloneDecoderCallInstruction(int32 bodyId,
    int32 bodyOffset, int32 recordIndex,
    ref<init bool> doesNotReturnResult)
    ensure return == 0 ? *doesNotReturnResult is init : true
{
    int32 callId = FindStandaloneDecoderCallRecord(
        bodyOffset, recordIndex);
    if (callId < 0)
    {
        return 3;
    }

    int32 callOffset = callId * 22;
    int32 targetMethodRecordId
        = Host.StandaloneDecoderCalls[callOffset + 6];
    int32 inputFirst
        = Host.StandaloneDecoderCalls[callOffset + 9];
    int32 inputCount
        = Host.StandaloneDecoderCalls[callOffset + 10];
    int32 resultKind
        = Host.StandaloneDecoderCalls[callOffset + 7];
    int32 resultIndex
        = Host.StandaloneDecoderCalls[callOffset + 8];
    if (targetMethodRecordId < 0
        || targetMethodRecordId
            >= Host.StandaloneDecoderMethodCount[0]
        || inputFirst < 0 || inputCount < 0
        || inputCount
            > Host.StandaloneDecoderCallInputs.Length / 4 - inputFirst)
    {
        return 3;
    }

    for (mut int32 inputOrdinal = 0;
        inputOrdinal < inputCount;
        inputOrdinal = inputOrdinal + 1)
    {
        int32 inputOffset = (inputFirst + inputOrdinal) * 4;
        int32 selectorKind
            = Host.StandaloneDecoderCallInputs[inputOffset];
        int32 sourceUse
            = Host.StandaloneDecoderCallInputs[inputOffset + 1];
        int32 selectorIndex
            = Host.StandaloneDecoderCallInputs[inputOffset + 2];
        int32 expectedTypeId
            = Host.StandaloneDecoderCallInputs[inputOffset + 3];
        if (selectorKind == 1)
        {
            if (selectorIndex >= 14)
            {
                return 2;
            }
            int32 actualTypeId
                = Host.StandaloneDecoderRegisterTypeIds[
                    bodyId * 14 + selectorIndex];
            if (actualTypeId <= 0
                || actualTypeId != expectedTypeId
                || (sourceUse != 1 && sourceUse != 5))
            {
                return 3;
            }
        }
        else if (selectorKind != 0 && selectorKind != 2)
        {
            return 3;
        }
    }

    int32 targetMethodOffset = targetMethodRecordId * 16;
    int32 targetEffectMask
        = Host.StandaloneDecoderMethods[targetMethodOffset + 15];
    *doesNotReturnResult = (targetEffectMask & 2) != 0;
    if (resultKind == 1 && resultIndex <= 13)
    {
        int32 resultTypeId
            = Host.StandaloneDecoderMethods[targetMethodOffset + 5];
        return SetStandaloneDecoderRegisterType(
            bodyId, resultIndex, resultTypeId);
    }
    if (resultKind == 1 && resultIndex == 15)
    {
        return 0;
    }
    if (resultKind == 0 || resultKind == 2)
    {
        return 0;
    }
    return 3;
}

int32 GetStandaloneDecoderUnsupportedOpcodeStatus(int32 opcode)
{
    if ((opcode >= 0x00 && opcode <= 0x0F)
        || (opcode >= 0x10 && opcode <= 0x1A)
        || (opcode >= 0x20 && opcode <= 0x2B)
        || (opcode >= 0x30 && opcode <= 0x36)
        || (opcode >= 0x40 && opcode <= 0x41)
        || (opcode >= 0x50 && opcode <= 0x52)
        || (opcode >= 0x60 && opcode <= 0x67)
        || (opcode >= 0x70 && opcode <= 0x7F)
        || (opcode >= 0x80 && opcode <= 0x83)
        || (opcode >= 0x90 && opcode <= 0x92)
        || (opcode >= 0xA0 && opcode <= 0xAF)
        || (opcode >= 0xB0 && opcode <= 0xB8)
        || (opcode >= 0xC0 && opcode <= 0xCC)
        || (opcode >= 0xD0 && opcode <= 0xDE)
        || (opcode >= 0xE0 && opcode <= 0xE8)
        || opcode == 0xEA || opcode == 0xEB)
    {
        return 2;
    }
    return 3;
}

int32 ValidateStandaloneBodyCode(int32 bodyId, int32 bodyOffset,
    int32 artifactStart, int32 artifactLength)
{
    int32 codeStart
        = Host.StandaloneDecoderBodies[bodyOffset + 25];
    int32 codeLength
        = Host.StandaloneDecoderBodies[bodyOffset + 26];
    int32 methodRecordId
        = Host.StandaloneDecoderBodies[bodyOffset];
    int32 homeCount
        = Host.StandaloneDecoderBodies[bodyOffset + 8];
    int32 constantMapCount
        = Host.StandaloneDecoderBodies[bodyOffset + 16];
    int32 constantMapFirst
        = Host.StandaloneDecoderBodies[bodyOffset + 31];
    if (codeStart < artifactStart || codeLength <= 0
        || methodRecordId < 0
        || methodRecordId >= Host.StandaloneDecoderMethodCount[0])
    {
        return 3;
    }

    int32 callerMethodOffset = methodRecordId * 16;
    int32 resultTypeId
        = Host.StandaloneDecoderMethods[callerMethodOffset + 5];
    if (resultTypeId <= 0
        || resultTypeId > Host.StandaloneTypeFactCount[0]
        || Host.StandaloneTypeFacts[resultTypeId * 3] != 0)
    {
        return 2;
    }
    int32 resultTypeCode
        = Host.StandaloneTypeFacts[resultTypeId * 3 + 1];
    int32 resultWidth
        = GetStandaloneDecoderScalarWidth(resultTypeId);
    if (resultWidth < 0)
    {
        return 2;
    }

    mut int32 codeOffset = 0;
    mut bool terminal = false;
    mut bool terminalDoesNotReturn = false;
    while (codeOffset < codeLength)
    {
        init int32 opcode;
        if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, codeStart + codeOffset,
                ref init opcode))
        {
            return 3;
        }

        if (opcode == 0x00)
        {
            codeOffset = codeOffset + 1;
            if (resultTypeCode != 0)
            {
                int32 returnTypeId
                    = Host.StandaloneDecoderRegisterTypeIds[bodyId * 14];
                if (returnTypeId <= 0 || returnTypeId != resultTypeId)
                {
                    return 3;
                }
            }
            terminal = true;
        }
        else if (opcode >= 0x01 && opcode <= 0x03)
        {
            int32 formalOrdinal = opcode - 1;
            init int32 formalTypeId;
            int32 status = GetStandaloneDecoderMethodParameterTypeId(
                methodRecordId, formalOrdinal, ref init formalTypeId);
            if (status != 0)
            {
                return status;
            }
            status = SetStandaloneDecoderRegisterType(
                bodyId, formalOrdinal, formalTypeId);
            if (status != 0)
            {
                return status;
            }
            codeOffset = codeOffset + 1;
        }
        else if (opcode == 0x04)
        {
            init int32 firstTypeId;
            init int32 secondTypeId;
            int32 firstStatus
                = GetStandaloneDecoderMethodParameterTypeId(
                    methodRecordId, 0, ref init firstTypeId);
            int32 secondStatus
                = GetStandaloneDecoderMethodParameterTypeId(
                    methodRecordId, 1, ref init secondTypeId);
            if (firstStatus != 0 || secondStatus != 0)
            {
                return firstStatus != 0 ? firstStatus : secondStatus;
            }
            int32 setStatus = SetStandaloneDecoderRegisterType(
                bodyId, 0, firstTypeId);
            if (setStatus == 0)
            {
                setStatus = SetStandaloneDecoderRegisterType(
                    bodyId, 1, secondTypeId);
            }
            if (setStatus != 0)
            {
                return setStatus;
            }
            codeOffset = codeOffset + 1;
        }
        else if (opcode == 0x05 || opcode == 0x06)
        {
            int32 homeIndex = opcode == 0x05 ? 0 : 1;
            if (homeIndex >= homeCount)
            {
                return 3;
            }
            int32 homeFirst
                = Host.StandaloneDecoderBodies[bodyOffset + 28];
            int32 homeTypeId
                = Host.StandaloneDecoderHomes[
                    (homeFirst + homeIndex) * 3 + 1];
            int32 setStatus = SetStandaloneDecoderRegisterType(
                bodyId, homeIndex, homeTypeId);
            if (setStatus != 0)
            {
                return setStatus;
            }
            codeOffset = codeOffset + 1;
        }
        else if (opcode == 0x07 || opcode == 0x08)
        {
            int32 homeIndex = opcode == 0x07 ? 0 : 1;
            int32 sourceRegister = opcode == 0x07 ? 0 : 1;
            int32 storeStatus = ValidateStandaloneDecoderHomeStore(
                bodyId, bodyOffset, homeIndex, sourceRegister);
            if (storeStatus != 0)
            {
                return storeStatus;
            }
            codeOffset = codeOffset + 1;
        }
        else if (opcode == 0x09)
        {
            if (constantMapCount <= 0)
            {
                return 3;
            }
            int32 constantTypeId
                = Host.StandaloneDecoderConstantMapEntries[
                    constantMapFirst * 3];
            int32 setStatus = SetStandaloneDecoderRegisterType(
                bodyId, 0, constantTypeId);
            if (setStatus != 0)
            {
                return setStatus;
            }
            codeOffset = codeOffset + 1;
        }
        else if (opcode == 0x13 || opcode == 0x16)
        {
            if (codeOffset > codeLength - 2)
            {
                return 3;
            }
            init int32 control;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, codeStart + codeOffset + 1,
                    ref init control))
            {
                return 3;
            }
            int32 destinationRegister = control & 0x0F;
            int32 mapIndex = control >>> 4;
            if (destinationRegister > 13)
            {
                return 3;
            }
            int32 mapTypeId;
            if (opcode == 0x13)
            {
                if (mapIndex >= homeCount)
                {
                    return 3;
                }
                int32 homeFirst
                    = Host.StandaloneDecoderBodies[bodyOffset + 28];
                mapTypeId
                    = Host.StandaloneDecoderHomes[
                        (homeFirst + mapIndex) * 3 + 1];
            }
            else
            {
                if (mapIndex >= constantMapCount)
                {
                    return 3;
                }
                mapTypeId
                    = Host.StandaloneDecoderConstantMapEntries[
                        (constantMapFirst + mapIndex) * 3];
            }
            int32 setStatus = SetStandaloneDecoderRegisterType(
                bodyId, destinationRegister, mapTypeId);
            if (setStatus != 0)
            {
                return setStatus;
            }
            codeOffset = codeOffset + 2;
        }
        else if (opcode == 0x14)
        {
            if (codeOffset > codeLength - 2)
            {
                return 3;
            }
            init int32 control;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, codeStart + codeOffset + 1,
                    ref init control))
            {
                return 3;
            }
            int32 homeIndex = control & 0x0F;
            int32 sourceRegister = control >>> 4;
            int32 storeStatus = ValidateStandaloneDecoderHomeStore(
                bodyId, bodyOffset, homeIndex, sourceRegister);
            if (storeStatus != 0)
            {
                return storeStatus;
            }
            codeOffset = codeOffset + 2;
        }
        else if (opcode == 0xD4 || opcode == 0xD5)
        {
            if (codeOffset > codeLength - 4)
            {
                return 3;
            }
            init int32 control;
            init uint32 mapIndex;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, codeStart + codeOffset + 1,
                    ref init control)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength,
                    codeStart + codeOffset + 2, ref init mapIndex)
                || (control & 0xF0) != 0
                || (control & 0x0F) > 13)
            {
                return 3;
            }
            int32 destinationRegister = control & 0x0F;
            int32 mapTypeId;
            if (opcode == 0xD4)
            {
                if (mapIndex >= uint32(constantMapCount))
                {
                    return 3;
                }
                mapTypeId
                    = Host.StandaloneDecoderConstantMapEntries[
                        (constantMapFirst + int32(mapIndex)) * 3];
            }
            else
            {
                if (mapIndex >= uint32(homeCount))
                {
                    return 3;
                }
                int32 homeFirst
                    = Host.StandaloneDecoderBodies[bodyOffset + 28];
                mapTypeId
                    = Host.StandaloneDecoderHomes[
                        (homeFirst + int32(mapIndex)) * 3 + 1];
            }
            int32 setStatus = SetStandaloneDecoderRegisterType(
                bodyId, destinationRegister, mapTypeId);
            if (setStatus != 0)
            {
                return setStatus;
            }
            codeOffset = codeOffset + 4;
        }
        else if (opcode == 0xD6)
        {
            if (codeOffset > codeLength - 4)
            {
                return 3;
            }
            init int32 control;
            init uint32 homeIndex;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, codeStart + codeOffset + 1,
                    ref init control)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength,
                    codeStart + codeOffset + 2, ref init homeIndex)
                || (control >>> 4) != 1)
            {
                return 3;
            }
            int32 storeStatus = ValidateStandaloneDecoderHomeStore(
                bodyId, bodyOffset, int32(homeIndex), control & 0x0F);
            if (storeStatus != 0)
            {
                return storeStatus;
            }
            codeOffset = codeOffset + 4;
        }
        else if (opcode == 0xC0)
        {
            if (codeOffset > codeLength - 4)
            {
                return 3;
            }
            init int32 control;
            init uint32 registerPayload;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, codeStart + codeOffset + 1,
                    ref init control)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength,
                    codeStart + codeOffset + 2,
                    ref init registerPayload))
            {
                return 3;
            }
            int32 resultRegister
                = int32(registerPayload & 0x0F);
            int32 unusedResult
                = int32((registerPayload >> 4) & 0x0F);
            int32 sourceRegister
                = int32((registerPayload >> 8) & 0x0F);
            int32 unusedSource
                = int32((registerPayload >> 12) & 0x0F);
            if (resultRegister > 13
                || resultRegister != sourceRegister
                || unusedResult != 15 || unusedSource != 15)
            {
                return 3;
            }
            int32 registerTypeId
                = Host.StandaloneDecoderRegisterTypeIds[
                    bodyId * 14 + sourceRegister];
            if (registerTypeId <= 0
                || registerTypeId
                    > Host.StandaloneTypeFactCount[0]
                || Host.StandaloneTypeFacts[
                    registerTypeId * 3] != 0)
            {
                return 3;
            }
            int32 typeCode
                = Host.StandaloneTypeFacts[
                    registerTypeId * 3 + 1];
            bool integerType
                = (typeCode >= 0x06 && typeCode <= 0x0F)
                    || typeCode == 0x10 || typeCode == 0x11;
            bool floatingType
                = typeCode == 0x14 || typeCode == 0x15;
            if (control == 0x04 || control == 0x08)
            {
                if (!integerType)
                {
                    return 3;
                }
            }
            else if (control == 0x25)
            {
                if (!floatingType)
                {
                    return 3;
                }
            }
            else if ((control >= 1 && control <= 0x0F)
                || (control >= 0x20 && control <= 0x25))
            {
                return 2;
            }
            else
            {
                return 3;
            }
            int32 registerTypeStatus
                = SetStandaloneDecoderRegisterType(
                    bodyId, resultRegister, registerTypeId);
            if (registerTypeStatus != 0)
            {
                return registerTypeStatus;
            }
            codeOffset = codeOffset + 4;
        }
        else if (opcode == 0xC1)
        {
            if (codeOffset > codeLength - 4)
            {
                return 3;
            }
            init int32 control;
            init uint32 registerPayload;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, codeStart + codeOffset + 1,
                    ref init control)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength,
                    codeStart + codeOffset + 2,
                    ref init registerPayload))
            {
                return 3;
            }
            int32 resultRegister
                = int32(registerPayload & 0x0F);
            int32 unusedResult
                = int32((registerPayload >> 4) & 0x0F);
            int32 source0Register
                = int32((registerPayload >> 8) & 0x0F);
            int32 source1Register
                = int32((registerPayload >> 12) & 0x0F);
            if (resultRegister > 13 || unusedResult != 15)
            {
                return 3;
            }
            int32 registerTypeId = -1;
            if (control == 0x04)
            {
                if (resultRegister != source0Register
                    || source1Register != 15
                    || source0Register > 13)
                {
                    return 3;
                }
                registerTypeId
                    = Host.StandaloneDecoderRegisterTypeIds[
                        bodyId * 14 + source0Register];
                if (registerTypeId <= 0
                    || registerTypeId
                        > Host.StandaloneTypeFactCount[0]
                    || Host.StandaloneTypeFacts[
                        registerTypeId * 3] != 0)
                {
                    return 3;
                }
                int32 typeCode
                    = Host.StandaloneTypeFacts[
                        registerTypeId * 3 + 1];
                bool integerType
                    = (typeCode >= 0x06 && typeCode <= 0x0F)
                        || typeCode == 0x10 || typeCode == 0x11;
                if (!integerType && typeCode != 1)
                {
                    return 3;
                }
            }
            else if (control >= 1 && control <= 3)
            {
                if (source0Register > 13 || source1Register > 13)
                {
                    return 3;
                }
                int32 leftTypeId
                    = Host.StandaloneDecoderRegisterTypeIds[
                        bodyId * 14 + source0Register];
                int32 rightTypeId
                    = Host.StandaloneDecoderRegisterTypeIds[
                        bodyId * 14 + source1Register];
                if (leftTypeId <= 0
                    || leftTypeId
                        > Host.StandaloneTypeFactCount[0]
                    || rightTypeId != leftTypeId
                    || Host.StandaloneTypeFacts[
                        leftTypeId * 3] != 0)
                {
                    return 3;
                }
                int32 typeCode
                    = Host.StandaloneTypeFacts[
                        leftTypeId * 3 + 1];
                bool integerType
                    = (typeCode >= 0x06 && typeCode <= 0x0F)
                        || typeCode == 0x10 || typeCode == 0x11;
                if (!integerType && typeCode != 1)
                {
                    return 3;
                }
                registerTypeId = leftTypeId;
            }
            else if (control >= 5 && control <= 7)
            {
                return 2;
            }
            else
            {
                return 3;
            }
            int32 registerTypeStatus
                = SetStandaloneDecoderRegisterType(
                    bodyId, resultRegister, registerTypeId);
            if (registerTypeStatus != 0)
            {
                return registerTypeStatus;
            }
            codeOffset = codeOffset + 4;
        }
        else if (opcode == 0xC2)
        {
            if (codeOffset > codeLength - 4)
            {
                return 3;
            }
            init int32 control;
            init uint32 registerPayload;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, codeStart + codeOffset + 1,
                    ref init control)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength,
                    codeStart + codeOffset + 2,
                    ref init registerPayload))
            {
                return 3;
            }
            int32 resultRegister
                = int32(registerPayload & 0x0F);
            int32 unusedResult
                = int32((registerPayload >> 4) & 0x0F);
            int32 source0Register
                = int32((registerPayload >> 8) & 0x0F);
            int32 source1Register
                = int32((registerPayload >> 12) & 0x0F);
            if (resultRegister > 13 || unusedResult != 15
                || source0Register > 13 || source1Register > 13)
            {
                return 3;
            }
            int32 leftTypeId
                = Host.StandaloneDecoderRegisterTypeIds[
                    bodyId * 14 + source0Register];
            int32 rightTypeId
                = Host.StandaloneDecoderRegisterTypeIds[
                    bodyId * 14 + source1Register];
            if (leftTypeId <= 0
                || leftTypeId
                    > Host.StandaloneTypeFactCount[0]
                || rightTypeId != leftTypeId
                || Host.StandaloneTypeFacts[
                    leftTypeId * 3] != 0
                || Host.StandaloneTypeFacts[
                    leftTypeId * 3 + 1] != 1)
            {
                return 3;
            }
            if (control != 0x01 && control != 0x02)
            {
                return control == 0 ? 2 : 3;
            }
            int32 registerTypeStatus
                = SetStandaloneDecoderRegisterType(
                    bodyId, resultRegister, leftTypeId);
            if (registerTypeStatus != 0)
            {
                return registerTypeStatus;
            }
            codeOffset = codeOffset + 4;
        }
        else if (opcode == 0x90)
        {
            if (codeOffset > codeLength - 2)
            {
                return 3;
            }
            init int32 recordIndex;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, codeStart + codeOffset + 1,
                    ref init recordIndex))
            {
                return 3;
            }
            codeOffset = codeOffset + 2;
            init bool callDoesNotReturn;
            int32 callStatus = ValidateStandaloneDecoderCallInstruction(
                bodyId, bodyOffset, recordIndex,
                ref init callDoesNotReturn);
            if (callStatus != 0)
            {
                return callStatus;
            }
            if (callDoesNotReturn)
            {
                if (codeOffset != codeLength)
                {
                    return 3;
                }
                terminal = true;
                terminalDoesNotReturn = true;
            }
        }
        else if (opcode == 0xE0)
        {
            if (codeOffset > codeLength - 4)
            {
                return 3;
            }
            init int32 control;
            init uint32 recordIndex;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, codeStart + codeOffset + 1,
                    ref init control)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength,
                    codeStart + codeOffset + 2, ref init recordIndex)
                || control != 0)
            {
                return 3;
            }
            codeOffset = codeOffset + 4;
            init bool callDoesNotReturn;
            int32 callStatus = ValidateStandaloneDecoderCallInstruction(
                bodyId, bodyOffset, int32(recordIndex),
                ref init callDoesNotReturn);
            if (callStatus != 0)
            {
                return callStatus;
            }
            if (callDoesNotReturn)
            {
                if (codeOffset != codeLength)
                {
                    return 3;
                }
                terminal = true;
                terminalDoesNotReturn = true;
            }
        }
        else if (opcode == 0xB8)
        {
            if (codeOffset > codeLength - 2)
            {
                return 3;
            }
            init int32 homeIndex;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, codeStart + codeOffset + 1,
                    ref init homeIndex)
                || homeIndex >= homeCount
                || resultTypeCode == 0)
            {
                return 3;
            }
            int32 homeFirst
                = Host.StandaloneDecoderBodies[bodyOffset + 28];
            if (Host.StandaloneDecoderHomes[
                    (homeFirst + homeIndex) * 3 + 1]
                != resultTypeId)
            {
                return 3;
            }
            codeOffset = codeOffset + 2;
            terminal = true;
        }
        else if (opcode == 0x17)
        {
            if (codeOffset > codeLength - 2)
            {
                return 3;
            }
            init int32 control;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, codeStart + codeOffset + 1,
                    ref init control)
                || (control & 0xF0) != 0
                || resultTypeCode == 0)
            {
                return 3;
            }
            int32 resultRegister = control & 0x0F;
            if (resultRegister > 13)
            {
                return 2;
            }
            int32 registerTypeId
                = Host.StandaloneDecoderRegisterTypeIds[
                    bodyId * 14 + resultRegister];
            if (registerTypeId <= 0
                || registerTypeId != resultTypeId)
            {
                return 3;
            }
            codeOffset = codeOffset + 2;
            terminal = true;
        }
        else if (opcode == 0x18)
        {
            if (codeOffset > codeLength - 2)
            {
                return 3;
            }
            init int32 control;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, codeStart + codeOffset + 1,
                    ref init control)
                || control != 0 || resultTypeCode != 0)
            {
                return 3;
            }
            codeOffset = codeOffset + 2;
            terminal = true;
        }
        else
        {
            return GetStandaloneDecoderUnsupportedOpcodeStatus(opcode);
        }

        if (terminal && codeOffset != codeLength)
        {
            return 3;
        }
    }

    if (!terminal || codeOffset != codeLength
        || terminalDoesNotReturn
            != ((Host.StandaloneDecoderMethods[
                callerMethodOffset + 15] & 2) != 0))
    {
        return 3;
    }
    return 0;
}

public static int32 DecodeStandaloneModuleMetadata()
{
    if (!ValidateStandaloneDecoderBuffers())
    {
        return 3;
    }

    ClearStandaloneDecoderOutputs();
    int32 status = BuildStandaloneDecoderModuleCatalog();
    if (status != 0)
    {
        ClearStandaloneDecoderOutputs();
        Host.StandaloneDecoderStatus[0] = status;
        return status;
    }

    int32 selectedModuleId
        = Host.StandaloneDecoderSelectedModuleId[0];
    if (selectedModuleId < 0
        || selectedModuleId >= Host.StandaloneModuleCount[0]
        || !TryValidateStandaloneArtifactDirectory(
            Host.StandaloneModuleDirectory[
                (selectedModuleId + 1) * 8]))
    {
        ClearStandaloneDecoderOutputs();
        Host.StandaloneDecoderStatus[0] = 3;
        return 3;
    }

    Host.StandaloneDecoderStatus[0] = 0;
    return 0;
}

public static int32 BuildStandaloneImportedTargetPlan()
{
    if (!ValidateStandaloneDecoderBuffers()
        || Host.StandaloneDecoderStatus[0] != 0
        || Host.StandaloneDecoderSelectedModuleId[0] < 0
        || Host.StandaloneDecoderSelectedModuleId[0]
            >= Host.StandaloneModuleCount[0])
    {
        return 3;
    }

    ClearStandaloneDecoderCallTargetPlans();
    int32 selectedModuleId
        = Host.StandaloneDecoderSelectedModuleId[0];
    int32 consumerDirectoryOffset = (selectedModuleId + 1) * 8;
    int32 consumerArtifactOrdinal
        = Host.StandaloneModuleDirectory[consumerDirectoryOffset];
    if (consumerArtifactOrdinal < 0
        || !TryValidateStandaloneArtifactDirectory(
            consumerArtifactOrdinal))
    {
        return 3;
    }
    init int32 artifactStart;
    init int32 artifactLength;
    if (!TryGetStandaloneArtifactExtent(consumerArtifactOrdinal,
            ref init artifactStart, ref init artifactLength))
    {
        return 3;
    }

    for (mut int32 callId = 0;
        callId < Host.StandaloneDecoderCallCount[0];
        callId = callId + 1)
    {
        int32 callOffset = callId * 22;
        int32 bodyId = Host.StandaloneDecoderCalls[callOffset];
        if (bodyId < 0
            || bodyId >= Host.StandaloneDecoderBodyCount[0])
        {
            ClearStandaloneDecoderCallTargetPlans();
            return 3;
        }
        int32 bodyOffset = bodyId * 34;
        if (Host.StandaloneDecoderBodies[bodyOffset + 1]
                != consumerArtifactOrdinal
            || Host.StandaloneDecoderBodies[bodyOffset + 27]
                != selectedModuleId)
        {
            ClearStandaloneDecoderCallTargetPlans();
            return 3;
        }

        init int32 targetArtifactOrdinal;
        init int32 targetModuleId;
        init int32 targetModuleRow;
        init int32 targetMethodDefRow;
        init int32 targetMethodSigRow;
        init int32 targetBodyRow;
        init int32 targetBodyStart;
        init int32 targetBodyLength;
        int32 targetStatus = ResolveStandaloneDecoderCallTargetPlan(
            bodyOffset,
            Host.StandaloneDecoderCalls[callOffset + 2],
            Host.StandaloneDecoderCalls[callOffset + 3],
            Host.StandaloneDecoderCalls[callOffset + 4],
            Host.StandaloneDecoderCalls[callOffset + 5],
            Host.StandaloneDecoderCalls[callOffset + 6],
            artifactStart, artifactLength,
            ref init targetArtifactOrdinal,
            ref init targetModuleId,
            ref init targetModuleRow,
            ref init targetMethodDefRow,
            ref init targetMethodSigRow,
            ref init targetBodyRow,
            ref init targetBodyStart,
            ref init targetBodyLength);
        if (targetStatus != 0)
        {
            ClearStandaloneDecoderCallTargetPlans();
            return targetStatus;
        }

        Host.StandaloneDecoderCalls[callOffset + 14]
            = targetArtifactOrdinal;
        Host.StandaloneDecoderCalls[callOffset + 15] = targetModuleId;
        Host.StandaloneDecoderCalls[callOffset + 16] = targetModuleRow;
        Host.StandaloneDecoderCalls[callOffset + 17]
            = targetMethodDefRow;
        Host.StandaloneDecoderCalls[callOffset + 18]
            = targetMethodSigRow;
        Host.StandaloneDecoderCalls[callOffset + 19] = targetBodyRow;
        Host.StandaloneDecoderCalls[callOffset + 20] = targetBodyStart;
        Host.StandaloneDecoderCalls[callOffset + 21] = targetBodyLength;
    }

    if (!TryValidateStandaloneArtifactDirectory(
            consumerArtifactOrdinal))
    {
        ClearStandaloneDecoderCallTargetPlans();
        return 3;
    }
    Host.StandaloneDecoderTargetPlanBuilt[0] = 1;
    return 0;
}

public static int32 ValidateStandaloneImportedTargetBodies()
{
    if (!ValidateStandaloneDecoderBuffers()
        || Host.StandaloneDecoderStatus[0] != 0
        || Host.StandaloneDecoderTargetPlanBuilt[0] != 1
        || Host.StandaloneDecoderSelectedModuleId[0] < 0
        || Host.StandaloneDecoderSelectedModuleId[0]
            >= Host.StandaloneModuleCount[0])
    {
        return 3;
    }
    Host.StandaloneDecoderTargetBodiesValidated[0] = 0;

    for (mut int32 callId = 0;
        callId < Host.StandaloneDecoderCallCount[0];
        callId = callId + 1)
    {
        int32 callOffset = callId * 22;
        int32 targetKind
            = Host.StandaloneDecoderCalls[callOffset + 3];
        int32 artifactOrdinal
            = Host.StandaloneDecoderCalls[callOffset + 14];
        int32 moduleId
            = Host.StandaloneDecoderCalls[callOffset + 15];
        int32 moduleRow
            = Host.StandaloneDecoderCalls[callOffset + 16];
        int32 methodDefRow
            = Host.StandaloneDecoderCalls[callOffset + 17];
        int32 methodSigRow
            = Host.StandaloneDecoderCalls[callOffset + 18];
        int32 bodyRow
            = Host.StandaloneDecoderCalls[callOffset + 19];
        if (targetKind == 1)
        {
            if (artifactOrdinal < 0 || moduleId < 0 || moduleRow <= 0
                || methodDefRow <= 0 || methodSigRow <= 0
                || bodyRow <= 0
                || Host.StandaloneDecoderCalls[callOffset + 20] <= 0
                || Host.StandaloneDecoderCalls[callOffset + 21] <= 0)
            {
                ClearStandaloneDecoderCallTargetPlans();
                return 3;
            }
            continue;
        }
        if (targetKind != 2)
        {
            ClearStandaloneDecoderCallTargetPlans();
            return 3;
        }
        if (bodyRow == 0)
        {
            ClearStandaloneDecoderCallTargetPlans();
            return 2;
        }

        init int32 bodyStart;
        init int32 bodyLength;
        int32 bodyStatus = ValidateStandaloneDecoderProviderBody(
            artifactOrdinal, moduleRow, methodDefRow, methodSigRow,
            bodyRow, moduleId, ref init bodyStart,
            ref init bodyLength);
        if (bodyStatus != 0)
        {
            ClearStandaloneDecoderCallTargetPlans();
            return bodyStatus;
        }
        Host.StandaloneDecoderCalls[callOffset + 20] = bodyStart;
        Host.StandaloneDecoderCalls[callOffset + 21] = bodyLength;
    }

    int32 selectedModuleId
        = Host.StandaloneDecoderSelectedModuleId[0];
    int32 consumerArtifactOrdinal
        = Host.StandaloneModuleDirectory[
            (selectedModuleId + 1) * 8];
    if (!TryValidateStandaloneArtifactDirectory(
            consumerArtifactOrdinal))
    {
        ClearStandaloneDecoderCallTargetPlans();
        return 3;
    }
    Host.StandaloneDecoderTargetBodiesValidated[0] = 1;
    return 0;
}

void ClearStandaloneDecoderCallTargetPlans()
{
    Host.StandaloneDecoderTargetPlanBuilt[0] = 0;
    Host.StandaloneDecoderTargetBodiesValidated[0] = 0;
    int32 callCount = Host.StandaloneDecoderCallCount[0];
    if (callCount < 0
        || callCount > Host.StandaloneDecoderCalls.Length / 22)
    {
        return;
    }
    for (mut int32 callId = 0;
        callId < callCount;
        callId = callId + 1)
    {
        int32 callOffset = callId * 22;
        for (mut int32 field = 14; field < 22; field = field + 1)
        {
            Host.StandaloneDecoderCalls[callOffset + field] = -1;
        }
    }
}
