    Host.StandaloneWriterBodyPlanCount[0] = 0;
    Host.StandaloneWriterTypeMapCount[0] = 0;
    Host.StandaloneWriterMethodMapCount[0] = 0;
    Host.StandaloneWriterConstantMapCount[0] = 0;

    for (mut int32 bodyId = 0;
        bodyId < bodyCount;
        bodyId = bodyId + 1)
    {
        int32 bodyOffset = bodyId * 12;
        int32 homeFirst
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 1];
        int32 homeCount
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 2];
        int32 constantFirst
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 3];
        int32 constantCount
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 4];
        int32 invokeFirst
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 5];
        int32 invokeCount
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 6];
        int32 inputFirst
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 7];
        int32 inputCount
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 8];
        int32 operationFirst
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 9];
        int32 operationCount
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 10];
        int32 terminalKind
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 11];
        if (Host.StandaloneRewrittenNormalizedBodies[bodyOffset]
                != bodyId
            || homeFirst < 0 || homeCount < 0
            || homeFirst
                > Host.StandaloneRewrittenNormalizedHomeCount[0]
                    - homeCount
            || constantFirst < 0 || constantCount < 0
            || constantFirst
                > Host.StandaloneRewrittenNormalizedConstantCount[0]
                    - constantCount
            || invokeFirst < 0 || invokeCount < 0
            || invokeFirst > Host.StandaloneRewrittenInvokeCount[0]
                - invokeCount
            || inputFirst < 0 || inputCount < 0
            || inputFirst > Host.StandaloneRewrittenInvokeInputCount[0]
                - inputCount
            || operationFirst < 0 || operationCount < 0
            || operationFirst
                > Host.StandaloneRewrittenNormalizedOperationCount[0]
                    - operationCount
            || invokeCount > 65_535)
        {
            return 3;
        }

        int32 typeFirst = Host.StandaloneWriterTypeMapCount[0];
        for (mut int32 typeId = 0;
            typeId < Host.StandaloneWriterTypeMapIndexByTypeId.Length;
            typeId = typeId + 1)
        {
            Host.StandaloneWriterTypeMapIndexByTypeId[typeId] = -1;
        }
        for (mut int32 localHome = 0;
            localHome < homeCount;
            localHome = localHome + 1)
        {
            int32 homeIndex = homeFirst + localHome;
            int32 homeOffset = homeIndex * 5;
            if (Host.StandaloneRewrittenNormalizedHomes[
                    homeOffset] != bodyId)
            {
                return 3;
            }
            init int32 typeMapIndex;
            int32 typeStatus = AddStandaloneWriterBodyTypeMapEntry(
                typeFirst,
                Host.StandaloneRewrittenNormalizedHomes[
                    homeOffset + 3],
                ref init typeMapIndex);
            if (typeStatus != 0)
            {
                return typeStatus;
            }
            Host.StandaloneWriterHomeTypeMapIndices[homeIndex]
                = typeMapIndex;
        }
        int32 typeMapCount
            = Host.StandaloneWriterTypeMapCount[0] - typeFirst;

        int32 methodFirst = Host.StandaloneWriterMethodMapCount[0];
        for (mut int32 target = 0;
            target < Host.StandaloneWriterLocalMethodMapIndices.Length;
            target = target + 1)
        {
            Host.StandaloneWriterLocalMethodMapIndices[target] = -1;
        }
        for (mut int32 target = 0;
            target
                < Host.StandaloneWriterImportedMethodMapIndices.Length;
            target = target + 1)
        {
            Host.StandaloneWriterImportedMethodMapIndices[target] = -1;
