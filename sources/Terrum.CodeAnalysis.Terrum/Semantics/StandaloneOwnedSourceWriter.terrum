                    return 3;
                }
                int32 invokeOffset = invokeId * 10;
                int32 targetKind
                    = Host.StandaloneRewrittenInvokes[invokeOffset];
                int32 targetIndex
                    = Host.StandaloneRewrittenInvokes[
                        invokeOffset + 1];
                int32 expectedCallableId
                    = Host.StandaloneRewrittenInvokes[
                        invokeOffset + 2];
                if (targetKind == 1
                    ? (targetIndex < 0
                        || targetIndex >= localCount
                        || Host.StandaloneRewrittenLocalCallables[
                            targetIndex * 3 + 1]
                            != expectedCallableId)
                    : targetKind == 2
                        ? (targetIndex < 0
                            || targetIndex
                                >= Host.StandaloneRewrittenImportedCallableCount[0]
                            || Host.StandaloneRewrittenImportedCallables[
                                targetIndex * 8 + 4]
                                != expectedCallableId)
                        : true)
                {
                    return 3;
                }
                init int32 methodMapIndex;
                int32 methodStatus
