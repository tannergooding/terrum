        *localIndexResult = existing;
        return 0;
    }
    int32 globalIndex = Host.StandaloneWriterMethodMapCount[0];
    int32 localIndex = globalIndex - methodFirst;
    if (localIndex < 0 || localIndex > 0xFFFF
        || globalIndex >= Host.StandaloneWriterMethodMapTokens.Length)
    {
        return 3;
    }
    Host.StandaloneWriterMethodMapTokens[globalIndex]
        = uint32(token);
    Host.StandaloneWriterMethodMapCount[0] = globalIndex + 1;
    if (targetKind == 1)
    {
        Host.StandaloneWriterLocalMethodMapIndices[targetIndex]
            = localIndex;
    }
    else
    {
        Host.StandaloneWriterImportedMethodMapIndices[targetIndex]
            = localIndex;
    }
    *localIndexResult = localIndex;
    return 0;
}

int32 AddStandaloneWriterBodyConstantMapEntry(int32 constantFirst,
    int32 constantId, ref<init int32> localIndexResult)
