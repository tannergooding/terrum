    ensure return == 0 ? *localIndexResult is init : true
{
    int32 localCount
        = Host.StandaloneRewrittenLocalCallableCount[0];
    int32 importedCount
        = Host.StandaloneRewrittenImportedCallableCount[0];
    int32 token;
    int32 existing;
    if (targetKind == 1)
    {
        if (targetIndex < 0 || targetIndex >= localCount
            || targetIndex
                >= Host.StandaloneWriterLocalMethodMapIndices.Length)
        {
            return 3;
        }
        existing
            = Host.StandaloneWriterLocalMethodMapIndices[targetIndex];
        token = int32(0x1600_0000)
            | (targetIndex + 1);
    }
    else if (targetKind == 2)
    {
        if (targetIndex < 0 || targetIndex >= importedCount
            || targetIndex
                >= Host.StandaloneWriterImportedMethodMapIndices.Length)
        {
            return 3;
        }
        existing
            = Host.StandaloneWriterImportedMethodMapIndices[
                targetIndex];
        token = int32(0x1C00_0000)
            | (targetIndex + 1);
    }
