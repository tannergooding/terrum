                int32 inputCountForCall
                    = Host.StandaloneRewrittenInvokes[
                        invokeOffset + 4];
                int32 prepCount
                    = Host.StandaloneRewrittenInvokes[
                        invokeOffset + 8];
                if (inputCountForCall < 0
