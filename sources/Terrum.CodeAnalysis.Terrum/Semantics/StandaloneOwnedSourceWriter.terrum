                    return 3;
                }
                init int32 constantMapIndex;
                int32 constantStatus
                    = AddStandaloneWriterBodyConstantMapEntry(
                        constantMapFirst,
                        constantFirst + operationOperand,
                        ref init constantMapIndex);
                if (constantStatus != 0)
