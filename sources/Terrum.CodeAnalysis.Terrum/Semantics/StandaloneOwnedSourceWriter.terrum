                    return constantStatus;
                }
            }
            if (operationKind == 3)
            {
                if (operationOperand < 0
                    || operationOperand >= invokeCount)
                {
                    return 3;
                }
                int32 invokeId = invokeFirst + operationOperand;
                if (Host.StandaloneWriterCallSiteRecordIndices[
