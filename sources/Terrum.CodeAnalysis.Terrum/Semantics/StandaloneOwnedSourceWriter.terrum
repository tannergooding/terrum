    Host.StandaloneWriterTypeMapTokens[globalIndex] = token;
    Host.StandaloneWriterTypeMapCount[0] = globalIndex + 1;
    Host.StandaloneWriterTypeMapIndexByTypeId[typeId] = localIndex;
    *localIndexResult = localIndex;
    return 0;
}

int32 AddStandaloneWriterBodyMethodMapEntry(int32 methodFirst,
    int32 targetKind, int32 targetIndex,
