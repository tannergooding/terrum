        for (mut int32 sourceRow = 0;
            sourceRow
                < Host.StandaloneWriterConstantMapIndexBySourceRow.Length;
            sourceRow = sourceRow + 1)
        {
            Host.StandaloneWriterConstantMapIndexBySourceRow[
                sourceRow] = -1;
        }

        int32 operationCallCount = 0;
