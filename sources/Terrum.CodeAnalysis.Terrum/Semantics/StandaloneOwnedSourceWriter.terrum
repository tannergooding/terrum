        int32 codeLength = 0;
        for (mut int32 localOperation = 0;
            localOperation < operationCount;
            localOperation = localOperation + 1)
        {
            int32 operationIndex = operationFirst + localOperation;
            int32 operationKind
                = Host.StandaloneRewrittenNormalizedOperations[
                    operationIndex * 4];
            int32 operationOperand
                = Host.StandaloneRewrittenNormalizedOperations[
                    operationIndex * 4 + 1];
            if (operationKind == 1)
            {
                if (operationOperand < 0
                    || operationOperand >= constantCount)
