    Host.StandaloneWriterConstantMapCount[0] = globalIndex + 1;
    Host.StandaloneWriterConstantMapIndexBySourceRow[sourceRow]
        = localIndex;
    Host.StandaloneWriterConstantMapIndices[constantId] = localIndex;
    *localIndexResult = localIndex;
    return 0;
}

int32 GetStandaloneWriterOperationCodeLength(int32 bodyId,
    int32 operationIndex, int32 callRecordIndex)
{
    int32 operationOffset = operationIndex * 4;
    int32 kind
        = Host.StandaloneRewrittenNormalizedOperations[
            operationOffset];
    int32 operand0
        = Host.StandaloneRewrittenNormalizedOperations[
            operationOffset + 1];
    int32 operand1
        = Host.StandaloneRewrittenNormalizedOperations[
            operationOffset + 2];
    if (Host.StandaloneRewrittenNormalizedOperations[
            operationOffset + 3] != bodyId)
    {
        return -1;
    }

    if (kind == 1)
    {
        int32 bodyOffset = bodyId * 12;
        int32 constantFirst
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 3];
        int32 constantCount
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 4];
        if (operand0 < 0 || operand0 >= constantCount
            || operand1 != 0)
        {
            return -1;
        }
        int32 mapIndex
            = Host.StandaloneWriterConstantMapIndices[
                constantFirst + operand0];
        return mapIndex == 0 ? 1
            : mapIndex <= 15 ? 2
            : mapIndex <= 0xFFFF ? 4 : -1;
    }
    if (kind == 2)
    {
        int32 bodyOffset = bodyId * 12;
        int32 homeFirst
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 1];
        int32 homeCount
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 2];
        if (operand0 < 0 || operand0 >= homeCount
            || operand1 != 0)
        {
            return -1;
        }
        int32 homeIndex = operand0;
        return homeIndex == 0 ? 1
            : homeIndex <= 15 ? 2
            : homeIndex <= 0xFFFF ? 4 : -1;
    }
    if (kind == 3)
    {
        int32 bodyOffset = bodyId * 12;
        int32 invokeFirst
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 5];
        int32 invokeCount
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 6];
        if (operand0 < 0 || operand0 >= invokeCount
            || operand1 != 0 || callRecordIndex < 1
            || callRecordIndex > 0xFFFF)
        {
            return -1;
        }
        int32 invokeId = invokeFirst + operand0;
        Host.StandaloneWriterCallSiteRecordIndices[invokeId]
            = callRecordIndex;
        return callRecordIndex <= 255 ? 2 : 4;
    }
    if (kind == 4)
    {
        int32 bodyOffset = bodyId * 12;
        int32 homeCount
            = Host.StandaloneRewrittenNormalizedBodies[
                bodyOffset + 2];
        if (operand0 < 0 || operand0 >= homeCount
            || operand1 != 0)
        {
            return -1;
        }
        return operand0 <= 255 ? 2 : 6;
    }
    if (kind == 5 && operand0 == 0 && operand1 == 0)
    {
        return 2;
    }
    return -1;
}

int32 BuildStandaloneWriterBodyPlans()
{
    int32 bodyCount
        = Host.StandaloneRewrittenNormalizedBodyCount[0];
    int32 localCount
        = Host.StandaloneRewrittenLocalCallableCount[0];
    if (bodyCount != localCount || bodyCount <= 0
        || bodyCount > Host.StandaloneWriterBodyPlans.Length / 20)
    {
        return 3;
