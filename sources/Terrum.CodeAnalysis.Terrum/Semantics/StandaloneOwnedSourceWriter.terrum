    int32 globalIndex = Host.StandaloneWriterTypeMapCount[0];
    int32 localIndex = globalIndex - typeFirst;
    if (localIndex < 0 || localIndex > 0xFFFF
        || globalIndex >= Host.StandaloneWriterTypeMapTokens.Length)
    {
