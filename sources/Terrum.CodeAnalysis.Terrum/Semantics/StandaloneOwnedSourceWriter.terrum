            {
                return 3;
            }
            codeLength = codeLength + instructionLength;
        }
        if (operationCallCount != invokeCount
            || recordDataLength > int32.MaxValue
            || codeLength <= 0)
        {
            return 3;
        }
        for (mut int32 localInvoke = 0;
            localInvoke < invokeCount;
            localInvoke = localInvoke + 1)
        {
            int32 invokeId = invokeFirst + localInvoke;
            if (Host.StandaloneWriterCallSiteRecordIndices[
                    invokeId] <= 0
                || Host.StandaloneWriterInvokeMethodMapIndices[
                    invokeId] < 0)
            {
                return 3;
            }
        }

        int32 methodMapCount
            = Host.StandaloneWriterMethodMapCount[0] - methodFirst;
        int32 constantMapCount
            = Host.StandaloneWriterConstantMapCount[0]
                - constantMapFirst;
        if (methodMapCount > 65_536
            || typeMapCount > 65_536
            || constantMapCount > 65_536)
        {
            return 3;
        }
        int32 recordCount = invokeCount + 1;
        int32 mapMask = (homeCount != 0 ? 1 : 0)
            | (typeMapCount != 0 ? 2 : 0)
            | (methodMapCount != 0 ? 4 : 0)
            | (constantMapCount != 0 ? 16 : 0);
        int32 mapCount = 0;
        if ((mapMask & 1) != 0) { mapCount = mapCount + 1; }
        if ((mapMask & 2) != 0) { mapCount = mapCount + 1; }
        if ((mapMask & 4) != 0) { mapCount = mapCount + 1; }
        if ((mapMask & 8) != 0) { mapCount = mapCount + 1; }
        if ((mapMask & 16) != 0) { mapCount = mapCount + 1; }
        int32 bodySize = 17 + (mapCount * 4)
            + (homeCount * 8) + (typeMapCount * 4)
            + (methodMapCount * 4) + (constantMapCount * 8)
            + 12 + ((recordCount + 1) * 4)
            + recordDataLength + codeLength;
        if (bodySize <= 0 || bodySize > int32.MaxValue)
        {
            return 3;
        }

        int32 planOffset = bodyId * 20;
        Host.StandaloneWriterBodyPlans[planOffset] = bodyId;
        Host.StandaloneWriterBodyPlans[planOffset + 1] = mapMask;
        Host.StandaloneWriterBodyPlans[planOffset + 2] = homeFirst;
        Host.StandaloneWriterBodyPlans[planOffset + 3] = homeCount;
        Host.StandaloneWriterBodyPlans[planOffset + 4] = typeFirst;
        Host.StandaloneWriterBodyPlans[planOffset + 5] = typeMapCount;
        Host.StandaloneWriterBodyPlans[planOffset + 6] = methodFirst;
        Host.StandaloneWriterBodyPlans[planOffset + 7] = methodMapCount;
        Host.StandaloneWriterBodyPlans[planOffset + 8]
            = constantMapFirst;
        Host.StandaloneWriterBodyPlans[planOffset + 9]
            = constantMapCount;
        Host.StandaloneWriterBodyPlans[planOffset + 10]
            = invokeFirst;
        Host.StandaloneWriterBodyPlans[planOffset + 11]
            = invokeCount;
        Host.StandaloneWriterBodyPlans[planOffset + 12]
            = inputFirst;
        Host.StandaloneWriterBodyPlans[planOffset + 13]
            = inputCount;
        Host.StandaloneWriterBodyPlans[planOffset + 14]
            = operationFirst;
        Host.StandaloneWriterBodyPlans[planOffset + 15]
            = operationCount;
        Host.StandaloneWriterBodyPlans[planOffset + 16]
            = recordDataLength;
        Host.StandaloneWriterBodyPlans[planOffset + 17] = codeLength;
        Host.StandaloneWriterBodyPlans[planOffset + 18] = bodySize;
        Host.StandaloneWriterBodyPlans[planOffset + 19] = recordCount;
        Host.StandaloneWriterBodyPlanCount[0] = bodyId + 1;
    }
    return 0;
}

int32 WriteStandaloneWriterCallSiteRecord(int32 bodyId,
    int32 invokeId)
{
    int32 invokeOffset = invokeId * 10;
    int32 targetKind
        = Host.StandaloneRewrittenInvokes[invokeOffset];
    int32 resultKind
        = Host.StandaloneRewrittenInvokes[invokeOffset + 5];
    int32 resultIndex
        = Host.StandaloneRewrittenInvokes[invokeOffset + 6];
    int32 inputFirst
        = Host.StandaloneRewrittenInvokes[invokeOffset + 3];
    int32 inputCount
        = Host.StandaloneRewrittenInvokes[invokeOffset + 4];
    int32 prepFirst
        = Host.StandaloneRewrittenInvokes[invokeOffset + 7];
    int32 prepCount
        = Host.StandaloneRewrittenInvokes[invokeOffset + 8];
    int32 mapIndex
        = Host.StandaloneWriterInvokeMethodMapIndices[invokeId];
    int32 bodyOffset = bodyId * 12;
    int32 homeFirst
        = Host.StandaloneRewrittenNormalizedBodies[
            bodyOffset + 1];
    int32 homeCount
        = Host.StandaloneRewrittenNormalizedBodies[
            bodyOffset + 2];
    if ((targetKind != 1 && targetKind != 2)
        || mapIndex < 0 || mapIndex > 0xFFFF
        || resultKind < 0 || resultKind > 2
        || (resultKind == 0 && resultIndex != 0)
        || (resultKind == 1
            && (resultIndex < 0 || resultIndex > 15
                || resultIndex == 14))
        || (resultKind == 2
            && (resultIndex < 0 || resultIndex >= homeCount))
        || inputFirst < 0 || inputCount < 0
        || inputFirst
            > Host.StandaloneRewrittenInvokeInputCount[0]
                - inputCount
        || prepFirst < 0 || prepCount != 0
        || prepFirst
            > Host.StandaloneRewrittenInvokeInputCount[0])
    {
        return prepCount != 0 ? 2 : 3;
    }

    int32 status = AppendStandaloneWriterByte(0x02);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterByte(0);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterHalfWord(0);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterByte(1);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterByte(resultKind);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterHalfWord(uint32(mapIndex));
    if (status != 0) { return status; }
    status = AppendStandaloneWriterHalfWord(uint32(resultIndex));
    if (status != 0) { return status; }
    status = AppendStandaloneWriterWord(uint32(inputCount));
    if (status != 0) { return status; }
    status = AppendStandaloneWriterWord(0);
    if (status != 0) { return status; }

    for (mut int32 inputOrdinal = 0;
        inputOrdinal < inputCount;
        inputOrdinal = inputOrdinal + 1)
    {
        int32 inputOffset = (inputFirst + inputOrdinal) * 3;
        int32 selectorKind
            = Host.StandaloneRewrittenInvokeInputs[inputOffset];
        int32 sourceUse
            = Host.StandaloneRewrittenInvokeInputs[inputOffset + 1];
        int32 selectorIndex
            = Host.StandaloneRewrittenInvokeInputs[inputOffset + 2];
        if (selectorKind < 0 || selectorKind > 2
            || (selectorKind == 0
                ? sourceUse != 0 || selectorIndex != 0
                : (sourceUse < 1 || sourceUse > 5)
                    || (selectorKind == 1
                        && (selectorIndex < 0
                            || selectorIndex > 15))
                    || (selectorKind == 2
                        && (selectorIndex < 0
                            || selectorIndex >= homeCount))))
        {
            return 3;
        }
        status = AppendStandaloneWriterByte(selectorKind);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterByte(sourceUse);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterHalfWord(
            uint32(selectorIndex));
        if (status != 0) { return status; }
    }
    return 0;
}

int32 WriteStandaloneWriterBodyCode(int32 bodyId,
    int32 codeLength)
{
    int32 bodyOffset = bodyId * 20;
    int32 operationFirst
        = Host.StandaloneWriterBodyPlans[bodyOffset + 14];
    int32 operationCount
        = Host.StandaloneWriterBodyPlans[bodyOffset + 15];
    int32 constantFirst
        = Host.StandaloneRewrittenNormalizedBodies[
            bodyId * 12 + 3];
    int32 invokeFirst
        = Host.StandaloneRewrittenNormalizedBodies[
            bodyId * 12 + 5];
    int32 codeStart
        = Host.StandaloneWriterOutputByteCount[0];
    mut int32 observedCallCount = 0;
    for (mut int32 localOperation = 0;
        localOperation < operationCount;
        localOperation = localOperation + 1)
    {
        int32 operationOffset
            = (operationFirst + localOperation) * 4;
        int32 kind
            = Host.StandaloneRewrittenNormalizedOperations[
                operationOffset];
        int32 operand0
            = Host.StandaloneRewrittenNormalizedOperations[
                operationOffset + 1];
        int32 operand1
            = Host.StandaloneRewrittenNormalizedOperations[
                operationOffset + 2];
        int32 status;
        if (kind == 1)
        {
            if (operand0 < 0
                || operand0
                    >= Host.StandaloneRewrittenNormalizedBodies[
                        bodyId * 12 + 4]
                || operand1 != 0)
            {
                return 3;
            }
            int32 mapIndex
                = Host.StandaloneWriterConstantMapIndices[
                    constantFirst + operand0];
            if (mapIndex == 0)
            {
                status = AppendStandaloneWriterByte(0x09);
                if (status != 0) { return status; }
            }
            else if (mapIndex > 0 && mapIndex <= 15)
            {
                status = AppendStandaloneWriterByte(0x16);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(mapIndex << 4);
                if (status != 0) { return status; }
            }
            else if (mapIndex > 15 && mapIndex <= 0xFFFF)
            {
                status = AppendStandaloneWriterByte(0xD4);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(0);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterHalfWord(
                    uint32(mapIndex));
                if (status != 0) { return status; }
            }
            else
            {
                return 3;
            }
        }
        else if (kind == 2)
        {
            int32 homeCount
                = Host.StandaloneRewrittenNormalizedBodies[
                    bodyId * 12 + 2];
            if (operand0 < 0 || operand0 >= homeCount
                || operand1 != 0)
            {
                return 3;
            }
            if (operand0 == 0)
            {
                status = AppendStandaloneWriterByte(0x05);
                if (status != 0) { return status; }
            }
            else if (operand0 <= 15)
            {
                status = AppendStandaloneWriterByte(0x13);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(operand0 << 4);
                if (status != 0) { return status; }
            }
            else if (operand0 <= 0xFFFF)
            {
                status = AppendStandaloneWriterByte(0xD5);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(0);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterHalfWord(
                    uint32(operand0));
                if (status != 0) { return status; }
            }
            else
            {
                return 3;
            }
        }
        else if (kind == 3)
        {
            int32 invokeCount
                = Host.StandaloneRewrittenNormalizedBodies[
                    bodyId * 12 + 6];
            if (operand0 < 0 || operand0 >= invokeCount
                || operand1 != 0)
            {
                return 3;
            }
            int32 invokeId = invokeFirst + operand0;
            int32 recordIndex
                = Host.StandaloneWriterCallSiteRecordIndices[
                    invokeId];
            if (recordIndex < 1 || recordIndex > 0xFFFF)
            {
                return 3;
            }
            if (recordIndex <= 255)
            {
                status = AppendStandaloneWriterByte(0x90);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(recordIndex);
                if (status != 0) { return status; }
            }
            else
            {
                status = AppendStandaloneWriterByte(0xE0);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(0);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterHalfWord(
                    uint32(recordIndex));
                if (status != 0) { return status; }
            }
            observedCallCount = observedCallCount + 1;
        }
        else if (kind == 4)
        {
            int32 homeCount
                = Host.StandaloneRewrittenNormalizedBodies[
                    bodyId * 12 + 2];
            if (operand0 < 0 || operand0 >= homeCount
                || operand1 != 0)
            {
                return 3;
            }
            if (operand0 <= 255)
            {
                status = AppendStandaloneWriterByte(0xB8);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(operand0);
                if (status != 0) { return status; }
            }
            else
            {
                status = AppendStandaloneWriterByte(0xD5);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(0);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterHalfWord(
                    uint32(operand0));
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(0x17);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(0);
                if (status != 0) { return status; }
            }
        }
        else if (kind == 5 && operand0 == 0 && operand1 == 0)
        {
            status = AppendStandaloneWriterByte(0x18);
            if (status != 0) { return status; }
            status = AppendStandaloneWriterByte(0);
            if (status != 0) { return status; }
        }
        else
        {
            return 3;
        }
    }
    int32 invokeCount
        = Host.StandaloneRewrittenNormalizedBodies[
            bodyId * 12 + 6];
    if (observedCallCount != invokeCount
        || Host.StandaloneWriterOutputByteCount[0] - codeStart
            != codeLength)
    {
        return 3;
    }
    return 0;
}

int32 WriteStandaloneWriterBody(int32 bodyId)
{
    int32 planOffset = bodyId * 20;
    int32 mapMask
        = Host.StandaloneWriterBodyPlans[planOffset + 1];
    int32 homeFirst
        = Host.StandaloneWriterBodyPlans[planOffset + 2];
    int32 homeCount
        = Host.StandaloneWriterBodyPlans[planOffset + 3];
    int32 typeFirst
        = Host.StandaloneWriterBodyPlans[planOffset + 4];
    int32 typeCount
        = Host.StandaloneWriterBodyPlans[planOffset + 5];
    int32 methodFirst
        = Host.StandaloneWriterBodyPlans[planOffset + 6];
    int32 methodCount
        = Host.StandaloneWriterBodyPlans[planOffset + 7];
    int32 constantFirst
        = Host.StandaloneWriterBodyPlans[planOffset + 8];
    int32 constantCount
        = Host.StandaloneWriterBodyPlans[planOffset + 9];
    int32 invokeFirst
        = Host.StandaloneWriterBodyPlans[planOffset + 10];
    int32 invokeCount
        = Host.StandaloneWriterBodyPlans[planOffset + 11];
    int32 operationFirst
        = Host.StandaloneWriterBodyPlans[planOffset + 14];
    int32 operationCount
        = Host.StandaloneWriterBodyPlans[planOffset + 15];
    int32 recordDataLength
        = Host.StandaloneWriterBodyPlans[planOffset + 16];
    int32 codeLength
        = Host.StandaloneWriterBodyPlans[planOffset + 17];
    int32 bodySize
        = Host.StandaloneWriterBodyPlans[planOffset + 18];
    int32 recordCount
        = Host.StandaloneWriterBodyPlans[planOffset + 19];
    int32 bodyStart
        = Host.StandaloneWriterOutputByteCount[0];

    int32 status = AppendStandaloneWriterByte(1);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterByte(1);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterByte(mapMask);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterHalfWord(0);
    if (status != 0) { return status; }
    if ((mapMask & 1) != 0)
    {
        status = AppendStandaloneWriterWord(uint32(homeCount));
        if (status != 0) { return status; }
    }
    if ((mapMask & 2) != 0)
    {
        status = AppendStandaloneWriterWord(uint32(typeCount));
        if (status != 0) { return status; }
    }
    if ((mapMask & 4) != 0)
    {
        status = AppendStandaloneWriterWord(uint32(methodCount));
        if (status != 0) { return status; }
    }
    if ((mapMask & 8) != 0)
    {
        return 3;
    }
    if ((mapMask & 16) != 0)
    {
        status = AppendStandaloneWriterWord(uint32(constantCount));
        if (status != 0) { return status; }
    }
    status = AppendStandaloneWriterWord(1);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterWord(uint32(recordCount));
    if (status != 0) { return status; }
    status = AppendStandaloneWriterWord(uint32(codeLength));
    if (status != 0) { return status; }

    for (mut int32 localHome = 0;
        localHome < homeCount;
        localHome = localHome + 1)
    {
        int32 homeOffset = (homeFirst + localHome) * 5;
        int32 role
            = Host.StandaloneRewrittenNormalizedHomes[
                homeOffset + 1];
        int32 flags
            = Host.StandaloneRewrittenNormalizedHomes[
                homeOffset + 2];
        int32 typeMapIndex
            = Host.StandaloneWriterHomeTypeMapIndices[
                homeFirst + localHome];
        int32 formalOrdinal
            = Host.StandaloneRewrittenNormalizedHomes[
                homeOffset + 4];
        if ((role != 2 && role != 3)
            || flags != 0 || typeMapIndex < 0
            || typeMapIndex >= typeCount
            || formalOrdinal < 0 || formalOrdinal > 0xFFFF
            || (role == 3 && formalOrdinal != 0))
        {
            return 3;
        }
        status = AppendStandaloneWriterByte(role);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterByte(flags);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterHalfWord(
            uint32(typeMapIndex));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterHalfWord(
            uint32(formalOrdinal));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterHalfWord(0);
        if (status != 0) { return status; }
    }
    for (mut int32 index = 0;
        index < typeCount;
        index = index + 1)
    {
        status = AppendStandaloneWriterWord(
            Host.StandaloneWriterTypeMapTokens[
                typeFirst + index]);
        if (status != 0) { return status; }
    }
    for (mut int32 index = 0;
        index < methodCount;
        index = index + 1)
    {
        status = AppendStandaloneWriterWord(
            Host.StandaloneWriterMethodMapTokens[
                methodFirst + index]);
        if (status != 0) { return status; }
    }
    for (mut int32 index = 0;
        index < constantCount;
        index = index + 1)
    {
        int32 constantOffset
            = (constantFirst + index) * 2;
        status = AppendStandaloneWriterWord(
            Host.StandaloneWriterConstantMapEntries[
                constantOffset]);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(
            Host.StandaloneWriterConstantMapEntries[
                constantOffset + 1]);
        if (status != 0) { return status; }
    }

    status = AppendStandaloneWriterWord(0);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterWord(uint32(codeLength));
    if (status != 0) { return status; }
    status = AppendStandaloneWriterHalfWord(0);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterHalfWord(0);
    if (status != 0) { return status; }

    mut int32 recordOffset = 0;
    status = AppendStandaloneWriterWord(0);
    if (status != 0) { return status; }
    recordOffset = 8;
    status = AppendStandaloneWriterWord(uint32(recordOffset));
    if (status != 0) { return status; }
    for (mut int32 localOperation = 0;
        localOperation < operationCount;
        localOperation = localOperation + 1)
    {
        int32 operationOffset
            = (operationFirst + localOperation) * 4;
        if (Host.StandaloneRewrittenNormalizedOperations[
                operationOffset] != 3)
        {
            continue;
        }
        int32 invokeLocal
            = Host.StandaloneRewrittenNormalizedOperations[
                operationOffset + 1];
        if (invokeLocal < 0 || invokeLocal >= invokeCount)
        {
            return 3;
        }
        int32 invokeId = invokeFirst + invokeLocal;
        int32 inputCountForCall
            = Host.StandaloneRewrittenInvokes[
                invokeId * 10 + 4];
        recordOffset = recordOffset + 20
            + (inputCountForCall * 4);
        status = AppendStandaloneWriterWord(uint32(recordOffset));
        if (status != 0) { return status; }
    }
    if (recordOffset != recordDataLength)
    {
        return 3;
    }

    status = AppendStandaloneWriterByte(1);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterByte(0);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterHalfWord(0);
    if (status != 0) { return status; }
    status = AppendStandaloneWriterWord(0);
    if (status != 0) { return status; }
    for (mut int32 localOperation = 0;
        localOperation < operationCount;
        localOperation = localOperation + 1)
    {
        int32 operationOffset
            = (operationFirst + localOperation) * 4;
        if (Host.StandaloneRewrittenNormalizedOperations[
                operationOffset] != 3)
        {
            continue;
        }
        int32 invokeLocal
            = Host.StandaloneRewrittenNormalizedOperations[
                operationOffset + 1];
        int32 invokeId = invokeFirst + invokeLocal;
        status = WriteStandaloneWriterCallSiteRecord(
            bodyId, invokeId);
        if (status != 0) { return status; }
    }
    status = WriteStandaloneWriterBodyCode(bodyId, codeLength);
    if (status != 0) { return status; }
    if (Host.StandaloneWriterOutputByteCount[0] - bodyStart
        != bodySize)
    {
        return 3;
    }
    return 0;
}

int32 WriteStandaloneWriterBodySection()
{
    int32 bodyCount = Host.StandaloneWriterBodyPlanCount[0];
    if (bodyCount <= 0
        || bodyCount > Host.StandaloneWriterBodyPlans.Length / 20)
    {
        return 3;
    }

    int32 totalDataLength = 0;
    for (mut int32 bodyId = 0;
        bodyId < bodyCount;
        bodyId = bodyId + 1)
    {
        int32 bodySize
            = Host.StandaloneWriterBodyPlans[
                bodyId * 20 + 18];
        if (bodySize <= 0
            || totalDataLength > int32.MaxValue - bodySize)
        {
            return 3;
        }
        totalDataLength = totalDataLength + bodySize;
    }

    int32 sectionStart = Host.StandaloneWriterOutputByteCount[0];
    mut int32 dataOffset = 0;
    for (mut int32 bodyId = 0;
        bodyId < bodyCount;
        bodyId = bodyId + 1)
    {
        int32 status = AppendStandaloneWriterWord(
            uint32(dataOffset));
        if (status != 0) { return status; }
        dataOffset = dataOffset
            + Host.StandaloneWriterBodyPlans[
                bodyId * 20 + 18];
    }
    int32 finalOffsetStatus
        = AppendStandaloneWriterWord(uint32(dataOffset));
    if (finalOffsetStatus != 0) { return finalOffsetStatus; }
    if (dataOffset != totalDataLength)
    {
        return 3;
    }

    for (mut int32 bodyId = 0;
        bodyId < bodyCount;
        bodyId = bodyId + 1)
    {
        int32 status = WriteStandaloneWriterBody(bodyId);
        if (status != 0)
        {
            return status;
        }
    }
    return FinishStandaloneWriterSection(
        0x0020, bodyCount, sectionStart);
}

int32 WriteStandaloneWriterPredicateGraphSections()
{
    int32 graphCount
        = Host.StandaloneWriterPredicateGraphMapCount[0];
    if (graphCount < 0
        || graphCount
            > Host.StandaloneWriterPredicateGraphMap.Length / 4
        || graphCount > 0xFF_FFFF)
    {
        return 3;
    }
    if (graphCount == 0)
    {
        return 0;
    }

    for (mut int32 graphIndex = 0;
        graphIndex < graphCount;
        graphIndex = graphIndex + 1)
    {
        int32 mapOffset = graphIndex * 4;
        int32 artifactOrdinal
            = Host.StandaloneWriterPredicateGraphMap[mapOffset];
        int32 inputGraphRow
            = Host.StandaloneWriterPredicateGraphMap[mapOffset + 1];
        int32 outputGraphRow
            = Host.StandaloneWriterPredicateGraphMap[mapOffset + 2];
        int32 nodeKind
            = Host.StandaloneWriterPredicateGraphMap[mapOffset + 3];
        if (artifactOrdinal < 0
            || artifactOrdinal >= Host.StandaloneRequest[4]
            || inputGraphRow <= 0
            || outputGraphRow != graphIndex + 1
            || nodeKind < 1 || nodeKind > 6)
        {
            return 3;
        }
    }

    int32 sectionStart = Host.StandaloneWriterOutputByteCount[0];
    for (mut int32 graphIndex = 0;
        graphIndex < graphCount;
        graphIndex = graphIndex + 1)
    {
        uint32 row = uint32(graphIndex + 1);
        int32 status = AppendStandaloneWriterWord(row);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(row);
        if (status != 0) { return status; }
    }
    int32 status = FinishStandaloneWriterSection(
        0x0037, graphCount, sectionStart);
    if (status != 0) { return status; }

    sectionStart = Host.StandaloneWriterOutputByteCount[0];
    for (mut int32 graphIndex = 0;
        graphIndex < graphCount;
        graphIndex = graphIndex + 1)
    {
        uint32 row = uint32(graphIndex + 1);
        status = AppendStandaloneWriterWord(row);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(1);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(0);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(0);
        if (status != 0) { return status; }
    }
    status = FinishStandaloneWriterSection(
        0x0038, graphCount, sectionStart);
    if (status != 0) { return status; }

    sectionStart = Host.StandaloneWriterOutputByteCount[0];
    for (mut int32 graphIndex = 0;
        graphIndex < graphCount;
        graphIndex = graphIndex + 1)
    {
        status = AppendStandaloneWriterByte(5);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterByte(0);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterHalfWord(0);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(0);
        if (status != 0) { return status; }
    }
    status = FinishStandaloneWriterSection(
        0x0039, graphCount, sectionStart);
    if (status != 0) { return status; }

    sectionStart = Host.StandaloneWriterOutputByteCount[0];
    for (mut int32 graphIndex = 0;
        graphIndex < graphCount;
        graphIndex = graphIndex + 1)
    {
        int32 nodeKind
            = Host.StandaloneWriterPredicateGraphMap[
                graphIndex * 4 + 3];
        status = AppendStandaloneWriterWord(uint32(nodeKind));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(uint32(0xF200_0001));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(
            uint32(graphIndex + 1));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(1);
        if (status != 0) { return status; }
    }
    status = FinishStandaloneWriterSection(
        0x003B, graphCount, sectionStart);
    if (status != 0) { return status; }

    sectionStart = Host.StandaloneWriterOutputByteCount[0];
    for (mut int32 graphIndex = 0;
        graphIndex < graphCount;
        graphIndex = graphIndex + 1)
    {
        status = AppendStandaloneWriterByte(1);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterByte(0);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterHalfWord(0);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(
            uint32(graphIndex + 1));
        if (status != 0) { return status; }
    }
    return FinishStandaloneWriterSection(
        0x003C, graphCount, sectionStart);
}

public static int32 WriteStandaloneScalarModule()
{
    if (!ValidateStandaloneWriterBuffers()
        || !ValidateStandaloneSourceCallBuffers()
        || !ValidateStandaloneNormalizationBuffers()
        || !ValidateStandaloneRewriteBuffers())
    {
        return 3;
    }

    ClearStandaloneWriterOutputs();
    if (ValidateStandaloneMethodImportInput() != 0
        || Host.StandaloneSourceProgramStatus[0] != 0
        || Host.StandaloneNormalizedProgramStatus[0] != 0
        || Host.StandaloneRewriteStatus[0] != 0
        || Host.StandaloneRewrittenSourceBodyCount[0]
            != Host.StandaloneRewrittenNormalizedBodyCount[0]
        || Host.StandaloneRewrittenNormalizedBodyCount[0]
            != Host.StandaloneRewrittenLocalCallableCount[0]
        || !ValidateStandaloneRewriteMaps())
    {
        return FailStandaloneWriter(3);
    }

    int32 contractStatus
        = ValidateStandaloneWriterContractClosure();
    if (contractStatus != 0)
    {
        return FailStandaloneWriter(contractStatus);
    }
    int32 stringStatus = BuildStandaloneWriterStringInventory();
    if (stringStatus != 0)
    {
        return FailStandaloneWriter(stringStatus);
    }
    int32 typeStatus = BuildStandaloneWriterTypeSpecInventory();
    if (typeStatus != 0)
    {
        return FailStandaloneWriter(typeStatus);
    }
    int32 constantStatus = BuildStandaloneWriterConstantInventory();
    if (constantStatus != 0)
    {
        return FailStandaloneWriter(constantStatus);
    }
    int32 bodyStatus = BuildStandaloneWriterBodyPlans();
    if (bodyStatus != 0)
    {
        return FailStandaloneWriter(bodyStatus);
    }

    int32 writeStatus = WriteStandaloneWriterModuleSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterStringSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterBlobSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterFeatureSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterModuleRefSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterTypeSpecSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterMethodDefSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterMethodSigSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterParamSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterContractSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterImportSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterBodySection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterConstantSourceSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterFrozenValueNodeSection();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }
    writeStatus = WriteStandaloneWriterPredicateGraphSections();
    if (writeStatus != 0)
    {
        return FailStandaloneWriter(writeStatus);
    }

    Host.StandaloneWriterStatus[0] = 0;
    return 0;
}

int32 ValidateStandaloneWriterContractClosure()
{
    int32 rootMapStatus = BuildStandaloneWriterRootMap();
    if (rootMapStatus != 0)
    {
        return rootMapStatus;
    }

    int32 localCount
        = Host.StandaloneRewrittenLocalCallableCount[0];
    int32 methodCount = GetStandaloneWriterMethodCount();
    if (localCount < 0 || methodCount < localCount
        || methodCount
            > Host.StandaloneWriterMethodContractCounts.Length
        || Host.StandaloneWriterPredicateGraphMap.Length % 4 != 0)
    {
        return 3;
    }

    Host.StandaloneWriterPredicateGraphMapCount[0] = 0;
    for (mut int32 methodId = 0;
        methodId < methodCount;
        methodId = methodId + 1)
    {
        Host.StandaloneWriterMethodContractCounts[methodId] = 0;
    }

    for (mut int32 methodId = 0;
        methodId < methodCount;
        methodId = methodId + 1)
    {
        if (methodId < localCount)
        {
            int32 effectMask
                = GetStandaloneWriterMethodEffectMask(methodId);
            if (effectMask < 0 || (effectMask & ~6) != 0)
            {
                return 3;
            }
            Host.StandaloneWriterMethodContractCounts[methodId]
                = effectMask == 0 ? 0 : 1;
            continue;
        }

        int32 groupIndex = methodId - localCount;
        int32 representativeImport
            = Host.StandaloneWriterRootRepresentativeImportByGroup[
                groupIndex];
        if (representativeImport < 0
            || representativeImport
                >= Host.StandaloneRewrittenImportedCallableCount[0])
        {
            return 3;
        }
        int32 rootOrdinal
            = Host.StandaloneWriterRootOrdinals[representativeImport];
        if (rootOrdinal < 0
            || rootOrdinal >= Host.StandaloneResolvedRootCount[0])
        {
            return 3;
        }

        int32 rootOffset = rootOrdinal * 20;
        int32 artifactOrdinal
            = int32(Host.StandaloneResolvedRoots[rootOffset + 2]);
        int32 moduleRow
            = int32(Host.StandaloneResolvedRoots[rootOffset + 3]);
        int32 methodDefRow
            = int32(Host.StandaloneResolvedRoots[rootOffset + 5]);
        int32 paramFirst
            = int32(Host.StandaloneResolvedRoots[rootOffset + 10]);
        int32 paramCount
            = int32(Host.StandaloneResolvedRoots[rootOffset + 11]);
        int32 contractFirst
            = int32(Host.StandaloneResolvedRoots[rootOffset + 14]);
        int32 contractCount
            = int32(Host.StandaloneResolvedRoots[rootOffset + 15]);
        init int32 artifactStart;
        init int32 artifactLength;
        if (moduleRow <= 0 || methodDefRow <= 0
            || paramFirst < 0 || paramCount < 0
            || contractFirst < 0 || contractCount < 0
            || !TryGetStandaloneArtifactExtent(artifactOrdinal,
                ref init artifactStart, ref init artifactLength)
            || !TryValidateStandaloneArtifactDirectory(artifactOrdinal))
        {
            return 3;
        }

        int32 contractStatus = ValidateStandaloneMethodContracts(
            artifactOrdinal, moduleRow, rootOrdinal,
            artifactStart, artifactLength, methodDefRow,
            uint32(paramFirst), uint32(paramCount),
            uint32(contractFirst), uint32(contractCount));
        if (contractStatus != 0)
        {
            return contractStatus;
        }

        int32 effectMask
            = GetStandaloneWriterMethodEffectMask(methodId);
        if (effectMask != Host.StandaloneCallableEffects[rootOrdinal])
        {
            return 3;
        }
        int32 factCount = Host.StandaloneContractFactCount[0];
        if (effectMask < 0 || (effectMask & ~6) != 0
            || factCount < 0
            || factCount > Host.StandaloneContractFacts.Length / 7 - 1
            || factCount > 0xFF_FFFF
                - (effectMask == 0 ? 0 : 1))
        {
            return 3;
        }

        for (mut int32 factRow = 1;
            factRow <= factCount;
            factRow = factRow + 1)
        {
            int32 factOffset = factRow * 7;
            int32 factKind
                = Host.StandaloneContractFacts[factOffset];
            if (factKind == 2 || factKind == 11)
            {
                int32 predicateGraphRow = factKind == 2
                    ? Host.StandaloneContractFacts[factOffset + 2]
                    : Host.StandaloneContractFacts[factOffset + 3];
                init int32 outputGraphRow;
                int32 graphStatus
                    = EnsureStandaloneWriterPredicateGraph(
                        artifactOrdinal, moduleRow, rootOrdinal,
                        predicateGraphRow, ref init outputGraphRow);
                if (graphStatus != 0)
                {
                    return graphStatus;
                }
            }
            else if (factKind != 4)
            {
                return 3;
            }
        }

        Host.StandaloneWriterMethodContractCounts[methodId]
            = factCount + (effectMask == 0 ? 0 : 1);
    }

    return 0;
}

int32 EnsureStandaloneWriterPredicateGraph(int32 artifactOrdinal,
    int32 moduleRow, int32 callableSlot, int32 predicateGraphRow,
    ref<init int32> outputGraphRowResult)
    ensure return == 0 ? *outputGraphRowResult is init : true
{
    int32 mapCount
        = Host.StandaloneWriterPredicateGraphMapCount[0];
    int32 mapCapacity
        = Host.StandaloneWriterPredicateGraphMap.Length / 4;
    if (mapCount < 0 || mapCount > mapCapacity
        || Host.StandaloneWriterPredicateGraphMap.Length % 4 != 0
        || artifactOrdinal < 0
        || artifactOrdinal >= Host.StandaloneRequest[4]
        || predicateGraphRow <= 0)
    {
        return 3;
    }

    for (mut int32 mapRow = 0;
        mapRow < mapCount;
        mapRow = mapRow + 1)
    {
        int32 mapOffset = mapRow * 4;
        if (Host.StandaloneWriterPredicateGraphMap[mapOffset]
                == artifactOrdinal
            && Host.StandaloneWriterPredicateGraphMap[
                mapOffset + 1] == predicateGraphRow)
        {
            *outputGraphRowResult
                = Host.StandaloneWriterPredicateGraphMap[mapOffset + 2];
            return 0;
        }
    }

    init int32 artifactStart;
    init int32 artifactLength;
    if (mapCount >= mapCapacity || mapCount >= 0xFF_FFFF
        || !TryGetStandaloneArtifactExtent(artifactOrdinal,
            ref init artifactStart, ref init artifactLength)
        || !TryValidateStandaloneArtifactDirectory(artifactOrdinal))
    {
        return 3;
    }

    init int32 nodeKind;
    int32 graphStatus = TryValidateStandalonePublishedPredicateGraph(
        artifactStart, artifactLength, moduleRow, callableSlot,
        uint32(predicateGraphRow), ref init nodeKind);
    if (graphStatus != 0)
    {
        return graphStatus;
    }

    int32 outputGraphRow = mapCount + 1;
    int32 mapOffset = mapCount * 4;
    Host.StandaloneWriterPredicateGraphMap[mapOffset]
        = artifactOrdinal;
    Host.StandaloneWriterPredicateGraphMap[mapOffset + 1]
        = predicateGraphRow;
    Host.StandaloneWriterPredicateGraphMap[mapOffset + 2]
        = outputGraphRow;
    Host.StandaloneWriterPredicateGraphMap[mapOffset + 3]
        = nodeKind;
    Host.StandaloneWriterPredicateGraphMapCount[0]
        = outputGraphRow;
    *outputGraphRowResult = outputGraphRow;
    return 0;
}

int32 FindStandaloneWriterPredicateGraph(int32 artifactOrdinal,
    int32 predicateGraphRow)
{
    int32 mapCount
        = Host.StandaloneWriterPredicateGraphMapCount[0];
    if (mapCount < 0
        || mapCount > Host.StandaloneWriterPredicateGraphMap.Length / 4)
    {
        return -1;
    }
    for (mut int32 mapRow = 0;
        mapRow < mapCount;
        mapRow = mapRow + 1)
    {
        int32 mapOffset = mapRow * 4;
        if (Host.StandaloneWriterPredicateGraphMap[mapOffset]
                == artifactOrdinal
            && Host.StandaloneWriterPredicateGraphMap[
                mapOffset + 1] == predicateGraphRow)
        {
            return Host.StandaloneWriterPredicateGraphMap[
                mapOffset + 2];
        }
    }
    return 0;
}

int32 GetStandaloneWriterTotalParameterCount()
{
    int32 methodCount = GetStandaloneWriterMethodCount();
    mut int32 total = 0;
    for (mut int32 methodId = 0;
        methodId < methodCount;
        methodId = methodId + 1)
    {
        int32 count
            = GetStandaloneWriterMethodParameterCount(methodId);
        if (count < 0 || count > 65_536
            || total > 0xFF_FFFF - count)
        {
            return -1;
        }
        total = total + count;
    }
    return total;
}

int32 GetStandaloneWriterTotalContractCount()
{
    int32 methodCount = GetStandaloneWriterMethodCount();
    if (methodCount < 0
        || methodCount
            > Host.StandaloneWriterMethodContractCounts.Length)
    {
        return -1;
    }

    mut int32 total = 0;
    for (mut int32 methodId = 0;
        methodId < methodCount;
        methodId = methodId + 1)
    {
        int32 count
            = Host.StandaloneWriterMethodContractCounts[methodId];
        if (count < 0 || total > 0xFF_FFFF - count)
        {
            return -1;
        }
        total = total + count;
    }
    return total;
}

int32 WriteStandaloneWriterMethodDefSection()
{
    int32 methodCount = GetStandaloneWriterMethodCount();
    if (methodCount <= 0 || methodCount > 0xFF_FFFF
        || Host.StandaloneRewrittenImportedCallableCount[0]
            != Host.StandaloneWriterRootOrdinals.Length)
    {
        return 3;
    }

    int32 sectionStart = Host.StandaloneWriterOutputByteCount[0];
    mut int32 nextContractRow = 1;
    for (mut int32 methodId = 0;
        methodId < methodCount;
        methodId = methodId + 1)
    {
        int32 nameStringId
            = GetStandaloneWriterMethodNameStringId(methodId);
        int32 flags = GetStandaloneWriterMethodFlags(methodId);
        int32 bodyRow
            = GetStandaloneWriterMethodBodyRow(methodId);
        int32 effectMask
            = GetStandaloneWriterMethodEffectMask(methodId);
        int32 contractCount
            = Host.StandaloneWriterMethodContractCounts[methodId];
        if (nameStringId <= 0
            || nameStringId > Host.StandaloneWriterStringCount[0]
            || (flags != 0 && flags != 2)
            || bodyRow < 0 || effectMask < 0
            || (effectMask & ~6) != 0
            || contractCount < 0
            || nextContractRow > 0xFF_FFFF - contractCount)
        {
            return 3;
        }

        int32 contractFirst
            = contractCount == 0 ? 0 : nextContractRow;
        nextContractRow = nextContractRow + contractCount;
        int32 status = AppendStandaloneWriterWord(0);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(uint32(nameStringId));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(uint32(methodId + 1));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(uint32(flags));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(uint32(contractFirst));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(uint32(contractCount));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(uint32(bodyRow));
        if (status != 0) { return status; }
    }
    if (nextContractRow - 1
        != GetStandaloneWriterTotalContractCount())
    {
        return 3;
    }
    return FinishStandaloneWriterSection(
        0x0016, methodCount, sectionStart);
}

int32 WriteStandaloneWriterMethodSigSection()
{
    int32 methodCount = GetStandaloneWriterMethodCount();
    if (methodCount <= 0 || methodCount > 0xFF_FFFF)
    {
        return 3;
    }
    int32 totalParameterCount
        = GetStandaloneWriterTotalParameterCount();
    if (totalParameterCount < 0)
    {
        return 3;
    }

    int32 sectionStart = Host.StandaloneWriterOutputByteCount[0];
    mut int32 nextParameterRow = 1;
    for (mut int32 methodId = 0;
        methodId < methodCount;
        methodId = methodId + 1)
    {
        int32 resultTypeId
            = GetStandaloneWriterMethodResultTypeId(methodId);
        int32 parameterCount
            = GetStandaloneWriterMethodParameterCount(methodId);
        if (resultTypeId <= 0 || parameterCount < 0
            || parameterCount > 65_536
            || nextParameterRow
                > 0xFF_FFFF - parameterCount)
        {
            return 3;
        }
        init uint32 resultTypeSpec;
        int32 typeStatus = EnsureStandaloneWriterTypeSpec(
            resultTypeId, ref init resultTypeSpec);
        if (typeStatus != 0)
        {
            return typeStatus;
        }

        int32 paramFirst = parameterCount == 0
            ? 0 : nextParameterRow;
        int32 status
            = AppendStandaloneWriterWord(resultTypeSpec);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(0);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(uint32(paramFirst));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(uint32(parameterCount));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(0);
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(0);
        if (status != 0) { return status; }
        nextParameterRow = nextParameterRow + parameterCount;
    }
    if (nextParameterRow - 1 != totalParameterCount)
    {
        return 3;
    }
    return FinishStandaloneWriterSection(
        0x0017, methodCount, sectionStart);
}

int32 WriteStandaloneWriterParamSection()
{
    int32 totalParameterCount
        = GetStandaloneWriterTotalParameterCount();
    if (totalParameterCount < 0)
    {
        return 3;
    }
    if (totalParameterCount == 0)
    {
        return 0;
    }

    int32 methodCount = GetStandaloneWriterMethodCount();
    int32 sectionStart = Host.StandaloneWriterOutputByteCount[0];
    for (mut int32 methodId = 0;
        methodId < methodCount;
        methodId = methodId + 1)
    {
        int32 parameterCount
            = GetStandaloneWriterMethodParameterCount(methodId);
        if (parameterCount < 0)
        {
            return 3;
        }
        for (mut int32 ordinal = 0;
            ordinal < parameterCount;
            ordinal = ordinal + 1)
        {
            int32 typeId
                = GetStandaloneWriterMethodParameterTypeId(
                    methodId, ordinal);
            init uint32 typeSpecRef;
            int32 typeStatus = EnsureStandaloneWriterTypeSpec(
                typeId, ref init typeSpecRef);
            if (typeStatus != 0)
            {
                return typeStatus;
            }
            int32 status
                = AppendStandaloneWriterWord(uint32(methodId + 1));
            if (status != 0) { return status; }
            status = AppendStandaloneWriterWord(uint32(ordinal));
            if (status != 0) { return status; }
            status = AppendStandaloneWriterWord(typeSpecRef);
            if (status != 0) { return status; }
            status = AppendStandaloneWriterByte(0);
            if (status != 0) { return status; }
            status = AppendStandaloneWriterByte(0);
            if (status != 0) { return status; }
            status = AppendStandaloneWriterHalfWord(0);
            if (status != 0) { return status; }
        }
    }
    return FinishStandaloneWriterSection(
        0x0018, totalParameterCount, sectionStart);
}

int32 GetStandaloneWriterMethodRootOrdinal(int32 methodId)
{
    int32 localCount
        = Host.StandaloneRewrittenLocalCallableCount[0];
    int32 rootGroupCount
        = Host.StandaloneWriterRootExpectedGroupCount[0];
    if (methodId < localCount
        || methodId >= localCount + rootGroupCount)
    {
        return -1;
    }

    int32 representativeImport
        = Host.StandaloneWriterRootRepresentativeImportByGroup[
            methodId - localCount];
    if (representativeImport < 0
        || representativeImport
            >= Host.StandaloneRewrittenImportedCallableCount[0])
    {
        return -1;
    }
    int32 rootOrdinal
        = Host.StandaloneWriterRootOrdinals[representativeImport];
    if (rootOrdinal < 0
        || rootOrdinal >= Host.StandaloneResolvedRootCount[0])
    {
        return -1;
    }
    return rootOrdinal;
}

int32 AppendStandaloneWriterContractHeader(int32 methodId,
    int32 clauseKind)
{
    int32 methodCount = GetStandaloneWriterMethodCount();
    if (methodId < 0 || methodId >= methodCount
        || clauseKind <= 0 || clauseKind > 0xFFFF)
    {
        return 3;
    }

    int32 status = AppendStandaloneWriterWord(uint32(methodId + 1));
    if (status != 0) { return status; }
    status = AppendStandaloneWriterHalfWord(uint32(clauseKind));
    if (status != 0) { return status; }
    return AppendStandaloneWriterHalfWord(0);
}

int32 WriteStandaloneWriterContractSection()
{
    int32 contractCount
        = GetStandaloneWriterTotalContractCount();
    if (contractCount < 0)
    {
        return 3;
    }
    if (contractCount == 0)
    {
        return 0;
    }

    int32 methodCount = GetStandaloneWriterMethodCount();
    int32 localCount
        = Host.StandaloneRewrittenLocalCallableCount[0];
    int32 sectionStart = Host.StandaloneWriterOutputByteCount[0];
    mut int32 dataOffset = 0;
    mut int32 outputContractRow = 0;
    int32 status = AppendStandaloneWriterWord(0);
    if (status != 0) { return status; }

    for (mut int32 methodId = 0;
        methodId < methodCount;
        methodId = methodId + 1)
    {
        if (methodId < localCount)
        {
            int32 effectMask
                = GetStandaloneWriterMethodEffectMask(methodId);
            int32 methodContractCount
                = Host.StandaloneWriterMethodContractCounts[methodId];
            if (effectMask < 0 || (effectMask & ~6) != 0
                || methodContractCount
                    != (effectMask == 0 ? 0 : 1))
            {
                return 3;
            }
            if (effectMask != 0)
            {
                dataOffset = dataOffset + 12;
                outputContractRow = outputContractRow + 1;
                status = AppendStandaloneWriterWord(
                    uint32(dataOffset));
                if (status != 0) { return status; }
            }
            continue;
        }

        int32 rootOrdinal
            = GetStandaloneWriterMethodRootOrdinal(methodId);
        if (rootOrdinal < 0)
        {
            return 3;
        }
        int32 rootOffset = rootOrdinal * 20;
        int32 artifactOrdinal
            = int32(Host.StandaloneResolvedRoots[rootOffset + 2]);
        int32 inputContractFirst
            = int32(Host.StandaloneResolvedRoots[rootOffset + 14]);
        int32 inputContractCount
            = int32(Host.StandaloneResolvedRoots[rootOffset + 15]);
        if (inputContractCount < 0)
        {
            return 3;
        }
        if (inputContractCount == 0)
        {
            if (Host.StandaloneWriterMethodContractCounts[methodId] != 0)
            {
                return 3;
            }
            continue;
        }

        int32 methodFirstOutputRow = outputContractRow;
        init int32 artifactStart;
        init int32 artifactLength;
        if (!TryGetStandaloneArtifactExtent(artifactOrdinal,
                ref init artifactStart, ref init artifactLength)
            || !TryValidateStandaloneArtifactDirectory(artifactOrdinal))
        {
            return 3;
        }
        int32 contractEntry
            = FindStandaloneArtifactSection(0x001B);
        int32 contractTableCount
            = GetStandaloneArtifactSectionCount(0x001B);
        if (contractEntry == 0)
        {
            return 3;
        }
        int32 contractStart
            = Host.StandaloneSectionStarts[contractEntry];
        int32 contractLength
            = Host.StandaloneSectionLengths[contractEntry];
        for (mut int32 inputOffset = 0;
            inputOffset < inputContractCount;
            inputOffset = inputOffset + 1)
        {
            init int32 rowStart;
            init int32 rowLength;
            if (!TryGetStandaloneVariableTableRowExtent(
                    artifactStart, artifactLength, contractStart,
                    contractLength, contractTableCount, 8, 1,
                    inputContractFirst + inputOffset,
                    ref init rowStart, ref init rowLength))
            {
                return 3;
            }
            init uint32 clauseKind;
            if (rowLength < 8
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength, rowStart + 4,
                    ref init clauseKind))
            {
                return 3;
            }

            if (clauseKind == 1)
            {
                init uint32 effectMask;
                if (rowLength != 12
                    || !TryReadStandaloneArtifactAbsoluteWord(
                        artifactStart, artifactLength, rowStart + 8,
                        ref init effectMask))
                {
                    return 3;
                }
                if (effectMask == 0)
                {
                    continue;
                }
            }
            else if (clauseKind != 2 && clauseKind != 4
                && clauseKind != 0x0B)
            {
                return 2;
            }
            else if (rowLength != 20)
            {
                return 3;
            }

            if (dataOffset > int32.MaxValue - rowLength)
            {
                return 3;
            }
            dataOffset = dataOffset + rowLength;
            outputContractRow = outputContractRow + 1;
            status = AppendStandaloneWriterWord(uint32(dataOffset));
            if (status != 0) { return status; }
        }
        if (outputContractRow - methodFirstOutputRow
            != Host.StandaloneWriterMethodContractCounts[methodId])
        {
            return 3;
        }
    }

    if (outputContractRow != contractCount)
    {
        return 3;
    }

    outputContractRow = 0;
    for (mut int32 methodId = 0;
        methodId < methodCount;
        methodId = methodId + 1)
    {
        int32 effectMask
            = GetStandaloneWriterMethodEffectMask(methodId);
        if (effectMask < 0 || (effectMask & ~6) != 0)
        {
            return 3;
        }
        if (methodId < localCount)
        {
            if (effectMask != 0)
            {
                status = AppendStandaloneWriterContractHeader(
                    methodId, 1);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterWord(
                    uint32(effectMask));
                if (status != 0) { return status; }
                outputContractRow = outputContractRow + 1;
            }
            continue;
        }

        int32 rootOrdinal
            = GetStandaloneWriterMethodRootOrdinal(methodId);
        if (rootOrdinal < 0)
        {
            return 3;
        }
        int32 rootOffset = rootOrdinal * 20;
        int32 artifactOrdinal
            = int32(Host.StandaloneResolvedRoots[rootOffset + 2]);
        int32 methodDefRow
            = int32(Host.StandaloneResolvedRoots[rootOffset + 5]);
        int32 inputContractFirst
            = int32(Host.StandaloneResolvedRoots[rootOffset + 14]);
        int32 inputContractCount
            = int32(Host.StandaloneResolvedRoots[rootOffset + 15]);
        if (inputContractCount < 0)
        {
            return 3;
        }
        if (inputContractCount == 0)
        {
            if (Host.StandaloneWriterMethodContractCounts[methodId] != 0)
            {
                return 3;
            }
            continue;
        }

        int32 methodFirstOutputRow = outputContractRow;
        init int32 artifactStart;
        init int32 artifactLength;
        if (!TryGetStandaloneArtifactExtent(artifactOrdinal,
                ref init artifactStart, ref init artifactLength)
            || !TryValidateStandaloneArtifactDirectory(artifactOrdinal))
        {
            return 3;
        }
        int32 contractEntry
            = FindStandaloneArtifactSection(0x001B);
        int32 contractTableCount
            = GetStandaloneArtifactSectionCount(0x001B);
        if (contractEntry == 0)
        {
            return 3;
        }
        int32 contractStart
            = Host.StandaloneSectionStarts[contractEntry];
        int32 contractLength
            = Host.StandaloneSectionLengths[contractEntry];
        for (mut int32 inputOffset = 0;
            inputOffset < inputContractCount;
            inputOffset = inputOffset + 1)
        {
            init int32 rowStart;
            init int32 rowLength;
            init uint32 owner;
            init uint32 clauseKind;
            init uint32 clauseFlags;
            if (!TryGetStandaloneVariableTableRowExtent(
                    artifactStart, artifactLength, contractStart,
                    contractLength, contractTableCount, 8, 1,
                    inputContractFirst + inputOffset,
                    ref init rowStart, ref init rowLength)
                || rowLength < 8
                || !TryReadStandaloneArtifactAbsoluteWord(
                    artifactStart, artifactLength, rowStart,
                    ref init owner)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength, rowStart + 4,
                    ref init clauseKind)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength, rowStart + 6,
                    ref init clauseFlags)
                || owner != uint32(methodDefRow)
                || clauseFlags != 0)
            {
                return 3;
            }

            if (clauseKind == 1)
            {
                init uint32 inputEffectMask;
                if (rowLength != 12
                    || !TryReadStandaloneArtifactAbsoluteWord(
                        artifactStart, artifactLength, rowStart + 8,
                        ref init inputEffectMask))
                {
                    return 3;
                }
                if (inputEffectMask == 0)
                {
                    continue;
                }
                if (int32(inputEffectMask) != effectMask)
                {
                    return 3;
                }
                status = AppendStandaloneWriterContractHeader(
                    methodId, 1);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterWord(inputEffectMask);
                if (status != 0) { return status; }
                outputContractRow = outputContractRow + 1;
                continue;
            }

            if (rowLength != 20)
            {
                return 3;
            }
            if (clauseKind == 2)
            {
                init uint32 parameterOrdinal;
                init uint32 inputGraphRow;
                init int32 state;
                init int32 reserved0;
                init int32 reserved1;
                init int32 reserved2;
                if (!TryReadStandaloneArtifactAbsoluteWord(
                        artifactStart, artifactLength, rowStart + 8,
                        ref init parameterOrdinal)
                    || !TryReadStandaloneArtifactAbsoluteWord(
                        artifactStart, artifactLength, rowStart + 12,
                        ref init inputGraphRow)
                    || !TryReadStandaloneArtifactAbsoluteByte(
                        artifactStart, artifactLength, rowStart + 16,
                        ref init state)
                    || !TryReadStandaloneArtifactAbsoluteByte(
                        artifactStart, artifactLength, rowStart + 17,
                        ref init reserved0)
                    || !TryReadStandaloneArtifactAbsoluteByte(
                        artifactStart, artifactLength, rowStart + 18,
                        ref init reserved1)
                    || !TryReadStandaloneArtifactAbsoluteByte(
                        artifactStart, artifactLength, rowStart + 19,
                        ref init reserved2))
                {
                    return 3;
                }
                int32 outputGraphRow
                    = FindStandaloneWriterPredicateGraph(
                        artifactOrdinal, int32(inputGraphRow));
                if (outputGraphRow <= 0 || state < 0 || state > 1
                    || reserved0 != 0 || reserved1 != 0
                    || reserved2 != 0)
                {
                    return 3;
                }

                status = AppendStandaloneWriterContractHeader(
                    methodId, 2);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterWord(
                    parameterOrdinal);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterWord(
                    uint32(outputGraphRow));
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(state);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(0);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(0);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(0);
                if (status != 0) { return status; }
                outputContractRow = outputContractRow + 1;
                continue;
            }

            if (clauseKind == 0x0B)
            {
                init int32 phaseTag;
                init int32 phaseFlags;
                init uint32 phaseReserved;
                init uint32 phaseOrdinal;
                init uint32 inputGraphRow;
                if (!TryReadStandaloneArtifactAbsoluteByte(
                        artifactStart, artifactLength, rowStart + 8,
                        ref init phaseTag)
                    || !TryReadStandaloneArtifactAbsoluteByte(
                        artifactStart, artifactLength, rowStart + 9,
                        ref init phaseFlags)
                    || !TryReadStandaloneArtifactAbsoluteHalfWord(
                        artifactStart, artifactLength, rowStart + 10,
                        ref init phaseReserved)
                    || !TryReadStandaloneArtifactAbsoluteWord(
                        artifactStart, artifactLength, rowStart + 12,
                        ref init phaseOrdinal)
                    || !TryReadStandaloneArtifactAbsoluteWord(
                        artifactStart, artifactLength, rowStart + 16,
                        ref init inputGraphRow)
                    || phaseFlags != 0 || phaseReserved != 0)
                {
                    return 3;
                }
                int32 outputGraphRow
                    = FindStandaloneWriterPredicateGraph(
                        artifactOrdinal, int32(inputGraphRow));
                if (outputGraphRow <= 0)
                {
                    return 3;
                }

                status = AppendStandaloneWriterContractHeader(
                    methodId, 0x0B);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(phaseTag);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(0);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterHalfWord(0);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterWord(phaseOrdinal);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterWord(
                    uint32(outputGraphRow));
                if (status != 0) { return status; }
                outputContractRow = outputContractRow + 1;
                continue;
            }

            if (clauseKind == 4)
            {
                init int32 destinationKind;
                init int32 sourceKind;
                init int32 relationship;
                init int32 phase;
                init uint32 destinationOrdinal;
                init uint32 sourceOrdinal;
                if (!TryReadStandaloneArtifactAbsoluteByte(
                        artifactStart, artifactLength, rowStart + 8,
                        ref init destinationKind)
                    || !TryReadStandaloneArtifactAbsoluteByte(
                        artifactStart, artifactLength, rowStart + 9,
                        ref init sourceKind)
                    || !TryReadStandaloneArtifactAbsoluteByte(
                        artifactStart, artifactLength, rowStart + 10,
                        ref init relationship)
                    || !TryReadStandaloneArtifactAbsoluteByte(
                        artifactStart, artifactLength, rowStart + 11,
                        ref init phase)
                    || !TryReadStandaloneArtifactAbsoluteWord(
                        artifactStart, artifactLength, rowStart + 12,
                        ref init destinationOrdinal)
                    || !TryReadStandaloneArtifactAbsoluteWord(
                        artifactStart, artifactLength, rowStart + 16,
                        ref init sourceOrdinal))
                {
                    return 3;
                }
                status = AppendStandaloneWriterContractHeader(
                    methodId, 4);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(destinationKind);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(sourceKind);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(relationship);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterByte(phase);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterWord(
                    destinationOrdinal);
                if (status != 0) { return status; }
                status = AppendStandaloneWriterWord(sourceOrdinal);
                if (status != 0) { return status; }
                outputContractRow = outputContractRow + 1;
                continue;
            }

            return 2;
        }
        if (outputContractRow - methodFirstOutputRow
            != Host.StandaloneWriterMethodContractCounts[methodId])
        {
            return 3;
        }
    }

    if (outputContractRow != contractCount)
    {
        return 3;
    }
    return FinishStandaloneWriterSection(
        0x001B, contractCount, sectionStart);
}

int32 WriteStandaloneWriterImportSection()
{
    int32 importedCount
        = Host.StandaloneRewrittenImportedCallableCount[0];
    if (importedCount < 0 || importedCount > 0xFF_FFFF)
    {
        return 3;
    }
    if (importedCount == 0)
    {
        return 0;
    }

    int32 sectionStart = Host.StandaloneWriterOutputByteCount[0];
    for (mut int32 importedId = 0;
        importedId < importedCount;
        importedId = importedId + 1)
    {
        int32 providerModuleId
            = Host.StandaloneRewrittenImportedCallables[
                importedId * 8 + 1];
        int32 keyStringId
            = Host.StandaloneWriterRootKeyStringIds[importedId];
        if (providerModuleId < 0
            || providerModuleId
                >= Host.StandaloneWriterModuleRefByModuleId.Length
            || keyStringId <= 0
            || keyStringId > Host.StandaloneWriterStringCount[0])
        {
            return 3;
        }
        int32 moduleRefRow
            = Host.StandaloneWriterModuleRefByModuleId[
                providerModuleId];
        int32 expectedMethodRow
            = Host.StandaloneWriterRootExpectedMethodRowsByImport[
                importedId];
        if (moduleRefRow <= 0
            || moduleRefRow
                > Host.StandaloneWriterModuleRefCount[0]
            || expectedMethodRow <= 0
            || expectedMethodRow > 0x00FF_FFFF)
        {
            return 3;
        }
        int32 status = AppendStandaloneWriterWord(
            uint32(moduleRefRow));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(uint32(keyStringId));
        if (status != 0) { return status; }
        status = AppendStandaloneWriterWord(
            uint32(0x1600_0000) | uint32(expectedMethodRow));
        if (status != 0) { return status; }
    }
    return FinishStandaloneWriterSection(
        0x001C, importedCount, sectionStart);
}
