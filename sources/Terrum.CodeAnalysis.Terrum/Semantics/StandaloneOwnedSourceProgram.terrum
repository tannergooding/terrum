        tokenIndex = tokenIndex + 1;
    }
    if (tokenIndex < tokenEnd
        && Host.Tokens[tokenIndex * 3] == 46)
    {
        *nameTokenEndResult = tokenIndex;
        *openingParenResult = tokenIndex;
        return 0;
    }
    *nameTokenEndResult = tokenIndex;
    *openingParenResult = -1;
    return 1;
}

int32 ParseStandaloneInitializationArgumentExpression(
