                = FindStandaloneImportedCandidateAtScope(localCallableId,
                    nameTokenStart, nameTokenEnd, openingParen,
                    closingParen, argumentCount, usingScopeId, depth,
                    ref init importedCandidate,
                    ref init importedNameFound);
            if (importedNameFound)
            {
