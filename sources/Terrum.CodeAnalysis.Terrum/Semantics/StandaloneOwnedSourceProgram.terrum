            init bool localNameFound;
            int32 localStatus
                = FindStandaloneLocalCandidateAtNamespace(
                    namespaceIdentityId, localCallableId,
                    methodNameToken, openingParen, closingParen,
                    argumentCount, depth,
                    ref init localCandidate, ref init localNameFound);
            if (localNameFound)
            {
                if (localStatus != 0)
                {
                    return localStatus;
                }
                int32 infoOffset = localCandidate * 12;
                return CompleteStandaloneCallCandidate(1,
                    localCandidate,
                    Host.StandaloneSourceCallableInfo[infoOffset + 4],
                    Host.StandaloneSourceCallableInfo[infoOffset + 6],
                    ref init targetKindResult, ref init targetIndexResult,
                    ref init expectedCallableIdResult,
                    ref init resultTypeIdResult,
                    ref init parameterCountResult);
            }
        }

        init int32 qualifiedImportedCandidate;
        init bool qualifiedImportedNameFound;
        int32 qualifiedImportStatus
            = FindStandaloneImportedCandidateAtScope(localCallableId,
                nameTokenStart, nameTokenEnd, openingParen,
                closingParen, argumentCount, -2, depth,
                ref init qualifiedImportedCandidate,
                ref init qualifiedImportedNameFound);
        if (qualifiedImportedNameFound)
        {
            if (qualifiedImportStatus != 0)
            {
                return qualifiedImportStatus;
            }
            int32 importedOffset
                = qualifiedImportedCandidate * 8;
            int32 importedCallableId
                = Host.StandaloneSourceImportedCallables[
                    importedOffset + 4];
            int32 importedRootOffset = importedCallableId * 20;
            return CompleteStandaloneCallCandidate(2,
                qualifiedImportedCandidate,
                Host.StandaloneCallableTypeIds[importedCallableId],
                int32(Host.StandaloneResolvedRoots[
                    importedRootOffset + 11]),
                ref init targetKindResult, ref init targetIndexResult,
                ref init expectedCallableIdResult,
                ref init resultTypeIdResult,
                ref init parameterCountResult);
        }
        return 3;
    }

    mut int32 namespaceIdentityId
        = Host.StandaloneSourceCallableInfo[
            localCallableId * 12 + 3];
    if (namespaceIdentityId < 0
        || namespaceIdentityId
            > Host.StandaloneSourceNamespaceIdentityCount[0])
    {
        return 3;
    }
    while (true)
    {
