namespace Terrum.CodeAnalysis;

public static int32 BindStandaloneOwnedSourceProgram()
{
    if (Host.StandaloneSourceProgramStatus.Length != 1)
    {
        return 3;
    }
    Host.StandaloneSourceProgramStatus[0] = 0;
    if (ValidateStandaloneMethodImportInput() != 0
        || !ValidateStandaloneSourceCallBuffers())
    {
        Host.StandaloneSourceProgramStatus[0] = 3;
        return 3;
    }

    ClearStandaloneSourceCallProgram();
    int32 rootStatus = BindStandaloneMethodRoots();
    if (rootStatus != 0)
    {
        return FailStandaloneSourceProgram(rootStatus);
    }

    init int32 tokenEnd;
    int32 tokenStatus = FindStandaloneSourceEnd(ref init tokenEnd);
    if (tokenStatus != 0)
    {
        return FailStandaloneSourceProgram(tokenStatus);
    }
    if (!TokenIntegerSnapshot.TryValidate(tokenEnd + 1))
    {
        return FailStandaloneSourceProgram(3);
    }

    int32 importedStatus = BuildStandaloneImportedCallableViews();
    if (importedStatus != 0)
    {
        return FailStandaloneSourceProgram(importedStatus);
    }

    init int32 usingModuleDirectoryRow;
    if (!TryFindStandaloneModuleDirectoryRow(
            Host.StandaloneRequest[2], Host.StandaloneRequest[3],
            ref init usingModuleDirectoryRow))
    {
        return FailStandaloneSourceProgram(3);
    }
    int32 usingModuleId = usingModuleDirectoryRow - 1;
    int32 sourceStatus = InventoryStandaloneSourceFile(
        tokenEnd, usingModuleId);
    if (sourceStatus != 0)
    {
        return FailStandaloneSourceProgram(sourceStatus);
    }
    if (Host.StandaloneLocalCallableCount[0] == 0)
    {
        return FailStandaloneSourceProgram(1);
    }
    int32 primitiveTypeStatus
        = InternStandaloneSourcePrimitiveTypeFacts();
    if (primitiveTypeStatus != 0)
    {
        return FailStandaloneSourceProgram(primitiveTypeStatus);
    }

    for (mut int32 localCallableId = 0;
        localCallableId < Host.StandaloneLocalCallableCount[0];
        localCallableId = localCallableId + 1)
    {
        int32 bodyStatus
            = BindStandaloneSourceBody(localCallableId);
        if (bodyStatus != 0)
        {
            return FailStandaloneSourceProgram(bodyStatus);
        }
    }

    int32 verificationStatus = VerifyStandaloneDirectCalls();
    if (verificationStatus != 0)
    {
        return FailStandaloneSourceProgram(verificationStatus);
    }
    Host.StandaloneSourceProgramStatus[0] = 0;
    return 0;
}

bool ValidateStandaloneSourceCallBuffers()
{
    if (Host.Source.Length < 0
        || Host.Source.Length >= int32.MaxValue
        || Host.Tokens.Length
            != (Host.Source.Length + 1) * 3)
    {
        return false;
    }
    int32 tokenCapacity = Host.Source.Length + 1;
    if (tokenCapacity > int32.MaxValue / 12)
    {
        return false;
    }
    return Host.StandaloneSourceProgramStatus.Length == 1
        && Host.StandaloneSourceArithmeticProfile.Length == 1
        && (Host.StandaloneSourceArithmeticProfile[0] == 0
            || Host.StandaloneSourceArithmeticProfile[0] == 1)
        && Host.StandaloneLocalCallableCount.Length == 1
        && Host.StandaloneLocalCallables.Length == tokenCapacity * 3
        && Host.StandaloneSourceCallableInfo.Length
            == tokenCapacity * 12
        && Host.StandaloneSourceParameterCount.Length == 1
        && Host.StandaloneSourceParameters.Length
            == tokenCapacity * 4
        && Host.StandaloneSourceBodyCount.Length == 1
        && Host.StandaloneSourceBodies.Length
            == tokenCapacity * 12
        && Host.StandaloneSourceExpressionCount.Length == 1
        && Host.StandaloneSourceExpressions.Length
            == tokenCapacity * 8
        && Host.StandaloneSourceExpressionUseCounts.Length
            == tokenCapacity
        && Host.StandaloneSourceDirectCallUseCounts.Length
            == tokenCapacity
        && Host.StandaloneSourceStatementCount.Length == 1
        && Host.StandaloneSourceStatements.Length
            == tokenCapacity * 3
        && Host.StandaloneSourceStatementParentIds.Length
            == tokenCapacity
        && Host.StandaloneSourceIfNodeCount.Length == 1
        && Host.StandaloneSourceIfNodes.Length
            == tokenCapacity * 5
        && Host.StandaloneSourceIfChildCount.Length == 1
        && Host.StandaloneSourceIfChildren.Length
            == tokenCapacity
        && Host.StandaloneSourceLexicalScopeCount.Length == 1
        && Host.StandaloneSourceLexicalScopes.Length
            == tokenCapacity * 5
        && Host.StandaloneSourceBodyScopeIds.Length
            == tokenCapacity
        && Host.StandaloneSourceLocalCount.Length == 1
        && Host.StandaloneSourceLocals.Length
            == tokenCapacity * 10
        && Host.StandaloneSourceBodyLocalRanges.Length
            == tokenCapacity * 2
        && Host.StandaloneSourceLocalStates.Length
            == tokenCapacity
        && Host.StandaloneSourceLocalDeclarationUseCounts.Length
            == tokenCapacity
        && Host.StandaloneSourcePlaceCount.Length == 1
        && Host.StandaloneSourcePlaces.Length
            == tokenCapacity * 5
        && Host.StandaloneSourceBodyPlaceRanges.Length
            == tokenCapacity * 2
        && Host.StandaloneSourcePlaceUseCounts.Length
            == tokenCapacity
        && Host.StandaloneSourceImportedCallableCount.Length == 1
        && Host.StandaloneSourceImportedCallables.Length
            == Host.StandaloneMethodRoots.Length / 5 * 8
        && Host.StandaloneSourceDirectCallCount.Length == 1
        && Host.StandaloneSourceDirectCalls.Length
            == tokenCapacity * 7
        && Host.StandaloneSourceCallArgumentCount.Length == 1
        && Host.StandaloneSourceCallArguments.Length
            == tokenCapacity * 3
        && Host.StandaloneSourceCallArgumentOwners.Length
            == tokenCapacity
        && Host.StandaloneSourceCallFormalSeen.Length
            == tokenCapacity
        && Host.StandaloneSourceCallCandidateCache.Length
            == tokenCapacity * 6
        && Host.StandaloneSourceUsingCount.Length == 1
        && Host.StandaloneSourceNamespaceScopeCount.Length == 1
        && Host.StandaloneSourceNamespaceIdentityCount.Length == 1
        && Host.StandaloneSourceNamespaceDepthLimit.Length == 1
        && Host.StandaloneSourceNamespaceDepthLimit[0] > 0
        && Host.StandaloneSourceUsings.Length
            == tokenCapacity * 3
        && Host.StandaloneSourceNamespaceScopes.Length
            == tokenCapacity * 2
        && Host.StandaloneSourceNamespaceIdentityNodes.Length
            == tokenCapacity * 3
        && Host.StandaloneSourceNamespaceIdentitySlots.Length
            == tokenCapacity * 2 + 1;
}

void ClearStandaloneSourceCallProgram()
{
    Host.StandaloneSourceProgramStatus[0] = 0;
    Host.StandaloneLocalCallableCount[0] = 0;
    Host.StandaloneSourceParameterCount[0] = 0;
    Host.StandaloneSourceBodyCount[0] = 0;
    Host.StandaloneSourceExpressionCount[0] = 0;
    Host.StandaloneSourceStatementCount[0] = 0;
    Host.StandaloneSourceIfNodeCount[0] = 0;
    Host.StandaloneSourceIfChildCount[0] = 0;
    Host.StandaloneSourceLexicalScopeCount[0] = 0;
    Host.StandaloneSourceLocalCount[0] = 0;
    Host.StandaloneSourcePlaceCount[0] = 0;
    Host.StandaloneSourceImportedCallableCount[0] = 0;
    Host.StandaloneSourceDirectCallCount[0] = 0;
    Host.StandaloneSourceCallArgumentCount[0] = 0;
    Host.StandaloneSourceUsingCount[0] = 0;
    Host.StandaloneSourceNamespaceScopeCount[0] = 0;
    Host.StandaloneSourceNamespaceIdentityCount[0] = 0;
    for (mut int32 index = 0;
        index < Host.StandaloneLocalCallables.Length;
        index = index + 1)
    {
        Host.StandaloneLocalCallables[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceCallableInfo.Length;
        index = index + 1)
    {
        Host.StandaloneSourceCallableInfo[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceParameters.Length;
        index = index + 1)
    {
        Host.StandaloneSourceParameters[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceBodies.Length;
        index = index + 1)
    {
        Host.StandaloneSourceBodies[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceExpressions.Length;
        index = index + 1)
    {
        Host.StandaloneSourceExpressions[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceExpressionUseCounts.Length;
        index = index + 1)
    {
        Host.StandaloneSourceExpressionUseCounts[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceDirectCallUseCounts.Length;
        index = index + 1)
    {
        Host.StandaloneSourceDirectCallUseCounts[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceStatements.Length;
        index = index + 1)
    {
        Host.StandaloneSourceStatements[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceStatementParentIds.Length;
        index = index + 1)
    {
        Host.StandaloneSourceStatementParentIds[index] = -1;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceIfNodes.Length;
        index = index + 1)
    {
        Host.StandaloneSourceIfNodes[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceIfChildren.Length;
        index = index + 1)
    {
        Host.StandaloneSourceIfChildren[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceLexicalScopes.Length;
        index = index + 1)
    {
        Host.StandaloneSourceLexicalScopes[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceBodyScopeIds.Length;
        index = index + 1)
    {
        Host.StandaloneSourceBodyScopeIds[index] = -1;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceLocals.Length;
        index = index + 1)
    {
        Host.StandaloneSourceLocals[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceBodyLocalRanges.Length;
        index = index + 1)
    {
        Host.StandaloneSourceBodyLocalRanges[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceLocalStates.Length;
        index = index + 1)
    {
        Host.StandaloneSourceLocalStates[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceLocalDeclarationUseCounts.Length;
        index = index + 1)
    {
        Host.StandaloneSourceLocalDeclarationUseCounts[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourcePlaces.Length;
        index = index + 1)
    {
        Host.StandaloneSourcePlaces[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceBodyPlaceRanges.Length;
        index = index + 1)
    {
        Host.StandaloneSourceBodyPlaceRanges[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourcePlaceUseCounts.Length;
        index = index + 1)
    {
        Host.StandaloneSourcePlaceUseCounts[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceImportedCallables.Length;
        index = index + 1)
    {
        Host.StandaloneSourceImportedCallables[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceDirectCalls.Length;
        index = index + 1)
    {
        Host.StandaloneSourceDirectCalls[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceCallArguments.Length;
        index = index + 1)
    {
        Host.StandaloneSourceCallArguments[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceCallArgumentOwners.Length;
        index = index + 1)
    {
        Host.StandaloneSourceCallArgumentOwners[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceCallFormalSeen.Length;
        index = index + 1)
    {
        Host.StandaloneSourceCallFormalSeen[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceCallCandidateCache.Length;
        index = index + 1)
    {
        Host.StandaloneSourceCallCandidateCache[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceUsings.Length;
        index = index + 1)
    {
        Host.StandaloneSourceUsings[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceNamespaceScopes.Length;
        index = index + 1)
    {
        Host.StandaloneSourceNamespaceScopes[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceNamespaceIdentityNodes.Length;
        index = index + 1)
    {
        Host.StandaloneSourceNamespaceIdentityNodes[index] = 0;
    }
    for (mut int32 index = 0;
        index < Host.StandaloneSourceNamespaceIdentitySlots.Length;
        index = index + 1)
    {
        Host.StandaloneSourceNamespaceIdentitySlots[index] = 0;
    }
}

int32 FailStandaloneSourceProgram(int32 status)
{
    ClearStandaloneSourceCallProgram();
    ClearStandaloneResolvedRoots();
    Host.StandaloneSourceProgramStatus[0] = status;
    return status;
}

int32 FindStandaloneSourceEnd(ref<init int32> tokenEndResult)
    ensure return == 0 ? *tokenEndResult is init : true
{
    int32 tokenCapacity = Host.Tokens.Length / 3;
    if (tokenCapacity < 1)
    {
        return 3;
    }

    mut int32 previousEnd = 0;
    mut int32 end = -1;
    for (mut int32 index = 0; index < tokenCapacity;
        index = index + 1)
    {
        int32 offset = index * 3;
        int32 kind = Host.Tokens[offset];
        int32 start = Host.Tokens[offset + 1];
        int32 length = Host.Tokens[offset + 2];
        if (kind == 0)
        {
            if (end < 0 && (start != Host.Source.Length || length != 0)
                || end >= 0 && (start != 0 || length != 0))
            {
                return 3;
            }
            if (end < 0)
            {
                end = index;
            }
            continue;
        }
        if (end >= 0 || start < previousEnd || length <= 0
            || start < 0 || start > Host.Source.Length
            || length > Host.Source.Length - start)
        {
            return 3;
        }
        previousEnd = start + length;
    }
    if (end < 0)
    {
        return 3;
    }
    *tokenEndResult = end;
    return 0;
}

int32 BuildStandaloneImportedCallableViews()
{
    int32 rootCount = Host.StandaloneResolvedRootCount[0];
    if (rootCount < 0
        || rootCount != Host.StandaloneMethodRoots.Length / 5
        || Host.StandaloneSourceImportedCallableCount.Length != 1
        || Host.StandaloneSourceImportedCallables.Length
            != Host.StandaloneMethodRoots.Length / 5 * 8)
    {
        return 3;
    }

    for (mut int32 rootOrdinal = 0;
        rootOrdinal < rootCount;
        rootOrdinal = rootOrdinal + 1)
    {
        int32 rootOffset = rootOrdinal * 20;
        int32 inputOffset = rootOrdinal * 5;
        int32 importedOffset = rootOrdinal * 8;
        Host.StandaloneSourceImportedCallables[importedOffset]
            = int32(Host.StandaloneResolvedRoots[rootOffset + 1]);
        Host.StandaloneSourceImportedCallables[importedOffset + 1]
            = int32(Host.StandaloneResolvedRoots[rootOffset]);
        Host.StandaloneSourceImportedCallables[importedOffset + 2]
            = Host.StandaloneMethodRoots[inputOffset + 3];
        Host.StandaloneSourceImportedCallables[importedOffset + 3]
            = Host.StandaloneMethodRoots[inputOffset + 4];
        Host.StandaloneSourceImportedCallables[importedOffset + 4]
            = rootOrdinal;
        Host.StandaloneSourceImportedCallables[importedOffset + 5]
            = int32(Host.StandaloneResolvedRoots[rootOffset + 2]);
        Host.StandaloneSourceImportedCallables[importedOffset + 6]
            = int32(Host.StandaloneResolvedRoots[rootOffset + 3]);
        Host.StandaloneSourceImportedCallables[importedOffset + 7]
            = int32(Host.StandaloneResolvedRoots[rootOffset + 5]);
    }

    Host.StandaloneSourceImportedCallableCount[0] = rootCount;
    return 0;
}

int32 ResolveStandaloneCallTarget(int32 targetKind,
    int32 targetIndex, ref<init int32> expectedCallableIdResult)
    ensure return == 0 ? *expectedCallableIdResult is init : true
{
    if (targetKind == 1)
    {
        if (targetIndex < 0
            || targetIndex >= Host.StandaloneLocalCallableCount[0])
        {
            return 3;
        }
        *expectedCallableIdResult
            = Host.StandaloneLocalCallables[targetIndex * 3 + 1];
        return 0;
    }
    if (targetKind == 2)
    {
        if (targetIndex < 0
            || targetIndex
                >= Host.StandaloneSourceImportedCallableCount[0])
        {
            return 3;
        }
        *expectedCallableIdResult
            = Host.StandaloneSourceImportedCallables[
                targetIndex * 8 + 4];
        return 0;
    }
    return 3;
}

int32 InventoryStandaloneSourceFile(int32 tokenEnd, int32 usingModuleId)
{
    init int32 declarationStart;
    int32 usingStatus = ParseStandaloneSourceUsings(
        0, tokenEnd, -1, ref init declarationStart);
    if (usingStatus != 0)
    {
        return usingStatus;
    }

    if (declarationStart >= tokenEnd
        || Host.Tokens[declarationStart * 3] != 6)
    {
        init int32 afterDeclarations;
        int32 declarationStatus = InventoryStandaloneSourceDeclarations(
            declarationStart, tokenEnd, -1, usingModuleId, 0, true,
            ref init afterDeclarations);
        if (declarationStatus != 0
            || afterDeclarations != tokenEnd)
        {
            return declarationStatus != 0 ? declarationStatus : 1;
        }
        return 0;
    }

    init int32 namespaceNameEnd;
    int32 namespaceNameStatus = ParseStandaloneDottedIdentifier(
        declarationStart + 1, tokenEnd, ref init namespaceNameEnd);
    if (namespaceNameStatus != 0 || namespaceNameEnd >= tokenEnd)
    {
        return 1;
    }

    int32 namespaceDelimiter
        = Host.Tokens[namespaceNameEnd * 3];
    if (namespaceDelimiter == 52)
    {
        init int32 namespaceIdentity;
        int32 identityStatus = InternStandaloneNamespacePath(0,
            declarationStart + 1, namespaceNameEnd,
            ref init namespaceIdentity);
        if (identityStatus != 0)
        {
            return identityStatus;
        }

        init int32 namespaceScopeId;
        int32 scopeStatus = AppendStandaloneNamespaceScope(-1,
            namespaceIdentity, ref init namespaceScopeId);
        if (scopeStatus != 0)
        {
            return scopeStatus;
        }

        init int32 afterDeclarations;
        int32 declarationStatus = InventoryStandaloneSourceDeclarations(
            namespaceNameEnd + 1, tokenEnd, namespaceScopeId,
            usingModuleId, 1, false, ref init afterDeclarations);
        if (declarationStatus != 0
            || afterDeclarations != tokenEnd)
        {
            return declarationStatus != 0 ? declarationStatus : 1;
        }
        return 0;
    }

    if (namespaceDelimiter != 48)
    {
        return 1;
    }
    init int32 afterDeclarations;
    int32 declarationStatus = InventoryStandaloneSourceDeclarations(
        declarationStart, tokenEnd, -1, usingModuleId, 0, true,
        ref init afterDeclarations);
    if (declarationStatus != 0
        || afterDeclarations != tokenEnd)
    {
        return declarationStatus != 0 ? declarationStatus : 1;
    }
    return 0;
}

int32 InventoryStandaloneSourceDeclarations(int32 tokenStart,
    int32 tokenEnd, int32 namespaceScopeId, int32 usingModuleId,
    int32 namespaceDepth, bool allowNamespaceBlocks,
    ref<init int32> nextTokenResult)
    ensure return == 0 ? *nextTokenResult is init : true
{
    if (namespaceDepth < 0
        || namespaceDepth > Host.StandaloneSourceNamespaceDepthLimit[0])
    {
        return 2;
    }

    init int32 declarationStart;
    int32 usingStatus = ParseStandaloneSourceUsings(tokenStart,
        tokenEnd, namespaceScopeId, ref init declarationStart);
    if (usingStatus != 0)
    {
        return usingStatus;
    }

    int32 namespaceIdentityId
        = GetStandaloneNamespaceIdentity(namespaceScopeId);
    if (namespaceIdentityId < 0)
    {
        return 3;
    }
    mut int32 tokenIndex = declarationStart;
    while (tokenIndex < tokenEnd)
    {
        if (Host.Tokens[tokenIndex * 3] == 6)
        {
            if (!allowNamespaceBlocks)
            {
                return 1;
            }

            init int32 afterNamespace;
            int32 namespaceStatus
                = InventoryStandaloneSourceNamespaceBlock(tokenIndex,
                    tokenEnd, namespaceScopeId, usingModuleId,
                    namespaceDepth,
                    ref init afterNamespace);
            if (namespaceStatus != 0)
            {
                return namespaceStatus;
            }
            tokenIndex = afterNamespace;
            continue;
        }

        int32 localCallableId
            = Host.StandaloneLocalCallableCount[0];
        init int32 nextToken;
        int32 headerStatus = InventoryStandaloneSourceCallable(
            tokenIndex, tokenEnd, localCallableId, usingModuleId,
            namespaceScopeId, namespaceIdentityId,
            ref init nextToken);
        if (headerStatus != 0)
        {
            return headerStatus;
        }
        Host.StandaloneLocalCallableCount[0]
            = localCallableId + 1;
        tokenIndex = nextToken;
    }

    *nextTokenResult = tokenIndex;
    return 0;
}

int32 InventoryStandaloneSourceNamespaceBlock(int32 namespaceToken,
    int32 tokenEnd, int32 parentScopeId, int32 usingModuleId,
    int32 parentNamespaceDepth,
    ref<init int32> nextTokenResult)
    ensure return == 0 ? *nextTokenResult is init : true
{
    if (namespaceToken < 0 || namespaceToken >= tokenEnd
        || Host.Tokens[namespaceToken * 3] != 6)
    {
        return 1;
    }
    if (parentNamespaceDepth
        >= Host.StandaloneSourceNamespaceDepthLimit[0])
    {
        return 2;
    }

    int32 nameStart = namespaceToken + 1;
    init int32 nameEnd;
    if (ParseStandaloneDottedIdentifier(nameStart, tokenEnd,
            ref init nameEnd) != 0
        || nameEnd >= tokenEnd
        || Host.Tokens[nameEnd * 3] != 48)
    {
        return 1;
    }

    mut int32 nesting = 1;
    mut int32 scan = nameEnd + 1;
    while (scan < tokenEnd && nesting > 0)
    {
        int32 kind = Host.Tokens[scan * 3];
        if (kind == 48)
        {
            nesting = nesting + 1;
        }
        else if (kind == 49)
        {
            nesting = nesting - 1;
        }
        scan = scan + 1;
    }

    if (nesting != 0)
    {
        return 1;
    }
    int32 closeBrace = scan - 1;
    int32 parentIdentityId
        = GetStandaloneNamespaceIdentity(parentScopeId);
    if (parentIdentityId < 0)
    {
        return 3;
    }
    init int32 namespaceIdentity;
    int32 identityStatus = InternStandaloneNamespacePath(
        parentIdentityId, nameStart, nameEnd,
        ref init namespaceIdentity);
    if (identityStatus != 0)
    {
        return identityStatus;
    }
    init int32 namespaceScopeId;
    int32 scopeStatus = AppendStandaloneNamespaceScope(parentScopeId,
        namespaceIdentity, ref init namespaceScopeId);
    if (scopeStatus != 0)
    {
        return scopeStatus;
    }

    init int32 afterBody;
    int32 bodyStatus = InventoryStandaloneSourceDeclarations(
        nameEnd + 1, closeBrace, namespaceScopeId, usingModuleId,
        parentNamespaceDepth + 1, true, ref init afterBody);
    if (bodyStatus != 0 || afterBody != closeBrace)
    {
        return bodyStatus != 0 ? bodyStatus : 1;
    }

    *nextTokenResult = closeBrace + 1;
    return 0;
}

int32 ParseStandaloneSourceUsings(int32 tokenStart, int32 tokenEnd,
    int32 namespaceScopeId, ref<init int32> tokenIndexResult)
    ensure return == 0 ? *tokenIndexResult is init : true
{
    mut int32 tokenIndex = tokenStart;
    while (tokenIndex < tokenEnd
        && Host.Tokens[tokenIndex * 3] == 5)
    {
        int32 usingStart = tokenIndex + 1;
        init int32 pathEnd;
        if (ParseStandaloneDottedIdentifier(usingStart, tokenEnd,
                ref init pathEnd) != 0
            || pathEnd >= tokenEnd
            || Host.Tokens[pathEnd * 3] != 52
            || Host.StandaloneSourceUsingCount[0]
                >= Host.StandaloneSourceUsings.Length / 3)
        {
            return 1;
        }

        int32 usingOffset
            = Host.StandaloneSourceUsingCount[0] * 3;
        Host.StandaloneSourceUsings[usingOffset] = usingStart;
        Host.StandaloneSourceUsings[usingOffset + 1] = pathEnd;
        Host.StandaloneSourceUsings[usingOffset + 2]
            = namespaceScopeId;
        Host.StandaloneSourceUsingCount[0]
            = Host.StandaloneSourceUsingCount[0] + 1;
        tokenIndex = pathEnd + 1;
    }
    *tokenIndexResult = tokenIndex;
    return 0;
}

int32 ParseStandaloneDottedIdentifier(int32 tokenStart,
    int32 tokenEnd, ref<init int32> tokenIndexResult)
    ensure return == 0 ? *tokenIndexResult is init : true
{
    if (tokenStart < 0 || tokenStart >= tokenEnd
        || Host.Tokens[tokenStart * 3] != 2)
    {
        return 1;
    }
    mut int32 tokenIndex = tokenStart + 1;
    while (tokenIndex < tokenEnd
        && Host.Tokens[tokenIndex * 3] == 54)
    {
        tokenIndex = tokenIndex + 1;
        if (tokenIndex >= tokenEnd
            || Host.Tokens[tokenIndex * 3] != 2)
        {
            return 1;
        }
        tokenIndex = tokenIndex + 1;
    }
    *tokenIndexResult = tokenIndex;
    return 0;
}

int32 AppendStandaloneNamespaceScope(int32 parentScopeId,
    int32 namespaceIdentityId,
    ref<init int32> scopeIdResult)
    ensure return == 0 ? *scopeIdResult is init : true
{
    int32 count = Host.StandaloneSourceNamespaceScopeCount[0];
    if (count < 0
        || count >= Host.StandaloneSourceNamespaceScopes.Length / 2
        || parentScopeId < -1
        || parentScopeId >= count
        || namespaceIdentityId < 0
        || namespaceIdentityId
            > Host.StandaloneSourceNamespaceIdentityCount[0])
    {
        return 3;
    }
    int32 scopeOffset = count * 2;
    Host.StandaloneSourceNamespaceScopes[scopeOffset] = parentScopeId;
    Host.StandaloneSourceNamespaceScopes[scopeOffset + 1]
        = namespaceIdentityId;
    Host.StandaloneSourceNamespaceScopeCount[0] = count + 1;
    *scopeIdResult = count;
    return 0;
}

int32 GetStandaloneNamespaceIdentity(int32 scopeId)
{
    if (scopeId == -1)
    {
        return 0;
    }
    if (scopeId < 0
        || scopeId >= Host.StandaloneSourceNamespaceScopeCount[0])
    {
        return -1;
    }
    return Host.StandaloneSourceNamespaceScopes[scopeId * 2 + 1];
}

int32 GetStandaloneNamespaceParentIdentity(int32 identityId)
{
    if (identityId == 0)
    {
        return -1;
    }
    if (identityId < 0
        || identityId
            > Host.StandaloneSourceNamespaceIdentityCount[0])
    {
        return -1;
    }
    return Host.StandaloneSourceNamespaceIdentityNodes[
        (identityId - 1) * 3];
}

int32 GetStandaloneNamespaceParentScope(int32 scopeId)
{
    if (scopeId < 0
        || scopeId >= Host.StandaloneSourceNamespaceScopeCount[0])
    {
        return -1;
    }
    return Host.StandaloneSourceNamespaceScopes[scopeId * 2];
}

int32 FindStandaloneNamespaceScopeForIdentity(int32 currentScopeId,
    int32 namespaceIdentityId)
{
    mut int32 scopeId = currentScopeId;
    while (scopeId >= 0)
    {
        if (scopeId
                >= Host.StandaloneSourceNamespaceScopeCount[0])
        {
            return -2;
        }
        if (GetStandaloneNamespaceIdentity(scopeId)
            == namespaceIdentityId)
        {
            return scopeId;
        }
        scopeId = GetStandaloneNamespaceParentScope(scopeId);
    }
    return namespaceIdentityId == 0 ? -1 : -2;
}

int32 GetStandaloneNamespaceSegmentHash(int32 parentIdentityId,
    int32 tokenIndex, ref<init int32> hashResult)
    ensure return == 0 ? *hashResult is init : true
{
    init int32 kind;
    init int32 tokenStart;
    init int32 tokenLength;
    if (parentIdentityId < 0
        || parentIdentityId
            > Host.StandaloneSourceNamespaceIdentityCount[0]
        || !TryReadStandaloneSourceToken(tokenIndex,
            ref init kind, ref init tokenStart,
            ref init tokenLength)
        || kind != 2)
    {
        return 1;
    }
    if (tokenLength > 0
        && Host.Source[tokenStart] == char16(64))
    {
        tokenStart = tokenStart + 1;
        tokenLength = tokenLength - 1;
    }
    if (tokenLength <= 0)
    {
        return 1;
    }

    mut int32 hash
        = ((parentIdentityId % 65521) * 31 + 1) % 65521;
    for (mut int32 index = 0;
        index < tokenLength;
        index = index + 1)
    {
        hash = (hash * 31
            + int32(Host.Source[tokenStart + index])) % 65521;
    }
    *hashResult = hash;
    return 0;
}

int32 InternStandaloneNamespaceSegment(int32 parentIdentityId,
    int32 tokenIndex, ref<init int32> identityResult)
    ensure return == 0 ? *identityResult is init : true
{
    init int32 hash;
    if (GetStandaloneNamespaceSegmentHash(parentIdentityId,
            tokenIndex, ref init hash) != 0
        || Host.StandaloneSourceNamespaceIdentitySlots.Length == 0)
    {
        return 1;
    }

    int32 slotCount
        = Host.StandaloneSourceNamespaceIdentitySlots.Length;
    mut int32 slot = hash % slotCount;
    mut int32 probes = 0;
    while (probes < slotCount)
    {
        int32 existingIdentity
            = Host.StandaloneSourceNamespaceIdentitySlots[slot];
        if (existingIdentity == 0)
        {
            break;
        }
        int32 nodeOffset = (existingIdentity - 1) * 3;
        if (Host.StandaloneSourceNamespaceIdentityNodes[
                nodeOffset] == parentIdentityId
            && IsStandaloneSourceName(tokenIndex,
                Host.StandaloneSourceNamespaceIdentityNodes[
                    nodeOffset + 1],
                Host.StandaloneSourceNamespaceIdentityNodes[
                    nodeOffset + 2]))
        {
            *identityResult = existingIdentity;
            return 0;
        }
        slot = slot + 1;
        if (slot == slotCount)
        {
            slot = 0;
        }
        probes = probes + 1;
    }
    if (probes >= slotCount)
    {
        return 3;
    }

    int32 identityCount
        = Host.StandaloneSourceNamespaceIdentityCount[0];
    if (identityCount
        >= Host.StandaloneSourceNamespaceIdentityNodes.Length / 3)
    {
        return 3;
    }
    init int32 kind;
    init int32 tokenStart;
    init int32 tokenLength;
    if (!TryReadStandaloneSourceToken(tokenIndex,
            ref init kind, ref init tokenStart,
            ref init tokenLength))
    {
        return 1;
    }
    int32 identity = identityCount + 1;
    int32 nodeOffset = (identity - 1) * 3;
    Host.StandaloneSourceNamespaceIdentityNodes[nodeOffset]
        = parentIdentityId;
    Host.StandaloneSourceNamespaceIdentityNodes[nodeOffset + 1]
        = tokenStart;
    Host.StandaloneSourceNamespaceIdentityNodes[nodeOffset + 2]
        = tokenLength;
    Host.StandaloneSourceNamespaceIdentitySlots[slot] = identity;
    Host.StandaloneSourceNamespaceIdentityCount[0] = identity;
    *identityResult = identity;
    return 0;
}

bool TryFindStandaloneNamespaceIdentity(int32 parentIdentityId,
    int32 tokenIndex, ref<init int32> identityResult)
    ensure return ? *identityResult is init : true
{
    init int32 hash;
    if (GetStandaloneNamespaceSegmentHash(parentIdentityId,
            tokenIndex, ref init hash) != 0
        || Host.StandaloneSourceNamespaceIdentitySlots.Length == 0)
    {
        return false;
    }

    int32 slotCount
        = Host.StandaloneSourceNamespaceIdentitySlots.Length;
    mut int32 slot = hash % slotCount;
    for (mut int32 probes = 0;
        probes < slotCount;
        probes = probes + 1)
    {
        int32 existingIdentity
            = Host.StandaloneSourceNamespaceIdentitySlots[slot];
        if (existingIdentity == 0)
        {
            return false;
        }
        int32 nodeOffset = (existingIdentity - 1) * 3;
        if (Host.StandaloneSourceNamespaceIdentityNodes[
                nodeOffset] == parentIdentityId
            && IsStandaloneSourceName(tokenIndex,
                Host.StandaloneSourceNamespaceIdentityNodes[
                    nodeOffset + 1],
                Host.StandaloneSourceNamespaceIdentityNodes[
                    nodeOffset + 2]))
        {
            *identityResult = existingIdentity;
            return true;
        }
        slot = slot + 1;
        if (slot == slotCount)
        {
            slot = 0;
        }
    }
    return false;
}

int32 InternStandaloneNamespacePath(int32 parentIdentityId,
    int32 tokenStart, int32 tokenEnd,
    ref<init int32> identityResult)
    ensure return == 0 ? *identityResult is init : true
{
    mut int32 identity = parentIdentityId;
    mut int32 tokenIndex = tokenStart;
    while (tokenIndex < tokenEnd)
    {
        init int32 nextIdentity;
        int32 status = InternStandaloneNamespaceSegment(identity,
            tokenIndex, ref init nextIdentity);
        if (status != 0)
        {
            return status;
        }
        identity = nextIdentity;
        tokenIndex = tokenIndex + 1;
        if (tokenIndex < tokenEnd)
        {
            if (Host.Tokens[tokenIndex * 3] != 54)
            {
                return 1;
            }
            tokenIndex = tokenIndex + 1;
        }
    }
    if (tokenStart >= tokenEnd)
    {
        return 1;
    }
    *identityResult = identity;
    return 0;
}

bool TryReadStandaloneSourceToken(int32 tokenIndex,
    ref<init int32> kindResult, ref<init int32> startResult,
    ref<init int32> lengthResult)
    ensure return ? (*kindResult is init && *startResult is init
        && *lengthResult is init) : true
{
    if (tokenIndex < 0 || tokenIndex >= Host.Tokens.Length / 3)
    {
        return false;
    }
    int32 offset = tokenIndex * 3;
    int32 kind = Host.Tokens[offset];
    int32 start = Host.Tokens[offset + 1];
    int32 length = Host.Tokens[offset + 2];
    init SourceRange range;
    if (!SourceRange.TryCreate(start, length, ref init range)
        || start > Host.Source.Length
        || length > Host.Source.Length - start)
    {
        return false;
    }
    *kindResult = kind;
    *startResult = start;
    *lengthResult = length;
    return true;
}

bool IsStandaloneSourceInitKeyword(int32 tokenIndex)
{
    init int32 kind;
    init int32 start;
    init int32 length;
    return TryReadStandaloneSourceToken(tokenIndex,
            ref init kind, ref init start, ref init length)
        && kind == 2 && length == 4
        && Host.Source[start] == char16(105)
        && Host.Source[start + 1] == char16(110)
        && Host.Source[start + 2] == char16(105)
        && Host.Source[start + 3] == char16(116);
}

bool IsStandaloneSourceName(int32 tokenIndex, int32 spellingStart,
    int32 spellingLength)
{
    init int32 kind;
    init int32 tokenStart;
    init int32 tokenLength;
    if (!TryReadStandaloneSourceToken(tokenIndex,
            ref init kind, ref init tokenStart,
            ref init tokenLength)
        || kind != 2 || spellingStart < 0 || spellingLength < 0
        || spellingStart > Host.Source.Length
        || spellingLength > Host.Source.Length - spellingStart)
    {
        return false;
    }

    if (tokenLength > 0 && Host.Source[tokenStart] == char16(64))
    {
        tokenStart = tokenStart + 1;
        tokenLength = tokenLength - 1;
    }
    if (spellingLength > 0
        && Host.Source[spellingStart] == char16(64))
    {
        spellingStart = spellingStart + 1;
        spellingLength = spellingLength - 1;
    }
    if (tokenLength != spellingLength)
    {
        return false;
    }
    for (mut int32 index = 0; index < tokenLength;
        index = index + 1)
    {
        if (Host.Source[tokenStart + index]
            != Host.Source[spellingStart + index])
        {
            return false;
        }
    }
    return tokenLength > 0;
}

int32 MapStandaloneSourceScalarType(int32 sourceTypeCode)
{
    if (sourceTypeCode == 1) { return 0x08; }
    if (sourceTypeCode == 2) { return 0x0D; }
    if (sourceTypeCode == 3) { return 0x09; }
    if (sourceTypeCode == 4) { return 0x0E; }
    if (sourceTypeCode == 5) { return 0x01; }
    if (sourceTypeCode == 6) { return 0x03; }
    if (sourceTypeCode == 7) { return 0x14; }
    if (sourceTypeCode == 8) { return 0x15; }
    return -1;
}

int32 InternStandaloneSourcePrimitiveTypeFacts()
{
    if (Host.Tokens.Length % 3 != 0)
    {
        return 3;
    }

    int32 tokenCount = Host.Tokens.Length / 3;
    mut bool needsBooleanType = false;
    mut bool needsUnitType = false;
    for (mut int32 tokenIndex = 0;
        tokenIndex < tokenCount;
        tokenIndex = tokenIndex + 1)
    {
        int32 tokenOffset = tokenIndex * 3;
        int32 tokenKind = Host.Tokens[tokenOffset];
        if (tokenKind == 20 || tokenKind == 21
            || (tokenKind >= 65 && tokenKind <= 70))
        {
            needsBooleanType = true;
        }
        if (tokenKind == 46 && tokenIndex + 1 < tokenCount
            && Host.Tokens[(tokenIndex + 1) * 3] == 47
            && (tokenIndex == 0
                || Host.Tokens[(tokenIndex - 1) * 3] != 2))
        {
            needsUnitType = true;
        }
        if (tokenKind != 2)
        {
            continue;
        }

        int32 tokenStart = Host.Tokens[tokenOffset + 1];
        int32 tokenLength = Host.Tokens[tokenOffset + 2];
        if (tokenStart < 0 || tokenLength <= 0
            || tokenStart > Host.Source.Length - tokenLength)
        {
            return 3;
        }
        int32 sourceTypeCode
            = GetStandaloneSourcePrimitiveType(
                tokenStart, tokenLength);
        int32 metadataTypeCode
            = MapStandaloneSourceScalarType(sourceTypeCode);
        if (metadataTypeCode < 0)
        {
            continue;
        }
        if (metadataTypeCode == 1)
        {
            needsBooleanType = true;
        }

        init int32 typeId;
        int32 status = InternStandaloneCallableTypeFact(
            0, metadataTypeCode, false, ref init typeId);
        if (status != 0)
        {
            return status;
        }
    }
    if (needsBooleanType)
    {
        init int32 boolTypeId;
        int32 boolTypeStatus = InternStandaloneCallableTypeFact(
            0, 1, false, ref init boolTypeId);
        if (boolTypeStatus != 0)
        {
            return boolTypeStatus;
        }
    }
    if (needsUnitType)
    {
        init int32 unitTypeId;
        int32 unitTypeStatus = InternStandaloneCallableTypeFact(
            0, 0, false, ref init unitTypeId);
        if (unitTypeStatus != 0)
        {
            return unitTypeStatus;
        }
    }
    return 0;
}

int32 GetStandaloneSourcePrimitiveType(int32 start, int32 length)
{
    if (length == 4 && Host.Source[start] == char16(98)
        && Host.Source[start + 1] == char16(111)
        && Host.Source[start + 2] == char16(111)
        && Host.Source[start + 3] == char16(108))
    {
        return 5;
    }
    if (length == 5 && Host.Source[start] == char16(105)
        && Host.Source[start + 1] == char16(110)
        && Host.Source[start + 2] == char16(116))
    {
        if (Host.Source[start + 3] == char16(51)
            && Host.Source[start + 4] == char16(50))
        {
            return 1;
        }
        if (Host.Source[start + 3] == char16(54)
            && Host.Source[start + 4] == char16(52))
        {
            return 3;
        }
    }
    if (length == 6 && Host.Source[start] == char16(117)
        && Host.Source[start + 1] == char16(105)
        && Host.Source[start + 2] == char16(110)
        && Host.Source[start + 3] == char16(116))
    {
        if (Host.Source[start + 4] == char16(51)
            && Host.Source[start + 5] == char16(50))
        {
            return 2;
        }
        if (Host.Source[start + 4] == char16(54)
            && Host.Source[start + 5] == char16(52))
        {
            return 4;
        }
    }
    if (length == 6 && Host.Source[start] == char16(99)
        && Host.Source[start + 1] == char16(104)
        && Host.Source[start + 2] == char16(97)
        && Host.Source[start + 3] == char16(114)
        && Host.Source[start + 4] == char16(49)
        && Host.Source[start + 5] == char16(54))
    {
        return 6;
    }
    if (length == 7 && Host.Source[start] == char16(102)
        && Host.Source[start + 1] == char16(108)
        && Host.Source[start + 2] == char16(111)
        && Host.Source[start + 3] == char16(97)
        && Host.Source[start + 4] == char16(116))
    {
        if (Host.Source[start + 5] == char16(51)
            && Host.Source[start + 6] == char16(50))
        {
            return 7;
        }
        if (Host.Source[start + 5] == char16(54)
            && Host.Source[start + 6] == char16(52))
        {
            return 8;
        }
    }
    return -1;
}

int32 ParseStandaloneSourceType(int32 tokenIndex, bool allowUnit,
    bool allowInitReference, ref<init int32> nextTokenResult,
    ref<init int32> typeIdResult)
    ensure return == 0 ? (*nextTokenResult is init
        && *typeIdResult is init) : true
{
    init int32 kind;
    init int32 start;
    init int32 length;
    if (!TryReadStandaloneSourceToken(tokenIndex,
            ref init kind, ref init start, ref init length))
    {
        return 1;
    }

    mut int32 typeTokenIndex = tokenIndex;
    mut int32 nextToken = tokenIndex + 1;
    mut int32 typeKind = 0;
    mut bool writable = false;
    if (kind == 14)
    {
        if (!allowInitReference)
        {
            return 2;
        }
        init int32 lessKind;
        init int32 lessStart;
        init int32 lessLength;
        if (!TryReadStandaloneSourceToken(tokenIndex + 1,
                ref init lessKind, ref init lessStart,
                ref init lessLength)
            || lessKind != 67
            || !IsStandaloneSourceInitKeyword(tokenIndex + 2))
        {
            return 1;
        }
        typeTokenIndex = tokenIndex + 3;
        typeKind = 1;
        writable = true;
    }
    else if (kind == 11)
    {
        if (!allowUnit)
        {
            return 2;
        }
        init int32 typeId;
        int32 internStatus = InternStandaloneCallableTypeFact(
            0, 0, false, ref init typeId);
        if (internStatus != 0)
        {
            return internStatus;
        }
        *nextTokenResult = nextToken;
        *typeIdResult = typeId;
        return 0;
    }
    else if (kind != 2)
    {
        return 1;
    }

    init int32 typeNameKind;
    init int32 typeNameStart;
    init int32 typeNameLength;
    if (!TryReadStandaloneSourceToken(typeTokenIndex,
            ref init typeNameKind, ref init typeNameStart,
            ref init typeNameLength)
        || typeNameKind != 2)
    {
        return 1;
    }
    int32 sourceTypeCode
        = GetStandaloneSourcePrimitiveType(typeNameStart,
            typeNameLength);
    int32 metadataTypeCode
        = MapStandaloneSourceScalarType(sourceTypeCode);
    if (metadataTypeCode < 0)
    {
        return 2;
    }

    if (typeKind == 1)
    {
        init int32 greaterKind;
        init int32 greaterStart;
        init int32 greaterLength;
        int32 greaterIndex = typeTokenIndex + 1;
        if (!TryReadStandaloneSourceToken(greaterIndex,
                ref init greaterKind, ref init greaterStart,
                ref init greaterLength)
            || greaterKind != 69)
        {
            return 1;
        }
        nextToken = greaterIndex + 1;
    }
    init int32 typeIdResultValue;
    int32 typeInternStatus = InternStandaloneCallableTypeFact(
        typeKind, metadataTypeCode, writable,
        ref init typeIdResultValue);
    if (typeInternStatus != 0)
    {
        return typeInternStatus;
    }
    *nextTokenResult = nextToken;
    *typeIdResult = typeIdResultValue;
    return 0;
}

int32 InventoryStandaloneSourceCallable(int32 tokenStart,
    int32 tokenEnd, int32 localCallableId, int32 usingModuleId,
    int32 namespaceScopeId, int32 namespaceIdentityId,
    ref<init int32> nextTokenResult)
    ensure return == 0 ? *nextTokenResult is init : true
{
    if (localCallableId < 0
        || localCallableId
            >= Host.StandaloneSourceCallableInfo.Length / 12
        || localCallableId
            >= Host.StandaloneLocalCallables.Length / 3)
    {
        return 3;
    }

    mut int32 tokenIndex = tokenStart;
    mut int32 flags = 0;
    mut bool visibilitySeen = false;
    mut bool unsafeSeen = false;
    while (tokenIndex < tokenEnd)
    {
        int32 kind = Host.Tokens[tokenIndex * 3];
        if (kind == 7 || kind == 8)
        {
            if (visibilitySeen)
            {
                return 1;
            }
            visibilitySeen = true;
            if (kind == 7) { flags = flags | 1; }
            tokenIndex = tokenIndex + 1;
            continue;
        }
        if (kind == 76)
        {
            if (unsafeSeen)
            {
                return 1;
            }
            unsafeSeen = true;
            flags = flags | 2;
            tokenIndex = tokenIndex + 1;
            continue;
        }
        break;
    }

    init int32 afterReturnType;
    init int32 returnTypeId;
    int32 returnTypeStatus = ParseStandaloneSourceType(
        tokenIndex, true, false, ref init afterReturnType,
        ref init returnTypeId);
    if (returnTypeStatus != 0)
    {
        return returnTypeStatus;
    }
    tokenIndex = afterReturnType;
    init int32 nameKind;
    init int32 nameStart;
    init int32 nameLength;
    if (!TryReadStandaloneSourceToken(tokenIndex,
            ref init nameKind, ref init nameStart,
            ref init nameLength)
        || nameKind != 2 || nameLength <= 0)
    {
        return 1;
    }
    tokenIndex = tokenIndex + 1;
    if (tokenIndex >= tokenEnd || Host.Tokens[tokenIndex * 3] != 46)
    {
        return 1;
    }
    tokenIndex = tokenIndex + 1;

    mut int32 parameterFirst
        = Host.StandaloneSourceParameterCount[0];
    mut int32 parameterCount = 0;
    if (tokenIndex >= tokenEnd)
    {
        return 1;
    }
    if (Host.Tokens[tokenIndex * 3] != 47)
    {
        while (true)
        {
            init int32 parameterTypeId;
            init int32 afterParameterType;
            int32 parameterTypeStatus = ParseStandaloneSourceType(
                tokenIndex, true, true, ref init afterParameterType,
                ref init parameterTypeId);
            if (parameterTypeStatus != 0)
            {
                return parameterTypeStatus;
            }
            tokenIndex = afterParameterType;
            init int32 parameterNameKind;
            init int32 parameterNameStart;
            init int32 parameterNameLength;
            if (!TryReadStandaloneSourceToken(tokenIndex,
                    ref init parameterNameKind,
                    ref init parameterNameStart,
                    ref init parameterNameLength)
                || parameterNameKind != 2
                || parameterNameLength <= 0
                || Host.StandaloneSourceParameterCount[0]
                    >= Host.StandaloneSourceParameters.Length / 4)
            {
                return 1;
            }

            for (mut int32 prior = 0;
                prior < parameterCount;
                prior = prior + 1)
            {
                int32 priorOffset = (parameterFirst + prior) * 4;
                if (IsStandaloneSourceName(tokenIndex,
                        Host.StandaloneSourceParameters[
                            priorOffset + 2],
                        Host.StandaloneSourceParameters[
                            priorOffset + 3]))
                {
                    return 1;
                }
            }

            int32 parameterRow
                = Host.StandaloneSourceParameterCount[0];
            int32 parameterOffset = parameterRow * 4;
            Host.StandaloneSourceParameters[parameterOffset]
                = localCallableId;
            Host.StandaloneSourceParameters[parameterOffset + 1]
                = parameterTypeId;
            Host.StandaloneSourceParameters[parameterOffset + 2]
                = parameterNameStart;
            Host.StandaloneSourceParameters[parameterOffset + 3]
                = parameterNameLength;
            Host.StandaloneSourceParameterCount[0] = parameterRow + 1;
            parameterCount = parameterCount + 1;
            tokenIndex = tokenIndex + 1;
            if (tokenIndex >= tokenEnd)
            {
                return 1;
            }
            if (Host.Tokens[tokenIndex * 3] != 53)
            {
                break;
            }
            tokenIndex = tokenIndex + 1;
        }
    }
    if (tokenIndex >= tokenEnd || Host.Tokens[tokenIndex * 3] != 47)
    {
        return 1;
    }
    tokenIndex = tokenIndex + 1;
    if (tokenIndex >= tokenEnd || Host.Tokens[tokenIndex * 3] != 48)
    {
        return 2;
    }

    int32 bodyOpen = tokenIndex;
    mut int32 depth = 1;
    tokenIndex = tokenIndex + 1;
    while (tokenIndex < tokenEnd && depth > 0)
    {
        int32 kind = Host.Tokens[tokenIndex * 3];
        if (kind == 48) { depth = depth + 1; }
        else if (kind == 49) { depth = depth - 1; }
        tokenIndex = tokenIndex + 1;
    }
    if (depth != 0)
    {
        return 1;
    }
    int32 bodyClose = tokenIndex - 1;

    int32 infoOffset = localCallableId * 12;
    Host.StandaloneSourceCallableInfo[infoOffset]
        = nameStart;
    Host.StandaloneSourceCallableInfo[infoOffset + 1]
        = nameLength;
    Host.StandaloneSourceCallableInfo[infoOffset + 2]
        = namespaceScopeId;
    Host.StandaloneSourceCallableInfo[infoOffset + 3]
        = namespaceIdentityId;
    Host.StandaloneSourceCallableInfo[infoOffset + 4]
        = returnTypeId;
    Host.StandaloneSourceCallableInfo[infoOffset + 5]
        = parameterFirst;
    Host.StandaloneSourceCallableInfo[infoOffset + 6]
        = parameterCount;
    Host.StandaloneSourceCallableInfo[infoOffset + 7]
        = localCallableId;
    Host.StandaloneSourceCallableInfo[infoOffset + 8]
        = bodyOpen + 1;
    Host.StandaloneSourceCallableInfo[infoOffset + 9]
        = bodyClose;
    Host.StandaloneSourceCallableInfo[infoOffset + 10] = flags;
    Host.StandaloneSourceCallableInfo[infoOffset + 11]
        = Host.StandaloneResolvedRootCount[0]
            + Host.StandaloneResolvedImports.Length / 32
            + Host.StandaloneResolvedProviderGroupCount[0]
            + localCallableId;

    int32 callableId
        = Host.StandaloneSourceCallableInfo[infoOffset + 11];
    if (callableId < 0
        || callableId >= Host.StandaloneCallableTypeIds.Length)
    {
        return 3;
    }
    Host.StandaloneCallableTypeIds[callableId] = returnTypeId;
    Host.StandaloneCallableEffects[callableId]
        = (flags & 2) != 0 ? 4 : 0;

    int32 callableOffset = localCallableId * 3;
    Host.StandaloneLocalCallables[callableOffset] = usingModuleId;
    Host.StandaloneLocalCallables[callableOffset + 1]
        = Host.StandaloneSourceCallableInfo[infoOffset + 11];
    Host.StandaloneLocalCallables[callableOffset + 2]
        = localCallableId;
    Host.StandaloneSourceBodyCount[0] = localCallableId + 1;
    *nextTokenResult = tokenIndex;
    return 0;
}

int32 TryGetStandaloneSourceExpressionDoesNotReturn(int32 bodyId,
    int32 expressionId, ref<init bool> doesNotReturnResult)
    ensure return == 0 ? *doesNotReturnResult is init : true
{
    if (bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0]
        || expressionId < 0)
    {
        return 3;
    }

    int32 bodyOffset = bodyId * 12;
    int32 expressionFirst
        = Host.StandaloneSourceBodies[bodyOffset + 3];
    int32 expressionIndex = expressionFirst + expressionId;
    if (expressionIndex < expressionFirst
        || expressionIndex >= Host.StandaloneSourceExpressionCount[0]
        || Host.StandaloneSourceExpressions[
            expressionIndex * 8 + 7] != bodyId)
    {
        return 3;
    }
    int32 expressionKind
        = Host.StandaloneSourceExpressions[expressionIndex * 8];
    if (expressionKind == 34)
    {
        int32 conditionExpressionId
            = Host.StandaloneSourceExpressions[
                expressionIndex * 8 + 2];
        int32 trueExpressionId
            = Host.StandaloneSourceExpressions[
                expressionIndex * 8 + 3];
        int32 falseExpressionId
            = Host.StandaloneSourceExpressions[
                expressionIndex * 8 + 4];
        init bool conditionDoesNotReturn;
        int32 conditionStatus
            = TryGetStandaloneSourceExpressionDoesNotReturn(
                bodyId, conditionExpressionId,
                ref init conditionDoesNotReturn);
        if (conditionStatus != 0)
        {
            return conditionStatus;
        }
        if (conditionDoesNotReturn)
        {
            *doesNotReturnResult = true;
            return 0;
        }
        init bool trueDoesNotReturn;
        int32 trueStatus
            = TryGetStandaloneSourceExpressionDoesNotReturn(
                bodyId, trueExpressionId,
                ref init trueDoesNotReturn);
        if (trueStatus != 0)
        {
            return trueStatus;
        }
        init bool falseDoesNotReturn;
        int32 falseStatus
            = TryGetStandaloneSourceExpressionDoesNotReturn(
                bodyId, falseExpressionId,
                ref init falseDoesNotReturn);
        if (falseStatus != 0)
        {
            return falseStatus;
        }
        *doesNotReturnResult
            = trueDoesNotReturn && falseDoesNotReturn;
        return 0;
    }
    if (expressionKind == 35 || expressionKind == 36)
    {
        int32 leftExpressionId
            = Host.StandaloneSourceExpressions[
                expressionIndex * 8 + 2];
        return TryGetStandaloneSourceExpressionDoesNotReturn(
            bodyId, leftExpressionId,
            ref init *doesNotReturnResult);
    }
    if (expressionKind == 12 || expressionKind == 13
        || expressionKind == 14 || expressionKind == 15
        || expressionKind == 16 || expressionKind == 17
        || expressionKind == 18 || expressionKind == 19
        || expressionKind == 20 || expressionKind == 21
        || expressionKind == 22 || expressionKind == 23
        || expressionKind == 24 || expressionKind == 25
        || (expressionKind >= 31 && expressionKind <= 33)
        || expressionKind == 35 || expressionKind == 36)
    {
        int32 leftExpressionId
            = Host.StandaloneSourceExpressions[
                expressionIndex * 8 + 2];
        int32 rightExpressionId
            = Host.StandaloneSourceExpressions[
                expressionIndex * 8 + 3];
        if (leftExpressionId < 0
            || leftExpressionId >= expressionId
            || rightExpressionId < 0
            || rightExpressionId >= expressionId)
        {
            return 3;
        }
        int32 leftStatus
            = TryGetStandaloneSourceExpressionDoesNotReturn(
                bodyId, leftExpressionId,
                ref init *doesNotReturnResult);
        if (leftStatus != 0)
        {
            return leftStatus;
        }
        if (*doesNotReturnResult)
        {
            return 0;
        }
        return TryGetStandaloneSourceExpressionDoesNotReturn(
            bodyId, rightExpressionId,
            ref init *doesNotReturnResult);
    }
    if (expressionKind == 6 || expressionKind == 8
        || expressionKind == 9 || expressionKind == 10
        || expressionKind == 11
        || (expressionKind >= 27 && expressionKind <= 30))
    {
        int32 childExpressionId
            = Host.StandaloneSourceExpressions[
                expressionIndex * 8 + 2];
        if (childExpressionId < 0
            || childExpressionId >= expressionId)
        {
            return 3;
        }
        return TryGetStandaloneSourceExpressionDoesNotReturn(
            bodyId, childExpressionId,
            ref init *doesNotReturnResult);
    }
    if (expressionKind != 3)
    {
        *doesNotReturnResult = false;
        return 0;
    }

    int32 bodyCallFirst
        = Host.StandaloneSourceBodies[bodyOffset + 5];
    int32 callLocalIndex
        = Host.StandaloneSourceExpressions[expressionIndex * 8 + 2];
    if (callLocalIndex < 0
        || bodyCallFirst < 0
        || bodyCallFirst > Host.StandaloneSourceDirectCallCount[0]
        || callLocalIndex
            >= Host.StandaloneSourceDirectCallCount[0] - bodyCallFirst)
    {
        return 3;
    }
    int32 expectedCallableId
        = Host.StandaloneSourceDirectCalls[
            (bodyCallFirst + callLocalIndex) * 7 + 2];
    if (expectedCallableId < 0
        || expectedCallableId >= Host.StandaloneCallableEffects.Length)
    {
        return 3;
    }
    *doesNotReturnResult
        = (Host.StandaloneCallableEffects[expectedCallableId] & 2) != 0;
    return 0;
}

int32 AppendStandaloneSourceLexicalScope(int32 bodyId,
    bool unsafeContext, ref<init int32> scopeIdResult)
    ensure return == 0 ? *scopeIdResult is init : true
{
    int32 count = Host.StandaloneSourceLexicalScopeCount[0];
    if (bodyId < 0 || bodyId >= Host.StandaloneSourceBodyCount[0]
        || count < 0
        || count >= Host.StandaloneSourceLexicalScopes.Length / 5)
    {
        return 3;
    }

    int32 scopeOffset = count * 5;
    Host.StandaloneSourceLexicalScopes[scopeOffset] = -1;
    Host.StandaloneSourceLexicalScopes[scopeOffset + 1] = bodyId;
    Host.StandaloneSourceLexicalScopes[scopeOffset + 2]
        = Host.StandaloneSourceLocalCount[0];
    Host.StandaloneSourceLexicalScopes[scopeOffset + 3] = 0;
    Host.StandaloneSourceLexicalScopes[scopeOffset + 4]
        = unsafeContext ? 1 : 0;
    Host.StandaloneSourceLexicalScopeCount[0] = count + 1;
    Host.StandaloneSourceBodyScopeIds[bodyId] = count;
    *scopeIdResult = count;
    return 0;
}

int32 FindStandaloneLocalInitializerEnd(int32 tokenStart,
    int32 tokenEnd, ref<init int32> semicolonResult)
    ensure return == 0 ? *semicolonResult is init : true
{
    if (tokenStart < 0 || tokenStart >= tokenEnd
        || tokenEnd > Host.Tokens.Length / 3)
    {
        return 3;
    }

    mut int32 parenthesisDepth = 0;
    for (mut int32 tokenIndex = tokenStart;
        tokenIndex < tokenEnd;
        tokenIndex = tokenIndex + 1)
    {
        int32 kind = Host.Tokens[tokenIndex * 3];
        if (kind == 46)
        {
            parenthesisDepth = parenthesisDepth + 1;
        }
        else if (kind == 47)
        {
            if (parenthesisDepth == 0)
            {
                return 1;
            }
            parenthesisDepth = parenthesisDepth - 1;
        }
        else if (kind == 52 && parenthesisDepth == 0)
        {
            *semicolonResult = tokenIndex;
            return 0;
        }
        else if ((kind == 48 || kind == 49)
            && parenthesisDepth == 0)
        {
            return 2;
        }
    }
    return 1;
}

int32 AppendStandaloneSourceLocal(int32 bodyId, int32 scopeId,
    int32 typeId, int32 bindingKind, int32 nameToken,
    int32 declarationStart, int32 initializerStart, int32 semicolonToken,
    ref<init int32> localIdResult)
    ensure return == 0 ? *localIdResult is init : true
{
    if (bodyId < 0 || bodyId >= Host.StandaloneSourceBodyCount[0]
        || scopeId < 0
        || scopeId >= Host.StandaloneSourceLexicalScopeCount[0]
        || typeId < 0 || typeId > Host.StandaloneTypeFactCount[0]
        || bindingKind < 0 || bindingKind > 3
        || (typeId == 0 && bindingKind != 0 && bindingKind != 1)
        || nameToken < 0 || nameToken >= Host.Tokens.Length / 3
        || declarationStart < 0 || semicolonToken < 0
        || ((initializerStart < 0)
            != (bindingKind == 2 || bindingKind == 3)))
    {
        return 3;
    }

    init int32 nameKind;
    init int32 nameStart;
    init int32 nameLength;
    if (!TryReadStandaloneSourceToken(nameToken,
            ref init nameKind, ref init nameStart,
            ref init nameLength)
        || nameKind != 2 || nameLength <= 0)
    {
        return 3;
    }

    init int32 parameterOrdinal;
    init int32 parameterTypeId;
    if (TryFindStandaloneSourceParameter(bodyId, nameToken,
            ref init parameterOrdinal, ref init parameterTypeId))
    {
        return 2;
    }

    int32 scopeOffset = scopeId * 5;
    if (Host.StandaloneSourceLexicalScopes[scopeOffset + 1] != bodyId)
    {
        return 3;
    }
    int32 scopeFirst
        = Host.StandaloneSourceLexicalScopes[scopeOffset + 2];
    int32 scopeCount
        = Host.StandaloneSourceLexicalScopes[scopeOffset + 3];
    for (mut int32 prior = 0; prior < scopeCount;
        prior = prior + 1)
    {
        int32 priorId = scopeFirst + prior;
        if (priorId < 0
            || priorId >= Host.StandaloneSourceLocalCount[0])
        {
            return 3;
        }
        int32 priorOffset = priorId * 10;
        if (Host.StandaloneSourceLocals[priorOffset] != bodyId
            || Host.StandaloneSourceLocals[priorOffset + 1] != scopeId)
        {
            return 3;
        }
        if (IsStandaloneSourceName(nameToken,
                Host.StandaloneSourceLocals[priorOffset + 4],
                Host.StandaloneSourceLocals[priorOffset + 5]))
        {
            return 2;
        }
    }

    int32 localId = Host.StandaloneSourceLocalCount[0];
    if (localId < 0
        || localId >= Host.StandaloneSourceLocals.Length / 10)
    {
        return 3;
    }
    int32 localOffset = localId * 10;
    Host.StandaloneSourceLocals[localOffset] = bodyId;
    Host.StandaloneSourceLocals[localOffset + 1] = scopeId;
    Host.StandaloneSourceLocals[localOffset + 2] = typeId;
    Host.StandaloneSourceLocals[localOffset + 3] = bindingKind;
    Host.StandaloneSourceLocals[localOffset + 4] = nameStart;
    Host.StandaloneSourceLocals[localOffset + 5] = nameLength;
    Host.StandaloneSourceLocals[localOffset + 6] = nameToken;
    Host.StandaloneSourceLocals[localOffset + 7] = declarationStart;
    Host.StandaloneSourceLocals[localOffset + 8] = initializerStart;
    Host.StandaloneSourceLocals[localOffset + 9] = semicolonToken;
    Host.StandaloneSourceLocalStates[localId] = 0;
    Host.StandaloneSourceLocalCount[0] = localId + 1;
    Host.StandaloneSourceLexicalScopes[scopeOffset + 3]
        = scopeCount + 1;
    *localIdResult = localId;
    return 0;
}

int32 TryInventoryStandaloneSourceLocal(int32 bodyId, int32 scopeId,
    int32 tokenStart, int32 tokenEnd,
    ref<init int32> localIdResult,
    ref<init int32> nextTokenResult)
    ensure return == 1 ? (*localIdResult is init
        && *nextTokenResult is init) : true
{
    if (tokenStart < 0 || tokenStart >= tokenEnd
        || tokenEnd > Host.Tokens.Length / 3)
    {
        return 3;
    }

    mut int32 cursor = tokenStart;
    mut bool isInit = false;
    mut bool isMutable = false;
    int32 firstKind = Host.Tokens[cursor * 3];
    if (firstKind == 2
        && IsStandaloneSourceInitKeyword(cursor))
    {
        isInit = true;
        cursor = cursor + 1;
        if (cursor < tokenEnd
            && (Host.Tokens[cursor * 3] == 46
                || Host.Tokens[cursor * 3] == 54
                || Host.Tokens[cursor * 3] == 52))
        {
            return 0;
        }
    }
    if (cursor < tokenEnd && Host.Tokens[cursor * 3] == 13)
    {
        isMutable = true;
        cursor = cursor + 1;
    }
    if (cursor >= tokenEnd)
    {
        return isInit || isMutable ? 2 : 0;
    }
    bool inferredType = Host.Tokens[cursor * 3] == 12;
    init int32 afterType;
    init int32 typeId;
    if (inferredType)
    {
        if (isInit)
        {
            return 2;
        }
        afterType = cursor + 1;
        typeId = 0;
    }
    else
    {
        int32 typeStatus = ParseStandaloneSourceType(cursor,
            true, false, ref init afterType, ref init typeId);
        if (typeStatus != 0)
        {
            return isInit || isMutable ? 2 : 0;
        }
    }
    if (afterType >= tokenEnd
        || Host.Tokens[afterType * 3] != 2)
    {
        return isInit || isMutable ? 2 : 0;
    }

    int32 nameToken = afterType;
    int32 afterName = nameToken + 1;
    int32 bindingKind = isInit
        ? (isMutable ? 3 : 2)
        : (isMutable ? 1 : 0);
    init int32 semicolonToken;
    mut int32 initializerStart = -1;
    if (isInit)
    {
        if (afterName >= tokenEnd
            || Host.Tokens[afterName * 3] != 52)
        {
            return 2;
        }
        semicolonToken = afterName;
    }
    else
    {
        if (afterName >= tokenEnd
            || Host.Tokens[afterName * 3] != 64)
        {
            return 2;
        }
        initializerStart = afterName + 1;
        if (FindStandaloneLocalInitializerEnd(initializerStart,
                tokenEnd, ref init semicolonToken) != 0)
        {
            return 1;
        }
        if (initializerStart >= semicolonToken)
        {
            return 2;
        }
    }

    init int32 localId;
    int32 appendStatus = AppendStandaloneSourceLocal(bodyId, scopeId,
        typeId, bindingKind, nameToken, tokenStart, initializerStart,
        semicolonToken, ref init localId);
    if (appendStatus != 0)
    {
        return appendStatus;
    }
    *localIdResult = localId;
    *nextTokenResult = semicolonToken + 1;
    return 1;
}

int32 FindStandaloneSourceStatementSemicolon(int32 tokenStart,
    int32 tokenEnd, ref<init int32> semicolonResult)
    ensure return == 0 ? *semicolonResult is init : true
{
    mut int32 parenthesisDepth = 0;
    for (mut int32 tokenIndex = tokenStart;
        tokenIndex < tokenEnd;
        tokenIndex = tokenIndex + 1)
    {
        int32 kind = Host.Tokens[tokenIndex * 3];
        if (kind == 46)
        {
            parenthesisDepth = parenthesisDepth + 1;
        }
        else if (kind == 47)
        {
            if (parenthesisDepth == 0)
            {
                return 1;
            }
            parenthesisDepth = parenthesisDepth - 1;
        }
        else if (kind == 52 && parenthesisDepth == 0)
        {
            *semicolonResult = tokenIndex;
            return 0;
        }
        else if ((kind == 48 || kind == 49)
            && parenthesisDepth == 0)
        {
            return 2;
        }
    }
    return 1;
}

int32 InventoryStandaloneSourceLocals(int32 bodyId,
    int32 scopeId, int32 tokenStart, int32 tokenEnd)
{
    if (bodyId < 0 || bodyId >= Host.StandaloneSourceBodyCount[0]
        || scopeId < 0
        || scopeId >= Host.StandaloneSourceLexicalScopeCount[0]
        || tokenStart < 0 || tokenStart > tokenEnd
        || tokenEnd > Host.Tokens.Length / 3)
    {
        return 3;
    }

    int32 localFirst = Host.StandaloneSourceLocalCount[0];
    mut int32 tokenIndex = tokenStart;
    while (tokenIndex < tokenEnd)
    {
        init int32 localId;
        init int32 nextToken;
        int32 localStatus = TryInventoryStandaloneSourceLocal(
            bodyId, scopeId, tokenIndex, tokenEnd,
            ref init localId, ref init nextToken);
        if (localStatus == 1)
        {
            if (nextToken <= tokenIndex)
            {
                return 3;
            }
            tokenIndex = nextToken;
            continue;
        }
        if (localStatus != 0)
        {
            return localStatus;
        }

        init int32 semicolon;
        int32 statementStatus = FindStandaloneSourceStatementSemicolon(
            tokenIndex, tokenEnd, ref init semicolon);
        if (statementStatus != 0)
        {
            return statementStatus;
        }
        tokenIndex = semicolon + 1;
    }

    int32 localCount
        = Host.StandaloneSourceLocalCount[0] - localFirst;
    Host.StandaloneSourceBodyLocalRanges[bodyId * 2] = localFirst;
    Host.StandaloneSourceBodyLocalRanges[bodyId * 2 + 1] = localCount;
    int32 scopeOffset = scopeId * 5;
    Host.StandaloneSourceLexicalScopes[scopeOffset + 2] = localFirst;
    Host.StandaloneSourceLexicalScopes[scopeOffset + 3] = localCount;
    return 0;
}

int32 FindStandaloneSourceLocal(int32 bodyId, int32 nameToken)
{
    if (bodyId < 0 || bodyId >= Host.StandaloneSourceBodyCount[0]
        || nameToken < 0 || nameToken >= Host.Tokens.Length / 3)
    {
        return -2;
    }
    int32 rangeOffset = bodyId * 2;
    int32 localFirst
        = Host.StandaloneSourceBodyLocalRanges[rangeOffset];
    int32 localCount
        = Host.StandaloneSourceBodyLocalRanges[rangeOffset + 1];
    if (localFirst < 0 || localCount < 0
        || localFirst
            > Host.StandaloneSourceLocalCount[0] - localCount)
    {
        return -2;
    }
    for (mut int32 ordinal = 0; ordinal < localCount;
        ordinal = ordinal + 1)
    {
        int32 localId = localFirst + ordinal;
        int32 localOffset = localId * 10;
        if (Host.StandaloneSourceLocals[localOffset] != bodyId)
        {
            return -2;
        }
        if (IsStandaloneSourceName(nameToken,
                Host.StandaloneSourceLocals[localOffset + 4],
                Host.StandaloneSourceLocals[localOffset + 5]))
        {
            return localId;
        }
    }
    return -1;
}

int32 FindStandaloneSourceLocalAtDeclaration(int32 bodyId,
    int32 declarationToken)
{
    if (bodyId < 0 || bodyId >= Host.StandaloneSourceBodyCount[0]
        || declarationToken < 0)
    {
        return -2;
    }
    int32 rangeOffset = bodyId * 2;
    int32 localFirst
        = Host.StandaloneSourceBodyLocalRanges[rangeOffset];
    int32 localCount
        = Host.StandaloneSourceBodyLocalRanges[rangeOffset + 1];
    if (localFirst < 0 || localCount < 0
        || localFirst
            > Host.StandaloneSourceLocalCount[0] - localCount)
    {
        return -2;
    }
    for (mut int32 ordinal = 0; ordinal < localCount;
        ordinal = ordinal + 1)
    {
        int32 localId = localFirst + ordinal;
        int32 localOffset = localId * 10;
        if (Host.StandaloneSourceLocals[localOffset] != bodyId)
        {
            return -2;
        }
        if (Host.StandaloneSourceLocals[localOffset + 7]
            == declarationToken)
        {
            return localId;
        }
    }
    return -1;
}

int32 AppendStandaloneSourcePlace(int32 bodyId, int32 typeId,
    int32 placeKind, int32 targetIndex, int32 locationId,
    ref<init int32> placeIdResult)
    ensure return == 0 ? *placeIdResult is init : true
{
    int32 count = Host.StandaloneSourcePlaceCount[0];
    if (count < 0
        || count >= Host.StandaloneSourcePlaces.Length / 5
        || bodyId < 0 || bodyId >= Host.StandaloneSourceBodyCount[0]
        || typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0]
        || (placeKind < 1 || placeKind > 4)
        || targetIndex < 0)
    {
        return 3;
    }

    if (placeKind == 4)
    {
        int32 infoOffset = bodyId * 12;
        int32 parameterCount
            = Host.StandaloneSourceCallableInfo[infoOffset + 6];
        int32 parameterFirst
            = Host.StandaloneSourceCallableInfo[infoOffset + 5];
        int32 parameterRow = parameterFirst + targetIndex;
        if (targetIndex >= parameterCount
            || parameterRow < 0
            || parameterRow >= Host.StandaloneSourceParameterCount[0]
            || Host.StandaloneSourceParameters[
                parameterRow * 4] != bodyId
            || Host.StandaloneSourceParameters[
                parameterRow * 4 + 1] != typeId)
        {
            return 3;
        }
    }
    else
    {
        if (targetIndex >= Host.StandaloneSourceLocalCount[0])
        {
            return 3;
        }
        int32 localOffset = targetIndex * 10;
        if (Host.StandaloneSourceLocals[localOffset] != bodyId
            || Host.StandaloneSourceLocals[localOffset + 2] != typeId)
        {
            return 3;
        }
    }
    int32 placeOffset = count * 5;
    Host.StandaloneSourcePlaces[placeOffset] = bodyId;
    Host.StandaloneSourcePlaces[placeOffset + 1] = typeId;
    Host.StandaloneSourcePlaces[placeOffset + 2] = placeKind;
    Host.StandaloneSourcePlaces[placeOffset + 3] = targetIndex;
    Host.StandaloneSourcePlaces[placeOffset + 4] = locationId;
    Host.StandaloneSourcePlaceCount[0] = count + 1;
    *placeIdResult = count;
    return 0;
}

int32 BindStandaloneSourceBody(int32 localCallableId)
{
    int32 bodyOffset = localCallableId * 12;
    int32 infoOffset = localCallableId * 12;
    mut int32 bodyTokenStart
        = Host.StandaloneSourceCallableInfo[infoOffset + 8];
    mut int32 bodyTokenEnd
        = Host.StandaloneSourceCallableInfo[infoOffset + 9];
    int32 resultTypeId
        = Host.StandaloneSourceCallableInfo[infoOffset + 4];
    int32 expressionFirst
        = Host.StandaloneSourceExpressionCount[0];
    int32 directCallFirst
        = Host.StandaloneSourceDirectCallCount[0];
    int32 argumentFirst
        = Host.StandaloneSourceCallArgumentCount[0];
    int32 statementFirst
        = Host.StandaloneSourceStatementCount[0];
    int32 placeFirst
        = Host.StandaloneSourcePlaceCount[0];
    mut bool unsafeBlock = false;
    if (bodyTokenStart + 1 < bodyTokenEnd
        && Host.Tokens[bodyTokenStart * 3] == 76
        && Host.Tokens[(bodyTokenStart + 1) * 3] == 48)
    {
        init int32 unsafeClose;
        if (!FindStandaloneMatchingClose(
                bodyTokenStart + 1, bodyTokenEnd,
                48, 49, ref init unsafeClose)
            || unsafeClose != bodyTokenEnd - 1)
        {
            return 2;
        }
        bodyTokenStart = bodyTokenStart + 2;
        bodyTokenEnd = unsafeClose;
        unsafeBlock = true;
    }
    Host.StandaloneSourceBodies[bodyOffset]
        = localCallableId;
    Host.StandaloneSourceBodies[bodyOffset + 1]
        = bodyTokenStart;
    Host.StandaloneSourceBodies[bodyOffset + 2]
        = bodyTokenEnd;
    Host.StandaloneSourceBodies[bodyOffset + 3]
        = expressionFirst;
    Host.StandaloneSourceBodies[bodyOffset + 5]
        = directCallFirst;
    Host.StandaloneSourceBodies[bodyOffset + 7]
        = argumentFirst;
    Host.StandaloneSourceBodies[bodyOffset + 9]
        = statementFirst;
    Host.StandaloneSourceBodies[bodyOffset + 11]
        = unsafeBlock ? 1 : 0;
    init int32 scopeId;
    int32 scopeStatus = AppendStandaloneSourceLexicalScope(
        localCallableId, unsafeBlock, ref init scopeId);
    if (scopeStatus != 0)
    {
        return scopeStatus;
    }
    int32 localInventoryStatus = InventoryStandaloneSourceLocals(
        localCallableId, scopeId, bodyTokenStart, bodyTokenEnd);
    if (localInventoryStatus != 0)
    {
        return localInventoryStatus;
    }

    mut int32 tokenIndex = bodyTokenStart;
    mut bool sawReturn = false;
    while (tokenIndex < bodyTokenEnd)
    {
        int32 kind = Host.Tokens[tokenIndex * 3];
        int32 declaredLocalId
            = FindStandaloneSourceLocalAtDeclaration(
                localCallableId, tokenIndex);
        if (declaredLocalId == -2)
        {
            return 3;
        }
        if (declaredLocalId >= 0)
        {
            int32 localOffset = declaredLocalId * 10;
            int32 typeId
                = Host.StandaloneSourceLocals[localOffset + 2];
            int32 bindingKind
                = Host.StandaloneSourceLocals[localOffset + 3];
            int32 initializerStart
                = Host.StandaloneSourceLocals[localOffset + 8];
            int32 semicolonToken
                = Host.StandaloneSourceLocals[localOffset + 9];
            bool inferredType = typeId == 0;
            init int32 initializerExpressionId;
            int32 expressionId = -1;
            if (initializerStart >= 0)
            {
                init int32 nextInitializerToken;
                int32 initializerStatus
                    = ParseStandaloneSourceExpression(
                        localCallableId, localCallableId,
                        expressionFirst,
                        inferredType ? -1 : typeId, initializerStart,
                        semicolonToken, 1,
                        ref init initializerExpressionId,
                        ref init nextInitializerToken);
                if (initializerStatus != 0)
                {
                    return initializerStatus;
                }
                if (nextInitializerToken != semicolonToken)
                {
                    return 1;
                }
                expressionId = initializerExpressionId;
                if (inferredType)
                {
                    int32 inferredTypeId
                        = Host.StandaloneSourceExpressions[
                            (expressionFirst + expressionId) * 8 + 1];
                    if (!IsStandaloneSourceConstructionType(
                            inferredTypeId)
                        || GetStandaloneSourceUse(inferredTypeId) == 5)
                    {
                        return 2;
                    }
                    Host.StandaloneSourceLocals[
                        localOffset + 2] = inferredTypeId;
                    typeId = inferredTypeId;
                }
            }
            else if (bindingKind != 2 && bindingKind != 3)
            {
                return 3;
            }

            int32 statementStatus = AppendStandaloneSourceStatement(
                localCallableId, expressionFirst, 4, expressionId,
                declaredLocalId);
            if (statementStatus != 0)
            {
                return statementStatus;
            }
            if (expressionId >= 0)
            {
                Host.StandaloneSourceLocalStates[declaredLocalId] = 1;
            }
            tokenIndex = semicolonToken + 1;
            continue;
        }

        if (IsStandaloneSourceIfKeyword(tokenIndex))
        {
            if (sawReturn || tokenIndex + 1 >= bodyTokenEnd
                || Host.Tokens[(tokenIndex + 1) * 3] != 46)
            {
                return 1;
            }
            init int32 conditionClose;
            if (!FindStandaloneMatchingClose(
                    tokenIndex + 1, bodyTokenEnd, 46, 47,
                    ref init conditionClose))
            {
                return 1;
            }
            init int32 boolTypeId;
            int32 boolTypeStatus
                = InternStandaloneCallableTypeFact(
                    0, 1, false, ref init boolTypeId);
            if (boolTypeStatus != 0)
            {
                return boolTypeStatus;
            }
            init int32 conditionExpressionId;
            init int32 nextConditionToken;
            int32 conditionStatus
                = ParseStandaloneSourceExpression(
                    localCallableId, localCallableId,
                    expressionFirst, boolTypeId, tokenIndex + 2,
                conditionClose, 1,
                    ref init conditionExpressionId,
                    ref init nextConditionToken);
            if (conditionStatus != 0)
            {
                return conditionStatus;
            }
            if (nextConditionToken != conditionClose)
            {
                return 1;
            }
            init bool conditionDoesNotReturn;
            int32 conditionDoesNotReturnStatus
                = TryGetStandaloneSourceExpressionDoesNotReturn(
                    localCallableId, conditionExpressionId,
                    ref init conditionDoesNotReturn);
            if (conditionDoesNotReturnStatus != 0)
            {
                return conditionDoesNotReturnStatus;
            }
            if (conditionDoesNotReturn)
            {
                return 2;
            }

            init int32 ifNodeId;
            int32 ifNodeStatus = AppendStandaloneSourceIfNode(
                localCallableId, ref init ifNodeId);
            if (ifNodeStatus != 0)
            {
                return ifNodeStatus;
            }
            int32 ifStatementStatus
                = AppendStandaloneSourceStatement(
                    localCallableId, expressionFirst, 6,
                    conditionExpressionId, ifNodeId);
            if (ifStatementStatus != 0)
            {
                return ifStatementStatus;
            }
            int32 ifStatementId
                = Host.StandaloneSourceStatementCount[0] - 1;

            init int32 trueStatementFirst;
            init int32 trueStatementCount;
            init int32 afterTrueToken;
            int32 trueStatus = ParseStandaloneSourceIfBranch(
                localCallableId, localCallableId, expressionFirst,
                resultTypeId, ifNodeId, ifStatementId, true,
                conditionClose + 1, bodyTokenEnd,
                ref init trueStatementFirst,
                ref init trueStatementCount,
                ref init afterTrueToken);
            if (trueStatus != 0)
            {
                return trueStatus;
            }
            init int32 falseStatementFirst;
            init int32 falseStatementCount;
            init int32 afterFalseToken;
            if (afterTrueToken < bodyTokenEnd
                && IsStandaloneSourceElseKeyword(afterTrueToken))
            {
                int32 falseStatus = ParseStandaloneSourceIfBranch(
                    localCallableId, localCallableId, expressionFirst,
                    resultTypeId, ifNodeId, ifStatementId, false,
                    afterTrueToken + 1, bodyTokenEnd,
                    ref init falseStatementFirst,
                    ref init falseStatementCount,
                    ref init afterFalseToken);
                if (falseStatus != 0)
                {
                    return falseStatus;
                }
            }
            else
            {
                falseStatementFirst = -1;
                falseStatementCount = 0;
                afterFalseToken = afterTrueToken;
                Host.StandaloneSourceIfNodes[ifNodeId * 5 + 3]
                    = Host.StandaloneSourceIfChildCount[0];
            }
            if (trueStatementCount <= 0
                || falseStatementCount < 0)
            {
                return 2;
            }
            int32 trueChildFirst
                = Host.StandaloneSourceIfNodes[ifNodeId * 5 + 1];
            int32 falseChildFirst
                = Host.StandaloneSourceIfNodes[ifNodeId * 5 + 3];
            int32 trueStatementId
                = Host.StandaloneSourceIfChildren[trueChildFirst];
            int32 falseStatementId = falseStatementCount == 0
                ? -1
                : Host.StandaloneSourceIfChildren[falseChildFirst];
            if (trueStatementId != trueStatementFirst
                || (falseStatementCount != 0
                    && falseStatementId != falseStatementFirst)
                || (falseStatementCount == 0
                    && falseStatementFirst != -1)
                || Host.StandaloneSourceIfNodes[ifNodeId * 5 + 2]
                    != trueStatementCount
                || Host.StandaloneSourceIfNodes[ifNodeId * 5 + 4]
                    != falseStatementCount)
            {
                return 3;
            }
            int32 trueStatementKind
                = Host.StandaloneSourceStatements[
                    trueStatementId * 3];
            int32 falseStatementKind = falseStatementCount == 0
                ? -1
                : Host.StandaloneSourceStatements[
                    falseStatementId * 3];
            bool trueReturns
                = trueStatementCount == 1
                    && trueStatementKind == 1;
            bool falseReturns
                = falseStatementCount == 1
                    && falseStatementKind == 1;
            bool bothReturns
                = trueReturns && falseReturns;
            mut bool trueAssignments = trueStatementCount > 0;
            mut bool falseAssignments = falseStatementCount > 0;
            for (mut int32 branchIndex = 0;
                branchIndex < 2;
                branchIndex = branchIndex + 1)
            {
                int32 childFirst = branchIndex == 0
                    ? trueChildFirst : falseChildFirst;
                int32 childCount = branchIndex == 0
                    ? trueStatementCount : falseStatementCount;
                for (mut int32 childIndex = 0;
                    childIndex < childCount;
                    childIndex = childIndex + 1)
                {
                    int32 childStatementId
                        = Host.StandaloneSourceIfChildren[
                            childFirst + childIndex];
                    if (Host.StandaloneSourceStatements[
                            childStatementId * 3] != 5)
                    {
                        if (branchIndex == 0)
                        {
                            trueAssignments = false;
                        }
                        else
                        {
                            falseAssignments = false;
                        }
                    }
                }
            }
            bool bothAssignments
                = trueAssignments
                    && (falseStatementCount == 0 || falseAssignments);
            bool oneReturnOneAssignments
                = (trueReturns && falseAssignments)
                    || (falseReturns && trueAssignments);
            if (!bothReturns && !bothAssignments
                && !oneReturnOneAssignments)
            {
                return 2;
            }
            if (bothReturns && afterFalseToken != bodyTokenEnd)
            {
                return 1;
            }
            if (bothAssignments || oneReturnOneAssignments)
            {
                int32 localId = -1;
                int32 localTypeId = -1;
                int32 assignmentBranchIndex
                    = trueReturns ? 1 : 0;
                int32 assignmentBranchCount
                    = assignmentBranchIndex == 0
                        ? trueStatementCount : falseStatementCount;
                for (mut int32 branchOrdinal = 0;
                    branchOrdinal < (bothAssignments ? 2 : 1);
                    branchOrdinal = branchOrdinal + 1)
                {
                    int32 branchIndex = bothAssignments
                        ? branchOrdinal : assignmentBranchIndex;
                    int32 childFirst = branchIndex == 0
                        ? trueChildFirst : falseChildFirst;
                    int32 childCount = branchIndex == 0
                        ? trueStatementCount : falseStatementCount;
                    for (mut int32 childIndex = 0;
                        childIndex < childCount;
                        childIndex = childIndex + 1)
                    {
                        int32 childStatementId
                            = Host.StandaloneSourceIfChildren[
                                childFirst + childIndex];
                        if (Host.StandaloneSourceStatements[
                                childStatementId * 3] != 5)
                        {
                            return 2;
                        }
                        int32 placeId
                            = Host.StandaloneSourceStatements[
                                childStatementId * 3 + 2];
                        if (placeId < 0
                            || placeId
                                >= Host.StandaloneSourcePlaceCount[0])
                        {
                            return 3;
                        }
                        int32 placeOffset = placeId * 5;
                        int32 childLocalId
                            = Host.StandaloneSourcePlaces[
                                placeOffset + 3];
                        int32 childTypeId
                            = Host.StandaloneSourcePlaces[
                                placeOffset + 1];
                        if (childLocalId < 0
                            || Host.StandaloneSourcePlaces[
                                placeOffset] != localCallableId
                            || Host.StandaloneSourcePlaces[
                                placeOffset + 2] != 2
                            || (localId >= 0
                                && (localId != childLocalId
                                    || localTypeId != childTypeId)))
                        {
                            return 2;
                        }
                        localId = childLocalId;
                        localTypeId = childTypeId;
                    }
                }
                int32 localOffset = localId * 10;
                int32 bindingKind
                    = Host.StandaloneSourceLocals[localOffset + 3];
                int32 localState
                    = Host.StandaloneSourceLocalStates[localId];
                if ((bindingKind == 1 && localState != 1)
                    || (bindingKind == 2
                        && (localState != 0
                            || falseStatementCount == 0
                            || (bothAssignments
                                && (trueStatementCount != 1
                                    || falseStatementCount != 1))
                            || (oneReturnOneAssignments
                                && assignmentBranchCount != 1)))
                    || (bindingKind == 3
                        && (localState != 0 && localState != 1))
                    || (bindingKind != 1 && bindingKind != 2
                        && bindingKind != 3))
                {
                    return 2;
                }
                if (falseStatementCount == 0 && localState == 0
                    && (bindingKind == 2 || bindingKind == 3))
                {
                    return 2;
                }
                if (falseStatementCount != 0 && localState == 0
                    && (bindingKind == 2 || bindingKind == 3))
                {
                    Host.StandaloneSourceLocalStates[localId] = 1;
                }
            }
            sawReturn = bothReturns;
            tokenIndex = afterFalseToken;
            continue;
        }

        int32 assignmentTokenKind
            = tokenIndex + 1 < bodyTokenEnd
                ? Host.Tokens[(tokenIndex + 1) * 3] : 0;
        int32 compoundExpressionKind
            = GetStandaloneSourceCompoundAssignmentExpressionKind(
                assignmentTokenKind);
        bool simpleAssignment = assignmentTokenKind == 64;
        bool compoundAssignment = compoundExpressionKind != 0;
        if (kind == 2 && (simpleAssignment || compoundAssignment))
        {
            int32 localId
                = FindStandaloneSourceLocal(localCallableId, tokenIndex);
            if (localId < 0)
            {
                return 2;
            }
            int32 localOffset = localId * 10;
            int32 typeId
                = Host.StandaloneSourceLocals[localOffset + 2];
            int32 bindingKind
                = Host.StandaloneSourceLocals[localOffset + 3];
            int32 localNameToken
                = Host.StandaloneSourceLocals[localOffset + 6];
            int32 localState
                = Host.StandaloneSourceLocalStates[localId];
            bool compoundIntegerOperation
                = compoundExpressionKind >= 12
                    && compoundExpressionKind <= 14;
            bool compoundShiftOperation
                = compoundExpressionKind >= 31
                    && compoundExpressionKind <= 33;
            if (Host.StandaloneSourceLocals[localOffset] != localCallableId
                || tokenIndex < localNameToken
                || !((bindingKind == 1 && localState == 1)
                    || (bindingKind == 2 && localState == 0)
                    || bindingKind == 3)
                || typeId <= 0
                || typeId > Host.StandaloneTypeFactCount[0]
                || (compoundAssignment
                    && ((bindingKind != 1 && bindingKind != 3)
                        || localState != 1
                        || (compoundShiftOperation
                            ? !IsStandaloneSourceShiftDataType(typeId)
                            : compoundIntegerOperation
                                ? !IsStandaloneIntegerArithmeticType(
                                    typeId)
                                : !IsStandaloneArithmeticType(typeId))
                        || !IsStandaloneBinaryOperatorSeparated(
                            tokenIndex + 1))))
            {
                return 2;
            }

            init int32 semicolonToken;
            int32 semicolonStatus = FindStandaloneSourceStatementSemicolon(
                tokenIndex + 2, bodyTokenEnd,
                ref init semicolonToken);
            if (semicolonStatus != 0)
            {
                return semicolonStatus;
            }
            init int32 placeId;
            int32 placeStatus = AppendStandaloneSourcePlace(
                localCallableId, typeId, 2, localId, -1,
                ref init placeId);
            if (placeStatus != 0)
            {
                return placeStatus;
            }
            mut int32 expressionId = -1;
            if (simpleAssignment)
            {
                init int32 parsedExpressionId;
                init int32 nextToken;
                int32 expressionStatus
                    = ParseStandaloneSourceExpression(
                        localCallableId, localCallableId,
                        expressionFirst, typeId, tokenIndex + 2,
                        semicolonToken, 1,
                        ref init parsedExpressionId,
                        ref init nextToken);
                if (expressionStatus != 0)
                {
                    return expressionStatus;
                }
                if (nextToken != semicolonToken)
                {
                    return 1;
                }
                expressionId = parsedExpressionId;
            }
            else
            {
                mut int32 compoundRightTypeId = typeId;
                if (compoundShiftOperation)
                {
                    init int32 countTypeId;
                    int32 countTypeStatus
                        = FindStandaloneShiftCountType(
                            localCallableId, tokenIndex + 2,
                            semicolonToken, 0,
                            ref init countTypeId);
                    if (countTypeStatus != 0)
                    {
                        return countTypeStatus;
                    }
                    compoundRightTypeId = countTypeId;
                }
                init int32 leftExpressionId;
                init int32 nextLeftToken;
                int32 leftStatus = ParseStandaloneSourceExpression(
                    localCallableId, localCallableId, expressionFirst,
                    typeId, tokenIndex, tokenIndex + 1, 1,
                    ref init leftExpressionId,
                    ref init nextLeftToken);
                if (leftStatus != 0)
                {
                    return leftStatus;
                }
                init int32 rightExpressionId;
                init int32 nextRightToken;
                int32 rightStatus = ParseStandaloneSourceExpression(
                    localCallableId, localCallableId, expressionFirst,
                    compoundRightTypeId, tokenIndex + 2,
                    semicolonToken, 1,
                    ref init rightExpressionId,
                    ref init nextRightToken);
                if (rightStatus != 0)
                {
                    return rightStatus;
                }
                int32 leftGlobalId = expressionFirst
                    + leftExpressionId;
                int32 rightGlobalId = expressionFirst
                    + rightExpressionId;
                if (nextLeftToken != tokenIndex + 1
                    || nextRightToken != semicolonToken
                    || leftExpressionId == rightExpressionId
                    || leftGlobalId < expressionFirst
                    || leftGlobalId
                        >= Host.StandaloneSourceExpressionCount[0]
                    || rightGlobalId < expressionFirst
                    || rightGlobalId
                        >= Host.StandaloneSourceExpressionCount[0]
                    || Host.StandaloneSourceExpressions[
                        leftGlobalId * 8 + 1] != typeId
                    || Host.StandaloneSourceExpressions[
                        rightGlobalId * 8 + 1]
                        != compoundRightTypeId
                    || Host.StandaloneSourceExpressionUseCounts[
                        leftGlobalId] != 0
                    || Host.StandaloneSourceExpressionUseCounts[
                        rightGlobalId] != 0)
                {
                    return 3;
                }
                init int32 compoundExpressionId;
                int32 appendStatus
                    = AppendStandaloneSourceExpression(
                        localCallableId, compoundExpressionKind, typeId,
                        leftExpressionId, rightExpressionId, 0, 0, -1,
                        expressionFirst,
                        ref init compoundExpressionId);
                if (appendStatus != 0)
                {
                    return appendStatus;
                }
                Host.StandaloneSourceExpressionUseCounts[leftGlobalId]
                    = 1;
                Host.StandaloneSourceExpressionUseCounts[rightGlobalId]
                    = 1;
                expressionId = compoundExpressionId;
            }
            init bool expressionDoesNotReturn;
            int32 doesNotReturnStatus
                = TryGetStandaloneSourceExpressionDoesNotReturn(
                    localCallableId, expressionId,
                    ref init expressionDoesNotReturn);
            if (doesNotReturnStatus != 0)
            {
                return doesNotReturnStatus;
            }
            if (simpleAssignment && !expressionDoesNotReturn
                && (bindingKind == 2 || bindingKind == 3))
            {
                Host.StandaloneSourceLocalStates[localId] = 1;
            }
            int32 statementStatus = AppendStandaloneSourceStatement(
                localCallableId, expressionFirst, 5, expressionId,
                placeId);
            if (statementStatus != 0)
            {
                return statementStatus;
            }
            tokenIndex = semicolonToken + 1;
            continue;
        }

        if (kind == 19)
        {
            if (sawReturn)
            {
                return 1;
            }
            sawReturn = true;
            tokenIndex = tokenIndex + 1;
            if (tokenIndex < bodyTokenEnd
                && Host.Tokens[tokenIndex * 3] == 52)
            {
                if (!IsStandaloneUnitType(resultTypeId))
                {
                    return 2;
                }
                int32 statementStatus = AppendStandaloneSourceStatement(
                    localCallableId, expressionFirst, 1, -1, -1);
                if (statementStatus != 0)
                {
                    return statementStatus;
                }
                tokenIndex = tokenIndex + 1;
                if (tokenIndex != bodyTokenEnd)
                {
                    return 1;
                }
                continue;
            }

            init int32 expressionId;
            init int32 nextToken;
            int32 expressionStatus
                = ParseStandaloneSourceExpression(localCallableId,
                    localCallableId, expressionFirst, resultTypeId,
                    tokenIndex, bodyTokenEnd, 0,
                    ref init expressionId, ref init nextToken);
            if (expressionStatus != 0)
            {
                return expressionStatus;
            }
            int32 statementStatus = AppendStandaloneSourceStatement(
                localCallableId, expressionFirst, 1, expressionId, -1);
            if (statementStatus != 0)
            {
                return statementStatus;
            }
            tokenIndex = nextToken;
            if (tokenIndex >= bodyTokenEnd
                || Host.Tokens[tokenIndex * 3] != 52)
            {
                return 1;
            }
            tokenIndex = tokenIndex + 1;
            if (tokenIndex != bodyTokenEnd)
            {
                return 1;
            }
            continue;
        }

        mut int32 expressionStatementKind = 2;
        mut int32 expressionStart = tokenIndex;
        if (kind == 81)
        {
            if (tokenIndex + 1 >= bodyTokenEnd
                || Host.Tokens[(tokenIndex + 1) * 3] != 64)
            {
                return 1;
            }
            expressionStatementKind = 3;
            expressionStart = tokenIndex + 2;
        }

        init int32 expressionId;
        init int32 nextToken;
        int32 expressionStatus
            = ParseStandaloneSourceExpression(localCallableId,
                localCallableId, expressionFirst, -1,
                expressionStart, bodyTokenEnd, 1,
                ref init expressionId, ref init nextToken);
        if (expressionStatus != 0)
        {
            return expressionStatus;
        }
        int32 expressionGlobal
            = expressionFirst + expressionId;
        if (expressionGlobal < expressionFirst
            || expressionGlobal >= Host.StandaloneSourceExpressionCount[0])
        {
            return 2;
        }
        if (expressionStatementKind == 2
            && !IsStandaloneUnitType(Host.StandaloneSourceExpressions[
                expressionGlobal * 8 + 1]))
        {
            int32 expressionKind
                = Host.StandaloneSourceExpressions[
                    expressionGlobal * 8];
            if (expressionKind != 3
                && expressionKind != 6
                && expressionKind != 8
                && expressionKind != 9)
            {
                return 2;
            }
            init bool expressionDoesNotReturn;
            int32 doesNotReturnStatus
                = TryGetStandaloneSourceExpressionDoesNotReturn(
                    localCallableId, expressionId,
                    ref init expressionDoesNotReturn);
            if (doesNotReturnStatus != 0)
            {
                return doesNotReturnStatus;
            }
            if (!expressionDoesNotReturn)
            {
                return 2;
            }
        }
        int32 statementStatus = AppendStandaloneSourceStatement(
            localCallableId, expressionFirst, expressionStatementKind,
            expressionId, -1);
        if (statementStatus != 0)
        {
            return statementStatus;
        }
        tokenIndex = nextToken;
        if (tokenIndex >= bodyTokenEnd
            || Host.Tokens[tokenIndex * 3] != 52)
        {
            return 1;
        }
        tokenIndex = tokenIndex + 1;
    }

    if (!IsStandaloneUnitType(resultTypeId) && !sawReturn)
    {
        return 2;
    }
    Host.StandaloneSourceBodies[bodyOffset + 4]
        = Host.StandaloneSourceExpressionCount[0] - expressionFirst;
    Host.StandaloneSourceBodies[bodyOffset + 6]
        = Host.StandaloneSourceDirectCallCount[0] - directCallFirst;
    Host.StandaloneSourceBodies[bodyOffset + 8]
        = Host.StandaloneSourceCallArgumentCount[0] - argumentFirst;
    Host.StandaloneSourceBodies[bodyOffset + 10]
        = Host.StandaloneSourceStatementCount[0] - statementFirst;
    Host.StandaloneSourceBodies[bodyOffset + 11]
        = unsafeBlock ? 1 : 0;
    Host.StandaloneSourceBodyPlaceRanges[localCallableId * 2]
        = placeFirst;
    Host.StandaloneSourceBodyPlaceRanges[localCallableId * 2 + 1]
        = Host.StandaloneSourcePlaceCount[0] - placeFirst;
    return 0;
}

bool FindStandaloneMatchingClose(int32 openingToken,
    int32 tokenEnd, int32 openingKind, int32 closingKind,
    ref<init int32> closingTokenResult)
    ensure return ? *closingTokenResult is init : true
{
    if (openingToken < 0 || openingToken >= tokenEnd
        || Host.Tokens[openingToken * 3] != openingKind)
    {
        return false;
    }

    mut int32 depth = 0;
    for (mut int32 index = openingToken;
        index < tokenEnd;
        index = index + 1)
    {
        int32 kind = Host.Tokens[index * 3];
        if (kind == openingKind)
        {
            depth = depth + 1;
        }
        else if (kind == closingKind)
        {
            depth = depth - 1;
            if (depth == 0)
            {
                *closingTokenResult = index;
                return true;
            }
            if (depth < 0)
            {
                return false;
            }
        }
    }
    return false;
}

bool IsStandaloneUnitType(int32 typeId)
{
    return typeId > 0
        && typeId <= Host.StandaloneTypeFactCount[0]
        && Host.StandaloneTypeFacts[typeId * 3] == 0
        && Host.StandaloneTypeFacts[typeId * 3 + 1] == 0
        && Host.StandaloneTypeFacts[typeId * 3 + 2] == 0;
}

bool AreStandaloneSourceTokensAdjacent(int32 firstToken,
    int32 secondToken)
{
    int32 tokenCount = Host.Tokens.Length / 3;
    if (firstToken < 0 || firstToken >= tokenCount
        || secondToken < 0 || secondToken >= tokenCount)
    {
        return false;
    }
    int32 firstStart
        = Host.Tokens[firstToken * 3 + 1];
    int32 firstLength
        = Host.Tokens[firstToken * 3 + 2];
    int32 secondStart
        = Host.Tokens[secondToken * 3 + 1];
    return firstStart >= 0 && firstLength > 0
        && firstStart <= Host.Source.Length - firstLength
        && secondStart == firstStart + firstLength;
}

bool TryParseStandaloneIntegerToken(int32 tokenIndex,
    ref<init int32> radixResult,
    ref<init uint64> magnitudeResult)
    ensure return ? (*radixResult is init
        && *magnitudeResult is init) : true
{
    if (tokenIndex < 0
        || tokenIndex >= Host.Tokens.Length / 3
        || Host.Tokens[tokenIndex * 3] != 3)
    {
        return false;
    }
    int32 tokenStart
        = Host.Tokens[tokenIndex * 3 + 1];
    int32 tokenLength
        = Host.Tokens[tokenIndex * 3 + 2];
    if (tokenStart < 0 || tokenLength <= 0
        || tokenStart > Host.Source.Length - tokenLength)
    {
        return false;
    }
    int32 radix = 10;
    int32 digitsStart = tokenStart;
    int32 digitsLength = tokenLength;
    if (tokenLength >= 2 && Host.Source[tokenStart] == 48)
    {
        int32 prefix = Host.Source[tokenStart + 1];
        if (prefix == 120 || prefix == 88)
        {
            radix = 16;
        }
        else if (prefix == 98 || prefix == 66)
        {
            radix = 2;
        }
        if (radix != 10)
        {
            digitsStart = tokenStart + 2;
            digitsLength = tokenLength - 2;
        }
    }
    if (digitsLength <= 0
        || !TryParseUInt64Base(digitsStart, digitsLength, radix,
            ref init *magnitudeResult))
    {
        return false;
    }
    *radixResult = radix;
    return true;
}

bool TryParseStandaloneFloatLiteralBits(int32 tokenIndex,
    int32 typeCode, bool negative, ref<init uint64> valueBitsResult)
    ensure return ? *valueBitsResult is init : true
{
    if ((typeCode != 0x14 && typeCode != 0x15)
        || tokenIndex < 0
        || tokenIndex >= Host.Tokens.Length / 3
        || Host.Tokens[tokenIndex * 3] != 3)
    {
        return false;
    }
    int32 tokenStart
        = Host.Tokens[tokenIndex * 3 + 1];
    int32 tokenLength
        = Host.Tokens[tokenIndex * 3 + 2];
    if (tokenStart < 0 || tokenLength <= 0
        || tokenStart > Host.Source.Length - tokenLength)
    {
        return false;
    }

    bool hexadecimalPrefix = tokenLength >= 2
        && Host.Source[tokenStart] == 48
        && (Host.Source[tokenStart + 1] == 120
            || Host.Source[tokenStart + 1] == 88);
    bool binaryPrefix = tokenLength >= 2
        && Host.Source[tokenStart] == 48
        && (Host.Source[tokenStart + 1] == 98
            || Host.Source[tokenStart + 1] == 66);
    bool floatingToken = IsFloatingPointToken(tokenIndex);
    if (binaryPrefix && floatingToken)
    {
        return false;
    }

    mut int64 parsedBits = -1;
    if (hexadecimalPrefix && floatingToken)
    {
        parsedBits = typeCode == 0x14
            ? GetHexFloat32LiteralBitsOrMinusOne(
                tokenStart, tokenLength)
            : GetHexFloat64LiteralBitsOrMinusOne(
                tokenStart, tokenLength);
    }
    else if (hexadecimalPrefix || binaryPrefix)
    {
        parsedBits = typeCode == 0x14
            ? GetBasedIntegerFloat32BitsOrMinusOne(
                tokenStart, tokenLength)
            : GetBasedIntegerFloat64BitsOrMinusOne(
                tokenStart, tokenLength);
    }
    else
    {
        parsedBits = typeCode == 0x14
            ? GetDecimalFloat32LiteralBitsOrMinusOne(
                tokenStart, tokenLength)
            : GetDecimalFloat64LiteralBitsOrMinusOne(
                tokenStart, tokenLength);
    }
    if (parsedBits < 0)
    {
        return false;
    }

    mut uint64 valueBits = uint64(parsedBits);
    if (negative)
    {
        valueBits = valueBits
            | (typeCode == 0x14
                ? uint64(0x8000_0000)
                : uint64(0x8000_0000_0000_0000));
    }
    *valueBitsResult = valueBits;
    return true;
}

int32 AppendStandaloneSourceFloatLiteral(int32 bodyId,
    int32 expressionFirst, int32 typeId, int32 tokenIndex,
    bool negative, ref<init int32> expressionIdResult)
    ensure return == 0 ? *expressionIdResult is init : true
{
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0]
        || Host.StandaloneTypeFacts[typeId * 3] != 0)
    {
        return 2;
    }
    int32 typeCode = Host.StandaloneTypeFacts[typeId * 3 + 1];
    if (typeCode != 0x14 && typeCode != 0x15)
    {
        return 2;
    }
    init uint64 valueBits;
    if (!TryParseStandaloneFloatLiteralBits(tokenIndex,
            typeCode, negative, ref init valueBits))
    {
        return 2;
    }
    return AppendStandaloneSourceExpression(
        bodyId, 2, typeId, 0, 0,
        EncodeWord(uint32(valueBits
            & uint64(uint32.MaxValue))),
        EncodeWord(uint32(valueBits >> 32)),
        -1, expressionFirst, ref init *expressionIdResult);
}

int32 GetStandaloneSourceUse(int32 typeId)
{
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0])
    {
        return -1;
    }
    if (Host.StandaloneTypeFacts[typeId * 3] == 1)
    {
        return 5;
    }
    return Host.StandaloneTypeFacts[typeId * 3 + 1] == 0 ? 0 : 1;
}

int32 AppendStandaloneSourceStatement(int32 bodyId,
    int32 expressionFirst, int32 kind, int32 expressionId,
    int32 locationId)
{
    int32 count = Host.StandaloneSourceStatementCount[0];
    if (count < 0
        || count >= Host.StandaloneSourceStatements.Length / 3
        || bodyId < 0
        || bodyId >= Host.StandaloneSourceBodyCount[0])
    {
        return 3;
    }
    if (expressionId >= 0)
    {
        int32 expressionIndex = expressionFirst + expressionId;
        if (expressionIndex < expressionFirst
            || expressionIndex
                >= Host.StandaloneSourceExpressionCount[0]
            || Host.StandaloneSourceExpressionUseCounts[
                expressionIndex] != 0)
        {
            return 3;
        }
        Host.StandaloneSourceExpressionUseCounts[
            expressionIndex] = 1;
    }
    int32 offset = count * 3;
    Host.StandaloneSourceStatements[offset] = kind;
    Host.StandaloneSourceStatements[offset + 1] = expressionId;
    Host.StandaloneSourceStatements[offset + 2] = locationId;
    Host.StandaloneSourceStatementParentIds[count] = -1;
    Host.StandaloneSourceStatementCount[0] = count + 1;
    return 0;
}

int32 ParseStandaloneSourceReturnBranch(int32 localCallableId,
    int32 bodyId, int32 expressionFirst, int32 returnTypeId,
    int32 tokenStart, int32 tokenEnd,
    ref<init int32> statementIdResult,
    ref<init int32> nextTokenResult)
    ensure return == 0 ? (*statementIdResult is init
        && *nextTokenResult is init) : true
{
    if (tokenStart < 0 || tokenStart >= tokenEnd
        || tokenEnd > Host.Tokens.Length / 3)
    {
        return 2;
    }

    mut int32 statementStart = tokenStart;
    mut int32 statementEnd = tokenEnd;
    mut int32 blockClose = -1;
    if (Host.Tokens[tokenStart * 3] == 48)
    {
        if (!FindStandaloneMatchingClose(tokenStart, tokenEnd,
                48, 49, ref init blockClose))
        {
            return 1;
        }
        statementStart = tokenStart + 1;
        statementEnd = blockClose;
    }
    if (statementStart >= statementEnd
        || Host.Tokens[statementStart * 3] != 19)
    {
        return 2;
    }

    init int32 semicolonToken;
    int32 semicolonStatus = FindStandaloneSourceStatementSemicolon(
        statementStart + 1, statementEnd,
        ref init semicolonToken);
    if (semicolonStatus != 0)
    {
        return semicolonStatus;
    }
    if (blockClose >= 0 && semicolonToken + 1 != statementEnd)
    {
        return 1;
    }

    int32 expressionId = -1;
    if (semicolonToken == statementStart + 1)
    {
        if (!IsStandaloneUnitType(returnTypeId))
        {
            return 2;
        }
    }
    else
    {
        if (IsStandaloneUnitType(returnTypeId))
        {
            return 2;
        }
        init int32 parsedExpressionId;
        init int32 nextExpressionToken;
        int32 expressionStatus
            = ParseStandaloneSourceExpression(localCallableId,
                bodyId, expressionFirst, returnTypeId,
                statementStart + 1, semicolonToken, 1,
                ref init parsedExpressionId,
                ref init nextExpressionToken);
        if (expressionStatus != 0)
        {
            return expressionStatus;
        }
        if (nextExpressionToken != semicolonToken)
        {
            return 1;
        }
        init bool expressionDoesNotReturn;
        int32 doesNotReturnStatus
            = TryGetStandaloneSourceExpressionDoesNotReturn(
                bodyId, parsedExpressionId,
                ref init expressionDoesNotReturn);
        if (doesNotReturnStatus != 0)
        {
            return doesNotReturnStatus;
        }
        if (expressionDoesNotReturn)
        {
            return 2;
        }
        expressionId = parsedExpressionId;
    }

    int32 appendStatus = AppendStandaloneSourceStatement(
        localCallableId, expressionFirst, 1, expressionId, -1);
    if (appendStatus != 0)
    {
        return appendStatus;
    }
    *statementIdResult
        = Host.StandaloneSourceStatementCount[0] - 1;
    *nextTokenResult
        = blockClose >= 0 ? blockClose + 1 : semicolonToken + 1;
    return 0;
}

int32 ParseStandaloneSourceAssignmentBranch(int32 localCallableId,
    int32 bodyId, int32 expressionFirst,
    int32 tokenStart, int32 tokenEnd,
    ref<init int32> statementIdResult,
    ref<init int32> nextTokenResult)
    ensure return == 0 ? (*statementIdResult is init
        && *nextTokenResult is init) : true
{
    if (tokenStart < 0 || tokenStart >= tokenEnd
        || tokenEnd > Host.Tokens.Length / 3)
    {
        return 2;
    }

    mut int32 statementStart = tokenStart;
    mut int32 statementEnd = tokenEnd;
    mut int32 blockClose = -1;
    if (Host.Tokens[tokenStart * 3] == 48)
    {
        if (!FindStandaloneMatchingClose(tokenStart, tokenEnd,
                48, 49, ref init blockClose))
        {
            return 1;
        }
        statementStart = tokenStart + 1;
        statementEnd = blockClose;
    }
    if (statementStart + 2 >= statementEnd
        || Host.Tokens[statementStart * 3] != 2
        || Host.Tokens[(statementStart + 1) * 3] != 64)
    {
        return 2;
    }
    init int32 semicolonToken;
    int32 semicolonStatus = FindStandaloneSourceStatementSemicolon(
        statementStart + 2, statementEnd, ref init semicolonToken);
    if (semicolonStatus != 0)
    {
        return semicolonStatus;
    }
    if (blockClose >= 0 && semicolonToken + 1 != statementEnd)
    {
        return 1;
    }

    int32 localId
        = FindStandaloneSourceLocal(localCallableId, statementStart);
    if (localId < 0)
    {
        return 2;
    }
    int32 localOffset = localId * 10;
    int32 typeId
        = Host.StandaloneSourceLocals[localOffset + 2];
    int32 bindingKind
        = Host.StandaloneSourceLocals[localOffset + 3];
    int32 localState
        = Host.StandaloneSourceLocalStates[localId];
    if (Host.StandaloneSourceLocals[localOffset] != bodyId
        || !((bindingKind == 1 && localState == 1)
            || (bindingKind == 2 && localState == 0)
            || bindingKind == 3)
        || GetStandaloneSourceUse(typeId) != 1)
    {
        return 2;
    }

    init int32 expressionId;
    init int32 nextExpressionToken;
    int32 expressionStatus = ParseStandaloneSourceExpression(
        localCallableId, bodyId, expressionFirst, typeId,
        statementStart + 2, semicolonToken, 1,
        ref init expressionId, ref init nextExpressionToken);
    if (expressionStatus != 0)
    {
        return expressionStatus;
    }
    if (nextExpressionToken != semicolonToken)
    {
        return 1;
    }
    init bool expressionDoesNotReturn;
    int32 doesNotReturnStatus
        = TryGetStandaloneSourceExpressionDoesNotReturn(
            bodyId, expressionId, ref init expressionDoesNotReturn);
    if (doesNotReturnStatus != 0 || expressionDoesNotReturn)
    {
        return doesNotReturnStatus != 0
            ? doesNotReturnStatus : 2;
    }
    init int32 placeId;
    int32 placeStatus = AppendStandaloneSourcePlace(
        bodyId, typeId, 2, localId, -1, ref init placeId);
    if (placeStatus != 0)
    {
        return placeStatus;
    }
    int32 appendStatus = AppendStandaloneSourceStatement(
        bodyId, expressionFirst, 5, expressionId, placeId);
    if (appendStatus != 0)
    {
        return appendStatus;
    }
    *statementIdResult
        = Host.StandaloneSourceStatementCount[0] - 1;
    *nextTokenResult
        = blockClose >= 0 ? blockClose + 1 : semicolonToken + 1;
    return 0;
}

int32 ParseStandaloneSourceIfBranch(int32 localCallableId,
    int32 bodyId, int32 expressionFirst, int32 returnTypeId,
    int32 ifNodeId, int32 ifStatementId, bool isTrueBranch,
    int32 tokenStart, int32 tokenEnd,
    ref<init int32> firstStatementIdResult,
    ref<init int32> statementCountResult,
    ref<init int32> nextTokenResult)
    ensure return == 0 ? (*firstStatementIdResult is init
        && *statementCountResult is init
        && *nextTokenResult is init) : true
{
    if (tokenStart < 0 || tokenStart >= tokenEnd)
    {
        return 2;
    }

    if (Host.Tokens[tokenStart * 3] != 48)
    {
        init int32 statementId;
        init int32 nextToken;
        int32 status = Host.Tokens[tokenStart * 3] == 19
            ? ParseStandaloneSourceReturnBranch(
                localCallableId, bodyId, expressionFirst, returnTypeId,
                tokenStart, tokenEnd, ref init statementId,
                ref init nextToken)
            : ParseStandaloneSourceAssignmentBranch(
                localCallableId, bodyId, expressionFirst,
                tokenStart, tokenEnd, ref init statementId,
                ref init nextToken);
        if (status != 0)
        {
            return status;
        }
        status = AppendStandaloneSourceIfChild(bodyId, ifNodeId,
            ifStatementId, isTrueBranch, statementId);
        if (status != 0)
        {
            return status;
        }
        *firstStatementIdResult = statementId;
        *statementCountResult = 1;
        *nextTokenResult = nextToken;
        return 0;
    }

    init int32 blockClose;
    if (!FindStandaloneMatchingClose(tokenStart, tokenEnd, 48, 49,
            ref init blockClose))
    {
        return 1;
    }

    mut int32 cursor = tokenStart + 1;
    mut int32 firstStatementId = -1;
    mut int32 statementCount = 0;
    while (cursor < blockClose)
    {
        init int32 semicolonToken;
        int32 semicolonStatus
            = FindStandaloneSourceStatementSemicolon(
                cursor, blockClose, ref init semicolonToken);
        if (semicolonStatus != 0)
        {
            return semicolonStatus;
        }

        init int32 statementId;
        init int32 nextToken;
        int32 status = Host.Tokens[cursor * 3] == 19
            ? ParseStandaloneSourceReturnBranch(
                localCallableId, bodyId, expressionFirst, returnTypeId,
                cursor, semicolonToken + 1, ref init statementId,
                ref init nextToken)
            : ParseStandaloneSourceAssignmentBranch(
                localCallableId, bodyId, expressionFirst, cursor,
                semicolonToken + 1, ref init statementId,
                ref init nextToken);
        if (status != 0)
        {
            return status;
        }
        if (nextToken != semicolonToken + 1
            || (Host.Tokens[cursor * 3] == 19
                && semicolonToken + 1 != blockClose))
        {
            return 2;
        }
        if (statementCount == 0)
        {
            firstStatementId = statementId;
        }
        status = AppendStandaloneSourceIfChild(bodyId, ifNodeId,
            ifStatementId, isTrueBranch, statementId);
        if (status != 0)
        {
            return status;
        }
        statementCount = statementCount + 1;
        cursor = nextToken;
    }

    if (statementCount == 0)
    {
        return 2;
    }
    *firstStatementIdResult = firstStatementId;
    *statementCountResult = statementCount;
    *nextTokenResult = blockClose + 1;
    return 0;
}

int32 AppendStandaloneSourceIfNode(int32 bodyId,
    ref<init int32> ifNodeIdResult)
    ensure return == 0 ? *ifNodeIdResult is init : true
{
    int32 count = Host.StandaloneSourceIfNodeCount[0];
    if (count < 0
        || count >= Host.StandaloneSourceIfNodes.Length / 5
        || bodyId < 0 || bodyId >= Host.StandaloneSourceBodyCount[0])
    {
        return 3;
    }
    int32 offset = count * 5;
    Host.StandaloneSourceIfNodes[offset] = bodyId;
    Host.StandaloneSourceIfNodes[offset + 1] = -1;
    Host.StandaloneSourceIfNodes[offset + 2] = 0;
    Host.StandaloneSourceIfNodes[offset + 3] = -1;
    Host.StandaloneSourceIfNodes[offset + 4] = 0;
    Host.StandaloneSourceIfNodeCount[0] = count + 1;
    *ifNodeIdResult = count;
    return 0;
}

int32 AppendStandaloneSourceIfChild(int32 bodyId, int32 ifNodeId,
    int32 parentStatementId, bool isTrueBranch,
    int32 childStatementId)
{
    int32 nodeCount = Host.StandaloneSourceIfNodeCount[0];
    int32 childCount = Host.StandaloneSourceIfChildCount[0];
    if (ifNodeId < 0 || ifNodeId >= nodeCount
        || childCount < 0
        || childCount >= Host.StandaloneSourceIfChildren.Length
        || parentStatementId < 0
        || parentStatementId
            >= Host.StandaloneSourceStatementCount[0]
        || childStatementId < 0
        || childStatementId
            >= Host.StandaloneSourceStatementCount[0]
        || Host.StandaloneSourceIfNodes[ifNodeId * 5] != bodyId
        || Host.StandaloneSourceStatementParentIds[
            childStatementId] != -1)
    {
        return 3;
    }
    int32 offset = ifNodeId * 5;
    int32 firstField = isTrueBranch ? 1 : 3;
    int32 countField = firstField + 1;
    int32 currentCount
        = Host.StandaloneSourceIfNodes[offset + countField];
    int32 currentFirst
        = Host.StandaloneSourceIfNodes[offset + firstField];
    if (currentCount < 0
        || (currentCount != 0
            && (currentFirst < 0
                || currentFirst + currentCount != childCount)))
    {
        return 3;
    }
    Host.StandaloneSourceIfChildren[childCount] = childStatementId;
    Host.StandaloneSourceIfChildCount[0] = childCount + 1;
    if (currentCount == 0)
    {
        Host.StandaloneSourceIfNodes[offset + firstField] = childCount;
    }
    Host.StandaloneSourceIfNodes[offset + countField]
        = currentCount + 1;
    Host.StandaloneSourceStatementParentIds[childStatementId]
        = parentStatementId;
    return 0;
}

int32 AppendStandaloneSourceExpression(int32 bodyId, int32 kind,
    int32 typeId, int32 operand0, int32 operand1,
    int32 valueLow, int32 valueHigh, int32 locationId,
    int32 expressionFirst, ref<init int32> expressionIdResult)
    ensure return == 0 ? *expressionIdResult is init : true
{
    int32 count = Host.StandaloneSourceExpressionCount[0];
    if (count < 0
        || count >= Host.StandaloneSourceExpressions.Length / 8
        || count < expressionFirst)
    {
        return 3;
    }
    int32 offset = count * 8;
    Host.StandaloneSourceExpressions[offset] = kind;
    Host.StandaloneSourceExpressions[offset + 1] = typeId;
    Host.StandaloneSourceExpressions[offset + 2] = operand0;
    Host.StandaloneSourceExpressions[offset + 3] = operand1;
    Host.StandaloneSourceExpressions[offset + 4] = valueLow;
    Host.StandaloneSourceExpressions[offset + 5] = valueHigh;
    Host.StandaloneSourceExpressions[offset + 6] = locationId;
    Host.StandaloneSourceExpressions[offset + 7] = bodyId;
    *expressionIdResult = count - expressionFirst;
    Host.StandaloneSourceExpressionCount[0] = count + 1;
    return 0;
}

int32 AppendStandaloneDirectCall(int32 bodyId, int32 targetKind,
    int32 targetIndex, int32 expectedCallableId, int32 resultTypeId,
    int32 argumentFirst, int32 argumentCount, int32 locationId,
    ref<init int32> callLocalIndexResult)
    ensure return == 0 ? *callLocalIndexResult is init : true
{
    int32 count = Host.StandaloneSourceDirectCallCount[0];
    if (count < 0
        || count >= Host.StandaloneSourceDirectCalls.Length / 7)
    {
        return 3;
    }
    init int32 resolvedCallableId;
    int32 resolveStatus = ResolveStandaloneCallTarget(
        targetKind, targetIndex, ref init resolvedCallableId);
    if (resolveStatus != 0)
    {
        return resolveStatus;
    }
    if (resolvedCallableId != expectedCallableId)
    {
        return 3;
    }

    int32 offset = count * 7;
    Host.StandaloneSourceDirectCalls[offset] = targetKind;
    Host.StandaloneSourceDirectCalls[offset + 1] = targetIndex;
    Host.StandaloneSourceDirectCalls[offset + 2] = expectedCallableId;
    Host.StandaloneSourceDirectCalls[offset + 3] = resultTypeId;
    Host.StandaloneSourceDirectCalls[offset + 4] = argumentFirst;
    Host.StandaloneSourceDirectCalls[offset + 5] = argumentCount;
    Host.StandaloneSourceDirectCalls[offset + 6] = locationId;
    *callLocalIndexResult
        = count - Host.StandaloneSourceBodies[bodyId * 12 + 5];
    Host.StandaloneSourceDirectCallCount[0] = count + 1;
    return 0;
}

bool TryMatchStandaloneTokenPathToText(int32 tokenStart,
    int32 tokenEnd, int32 textStart, int32 textLength)
{
    if (tokenStart < 0 || tokenEnd < tokenStart
        || tokenEnd > Host.Tokens.Length / 3
        || textStart < 0 || textLength <= 0
        || textStart > Host.StandaloneText.Length
        || textLength > Host.StandaloneText.Length - textStart)
    {
        return false;
    }

    mut int32 tokenIndex = tokenStart;
    mut int32 textIndex = textStart;
    int32 textEnd = textStart + textLength;
    while (textIndex < textEnd)
    {
        mut int32 componentStart = textIndex;
        while (textIndex < textEnd
            && Host.StandaloneText[textIndex] != char16(46))
        {
            textIndex = textIndex + 1;
        }
        int32 componentLength = textIndex - componentStart;
        if (componentLength <= 0
            || tokenIndex >= tokenEnd
            || Host.Tokens[tokenIndex * 3] != 2
            || !StandaloneTokenMatchesText(tokenIndex,
                componentStart, componentLength))
        {
            return false;
        }
        tokenIndex = tokenIndex + 1;
        if (textIndex < textEnd)
        {
            if (tokenIndex >= tokenEnd
                || Host.Tokens[tokenIndex * 3] != 54)
            {
                return false;
            }
            tokenIndex = tokenIndex + 1;
            textIndex = textIndex + 1;
        }
    }
    return tokenIndex == tokenEnd;
}

bool StandaloneTokenMatchesText(int32 tokenIndex,
    int32 textStart, int32 textLength)
{
    if (tokenIndex < 0
        || tokenIndex >= Host.Tokens.Length / 3
        || textStart < 0 || textLength < 0
        || textStart > Host.StandaloneText.Length
        || textLength > Host.StandaloneText.Length - textStart)
    {
        return false;
    }
    int32 tokenOffset = tokenIndex * 3;
    int32 tokenStart = Host.Tokens[tokenOffset + 1];
    int32 tokenLength = Host.Tokens[tokenOffset + 2];
    if (tokenLength > 0 && Host.Source[tokenStart] == char16(64))
    {
        tokenStart = tokenStart + 1;
        tokenLength = tokenLength - 1;
    }
    if (textLength > 0 && Host.StandaloneText[textStart] == char16(64))
    {
        textStart = textStart + 1;
        textLength = textLength - 1;
    }
    if (tokenLength != textLength)
    {
        return false;
    }
    for (mut int32 index = 0; index < tokenLength;
        index = index + 1)
    {
        if (Host.Source[tokenStart + index]
            != Host.StandaloneText[textStart + index])
        {
            return false;
        }
    }
    return tokenLength > 0;
}

bool TryGetStandaloneKeyLastSegment(int32 keyStart,
    int32 keyLength, ref<init int32> prefixLengthResult,
    ref<init int32> segmentStartResult,
    ref<init int32> segmentLengthResult)
    ensure return ? (*prefixLengthResult is init
        && *segmentStartResult is init
        && *segmentLengthResult is init) : true
{
    if (keyStart < 0 || keyLength <= 0
        || keyStart > Host.StandaloneText.Length
        || keyLength > Host.StandaloneText.Length - keyStart)
    {
        return false;
    }
    int32 keyEnd = keyStart + keyLength;
    mut int32 lastDot = -1;
    for (mut int32 index = keyStart;
        index < keyEnd;
        index = index + 1)
    {
        if (Host.StandaloneText[index] == char16(46))
        {
            lastDot = index;
        }
    }
    if (lastDot < 0)
    {
        *prefixLengthResult = 0;
        *segmentStartResult = keyStart;
        *segmentLengthResult = keyLength;
        return true;
    }
    if (lastDot == keyStart || lastDot == keyEnd - 1)
    {
        return false;
    }
    *prefixLengthResult = lastDot - keyStart;
    *segmentStartResult = lastDot + 1;
    *segmentLengthResult = keyEnd - lastDot - 1;
    return true;
}

bool TryMatchStandaloneImportedCallableName(int32 importedIndex,
    int32 nameTokenStart, int32 nameTokenEnd, int32 usingScopeId)
{
    if (importedIndex < 0
        || importedIndex
            >= Host.StandaloneSourceImportedCallableCount[0])
    {
        return false;
    }
    int32 importedOffset = importedIndex * 8;
    int32 keyStart
        = Host.StandaloneSourceImportedCallables[importedOffset + 2];
    int32 keyLength
        = Host.StandaloneSourceImportedCallables[importedOffset + 3];
    init int32 prefixLength;
    init int32 segmentStart;
    init int32 segmentLength;
    if (!TryGetStandaloneKeyLastSegment(keyStart, keyLength,
            ref init prefixLength, ref init segmentStart,
            ref init segmentLength))
    {
        return false;
    }
    if (TryMatchStandaloneTokenPathToText(nameTokenStart,
            nameTokenEnd, keyStart, keyLength))
    {
        return prefixLength != 0 || usingScopeId == -1;
    }
    if (nameTokenEnd != nameTokenStart + 1)
    {
        return false;
    }

    if (!StandaloneTokenMatchesText(nameTokenStart,
            segmentStart, segmentLength))
    {
        return false;
    }
    if (prefixLength == 0)
    {
        return usingScopeId == -1;
    }

    for (mut int32 usingIndex = 0;
        usingIndex < Host.StandaloneSourceUsingCount[0];
        usingIndex = usingIndex + 1)
    {
        int32 usingOffset = usingIndex * 3;
        if (Host.StandaloneSourceUsings[usingOffset + 2]
            != usingScopeId)
        {
            continue;
        }
        if (TryMatchStandaloneTokenPathToText(
                Host.StandaloneSourceUsings[usingOffset],
                Host.StandaloneSourceUsings[usingOffset + 1],
                keyStart, prefixLength))
        {
            return true;
        }
    }
    return false;
}

int32 CountStandaloneCallArguments(int32 openingParen,
    int32 tokenEnd, ref<init int32> closingParenResult)
    ensure return >= 0 ? *closingParenResult is init : true
{
    if (openingParen < 0 || openingParen >= tokenEnd
        || Host.Tokens[openingParen * 3] != 46)
    {
        return -1;
    }

    mut int32 nestedParenDepth = 0;
    mut int32 commaCount = 0;
    mut bool hasArgumentToken = false;
    for (mut int32 index = openingParen + 1;
        index < tokenEnd;
        index = index + 1)
    {
        int32 kind = Host.Tokens[index * 3];
        if (kind == 46)
        {
            nestedParenDepth = nestedParenDepth + 1;
            hasArgumentToken = true;
            continue;
        }
        if (kind == 47)
        {
            if (nestedParenDepth == 0)
            {
                *closingParenResult = index;
                return hasArgumentToken ? commaCount + 1 : 0;
            }
            nestedParenDepth = nestedParenDepth - 1;
            hasArgumentToken = true;
            continue;
        }
        if (kind == 53 && nestedParenDepth == 0)
        {
            commaCount = commaCount + 1;
            continue;
        }
        hasArgumentToken = true;
    }
    return -1;
}

bool TryFindStandaloneCallArgumentEnd(int32 argumentStart,
    int32 closingParen, ref<init int32> tokenEndResult)
    ensure return ? *tokenEndResult is init : true
{
    if (argumentStart < 0 || argumentStart > closingParen
        || closingParen >= Host.Tokens.Length / 3
        || Host.Tokens[closingParen * 3] != 47)
    {
        return false;
    }

    mut int32 nestedParenDepth = 0;
    for (mut int32 tokenIndex = argumentStart;
        tokenIndex < closingParen;
        tokenIndex = tokenIndex + 1)
    {
        int32 kind = Host.Tokens[tokenIndex * 3];
        if (kind == 46)
        {
            nestedParenDepth = nestedParenDepth + 1;
        }
        else if (kind == 47)
        {
            if (nestedParenDepth == 0)
            {
                return false;
            }
            nestedParenDepth = nestedParenDepth - 1;
        }
        else if (kind == 53 && nestedParenDepth == 0)
        {
            *tokenEndResult = tokenIndex;
            return true;
        }
    }
    if (nestedParenDepth != 0)
    {
        return false;
    }
    *tokenEndResult = closingParen;
    return true;
}

bool IsStandaloneCallArgumentMappingApplicable(int32 targetKind,
    int32 targetIndex, int32 openingParen, int32 closingParen,
    int32 argumentCount)
{
    init int32 expectedCallableId;
    init int32 resultTypeId;
    init int32 parameterCount;
    if (TryGetStandaloneCallableSignature(targetKind, targetIndex,
            ref init expectedCallableId, ref init resultTypeId,
            ref init parameterCount) != 0
        || expectedCallableId < 0 || resultTypeId <= 0
        || parameterCount < 0
        || parameterCount != argumentCount
        || parameterCount > Host.StandaloneSourceCallFormalSeen.Length)
    {
        return false;
    }

    for (mut int32 ordinal = 0; ordinal < parameterCount;
        ordinal = ordinal + 1)
    {
        Host.StandaloneSourceCallFormalSeen[ordinal] = 0;
    }

    mut int32 nextPositionalParameter = 0;
    mut bool hasOutOfPositionNamedArgument = false;
    mut int32 argumentStart = openingParen + 1;
    for (mut int32 sourceOrdinal = 0;
        sourceOrdinal < argumentCount;
        sourceOrdinal = sourceOrdinal + 1)
    {
        init int32 argumentEnd;
        if (!TryFindStandaloneCallArgumentEnd(argumentStart,
                closingParen, ref init argumentEnd)
            || argumentStart >= argumentEnd)
        {
            return false;
        }
        if (sourceOrdinal + 1 < argumentCount)
        {
            if (argumentEnd >= closingParen
                || Host.Tokens[argumentEnd * 3] != 53)
            {
                return false;
            }
        }
        else if (argumentEnd != closingParen)
        {
            return false;
        }

        int32 parameterOrdinal = nextPositionalParameter;
        if (argumentStart + 1 < argumentEnd
            && Host.Tokens[argumentStart * 3] == 2
            && Host.Tokens[(argumentStart + 1) * 3] == 55)
        {
            if (targetKind != 1)
            {
                return false;
            }
            init int32 namedParameterOrdinal;
            init int32 namedParameterTypeId;
            if (!TryFindStandaloneSourceParameter(targetIndex,
                    argumentStart, ref init namedParameterOrdinal,
                    ref init namedParameterTypeId))
            {
                return false;
            }
            parameterOrdinal = namedParameterOrdinal;
            if (parameterOrdinal == nextPositionalParameter)
            {
                nextPositionalParameter
                    = nextPositionalParameter + 1;
            }
            else if (parameterOrdinal > nextPositionalParameter)
            {
                hasOutOfPositionNamedArgument = true;
            }
        }
        else
        {
            if (hasOutOfPositionNamedArgument)
            {
                return false;
            }
            parameterOrdinal = nextPositionalParameter;
            nextPositionalParameter = nextPositionalParameter + 1;
        }

        if (parameterOrdinal < 0
            || parameterOrdinal >= parameterCount
            || Host.StandaloneSourceCallFormalSeen[
                parameterOrdinal] != 0)
        {
            return false;
        }
        Host.StandaloneSourceCallFormalSeen[parameterOrdinal] = 1;
        argumentStart = argumentEnd + 1;
    }

    for (mut int32 ordinal = 0; ordinal < parameterCount;
        ordinal = ordinal + 1)
    {
        if (Host.StandaloneSourceCallFormalSeen[ordinal] != 1)
        {
            return false;
        }
    }
    return true;
}

bool IsStandaloneIntegerSourceType(int32 typeCode)
    => (typeCode >= 0x06 && typeCode <= 0x09)
        || (typeCode >= 0x0B && typeCode <= 0x0E)
        || typeCode == 0x10 || typeCode == 0x11
        || typeCode == 0x03;

bool IsStandaloneFloatingSourceType(int32 typeCode)
    => typeCode == 0x14 || typeCode == 0x15;

bool CanBindStandaloneNumericLiteralType(int32 typeId,
    int32 tokenIndex)
{
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0]
        || tokenIndex < 0
        || tokenIndex >= Host.Tokens.Length / 3
        || Host.Tokens[tokenIndex * 3] != 3
        || Host.StandaloneTypeFacts[typeId * 3] != 0)
    {
        return false;
    }
    int32 typeCode = Host.StandaloneTypeFacts[typeId * 3 + 1];
    if (IsFloatingPointToken(tokenIndex))
    {
        return IsStandaloneFloatingSourceType(typeCode);
    }
    return IsStandaloneIntegerSourceType(typeCode)
        || IsStandaloneFloatingSourceType(typeCode);
}

bool IsStandaloneUnaryPlusType(int32 typeId)
{
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0]
        || Host.StandaloneTypeFacts[typeId * 3] != 0)
    {
        return false;
    }
    int32 typeCode = Host.StandaloneTypeFacts[typeId * 3 + 1];
    return (typeCode >= 0x06 && typeCode <= 0x09)
        || (typeCode >= 0x0B && typeCode <= 0x0E)
        || typeCode == 0x10 || typeCode == 0x11
        || typeCode == 0x14 || typeCode == 0x15;
}

bool IsStandaloneUnaryMinusType(int32 typeId)
    => IsStandaloneUnaryPlusType(typeId);

bool IsStandaloneLogicalNotType(int32 typeId)
{
    return typeId > 0
        && typeId <= Host.StandaloneTypeFactCount[0]
        && Host.StandaloneTypeFacts[typeId * 3] == 0
        && Host.StandaloneTypeFacts[typeId * 3 + 1] == 1;
}

bool IsStandaloneBitwiseNotType(int32 typeId)
{
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0]
        || Host.StandaloneTypeFacts[typeId * 3] != 0)
    {
        return false;
    }
    int32 typeCode = Host.StandaloneTypeFacts[typeId * 3 + 1];
    return typeCode == 0x08 || typeCode == 0x0D
        || typeCode == 0x09 || typeCode == 0x0E;
}

bool IsStandaloneNotType(int32 typeId)
{
    return IsStandaloneLogicalNotType(typeId)
        || IsStandaloneBitwiseNotType(typeId);
}

bool IsStandaloneComparisonDataType(int32 typeId)
{
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0]
        || Host.StandaloneTypeFacts[typeId * 3] != 0)
    {
        return false;
    }

    int32 typeCode
        = Host.StandaloneTypeFacts[typeId * 3 + 1];
    return typeCode == 0x03 || typeCode == 0x08
        || typeCode == 0x0D || typeCode == 0x09
        || typeCode == 0x0E || typeCode == 0x14
        || typeCode == 0x15;
}

bool IsStandaloneArithmeticType(int32 typeId)
{
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0]
        || Host.StandaloneTypeFacts[typeId * 3] != 0)
    {
        return false;
    }

    int32 typeCode
        = Host.StandaloneTypeFacts[typeId * 3 + 1];
    return typeCode == 0x08 || typeCode == 0x0D
        || typeCode == 0x09 || typeCode == 0x0E
        || typeCode == 0x14 || typeCode == 0x15;
}

bool IsStandaloneIntegerArithmeticType(int32 typeId)
{
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0]
        || Host.StandaloneTypeFacts[typeId * 3] != 0)
    {
        return false;
    }
    int32 typeCode
        = Host.StandaloneTypeFacts[typeId * 3 + 1];
    return typeCode == 0x08 || typeCode == 0x0D
        || typeCode == 0x09 || typeCode == 0x0E;
}

bool IsStandaloneComparisonEqualityType(int32 typeId)
{
    return IsStandaloneLogicalNotType(typeId)
        || IsStandaloneComparisonDataType(typeId)
        || IsStandaloneUnitType(typeId);
}

bool IsStandaloneSourceOperandEndKind(int32 kind)
{
    return kind == 2 || kind == 3 || kind == 20
        || kind == 21 || kind == 47 || kind == 86 || kind == 87;
}

int32 FindStandaloneConditionalQuestion(int32 tokenStart,
    int32 tokenEnd)
{
    if (tokenStart < 0 || tokenStart >= tokenEnd
        || tokenEnd > Host.Tokens.Length / 3)
    {
        return -1;
    }

    mut int32 parenthesisDepth = 0;
    for (mut int32 tokenIndex = tokenStart;
        tokenIndex < tokenEnd;
        tokenIndex = tokenIndex + 1)
    {
        int32 kind = Host.Tokens[tokenIndex * 3];
        if (kind == 46)
        {
            parenthesisDepth = parenthesisDepth + 1;
        }
        else if (kind == 47)
        {
            if (parenthesisDepth == 0)
            {
                return -1;
            }
            parenthesisDepth = parenthesisDepth - 1;
        }
        else if (parenthesisDepth == 0 && kind == 56
            && tokenIndex > tokenStart
            && IsStandaloneBinaryOperatorSeparated(tokenIndex))
        {
            return tokenIndex;
        }
    }

    return -1;
}

int32 FindStandaloneConditionalColon(int32 questionIndex,
    int32 tokenEnd)
{
    if (questionIndex < 0 || questionIndex >= tokenEnd
        || tokenEnd > Host.Tokens.Length / 3
        || Host.Tokens[questionIndex * 3] != 56)
    {
        return -1;
    }

    mut int32 parenthesisDepth = 0;
    mut int32 nestedConditionalDepth = 0;
    for (mut int32 tokenIndex = questionIndex + 1;
        tokenIndex < tokenEnd;
        tokenIndex = tokenIndex + 1)
    {
        int32 kind = Host.Tokens[tokenIndex * 3];
        if (kind == 46)
        {
            parenthesisDepth = parenthesisDepth + 1;
        }
        else if (kind == 47)
        {
            if (parenthesisDepth == 0)
            {
                return -1;
            }
            parenthesisDepth = parenthesisDepth - 1;
        }
        else if (parenthesisDepth == 0 && kind == 56)
        {
            nestedConditionalDepth = nestedConditionalDepth + 1;
        }
        else if (parenthesisDepth == 0 && kind == 55)
        {
            if (!IsStandaloneBinaryOperatorSeparated(tokenIndex))
            {
                return -1;
            }
            if (nestedConditionalDepth == 0)
            {
                return tokenIndex;
            }
            nestedConditionalDepth = nestedConditionalDepth - 1;
        }
    }

    return -1;
}

int32 FindStandaloneBinaryOperator(int32 tokenStart,
    int32 tokenEnd)
{
    if (tokenStart < 0 || tokenStart >= tokenEnd
        || tokenEnd > Host.Tokens.Length / 3)
    {
        return -1;
    }

    mut int32 parenthesisDepth = 0;
    mut int32 selectedIndex = -1;
    mut int32 selectedPrecedence = 9;
    for (mut int32 tokenIndex = tokenStart;
        tokenIndex < tokenEnd;
        tokenIndex = tokenIndex + 1)
    {
        int32 kind = Host.Tokens[tokenIndex * 3];
        if (kind == 46)
        {
            parenthesisDepth = parenthesisDepth + 1;
        }
        else if (kind == 47)
        {
            if (parenthesisDepth == 0)
            {
                return -1;
            }
            parenthesisDepth = parenthesisDepth - 1;
        }
        else if (parenthesisDepth == 0)
        {
            int32 precedence = kind == 73 ? 1
                : kind == 75 ? 2
                    : kind == 71 ? 3
                        : (kind == 65 || kind == 66) ? 4
                            : (kind >= 67 && kind <= 70) ? 5
                                : (kind >= 88 && kind <= 90) ? 6
                                    : (kind == 57 || kind == 58) ? 7
                                        : (kind >= 59 && kind <= 61)
                                            ? 8 : 0;
            bool hasLeftOperand = tokenIndex > tokenStart
                && IsStandaloneSourceOperandEndKind(
                    Host.Tokens[(tokenIndex - 1) * 3]);
            if (precedence != 0 && hasLeftOperand
                && precedence <= selectedPrecedence)
            {
                selectedIndex = tokenIndex;
                selectedPrecedence = precedence;
            }
        }
    }

    return parenthesisDepth == 0 ? selectedIndex : -1;
}

int32 FindStandaloneLazyBooleanOperator(int32 tokenStart,
    int32 tokenEnd)
{
    if (tokenStart < 0 || tokenStart >= tokenEnd
        || tokenEnd > Host.Tokens.Length / 3)
    {
        return -1;
    }

    mut int32 parenthesisDepth = 0;
    mut int32 selectedIndex = -1;
    mut int32 selectedPrecedence = 3;
    for (mut int32 tokenIndex = tokenStart;
        tokenIndex < tokenEnd;
        tokenIndex = tokenIndex + 1)
    {
        int32 kind = Host.Tokens[tokenIndex * 3];
        if (kind == 46)
        {
            parenthesisDepth = parenthesisDepth + 1;
        }
        else if (kind == 47)
        {
            if (parenthesisDepth == 0)
            {
                return -1;
            }
            parenthesisDepth = parenthesisDepth - 1;
        }
        else if (parenthesisDepth == 0)
        {
            int32 precedence = kind == 74 ? 1
                : kind == 72 ? 2 : 0;
            bool hasLeftOperand = tokenIndex > tokenStart
                && IsStandaloneSourceOperandEndKind(
                    Host.Tokens[(tokenIndex - 1) * 3]);
            if (precedence != 0 && hasLeftOperand
                && precedence <= selectedPrecedence
                && IsStandaloneBinaryOperatorSeparated(tokenIndex))
            {
                selectedIndex = tokenIndex;
                selectedPrecedence = precedence;
            }
        }
    }

    return parenthesisDepth == 0 ? selectedIndex : -1;
}

bool IsStandaloneWritableUpdatePlace(int32 localCallableId,
    int32 tokenStart, int32 tokenEnd, int32 expectedTypeId)
{
    if (tokenStart < 0 || tokenStart >= tokenEnd
        || tokenEnd > Host.Tokens.Length / 3)
    {
        return false;
    }
    mut int32 placeStart = tokenStart;
    mut int32 placeEnd = tokenEnd;
    while (placeStart < placeEnd
        && Host.Tokens[placeStart * 3] == 46)
    {
        init int32 closingToken;
        if (!FindStandaloneMatchingClose(
                placeStart, placeEnd, 46, 47,
                ref init closingToken)
            || closingToken + 1 != placeEnd)
        {
            return false;
        }
        placeStart = placeStart + 1;
        placeEnd = closingToken;
    }
    if (placeEnd != placeStart + 1
        || Host.Tokens[placeStart * 3] != 2)
    {
        return false;
    }
    int32 localId
        = FindStandaloneSourceLocal(localCallableId, placeStart);
    if (localId < 0)
    {
        return false;
    }
    int32 localOffset = localId * 10;
    int32 bindingKind
        = Host.StandaloneSourceLocals[localOffset + 3];
    return Host.StandaloneSourceLocals[localOffset]
            == localCallableId
        && Host.StandaloneSourceLocals[localOffset + 2]
            == expectedTypeId
        && Host.StandaloneSourceLocalStates[localId] == 1
        && (bindingKind == 1 || bindingKind == 3)
        && GetStandaloneSourceUse(expectedTypeId) != 5;
}

bool IsStandaloneBinaryOperatorSeparated(int32 tokenIndex)
{
    int32 tokenCount = Host.Tokens.Length / 3;
    if (tokenIndex <= 0 || tokenIndex >= tokenCount - 1)
    {
        return false;
    }
    return !AreStandaloneSourceTokensAdjacent(
            tokenIndex - 1, tokenIndex)
        && !AreStandaloneSourceTokensAdjacent(
            tokenIndex, tokenIndex + 1);
}

int32 GetStandaloneSourceCompoundAssignmentExpressionKind(
    int32 tokenKind)
{
    return tokenKind == 91 ? 21
        : tokenKind == 92 ? 22
            : tokenKind == 93 ? 23
                : tokenKind == 94 ? 24
                    : tokenKind == 95 ? 25
                        : tokenKind == 96 ? 12
                            : tokenKind == 97 ? 13
                                            : tokenKind == 98 ? 14
                                                : tokenKind == 99 ? 31
                                                    : tokenKind == 100 ? 32
                                                        : tokenKind == 101 ? 33 : 0;
}

bool HasStandaloneSourceTypeEvidence(int32 tokenStart,
    int32 tokenEnd)
{
    for (mut int32 tokenIndex = tokenStart;
        tokenIndex < tokenEnd;
        tokenIndex = tokenIndex + 1)
    {
        int32 kind = Host.Tokens[tokenIndex * 3];
        if (kind == 2 || kind == 20 || kind == 21
            || (kind == 46 && tokenIndex + 1 < tokenEnd
                && Host.Tokens[(tokenIndex + 1) * 3] == 47))
        {
            return true;
        }
    }
    return false;
}

int32 FindStandaloneComparisonOperandType(int32 localCallableId,
    int32 operatorKind, int32 leftStart, int32 leftEnd,
    int32 rightStart, int32 rightEnd, int32 depth,
    ref<init int32> typeIdResult)
    ensure return == 0 ? *typeIdResult is init : true
{
    if (depth > 64 || leftStart < 0 || leftStart >= leftEnd
        || rightStart < 0 || rightStart >= rightEnd
        || leftEnd > Host.Tokens.Length / 3
        || rightEnd > Host.Tokens.Length / 3
        || !HasStandaloneSourceTypeEvidence(leftStart, leftEnd)
            && !HasStandaloneSourceTypeEvidence(
                rightStart, rightEnd))
    {
        return 2;
    }

    bool equality
        = operatorKind == 65 || operatorKind == 66;
    mut int32 selectedTypeId = 0;
    for (mut int32 typeId = 1;
        typeId <= Host.StandaloneTypeFactCount[0];
        typeId = typeId + 1)
    {
        if ((equality
                ? !IsStandaloneComparisonEqualityType(typeId)
                : !IsStandaloneComparisonDataType(typeId))
            || !CanBindStandaloneSourceArgument(localCallableId,
                leftStart, leftEnd, typeId, depth + 1)
            || !CanBindStandaloneSourceArgument(localCallableId,
                rightStart, rightEnd, typeId, depth + 1))
        {
            continue;
        }
        if (selectedTypeId != 0)
        {
            return 2;
        }
        selectedTypeId = typeId;
    }

    if (selectedTypeId == 0)
    {
        return 2;
    }
    *typeIdResult = selectedTypeId;
    return 0;
}

int32 FindStandaloneArithmeticOperandType(int32 localCallableId,
    int32 leftStart, int32 leftEnd, int32 rightStart, int32 rightEnd,
    int32 depth, ref<init int32> typeIdResult)
    ensure return == 0 ? *typeIdResult is init : true
{
    if (depth > 64 || leftStart < 0 || leftStart >= leftEnd
        || rightStart < 0 || rightStart >= rightEnd
        || leftEnd > Host.Tokens.Length / 3
        || rightEnd > Host.Tokens.Length / 3
        || !HasStandaloneSourceTypeEvidence(leftStart, leftEnd)
            && !HasStandaloneSourceTypeEvidence(rightStart,
                rightEnd))
    {
        return 2;
    }

    mut int32 selectedTypeId = 0;
    for (mut int32 typeId = 1;
        typeId <= Host.StandaloneTypeFactCount[0];
        typeId = typeId + 1)
    {
        if (!IsStandaloneArithmeticType(typeId)
            || !CanBindStandaloneSourceArgument(localCallableId,
                leftStart, leftEnd, typeId, depth + 1)
            || !CanBindStandaloneSourceArgument(localCallableId,
                rightStart, rightEnd, typeId, depth + 1))
        {
            continue;
        }
        if (selectedTypeId != 0)
        {
            return 2;
        }
        selectedTypeId = typeId;
    }

    if (selectedTypeId == 0)
    {
        return 2;
    }
    *typeIdResult = selectedTypeId;
    return 0;
}

bool IsStandaloneShiftCountType(int32 typeId)
{
    return typeId > 0
        && typeId <= Host.StandaloneTypeFactCount[0]
        && Host.StandaloneTypeFacts[typeId * 3] == 0
        && (Host.StandaloneTypeFacts[typeId * 3 + 1] == 0x08
            || Host.StandaloneTypeFacts[typeId * 3 + 1] == 0x09
            || Host.StandaloneTypeFacts[typeId * 3 + 1] == 0x0D
            || Host.StandaloneTypeFacts[typeId * 3 + 1] == 0x0E);
}

bool IsStandaloneSourceShiftDataType(int32 typeId)
{
    return typeId > 0
        && typeId <= Host.StandaloneTypeFactCount[0]
        && Host.StandaloneTypeFacts[typeId * 3] == 0
        && (Host.StandaloneTypeFacts[typeId * 3 + 1] == 0x08
            || Host.StandaloneTypeFacts[typeId * 3 + 1] == 0x0D
            || Host.StandaloneTypeFacts[typeId * 3 + 1] == 0x09
            || Host.StandaloneTypeFacts[typeId * 3 + 1] == 0x0E);
}

int32 FindStandaloneShiftCountType(int32 localCallableId,
    int32 tokenStart, int32 tokenEnd, int32 depth,
    ref<init int32> typeIdResult)
    ensure return == 0 ? *typeIdResult is init : true
{
    if (depth > 64 || tokenStart < 0 || tokenStart >= tokenEnd
        || tokenEnd > Host.Tokens.Length / 3)
    {
        return 2;
    }
    mut int32 selectedTypeId = 0;
    if (!HasStandaloneSourceTypeEvidence(tokenStart, tokenEnd))
    {
        init int32 contextualTypeId;
        int32 status = InternStandaloneCallableTypeFact(
            0, 0x08, false, ref init contextualTypeId);
        if (status != 0)
        {
            return status;
        }
        selectedTypeId = contextualTypeId;
    }
    else
    {
        for (mut int32 typeId = 1;
            typeId <= Host.StandaloneTypeFactCount[0];
            typeId = typeId + 1)
        {
            if (!IsStandaloneShiftCountType(typeId)
                || !CanBindStandaloneSourceArgument(localCallableId,
                    tokenStart, tokenEnd, typeId, depth + 1))
            {
                continue;
            }
            if (selectedTypeId != 0)
            {
                return 2;
            }
            selectedTypeId = typeId;
        }
        if (selectedTypeId == 0)
        {
            return 2;
        }
    }

    if (Host.StandaloneTypeFacts[
            selectedTypeId * 3 + 1] == 0x08)
    {
        init int32 uint32TypeId;
        int32 conversionTypeStatus
            = InternStandaloneCallableTypeFact(
                0, 0x0D, false, ref init uint32TypeId);
        if (conversionTypeStatus != 0)
        {
            return conversionTypeStatus;
        }
    }

    *typeIdResult = selectedTypeId;
    return 0;
}

int32 FindStandaloneShiftOperandTypes(int32 localCallableId,
    int32 leftStart, int32 leftEnd, int32 rightStart, int32 rightEnd,
    int32 depth, ref<init int32> dataTypeIdResult,
    ref<init int32> countTypeIdResult)
    ensure return == 0 ? (*dataTypeIdResult is init
        && *countTypeIdResult is init) : true
{
    if (depth > 64 || leftStart < 0 || leftStart >= leftEnd
        || rightStart < 0 || rightStart >= rightEnd
        || leftEnd > Host.Tokens.Length / 3
        || rightEnd > Host.Tokens.Length / 3
        || !HasStandaloneSourceTypeEvidence(leftStart, leftEnd))
    {
        return 2;
    }

    mut int32 selectedDataTypeId = 0;
    for (mut int32 typeId = 1;
        typeId <= Host.StandaloneTypeFactCount[0];
        typeId = typeId + 1)
    {
        if (!IsStandaloneSourceShiftDataType(typeId)
            || !CanBindStandaloneSourceArgument(localCallableId,
                leftStart, leftEnd, typeId, depth + 1))
        {
            continue;
        }
        if (selectedDataTypeId != 0)
        {
            return 2;
        }
        selectedDataTypeId = typeId;
    }
    if (selectedDataTypeId == 0)
    {
        return 2;
    }

    init int32 selectedCountTypeId;
    int32 countTypeStatus = FindStandaloneShiftCountType(
        localCallableId, rightStart, rightEnd, depth + 1,
        ref init selectedCountTypeId);
    if (countTypeStatus != 0)
    {
        return countTypeStatus;
    }

    *dataTypeIdResult = selectedDataTypeId;
    *countTypeIdResult = selectedCountTypeId;
    return 0;
}

bool IsStandaloneSourceConstructionType(int32 typeId)
{
    if (typeId <= 0 || typeId > Host.StandaloneTypeFactCount[0]
        || Host.StandaloneTypeFacts[typeId * 3] != 0)
    {
        return false;
    }
    int32 typeCode = Host.StandaloneTypeFacts[typeId * 3 + 1];
    return typeCode == 0 || typeCode == 1
        || IsStandaloneIntegerSourceType(typeCode)
        || typeCode == 0x14 || typeCode == 0x15;
}

bool IsStandaloneSourceIsKeyword(int32 tokenIndex)
{
    init int32 kind;
    init int32 start;
    init int32 length;
    return TryReadStandaloneSourceToken(tokenIndex,
            ref init kind, ref init start, ref init length)
        && kind == 2 && length == 2
        && Host.Source[start] == char16(105)
        && Host.Source[start + 1] == char16(115);
}

bool IsStandaloneSourceIfKeyword(int32 tokenIndex)
{
    init int32 kind;
    init int32 start;
    init int32 length;
    return TryReadStandaloneSourceToken(tokenIndex,
            ref init kind, ref init start, ref init length)
        && length == 2
        && Host.Source[start] == char16(105)
        && Host.Source[start + 1] == char16(102);
}

bool IsStandaloneSourceElseKeyword(int32 tokenIndex)
{
    init int32 kind;
    init int32 start;
    init int32 length;
    return TryReadStandaloneSourceToken(tokenIndex,
            ref init kind, ref init start, ref init length)
        && length == 4
        && Host.Source[start] == char16(101)
        && Host.Source[start + 1] == char16(108)
        && Host.Source[start + 2] == char16(115)
        && Host.Source[start + 3] == char16(101);
}

int32 TryGetStandaloneInitTestPlace(int32 localCallableId,
    int32 tokenStart, int32 tokenEnd,
    ref<init int32> placeKindResult,
    ref<init int32> targetIndexResult,
    ref<init int32> stateResult)
    ensure return == 0
        ? (*placeKindResult is init && *targetIndexResult is init
            && *stateResult is init) : true
{
    if (tokenStart < 0 || tokenStart >= tokenEnd
        || tokenEnd > Host.Tokens.Length / 3)
    {
        return 2;
    }
    if (tokenEnd - tokenStart < 3
        || !IsStandaloneSourceIsKeyword(tokenEnd - 2)
        || !IsStandaloneSourceInitKeyword(tokenEnd - 1))
    {
        return 1;
    }

    mut int32 localStart = tokenStart;
    mut int32 localEnd = tokenEnd - 2;
    while (localStart < localEnd
        && Host.Tokens[localStart * 3] == 46)
    {
        init int32 closingToken;
        if (!FindStandaloneMatchingClose(localStart, localEnd,
                46, 47, ref init closingToken)
            || closingToken + 1 != localEnd)
        {
            return 2;
        }
        localStart = localStart + 1;
        localEnd = closingToken;
    }
    if (localEnd != localStart + 1
        || Host.Tokens[localStart * 3] != 2)
    {
        return 2;
    }
    int32 localId
        = FindStandaloneSourceLocal(localCallableId, localStart);
    if (localId == -2)
    {
        return 2;
    }
    if (localId >= 0)
    {
        int32 localOffset = localId * 10;
        int32 localState
            = Host.StandaloneSourceLocalStates[localId];
        if (localStart
                < Host.StandaloneSourceLocals[localOffset + 6]
            || localState < 0 || localState > 1
            || GetStandaloneSourceUse(
                Host.StandaloneSourceLocals[localOffset + 2]) == 5)
        {
            return 2;
        }
        *placeKindResult = 3;
        *targetIndexResult = localId;
        *stateResult = localState;
        return 0;
    }
    init int32 parameterOrdinal;
    init int32 parameterTypeId;
    if (!TryFindStandaloneSourceParameter(localCallableId,
            localStart, ref init parameterOrdinal,
            ref init parameterTypeId))
    {
        return 2;
    }
    *placeKindResult = 4;
    *targetIndexResult = parameterOrdinal;
    *stateResult = 1;
    return 0;
}

bool CanBindStandaloneSourceArgument(int32 localCallableId,
    int32 tokenStart, int32 tokenEnd, int32 expectedTypeId,
    int32 depth)
{
    if (depth > 64 || tokenStart < 0 || tokenStart >= tokenEnd
        || tokenEnd > Host.Tokens.Length / 3
        || expectedTypeId <= 0
        || expectedTypeId > Host.StandaloneTypeFactCount[0])
    {
        return false;
    }

    int32 conditionalQuestion
        = FindStandaloneConditionalQuestion(tokenStart, tokenEnd);
    if (conditionalQuestion >= 0)
    {
        int32 conditionalColon
            = FindStandaloneConditionalColon(
                conditionalQuestion, tokenEnd);
        if (conditionalQuestion <= tokenStart
            || conditionalQuestion + 1 >= tokenEnd
            || conditionalColon <= conditionalQuestion + 1
            || conditionalColon >= tokenEnd - 1
            || !IsStandaloneBinaryOperatorSeparated(conditionalColon)
            || depth != 0
            || GetStandaloneSourceUse(expectedTypeId) != 1
            || !IsStandaloneSourceConstructionType(expectedTypeId))
        {
            return false;
        }
        init int32 boolTypeId;
        if (InternStandaloneCallableTypeFact(
                0, 1, false, ref init boolTypeId) != 0)
        {
            return false;
        }
        return CanBindStandaloneSourceArgument(localCallableId,
                tokenStart, conditionalQuestion, boolTypeId,
                depth + 1)
            && CanBindStandaloneSourceArgument(localCallableId,
                conditionalQuestion + 1, conditionalColon,
                expectedTypeId, depth + 1)
            && CanBindStandaloneSourceArgument(localCallableId,
                conditionalColon + 1, tokenEnd,
                expectedTypeId, depth + 1);
    }

    int32 lazyBooleanOperator
        = FindStandaloneLazyBooleanOperator(tokenStart, tokenEnd);
    if (lazyBooleanOperator >= 0)
    {
        return depth == 0
            && IsStandaloneLogicalNotType(expectedTypeId)
            && lazyBooleanOperator > tokenStart
            && lazyBooleanOperator + 1 < tokenEnd
            && CanBindStandaloneSourceArgument(localCallableId,
                tokenStart, lazyBooleanOperator, expectedTypeId,
                depth + 1)
            && CanBindStandaloneSourceArgument(localCallableId,
                lazyBooleanOperator + 1, tokenEnd, expectedTypeId,
                depth + 1);
    }

    int32 binaryOperator
        = FindStandaloneBinaryOperator(tokenStart, tokenEnd);
    if (binaryOperator >= 0)
    {
        int32 operatorKind
            = Host.Tokens[binaryOperator * 3];
        if (binaryOperator <= tokenStart
            || binaryOperator + 1 >= tokenEnd
            || !IsStandaloneBinaryOperatorSeparated(binaryOperator))
        {
            return false;
        }
        if (operatorKind >= 65 && operatorKind <= 70)
        {
            if (!IsStandaloneLogicalNotType(expectedTypeId))
            {
                return false;
            }
            init int32 operandTypeId;
            return FindStandaloneComparisonOperandType(
                localCallableId, operatorKind, tokenStart,
                binaryOperator, binaryOperator + 1, tokenEnd,
                depth + 1, ref init operandTypeId) == 0;
        }
        if (operatorKind >= 88 && operatorKind <= 90)
        {
            init int32 countTypeId;
            return IsStandaloneSourceShiftDataType(expectedTypeId)
                && FindStandaloneShiftCountType(localCallableId,
                    binaryOperator + 1, tokenEnd, depth + 1,
                    ref init countTypeId) == 0
                && CanBindStandaloneSourceArgument(localCallableId,
                    tokenStart, binaryOperator, expectedTypeId,
                    depth + 1)
                && CanBindStandaloneSourceArgument(localCallableId,
                    binaryOperator + 1, tokenEnd, countTypeId,
                    depth + 1);
        }
        if (operatorKind >= 57 && operatorKind <= 61)
        {
            if (!IsStandaloneArithmeticType(expectedTypeId))
            {
                return false;
            }
            return CanBindStandaloneSourceArgument(localCallableId,
                    tokenStart, binaryOperator, expectedTypeId,
                    depth + 1)
                && CanBindStandaloneSourceArgument(localCallableId,
                    binaryOperator + 1, tokenEnd, expectedTypeId,
                    depth + 1);
        }
        if (!IsStandaloneNotType(expectedTypeId))
        {
            return false;
        }
        return CanBindStandaloneSourceArgument(localCallableId,
                tokenStart, binaryOperator, expectedTypeId, depth + 1)
            && CanBindStandaloneSourceArgument(localCallableId,
                binaryOperator + 1, tokenEnd, expectedTypeId,
                depth + 1);
    }

    init int32 initTestPlaceKind;
    init int32 initTestTargetIndex;
    init int32 initTestState;
    int32 initTestStatus = TryGetStandaloneInitTestPlace(
        localCallableId, tokenStart, tokenEnd,
        ref init initTestPlaceKind, ref init initTestTargetIndex,
        ref init initTestState);
    if (initTestStatus == 0)
    {
        return IsStandaloneLogicalNotType(expectedTypeId);
    }
    if (initTestStatus != 1)
    {
        return false;
    }

    int32 prefixUpdateKind = Host.Tokens[tokenStart * 3];
    int32 postfixTokenIndex = tokenEnd - 1;
    int32 postfixUpdateKind
        = Host.Tokens[postfixTokenIndex * 3];
    bool prefixUpdate
        = prefixUpdateKind == 86 || prefixUpdateKind == 87;
    bool postfixUpdate
        = postfixUpdateKind == 86 || postfixUpdateKind == 87;
    if (prefixUpdate || postfixUpdate)
    {
        if ((prefixUpdate && postfixUpdate)
            || !IsStandaloneArithmeticType(expectedTypeId))
        {
            return false;
        }
        int32 operandStart = prefixUpdate
            ? tokenStart + 1 : tokenStart;
        int32 operandEnd = prefixUpdate
            ? tokenEnd : postfixTokenIndex;
        if (operandStart >= operandEnd
            || (prefixUpdate
                ? !AreStandaloneSourceTokensAdjacent(
                    tokenStart, operandStart)
                : !AreStandaloneSourceTokensAdjacent(
                    postfixTokenIndex - 1, postfixTokenIndex)))
        {
            return false;
        }
        return IsStandaloneWritableUpdatePlace(localCallableId,
                operandStart, operandEnd, expectedTypeId)
            && CanBindStandaloneSourceArgument(localCallableId,
                operandStart, operandEnd, expectedTypeId, depth + 1);
    }

    int32 kind = Host.Tokens[tokenStart * 3];
    if (kind == 46)
    {
        init int32 closingToken;
        if (!FindStandaloneMatchingClose(tokenStart, tokenEnd,
                46, 47, ref init closingToken)
            || closingToken + 1 != tokenEnd)
        {
            return false;
        }
        if (closingToken == tokenStart + 1)
        {
            return IsStandaloneUnitType(expectedTypeId);
        }
        return CanBindStandaloneSourceArgument(localCallableId,
            tokenStart + 1, closingToken, expectedTypeId, depth + 1);
    }
    if (kind == 57)
    {
        int32 operandToken = tokenStart + 1;
        if (operandToken < tokenEnd
            && Host.Tokens[operandToken * 3] == 3)
        {
            if (operandToken + 1 != tokenEnd
                || !AreStandaloneSourceTokensAdjacent(
                    tokenStart, operandToken))
            {
                return false;
            }
            return Host.StandaloneTypeFacts[
                    expectedTypeId * 3] == 0
                && CanBindStandaloneNumericLiteralType(
                    expectedTypeId, operandToken);
        }
        return tokenStart + 1 < tokenEnd
            && IsStandaloneUnaryPlusType(expectedTypeId)
            && CanBindStandaloneSourceArgument(localCallableId,
                tokenStart + 1, tokenEnd, expectedTypeId, depth + 1);
    }
    if (kind == 58)
    {
        int32 operandToken = tokenStart + 1;
        if (operandToken < tokenEnd
            && Host.Tokens[operandToken * 3] == 3)
        {
            if (operandToken + 1 != tokenEnd
                || !AreStandaloneSourceTokensAdjacent(
                    tokenStart, operandToken))
            {
                return false;
            }
            return Host.StandaloneTypeFacts[
                    expectedTypeId * 3] == 0
                && CanBindStandaloneNumericLiteralType(
                    expectedTypeId, operandToken);
        }
        return tokenStart + 1 < tokenEnd
            && IsStandaloneUnaryMinusType(expectedTypeId)
            && CanBindStandaloneSourceArgument(localCallableId,
                tokenStart + 1, tokenEnd, expectedTypeId, depth + 1);
    }
    if (kind == 62)
    {
        return tokenStart + 1 < tokenEnd
            && IsStandaloneLogicalNotType(expectedTypeId)
            && CanBindStandaloneSourceArgument(localCallableId,
                tokenStart + 1, tokenEnd, expectedTypeId, depth + 1);
    }
    if (kind == 63)
    {
        return tokenStart + 1 < tokenEnd
            && IsStandaloneBitwiseNotType(expectedTypeId)
            && CanBindStandaloneSourceArgument(localCallableId,
                tokenStart + 1, tokenEnd, expectedTypeId, depth + 1);
    }
    if (kind == 3)
    {
        return tokenEnd == tokenStart + 1
            && CanBindStandaloneNumericLiteralType(
                expectedTypeId, tokenStart);
    }
    if (kind == 20 || kind == 21)
    {
        return tokenEnd == tokenStart + 1
            && Host.StandaloneTypeFacts[expectedTypeId * 3] == 0
            && Host.StandaloneTypeFacts[expectedTypeId * 3 + 1] == 1;
    }
    if (kind == 14)
    {
        if (tokenEnd != tokenStart + 3
            || Host.StandaloneTypeFacts[expectedTypeId * 3] != 1
            || !IsStandaloneSourceInitKeyword(tokenStart + 1)
            || Host.Tokens[(tokenStart + 2) * 3] != 2)
        {
            return false;
        }
        init int32 parameterOrdinal;
        init int32 parameterTypeId;
        return TryFindStandaloneSourceParameter(localCallableId,
                tokenStart + 2, ref init parameterOrdinal,
                ref init parameterTypeId)
            && parameterTypeId == expectedTypeId;
    }
    if (kind != 2)
    {
        return false;
    }

    init int32 afterConstructedType;
    init int32 constructedTypeId;
    if (ParseStandaloneSourceType(tokenStart, true, false,
            ref init afterConstructedType,
            ref init constructedTypeId) == 0
        && afterConstructedType < tokenEnd
        && Host.Tokens[afterConstructedType * 3] == 46)
    {
        if (constructedTypeId != expectedTypeId
            || !IsStandaloneSourceConstructionType(
                constructedTypeId))
        {
            return false;
        }
        init int32 closingParen;
        int32 argumentCount = CountStandaloneCallArguments(
            afterConstructedType, tokenEnd,
            ref init closingParen);
        return argumentCount == 1
            && closingParen + 1 == tokenEnd
            && CanBindStandaloneSourceArgument(localCallableId,
                afterConstructedType + 1, closingParen,
                constructedTypeId, depth + 1);
    }

    init int32 nameTokenEnd;
    init int32 openingParen;
    int32 nameStatus = FindStandaloneSourceCallNameEnd(
        tokenStart, tokenEnd, ref init nameTokenEnd,
        ref init openingParen);
    if (nameStatus < 0)
    {
        return false;
    }
    if (nameStatus == 1)
    {
        if (nameTokenEnd != tokenStart + 1
            || nameTokenEnd != tokenEnd)
        {
            return false;
        }
        int32 localId
            = FindStandaloneSourceLocal(localCallableId, tokenStart);
        if (localId == -2)
        {
            return false;
        }
        if (localId >= 0)
        {
            int32 localOffset = localId * 10;
            int32 localTypeId
                = Host.StandaloneSourceLocals[localOffset + 2];
            int32 localNameToken
                = Host.StandaloneSourceLocals[localOffset + 6];
            return tokenStart >= localNameToken
                && Host.StandaloneSourceLocalStates[localId] == 1
                && localTypeId == expectedTypeId
                && GetStandaloneSourceUse(localTypeId) != 5;
        }
        init int32 parameterOrdinal;
        init int32 parameterTypeId;
        return TryFindStandaloneSourceParameter(localCallableId,
                tokenStart, ref init parameterOrdinal,
                ref init parameterTypeId)
            && parameterTypeId == expectedTypeId
            && GetStandaloneSourceUse(parameterTypeId) != 5;
    }

    init int32 closingParen;
    int32 argumentCount = CountStandaloneCallArguments(
        openingParen, tokenEnd, ref init closingParen);
    if (argumentCount < 0 || closingParen + 1 != tokenEnd)
    {
        return false;
    }
    init int32 targetKind;
    init int32 targetIndex;
    init int32 expectedCallableId;
    init int32 resultTypeId;
    init int32 parameterCount;
    if (FindStandaloneCallCandidate(localCallableId, tokenStart,
            nameTokenEnd, openingParen, closingParen, argumentCount,
            depth, ref init targetKind, ref init targetIndex,
            ref init expectedCallableId, ref init resultTypeId,
            ref init parameterCount) != 0
        || expectedCallableId < 0 || parameterCount < 0
        || resultTypeId != expectedTypeId)
    {
        return false;
    }
    return !StandaloneCallableRequiresUnsafe(targetKind, targetIndex)
        || (Host.StandaloneSourceBodies[localCallableId * 12 + 11]
            & 1) != 0;
}

bool IsStandaloneCallCandidateApplicable(int32 localCallableId,
    int32 targetKind, int32 targetIndex, int32 openingParen,
    int32 closingParen, int32 argumentCount, int32 depth)
{
    if (depth > 64
        || !IsStandaloneCallArgumentMappingApplicable(targetKind,
            targetIndex, openingParen, closingParen, argumentCount)
        || (StandaloneCallableRequiresUnsafe(targetKind, targetIndex)
            && (Host.StandaloneSourceBodies[
                    localCallableId * 12 + 11] & 1) == 0))
    {
        return false;
    }

    mut int32 argumentStart = openingParen + 1;
    mut int32 nextPositionalParameter = 0;
    mut bool hasOutOfPositionNamedArgument = false;
    for (mut int32 sourceOrdinal = 0;
        sourceOrdinal < argumentCount;
        sourceOrdinal = sourceOrdinal + 1)
    {
        init int32 argumentEnd;
        if (!TryFindStandaloneCallArgumentEnd(argumentStart,
                closingParen, ref init argumentEnd)
            || argumentStart >= argumentEnd)
        {
            return false;
        }
        if (sourceOrdinal + 1 < argumentCount)
        {
            if (argumentEnd >= closingParen
                || Host.Tokens[argumentEnd * 3] != 53)
            {
                return false;
            }
        }
        else if (argumentEnd != closingParen)
        {
            return false;
        }

        int32 parameterOrdinal = nextPositionalParameter;
        if (argumentStart + 1 < argumentEnd
            && Host.Tokens[argumentStart * 3] == 2
            && Host.Tokens[(argumentStart + 1) * 3] == 55)
        {
            if (targetKind != 1)
            {
                return false;
            }
            init int32 namedParameterOrdinal;
            init int32 namedParameterTypeId;
            if (!TryFindStandaloneSourceParameter(targetIndex,
                    argumentStart, ref init namedParameterOrdinal,
                    ref init namedParameterTypeId))
            {
                return false;
            }
            parameterOrdinal = namedParameterOrdinal;
            if (parameterOrdinal == nextPositionalParameter)
            {
                nextPositionalParameter
                    = nextPositionalParameter + 1;
            }
            else if (parameterOrdinal > nextPositionalParameter)
            {
                hasOutOfPositionNamedArgument = true;
            }
            argumentStart = argumentStart + 2;
        }
        else
        {
            if (hasOutOfPositionNamedArgument)
            {
                return false;
            }
            parameterOrdinal = nextPositionalParameter;
            nextPositionalParameter = nextPositionalParameter + 1;
        }

        init int32 parameterTypeId;
        if (argumentStart >= argumentEnd
            || GetStandaloneCallParameterTypeId(targetKind,
                targetIndex, parameterOrdinal,
                ref init parameterTypeId) != 0
            || !CanBindStandaloneSourceArgument(localCallableId,
                argumentStart, argumentEnd, parameterTypeId,
                depth + 1))
        {
            return false;
        }
        argumentStart = argumentEnd + 1;
    }
    return true;
}

int32 FindStandaloneLocalCandidateAtNamespace(int32 namespaceIdentityId,
    int32 localCallableId, int32 nameToken, int32 openingParen,
    int32 closingParen, int32 argumentCount, int32 depth,
    ref<init int32> candidateResult,
    ref<init bool> nameFoundResult)
    ensure return == 0 ? (*candidateResult is init
        && *nameFoundResult is init) : true
{
    mut int32 matchingCandidates = 0;
    mut int32 candidateResultValue = -1;
    mut bool nameFound = false;
    for (mut int32 candidate = 0;
        candidate < Host.StandaloneLocalCallableCount[0];
        candidate = candidate + 1)
    {
        int32 infoOffset = candidate * 12;
        if (Host.StandaloneSourceCallableInfo[infoOffset + 3]
                != namespaceIdentityId
            || !StandaloneTokenMatchesText(nameToken,
                Host.StandaloneSourceCallableInfo[infoOffset],
                Host.StandaloneSourceCallableInfo[infoOffset + 1]))
        {
            continue;
        }

        nameFound = true;
        if (IsStandaloneCallCandidateApplicable(localCallableId,
                1, candidate, openingParen, closingParen,
                argumentCount, depth))
        {
            matchingCandidates = matchingCandidates + 1;
            candidateResultValue = candidate;
        }
    }

    *candidateResult = candidateResultValue;
    *nameFoundResult = nameFound;
    if (!nameFound)
    {
        return 0;
    }
    if (matchingCandidates == 0)
    {
        return 2;
    }
    return matchingCandidates == 1 ? 0 : 4;
}

int32 FindStandaloneImportedCandidateAtScope(int32 localCallableId,
    int32 nameTokenStart, int32 nameTokenEnd, int32 openingParen,
    int32 closingParen, int32 argumentCount, int32 usingScopeId,
    int32 depth,
    ref<init int32> candidateResult,
    ref<init bool> nameFoundResult)
    ensure return == 0 ? (*candidateResult is init
        && *nameFoundResult is init) : true
{
    mut int32 matchingNamedViews = 0;
    mut int32 candidateResultValue = -1;
    mut bool nameFound = false;
    for (mut int32 candidate = 0;
        candidate < Host.StandaloneSourceImportedCallableCount[0];
        candidate = candidate + 1)
    {
        if (!TryMatchStandaloneImportedCallableName(candidate,
                nameTokenStart, nameTokenEnd, usingScopeId))
        {
            continue;
        }

        nameFound = true;
        matchingNamedViews = matchingNamedViews + 1;
        candidateResultValue = candidate;
    }

    *candidateResult = candidateResultValue;
    *nameFoundResult = nameFound;
    if (!nameFound)
    {
        return 0;
    }
    if (matchingNamedViews != 1)
    {
        return 4;
    }
    if (!IsStandaloneCallCandidateApplicable(localCallableId, 2,
            candidateResultValue, openingParen, closingParen,
            argumentCount, depth))
    {
        return 2;
    }
    return 0;
}

int32 CompleteStandaloneCallCandidate(int32 targetKind,
    int32 targetIndex, int32 resultTypeId, int32 parameterCount,
    ref<init int32> targetKindResult,
    ref<init int32> targetIndexResult,
    ref<init int32> expectedCallableIdResult,
    ref<init int32> resultTypeIdResult,
    ref<init int32> parameterCountResult)
    ensure return == 0 ? (*targetKindResult is init
        && *targetIndexResult is init
        && *expectedCallableIdResult is init
        && *resultTypeIdResult is init
        && *parameterCountResult is init) : true
{
    init int32 expectedCallableId;
    int32 resolveStatus = ResolveStandaloneCallTarget(
        targetKind, targetIndex, ref init expectedCallableId);
    if (resolveStatus != 0)
    {
        return resolveStatus;
    }
    *targetKindResult = targetKind;
    *targetIndexResult = targetIndex;
    *expectedCallableIdResult = expectedCallableId;
    *resultTypeIdResult = resultTypeId;
    *parameterCountResult = parameterCount;
    return 0;
}

bool TryResolveStandaloneQualifiedNamespaceIdentity(
    int32 callerScopeId, int32 pathTokenStart, int32 pathTokenEnd,
    ref<init int32> namespaceIdentityResult)
    ensure return ? *namespaceIdentityResult is init : true
{
    if (pathTokenStart < 0 || pathTokenStart >= pathTokenEnd)
    {
        return false;
    }
    mut int32 baseIdentityId
        = GetStandaloneNamespaceIdentity(callerScopeId);
    while (baseIdentityId >= 0)
    {
        mut int32 resolvedIdentityId = baseIdentityId;
        mut int32 tokenIndex = pathTokenStart;
        mut bool matched = true;
        while (tokenIndex < pathTokenEnd)
        {
            init int32 nextIdentityId;
            if (Host.Tokens[tokenIndex * 3] != 2
                || !TryFindStandaloneNamespaceIdentity(
                    resolvedIdentityId, tokenIndex,
                    ref init nextIdentityId))
            {
                matched = false;
                break;
            }
            resolvedIdentityId = nextIdentityId;
            tokenIndex = tokenIndex + 1;
            if (tokenIndex < pathTokenEnd)
            {
                if (Host.Tokens[tokenIndex * 3] != 54)
                {
                    matched = false;
                    break;
                }
                tokenIndex = tokenIndex + 1;
            }
        }
        if (matched && tokenIndex == pathTokenEnd)
        {
            *namespaceIdentityResult = resolvedIdentityId;
            return true;
        }
        if (baseIdentityId == 0)
        {
            break;
        }
        baseIdentityId
            = GetStandaloneNamespaceParentIdentity(baseIdentityId);
    }
    return false;
}

int32 FindStandaloneCallCandidate(int32 localCallableId,
    int32 nameTokenStart, int32 nameTokenEnd, int32 openingParen,
    int32 closingParen, int32 argumentCount, int32 depth,
    ref<init int32> targetKindResult,
    ref<init int32> targetIndexResult,
    ref<init int32> expectedCallableIdResult,
    ref<init int32> resultTypeIdResult,
    ref<init int32> parameterCountResult)
    ensure return == 0 ? (*targetKindResult is init
        && *targetIndexResult is init
        && *expectedCallableIdResult is init
        && *resultTypeIdResult is init
        && *parameterCountResult is init) : true
{
    if (localCallableId < 0
        || localCallableId >= Host.StandaloneLocalCallableCount[0]
        || nameTokenStart < 0
        || nameTokenStart >= Host.Tokens.Length / 3
        || depth < 0)
    {
        return 3;
    }
    if (depth > 64)
    {
        return 2;
    }

    int32 cacheOffset = nameTokenStart * 6;
    if (cacheOffset < 0
        || cacheOffset
            > Host.StandaloneSourceCallCandidateCache.Length - 6)
    {
        return 3;
    }
    if (Host.StandaloneSourceCallCandidateCache[cacheOffset]
        == localCallableId + 1)
    {
        int32 cachedStatus
            = Host.StandaloneSourceCallCandidateCache[cacheOffset + 1];
        if (cachedStatus != 0)
        {
            return cachedStatus;
        }
        return CompleteStandaloneCallCandidate(
            Host.StandaloneSourceCallCandidateCache[cacheOffset + 2],
            Host.StandaloneSourceCallCandidateCache[cacheOffset + 3],
            Host.StandaloneSourceCallCandidateCache[cacheOffset + 4],
            Host.StandaloneSourceCallCandidateCache[cacheOffset + 5],
            ref init *targetKindResult,
            ref init *targetIndexResult,
            ref init *expectedCallableIdResult,
            ref init *resultTypeIdResult,
            ref init *parameterCountResult);
    }

    int32 status = FindStandaloneCallCandidateCore(localCallableId,
        nameTokenStart, nameTokenEnd, openingParen, closingParen,
        argumentCount, depth, ref init *targetKindResult,
        ref init *targetIndexResult,
        ref init *expectedCallableIdResult,
        ref init *resultTypeIdResult,
        ref init *parameterCountResult);
    Host.StandaloneSourceCallCandidateCache[cacheOffset + 1] = status;
    if (status == 0)
    {
        Host.StandaloneSourceCallCandidateCache[cacheOffset + 2]
            = *targetKindResult;
        Host.StandaloneSourceCallCandidateCache[cacheOffset + 3]
            = *targetIndexResult;
        Host.StandaloneSourceCallCandidateCache[cacheOffset + 4]
            = *resultTypeIdResult;
        Host.StandaloneSourceCallCandidateCache[cacheOffset + 5]
            = *parameterCountResult;
    }
    Host.StandaloneSourceCallCandidateCache[cacheOffset]
        = localCallableId + 1;
    return status;
}

int32 FindStandaloneCallCandidateCore(int32 localCallableId,
    int32 nameTokenStart, int32 nameTokenEnd, int32 openingParen,
    int32 closingParen, int32 argumentCount, int32 depth,
    ref<init int32> targetKindResult,
    ref<init int32> targetIndexResult,
    ref<init int32> expectedCallableIdResult,
    ref<init int32> resultTypeIdResult,
    ref<init int32> parameterCountResult)
    ensure return == 0 ? (*targetKindResult is init
        && *targetIndexResult is init
        && *expectedCallableIdResult is init
        && *resultTypeIdResult is init
        && *parameterCountResult is init) : true
{
    if (localCallableId < 0
        || localCallableId >= Host.StandaloneLocalCallableCount[0]
        || nameTokenStart < 0 || nameTokenStart >= nameTokenEnd
        || nameTokenEnd > Host.Tokens.Length / 3
        || openingParen < nameTokenEnd
        || closingParen <= openingParen
        || closingParen >= Host.Tokens.Length / 3
        || depth < 0)
    {
        return 3;
    }
    if (depth > 64)
    {
        return 2;
    }

    mut int32 lastDot = -1;
    for (mut int32 tokenIndex = nameTokenStart;
        tokenIndex < nameTokenEnd;
        tokenIndex = tokenIndex + 1)
    {
        if (Host.Tokens[tokenIndex * 3] == 54)
        {
            lastDot = tokenIndex;
        }
    }
    int32 methodNameToken = lastDot < 0
        ? nameTokenStart : lastDot + 1;
    if (methodNameToken >= nameTokenEnd
        || nameTokenEnd != methodNameToken + 1
        || Host.Tokens[methodNameToken * 3] != 2)
    {
        return 3;
