                            = Host.StandaloneSourceIfChildren[
                                childFirst + childIndex];
                        int32 childPlaceId
                            = Host.StandaloneSourceStatements[
                                childStatementId * 3 + 2];
                        if (childPlaceId < bodyPlaceFirst
                            || childPlaceId
                                >= bodyPlaceFirst + bodyPlaceCount
                            || Host.StandaloneSourcePlaceUseCounts[
                                childPlaceId] != 0)
                        {
                            return 3;
                        }
                        int32 childPlaceOffset = childPlaceId * 5;
                        int32 childLocalId
                            = Host.StandaloneSourcePlaces[
                                childPlaceOffset + 3];
                        int32 childTypeId
                            = Host.StandaloneSourcePlaces[
                                childPlaceOffset + 1];
                        if (Host.StandaloneSourcePlaces[
                                childPlaceOffset] != bodyId
                            || Host.StandaloneSourcePlaces[
                                childPlaceOffset + 2] != 2
                            || (joinedLocalId >= 0
                                && (joinedLocalId != childLocalId
                                    || joinedTypeId != childTypeId)))
                        {
                            return 3;
                        }
                        joinedLocalId = childLocalId;
                        joinedTypeId = childTypeId;
                    }
                    if (joinedLocalId < bodyLocalFirst
                        || joinedLocalId
                            >= bodyLocalFirst + bodyLocalCount)
                    {
                        return 3;
                    }
                    int32 localOffset = joinedLocalId * 10;
                    int32 localTypeId
                        = Host.StandaloneSourceLocals[
                            localOffset + 2];
                    int32 bindingKind
                        = Host.StandaloneSourceLocals[
                            localOffset + 3];
                    int32 localUseCount
                        = Host.StandaloneSourceLocalDeclarationUseCounts[
                            joinedLocalId];
                    if (Host.StandaloneSourceLocals[localOffset]
                            != bodyId
                        || (bindingKind != 1 && bindingKind != 2
                            && bindingKind != 3)
                        || Host.StandaloneSourceLocalStates[
                            joinedLocalId] != 1
                        || GetStandaloneSourceUse(localTypeId) != 1
                        || joinedTypeId != localTypeId
                        || (bindingKind == 2
                            && (localUseCount != 1
                                || childCount != 1))
                        || (bindingKind == 3 && localUseCount < 1))
                    {
                        return 3;
                    }
                    for (mut int32 childIndex = 0;
                        childIndex < childCount;
                        childIndex = childIndex + 1)
                    {
                        int32 childStatementId
                            = Host.StandaloneSourceIfChildren[
                                childFirst + childIndex];
                        int32 childExpressionId
                            = Host.StandaloneSourceStatements[
                                childStatementId * 3 + 1];
                        if (childExpressionId < 0
                            || childExpressionId
                                >= bodyExpressionCount
                            || Host.StandaloneSourceExpressions[
                                (bodyExpressionFirst
                                    + childExpressionId) * 8 + 1]
                                != localTypeId)
                        {
                            return 3;
                        }
                        init bool assignmentDoesNotReturn;
                        int32 assignmentStatus
                            = TryGetStandaloneSourceExpressionDoesNotReturn(
                                bodyId, childExpressionId,
                                ref init assignmentDoesNotReturn);
                        if (assignmentStatus != 0
                            || assignmentDoesNotReturn)
                        {
                            return assignmentStatus != 0
                                ? assignmentStatus : 3;
                        }
                        int32 childPlaceId
                            = Host.StandaloneSourceStatements[
                                childStatementId * 3 + 2];
                        Host.StandaloneSourcePlaceUseCounts[
                            childPlaceId] = 1;
                    }
                    if ((bindingKind == 2
                            || (bindingKind == 3 && localUseCount == 1))
                        && Host.StandaloneSourceLocalStates[
                            joinedLocalId] == 1)
                    {
                        Host.StandaloneSourceLocalDeclarationUseCounts[
                            joinedLocalId] = localUseCount + 1;
                    }
                }
                else if (bothAssignments)
                {
                    int32 joinedLocalId = -1;
                    int32 joinedTypeId = -1;
                    for (mut int32 branchIndex = 0;
                        branchIndex < 2;
                        branchIndex = branchIndex + 1)
                    {
                        int32 childFirst = branchIndex == 0
                            ? trueFirst : falseFirst;
                        int32 childCount = branchIndex == 0
                            ? trueCount : falseCount;
                        for (mut int32 childIndex = 0;
                            childIndex < childCount;
                            childIndex = childIndex + 1)
                        {
                            int32 childStatementId
                                = Host.StandaloneSourceIfChildren[
                                    childFirst + childIndex];
                            int32 childPlaceId
                                = Host.StandaloneSourceStatements[
                                    childStatementId * 3 + 2];
                            if (childPlaceId < bodyPlaceFirst
                                || childPlaceId
                                    >= bodyPlaceFirst + bodyPlaceCount
                                || Host.StandaloneSourcePlaceUseCounts[
                                    childPlaceId] != 0)
                            {
                                return 3;
                            }
                            int32 childPlaceOffset = childPlaceId * 5;
                            int32 childLocalId
                                = Host.StandaloneSourcePlaces[
                                    childPlaceOffset + 3];
                            int32 childTypeId
                                = Host.StandaloneSourcePlaces[
                                    childPlaceOffset + 1];
                            if (Host.StandaloneSourcePlaces[
                                    childPlaceOffset] != bodyId
                                || Host.StandaloneSourcePlaces[
                                    childPlaceOffset + 2] != 2
                                || (joinedLocalId >= 0
                                    && (joinedLocalId != childLocalId
                                        || joinedTypeId != childTypeId)))
                            {
                                return 3;
                            }
                            joinedLocalId = childLocalId;
                            joinedTypeId = childTypeId;
                        }
                    }
                    if (joinedLocalId < bodyLocalFirst
                        || joinedLocalId
                            >= bodyLocalFirst + bodyLocalCount)
                    {
                        return 3;
                    }
                    int32 localOffset = joinedLocalId * 10;
                    int32 localTypeId
                        = Host.StandaloneSourceLocals[
                            localOffset + 2];
                    int32 bindingKind
                        = Host.StandaloneSourceLocals[
                            localOffset + 3];
                    int32 localUseCount
                        = Host.StandaloneSourceLocalDeclarationUseCounts[
                            joinedLocalId];
                    int32 localState
                        = Host.StandaloneSourceLocalStates[joinedLocalId];
                    if (Host.StandaloneSourceLocals[
                            localOffset] != bodyId
                        || (bindingKind != 1 && bindingKind != 2
                            && bindingKind != 3)
                        || localState != 1
                        || GetStandaloneSourceUse(localTypeId) != 1
                        || joinedTypeId != localTypeId
                        || (bindingKind == 2
                            && (falseCount == 0
                                || trueCount != 1 || falseCount != 1
                                || localUseCount != 1))
                        || (bindingKind == 3 && localUseCount < 1))
                    {
                        return 3;
                    }
                    for (mut int32 branchIndex = 0;
                        branchIndex < 2;
                        branchIndex = branchIndex + 1)
                    {
                        int32 childFirst = branchIndex == 0
                            ? trueFirst : falseFirst;
                        int32 childCount = branchIndex == 0
                            ? trueCount : falseCount;
                        for (mut int32 childIndex = 0;
                            childIndex < childCount;
                            childIndex = childIndex + 1)
                        {
                            int32 childStatementId
                                = Host.StandaloneSourceIfChildren[
                                    childFirst + childIndex];
                            int32 childExpressionId
                                = Host.StandaloneSourceStatements[
                                    childStatementId * 3 + 1];
                            if (childExpressionId < 0
                                || childExpressionId
                                    >= bodyExpressionCount
                                || Host.StandaloneSourceExpressions[
                                    (bodyExpressionFirst
                                        + childExpressionId) * 8 + 1]
                                    != localTypeId)
                            {
                                return 3;
                            }
                            init bool assignmentDoesNotReturn;
                            int32 assignmentDoesNotReturnStatus
                                = TryGetStandaloneSourceExpressionDoesNotReturn(
                                    bodyId, childExpressionId,
                                    ref init assignmentDoesNotReturn);
                            if (assignmentDoesNotReturnStatus != 0
                                || assignmentDoesNotReturn)
                            {
                                return assignmentDoesNotReturnStatus != 0
                                    ? assignmentDoesNotReturnStatus : 3;
                            }
                            int32 childPlaceId
                                = Host.StandaloneSourceStatements[
                                    childStatementId * 3 + 2];
                            Host.StandaloneSourcePlaceUseCounts[
                                childPlaceId] = 1;
                        }
                    }
                    if ((bindingKind == 2
                            || (bindingKind == 3 && localUseCount == 1))
                        && localState == 1)
                    {
                        Host.StandaloneSourceLocalDeclarationUseCounts[
                            joinedLocalId] = localUseCount + 1;
                    }
                }
                continue;
            }
            if (statementKind == 1)
            {
                if (sawReturn
                    || statementIndex != bodyStatementCount - 1)
                {
                    return 3;
                }
                sawReturn = true;
            }
            if (expressionId < 0)
            {
                if (statementKind != 1
                    || !IsStandaloneUnitType(
                        Host.StandaloneSourceCallableInfo[
                            bodyId * 12 + 4]))
                {
                    return 3;
                }
                continue;
            }
            if (expressionId >= bodyExpressionCount)
            {
                return 3;
            }
            int32 expressionOffset
                = (bodyExpressionFirst + expressionId) * 8;
            int32 expressionKind
                = Host.StandaloneSourceExpressions[expressionOffset];
            int32 expressionTypeId
                = Host.StandaloneSourceExpressions[
                    expressionOffset + 1];
            if (statementKind == 1
                && expressionTypeId != returnTypeId)
            {
                return 3;
            }
            if (statementKind == 2
                && !IsStandaloneUnitType(expressionTypeId))
            {
                if (expressionKind != 3
                    && expressionKind != 6
                    && expressionKind != 8)
                {
                    return 3;
                }
                init bool expressionDoesNotReturn;
                if (TryGetStandaloneSourceExpressionDoesNotReturn(
                        bodyId, expressionId,
                        ref init expressionDoesNotReturn) != 0
                    || !expressionDoesNotReturn)
                {
                    return 3;
                }
            }
        }
        for (mut int32 localOrdinal = 0;
            localOrdinal < bodyLocalCount;
            localOrdinal = localOrdinal + 1)
        {
            int32 localId = bodyLocalFirst + localOrdinal;
            int32 bindingKind
                = Host.StandaloneSourceLocals[localId * 10 + 3];
            int32 localState
                = Host.StandaloneSourceLocalStates[localId];
            int32 localUseCount
                = Host.StandaloneSourceLocalDeclarationUseCounts[
                    localId];
            bool validLocalUseCount = bindingKind == 2
                ? (localUseCount == 1 && localState == 0)
                    || (localUseCount == 2 && localState == 1)
                : bindingKind == 3
                    ? (localUseCount == 1 && localState == 0)
                        || (localUseCount > 1 && localState == 1)
                    : localUseCount == 1 && localState == 1;
            if (!validLocalUseCount)
            {
                return 3;
            }
        }
        if (!IsStandaloneUnitType(returnTypeId) && !sawReturn)
        {
            return 3;
        }
    }
    return 0;
}

