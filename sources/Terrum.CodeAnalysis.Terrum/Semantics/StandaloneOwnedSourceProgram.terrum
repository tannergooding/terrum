    mut int32 tokenIndex = tokenStart + 1;
    while (tokenIndex < tokenEnd
        && Host.Tokens[tokenIndex * 3] == 54)
    {
        tokenIndex = tokenIndex + 1;
        if (tokenIndex >= tokenEnd
            || Host.Tokens[tokenIndex * 3] != 2)
        {
            return -1;
