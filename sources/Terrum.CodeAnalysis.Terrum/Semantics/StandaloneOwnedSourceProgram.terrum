        *typeIdResult
            = Host.StandaloneSourceParameters[row * 4 + 1];
        return 0;
    }
    if (targetKind == 2)
    {
        if (targetIndex < 0
            || targetIndex
                >= Host.StandaloneSourceImportedCallableCount[0])
        {
            return 3;
        }
        int32 importedOffset = targetIndex * 8;
        int32 rootId
            = Host.StandaloneSourceImportedCallables[
                importedOffset + 4];
        int32 rootOffset = rootId * 20;
        int32 paramCount
            = int32(Host.StandaloneResolvedRoots[rootOffset + 11]);
        if (ordinal >= paramCount)
        {
            return 3;
        }
        int32 artifactOrdinal
            = int32(Host.StandaloneResolvedRoots[rootOffset + 2]);
        int32 paramFirst
            = int32(Host.StandaloneResolvedRoots[rootOffset + 10]);
        int32 globalParameterRow
            = Host.StandaloneArtifactParameterStarts[artifactOrdinal]
                + paramFirst + ordinal;
        if (globalParameterRow <= 0
            || globalParameterRow
                >= Host.StandaloneParameterTypeIds.Length)
        {
            return 3;
        }
        *typeIdResult
            = Host.StandaloneParameterTypeIds[globalParameterRow];
        return 0;
    }
    return 3;
}

int32 FindStandaloneSourceCallNameEnd(int32 tokenStart,
    int32 tokenEnd, ref<init int32> nameTokenEndResult,
    ref<init int32> openingParenResult)
    ensure return == 0 ? (*nameTokenEndResult is init
