        init bool localNameFound;
        int32 localStatus = FindStandaloneLocalCandidateAtNamespace(
            namespaceIdentityId, localCallableId, methodNameToken,
            openingParen, closingParen, argumentCount, depth,
            ref init localCandidate, ref init localNameFound);
        if (localNameFound)
        {
            if (localStatus != 0)
            {
                return localStatus;
            }
            int32 infoOffset = localCandidate * 12;
            return CompleteStandaloneCallCandidate(1, localCandidate,
                Host.StandaloneSourceCallableInfo[infoOffset + 4],
                Host.StandaloneSourceCallableInfo[infoOffset + 6],
                ref init targetKindResult, ref init targetIndexResult,
                ref init expectedCallableIdResult,
                ref init resultTypeIdResult,
                ref init parameterCountResult);
        }

        int32 usingScopeId = FindStandaloneNamespaceScopeForIdentity(
            callerScopeId, namespaceIdentityId);
        if (usingScopeId != -2)
        {
