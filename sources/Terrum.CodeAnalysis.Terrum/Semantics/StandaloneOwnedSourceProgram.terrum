        }
        namespaceIdentityId
            = GetStandaloneNamespaceParentIdentity(namespaceIdentityId);
        if (namespaceIdentityId < 0)
        {
            return 3;
        }
    }
    return 3;
}

int32 GetStandaloneCallParameterTypeId(int32 targetKind,
    int32 targetIndex, int32 ordinal,
    ref<init int32> typeIdResult)
    ensure return == 0 ? *typeIdResult is init : true
{
    if (ordinal < 0)
    {
        return 3;
