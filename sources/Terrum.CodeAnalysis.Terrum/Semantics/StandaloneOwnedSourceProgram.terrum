            {
                return 2;
            }
            parameterOrdinal = namedParameterOrdinal;
            if (parameterOrdinal == nextPositionalParameter)
            {
                nextPositionalParameter
                    = nextPositionalParameter + 1;
            }
            else
            {
                hasOutOfPositionNamedArgument = true;
            }
            expressionToken = argumentToken + 2;
        }
        else
        {
            if (hasOutOfPositionNamedArgument)
            {
                return 2;
            }
            parameterOrdinal = nextPositionalParameter;
            nextPositionalParameter = nextPositionalParameter + 1;
        }

        init int32 parameterTypeId;
        int32 parameterTypeStatus = GetStandaloneCallParameterTypeId(
            targetKind, targetIndex, parameterOrdinal,
            ref init parameterTypeId);
        if (parameterTypeStatus != 0)
        {
            return parameterTypeStatus;
        }
        init int32 argumentExpressionId;
        init int32 nextArgumentToken;
        int32 argumentStatus = ParseStandaloneSourceExpression(
            localCallableId, bodyId, expressionFirst,
            parameterTypeId, expressionToken, closeParen,
            depth + 1, ref init argumentExpressionId,
            ref init nextArgumentToken);
        if (argumentStatus != 0)
        {
            return argumentStatus;
        }
        int32 sourceUse = GetStandaloneSourceUse(parameterTypeId);
        if (sourceUse < 0)
        {
            return 3;
        }
        int32 argumentOffset
            = (globalArgumentFirst + sourceOrdinal) * 3;
        int32 argumentIndex = globalArgumentFirst + sourceOrdinal;
        int32 expressionIndex = expressionFirst
            + argumentExpressionId;
        int32 globalCallIndex
            = bodyCallFirst + callLocalIndex;
        if (expressionIndex < expressionFirst
            || expressionIndex
                >= Host.StandaloneSourceExpressionCount[0]
            || Host.StandaloneSourceExpressionUseCounts[
                expressionIndex] != 0
            || Host.StandaloneSourceCallArgumentOwners[
                argumentIndex] != 0)
        {
            return 3;
        }
        Host.StandaloneSourceExpressionUseCounts[
            expressionIndex] = 1;
        Host.StandaloneSourceCallArgumentOwners[argumentIndex]
            = globalCallIndex + 1;
        Host.StandaloneSourceCallArguments[argumentOffset]
            = argumentExpressionId;
        Host.StandaloneSourceCallArguments[argumentOffset + 1]
            = parameterOrdinal;
        Host.StandaloneSourceCallArguments[argumentOffset + 2]
            = sourceUse;

        argumentToken = nextArgumentToken;
        if (sourceOrdinal + 1 < argumentCount)
        {
            if (argumentToken >= closeParen
                || Host.Tokens[argumentToken * 3] != 53)
            {
                return 1;
            }
            argumentToken = argumentToken + 1;
        }
    }
    if (argumentToken != closeParen)
    {
        return 1;
    }

    init int32 callExpressionId;
    int32 expressionStatus = AppendStandaloneSourceExpression(
        bodyId, 3, resultTypeId, callLocalIndex, 0,
        0, 0, -1, expressionFirst,
        ref init callExpressionId);
    if (expressionStatus != 0)
    {
        return expressionStatus;
    }
    int32 globalCallIndex = bodyCallFirst + callLocalIndex;
    if (globalCallIndex < bodyCallFirst
        || globalCallIndex
            >= Host.StandaloneSourceDirectCallCount[0]
        || Host.StandaloneSourceDirectCallUseCounts[
            globalCallIndex] != 0)
    {
        return 3;
    }
    Host.StandaloneSourceDirectCallUseCounts[globalCallIndex] = 1;
    *expressionIdResult = callExpressionId;
    *nextTokenResult = closeParen + 1;
    return 0;
}

bool StandaloneCallableRequiresUnsafe(int32 targetKind,
    int32 targetIndex)
{
    if (targetKind == 2)
    {
        int32 importedOffset = targetIndex * 8;
        int32 expectedCallableId
            = Host.StandaloneSourceImportedCallables[
                importedOffset + 4];
        return (Host.StandaloneCallableEffects[
            expectedCallableId] & 4) != 0;
    }
    if (targetKind == 1)
    {
        return (Host.StandaloneSourceCallableInfo[
            targetIndex * 12 + 10] & 2) != 0;
    }
    return true;
}

bool IsStandaloneIntegerLiteralInRange(int32 typeCode,
    uint64 magnitude)
{
    if (typeCode == 0x06)
    {
        return magnitude <= uint64(0x7F);
    }
    if (typeCode == 0x07)
    {
        return magnitude <= uint64(0x7FFF);
    }
    if (typeCode == 0x08)
    {
        return magnitude <= uint64(0x7FFF_FFFF);
    }
    if (typeCode == 0x0D)
    {
        return magnitude <= uint64(0xFFFF_FFFF);
    }
    if (typeCode == 0x0B)
    {
        return magnitude <= uint64(0xFF);
    }
    if (typeCode == 0x0C)
    {
        return magnitude <= uint64(0xFFFF);
    }
    if (typeCode == 0x09)
    {
        return magnitude <= uint64(0x7FFF_FFFF_FFFF_FFFF);
    }
    if (typeCode == 0x0E)
    {
        return true;
    }
    if (typeCode == 0x10)
    {
        return magnitude <= uint64(0x7FFF_FFFF_FFFF_FFFF);
    }
    if (typeCode == 0x11)
    {
        return true;
    }
    if (typeCode == 0x03)
    {
        return magnitude <= uint64(0xFFFF);
    }
    return false;
}

bool IsStandaloneBasedIntegerLiteralInRange(int32 typeCode,
    uint64 bitPattern)
{
    if (typeCode == 0x06 || typeCode == 0x0B)
    {
        return bitPattern <= uint64(0xFF);
    }
    if (typeCode == 0x03 || typeCode == 0x07
        || typeCode == 0x0C)
    {
        return bitPattern <= uint64(0xFFFF);
    }
    if (typeCode == 0x08 || typeCode == 0x0D)
    {
        return bitPattern <= uint64(0xFFFF_FFFF);
    }
    return typeCode == 0x09 || typeCode == 0x0E
        || typeCode == 0x10 || typeCode == 0x11;
}

bool IsStandaloneNegativeIntegerLiteralInRange(int32 typeCode,
    uint64 magnitude)
{
    if (magnitude == 0)
    {
        return IsStandaloneIntegerLiteralInRange(typeCode, 0);
    }
    if (typeCode == 0x06)
    {
        return magnitude <= uint64(0x80);
    }
    if (typeCode == 0x07)
    {
        return magnitude <= uint64(0x8000);
    }
    if (typeCode == 0x08)
    {
        return magnitude <= uint64(0x8000_0000);
    }
    return (typeCode == 0x09 || typeCode == 0x10)
        && magnitude <= uint64(0x8000_0000_0000_0000);
}

bool IsStandaloneIntegerValueBitsValid(int32 typeCode,
    uint64 valueBits)
{
    if (typeCode == 1)
    {
        return valueBits <= 1;
    }
    if (typeCode == 0x03 || typeCode == 0x0C)
    {
        return valueBits <= uint64(0xFFFF);
    }
    if (typeCode == 0x06 || typeCode == 0x0B)
    {
        return valueBits <= uint64(0xFF);
    }
    if (typeCode == 0x07)
    {
        return valueBits <= uint64(0xFFFF);
    }
    if (typeCode == 0x08 || typeCode == 0x0D)
    {
        return valueBits <= uint64(0xFFFF_FFFF);
    }
    return typeCode == 0x09 || typeCode == 0x0E
        || typeCode == 0x10 || typeCode == 0x11;
}

bool IsStandaloneScalarLiteralBitsValid(int32 typeCode,
    uint64 valueBits)
{
    if (typeCode == 0x14)
    {
        return valueBits <= uint64(0xFFFF_FFFF);
    }
    if (typeCode == 0x15)
    {
        return true;
    }
    return IsStandaloneIntegerValueBitsValid(typeCode, valueBits);
}

int32 TryGetStandaloneCallableSignature(int32 targetKind,
    int32 targetIndex, ref<init int32> expectedCallableIdResult,
    ref<init int32> resultTypeIdResult,
    ref<init int32> parameterCountResult)
    ensure return == 0 ? (*expectedCallableIdResult is init
        && *resultTypeIdResult is init
        && *parameterCountResult is init) : true
{
    if (targetKind == 1)
    {
        if (targetIndex < 0
            || targetIndex >= Host.StandaloneLocalCallableCount[0])
        {
            return 3;
        }
        int32 infoOffset = targetIndex * 12;
        *expectedCallableIdResult
            = Host.StandaloneLocalCallables[targetIndex * 3 + 1];
        *resultTypeIdResult
            = Host.StandaloneSourceCallableInfo[infoOffset + 4];
        *parameterCountResult
            = Host.StandaloneSourceCallableInfo[infoOffset + 6];
        return 0;
    }
    if (targetKind == 2)
    {
        if (targetIndex < 0
            || targetIndex
                >= Host.StandaloneSourceImportedCallableCount[0])
        {
            return 3;
        }
        int32 importedOffset = targetIndex * 8;
        int32 rootId
            = Host.StandaloneSourceImportedCallables[
                importedOffset + 4];
        if (rootId < 0
            || rootId >= Host.StandaloneResolvedRootCount[0])
        {
            return 3;
        }
        *expectedCallableIdResult = rootId;
        *resultTypeIdResult
            = Host.StandaloneCallableTypeIds[rootId];
        *parameterCountResult
            = int32(Host.StandaloneResolvedRoots[rootId * 20 + 11]);
        return 0;
    }
    return 3;
}

int32 VerifyStandaloneDirectCalls()
{
    int32 localCallableCount
        = Host.StandaloneLocalCallableCount[0];
    int32 directCallCount
        = Host.StandaloneSourceDirectCallCount[0];
    int32 argumentCount
        = Host.StandaloneSourceCallArgumentCount[0];
    int32 expressionCount
        = Host.StandaloneSourceExpressionCount[0];
    int32 statementCount
        = Host.StandaloneSourceStatementCount[0];
    int32 localCount
        = Host.StandaloneSourceLocalCount[0];
    int32 placeCount
        = Host.StandaloneSourcePlaceCount[0];
    int32 lexicalScopeCount
        = Host.StandaloneSourceLexicalScopeCount[0];
    if (Host.StandaloneSourceBodyCount[0] != localCallableCount
        || localCallableCount <= 0
        || localCallableCount
            > Host.StandaloneLocalCallables.Length / 3
        || lexicalScopeCount < 0
        || lexicalScopeCount
            > Host.StandaloneSourceLexicalScopes.Length / 5
        || lexicalScopeCount
            > Host.StandaloneSourceBodyScopeIds.Length
        || localCount < 0
        || localCount > Host.StandaloneSourceLocals.Length / 10
        || localCount
            > Host.StandaloneSourceLocalStates.Length
        || localCount
            > Host.StandaloneSourceLocalDeclarationUseCounts.Length
        || placeCount < 0
        || placeCount > Host.StandaloneSourcePlaces.Length / 5
        || placeCount > Host.StandaloneSourcePlaceUseCounts.Length
        || directCallCount < 0
        || directCallCount
            > Host.StandaloneSourceDirectCalls.Length / 7
        || argumentCount < 0
        || argumentCount
            > Host.StandaloneSourceCallArguments.Length / 3
        || argumentCount
            > Host.StandaloneSourceCallArgumentOwners.Length
        || expressionCount < 0
        || expressionCount
            > Host.StandaloneSourceExpressions.Length / 8
        || expressionCount
            > Host.StandaloneSourceExpressionUseCounts.Length
        || directCallCount
            > Host.StandaloneSourceDirectCallUseCounts.Length
        || statementCount < 0
        || statementCount
            > Host.StandaloneSourceStatements.Length / 3)
    {
        return 3;
    }

    for (mut int32 localId = 0;
        localId < localCount;
        localId = localId + 1)
    {
        Host.StandaloneSourceLocalDeclarationUseCounts[localId] = 0;
    }
    for (mut int32 placeId = 0;
        placeId < placeCount;
        placeId = placeId + 1)
    {
        Host.StandaloneSourcePlaceUseCounts[placeId] = 0;
    }

    for (mut int32 bodyId = 0;
        bodyId < localCallableCount;
        bodyId = bodyId + 1)
    {
        int32 bodyOffset = bodyId * 12;
        int32 bodyLocalRangeOffset = bodyId * 2;
        int32 bodyLocalFirst
            = Host.StandaloneSourceBodyLocalRanges[
                bodyLocalRangeOffset];
        int32 bodyLocalCount
            = Host.StandaloneSourceBodyLocalRanges[
                bodyLocalRangeOffset + 1];
        int32 bodyScopeId
            = Host.StandaloneSourceBodyScopeIds[bodyId];
        int32 bodyPlaceRangeOffset = bodyId * 2;
        int32 bodyPlaceFirst
            = Host.StandaloneSourceBodyPlaceRanges[
                bodyPlaceRangeOffset];
        int32 bodyPlaceCount
            = Host.StandaloneSourceBodyPlaceRanges[
                bodyPlaceRangeOffset + 1];
        if (Host.StandaloneSourceBodies[bodyOffset] != bodyId
            || Host.StandaloneSourceBodies[bodyOffset + 3] < 0
            || Host.StandaloneSourceBodies[bodyOffset + 4] < 0
            || Host.StandaloneSourceBodies[bodyOffset + 5] < 0
            || Host.StandaloneSourceBodies[bodyOffset + 6] < 0
            || Host.StandaloneSourceBodies[bodyOffset + 7] < 0
            || Host.StandaloneSourceBodies[bodyOffset + 8] < 0
            || Host.StandaloneSourceBodies[bodyOffset + 9] < 0
            || Host.StandaloneSourceBodies[bodyOffset + 10] < 0
            || bodyLocalFirst < 0 || bodyLocalCount < 0
            || bodyLocalFirst > localCount - bodyLocalCount
            || bodyScopeId < 0
            || bodyScopeId >= lexicalScopeCount
            || bodyPlaceFirst < 0 || bodyPlaceCount < 0
            || bodyPlaceFirst > placeCount - bodyPlaceCount)
        {
            return 3;
        }
        int32 scopeOffset = bodyScopeId * 5;
        if (Host.StandaloneSourceLexicalScopes[scopeOffset] != -1
            || Host.StandaloneSourceLexicalScopes[
                scopeOffset + 1] != bodyId
            || Host.StandaloneSourceLexicalScopes[
                scopeOffset + 2] != bodyLocalFirst
            || Host.StandaloneSourceLexicalScopes[
                scopeOffset + 3] != bodyLocalCount
            || Host.StandaloneSourceLexicalScopes[
                scopeOffset + 4]
                != Host.StandaloneSourceBodies[bodyOffset + 11])
        {
            return 3;
        }
        for (mut int32 localOrdinal = 0;
            localOrdinal < bodyLocalCount;
            localOrdinal = localOrdinal + 1)
        {
            int32 localId = bodyLocalFirst + localOrdinal;
            int32 localOffset = localId * 10;
            int32 typeId
                = Host.StandaloneSourceLocals[localOffset + 2];
            int32 bindingKind
                = Host.StandaloneSourceLocals[localOffset + 3];
            int32 nameStart
                = Host.StandaloneSourceLocals[localOffset + 4];
            int32 nameLength
                = Host.StandaloneSourceLocals[localOffset + 5];
            int32 nameToken
                = Host.StandaloneSourceLocals[localOffset + 6];
            int32 declarationStart
                = Host.StandaloneSourceLocals[localOffset + 7];
            int32 initializerStart
                = Host.StandaloneSourceLocals[localOffset + 8];
            int32 semicolonToken
                = Host.StandaloneSourceLocals[localOffset + 9];
            if (Host.StandaloneSourceLocals[localOffset] != bodyId
                || Host.StandaloneSourceLocals[localOffset + 1]
                    != bodyScopeId
                || typeId <= 0
                || typeId > Host.StandaloneTypeFactCount[0]
                || GetStandaloneSourceUse(typeId) == 5
                || bindingKind < 0 || bindingKind > 3
                || nameStart < 0 || nameLength <= 0
                || nameStart > Host.Source.Length - nameLength
                || nameToken < 0
                || nameToken >= Host.Tokens.Length / 3
                || Host.Tokens[nameToken * 3] != 2
                || Host.Tokens[nameToken * 3 + 1] != nameStart
                || Host.Tokens[nameToken * 3 + 2] != nameLength
                || declarationStart < 0
                || declarationStart > nameToken
                || ((initializerStart < 0)
                    != (bindingKind == 2 || bindingKind == 3))
                || (initializerStart >= 0
                    && (initializerStart <= nameToken
                        || initializerStart >= semicolonToken))
                || semicolonToken <= nameToken
                || semicolonToken >= Host.Tokens.Length / 3
                || Host.Tokens[semicolonToken * 3] != 52
                || ((bindingKind == 2 || bindingKind == 3)
                    && semicolonToken != nameToken + 1)
                || Host.StandaloneSourceLocalStates[localId] < 0
                || Host.StandaloneSourceLocalStates[localId] > 1
                || ((bindingKind == 0 || bindingKind == 1)
                    && Host.StandaloneSourceLocalStates[localId] != 1))
            {
                return 3;
            }
        }
        for (mut int32 placeOrdinal = 0;
            placeOrdinal < bodyPlaceCount;
            placeOrdinal = placeOrdinal + 1)
        {
            int32 placeId = bodyPlaceFirst + placeOrdinal;
            int32 placeOffset = placeId * 5;
            int32 placeTypeId
                = Host.StandaloneSourcePlaces[placeOffset + 1];
            int32 placeKind
                = Host.StandaloneSourcePlaces[placeOffset + 2];
            int32 targetIndex
                = Host.StandaloneSourcePlaces[placeOffset + 3];
            if (Host.StandaloneSourcePlaces[placeOffset] != bodyId
                || placeTypeId <= 0
                || placeTypeId > Host.StandaloneTypeFactCount[0]
                || placeKind < 1 || placeKind > 4
                || targetIndex < 0
                || Host.StandaloneSourcePlaces[placeOffset + 4] != -1)
            {
                return 3;
            }
            if (placeKind == 4)
            {
                int32 parameterFirst
                    = Host.StandaloneSourceCallableInfo[
                        bodyId * 12 + 5];
                int32 parameterCount
                    = Host.StandaloneSourceCallableInfo[
                        bodyId * 12 + 6];
                int32 parameterRow
                    = parameterFirst + targetIndex;
                if (targetIndex >= parameterCount
                    || parameterRow < 0
                    || parameterRow
                        >= Host.StandaloneSourceParameterCount[0]
                    || Host.StandaloneSourceParameters[
                        parameterRow * 4] != bodyId
                    || Host.StandaloneSourceParameters[
                        parameterRow * 4 + 1] != placeTypeId)
                {
                    return 3;
                }
            }
            else
            {
                if (targetIndex < bodyLocalFirst
                    || targetIndex >= bodyLocalFirst + bodyLocalCount)
                {
                    return 3;
                }
                int32 localOffset = targetIndex * 10;
                int32 localState
                    = Host.StandaloneSourceLocalStates[targetIndex];
                int32 localBindingKind
                    = Host.StandaloneSourceLocals[
                        localOffset + 3];
                if (Host.StandaloneSourceLocals[localOffset] != bodyId
                    || Host.StandaloneSourceLocals[
                        localOffset + 2] != placeTypeId
                    || localState < 0 || localState > 1
                    || (placeKind == 1 && localState != 1)
                    || (placeKind == 2 && localBindingKind == 0)
                    || GetStandaloneSourceUse(placeTypeId) == 5)
                {
                    return 3;
                }
            }
        }
        int32 bodyExpressionFirst
            = Host.StandaloneSourceBodies[bodyOffset + 3];
        int32 bodyExpressionCount
            = Host.StandaloneSourceBodies[bodyOffset + 4];
        int32 bodyCallFirst
            = Host.StandaloneSourceBodies[bodyOffset + 5];
        int32 bodyCallCount
            = Host.StandaloneSourceBodies[bodyOffset + 6];
        int32 bodyArgumentFirst
            = Host.StandaloneSourceBodies[bodyOffset + 7];
        int32 bodyArgumentCount
            = Host.StandaloneSourceBodies[bodyOffset + 8];
        int32 bodyStatementFirst
            = Host.StandaloneSourceBodies[bodyOffset + 9];
        int32 bodyStatementCount
            = Host.StandaloneSourceBodies[bodyOffset + 10];
        if (bodyExpressionFirst
                > expressionCount - bodyExpressionCount
            || bodyCallFirst > directCallCount - bodyCallCount
            || bodyArgumentFirst > argumentCount - bodyArgumentCount
            || bodyStatementFirst > statementCount - bodyStatementCount)
        {
            return 3;
        }

        int32 previousArgumentEnd = 0;
        for (mut int32 callLocalIndex = 0;
            callLocalIndex < bodyCallCount;
            callLocalIndex = callLocalIndex + 1)
        {
            int32 callIndex = bodyCallFirst + callLocalIndex;
            int32 callOffset = callIndex * 7;
            int32 targetKind
                = Host.StandaloneSourceDirectCalls[callOffset];
            int32 targetIndex
                = Host.StandaloneSourceDirectCalls[callOffset + 1];
            int32 expectedCallableId
                = Host.StandaloneSourceDirectCalls[callOffset + 2];
            int32 resultTypeId
                = Host.StandaloneSourceDirectCalls[callOffset + 3];
            int32 callArgumentFirst
                = Host.StandaloneSourceDirectCalls[callOffset + 4];
            int32 callArgumentCount
                = Host.StandaloneSourceDirectCalls[callOffset + 5];
            if (callArgumentFirst < previousArgumentEnd
                || callArgumentCount < 0
                || callArgumentFirst
                    > bodyArgumentCount - callArgumentCount)
            {
                return 3;
            }
            previousArgumentEnd
                = callArgumentFirst + callArgumentCount;

            init int32 resolvedCallableId;
            init int32 targetResultTypeId;
            init int32 parameterCount;
            int32 targetStatus = TryGetStandaloneCallableSignature(
                targetKind, targetIndex,
                ref init resolvedCallableId,
                ref init targetResultTypeId,
                ref init parameterCount);
            if (targetStatus != 0)
            {
                return targetStatus;
            }
            if (resolvedCallableId != expectedCallableId
                || targetResultTypeId != resultTypeId
                || parameterCount != callArgumentCount
                || parameterCount
                    > Host.StandaloneSourceCallFormalSeen.Length)
            {
                return 3;
            }

            for (mut int32 ordinal = 0;
                ordinal < parameterCount;
                ordinal = ordinal + 1)
            {
                Host.StandaloneSourceCallFormalSeen[ordinal] = 0;
            }
            for (mut int32 ordinal = 0;
                ordinal < callArgumentCount;
                ordinal = ordinal + 1)
            {
                int32 argumentIndex
                    = bodyArgumentFirst + callArgumentFirst + ordinal;
                int32 argumentOffset = argumentIndex * 3;
                int32 expressionId
                    = Host.StandaloneSourceCallArguments[
                        argumentOffset];
                int32 parameterOrdinal
                    = Host.StandaloneSourceCallArguments[
                        argumentOffset + 1];
                int32 sourceUse
                    = Host.StandaloneSourceCallArguments[
                        argumentOffset + 2];
                if (parameterOrdinal < 0
                    || parameterOrdinal >= parameterCount
                    || (targetKind == 2
                        && parameterOrdinal != ordinal)
                    || Host.StandaloneSourceCallFormalSeen[
                        parameterOrdinal] != 0
                    || expressionId < 0
                    || expressionId >= bodyExpressionCount
                    || Host.StandaloneSourceCallArgumentOwners[
                        argumentIndex] != callIndex + 1)
                {
                    return 3;
                }
                Host.StandaloneSourceCallFormalSeen[
                    parameterOrdinal] = 1;

                init int32 parameterTypeId;
                int32 parameterStatus
                    = GetStandaloneCallParameterTypeId(
                        targetKind, targetIndex, parameterOrdinal,
                        ref init parameterTypeId);
                if (parameterStatus != 0)
                {
                    return parameterStatus;
                }
                int32 expressionOffset
                    = (bodyExpressionFirst + expressionId) * 8;
                int32 expressionTypeId
                    = Host.StandaloneSourceExpressions[
                        expressionOffset + 1];
                int32 expectedSourceUse
                    = GetStandaloneSourceUse(parameterTypeId);
                if (expressionTypeId != parameterTypeId
                    || sourceUse != expectedSourceUse)
                {
                    return 3;
                }
            }
            for (mut int32 ordinal = 0;
                ordinal < parameterCount;
                ordinal = ordinal + 1)
            {
                if (Host.StandaloneSourceCallFormalSeen[ordinal] != 1)
                {
                    return 3;
                }
            }
        }
        if (previousArgumentEnd != bodyArgumentCount)
        {
            return 3;
        }

        int32 returnTypeId
            = Host.StandaloneSourceCallableInfo[bodyId * 12 + 4];
        int32 parameterFirst
            = Host.StandaloneSourceCallableInfo[bodyId * 12 + 5];
        int32 parameterCount
            = Host.StandaloneSourceCallableInfo[bodyId * 12 + 6];
        for (mut int32 expressionLocal = 0;
            expressionLocal < bodyExpressionCount;
            expressionLocal = expressionLocal + 1)
        {
            int32 expressionIndex
                = bodyExpressionFirst + expressionLocal;
            int32 expressionOffset = expressionIndex * 8;
            int32 expressionKind
                = Host.StandaloneSourceExpressions[expressionOffset];
            int32 expressionTypeId
                = Host.StandaloneSourceExpressions[
                    expressionOffset + 1];
            int32 operand0
                = Host.StandaloneSourceExpressions[
                    expressionOffset + 2];
            int32 expressionBodyId
                = Host.StandaloneSourceExpressions[
                    expressionOffset + 7];
            if (expressionBodyId != bodyId
                || expressionTypeId <= 0
                || expressionTypeId
                    > Host.StandaloneTypeFactCount[0]
                || Host.StandaloneSourceExpressionUseCounts[
                    expressionIndex] != 1)
            {
                return 3;
            }

            if (expressionKind == 1 || expressionKind == 4)
            {
                if (operand0 < 0 || operand0 >= parameterCount)
                {
                    return 3;
                }
                int32 parameterOffset
                    = (parameterFirst + operand0) * 4;
                if (Host.StandaloneSourceParameters[
                        parameterOffset] != bodyId
                    || Host.StandaloneSourceParameters[
                        parameterOffset + 1] != expressionTypeId
                    || (expressionKind == 4)
                        != (Host.StandaloneTypeFacts[
                            expressionTypeId * 3] == 1)
                    || (expressionKind == 1
                        && GetStandaloneSourceUse(
                            expressionTypeId) == 5))
                {
                    return 3;
                }
            }
            else if (expressionKind == 5)
            {
                if (operand0 < bodyPlaceFirst
                    || operand0 >= bodyPlaceFirst + bodyPlaceCount
                    || Host.StandaloneSourcePlaceUseCounts[
                        operand0] != 0)
                {
                    return 3;
                }
                int32 placeOffset = operand0 * 5;
                if (Host.StandaloneSourcePlaces[placeOffset] != bodyId
                    || Host.StandaloneSourcePlaces[
                        placeOffset + 1] != expressionTypeId
                    || Host.StandaloneSourcePlaces[
                        placeOffset + 2] != 1
                    || GetStandaloneSourceUse(expressionTypeId) == 5)
                {
                    return 3;
                }
                Host.StandaloneSourcePlaceUseCounts[operand0] = 1;
            }
            else if (expressionKind == 26)
            {
                int32 stateAtTest
                    = Host.StandaloneSourceExpressions[
                        expressionOffset + 3];
                int32 placeKind
                    = operand0 >= 0
                        && operand0 < placeCount
                        ? Host.StandaloneSourcePlaces[
                            operand0 * 5 + 2] : 0;
                int32 localId
                    = operand0 >= 0
                        && operand0 < placeCount
                        ? Host.StandaloneSourcePlaces[
                            operand0 * 5 + 3] : -1;
                if (Host.StandaloneTypeFacts[
                        expressionTypeId * 3] != 0
