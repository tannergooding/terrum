namespace Terrum.CodeAnalysis;

// Trivia records retain scanner-6 kind/start/length/leading-token-index words.
public unique struct TokenTriviaSnapshot
{
    private OwnedInt32Buffer _records;
    private int32 _count;

    private TokenTriviaSnapshot(OwnedInt32Buffer records, int32 count)
    {
        _records = move records;
        _count = count;
    }

    public int32 GetCount()
    {
        return _count;
    }

    public bool TryGet(int32 index, init ref<Token> trivia, init ref<int32> owner)
    {
        if (index < 0 || index >= _count)
        {
            return false;
        }

        int32 offset = index * 4;
        require SourceRange.TryCreate(_records.Read(offset + 1), _records.Read(offset + 2),
            init var range);
        trivia = new Token(_records.Read(offset), range);
        owner = _records.Read(offset + 3);
        return true;
    }

    public static bool TryBuild(int32 tokenCount, init ref<TokenTriviaSnapshot> result)
    {
        if (Host.Diagnostics[0] != 0 || tokenCount < 1
            || tokenCount > Host.Tokens.Length / 3
            || Host.Trivia.Length < 1)
        {
            return false;
        }

        int32 count = Host.Trivia[0];
        if (count < 0 || count > (Host.Trivia.Length - 1) / 4
            || count > int32.MaxValue / 4
            || !OwnedInt32Buffer.TryCreate(count * 4, out var created))
        {
            return false;
        }

        mut OwnedInt32Buffer records = move created;
        mut int32 position = 0;
        mut int32 nextTrivia = 0;
        mut int32 previousEnd = 0;
        for (mut int32 index = 0; index < tokenCount; index = index + 1)
        {
            int32 tokenOffset = index * 3;
            int32 tokenKind = Host.Tokens[tokenOffset];
            int32 tokenStart = Host.Tokens[tokenOffset + 1];
            int32 tokenLength = Host.Tokens[tokenOffset + 2];
            if (!IsValidScannerToken(index, tokenCount, previousEnd,
                tokenKind, tokenStart, tokenLength))
            {
                return false;
            }

            while (nextTrivia < count && Host.Trivia[nextTrivia * 4 + 4] == index)
            {
                int32 offset = nextTrivia * 4 + 1;
                int32 kind = Host.Trivia[offset];
                int32 start = Host.Trivia[offset + 1];
                int32 length = Host.Trivia[offset + 2];
                if (kind < 0 || kind > 5 || length <= 0 || start != position
                    || length > tokenStart - start)
                {
                    return false;
                }
                require records.TryAppend(kind);
                require records.TryAppend(start);
                require records.TryAppend(length);
                require records.TryAppend(index);
                position = start + length;
                nextTrivia = nextTrivia + 1;
            }
            if (tokenStart != position)
            {
                return false;
            }
            position = tokenStart + tokenLength;
            previousEnd = position;
        }
        if (nextTrivia != count || position != Host.Source.Length)
        {
            return false;
        }

        result = new TokenTriviaSnapshot(move records, count);
        return true;
    }

    internal static bool TryBuildLossless(int32 tokenCount,
        init ref<TokenSnapshot> tokens, init ref<TokenTriviaSnapshot> trivia)
    {
        if (Host.Diagnostics[0] != 0 || tokenCount < 1
            || tokenCount > int32.MaxValue / 3
            || tokenCount > Host.Tokens.Length / 3
            || Host.Trivia.Length < 1)
        {
            return false;
        }

        int32 triviaCount = Host.Trivia[0];
        if (triviaCount < 0 || triviaCount > (Host.Trivia.Length - 1) / 4
            || triviaCount > int32.MaxValue / 4)
        {
            return false;
        }

        if (!OwnedInt32Buffer.TryCreate(tokenCount * 3, out var tokenRecords))
        {
            return false;
        }
        mut OwnedInt32Buffer ownedTokens = move tokenRecords;
        if (!OwnedInt32Buffer.TryCreate(triviaCount * 4, out var triviaRecords))
        {
            return false;
        }
        mut OwnedInt32Buffer ownedTrivia = move triviaRecords;
        mut int32 position = 0;
        mut int32 nextTrivia = 0;
        mut int32 previousEnd = 0;
        for (mut int32 index = 0; index < tokenCount; index = index + 1)
        {
            int32 tokenOffset = index * 3;
            int32 tokenKind = Host.Tokens[tokenOffset];
            int32 tokenStart = Host.Tokens[tokenOffset + 1];
            int32 tokenLength = Host.Tokens[tokenOffset + 2];
            if (tokenStart < previousEnd || tokenStart > Host.Source.Length
                || tokenLength < 0 || tokenLength > Host.Source.Length - tokenStart)
            {
                return false;
            }
            require ownedTokens.TryAppend(tokenKind);
            require ownedTokens.TryAppend(tokenStart);
            require ownedTokens.TryAppend(tokenLength);

            while (nextTrivia < triviaCount
                && Host.Trivia[nextTrivia * 4 + 4] == index)
            {
                int32 offset = nextTrivia * 4 + 1;
                int32 kind = Host.Trivia[offset];
                int32 start = Host.Trivia[offset + 1];
                int32 length = Host.Trivia[offset + 2];
                if (kind < 0 || kind > 5 || length <= 0 || start != position
                    || length > tokenStart - start)
                {
                    return false;
                }
                require ownedTrivia.TryAppend(kind);
                require ownedTrivia.TryAppend(start);
                require ownedTrivia.TryAppend(length);
                require ownedTrivia.TryAppend(index);
                position = start + length;
                nextTrivia = nextTrivia + 1;
            }
            if (tokenStart != position)
            {
                return false;
            }
            position = tokenStart + tokenLength;
            previousEnd = position;
        }
        if (nextTrivia != triviaCount || position != Host.Source.Length)
        {
            return false;
        }

        if (!TokenSnapshot.TryCreateValidated(move ownedTokens, tokenCount, init var scanned))
        {
            return false;
        }
        mut TokenTriviaSnapshot leading = new TokenTriviaSnapshot(move ownedTrivia, triviaCount);
        tokens = move scanned;
        trivia = move leading;
        return true;
    }
}

bool TryBuildLossless(int32 count,
    init ref<TokenSnapshot> tokens, init ref<TokenTriviaSnapshot> trivia)
{
    return TokenTriviaSnapshot.TryBuildLossless(count, init tokens, init trivia);
}

bool TryScanLossless(init ref<TokenSnapshot> tokens, init ref<TokenTriviaSnapshot> trivia)
{
    return TryBuildLossless(Scan(), init tokens, init trivia);
}
