namespace Terrum.CodeAnalysis;

// This component scans source token boundaries and lexical diagnostics.
// Host buffers are bounded capabilities, not source-constructible pointers.
bool IsIdentifierStart(int32 scalar)
{
    if (scalar == 95)
    {
        return true;
    }

    mut int32 low = 0;
    mut int32 high = Host.XidStart.Length / 2;
    while (low < high)
    {
        int32 middle = low + (high - low) / 2;
        if (scalar < Host.XidStart[middle * 2])
        {
            high = middle;
        }
        else if (scalar > Host.XidStart[middle * 2 + 1])
        {
            low = middle + 1;
        }
        else
        {
            return true;
        }
    }

    return false;
}

bool IsIdentifierContinue(int32 scalar)
{
    if (scalar == 95)
    {
        return true;
    }

    mut int32 low = 0;
    mut int32 high = Host.XidContinue.Length / 2;
    while (low < high)
    {
        int32 middle = low + (high - low) / 2;
        if (scalar < Host.XidContinue[middle * 2])
        {
            high = middle;
        }
        else if (scalar > Host.XidContinue[middle * 2 + 1])
        {
            low = middle + 1;
        }
        else
        {
            return true;
        }
    }

    return false;
}

bool IsSourceWhitespace(int32 unit)
{
    return unit == 9 || unit == 10 || unit == 11 || unit == 12 || unit == 13
        || unit == 32 || unit == 133 || unit == 160 || unit == 5760
        || (unit >= 8192 && unit <= 8202) || unit == 8232 || unit == 8233
        || unit == 8239 || unit == 8287 || unit == 12288;
}

int32 PeekUnit(int32 at)
{
    if (at >= Host.Source.Length)
    {
        return -1;
    }

    return int32(Host.Source[at]);
}

bool IsDigit(int32 unit)
{
    return unit >= 48 && unit <= 57;
}

bool IsHex(int32 unit)
{
    return IsDigit(unit) || (unit >= 65 && unit <= 70)
        || (unit >= 97 && unit <= 102);
}

bool IsNewline(int32 unit)
{
    return unit == 10 || unit == 13 || unit == 133 || unit == 8232 || unit == 8233;
}

bool CanAppendRecord(int32 count, int32 capacity, int32 width, int32 prefix)
{
    // Bound the count before computing an index near the maximum host-buffer length.
    return count >= 0 && capacity >= prefix && count < (capacity - prefix) / width;
}

void Report(int32 code, int32 start, int32 length)
{
    int32 count = Host.Diagnostics[0];
    require CanAppendRecord(count, Host.Diagnostics.Length, 3, 1);
    int32 record = count * 3 + 1;
    Host.Diagnostics[record] = code;
    Host.Diagnostics[record + 1] = start;
    Host.Diagnostics[record + 2] = length;
    Host.Diagnostics[0] = count + 1;
}

int32 ReadCommentScalar(int32 at, init ref<int32> width)
{
    int32 unit = PeekUnit(at);
    width = 1;
    if (unit < 55296 || unit > 57343)
    {
        return unit;
    }

    int32 scalar = ReadUtf16Scalar(at, Host.Source.Length);
    if (scalar == -1)
    {
        Report(1, at, 1);
    }
    else if (scalar >= 65536)
    {
        width = 2;
    }
    return scalar;
}

int32 SkipBlockComment(int32 start, int32 slashes)
{
    mut int32 at = start + slashes;
    while (PeekUnit(at) == 42)
    {
        at = at + 1;
    }
    int32 stars = at - start - slashes;
    while (at < Host.Source.Length)
    {
        if (PeekUnit(at) != 42)
        {
            int32 scalar = ReadCommentScalar(at, init var width);
            at = at + width;
            continue;
        }

        int32 fence = at;
        while (PeekUnit(at) == 42)
        {
            at = at + 1;
        }
        mut bool suffix = true;
        for (mut int32 index = 0; index < slashes; index = index + 1)
        {
            if (PeekUnit(at + index) != 47)
            {
                suffix = false;
            }
        }
        if (suffix && at - fence == stars)
        {
            return at + slashes;
        }
        if (suffix && at - fence > stars)
        {
            Report(10, fence, at - fence + slashes);
            // Keep the rejected whole fence opaque; its suffix cannot restart a closer.
            at = at + slashes;
        }
    }

    Report(3, start, at - start);
    return at;
}

void PublishTrivia(int32 kind, int32 start, int32 end, int32 owner)
{
    int32 count = Host.Trivia[0];
    require CanAppendRecord(count, Host.Trivia.Length, 4, 1);
    int32 record = count * 4 + 1;
    Host.Trivia[record] = kind;
    Host.Trivia[record + 1] = start;
    Host.Trivia[record + 2] = end - start;
    Host.Trivia[record + 3] = owner;
    Host.Trivia[0] = count + 1;
}

int32 SkipTrivia(int32 initial, int32 owner)
{
    mut int32 at = initial;
    while (at < Host.Source.Length)
    {
        int32 current = PeekUnit(at);
        int32 start = at;
        if (IsNewline(current))
        {
            at = at + 1;
            if (current == 13 && PeekUnit(at) == 10)
            {
                at = at + 1;
            }
            PublishTrivia(1, start, at, owner);
        }
        else if (IsSourceWhitespace(current))
        {
            at = at + 1;
            while (at < Host.Source.Length)
            {
                int32 unit = PeekUnit(at);
                if (!IsSourceWhitespace(unit) || IsNewline(unit))
                {
                    break;
                }
                at = at + 1;
            }
            PublishTrivia(0, start, at, owner);
        }
        else if (current == 47 && PeekUnit(at + 1) == 47 && PeekUnit(at + 2) == 42)
        {
            at = SkipBlockComment(start, 2);
            PublishTrivia(5, start, at, owner);
        }
        else if (current == 47 && PeekUnit(at + 1) == 47)
        {
            bool documentation = PeekUnit(at + 2) == 47;
            at = at + 2;
            while (at < Host.Source.Length)
            {
                int32 scalar = ReadCommentScalar(at, init var width);
                if (IsNewline(scalar))
                {
                    break;
                }
                at = at + width;
            }
            if (documentation)
            {
                PublishTrivia(4, start, at, owner);
            }
            else
            {
                PublishTrivia(2, start, at, owner);
            }
        }
        else if (current == 47 && PeekUnit(at + 1) == 42)
        {
            at = SkipBlockComment(start, 1);
            PublishTrivia(3, start, at, owner);
        }

        else
        {
            break;
        }
    }

    return at;
}

bool IsEscapeKeyword(int32 start, int32 length)
{
    mut int32 entry = 0;
    while (Host.EscapeKeywords[entry] != -1)
    {
        int32 size = Host.EscapeKeywords[entry + 1];
        if (size == length)
        {
            mut int32 offset = 0;
            while (offset < size
                && int32(Host.Source[start + offset]) == Host.EscapeKeywords[entry + 2 + offset])
            {
                offset = offset + 1;
            }
            if (offset == size)
            {
                return true;
            }
        }
        entry = entry + 2 + size;
    }
    return false;
}

int32 KeywordKind(int32 start, int32 length)
{
    int32 firstUnit = int32(Host.Source[start]);
    mut int32 entry = 0;
    while (Host.Keywords[entry] != -1)
    {
        int32 kind = Host.Keywords[entry];
        int32 size = Host.Keywords[entry + 1];
        if (size == length && firstUnit == Host.Keywords[entry + 2])
        {
            mut int32 offset = 1;
            while (offset < size && int32(Host.Source[start + offset]) == Host.Keywords[entry + 2 + offset])
            {
                offset = offset + 1;
            }
            if (offset == size)
            {
                return kind;
            }
        }
        entry = entry + size + 2;
    }
    return 2;
}

// Three low bits hold widths through four code units (>>>=); retain the longest match.
int32 OperatorMatch(int32 start)
{
    int32 firstUnit = int32(Host.Source[start]);
    mut int32 entry = 0;
    mut int32 best = -1;
    mut int32 width = 0;
    while (Host.Operators[entry] != -1)
    {
        int32 kind = Host.Operators[entry];
        int32 size = Host.Operators[entry + 1];
        if (size > width && size <= Host.Source.Length - start
            && firstUnit == Host.Operators[entry + 2])
        {
            mut int32 offset = 1;
            while (offset < size && int32(Host.Source[start + offset]) == Host.Operators[entry + 2 + offset])
            {
                offset = offset + 1;
            }
            if (offset == size)
            {
                width = size;
                best = kind * 8 + size;
            }
        }
        entry = entry + size + 2;
    }
    return best;
}

bool IsPunctuationGlyph(int32 unit)
{
    if (unit < 33 || unit > 63)
    {
        return unit == 94 || unit == 124 || unit == 126;
    }
    // Bits relative to ASCII '!' encode !%&*+-./:<=>?; the guard bounds the shift.
    return ((0x7A007631 >> (unit - 33)) & 1) != 0;
}

bool TryReadPunctuationRun(int32 start, init ref<int32> end, init ref<bool> typeBoundary)
{
    mut int32 at = start;
    mut bool deferred = true;
    while (at < Host.Source.Length)
    {
        int32 unit = PeekUnit(at);
        if (!IsPunctuationGlyph(unit))
        {
            break;
        }
        if (unit == 47 && (PeekUnit(at + 1) == 47 || PeekUnit(at + 1) == 42))
        {
            break;
        }
        if (unit != 62 && unit != 63)
        {
            deferred = false;
        }
        at = at + 1;
    }
    end = at;
    typeBoundary = deferred;
    return at != start;
}

bool IsUnsupportedPunctuationRun(int32 start, int32 length)
{
    if (length == 2)
    {
        return (PeekUnit(start) == 46 || PeekUnit(start) == 63)
            && PeekUnit(start + 1) == 46;
    }
    return length == 3 && PeekUnit(start) == 46
        && PeekUnit(start + 1) == 46 && PeekUnit(start + 2) == 94;
}

int32 ReadNumericTag(int32 at)
{
    int32 first = PeekUnit(at);
    if (first != 105 && first != 117 && first != 102)
    {
        return 0;
    }

    int32 second = PeekUnit(at + 1);
    mut int32 length = 0;
    if (second == 56 && first != 102)
    {
        length = 2;
    }
    else if (second == 49 && PeekUnit(at + 2) == 50 && PeekUnit(at + 3) == 56)
    {
        length = 4;
    }
    else if ((second == 49 && PeekUnit(at + 2) == 54)
        || (second == 51 && PeekUnit(at + 2) == 50)
        || (second == 54 && PeekUnit(at + 2) == 52))
    {
        length = 3;
    }

    if (length != 0 && at + length < Host.Source.Length)
    {
        int32 next = ReadUtf16Scalar(at + length, Host.Source.Length);
        if (next == 95 || IsIdentifierContinue(next))
        {
            return 0;
        }
    }

    return length;
}

int32 IntegerTag(int32 at, int32 length)
{
    int32 first = PeekUnit(at);
    if (first != 105 && first != 117)
    {
        return 0;
    }

    mut int32 width = 0;
    if (length == 2)
    {
        width = 1;
    }
    else if (length == 4)
    {
        width = 5;
    }
    else if (PeekUnit(at + 1) == 49)
    {
        width = 2;
    }
    else if (PeekUnit(at + 1) == 51)
    {
        width = 3;
    }
    else
    {
        width = 4;
    }

    if (first == 117)
    {
        width = width + 5;
    }

    return width;
}

int32 EncodeWord(uint32 word)
{
    if (word <= uint32(int32.MaxValue))
    {
        return int32(word);
    }

    return int32(int64(word) - 4294967296);
}

void PublishInteger(int32 tokenIndex, bool overflow, uint64 magnitude, int32 tag)
{
    int32 count = Host.IntegerValues[0];
    require CanAppendRecord(count, Host.IntegerValues.Length, 5, 1);
    mut uint64 payload = magnitude;
    if (overflow)
    {
        payload = 0;
    }

    // The low half is masked and the shifted high half is already uint32-bounded.
    uint32 low = uint32(payload & uint64(uint32.MaxValue));
    uint32 high = uint32(payload >> 32);
    int32 record = count * 5 + 1;
    Host.IntegerValues[record] = tokenIndex;
    Host.IntegerValues[record + 1] = 0;
    if (overflow)
    {
        Host.IntegerValues[record + 1] = 1;
    }
    Host.IntegerValues[record + 2] = EncodeWord(low);
    Host.IntegerValues[record + 3] = EncodeWord(high);
    Host.IntegerValues[record + 4] = tag;
    Host.IntegerValues[0] = count + 1;
}

bool IsBasedDigit(int32 value, int32 radix)
{
    if (radix == 16)
    {
        return IsHex(value);
    }
    if (radix == 10)
    {
        return IsDigit(value);
    }
    return value == 48 || value == 49;
}

int32 ScanDigitRun(int32 initial, int32 radix, bool allowInitialSeparators)
{
    mut int32 at = initial;
    mut bool hasDigit = false;
    while (true)
    {
        int32 unit = PeekUnit(at);
        if (IsBasedDigit(unit, radix))
        {
            hasDigit = true;
            at = at + 1;
            continue;
        }
        if (unit != 95)
        {
            break;
        }

        mut int32 next = at + 1;
        while (PeekUnit(next) == 95)
        {
            next = next + 1;
        }
        if ((hasDigit || allowInitialSeparators) && IsBasedDigit(PeekUnit(next), radix))
        {
            at = next;
            continue;
        }
        if (hasDigit)
        {
            Report(9, at, next - at);
        }
        break;
    }
    return at;
}

int32 SkipDigitSeparators(int32 at, int32 radix)
{
    mut int32 next = at + 1;
    while (PeekUnit(next) == 95)
    {
        next = next + 1;
    }
    if (IsBasedDigit(PeekUnit(next), radix))
    {
        return next;
    }
    Report(9, at, next - at);
    return at;
}

int32 ScanBasedNumber(int32 initial, int32 tokenIndex, int32 radix)
{
    mut int32 at = initial + 2;
    if (PeekUnit(at) == 95)
    {
        mut int32 next = at;
        while (PeekUnit(next) == 95)
        {
            next = next + 1;
        }
        if (IsBasedDigit(PeekUnit(next), radix))
        {
            at = next;
        }
    }
    if (!IsBasedDigit(PeekUnit(at), radix))
    {
        if (radix == 16)
        {
            Report(7, initial, 2);
        }
        else
        {
            Report(8, initial, 2);
        }
        return at;
    }

    mut uint64 magnitude = 0;
    mut bool overflow = false;
    uint64 wideRadix = uint64(radix);
    uint64 cutoff = uint64.MaxValue / wideRadix;
    uint64 finalDigit = uint64.MaxValue - cutoff * wideRadix;
    while (true)
    {
        int32 unit = PeekUnit(at);
        if (unit == 95)
        {
            int32 next = SkipDigitSeparators(at, radix);
            if (next == at)
            {
                break;
            }
            at = next;
            continue;
        }
        if (!IsBasedDigit(unit, radix))
        {
            break;
        }
        if (!overflow)
        {
            mut uint64 digit = uint64(unit - 48);
            if (radix == 16)
            {
                digit = uint64(HexValue(unit));
            }
            if (digit >= wideRadix || magnitude > cutoff
                || (magnitude == cutoff && digit > finalDigit))
            {
                overflow = true;
            }
            else
            {
                magnitude = magnitude * wideRadix + digit;
            }
        }
        at = at + 1;
    }

    mut int32 tag = 0;
    int32 tagLength = ReadNumericTag(at);
    if (tagLength != 0)
    {
        Report(6, at, tagLength);
        tag = IntegerTag(at, tagLength);
        at = at + tagLength;
    }
    if (tagLength == 0 || tag != 0)
    {
        PublishInteger(tokenIndex, overflow, magnitude, tag);
    }
    return at;
}

int32 ScanHexNumber(int32 initial, int32 tokenIndex)
{
    mut int32 at = initial + 2;
    mut int32 integerEnd = at;
    mut int32 integerDigits = 0;
    mut int32 invalidSeparatorStart = -1;
    mut int32 invalidSeparatorLength = 0;
    mut bool validFloatMantissa = true;
    mut uint64 magnitude = 0;
    mut bool overflow = false;
    uint64 cutoff = uint64.MaxValue / 16;
    uint64 finalDigit = uint64.MaxValue - cutoff * 16;
    while (true)
    {
        int32 unit = PeekUnit(at);
        if (IsHex(unit))
        {
            integerDigits = integerDigits + 1;
            mut uint64 digit = uint64(HexValue(unit));
            if (!overflow)
            {
                if (magnitude > cutoff || (magnitude == cutoff && digit > finalDigit))
                {
                    overflow = true;
                }
                else
                {
                    magnitude = magnitude * 16 + digit;
                }
            }
            at = at + 1;
            integerEnd = at;
        }
        else if (unit == 95)
        {
            int32 separatorStart = at;
            mut int32 next = at;
            while (PeekUnit(next) == 95)
            {
                next = next + 1;
            }
            if (IsHex(PeekUnit(next)))
            {
                at = next;
                continue;
            }
            validFloatMantissa = false;
            if (integerDigits != 0)
            {
                invalidSeparatorStart = separatorStart;
                invalidSeparatorLength = next - separatorStart;
            }
            break;
        }
        else
        {
            break;
        }
    }

    mut int32 floatAt = at;
    mut int32 floatDigits = integerDigits;
    if (validFloatMantissa && PeekUnit(at) == 46)
    {
        at = at + 1;
        mut bool segmentHasDigit = false;
        while (true)
        {
            int32 unit = PeekUnit(at);
            if (IsHex(unit))
            {
                floatDigits = floatDigits + 1;
                segmentHasDigit = true;
                at = at + 1;
            }
            else if (unit == 95)
            {
                mut int32 next = at;
                while (PeekUnit(next) == 95)
                {
                    next = next + 1;
                }
                if (!segmentHasDigit || !IsHex(PeekUnit(next)))
                {
                    validFloatMantissa = false;
                    break;
                }
                at = next;
            }
            else
            {
                break;
            }
        }
        floatAt = at;
    }

    if (validFloatMantissa && floatDigits != 0
        && (PeekUnit(floatAt) == 112 || PeekUnit(floatAt) == 80))
    {
        mut int32 exponentDigit = floatAt + 1;
        if (PeekUnit(exponentDigit) == 43 || PeekUnit(exponentDigit) == 45)
        {
            exponentDigit = exponentDigit + 1;
        }
        if (IsDigit(PeekUnit(exponentDigit)))
        {
            return ScanHexFloat(floatAt);
        }
    }

    at = integerEnd;
    if (invalidSeparatorStart >= 0)
    {
        Report(9, invalidSeparatorStart, invalidSeparatorLength);
    }
    if (integerDigits == 0)
    {
        Report(7, initial, 2);
        return at;
    }

    mut int32 tag = 0;
    int32 tagLength = ReadNumericTag(at);
    if (tagLength != 0)
    {
        Report(6, at, tagLength);
        tag = IntegerTag(at, tagLength);
        at = at + tagLength;
    }
    if (tagLength == 0 || tag != 0)
    {
        PublishInteger(tokenIndex, overflow, magnitude, tag);
    }
    return at;
}

int32 ScanHexFloat(int32 exponentPosition)
{
    mut int32 at = exponentPosition + 1;
    if (PeekUnit(at) == 43 || PeekUnit(at) == 45)
    {
        at = at + 1;
    }
    at = ScanDigitRun(at, 10, false);

    int32 tagLength = ReadNumericTag(at);
    if (tagLength != 0)
    {
        Report(6, at, tagLength);
        at = at + tagLength;
    }
    return at;
}

int32 ScanNumber(int32 initial, int32 tokenIndex)
{
    if (PeekUnit(initial) == 48)
    {
        int32 prefix = PeekUnit(initial + 1);
        if (prefix == 120 || prefix == 88)
        {
            return ScanHexNumber(initial, tokenIndex);
        }
        if (prefix == 98 || prefix == 66)
        {
            return ScanBasedNumber(initial, tokenIndex, 2);
        }
    }

    mut int32 at = initial;
    int32 start = at;
    mut uint64 magnitude = 0;
    mut bool overflow = false;
    uint64 cutoff = uint64.MaxValue / 10;
    uint64 finalDigit = uint64.MaxValue - cutoff * 10;
    while (true)
    {
        int32 unit = PeekUnit(at);
        if (unit == 95)
        {
            int32 next = SkipDigitSeparators(at, 10);
            if (next == at)
            {
                break;
            }
            at = next;
            continue;
        }
        if (!IsDigit(unit))
        {
            break;
        }
        if (!overflow)
        {
            uint64 digit = uint64(unit - 48);
            if (magnitude > cutoff || (magnitude == cutoff && digit > finalDigit))
            {
                overflow = true;
            }
            else
            {
                magnitude = magnitude * 10 + digit;
            }
        }
        at = at + 1;
    }

    mut bool integerForm = true;
    if (PeekUnit(at) == 46 && IsDigit(PeekUnit(at + 1)))
    {
        integerForm = false;
        at = at + 1;
        while (true)
        {
            int32 unit = PeekUnit(at);
            if (unit == 95)
            {
                int32 next = SkipDigitSeparators(at, 10);
                if (next == at)
                {
                    break;
                }
                at = next;
                continue;
            }
            if (!IsDigit(unit))
            {
                break;
            }
            at = at + 1;
        }
    }

    mut bool malformedExponent = false;
    int32 exponent = PeekUnit(at);
    if (exponent == 101 || exponent == 69)
    {
        int32 following = at + 1;
        bool signedExponent = PeekUnit(following) == 43 || PeekUnit(following) == 45;
        mut bool nextStartsIdentifier = false;
        if (following < Host.Source.Length)
        {
            int32 scalar = ReadUtf16Scalar(following, Host.Source.Length);
            nextStartsIdentifier = scalar == 95 || IsIdentifierContinue(scalar);
        }

        mut int32 exponentDigits = following;
        if (signedExponent)
        {
            exponentDigits = exponentDigits + 1;
        }

        if (IsDigit(PeekUnit(exponentDigits))
            || signedExponent || !nextStartsIdentifier)
        {
            integerForm = false;
            at = following;
            if (signedExponent)
            {
                at = at + 1;
            }

            if (!IsDigit(PeekUnit(at)))
            {
                malformedExponent = true;
                Report(4, start, at - start);
            }
            else
            {
                while (true)
                {
                    int32 unit = PeekUnit(at);
                    if (unit == 95)
                    {
                        int32 next = SkipDigitSeparators(at, 10);
                        if (next == at)
                        {
                            break;
                        }
                        at = next;
                        continue;
                    }
                    if (!IsDigit(unit))
                    {
                        break;
                    }
                    at = at + 1;
                }
            }
        }
    }

    mut int32 tag = 0;
    if (!malformedExponent)
    {
        int32 tagLength = ReadNumericTag(at);
        if (tagLength != 0)
        {
            Report(6, at, tagLength);
            tag = IntegerTag(at, tagLength);
            if (tag == 0)
            {
                integerForm = false;
            }
            at = at + tagLength;
        }
    }

    if (integerForm)
    {
        PublishInteger(tokenIndex, overflow, magnitude, tag);
    }

    return at;
}

int32 HexValue(int32 unit)
{
    if (IsDigit(unit))
    {
        return unit - 48;
    }

    if (unit >= 65 && unit <= 70)
    {
        return unit - 65 + 10;
    }

    return unit - 97 + 10;
}

int32 ScanString(int32 initial)
{
    mut int32 at = initial;
    int32 start = at;
    at = at + 1;
    mut bool terminated = false;
    while (at < Host.Source.Length)
    {
        int32 current = PeekUnit(at);
        if (IsNewline(current))
        {
            break;
        }
        if (current == 34)
        {
            at = at + 1;
            terminated = true;
            break;
        }
        else if (current != 92)
        {
            if (current < 55296 || current > 57343)
            {
                at = at + 1;
            }
            else
            {
                int32 scalar = ReadUtf16Scalar(at, Host.Source.Length);
                if (scalar == -1)
                {
                    Report(1, at, 1);
                }

                at = at + Utf16ScalarWidth(scalar);
            }
        }
        else
        {
            int32 escapeStart = at;
            at = at + 1;
            if (at == Host.Source.Length || IsNewline(PeekUnit(at)))
            {
                Report(5, escapeStart, 1);
                break;
            }
            else
            {
                require SourceRange.TryCreate(escapeStart, Host.Source.Length - escapeStart,
                    init var spelling);
                require StringEscapeDecodeResult.TryAnalyze(spelling, init var decoded);
                if (decoded.Scalar < 0)
                {
                    Report(1, escapeStart + 1, 1);
                }
                if (decoded.ErrorCode != 0)
                {
                    Report(decoded.ErrorCode, escapeStart, decoded.ErrorLength);
                }
                at = escapeStart + decoded.ConsumedLength;
            }
        }
    }

    if (!terminated)
    {
        Report(2, start, at - start);
    }

    return at;
}

int32 ScanCharacter(int32 initial)
{
    mut int32 at = initial + 1;
    int32 start = initial;
    mut bool terminated = false;
    while (at < Host.Source.Length)
    {
        int32 current = PeekUnit(at);
        if (IsNewline(current))
        {
            break;
        }
        if (current == 39)
        {
            at = at + 1;
            terminated = true;
            break;
        }
        else if (current == 92)
        {
            at = at + 1;
            if (at == Host.Source.Length || IsNewline(PeekUnit(at)))
            {
                break;
            }

            int32 escapedUnit = PeekUnit(at);
            if (escapedUnit < 55296 || escapedUnit > 57343)
            {
                at = at + 1;
            }
            else
            {
                int32 escapedScalar = ReadUtf16Scalar(at, Host.Source.Length);
                at = at + Utf16ScalarWidth(escapedScalar);
            }
        }
        else
        {
            int32 unit = PeekUnit(at);
            if (unit < 55296 || unit > 57343)
            {
                at = at + 1;
            }
            else
            {
                int32 scalar = ReadUtf16Scalar(at, Host.Source.Length);
                at = at + Utf16ScalarWidth(scalar);
            }
        }
    }

    if (!terminated)
    {
        Report(2, start, at - start);
    }
    else
    {
        require SourceRange.TryCreate(start, at - start, init var spelling);
        require CharacterLiteralDecodeResult.TryAnalyze(spelling, init var decoded);
        if (decoded.ErrorCode != 0)
        {
            Report(decoded.ErrorCode, decoded.ErrorSpan.Start, decoded.ErrorSpan.Length);
        }
    }

    return at;
}

// Token kinds use the host TokenKind catalog. Trivia words contain a count
// followed by (TriviaKind, start, length, owning token index) records.
int32 Scan()
{
    Host.Diagnostics[0] = 0;
    Host.Trivia[0] = 0;
    Host.IntegerValues[0] = 0;
    mut int32 position = 0;
    mut int32 count = 0;
    mut int32 deferredEnd = 0;
    while (position < Host.Source.Length)
    {
        position = SkipTrivia(position, count);
        if (position < Host.Source.Length)
        {
            int32 start = position;
            int32 scalar = ReadUtf16Scalar(position, Host.Source.Length);
            mut int32 kind = 1;
            position = position + Utf16ScalarWidth(scalar);
            mut int32 escapedStart = -1;
            if (scalar == 64 && position < Host.Source.Length)
            {
                escapedStart = ReadUtf16Scalar(position, Host.Source.Length);
            }
            if (scalar == 64 && IsIdentifierStart(escapedStart))
            {
                position = position + Utf16ScalarWidth(escapedStart);
                while (position < Host.Source.Length)
                {
                    int32 next = ReadUtf16Scalar(position, Host.Source.Length);
                    if (IsIdentifierContinue(next))
                    {
                        position = position + Utf16ScalarWidth(next);
                    }
                    else
                    {
                        break;
                    }
                }
                if (IsEscapeKeyword(start + 1, position - start - 1))
                {
                    kind = 2;
                }
                else
                {
                    Report(1, start, position - start);
                }
            }
            else if (IsIdentifierStart(scalar))
            {
                kind = 2;
                while (position < Host.Source.Length)
                {
                    int32 next = ReadUtf16Scalar(position, Host.Source.Length);
                    if (IsIdentifierContinue(next))
                    {
                        position = position + Utf16ScalarWidth(next);
                    }
                    else
                    {
                        break;
                    }
                }
                kind = KeywordKind(start, position - start);
            }
            else if (scalar >= 48 && scalar <= 57)
            {
                kind = 3;
                position = ScanNumber(start, count);
            }
            else if (scalar == 34)
            {
                kind = 4;
                position = ScanString(start);
            }
            else if (scalar == 39)
            {
                kind = 103;
                position = ScanCharacter(start);
            }
            else
            {
                int32 matched = OperatorMatch(start);
                if (start >= deferredEnd && IsPunctuationGlyph(scalar))
                {
                    require TryReadPunctuationRun(start, init var end, init var typeBoundary);
                    int32 length = end - start;
                    if (matched != -1 && matched % 8 == length)
                    {
                        kind = matched / 8;
                        position = end;
                    }
                    else if (typeBoundary)
                    {
                        deferredEnd = end;
                        kind = matched / 8;
                        position = start + matched % 8;
                    }
                    else
                    {
                        mut int32 diagnostic = 11;
                        if (IsUnsupportedPunctuationRun(start, length))
                        {
                            diagnostic = 12;
                        }
                        Report(diagnostic, start, length);
                        position = end;
                    }
                }
                else if (matched != -1)
                {
                    kind = matched / 8;
                    position = start + matched % 8;
                }
                else
                {
                    Report(1, start, position - start);
                }
            }

            require CanAppendRecord(count, Host.Tokens.Length, 3, 0);
            int32 record = count * 3;
            Host.Tokens[record] = kind;
            Host.Tokens[record + 1] = start;
            Host.Tokens[record + 2] = position - start;
            count = count + 1;
        }
    }

    require CanAppendRecord(count, Host.Tokens.Length, 3, 0);
    int32 endRecord = count * 3;
    Host.Tokens[endRecord] = 0;
    Host.Tokens[endRecord + 1] = position;
    Host.Tokens[endRecord + 2] = 0;

    return count + 1;
}
