using Terrum.CodeAnalysis.Numerics64;

namespace Terrum.CodeAnalysis;

bool MatchesSourceMagnitude(int32 tokenIndex, int32 status, int32 low, int32 high)
{
    int32 tokenOffset = tokenIndex * 3;
    mut int32 start = Host.Tokens[tokenOffset + 1];
    mut int32 length = Host.Tokens[tokenOffset + 2];
    if (start < 0 || length <= 0 || start > Host.Source.Length
        || length > Host.Source.Length - start)
    {
        return false;
    }

    mut uint32 radix = 10;
    if (length >= 2 && Host.Source[start] == char16(48))
    {
        int32 prefix = int32(Host.Source[start + 1]);
        if (prefix == 120 || prefix == 88)
        {
            radix = 16;
            start = start + 2;
            length = length - 2;
        }
        else if (prefix == 98 || prefix == 66)
        {
            radix = 2;
            start = start + 2;
            length = length - 2;
        }
    }

    if (!TryParseUInt64Base(start, length, radix, init var magnitude))
    {
        return status == 1 && low == 0 && high == 0;
    }

    return status == 0
        && low == EncodeWord(uint32(magnitude & uint64(uint32.MaxValue)))
        && high == EncodeWord(uint32(magnitude >> 32));
}

bool TryGetIntegerRecordCount(int32 tokenCount, init ref<int32> count)
{
    if (Host.Diagnostics[0] != 0 || tokenCount < 1
        || tokenCount > Host.Tokens.Length / 3
        || Host.IntegerValues.Length < 1)
    {
        return false;
    }

    int32 found = Host.IntegerValues[0];
    if (found < 0 || found >= tokenCount
        || found > (Host.IntegerValues.Length - 1) / 5
        || found > int32.MaxValue / 4)
    {
        return false;
    }

    count = found;
    return true;
}

bool IsFloatingPointToken(int32 tokenIndex)
{
    int32 tokenOffset = tokenIndex * 3;
    int32 start = Host.Tokens[tokenOffset + 1];
    int32 length = Host.Tokens[tokenOffset + 2];
    if (start < 0 || length <= 0 || start > Host.Source.Length
        || length > Host.Source.Length - start)
    {
        return false;
    }

    bool hexadecimal = length >= 2 && Host.Source[start] == char16(48)
        && (Host.Source[start + 1] == char16(120)
            || Host.Source[start + 1] == char16(88));
    bool binary = length >= 2 && Host.Source[start] == char16(48)
        && (Host.Source[start + 1] == char16(98)
            || Host.Source[start + 1] == char16(66));
    // Hexadecimal integers use e/E as digits; only p/P introduces their exponent.
    for (mut int32 offset = 0; offset < length; offset = offset + 1)
    {
        char16 unit = Host.Source[start + offset];
        if (unit == char16(46)
            || hexadecimal && (unit == char16(112) || unit == char16(80))
            || !hexadecimal && !binary && (unit == char16(101) || unit == char16(69)))
        {
            return true;
        }
    }

    return false;
}

bool IsValidIntegerRecord(int32 tokenIndex, int32 recordedIndex, int32 status,
    int32 low, int32 high, int32 tag)
{
    return recordedIndex == tokenIndex && status >= 0 && status <= 1 && tag == 0
        && (status != 1 || low == 0 && high == 0)
        && MatchesSourceMagnitude(tokenIndex, status, low, high);
}

// Magnitudes retain the scanner's raw low/high uint32 bit patterns as int32 words.
public unique struct TokenIntegerSnapshot
{
    private OwnedInt32Buffer _records;
    private int32 _count;

    private TokenIntegerSnapshot(OwnedInt32Buffer records, int32 count)
    {
        _records = move records;
        _count = count;
    }

    public int32 GetCount()
    {
        return _count;
    }

    public bool TryGet(int32 index, init ref<int32> tokenIndex,
        init ref<bool> overflow, init ref<int32> low, init ref<int32> high)
    {
        if (index < 0 || index >= _count)
        {
            return false;
        }

        int32 offset = index * 4;
        tokenIndex = _records.Read(offset);
        overflow = _records.Read(offset + 1) == 1;
        low = _records.Read(offset + 2);
        high = _records.Read(offset + 3);
        return true;
    }

    public bool TryFind(int32 tokenIndex, init ref<bool> overflow,
        init ref<int32> low, init ref<int32> high)
    {
        mut int32 first = 0;
        mut int32 end = _count;
        while (first < end)
        {
            int32 middle = first + (end - first) / 2;
            if (_records.Read(middle * 4) < tokenIndex)
            {
                first = middle + 1;
            }
            else
            {
                end = middle;
            }
        }

        if (first >= _count || _records.Read(first * 4) != tokenIndex)
        {
            return false;
        }

        int32 offset = first * 4;
        overflow = _records.Read(offset + 1) == 1;
        low = _records.Read(offset + 2);
        high = _records.Read(offset + 3);
        return true;
    }

    public static bool TryValidate(int32 tokenCount)
    {
        if (!TryGetIntegerRecordCount(tokenCount, init var count))
        {
            return false;
        }

        mut int32 recordIndex = 0;
        for (mut int32 tokenIndex = 0; tokenIndex < tokenCount - 1; tokenIndex = tokenIndex + 1)
        {
            if (Host.Tokens[tokenIndex * 3] != 3 || IsFloatingPointToken(tokenIndex))
            {
                continue;
            }

            if (recordIndex >= count)
            {
                return false;
            }

            int32 offset = recordIndex * 5 + 1;
            if (!IsValidIntegerRecord(tokenIndex, Host.IntegerValues[offset],
                Host.IntegerValues[offset + 1], Host.IntegerValues[offset + 2],
                Host.IntegerValues[offset + 3], Host.IntegerValues[offset + 4]))
            {
                return false;
            }
            recordIndex = recordIndex + 1;
        }

        return recordIndex == count;
    }

    public static bool TryBuild(int32 tokenCount, init ref<TokenIntegerSnapshot> result)
    {
        if (!TryGetIntegerRecordCount(tokenCount, init var count)
            || !OwnedInt32Buffer.TryCreate(count * 4, out var created))
        {
            return false;
        }

        mut OwnedInt32Buffer records = move created;
        mut int32 recordIndex = 0;
        for (mut int32 tokenIndex = 0; tokenIndex < tokenCount - 1; tokenIndex = tokenIndex + 1)
        {
            if (Host.Tokens[tokenIndex * 3] != 3 || IsFloatingPointToken(tokenIndex))
            {
                continue;
            }

            if (recordIndex >= count)
            {
                return false;
            }

            int32 offset = recordIndex * 5 + 1;
            int32 recordedIndex = Host.IntegerValues[offset];
            int32 status = Host.IntegerValues[offset + 1];
            int32 low = Host.IntegerValues[offset + 2];
            int32 high = Host.IntegerValues[offset + 3];
            int32 tag = Host.IntegerValues[offset + 4];
            if (!IsValidIntegerRecord(tokenIndex, recordedIndex, status, low, high, tag))
            {
                return false;
            }

            require records.TryAppend(tokenIndex);
            require records.TryAppend(status);
            require records.TryAppend(low);
            require records.TryAppend(high);
            recordIndex = recordIndex + 1;
        }

        if (recordIndex != count)
        {
            return false;
        }

        result = new TokenIntegerSnapshot(move records, count);
        return true;
    }
}

bool TryBuildCompilerInput(int32 count,
    init ref<TokenSnapshot> tokens, init ref<TokenTriviaSnapshot> trivia,
    init ref<TokenIntegerSnapshot> integers)
{
    if (!TryBuildLossless(count, init var scanned, init var leading)
        || !TokenIntegerSnapshot.TryBuild(count, init var magnitudes))
    {
        return false;
    }

    tokens = move scanned;
    trivia = move leading;
    integers = move magnitudes;
    return true;
}

bool TryScanCompilerInput(init ref<TokenSnapshot> tokens,
    init ref<TokenTriviaSnapshot> trivia, init ref<TokenIntegerSnapshot> integers)
{
    return TryBuildCompilerInput(Scan(), init tokens, init trivia, init integers);
}
