using Terrum;
namespace Terrum.CodeAnalysis;

public unique struct TokenCursor
{
    private mut Span<Token> _tokens;

    [Captures(nameof(tokens))]
    public TokenCursor(Span<Token> tokens)
    {
        _tokens = tokens;
    }

    public mut bool TryRead(init ref<Token> token)
    {
        if (_tokens.Length == 0)
        {
            return false;
        }

        token = _tokens[0];
        _tokens = _tokens.AdvanceOne();

        return true;
    }

    public bool TryGet(int32 index, init ref<Token> token)
    {
        if (index < 0)
        {
            return false;
        }

        uint64 unsignedIndex = uint64(index);
        if (unsignedIndex >= _tokens.Length)
        {
            return false;
        }

        token = _tokens[unsignedIndex];
        return true;
    }
}
