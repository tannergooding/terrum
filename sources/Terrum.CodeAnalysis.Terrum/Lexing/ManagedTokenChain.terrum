namespace Terrum.CodeAnalysis;

mut class ManagedTokenLink {
    public Token Value;
    public mut write ManagedTokenLink? Next;

    public ManagedTokenLink(Token token) {
        require token.Kind >= 0;
        Value = token;
        Next = null;
    }
}

mut class ManagedTokenChain {
    private mut write ManagedTokenLink? _first;
    private mut write ManagedTokenLink? _last;
    private mut int32 _count;
    private mut int32 _version;

    public ManagedTokenChain() {
        _first = null;
        _last = null;
        _count = 0;
        _version = 0;
    }

    public int32 GetCount() { return _count; }
    public int32 GetVersion() { return _version; }
    public int32 Count { get { return _count; } }
    public int32 Version { get { return _version; } }

    public mut bool TryAppend(int32 kind, int32 sourceOffset, int32 sourceLength) {
        // Bound per-chain heap use and linear indexed reads to 64 links.
        if (kind < 0 || _count == 64 || _version == int32.MaxValue) {
            return false;
        }
        init SourceRange range;
        if (!SourceRange.TryCreate(sourceOffset, sourceLength,
            ref init range)) {
            return false;
        }
        if (_last is some previous) {
            if (range.Start < previous.Value.Range.Start) { return false; }
        }
        if (!ManagedTokenLink.TryCreate(new Token(kind, range), out var created)) {
            return false;
        }
        if (_last is some last) {
            last.Next = created;
        } else {
            _first = created;
        }
        _last = created;
        _count = _count + 1;
        _version = _version + 1;
        return true;
    }

    public bool TryGet(int32 index, ref<init Token> token) {
        if (index < 0 || index >= _count) { return false; }
        mut ManagedTokenLink? cursor = _first;
        for (mut int32 at = 0; at < index; at = at + 1) {
            if (cursor is some current) {
                cursor = current.Next;
            } else {
                // An in-range index requires this link to exist.
                require false;
                return false;
            }
        }
        if (cursor is some found) {
            *token = found.Value;
            return true;
        }
        require false;
        return false;
    }

    public bool TryCreateCursor(out write ManagedTokenCursor cursor) {
        init write ManagedTokenCursor created;
        if (!TryCreateCursorInit(ref init created)) { return false; }
        cursor = created;
        return true;
    }

    internal bool TryCreateCursorInit(
        ref<init write ManagedTokenCursor> cursor) {
        if (!ManagedTokenCursor.TryCreate(this, _first, _version, out var created)) { return false; }
        *cursor = created;
        return true;
    }

    public mut bool TryClear() {
        if (_count == 0 || _version == int32.MaxValue) { return false; }
        _first = null;
        _last = null;
        _count = 0;
        _version = _version + 1;
        return true;
    }
}

mut class ManagedTokenCursor {
    private ManagedTokenChain _owner;
    private mut write ManagedTokenLink? _next;
    private int32 _version;

    public ManagedTokenCursor(ManagedTokenChain owner, write ManagedTokenLink? next, int32 version) {
        _owner = owner;
        _next = next;
        _version = version;
    }

    public bool IsCurrent { get { return _owner.Version == _version; } }

    public mut bool TryPeek(ref<init Token> token) {
        return TryPeekAhead(0, ref init *token);
    }

    public mut bool TryPeekAhead(int32 distance, ref<init Token> token) {
        if (!IsCurrent) {
            _next = null;
            return false;
        }

        if (distance < 0) { return false; }
        mut write ManagedTokenLink? cursor = _next;
        for (mut int32 index = 0; index < distance; index = index + 1) {
            if (cursor is some current) {
                cursor = current.Next;
            } else {
                return false;
            }
        }
        if (cursor is some current) {
            *token = current.Value;
            return true;
        }
        return false;
    }

    public mut bool TryReadKind(int32 kind, ref<init Token> token) {
        if (!IsCurrent) {
            _next = null;
            return false;
        }
        if (_next is some current) {
            Token next = current.Value;
            if (next.Kind != kind) { return false; }
            *token = next;
            _next = current.Next;
            return true;
        }
        return false;
    }

    public mut bool TryRead(ref<init Token> token) {
        if (!IsCurrent) {
            _next = null;
            return false;
        }
        if (_next is some current) {
            *token = current.Value;
            _next = current.Next;
            return true;
        }
        return false;
    }
}
