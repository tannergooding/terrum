namespace Terrum.CodeAnalysis;

public unique struct TokenSnapshot
{
    private OwnedInt32Buffer _records;
    private int32 _count;

    private TokenSnapshot(OwnedInt32Buffer records, int32 count)
    {
        _records = move records;
        _count = count;
    }

    internal static bool TryCreateValidated(OwnedInt32Buffer records, int32 count,
        ref<init TokenSnapshot> result)
    {
        if (count < 1 || count > int32.MaxValue / 3 || records.Count != count * 3)
        {
            return false;
        }

        mut int32 previousEnd = 0;
        for (mut int32 index = 0; index < count; index = index + 1)
        {
            int32 offset = index * 3;
            int32 kind = records.Read(offset);
            int32 start = records.Read(offset + 1);
            int32 length = records.Read(offset + 2);
            if (!IsValidScannerToken(index, count, previousEnd, kind, start, length))
            {
                return false;
            }
            previousEnd = start + length;
        }

        *result = new TokenSnapshot(move records, count);
        return true;
    }

    public int32 GetCount()
    {
        return _count;
    }

    public bool TryGet(int32 index, ref<init Token> token)
    {
        if (index < 0 || index >= _count)
        {
            return false;
        }

        int32 offset = index * 3;
        init SourceRange range;
        require SourceRange.TryCreate(_records.Read(offset + 1),
            _records.Read(offset + 2), ref init range);
        *token = new Token(_records.Read(offset), range);
        return true;
    }

    // Scalar input only treats canonical ref<init T> delimiters as generic punctuation.
    // Its operand-ending token kinds determine unary versus binary/update roles.
    // `ref init *place` is a scoped initialization-reference reborrow.
    // A colon attached to an identifier before a same-line loop keyword introduces its label.
    public SourceRange GetScalarOperatorSpacingError()
    {
        var run = GetScalarPunctuationRunError();
        if (run.Length != 0)
        {
            return run;
        }
        init Token first;
        require TryGet(0, ref init first);
        mut Token previous = first;
        if (_count > 2)
        {
            init Token second;
            require TryGet(1, ref init second);
            mut Token current = second;
            for (mut int32 index = 1; index < _count - 1; index = index + 1)
            {
                init Token next;
                init Token argumentStart;
                require TryGet(index + 1, ref init next);
                int32 kind = current.Kind;
                bool operandEnd = IsScalarOperandEnd(previous.Kind);
                mut bool prefix = kind == 62 || kind == 63;
                mut bool postfix = false;
                mut bool separated = false;
                if (kind == 57 || kind == 58)
                {
                    if (operandEnd) { separated = true; }
                    else { prefix = true; }
                }
                if (kind == 86 || kind == 87)
                {
                    if (operandEnd) { postfix = true; }
                    else { prefix = true; }
                }
                if (kind == 59)
                {
                    if (IsInitReferenceReborrow(index, previous)) { prefix = true; }
                    else if (operandEnd) { separated = true; }
                    else { prefix = true; }
                }
                else if (kind == 60 || kind == 61)
                {
                    separated = true;
                }
                if (kind == 55 || kind == 56) { separated = true; }
                if (kind == 55 && previous.Kind == 2
                    && previous.Range.End == current.Range.Start && index >= 2
                    && TryGet(index - 2, ref init argumentStart)
                    && (argumentStart.Kind == 46 || argumentStart.Kind == 53))
                {
                    separated = false;
                }
                if (kind >= 64 && kind <= 75 && !IsInitRefAngleDelimiter(index, previous, current))
                {
                    separated = true;
                }
                if (kind == 82 || kind == 84 || kind == 85) { separated = true; }
                if (kind >= 88 && kind <= 101) { separated = true; }
                if (kind == 55 && (next.Kind == 18 || next.Kind == 83 || next.Kind == 31))
                {
                    if (previous.Kind != 2 || previous.Range.End != current.Range.Start)
                    {
                        return current.Range;
                    }
                    for (mut int32 at = current.Range.End; at < next.Range.Start; at = at + 1)
                    {
                        if (IsNewline(PeekUnit(at)))
                        {
                            return current.Range;
                        }
                    }
                    separated = false;
                }
                if (prefix && current.Range.End != next.Range.Start)
                {
                    return current.Range;
                }
                if (postfix && previous.Range.End != current.Range.Start)
                {
                    return current.Range;
                }
                if (separated && (previous.Range.End == current.Range.Start
                    || current.Range.End == next.Range.Start))
                {
                    return current.Range;
                }
                previous = current;
                current = next;
            }
        }
        init SourceRange empty;
        require SourceRange.TryCreate(0, 0, ref init empty);
        return empty;
    }

    private bool IsInitRefAngleDelimiter(int32 index, Token previous, Token operation)
    {
        if (operation.Kind == 67 && previous.Kind == 14 && index >= 2)
        {
            init Token initialization;
            if (!TryGet(index + 1, ref init initialization))
            {
                return false;
            }
            return IsInitKeyword(initialization);
        }
        if (operation.Kind != 69 || previous.Kind != 2 || index < 4)
        {
            return false;
        }
        init Token less;
        init Token initialization;
        init Token refKeyword;
        if (!TryGet(index - 3, ref init less)
            || !TryGet(index - 2, ref init initialization)
            || !TryGet(index - 4, ref init refKeyword))
        {
            return false;
        }
        return less.Kind == 67 && refKeyword.Kind == 14
            && IsInitKeyword(initialization);
    }

    private bool IsInitReferenceReborrow(int32 index, Token previous)
    {
        if (previous.Kind != 2 || index < 2 || !IsInitKeyword(previous))
        {
            return false;
        }
        init Token refKeyword;
        return TryGet(index - 2, ref init refKeyword) && refKeyword.Kind == 14;
    }

    private bool IsInitKeyword(Token token)
    {
        if (token.Kind != 2 || token.Range.Length != 4)
        {
            return false;
        }
        int32 at = token.Range.Start;
        return Host.Source[at] == char16(105) && Host.Source[at + 1] == char16(110)
            && Host.Source[at + 2] == char16(105) && Host.Source[at + 3] == char16(116);
    }

    private SourceRange GetScalarPunctuationRunError()
    {
        mut int32 index = 0;
        while (index < _count - 1)
        {
            init Token first;
            require TryGet(index, ref init first);
            if (!IsPunctuationGlyph(PeekUnit(first.Range.Start)))
            {
                index = index + 1;
                continue;
            }
            int32 start = first.Range.Start;
            mut int32 end = first.Range.End;
            mut int32 records = 1;
            index = index + 1;
            while (index < _count - 1)
            {
                init Token next;
                require TryGet(index, ref init next);
                if (next.Range.Start != end
                    || !IsPunctuationGlyph(PeekUnit(next.Range.Start)))
                {
                    break;
                }
                end = next.Range.End;
                records = records + 1;
                index = index + 1;
            }
            int32 matched = OperatorMatch(start);
            if (records != 1 || matched == -1 || matched % 8 != end - start
                || matched / 8 != first.Kind)
            {
                init SourceRange error;
                require SourceRange.TryCreate(start, end - start,
                    ref init error);
                return error;
            }
        }
        init SourceRange empty;
        require SourceRange.TryCreate(0, 0, ref init empty);
        return empty;
    }

    private static bool IsScalarOperandEnd(int32 kind)
    {
        if (kind == 2 || kind == 3) { return true; }
        if (kind == 20 || kind == 21) { return true; }
        if (kind == 47) { return true; }
        return kind == 86 || kind == 87;
    }

    public static bool TryBuild(int32 count,
        ref<init TokenSnapshot> result)
    {
        if (Host.Diagnostics[0] != 0 || count < 1
            || count > int32.MaxValue / 3 || count > Host.Tokens.Length / 3)
        {
            return false;
        }

        init OwnedInt32Buffer created;
        if (!OwnedInt32Buffer.TryCreate(count * 3, ref init created))
        {
            return false;
        }

        mut OwnedInt32Buffer records = move created;
        for (mut int32 index = 0; index < count; index = index + 1)
        {
            int32 offset = index * 3;
            int32 kind = Host.Tokens[offset];
            int32 start = Host.Tokens[offset + 1];
            int32 length = Host.Tokens[offset + 2];
            require records.TryAppend(kind);
            require records.TryAppend(start);
            require records.TryAppend(length);
        }

        return TryCreateValidated(move records, count, ref init *result);
    }

    public static bool TryScan(ref<init TokenSnapshot> result)
    {
        return TryBuild(Scan(), ref init *result);
    }
}
