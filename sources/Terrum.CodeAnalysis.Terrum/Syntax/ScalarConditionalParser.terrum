namespace Terrum.CodeAnalysis;

bool TryParseScalarConditionalReturn(TokenSnapshot tokens,
    ref<init int32> scalarType, ref<init SourceRange> name)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 30)
    {
        return false;
    }
    init Token returnType;
    require tokens.TryGet(0, ref init returnType);
    init Token function;
    require tokens.TryGet(1, ref init function);
    init Token openParameters;
    require tokens.TryGet(2, ref init openParameters);
    init Token conditionType;
    require tokens.TryGet(3, ref init conditionType);
    init Token conditionParameter;
    require tokens.TryGet(4, ref init conditionParameter);
    init Token firstComma;
    require tokens.TryGet(5, ref init firstComma);
    init Token firstType;
    require tokens.TryGet(6, ref init firstType);
    init Token firstParameter;
    require tokens.TryGet(7, ref init firstParameter);
    init Token secondComma;
    require tokens.TryGet(8, ref init secondComma);
    init Token secondType;
    require tokens.TryGet(9, ref init secondType);
    init Token secondParameter;
    require tokens.TryGet(10, ref init secondParameter);
    init Token closeParameters;
    require tokens.TryGet(11, ref init closeParameters);
    init Token openBody;
    require tokens.TryGet(12, ref init openBody);
    init Token branch;
    require tokens.TryGet(13, ref init branch);
    init Token openCondition;
    require tokens.TryGet(14, ref init openCondition);
    init Token conditionUse;
    require tokens.TryGet(15, ref init conditionUse);
    init Token closeCondition;
    require tokens.TryGet(16, ref init closeCondition);
    init Token openTrue;
    require tokens.TryGet(17, ref init openTrue);
    init Token trueReturn;
    require tokens.TryGet(18, ref init trueReturn);
    init Token firstUse;
    require tokens.TryGet(19, ref init firstUse);
    init Token trueSemicolon;
    require tokens.TryGet(20, ref init trueSemicolon);
    init Token closeTrue;
    require tokens.TryGet(21, ref init closeTrue);
    init Token otherwise;
    require tokens.TryGet(22, ref init otherwise);
    init Token openFalse;
    require tokens.TryGet(23, ref init openFalse);
    init Token falseReturn;
    require tokens.TryGet(24, ref init falseReturn);
    init Token secondUse;
    require tokens.TryGet(25, ref init secondUse);
    init Token falseSemicolon;
    require tokens.TryGet(26, ref init falseSemicolon);
    init Token closeFalse;
    require tokens.TryGet(27, ref init closeFalse);
    init Token closeBody;
    require tokens.TryGet(28, ref init closeBody);
    init Token eof;
    require tokens.TryGet(29, ref init eof);
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    init int32 selected;
    init int32 condition;
    init int32 matchingFirst;
    init int32 matchingSecond;
    if (!TryGetScalarType(returnType, ref init selected)
        || !TryGetScalarType(conditionType, ref init condition) || condition != 5
        || !TryGetScalarType(firstType, ref init matchingFirst)
        || !TryGetScalarType(secondType, ref init matchingSecond)
        || selected != matchingFirst || selected != matchingSecond
        || function.Kind != 2 || openParameters.Kind != 46
        || firstComma.Kind != 53 || secondComma.Kind != 53
        || closeParameters.Kind != 47 || openBody.Kind != 48
        || branch.Kind != 16 || openCondition.Kind != 46
        || closeCondition.Kind != 47 || openTrue.Kind != 48
        || trueReturn.Kind != 19 || trueSemicolon.Kind != 52
        || closeTrue.Kind != 49 || otherwise.Kind != 17
        || openFalse.Kind != 48 || falseReturn.Kind != 19
        || falseSemicolon.Kind != 52 || closeFalse.Kind != 49
        || closeBody.Kind != 49 || eof.Kind != 0
        || !SameTokenSpelling(conditionParameter, conditionUse)
        || !SameTokenSpelling(firstParameter, firstUse)
        || !SameTokenSpelling(secondParameter, secondUse)
        || SameTokenSpelling(conditionParameter, firstParameter)
        || SameTokenSpelling(conditionParameter, secondParameter)
        || SameTokenSpelling(firstParameter, secondParameter))
    {
        return false;
    }
    *scalarType = selected;
    *name = function.Range;
    return true;
}

bool TryEvaluateInt32ScalarConditionalReturn(TokenSnapshot tokens, bool condition,
    int32 first, int32 second, ref<init SourceRange> name, ref<init int32> result)
{
    init int32 selected;
    init SourceRange foundName;
    if (!TryParseScalarConditionalReturn(move tokens, ref init selected, ref init foundName)
        || selected != 1)
    {
        return false;
    }
    *name = foundName;
    if (condition)
    {
        *result = first;
    }
    else
    {
        *result = second;
    }
    return true;
}

