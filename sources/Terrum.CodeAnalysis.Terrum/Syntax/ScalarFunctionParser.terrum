bool TryParseParameterAddReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    ref<init int32> scalarType, ref<init SourceRange> name,
    ref<init uint64> magnitude, ref<init bool> based)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 14)
    {
        return false;
    }
    init Token returnType;
    require tokens.TryGet(0, ref init returnType);
    init Token function;
    require tokens.TryGet(1, ref init function);
    init Token openParameters;
    require tokens.TryGet(2, ref init openParameters);
    init Token parameterType;
    require tokens.TryGet(3, ref init parameterType);
    init Token parameter;
    require tokens.TryGet(4, ref init parameter);
    init Token closeParameters;
    require tokens.TryGet(5, ref init closeParameters);
    init Token openBody;
    require tokens.TryGet(6, ref init openBody);
    init Token returnKeyword;
    require tokens.TryGet(7, ref init returnKeyword);
    init Token parameterUse;
    require tokens.TryGet(8, ref init parameterUse);
    init Token add;
    require tokens.TryGet(9, ref init add);
    init Token literal;
    require tokens.TryGet(10, ref init literal);
    init Token semicolon;
    require tokens.TryGet(11, ref init semicolon);
    init Token closeBody;
    require tokens.TryGet(12, ref init closeBody);
    init Token eof;
    require tokens.TryGet(13, ref init eof);
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    init int32 selected;
    init int32 matching;
    if (!TryGetScalarType(returnType, ref init selected)
        || !TryGetScalarType(parameterType, ref init matching) || selected != matching
        || selected == 5 || selected == 6 || function.Kind != 2
        || openParameters.Kind != 46 || parameter.Kind != 2 || closeParameters.Kind != 47
        || openBody.Kind != 48 || returnKeyword.Kind != 19
        || parameterUse.Kind != 2 || add.Kind != 57 || literal.Kind != 3
        || semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0
        || !SameTokenSpelling(parameter, parameterUse))
    {
        return false;
    }
    init bool overflow;
    init int32 low;
    init int32 high;
    if (!integers.TryFind(10, ref init overflow, ref init low, ref init high) || overflow)
    {
        return false;
    }

    *scalarType = selected;
    *name = function.Range;
    *magnitude = DecodeScannerMagnitude(low, high);
    *based = IsBasedInteger(literal);
    return true;
}

