namespace Terrum.CodeAnalysis;

// This bounded syntax-27 probe uses current TokenKind ordinals, not source
// characters, to classify punctuation; host parser recovery remains separate.
bool TryParseScalarReturnFunctionTyped(TokenSnapshot tokens,
    ref<init int32> scalarType, ref<init SourceRange> name,
    ref<init SourceRange> expression)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }

    init Token type;
    require tokens.TryGet(0, ref init type);
    init int32 selected;
    if (!TryGetScalarType(type, ref init selected) || selected > 5)
    {
        return false;
    }
    init Token function;
    require tokens.TryGet(1, ref init function);
    init Token openParameters;
    require tokens.TryGet(2, ref init openParameters);
    init Token closeParameters;
    require tokens.TryGet(3, ref init closeParameters);
    init Token openBody;
    require tokens.TryGet(4, ref init openBody);
    init Token returnKeyword;
    require tokens.TryGet(5, ref init returnKeyword);
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    if (function.Kind != 2 || openParameters.Kind != 46 || closeParameters.Kind != 47
        || openBody.Kind != 48 || returnKeyword.Kind != 19)
    {
        return false;
    }

    mut int32 first = 6;
    init Token initial;
    require tokens.TryGet(first, ref init initial);
    mut Token value = initial;
    bool grouped = count == 12 || count == 13;
    bool outerSign = count == 13 && ((selected == 5 && initial.Kind == 62)
        || (selected != 5 && (initial.Kind == 57 || initial.Kind == 58
            || initial.Kind == 63)));
    mut Token group = initial;
    if (outerSign)
    {
        first = first + 1;
        init Token groupToken;
        require tokens.TryGet(first, ref init groupToken);
        group = groupToken;
        value = group;
    }
    if (grouped)
    {
        if (value.Kind != 46)
        {
            return false;
        }
        first = first + 1;
        init Token groupedValue;
        require tokens.TryGet(first, ref init groupedValue);
        value = groupedValue;
    }
    if (count == 11 || (count == 13 && !outerSign))
    {
        if ((selected == 5 && value.Kind != 62)
            || (selected != 5 && value.Kind != 57 && value.Kind != 58
                && value.Kind != 63))
        {
            return false;
        }
        first = first + 1;
        init Token signedValue;
        require tokens.TryGet(first, ref init signedValue);
        value = signedValue;
    }
    if ((selected == 5 && value.Kind != 20 && value.Kind != 21)
        || (selected != 5 && value.Kind != 3))
    {
        return false;
    }

    mut int32 afterValue = first + 1;
    mut int32 end = value.Range.End;
    if (grouped)
    {
        init Token closeGroup;
        require tokens.TryGet(afterValue, ref init closeGroup);
        if (closeGroup.Kind != 47)
        {
            return false;
        }
        end = closeGroup.Range.End;
        afterValue = afterValue + 1;
    }
    init Token semicolon;
    require tokens.TryGet(afterValue, ref init semicolon);
    init Token closeBody;
    require tokens.TryGet(afterValue + 1, ref init closeBody);
    init Token eof;
    require tokens.TryGet(afterValue + 2, ref init eof);
    if (semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }

    mut int32 start = value.Range.Start;
    if (grouped)
    {
        start = group.Range.Start;
    }
    if (count == 11 || outerSign)
    {
        init Token prefix;
        require tokens.TryGet(6, ref init prefix);
        start = prefix.Range.Start;
    }
    init SourceRange scalar;
    require SourceRange.TryCreate(start, end - start, ref init scalar);
    *scalarType = selected;
    *name = function.Range;
    *expression = scalar;
    return true;
}

bool TryEvaluateBoolScalarReturn(TokenSnapshot tokens,
    ref<init SourceRange> name, ref<init bool> result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }
    mut int32 valueIndex = 6;
    if (count == 11 || count == 12)
    {
        valueIndex = 7;
    }
    else if (count == 13)
    {
        valueIndex = 8;
    }
    init Token literal;
    require tokens.TryGet(valueIndex, ref init literal);
    bool negate = count == 11 || count == 13;
    init int32 scalarType;
    init SourceRange foundName;
    init SourceRange expression;
    if (!TryParseScalarReturnFunctionTyped(move tokens, ref init scalarType,
            ref init foundName, ref init expression)
        || scalarType != 5)
    {
        return false;
    }

    mut bool resultValue = literal.Kind == 20;
    if (negate)
    {
        resultValue = !resultValue;
    }
    *name = foundName;
    *result = resultValue;
    return true;
}

bool TryParseScalarReturnFunction(TokenSnapshot tokens,
    ref<init SourceRange> name, ref<init SourceRange> expression)
{
    init int32 scalarType;
    init SourceRange foundName;
    init SourceRange foundExpression;
    if (!TryParseScalarReturnFunctionTyped(move tokens, ref init scalarType,
            ref init foundName, ref init foundExpression)
        || scalarType != 1)
    {
        return false;
    }

    *name = foundName;
    *expression = foundExpression;
    return true;
}

bool TryParseScalarReturnIntegerTyped(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    ref<init int32> scalarType, ref<init SourceRange> name,
    ref<init SourceRange> expression, ref<init int32> low, ref<init int32> high)
{
    mut int32 valueIndex = 6;
    if (tokens.GetCount() == 11 || tokens.GetCount() == 12)
    {
        valueIndex = 7;
    }
    else if (tokens.GetCount() == 13)
    {
        valueIndex = 8;
    }

    init bool overflow;
    init int32 magnitudeLow;
    init int32 magnitudeHigh;
    init int32 foundType;
    init SourceRange foundName;
    init SourceRange foundExpression;
    if (!integers.TryFind(valueIndex, ref init overflow, ref init magnitudeLow,
            ref init magnitudeHigh)
        || overflow
        || !TryParseScalarReturnFunctionTyped(move tokens, ref init foundType,
            ref init foundName, ref init foundExpression))
    {
        return false;
    }

    *scalarType = foundType;
    *name = foundName;
    *expression = foundExpression;
    *low = magnitudeLow;
    *high = magnitudeHigh;
    return true;
}

bool TryParseScalarReturnInteger(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    ref<init SourceRange> name, ref<init SourceRange> expression,
    ref<init int32> low, ref<init int32> high)
{
    init int32 scalarType;
    init SourceRange foundName;
    init SourceRange foundExpression;
    init int32 foundLow;
    init int32 foundHigh;
    if (!TryParseScalarReturnIntegerTyped(move tokens, move integers, ref init scalarType,
            ref init foundName, ref init foundExpression, ref init foundLow, ref init foundHigh)
        || scalarType != 1)
    {
        return false;
    }

    *name = foundName;
    *expression = foundExpression;
    *low = foundLow;
    *high = foundHigh;
    return true;
}

bool TryEvaluateInt32ScalarReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    ref<init SourceRange> name, ref<init int32> result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }

    mut int32 valueIndex = 6;
    if (count != 10)
    {
        valueIndex = 7;
    }
    if (count == 13)
    {
        valueIndex = 8;
    }
    init Token literal;
    require tokens.TryGet(valueIndex, ref init literal);
    mut bool negative = false;
    mut bool invert = false;
    mut bool outerSign = false;
    mut bool explicitSign = false;
    if (count == 11 || count == 13)
    {
        mut int32 prefixIndex = 6;
        if (count == 13)
        {
            init Token firstToken;
            require tokens.TryGet(6, ref init firstToken);
            if (firstToken.Kind == 46)
            {
                prefixIndex = 7;
            }
            else
            {
                outerSign = true;
            }
        }
        init Token prefix;
        require tokens.TryGet(prefixIndex, ref init prefix);
        negative = prefix.Kind == 58;
        invert = prefix.Kind == 63;
        explicitSign = (prefix.Kind == 57 || prefix.Kind == 58)
            && !outerSign && prefix.Range.End == literal.Range.Start;
    }
    init SourceRange foundName;
    init SourceRange expression;
    init int32 low;
    init int32 high;
    if (!TryParseScalarReturnInteger(move tokens, move integers, ref init foundName,
            ref init expression, ref init low, ref init high)
        || high != 0)
    {
        return false;
    }

    bool based = IsBasedInteger(literal);
    if (based && explicitSign)
    {
        uint64 magnitude = DecodeScannerMagnitude(low, high);
        uint64 maximum = negative ? uint64(int32.MaxValue) + 1 : uint64(int32.MaxValue);
        if (magnitude > maximum)
        {
            return false;
        }

        mut int32 signedBound = negative
            ? magnitude == maximum ? int32.MinValue : -int32(magnitude)
            : int32(magnitude);
        if (invert)
        {
            signedBound = ~signedBound;
        }
        *name = foundName;
        *result = signedBound;
        return true;
    }

    // Decimal signed minimum needs minus directly on the literal, not outside parentheses.
    if (low < 0)
    {
        if (!based)
        {
            if (!negative || outerSign || low != int32.MinValue)
            {
                return false;
            }
            *name = foundName;
            *result = int32.MinValue;
            return true;
        }
        if (negative && low == int32.MinValue)
        {
            return false;
        }
    }

    *name = foundName;
    mut int32 bound = low;
    if (negative)
    {
        bound = -low;
    }
    if (invert)
    {
        bound = ~bound;
    }
    *result = bound;
    return true;
}

bool TryEvaluateUInt32ScalarReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    ref<init SourceRange> name, ref<init uint32> result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }
    mut bool invert = false;
    if (count == 11 || count == 13)
    {
        mut int32 prefixIndex = 6;
        if (count == 13)
        {
            init Token firstToken;
            require tokens.TryGet(6, ref init firstToken);
            if (firstToken.Kind == 46)
            {
                prefixIndex = 7;
            }
        }
        init Token prefix;
        require tokens.TryGet(prefixIndex, ref init prefix);
        if (prefix.Kind != 57 && prefix.Kind != 63)
        {
            return false;
        }
        invert = prefix.Kind == 63;
    }
    init int32 scalarType;
    init SourceRange foundName;
    init SourceRange expression;
    init int32 low;
    init int32 high;
    if (!TryParseScalarReturnIntegerTyped(move tokens, move integers,
            ref init scalarType, ref init foundName, ref init expression,
            ref init low, ref init high)
        || scalarType != 2 || high != 0)
    {
        return false;
    }

    mut uint32 resultValue = uint32(0);
    if (low < 0)
    {
        resultValue = uint32(int64(low) + 4294967296);
    }
    else
    {
        resultValue = uint32(low);
    }
    if (invert)
    {
        resultValue = ~resultValue;
    }
    *name = foundName;
    *result = resultValue;
    return true;
}

