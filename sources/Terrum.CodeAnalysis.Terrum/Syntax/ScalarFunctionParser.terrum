            return false;
        }
        *name = foundName;
        if (operation == 60)
        {
            *result = left / right;
        }
        else
        {
            *result = left % right;
        }
        return true;
    }
    if (operation == 58)
    {
        if (left < right)
        {
            return false;
        }
        *name = foundName;
        *result = left - right;
        return true;
    }
    if (operation == 59)
    {
        if (right != 0 && left > uint64.MaxValue / right)
        {
            return false;
        }
        *name = foundName;
        *result = left * right;
        return true;
    }
    if (left > uint64.MaxValue - right)
    {
        return false;
    }

    *name = foundName;
    *result = left + right;
    return true;
}
