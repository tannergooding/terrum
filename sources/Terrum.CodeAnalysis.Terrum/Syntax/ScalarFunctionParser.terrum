    return true;
}

bool TryEvaluateInt64ScalarReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    ref<init SourceRange> name, ref<init int64> result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }
    mut int32 valueIndex = 6;
    if (count != 10)
    {
        valueIndex = 7;
    }
    if (count == 13)
    {
        valueIndex = 8;
    }
    init Token literal;
    require tokens.TryGet(valueIndex, ref init literal);
    mut bool negative = false;
    mut bool invert = false;
    mut bool outerSign = false;
    mut bool explicitSign = false;
    if (count == 11 || count == 13)
    {
        mut int32 prefixIndex = 6;
        if (count == 13)
        {
            init Token firstToken;
            require tokens.TryGet(6, ref init firstToken);
            if (firstToken.Kind == 46)
            {
                prefixIndex = 7;
            }
            else
            {
                outerSign = true;
            }
        }
        init Token prefix;
        require tokens.TryGet(prefixIndex, ref init prefix);
        negative = prefix.Kind == 58;
        invert = prefix.Kind == 63;
        explicitSign = (prefix.Kind == 57 || prefix.Kind == 58)
            && !outerSign && prefix.Range.End == literal.Range.Start;
    }
    init int32 scalarType;
    init SourceRange foundName;
    init SourceRange expression;
    init int32 low;
    init int32 high;
    if (!TryParseScalarReturnIntegerTyped(move tokens, move integers,
            ref init scalarType, ref init foundName, ref init expression,
            ref init low, ref init high)
        || scalarType != 3)
    {
        return false;
    }

    uint64 magnitude = DecodeScannerMagnitude(low, high);
    uint64 signBit = uint64(int64.MaxValue) + 1;
    bool based = IsBasedInteger(literal);
    if (based && explicitSign)
    {
        uint64 maximum = negative ? signBit : uint64(int64.MaxValue);
        if (magnitude > maximum)
        {
            return false;
        }

        mut int64 signedBound = negative
            ? magnitude == signBit ? int64.MinValue : -int64(magnitude)
            : int64(magnitude);
        if (invert)
        {
            signedBound = ~signedBound;
        }
        *name = foundName;
        *result = signedBound;
        return true;
    }
    if (!based && magnitude > uint64(int64.MaxValue))
    {
        if (!negative || outerSign || magnitude != signBit)
        {
            return false;
        }
        *name = foundName;
        *result = int64.MinValue;
        return true;
    }

    init int64 decoded;
    if (!TryDecodeSigned64Scalar(magnitude, based, ref init decoded))
    {
        return false;
    }
    mut int64 bound = decoded;
    if (negative)
    {
        if (bound == int64.MinValue)
        {
            return false;
        }
        bound = -bound;
    }
    if (invert)
    {
        bound = ~bound;
    }

    *name = foundName;
    *result = bound;
    return true;
}

bool TryParseScalarBinaryReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    ref<init int32> scalarType, ref<init int32> operation, ref<init SourceRange> name,
    ref<init int32> firstLow, ref<init int32> firstHigh, ref<init bool> firstBased,
    ref<init int32> secondLow, ref<init int32> secondHigh, ref<init bool> secondBased)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 12)
    {
        return false;
    }
    init Token type;
    require tokens.TryGet(0, ref init type);
    init int32 selected;
    if (!TryGetScalarType(type, ref init selected) || selected == 5 || selected == 6)
    {
        return false;
    }
    init Token function;
    require tokens.TryGet(1, ref init function);
    init Token openParameters;
    require tokens.TryGet(2, ref init openParameters);
    init Token closeParameters;
    require tokens.TryGet(3, ref init closeParameters);
    init Token openBody;
    require tokens.TryGet(4, ref init openBody);
    init Token returnKeyword;
    require tokens.TryGet(5, ref init returnKeyword);
    init Token left;
    require tokens.TryGet(6, ref init left);
    init Token binary;
    require tokens.TryGet(7, ref init binary);
    init Token right;
    require tokens.TryGet(8, ref init right);
    init Token semicolon;
    require tokens.TryGet(9, ref init semicolon);
    init Token closeBody;
    require tokens.TryGet(10, ref init closeBody);
    init Token eof;
    require tokens.TryGet(11, ref init eof);
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    if (function.Kind != 2 || openParameters.Kind != 46 || closeParameters.Kind != 47
        || openBody.Kind != 48 || returnKeyword.Kind != 19
        || left.Kind != 3 || ((binary.Kind < 57 || binary.Kind > 61)
            && binary.Kind != 71 && binary.Kind != 73 && binary.Kind != 75)
        || right.Kind != 3
        || semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }
    init bool leftOverflow;
    init int32 leftLow;
    init int32 leftHigh;
    init bool rightOverflow;
    init int32 rightLow;
    init int32 rightHigh;
    if (!integers.TryFind(6, ref init leftOverflow, ref init leftLow, ref init leftHigh)
        || !integers.TryFind(8, ref init rightOverflow, ref init rightLow, ref init rightHigh)
        || leftOverflow || rightOverflow)
    {
        return false;
    }

    *scalarType = selected;
    *operation = binary.Kind;
    *name = function.Range;
    *firstLow = leftLow;
    *firstHigh = leftHigh;
    *firstBased = IsBasedInteger(left);
    *secondLow = rightLow;
    *secondHigh = rightHigh;
    *secondBased = IsBasedInteger(right);
    return true;
}

bool TryEvaluateTypedScalarComparisonReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    ref<init SourceRange> name, ref<init bool> result)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 18)
    {
        return false;
    }
    init Token returnType;
    require tokens.TryGet(0, ref init returnType);
    init Token function;
    require tokens.TryGet(1, ref init function);
    init Token openParameters;
    require tokens.TryGet(2, ref init openParameters);
    init Token closeParameters;
    require tokens.TryGet(3, ref init closeParameters);
    init Token openBody;
    require tokens.TryGet(4, ref init openBody);
    init Token returnKeyword;
    require tokens.TryGet(5, ref init returnKeyword);
    init Token leftType;
    require tokens.TryGet(6, ref init leftType);
    init Token leftOpen;
    require tokens.TryGet(7, ref init leftOpen);
    init Token leftLiteral;
    require tokens.TryGet(8, ref init leftLiteral);
    init Token leftClose;
    require tokens.TryGet(9, ref init leftClose);
    init Token comparison;
    require tokens.TryGet(10, ref init comparison);
    init Token rightType;
    require tokens.TryGet(11, ref init rightType);
    init Token rightOpen;
    require tokens.TryGet(12, ref init rightOpen);
    init Token rightLiteral;
    require tokens.TryGet(13, ref init rightLiteral);
    init Token rightClose;
    require tokens.TryGet(14, ref init rightClose);
    init Token semicolon;
    require tokens.TryGet(15, ref init semicolon);
    init Token closeBody;
    require tokens.TryGet(16, ref init closeBody);
    init Token eof;
    require tokens.TryGet(17, ref init eof);
    if (!TokensAttach(function, openParameters)
        || !TokensAttach(leftType, leftOpen) || !TokensAttach(rightType, rightOpen))
    {
        return false;
    }
    init int32 selectedReturn;
    init int32 selected;
    init int32 matching;
    if (!TryGetScalarType(returnType, ref init selectedReturn) || selectedReturn != 5
        || !TryGetScalarType(leftType, ref init selected)
        || !TryGetScalarType(rightType, ref init matching) || selected != matching
        || selected == 5 || function.Kind != 2
        || openParameters.Kind != 46 || closeParameters.Kind != 47
        || openBody.Kind != 48 || returnKeyword.Kind != 19
        || leftOpen.Kind != 46 || leftLiteral.Kind != 3 || leftClose.Kind != 47
        || comparison.Kind < 65 || comparison.Kind > 70
        || rightOpen.Kind != 46 || rightLiteral.Kind != 3 || rightClose.Kind != 47
        || semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }
    init bool leftOverflow;
    init int32 leftLow;
    init int32 leftHigh;
    init bool rightOverflow;
    init int32 rightLow;
    init int32 rightHigh;
    if (!integers.TryFind(8, ref init leftOverflow, ref init leftLow, ref init leftHigh)
        || !integers.TryFind(13, ref init rightOverflow, ref init rightLow, ref init rightHigh)
        || leftOverflow || rightOverflow)
    {
        return false;
    }
    uint64 left = DecodeScannerMagnitude(leftLow, leftHigh);
    uint64 right = DecodeScannerMagnitude(rightLow, rightHigh);
    mut bool less = left < right;
    mut bool greater = left > right;
    if (selected == 1)
    {
        if (leftHigh != 0 || rightHigh != 0
            || (leftLow < 0 && !IsBasedInteger(leftLiteral))
            || (rightLow < 0 && !IsBasedInteger(rightLiteral)))
        {
            return false;
        }
        less = leftLow < rightLow;
        greater = leftLow > rightLow;
    }
    else if (selected == 2)
    {
        if (leftHigh != 0 || rightHigh != 0)
        {
            return false;
        }
    }
    else if (selected == 6)
    {
        if (leftHigh != 0 || rightHigh != 0
            || leftLow < 0 || rightLow < 0
            || leftLow > 65535 || rightLow > 65535)
        {
            return false;
        }
    }
    else if (selected == 3)
    {
        init int64 signedLeft;
        init int64 signedRight;
        if (!TryDecodeSigned64Scalar(left, IsBasedInteger(leftLiteral), ref init signedLeft)
            || !TryDecodeSigned64Scalar(right, IsBasedInteger(rightLiteral), ref init signedRight))
        {
            return false;
        }
        less = signedLeft < signedRight;
        greater = signedLeft > signedRight;
    }

    *name = function.Range;
    *result = EvaluateScalarComparison(comparison.Kind, left == right, less, greater);
    return true;
}

bool TryParseParameterComparisonReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    ref<init int32> scalarType, ref<init int32> operation, ref<init SourceRange> name,
    ref<init uint64> magnitude, ref<init bool> based)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 14)
    {
        return false;
    }
    init Token returnType;
    require tokens.TryGet(0, ref init returnType);
    init Token function;
    require tokens.TryGet(1, ref init function);
    init Token openParameters;
    require tokens.TryGet(2, ref init openParameters);
    init Token parameterType;
    require tokens.TryGet(3, ref init parameterType);
    init Token parameter;
    require tokens.TryGet(4, ref init parameter);
    init Token closeParameters;
    require tokens.TryGet(5, ref init closeParameters);
    init Token openBody;
    require tokens.TryGet(6, ref init openBody);
    init Token returnKeyword;
    require tokens.TryGet(7, ref init returnKeyword);
    init Token parameterUse;
    require tokens.TryGet(8, ref init parameterUse);
    init Token comparison;
    require tokens.TryGet(9, ref init comparison);
    init Token literal;
    require tokens.TryGet(10, ref init literal);
    init Token semicolon;
    require tokens.TryGet(11, ref init semicolon);
    init Token closeBody;
    require tokens.TryGet(12, ref init closeBody);
    init Token eof;
    require tokens.TryGet(13, ref init eof);
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    init int32 selectedReturn;
    init int32 selected;
    if (!TryGetScalarType(returnType, ref init selectedReturn) || selectedReturn != 5
        || !TryGetScalarType(parameterType, ref init selected) || selected == 5
        || function.Kind != 2 || openParameters.Kind != 46 || parameter.Kind != 2
        || closeParameters.Kind != 47 || openBody.Kind != 48
        || returnKeyword.Kind != 19 || parameterUse.Kind != 2
        || comparison.Kind < 65 || comparison.Kind > 70 || literal.Kind != 3
        || semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0
        || !SameTokenSpelling(parameter, parameterUse))
    {
        return false;
    }
