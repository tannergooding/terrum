        return false;
    }
    *name = foundName;
    *result = first - second;
    return true;
}

bool TryEvaluateInt32TwoParameterComparisonReturn(TokenSnapshot tokens, int32 first, int32 second,
    ref<init SourceRange> name, ref<init bool> result)
{
    init int32 selected;
    init int32 operation;
    init SourceRange foundName;
    if (!TryParseTwoParameterComparisonReturn(move tokens,
            ref init selected, ref init operation, ref init foundName)
        || selected != 1)
    {
        return false;
    }
    *name = foundName;
    *result = EvaluateScalarComparison(operation, first == second, first < second, first > second);
    return true;
}

