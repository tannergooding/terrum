bool TryEvaluateInt32TwoParameterSubtractReturn(TokenSnapshot tokens, int32 first, int32 second,
    ref<init SourceRange> name, ref<init int32> result)
{
    init int32 selected;
    init SourceRange foundName;
    if (!TryParseTwoParameterSubtractReturn(move tokens, ref init selected, ref init foundName)
        || selected != 1)
    {
        return false;
    }
    int64 difference = int64(first) - int64(second);
    if (difference < int64(int32.MinValue) || difference > int64(int32.MaxValue))
    {
        return false;
    }
    *name = foundName;
    *result = int32(difference);
    return true;
}

bool TryEvaluateUInt32TwoParameterSubtractReturn(TokenSnapshot tokens, uint32 first, uint32 second,
    ref<init SourceRange> name, ref<init uint32> result)
{
    init int32 selected;
    init SourceRange foundName;
    if (!TryParseTwoParameterSubtractReturn(move tokens, ref init selected, ref init foundName)
        || selected != 2 || first < second)
    {
        return false;
    }
    *name = foundName;
    *result = first - second;
    return true;
}

bool TryEvaluateInt64TwoParameterSubtractReturn(TokenSnapshot tokens, int64 first, int64 second,
    ref<init SourceRange> name, ref<init int64> result)
{
    init int32 selected;
    init SourceRange foundName;
    if (!TryParseTwoParameterSubtractReturn(move tokens, ref init selected, ref init foundName)
        || selected != 3
        || (second > 0 && first < int64.MinValue + second)
        || (second < 0 && first > int64.MaxValue + second))
    {
        return false;
    }
    *name = foundName;
    *result = first - second;
    return true;
}

bool TryEvaluateUInt64TwoParameterSubtractReturn(TokenSnapshot tokens, uint64 first, uint64 second,
    ref<init SourceRange> name, ref<init uint64> result)
{
    init int32 selected;
    init SourceRange foundName;
    if (!TryParseTwoParameterSubtractReturn(move tokens, ref init selected, ref init foundName)
        || selected != 4 || first < second)
