namespace Terrum.CodeAnalysis;

bool TryParseTwoParameterBinaryPrefix(TokenSnapshot tokens, int32 operatorKind,
    bool comparison,
    ref<init int32> scalarType, ref<init SourceRange> name)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 17 && tokens.GetCount() != 19)
    {
        return false;
    }
    init Token returnType;
    require tokens.TryGet(0, ref init returnType);
    init Token function;
    require tokens.TryGet(1, ref init function);
    init Token openParameters;
    require tokens.TryGet(2, ref init openParameters);
    init Token firstType;
    require tokens.TryGet(3, ref init firstType);
    init Token firstParameter;
    require tokens.TryGet(4, ref init firstParameter);
    init Token comma;
    require tokens.TryGet(5, ref init comma);
    init Token secondType;
    require tokens.TryGet(6, ref init secondType);
    init Token secondParameter;
    require tokens.TryGet(7, ref init secondParameter);
    init Token closeParameters;
    require tokens.TryGet(8, ref init closeParameters);
    init Token openBody;
    require tokens.TryGet(9, ref init openBody);
    init Token returnKeyword;
    require tokens.TryGet(10, ref init returnKeyword);
    init Token firstUse;
    require tokens.TryGet(11, ref init firstUse);
    init Token binary;
    require tokens.TryGet(12, ref init binary);
    init Token secondUse;
    require tokens.TryGet(13, ref init secondUse);
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    init int32 resultType;
    init int32 matchingFirst;
    init int32 matchingSecond;
    if (!TryGetScalarType(returnType, ref init resultType)
        || !TryGetScalarType(firstType, ref init matchingFirst)
        || !TryGetScalarType(secondType, ref init matchingSecond)
        || matchingFirst != matchingSecond
        || (comparison && resultType != 5)
        || (!comparison && resultType != matchingFirst)
        || matchingFirst == 5 || (!comparison && matchingFirst == 6)
        || function.Kind != 2 || openParameters.Kind != 46 || comma.Kind != 53
        || closeParameters.Kind != 47 || openBody.Kind != 48
        || returnKeyword.Kind != 19 || binary.Kind != operatorKind
        || !SameTokenSpelling(firstParameter, firstUse)
        || !SameTokenSpelling(secondParameter, secondUse)
        || SameTokenSpelling(firstParameter, secondParameter))
    {
        return false;
    }
    *scalarType = matchingFirst;
    *name = function.Range;
    return true;
}

bool TryParseTwoParameterAddPrefix(TokenSnapshot tokens,
    ref<init int32> scalarType, ref<init SourceRange> name)
{
    return TryParseTwoParameterBinaryPrefix(move tokens, 57, false, ref init *scalarType, ref init *name);
}

bool TryParseTwoParameterAddReturn(TokenSnapshot tokens,
    ref<init int32> scalarType, ref<init SourceRange> name)
{
    if (tokens.GetCount() != 17)
    {
        return false;
    }
    init Token semicolon;
    require tokens.TryGet(14, ref init semicolon);
    init Token closeBody;
    require tokens.TryGet(15, ref init closeBody);
    init Token eof;
    require tokens.TryGet(16, ref init eof);
    if (semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }
    return TryParseTwoParameterAddPrefix(move tokens, ref init *scalarType, ref init *name);
}

bool TryParseTwoParameterSubtractReturn(TokenSnapshot tokens,
    ref<init int32> scalarType, ref<init SourceRange> name)
{
    if (tokens.GetCount() != 17)
    {
        return false;
    }
    init Token semicolon;
    require tokens.TryGet(14, ref init semicolon);
    init Token closeBody;
    require tokens.TryGet(15, ref init closeBody);
    init Token eof;
    require tokens.TryGet(16, ref init eof);
    if (semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }
    return TryParseTwoParameterBinaryPrefix(move tokens, 58, false, ref init *scalarType, ref init *name);
}

bool TryParseTwoParameterComparisonReturn(TokenSnapshot tokens,
    ref<init int32> scalarType, ref<init int32> operation, ref<init SourceRange> name)
{
    if (tokens.GetCount() != 17)
    {
        return false;
    }
    init Token comparison;
    require tokens.TryGet(12, ref init comparison);
    init Token semicolon;
    require tokens.TryGet(14, ref init semicolon);
    init Token closeBody;
    require tokens.TryGet(15, ref init closeBody);
    init Token eof;
    require tokens.TryGet(16, ref init eof);
    init int32 selected;
    init SourceRange foundName;
    if (comparison.Kind < 65 || comparison.Kind > 70
        || semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0
        || !TryParseTwoParameterBinaryPrefix(move tokens, comparison.Kind, true,
            ref init selected, ref init foundName))
    {
        return false;
    }
    *scalarType = selected;
    *operation = comparison.Kind;
    *name = foundName;
    return true;
}

bool TryParseTwoParameterAddAndLiteralReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, ref<init int32> scalarType, ref<init SourceRange> name,
    ref<init uint64> magnitude, ref<init bool> based)
{
    if (tokens.GetCount() != 19)
    {
        return false;
    }
    init Token add;
    require tokens.TryGet(14, ref init add);
    init Token literal;
    require tokens.TryGet(15, ref init literal);
    init Token semicolon;
    require tokens.TryGet(16, ref init semicolon);
    init Token closeBody;
    require tokens.TryGet(17, ref init closeBody);
    init Token eof;
    require tokens.TryGet(18, ref init eof);
    init int32 selected;
    init SourceRange foundName;
    init bool overflow;
    init int32 low;
    init int32 high;
    if (add.Kind != 57 || literal.Kind != 3 || semicolon.Kind != 52
        || closeBody.Kind != 49 || eof.Kind != 0
        || !TryParseTwoParameterAddPrefix(move tokens, ref init selected,
            ref init foundName)
        || !integers.TryFind(15, ref init overflow, ref init low, ref init high)
        || overflow)
    {
        return false;
    }
    *scalarType = selected;
    *name = foundName;
    *magnitude = DecodeScannerMagnitude(low, high);
    *based = IsBasedInteger(literal);
    return true;
}

bool TryEvaluateInt32TwoParameterAddAndLiteralReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, int32 first, int32 second,
    ref<init SourceRange> name, ref<init int32> result)
{
    init int32 selected;
    init SourceRange foundName;
    init uint64 magnitude;
    init bool based;
    if (!TryParseTwoParameterAddAndLiteralReturn(move tokens, move integers,
            ref init selected, ref init foundName, ref init magnitude, ref init based)
        || selected != 1
        || magnitude > uint64(uint32.MaxValue)
        || (!based && magnitude > uint64(int32.MaxValue)))
    {
        return false;
    }
    int64 firstSum = int64(first) + int64(second);
    if (firstSum < int64(int32.MinValue) || firstSum > int64(int32.MaxValue))
    {
        return false;
    }
    mut int64 literal = int64(magnitude);
    if (magnitude > uint64(int32.MaxValue))
    {
        literal = literal - 4294967296;
    }
    int64 finalSum = firstSum + literal;
    if (finalSum < int64(int32.MinValue) || finalSum > int64(int32.MaxValue))
    {
        return false;
    }
    *name = foundName;
    *result = int32(finalSum);
    return true;
}

bool TryEvaluateUInt32TwoParameterAddAndLiteralReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, uint32 first, uint32 second,
    ref<init SourceRange> name, ref<init uint32> result)
{
    init int32 selected;
    init SourceRange foundName;
    init uint64 magnitude;
    init bool based;
    if (!TryParseTwoParameterAddAndLiteralReturn(move tokens, move integers,
            ref init selected, ref init foundName, ref init magnitude, ref init based)
        || selected != 2 || magnitude > uint64(uint32.MaxValue))
    {
        return false;
    }
    uint64 firstSum = uint64(first) + uint64(second);
    uint64 finalSum = firstSum + magnitude;
    if (firstSum > uint64(uint32.MaxValue) || finalSum > uint64(uint32.MaxValue))
    {
        return false;
    }
    *name = foundName;
    *result = uint32(finalSum);
    return true;
}

bool TryEvaluateInt64TwoParameterAddAndLiteralReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, int64 first, int64 second,
    ref<init SourceRange> name, ref<init int64> result)
{
    init int32 selected;
    init SourceRange foundName;
    init uint64 magnitude;
    init bool based;
    init int64 literal;
    if (!TryParseTwoParameterAddAndLiteralReturn(move tokens, move integers,
            ref init selected, ref init foundName, ref init magnitude, ref init based)
        || selected != 3 || !TryDecodeSigned64Scalar(magnitude, based, ref init literal)
        || (second > 0 && first > int64.MaxValue - second)
        || (second < 0 && first < int64.MinValue - second))
    {
        return false;
    }
    int64 firstSum = first + second;
    if ((literal > 0 && firstSum > int64.MaxValue - literal)
        || (literal < 0 && firstSum < int64.MinValue - literal))
    {
        return false;
    }
    *name = foundName;
    *result = firstSum + literal;
    return true;
}

bool TryEvaluateUInt64TwoParameterAddAndLiteralReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, uint64 first, uint64 second,
    ref<init SourceRange> name, ref<init uint64> result)
{
    init int32 selected;
    init SourceRange foundName;
    init uint64 magnitude;
    init bool based;
    if (!TryParseTwoParameterAddAndLiteralReturn(move tokens, move integers,
            ref init selected, ref init foundName, ref init magnitude, ref init based)
        || selected != 4 || first > uint64.MaxValue - second)
    {
        return false;
    }
    uint64 firstSum = first + second;
    if (firstSum > uint64.MaxValue - magnitude)
    {
        return false;
    }
    *name = foundName;
    *result = firstSum + magnitude;
    return true;
}

bool TryEvaluateInt32TwoParameterAddReturn(TokenSnapshot tokens, int32 first, int32 second,
    ref<init SourceRange> name, ref<init int32> result)
{
    init int32 selected;
    init SourceRange foundName;
    init int32 sum;
    if (!TryParseTwoParameterAddReturn(move tokens, ref init selected, ref init foundName)
        || selected != 1 || !TryAddScalarInt32(first, second, ref init sum))
    {
        return false;
    }
    *name = foundName;
    *result = sum;
    return true;
}

