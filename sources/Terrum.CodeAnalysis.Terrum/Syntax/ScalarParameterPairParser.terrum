bool TryEvaluateChar16TwoParameterComparisonReturn(TokenSnapshot tokens, char16 first, char16 second,
    ref<init SourceRange> name, ref<init bool> result)
{
    init int32 selected;
    init int32 operation;
    init SourceRange foundName;
    if (!TryParseTwoParameterComparisonReturn(move tokens,
            ref init selected, ref init operation, ref init foundName)
        || selected != 6)
    {
        return false;
