namespace Terrum.CodeAnalysis;

bool TryParseScalarComparisonConditionalReturn(TokenSnapshot tokens,
    ref<init int32> scalarType, ref<init int32> operation, ref<init SourceRange> name)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 29)
    {
        return false;
    }
    init Token returnType;
    require tokens.TryGet(0, ref init returnType);
    init Token function;
    require tokens.TryGet(1, ref init function);
    init Token openParameters;
    require tokens.TryGet(2, ref init openParameters);
    init Token firstType;
    require tokens.TryGet(3, ref init firstType);
    init Token firstParameter;
    require tokens.TryGet(4, ref init firstParameter);
    init Token comma;
    require tokens.TryGet(5, ref init comma);
    init Token secondType;
    require tokens.TryGet(6, ref init secondType);
    init Token secondParameter;
    require tokens.TryGet(7, ref init secondParameter);
    init Token closeParameters;
    require tokens.TryGet(8, ref init closeParameters);
    init Token openBody;
    require tokens.TryGet(9, ref init openBody);
    init Token branch;
    require tokens.TryGet(10, ref init branch);
    init Token openCondition;
    require tokens.TryGet(11, ref init openCondition);
    init Token firstCondition;
    require tokens.TryGet(12, ref init firstCondition);
    init Token comparison;
    require tokens.TryGet(13, ref init comparison);
    init Token secondCondition;
    require tokens.TryGet(14, ref init secondCondition);
    init Token closeCondition;
    require tokens.TryGet(15, ref init closeCondition);
    init Token openTrue;
    require tokens.TryGet(16, ref init openTrue);
    init Token trueReturn;
    require tokens.TryGet(17, ref init trueReturn);
    init Token firstUse;
    require tokens.TryGet(18, ref init firstUse);
    init Token trueSemicolon;
    require tokens.TryGet(19, ref init trueSemicolon);
    init Token closeTrue;
    require tokens.TryGet(20, ref init closeTrue);
    init Token otherwise;
    require tokens.TryGet(21, ref init otherwise);
    init Token openFalse;
    require tokens.TryGet(22, ref init openFalse);
    init Token falseReturn;
    require tokens.TryGet(23, ref init falseReturn);
    init Token secondUse;
    require tokens.TryGet(24, ref init secondUse);
    init Token falseSemicolon;
    require tokens.TryGet(25, ref init falseSemicolon);
    init Token closeFalse;
    require tokens.TryGet(26, ref init closeFalse);
    init Token closeBody;
    require tokens.TryGet(27, ref init closeBody);
    init Token eof;
    require tokens.TryGet(28, ref init eof);
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    init int32 selected;
    init int32 matchingFirst;
    init int32 matchingSecond;
    if (!TryGetScalarType(returnType, ref init selected)
        || !TryGetScalarType(firstType, ref init matchingFirst)
        || !TryGetScalarType(secondType, ref init matchingSecond)
        || selected != matchingFirst || selected != matchingSecond || selected == 5
        || function.Kind != 2 || openParameters.Kind != 46 || comma.Kind != 53
        || closeParameters.Kind != 47 || openBody.Kind != 48
        || branch.Kind != 16 || openCondition.Kind != 46
        || comparison.Kind < 65 || comparison.Kind > 70
        || closeCondition.Kind != 47 || openTrue.Kind != 48
        || trueReturn.Kind != 19 || trueSemicolon.Kind != 52
        || closeTrue.Kind != 49 || otherwise.Kind != 17
        || openFalse.Kind != 48 || falseReturn.Kind != 19
        || falseSemicolon.Kind != 52 || closeFalse.Kind != 49
        || closeBody.Kind != 49 || eof.Kind != 0
        || !SameTokenSpelling(firstParameter, firstCondition)
        || !SameTokenSpelling(secondParameter, secondCondition)
        || !SameTokenSpelling(firstParameter, firstUse)
        || !SameTokenSpelling(secondParameter, secondUse)
        || SameTokenSpelling(firstParameter, secondParameter))
    {
        return false;
    }
    *scalarType = selected;
    *operation = comparison.Kind;
    *name = function.Range;
    return true;
}

bool TryEvaluateInt32ComparisonConditionalReturn(TokenSnapshot tokens,
    int32 first, int32 second, ref<init SourceRange> name, ref<init int32> result)
{
    init int32 selected;
    init int32 operation;
    init SourceRange foundName;
    if (!TryParseScalarComparisonConditionalReturn(move tokens,
            ref init selected, ref init operation, ref init foundName)
        || selected != 1)
    {
        return false;
    }
    *name = foundName;
    if (EvaluateScalarComparison(operation, first == second, first < second, first > second))
    {
        *result = first;
    }
    else
    {
        *result = second;
    }
    return true;
}

