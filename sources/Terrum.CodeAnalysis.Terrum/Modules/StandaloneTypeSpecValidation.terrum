namespace Terrum.CodeAnalysis;

bool IsStandaloneTypeSpecInlineFamily(int32 familyCode)
{
    return (familyCode >= 0x80 && familyCode <= 0x84)
        || familyCode == 0x8A
        || (familyCode >= 0x8B && familyCode <= 0x8F);
}

bool TryValidateStandaloneTypeSpecTable(int32 artifactStart,
    int32 artifactLength)
{
    int32 typeSpecEntry = FindStandaloneArtifactSection(0x0011);
    int32 typeSpecCount = GetStandaloneArtifactSectionCount(0x0011);
    if (typeSpecCount == 0)
    {
        return typeSpecEntry == 0;
    }
    if (typeSpecEntry == 0)
    {
        return false;
    }

    int32 typeSpecStart = Host.StandaloneSectionStarts[typeSpecEntry];
    int32 typeSpecLength = Host.StandaloneSectionLengths[typeSpecEntry];
    if (!TryValidateStandaloneVariableTableIndex(artifactStart,
            artifactLength, typeSpecStart, typeSpecLength,
            typeSpecCount, 2, 1))
    {
        return false;
    }

    int32 typeDefCount = GetStandaloneArtifactSectionCount(0x0013);
    int32 importCount = GetStandaloneArtifactSectionCount(0x001C);
    int32 genericParamCount = GetStandaloneArtifactSectionCount(0x0019);
    int32 methodDefCount = GetStandaloneArtifactSectionCount(0x0016);
    int32 constraintCount = GetStandaloneArtifactSectionCount(0x001A);
    int32 constantSourceCount = GetStandaloneArtifactSectionCount(0x0030);
    int32 predicateCaptureCount = GetStandaloneArtifactSectionCount(0x003E);
    for (mut int32 row = 1; row <= typeSpecCount; row = row + 1)
    {
        init int32 rowStart;
        init int32 rowLength;
        if (!TryGetStandaloneVariableTableRowExtent(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, 2, 1, row,
                ref init rowStart, ref init rowLength))
        {
            return false;
        }

        init int32 form;
        init int32 qualifiers;
        if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, rowStart, ref init form)
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, rowStart + 1, ref init qualifiers)
            || (qualifiers & ~7) != 0)
        {
            return false;
        }

        if (form == 1)
        {
            init int32 code;
            if (rowLength < 3
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 2, ref init code))
            {
                return false;
            }
            if (code <= 0x19)
            {
                if (rowLength != 3 || (qualifiers & ~4) != 0)
                {
                    return false;
                }
            }
            else
            {
                init int32 argumentCode;
                if (!IsStandaloneTypeSpecInlineFamily(code)
                    || rowLength != 4
                    || !TryReadStandaloneArtifactAbsoluteByte(
                        artifactStart, artifactLength, rowStart + 3,
                        ref init argumentCode)
                    || argumentCode > 0x19
                    || ((qualifiers & 2) != 0
                        && code != 0x8B && code != 0x8D))
                {
                    return false;
                }
            }
            continue;
        }

        if (form >= 2 && form <= 4)
        {
            init uint32 targetRow;
            int32 targetCount = form == 2 ? typeDefCount
                : form == 3 ? importCount : genericParamCount;
            if (rowLength != 6
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 2, ref init targetRow)
                || targetRow == 0 || targetRow > uint32(targetCount))
            {
                return false;
            }
            continue;
        }

        if (form == 5)
        {
            init uint32 genericTypeSpec;
            if (rowLength < 10 || (rowLength - 6) % 4 != 0
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 2,
                    ref init genericTypeSpec)
                || genericTypeSpec == 0
                || genericTypeSpec >= uint32(row))
            {
                return false;
            }
            init int32 genericRowStart;
            init int32 genericRowLength;
            init int32 genericForm;
            if (!TryGetStandaloneVariableTableRowExtent(artifactStart,
                    artifactLength, typeSpecStart, typeSpecLength,
                    typeSpecCount, 2, 1, int32(genericTypeSpec),
                    ref init genericRowStart, ref init genericRowLength)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, genericRowStart,
                    ref init genericForm)
                || (genericForm != 2 && genericForm != 3)
                || !TryValidateStandaloneConstructedTypeArguments(
                    artifactStart, artifactLength, typeSpecStart,
                    typeSpecLength, typeSpecCount, row, rowStart,
                    rowLength, genericTypeSpec, genericForm, genericParamCount,
                    constraintCount, constantSourceCount))
            {
                return false;
            }
            continue;
        }

        if (form >= 6 && form <= 0x0B)
        {
            init uint32 inner;
            init bool isRow;
            init int32 innerRow;
            init int32 innerForm;
            init int32 innerQualifiers;
            init int32 innerCode;
            init int32 innerArgument;
            if (rowLength != 6
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 2, ref init inner)
                || !TryGetStandaloneTypeSpecRefInfo(artifactStart,
                    artifactLength, typeSpecStart, typeSpecLength,
                    typeSpecCount, inner, allowInitQualifier: false,
                    rowLimit: row, ref init isRow, ref init innerRow,
                    ref init innerForm, ref init innerQualifiers,
                    ref init innerCode, ref init innerArgument)
                || (form != 6 && isRow && innerForm == 1
                    && innerCode < 0x80 && innerQualifiers == 0))
            {
                return false;
            }
            continue;
        }

        if (form == 0x0C)
        {
            init int32 familyCode;
            init uint32 argument;
            init bool isRow;
            init int32 argumentRow;
            init int32 argumentForm;
            init int32 argumentQualifiers;
            init int32 argumentCode;
            init int32 argumentAtom;
            if (rowLength != 7
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 2,
                    ref init familyCode)
                || !IsStandaloneTypeSpecInlineFamily(familyCode)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 3,
                    ref init argument)
                || !TryGetStandaloneTypeSpecRefInfo(artifactStart,
                    artifactLength, typeSpecStart, typeSpecLength,
                    typeSpecCount, argument,
                    allowInitQualifier: familyCode == 0x8A,
                    rowLimit: row, ref init isRow,
                    ref init argumentRow, ref init argumentForm,
                    ref init argumentQualifiers, ref init argumentCode,
                    ref init argumentAtom)
                || (isRow && argumentForm == 1
                    && argumentCode < 0x80
                    && argumentQualifiers == 0))
            {
                return false;
            }
            continue;
        }

        if (form == 0x0D)
        {
            init int32 callingConvention;
            init uint32 methodDefRow;
            if (rowLength != 7 || qualifiers != 0
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 2,
                    ref init callingConvention)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 3,
                    ref init methodDefRow)
                || callingConvention < 1 || callingConvention > 4
                || methodDefRow == 0
                || methodDefRow > uint32(methodDefCount))
            {
                return false;
            }
            continue;
        }

        if (form == 0x0E)
        {
            init uint32 inner;
            init bool isRow;
            init int32 innerRow;
            init int32 innerForm;
            init int32 innerQualifiers;
            init int32 innerCode;
            init int32 innerArgument;
            if (rowLength != 6 || (qualifiers & ~1) != 0
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 2, ref init inner)
                || !TryGetStandaloneTypeSpecRefInfo(artifactStart,
                    artifactLength, typeSpecStart, typeSpecLength,
                    typeSpecCount, inner, allowInitQualifier: false,
                    rowLimit: row, ref init isRow, ref init innerRow,
                    ref init innerForm, ref init innerQualifiers,
                    ref init innerCode, ref init innerArgument))
            {
                return false;
            }
            continue;
        }

        if (form == 0x0F)
        {
            if (rowLength != 2 || qualifiers != 0)
            {
                return false;
            }
            continue;
        }

        if (form == 0x10)
        {
            init uint32 captureRow;
            if (rowLength != 6 || qualifiers != 0
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 2, ref init captureRow)
                || captureRow == 0
                || captureRow > uint32(predicateCaptureCount))
            {
                return false;
            }
            continue;
        }

        return false;
    }

    return true;
}

bool TryValidateStandaloneConstructedTypeArguments(int32 artifactStart,
    int32 artifactLength, int32 typeSpecStart, int32 typeSpecLength,
    int32 typeSpecCount, int32 constructedRow, int32 constructedRowStart,
    int32 constructedRowLength, uint32 genericTypeSpec,
    int32 genericTypeSpecForm, int32 genericParamCount,
    int32 constraintCount, int32 constantSourceCount)
{
    int32 typeDefCount = GetStandaloneArtifactSectionCount(0x0013);
    int32 typeDefEntry = FindStandaloneArtifactSection(0x0013);
    int32 importCount = GetStandaloneArtifactSectionCount(0x001C);
    int32 importEntry = FindStandaloneArtifactSection(0x001C);
    int32 genericParamEntry = FindStandaloneArtifactSection(0x0019);
    if (typeDefEntry == 0 || genericParamEntry == 0
        || (genericTypeSpecForm == 3 && importEntry == 0))
    {
        return false;
    }

    init int32 genericRowStart;
    init int32 genericRowLength;
    init uint32 genericDefinitionRow;
    if (!TryGetStandaloneVariableTableRowExtent(artifactStart,
            artifactLength, typeSpecStart, typeSpecLength, typeSpecCount,
            2, 1, int32(genericTypeSpec), ref init genericRowStart,
            ref init genericRowLength)
        || genericRowLength != 6
        || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, genericRowStart + 2,
            ref init genericDefinitionRow))
    {
        return false;
    }

    init int32 typeDefRow;
    if (genericTypeSpecForm == 2)
    {
        if (genericDefinitionRow == 0
            || genericDefinitionRow > uint32(typeDefCount))
        {
            return false;
        }
        typeDefRow = int32(genericDefinitionRow);
    }
    else
    {
        if (genericDefinitionRow == 0
            || genericDefinitionRow > uint32(importCount))
        {
            return false;
        }
        int32 importStart = Host.StandaloneSectionStarts[importEntry]
            + ((int32(genericDefinitionRow) - 1) * 12);
        init uint32 expectedTypeDef;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, importStart + 8,
                ref init expectedTypeDef)
            || (expectedTypeDef >> 24) != 0x13)
        {
            return false;
        }
        uint32 expectedTypeDefRow = expectedTypeDef & 0x00FF_FFFF;
        if (expectedTypeDefRow == 0
            || expectedTypeDefRow > uint32(typeDefCount))
        {
            return false;
        }
        typeDefRow = int32(expectedTypeDefRow);
    }

    int32 typeDefStart = Host.StandaloneSectionStarts[typeDefEntry]
        + ((typeDefRow - 1) * 44);
    init uint32 firstFormal;
    init uint32 formalCount;
    if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, typeDefStart + 20, ref init firstFormal)
        || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, typeDefStart + 24, ref init formalCount)
        || formalCount == 0
        || formalCount != uint32((constructedRowLength - 6) / 4)
        || !IsStandaloneMetadataRange(firstFormal, formalCount,
            genericParamCount))
    {
        return false;
    }

    int32 genericParamStart = Host.StandaloneSectionStarts[genericParamEntry];
    for (mut int32 ordinal = 0;
        ordinal < int32(formalCount);
        ordinal = ordinal + 1)
    {
        int32 formalRow = int32(firstFormal) + ordinal;
        int32 formalOffset = genericParamStart + ((formalRow - 1) * 32);
        int32 argumentOffset = constructedRowStart + 6 + (ordinal * 4);
        init uint32 ownerDefId;
        init uint32 formalOrdinal;
        init uint32 constraintFirst;
        init uint32 formalConstraintCount;
        init int32 formalKind;
        init int32 ownershipDomain;
        init int32 nullabilityDomain;
        init int32 formalReserved;
        init uint32 constantTypeSpec;
        init uint32 defaultArgument;
        init uint32 argument;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, formalOffset, ref init ownerDefId)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, formalOffset + 4,
                ref init formalOrdinal)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, formalOffset + 12,
                ref init constraintFirst)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, formalOffset + 16,
                ref init formalConstraintCount)
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, formalOffset + 20, ref init formalKind)
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, formalOffset + 21,
                ref init ownershipDomain)
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, formalOffset + 22,
                ref init nullabilityDomain)
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, formalOffset + 23,
                ref init formalReserved)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, formalOffset + 24,
                ref init constantTypeSpec)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, formalOffset + 28,
                ref init defaultArgument)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, argumentOffset, ref init argument)
            || ownerDefId
                != (uint32(0x1300_0000) | uint32(typeDefRow))
            || formalOrdinal != uint32(ordinal)
            || formalReserved != 0
            || !IsStandaloneMetadataRange(constraintFirst,
                formalConstraintCount, constraintCount))
        {
            return false;
        }

        if (formalKind == 1)
        {
            init bool argumentIsRow;
            init int32 argumentRow;
            init int32 argumentForm;
            init int32 argumentQualifiers;
            init int32 argumentCode;
            init int32 argumentAtom;
            if (ownershipDomain < 1 || ownershipDomain > 3
                || nullabilityDomain < 1 || nullabilityDomain > 2
                || constantTypeSpec != 0
                || !TryGetStandaloneTypeSpecRefInfo(artifactStart,
                    artifactLength, typeSpecStart, typeSpecLength,
                    typeSpecCount, argument,
                    allowInitQualifier: false, rowLimit: constructedRow,
                    ref init argumentIsRow, ref init argumentRow,
                    ref init argumentForm, ref init argumentQualifiers,
                    ref init argumentCode, ref init argumentAtom))
            {
                return false;
            }
            if (defaultArgument != 0)
            {
                init bool defaultIsRow;
                init int32 defaultRow;
                init int32 defaultForm;
                init int32 defaultQualifiers;
                init int32 defaultCode;
                init int32 defaultAtom;
                if (!TryGetStandaloneTypeSpecRefInfo(artifactStart,
                        artifactLength, typeSpecStart, typeSpecLength,
                        typeSpecCount, defaultArgument,
                        allowInitQualifier: false, rowLimit: 0,
                        ref init defaultIsRow, ref init defaultRow,
                        ref init defaultForm, ref init defaultQualifiers,
                        ref init defaultCode, ref init defaultAtom))
                {
                    return false;
                }
            }
        }
        else if (formalKind == 2)
        {
            if (ownershipDomain != 0 || nullabilityDomain != 0
                || constantTypeSpec == 0 || formalConstraintCount != 0
                || argument == 0
                || argument > uint32(constantSourceCount)
                || (defaultArgument != 0
                    && defaultArgument > uint32(constantSourceCount)))
            {
                return false;
            }
            init bool constantTypeIsRow;
            init int32 constantTypeRow;
            init int32 constantTypeForm;
            init int32 constantTypeQualifiers;
            init int32 constantTypeCode;
            init int32 constantTypeArgument;
            if (!TryGetStandaloneTypeSpecRefInfo(artifactStart,
                    artifactLength, typeSpecStart, typeSpecLength,
                    typeSpecCount, constantTypeSpec,
                    allowInitQualifier: false, rowLimit: 0,
                    ref init constantTypeIsRow, ref init constantTypeRow,
                    ref init constantTypeForm,
                    ref init constantTypeQualifiers,
                    ref init constantTypeCode,
                    ref init constantTypeArgument))
            {
                return false;
            }
        }
        else
        {
            return false;
        }
    }

    return true;
}

bool TryBuildStandaloneProjectionInterfaceMap(int32 artifactStart,
    int32 artifactLength, int32 typeDefCount, int32 interfaceDefCount,
    int32 interfaceBaseCount, int32 interfaceMethodCount)
{
    int32 typeDefEntry = FindStandaloneArtifactSection(0x0013);
    int32 interfaceDefEntry = FindStandaloneArtifactSection(0x0025);
    int32 genericParamCount = GetStandaloneArtifactSectionCount(0x0019);
    int32 genericParamEntry = FindStandaloneArtifactSection(0x0019);
    if (typeDefEntry == 0 || interfaceDefEntry == 0
        || typeDefCount == 0 || interfaceDefCount == 0
        || Host.StandaloneProjectionInterfaceByTypeDef.Length
            <= typeDefCount)
    {
        return false;
    }

    for (mut int32 row = 0; row <= typeDefCount; row = row + 1)
    {
        Host.StandaloneProjectionInterfaceByTypeDef[row] = 0;
    }

    int32 typeDefStart = Host.StandaloneSectionStarts[typeDefEntry];
    int32 interfaceDefStart
        = Host.StandaloneSectionStarts[interfaceDefEntry];
    for (mut int32 interfaceDefRow = 1;
        interfaceDefRow <= interfaceDefCount;
        interfaceDefRow = interfaceDefRow + 1)
    {
        int32 rowOffset = interfaceDefStart
            + ((interfaceDefRow - 1) * 48);
        init uint32 ownerTypeDefRow;
        init uint32 selfGenericParamRow;
        init uint32 baseFirst;
        init uint32 baseCount;
        init uint32 methodFirst;
        init uint32 methodCount;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowOffset, ref init ownerTypeDefRow)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowOffset + 4,
                ref init selfGenericParamRow)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowOffset + 8, ref init baseFirst)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowOffset + 12, ref init baseCount)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowOffset + 16,
                ref init methodFirst)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowOffset + 20,
                ref init methodCount)
            || ownerTypeDefRow == 0
            || ownerTypeDefRow > uint32(typeDefCount)
            || Host.StandaloneProjectionInterfaceByTypeDef[
                int32(ownerTypeDefRow)] != 0
            || !IsStandaloneMetadataRange(baseFirst, baseCount,
                interfaceBaseCount)
            || !IsStandaloneMetadataRange(methodFirst, methodCount,
                interfaceMethodCount))
        {
            return false;
        }

        int32 typeDefRowOffset = typeDefStart
            + ((int32(ownerTypeDefRow) - 1) * 44);
        init int32 typeDefFlags;
        init uint32 genericFirst;
        init uint32 typeGenericCount;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, typeDefRowOffset + 8,
                ref init typeDefFlags)
            || ((typeDefFlags >> 2) & 7) != 3
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, typeDefRowOffset + 20,
                ref init genericFirst)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, typeDefRowOffset + 24,
                ref init typeGenericCount)
            || (selfGenericParamRow != 0
                && (genericParamEntry == 0
                    || selfGenericParamRow > uint32(genericParamCount)
                    || !IsStandaloneMetadataRange(genericFirst,
                        typeGenericCount, genericParamCount)
                    || selfGenericParamRow < genericFirst
                    || selfGenericParamRow - genericFirst
                        >= typeGenericCount)))
        {
            return false;
        }

        if (selfGenericParamRow != 0)
        {
            int32 genericParamStart
                = Host.StandaloneSectionStarts[genericParamEntry]
                    + ((int32(selfGenericParamRow) - 1) * 32);
            init uint32 ownerDefId;
            init int32 formalKind;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, genericParamStart,
                    ref init ownerDefId)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, genericParamStart + 20,
                    ref init formalKind)
                || ownerDefId
                    != (uint32(0x1300_0000) | ownerTypeDefRow)
                || formalKind != 1)
            {
                return false;
            }
        }

        Host.StandaloneProjectionInterfaceByTypeDef[
            int32(ownerTypeDefRow)] = interfaceDefRow;
    }

    for (mut int32 typeDefRow = 1;
        typeDefRow <= typeDefCount;
        typeDefRow = typeDefRow + 1)
    {
        int32 typeDefRowOffset = typeDefStart + ((typeDefRow - 1) * 44);
        init int32 typeDefFlags;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, typeDefRowOffset + 8,
                ref init typeDefFlags)
            || ((((typeDefFlags >> 2) & 7) == 3)
                != (Host.StandaloneProjectionInterfaceByTypeDef[
                    typeDefRow] != 0)))
        {
            return false;
        }
    }

    return true;
}

bool TryGetStandaloneProjectionInterfaceDef(int32 artifactStart,
    int32 artifactLength, int32 typeSpecStart, int32 typeSpecLength,
    int32 typeSpecCount, uint32 interfaceTypeSpec,
    ref<init int32> interfaceDefRowResult,
    ref<init uint32> typeDefRowResult)
    ensure return ? (*interfaceDefRowResult is init
        && *typeDefRowResult is init) : true
{
    init bool isRow;
    init int32 typeSpecRow;
    init int32 typeSpecForm;
    init int32 typeSpecQualifiers;
    init int32 typeSpecCode;
    init int32 typeSpecArgument;
    if (!TryGetStandaloneTypeSpecRefInfo(artifactStart,
            artifactLength, typeSpecStart, typeSpecLength,
            typeSpecCount, interfaceTypeSpec,
            allowInitQualifier: false, rowLimit: 0,
            ref init isRow, ref init typeSpecRow,
            ref init typeSpecForm, ref init typeSpecQualifiers,
            ref init typeSpecCode, ref init typeSpecArgument)
        || !isRow)
    {
        return false;
    }

    init int32 rowStart;
    init int32 rowLength;
    if (!TryGetStandaloneVariableTableRowExtent(artifactStart,
            artifactLength, typeSpecStart, typeSpecLength,
            typeSpecCount, 2, 1, typeSpecRow,
            ref init rowStart, ref init rowLength))
    {
        return false;
    }

    int32 nominalForm = typeSpecForm;
    int32 nominalRowStart = rowStart;
    if (typeSpecForm == 5)
    {
        init uint32 genericTypeSpec;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowStart + 2, ref init genericTypeSpec)
            || !TryGetStandaloneVariableTableRowExtent(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, 2, 1, int32(genericTypeSpec),
                ref init rowStart, ref init rowLength)
            || rowLength != 6
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, rowStart, ref init nominalForm))
        {
            return false;
        }
        nominalRowStart = rowStart;
    }

    if (nominalForm != 2 && nominalForm != 3)
    {
        return false;
    }

    init uint32 nominalRow;
    if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, nominalRowStart + 2,
            ref init nominalRow))
    {
        return false;
    }

    int32 typeDefCount = GetStandaloneArtifactSectionCount(0x0013);
    if (nominalForm == 3)
    {
        int32 importCount = GetStandaloneArtifactSectionCount(0x001C);
        int32 importEntry = FindStandaloneArtifactSection(0x001C);
        if (importEntry == 0 || nominalRow == 0
            || nominalRow > uint32(importCount))
        {
            return false;
        }
        int32 importOffset = Host.StandaloneSectionStarts[importEntry]
            + ((int32(nominalRow) - 1) * 12) + 8;
        init uint32 expectedTypeDef;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, importOffset,
                ref init expectedTypeDef)
            || (expectedTypeDef >> 24) != 0x13)
        {
            return false;
        }
        nominalRow = expectedTypeDef & 0x00FF_FFFF;
    }

    if (nominalRow == 0 || nominalRow > uint32(typeDefCount)
        || Host.StandaloneProjectionInterfaceByTypeDef[
            int32(nominalRow)] == 0)
    {
        return false;
    }

    *typeDefRowResult = nominalRow;
    *interfaceDefRowResult
        = Host.StandaloneProjectionInterfaceByTypeDef[int32(nominalRow)];
    return true;
}

bool TryValidateStandaloneNonGenericInterfaceViews(int32 artifactStart,
    int32 artifactLength, int32 typeSpecStart, int32 typeSpecLength,
    int32 typeSpecCount, int32 interfaceDefCount, int32 interfaceBaseCount,
    int32 projectionRowStart, uint32 viewCount,
    uint32 sourceInterfaceTypeSpec, uint32 requestedInterfaceTypeSpec,
    uint32 sourceInterfaceTypeDefRow,
    uint32 requestedInterfaceTypeDefRow,
    int32 sourceInterfaceDefRow, int32 requestedInterfaceDefRow,
    ref<init bool> closureCompleteResult)
    ensure return ? (*closureCompleteResult is init) : true
{
    *closureCompleteResult = false;
    if (sourceInterfaceTypeSpec != requestedInterfaceTypeSpec
        || sourceInterfaceTypeDefRow != requestedInterfaceTypeDefRow
        || sourceInterfaceDefRow != requestedInterfaceDefRow)
    {
        return true;
    }

    if (Host.StandaloneProjectionViewSeen.Length
            <= interfaceDefCount
        || int64(Host.StandaloneProjectionInterfaceStack.Length)
            < int64(interfaceDefCount) * 2)
    {
        return false;
    }
    for (mut int32 row = 0; row <= interfaceDefCount; row = row + 1)
    {
        Host.StandaloneProjectionViewSeen[row] = 0;
    }

    init bool rootIsRow;
    init int32 rootTypeSpecRow;
    init int32 rootForm;
    init int32 rootQualifiers;
    init int32 rootTypeCode;
    init int32 rootArgumentCode;
    if (!TryGetStandaloneTypeSpecRefInfo(artifactStart,
            artifactLength, typeSpecStart, typeSpecLength,
            typeSpecCount, sourceInterfaceTypeSpec,
            allowInitQualifier: false, rowLimit: 0,
            ref init rootIsRow, ref init rootTypeSpecRow,
            ref init rootForm, ref init rootQualifiers,
            ref init rootTypeCode, ref init rootArgumentCode))
    {
        return false;
    }
    if (!rootIsRow || (rootForm != 2 && rootForm != 3))
    {
        return true;
    }

    int32 interfaceDefEntry = FindStandaloneArtifactSection(0x0025);
    int32 interfaceDefStart
        = Host.StandaloneSectionStarts[interfaceDefEntry];
    int32 rootInterfaceDefOffset = interfaceDefStart
        + ((sourceInterfaceDefRow - 1) * 48);
    init uint32 rootSelfFormal;
    init uint32 rootTypeDefRow;
    if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, rootInterfaceDefOffset + 4,
            ref init rootSelfFormal)
        || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, rootInterfaceDefOffset,
            ref init rootTypeDefRow))
    {
        return false;
    }
    int32 typeDefEntry = FindStandaloneArtifactSection(0x0013);
    int32 typeDefRowOffset = Host.StandaloneSectionStarts[typeDefEntry]
        + ((int32(rootTypeDefRow) - 1) * 44);
    init uint32 rootGenericCount;
    if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, typeDefRowOffset + 24,
            ref init rootGenericCount))
    {
        return false;
    }
    if (rootSelfFormal != 0 || rootGenericCount != 0)
    {
        return true;
    }

    int32 interfaceBaseEntry = FindStandaloneArtifactSection(0x0023);
    int32 interfaceBaseStart = interfaceBaseEntry == 0 ? 0
        : Host.StandaloneSectionStarts[interfaceBaseEntry];
    mut int32 stackCount = 1;
    Host.StandaloneProjectionViewSeen[sourceInterfaceDefRow] = 1;
    Host.StandaloneProjectionInterfaceStack[0]
        = sourceInterfaceDefRow;
    Host.StandaloneProjectionInterfaceStack[1] = 0;
    while (stackCount > 0)
    {
        int32 frameOffset = (stackCount - 1) * 2;
        int32 currentInterfaceDefRow
            = Host.StandaloneProjectionInterfaceStack[frameOffset];
        int32 nextBaseOrdinal
            = Host.StandaloneProjectionInterfaceStack[frameOffset + 1];
        int32 interfaceDefOffset = interfaceDefStart
            + ((currentInterfaceDefRow - 1) * 48);
        init uint32 baseFirst;
        init uint32 baseCount;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, interfaceDefOffset + 8,
                ref init baseFirst)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, interfaceDefOffset + 12,
                ref init baseCount)
            || !IsStandaloneMetadataRange(baseFirst, baseCount,
                interfaceBaseCount))
        {
            return false;
        }

        if (nextBaseOrdinal >= int32(baseCount))
        {
            Host.StandaloneProjectionViewSeen[
                currentInterfaceDefRow] = 2;
            stackCount = stackCount - 1;
            continue;
        }

        Host.StandaloneProjectionInterfaceStack[frameOffset + 1]
            = nextBaseOrdinal + 1;
        int32 baseRow = int32(baseFirst) + nextBaseOrdinal;
        int32 baseOffset = interfaceBaseStart + ((baseRow - 1) * 12);
        init uint32 baseOwner;
        init uint32 baseOrdinal;
        init uint32 baseTypeSpec;
        if (interfaceBaseEntry == 0
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, baseOffset, ref init baseOwner)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, baseOffset + 4,
                ref init baseOrdinal)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, baseOffset + 8,
                ref init baseTypeSpec)
            || baseOwner != uint32(currentInterfaceDefRow)
            || baseOrdinal != uint32(nextBaseOrdinal))
        {
            return false;
        }

        init bool baseIsRow;
        init int32 baseTypeSpecRow;
        init int32 baseForm;
        init int32 baseQualifiers;
        init int32 baseTypeCode;
        init int32 baseArgumentCode;
        init int32 baseInterfaceDefRow;
        init uint32 baseOwnerTypeDefRow;
        if (!TryGetStandaloneTypeSpecRefInfo(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, baseTypeSpec,
                allowInitQualifier: false, rowLimit: 0,
                ref init baseIsRow, ref init baseTypeSpecRow,
                ref init baseForm, ref init baseQualifiers,
                ref init baseTypeCode, ref init baseArgumentCode)
            || !baseIsRow)
        {
            return false;
        }
        if (baseForm == 5)
        {
            return true;
        }
        if ((baseForm != 2 && baseForm != 3)
            || !TryGetStandaloneProjectionInterfaceDef(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, baseTypeSpec,
                ref init baseInterfaceDefRow,
                ref init baseOwnerTypeDefRow))
        {
            return false;
        }

        int32 baseInterfaceDefOffset = interfaceDefStart
            + ((baseInterfaceDefRow - 1) * 48);
        init uint32 baseTypeDefRow;
        init uint32 baseSelfFormal;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, baseInterfaceDefOffset + 4,
                ref init baseSelfFormal)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, baseInterfaceDefOffset,
                ref init baseTypeDefRow))
        {
            return false;
        }
        int32 baseTypeDefRowOffset
            = Host.StandaloneSectionStarts[
                FindStandaloneArtifactSection(0x0013)]
                + ((int32(baseTypeDefRow) - 1) * 44);
        init uint32 baseGenericCount;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, baseTypeDefRowOffset + 24,
                ref init baseGenericCount))
        {
            return false;
        }
        if (baseSelfFormal != 0 || baseGenericCount != 0)
        {
            return true;
        }

        int32 baseVisitState
            = Host.StandaloneProjectionViewSeen[baseInterfaceDefRow];
        if (baseVisitState == 1)
        {
            return false;
        }
        if (baseVisitState == 0)
        {
            if (stackCount >= interfaceDefCount)
            {
                return false;
            }
            int32 childFrameOffset = stackCount * 2;
            Host.StandaloneProjectionViewSeen[baseInterfaceDefRow] = 1;
            Host.StandaloneProjectionInterfaceStack[childFrameOffset]
                = baseInterfaceDefRow;
            Host.StandaloneProjectionInterfaceStack[
                childFrameOffset + 1] = 0;
            stackCount = stackCount + 1;
        }
    }

    mut int32 reachableInterfaceCount = 0;
    for (mut int32 row = 1; row <= interfaceDefCount; row = row + 1)
    {
        if (Host.StandaloneProjectionViewSeen[row] == 2)
        {
            reachableInterfaceCount = reachableInterfaceCount + 1;
        }
    }
    if (viewCount != uint32(reachableInterfaceCount))
    {
        return false;
    }

    int32 viewCountInt = int32(viewCount);
    for (mut int32 viewOrdinal = 0;
        viewOrdinal < viewCountInt;
        viewOrdinal = viewOrdinal + 1)
    {
        int32 viewOffset = projectionRowStart + 28
            + (viewOrdinal * 8);
        init uint32 viewSourceTypeSpec;
        init uint32 viewRequestedTypeSpec;
        init int32 viewInterfaceDefRow;
        init uint32 viewOwnerTypeDefRow;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, viewOffset,
                ref init viewSourceTypeSpec)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, viewOffset + 4,
                ref init viewRequestedTypeSpec)
            || viewSourceTypeSpec != viewRequestedTypeSpec
            || !TryGetStandaloneProjectionInterfaceDef(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, viewSourceTypeSpec,
                ref init viewInterfaceDefRow,
                ref init viewOwnerTypeDefRow)
            || Host.StandaloneProjectionViewSeen[
                viewInterfaceDefRow] != 2)
        {
            return false;
        }
        Host.StandaloneProjectionViewSeen[viewInterfaceDefRow] = 3;
    }

    for (mut int32 row = 1; row <= interfaceDefCount; row = row + 1)
    {
        int32 visitState
            = Host.StandaloneProjectionViewSeen[row];
        if (visitState == 2 || (visitState != 0 && visitState != 3))
        {
            return false;
        }
    }

    *closureCompleteResult = true;
    return true;
}

bool TryValidateStandaloneWitnessProjectionTable(int32 artifactStart,
    int32 artifactLength)
{
    int32 projectionCount = GetStandaloneArtifactSectionCount(0x0068);
    int32 projectionEntry = FindStandaloneArtifactSection(0x0068);
    if (projectionCount == 0)
    {
        return projectionEntry == 0;
    }
    if (projectionEntry == 0)
    {
        return false;
    }

    int32 projectionStart
        = Host.StandaloneSectionStarts[projectionEntry];
    int32 projectionLength
        = Host.StandaloneSectionLengths[projectionEntry];
    if (!TryValidateStandaloneVariableTableIndex(artifactStart,
            artifactLength, projectionStart, projectionLength,
            projectionCount, 28, 4))
    {
        return false;
    }

    int32 moduleCount = GetStandaloneArtifactSectionCount(0x0001);
    int32 witnessCount = GetStandaloneArtifactSectionCount(0x0028);
    int32 witnessEntry = FindStandaloneArtifactSection(0x0028);
    int32 witnessMemberCount = GetStandaloneArtifactSectionCount(0x0029);
    int32 witnessMemberEntry = FindStandaloneArtifactSection(0x0029);
    int32 methodDefCount = GetStandaloneArtifactSectionCount(0x0016);
    int32 methodDefEntry = FindStandaloneArtifactSection(0x0016);
    int32 typeDefCount = GetStandaloneArtifactSectionCount(0x0013);
    int32 interfaceDefCount = GetStandaloneArtifactSectionCount(0x0025);
    int32 interfaceBaseCount = GetStandaloneArtifactSectionCount(0x0023);
    int32 interfaceMethodCount = GetStandaloneArtifactSectionCount(0x0024);
    int32 typeSpecCount = GetStandaloneArtifactSectionCount(0x0011);
    int32 typeSpecEntry = FindStandaloneArtifactSection(0x0011);
    int32 typeSpecStart = typeSpecEntry == 0 ? 0
        : Host.StandaloneSectionStarts[typeSpecEntry];
    int32 typeSpecLength = typeSpecEntry == 0 ? 0
        : Host.StandaloneSectionLengths[typeSpecEntry];
    if (witnessEntry == 0 || witnessMemberEntry == 0
        || methodDefEntry == 0
        || typeSpecEntry == 0
        || !TryValidateStandaloneVariableTableIndex(artifactStart,
            artifactLength, typeSpecStart, typeSpecLength,
            typeSpecCount, 2, 1)
        || !TryBuildStandaloneProjectionInterfaceMap(artifactStart,
            artifactLength, typeDefCount, interfaceDefCount,
            interfaceBaseCount, interfaceMethodCount)
        || Host.StandaloneProjectionMemberSeen.Length
            <= witnessMemberCount)
    {
        return false;
    }

    for (mut int32 row = 0;
        row <= witnessMemberCount;
        row = row + 1)
    {
        Host.StandaloneProjectionMemberSeen[row] = 0;
    }

    for (mut int32 projectionRow = 1;
        projectionRow <= projectionCount;
        projectionRow = projectionRow + 1)
    {
        init int32 rowStart;
        init int32 rowLength;
        init uint32 ownerModuleRow;
        init uint32 sourceWitnessRow;
        init uint32 requestedSelfTypeSpec;
        init uint32 requestedInterfaceTypeSpec;
        init uint32 ruleVersion;
        init uint32 viewCount;
        init uint32 projectionMemberCount;
        if (!TryGetStandaloneVariableTableRowExtent(artifactStart,
                artifactLength, projectionStart, projectionLength,
                projectionCount, 28, 4, projectionRow,
                ref init rowStart, ref init rowLength)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowStart, ref init ownerModuleRow)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowStart + 4, ref init sourceWitnessRow)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowStart + 8,
                ref init requestedSelfTypeSpec)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowStart + 12,
                ref init requestedInterfaceTypeSpec)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowStart + 16, ref init ruleVersion)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowStart + 20, ref init viewCount)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowStart + 24,
                ref init projectionMemberCount))
        {
            return false;
        }

        int64 expectedRowLength = 28
            + (int64(viewCount) * 8)
            + (int64(projectionMemberCount) * 16);
        if (ownerModuleRow == 0
            || ownerModuleRow > uint32(moduleCount)
            || sourceWitnessRow == 0
            || sourceWitnessRow > uint32(witnessCount)
            || requestedSelfTypeSpec == 0
            || requestedInterfaceTypeSpec == 0
            || ruleVersion != 1 || viewCount == 0
            || expectedRowLength != int64(rowLength))
        {
            return false;
        }

        init bool requiresGeneralPredicates;
        if (!TryRequireStandaloneModuleFeature(artifactStart,
                artifactLength, int32(ownerModuleRow), 17,
                ref init requiresGeneralPredicates)
            || !requiresGeneralPredicates)
        {
            return false;
        }

        init bool requestedSelfIsRow;
        init int32 requestedSelfRow;
        init int32 requestedSelfForm;
        init int32 requestedSelfQualifiers;
        init int32 requestedSelfCode;
        init int32 requestedSelfArgument;
        init bool requestedInterfaceIsRow;
        init int32 requestedInterfaceRow;
        init int32 requestedInterfaceForm;
        init int32 requestedInterfaceQualifiers;
        init int32 requestedInterfaceCode;
        init int32 requestedInterfaceArgument;
        if (!TryGetStandaloneTypeSpecRefInfo(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, requestedSelfTypeSpec,
                allowInitQualifier: false, rowLimit: 0,
                ref init requestedSelfIsRow, ref init requestedSelfRow,
                ref init requestedSelfForm,
                ref init requestedSelfQualifiers,
                ref init requestedSelfCode,
                ref init requestedSelfArgument)
            || !TryGetStandaloneTypeSpecRefInfo(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, requestedInterfaceTypeSpec,
                allowInitQualifier: false, rowLimit: 0,
                ref init requestedInterfaceIsRow,
                ref init requestedInterfaceRow,
                ref init requestedInterfaceForm,
                ref init requestedInterfaceQualifiers,
                ref init requestedInterfaceCode,
                ref init requestedInterfaceArgument))
        {
            return false;
        }

        int32 witnessOffset
            = Host.StandaloneSectionStarts[witnessEntry]
                + ((int32(sourceWitnessRow) - 1) * 32);
        init uint32 implementingTypeSpec;
        init uint32 sourceInterfaceTypeSpec;
        init uint32 witnessMemberFirst;
        init uint32 witnessMemberRows;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, witnessOffset,
                ref init implementingTypeSpec)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, witnessOffset + 4,
                ref init sourceInterfaceTypeSpec)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, witnessOffset + 8,
                ref init witnessMemberFirst)
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, witnessOffset + 12,
                ref init witnessMemberRows)
            || !IsStandaloneMetadataRange(witnessMemberFirst,
                witnessMemberRows, witnessMemberCount))
        {
            return false;
        }

        init bool implementingTypeIsRow;
        init int32 implementingTypeRow;
        init int32 implementingTypeForm;
        init int32 implementingTypeQualifiers;
        init int32 implementingTypeCode;
        init int32 implementingTypeArgument;
        init bool sourceInterfaceIsRow;
        init int32 sourceInterfaceRow;
        init int32 sourceInterfaceForm;
        init int32 sourceInterfaceQualifiers;
        init int32 sourceInterfaceCode;
        init int32 sourceInterfaceArgument;
        if (!TryGetStandaloneTypeSpecRefInfo(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, implementingTypeSpec,
                allowInitQualifier: false, rowLimit: 0,
                ref init implementingTypeIsRow,
                ref init implementingTypeRow,
                ref init implementingTypeForm,
                ref init implementingTypeQualifiers,
                ref init implementingTypeCode,
                ref init implementingTypeArgument)
            || !TryGetStandaloneTypeSpecRefInfo(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, sourceInterfaceTypeSpec,
                allowInitQualifier: false, rowLimit: 0,
                ref init sourceInterfaceIsRow,
                ref init sourceInterfaceRow,
                ref init sourceInterfaceForm,
                ref init sourceInterfaceQualifiers,
                ref init sourceInterfaceCode,
                ref init sourceInterfaceArgument))
        {
            return false;
        }

        init int32 sourceInterfaceDefRow;
        init uint32 sourceInterfaceTypeDefRow;
        init int32 requestedInterfaceDefRow;
        init uint32 requestedInterfaceTypeDefRow;
        if (!TryGetStandaloneProjectionInterfaceDef(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, sourceInterfaceTypeSpec,
                ref init sourceInterfaceDefRow,
                ref init sourceInterfaceTypeDefRow)
            || !TryGetStandaloneProjectionInterfaceDef(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, requestedInterfaceTypeSpec,
                ref init requestedInterfaceDefRow,
                ref init requestedInterfaceTypeDefRow))
        {
            return false;
        }

        int32 interfaceDefStart
            = Host.StandaloneSectionStarts[
                FindStandaloneArtifactSection(0x0025)];
        init bool hasCompleteNonGenericViewSet;
        if (!TryValidateStandaloneNonGenericInterfaceViews(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, interfaceDefCount, interfaceBaseCount,
                rowStart, viewCount, sourceInterfaceTypeSpec,
                requestedInterfaceTypeSpec, sourceInterfaceTypeDefRow,
                requestedInterfaceTypeDefRow, sourceInterfaceDefRow,
                requestedInterfaceDefRow,
                ref init hasCompleteNonGenericViewSet))
        {
            return false;
        }
        if (hasCompleteNonGenericViewSet
            && projectionMemberCount != witnessMemberRows)
        {
            return false;
        }

        mut int32 rootViewCount = 0;
        int32 viewCountInt = int32(viewCount);
        for (mut int32 viewOrdinal = 0;
            viewOrdinal < viewCountInt;
            viewOrdinal = viewOrdinal + 1)
        {
            int32 viewOffset = rowStart + 28 + (viewOrdinal * 8);
            init uint32 viewSourceTypeSpec;
            init uint32 viewRequestedTypeSpec;
            init bool viewSourceIsRow;
            init int32 viewSourceRow;
            init int32 viewSourceForm;
            init int32 viewSourceQualifiers;
            init int32 viewSourceCode;
            init int32 viewSourceArgument;
            init bool viewRequestedIsRow;
            init int32 viewRequestedRow;
            init int32 viewRequestedForm;
            init int32 viewRequestedQualifiers;
            init int32 viewRequestedCode;
            init int32 viewRequestedArgument;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, viewOffset, ref init viewSourceTypeSpec)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, viewOffset + 4,
                    ref init viewRequestedTypeSpec)
                || !TryGetStandaloneTypeSpecRefInfo(artifactStart,
                    artifactLength, typeSpecStart, typeSpecLength,
                    typeSpecCount, viewSourceTypeSpec,
                    allowInitQualifier: false, rowLimit: 0,
                    ref init viewSourceIsRow, ref init viewSourceRow,
                    ref init viewSourceForm, ref init viewSourceQualifiers,
                    ref init viewSourceCode, ref init viewSourceArgument)
                || !TryGetStandaloneTypeSpecRefInfo(artifactStart,
                    artifactLength, typeSpecStart, typeSpecLength,
                    typeSpecCount, viewRequestedTypeSpec,
                    allowInitQualifier: false, rowLimit: 0,
                    ref init viewRequestedIsRow,
                    ref init viewRequestedRow,
                    ref init viewRequestedForm,
                    ref init viewRequestedQualifiers,
                    ref init viewRequestedCode,
                    ref init viewRequestedArgument))
            {
                return false;
            }
            if (viewSourceTypeSpec == sourceInterfaceTypeSpec
                && viewRequestedTypeSpec == requestedInterfaceTypeSpec)
            {
                rootViewCount = rootViewCount + 1;
            }
        }
        if (rootViewCount != 1)
        {
            return false;
        }

        int32 projectionMemberCountInt = int32(projectionMemberCount);
        for (mut int32 memberOrdinal = 0;
            memberOrdinal < projectionMemberCountInt;
            memberOrdinal = memberOrdinal + 1)
        {
            int32 memberOffset = rowStart + 28 + (viewCountInt * 8)
                + (memberOrdinal * 16);
            init uint32 witnessMemberRow;
            init uint32 viewOrdinal;
            init uint32 selectedOwnerTypeSpec;
            init int32 targetPolicy;
            init int32 memberFlags;
            init uint32 memberReserved;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, memberOffset,
                    ref init witnessMemberRow)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, memberOffset + 4,
                    ref init viewOrdinal)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, memberOffset + 8,
                    ref init selectedOwnerTypeSpec)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, memberOffset + 12,
                    ref init targetPolicy)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, memberOffset + 13,
                    ref init memberFlags)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength, memberOffset + 14,
                    ref init memberReserved)
                || witnessMemberRow == 0
                || witnessMemberRow > uint32(witnessMemberCount)
                || witnessMemberRow < witnessMemberFirst
                || witnessMemberRow - witnessMemberFirst >= witnessMemberRows
                || viewOrdinal >= viewCount
                || (targetPolicy != 1 && targetPolicy != 2)
                || memberFlags != 0 || memberReserved != 0)
            {
                return false;
            }

            int32 sourceMemberOffset
                = Host.StandaloneSectionStarts[witnessMemberEntry]
                    + ((int32(witnessMemberRow) - 1) * 20);
            init uint32 memberWitnessRow;
            init uint32 memberDeclaringInterface;
            init uint32 requirementMethodDef;
            init uint32 sourceSelectedOwner;
            init uint32 selectedMethodDef;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, sourceMemberOffset,
                    ref init memberWitnessRow)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, sourceMemberOffset + 4,
                    ref init memberDeclaringInterface)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, sourceMemberOffset + 8,
                    ref init requirementMethodDef)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, sourceMemberOffset + 12,
                    ref init sourceSelectedOwner)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, sourceMemberOffset + 16,
                    ref init selectedMethodDef)
                || memberWitnessRow != sourceWitnessRow
                || requirementMethodDef == 0
                || requirementMethodDef > uint32(methodDefCount)
                || selectedMethodDef == 0
                || selectedMethodDef > uint32(methodDefCount))
            {
                return false;
            }

            int32 viewOffset = rowStart + 28
                + (int32(viewOrdinal) * 8);
            init uint32 viewSourceTypeSpec;
            init uint32 viewRequestedTypeSpec;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, viewOffset,
                    ref init viewSourceTypeSpec)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, viewOffset + 4,
                    ref init viewRequestedTypeSpec)
                || memberDeclaringInterface != viewSourceTypeSpec)
            {
                return false;
            }

            if (hasCompleteNonGenericViewSet)
            {
                init int32 memberInterfaceDefRow;
                init uint32 memberInterfaceTypeDefRow;
                if (!TryGetStandaloneProjectionInterfaceDef(
                        artifactStart, artifactLength, typeSpecStart,
                        typeSpecLength, typeSpecCount,
                        memberDeclaringInterface,
                        ref init memberInterfaceDefRow,
                        ref init memberInterfaceTypeDefRow)
                    || Host.StandaloneProjectionViewSeen[
                        memberInterfaceDefRow] != 3
                    || Host.StandaloneProjectionMemberSeen[
                        int32(witnessMemberRow)] == projectionRow)
                {
                    return false;
                }

                int32 memberInterfaceDefOffset
                    = interfaceDefStart
                        + ((memberInterfaceDefRow - 1) * 48);
                init uint32 memberMethodFirstValue;
                init uint32 memberMethodCountValue;
                if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                        artifactLength, memberInterfaceDefOffset + 16,
                        ref init memberMethodFirstValue)
                    || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                        artifactLength, memberInterfaceDefOffset + 20,
                        ref init memberMethodCountValue))
                {
                    return false;
                }
                int32 memberMethodFirst = int32(memberMethodFirstValue);
                int32 memberMethodCount = int32(memberMethodCountValue);
                bool requirementFound = false;
                int32 interfaceMethodEntry
                    = FindStandaloneArtifactSection(0x0024);
                int32 interfaceMethodStart
                    = Host.StandaloneSectionStarts[interfaceMethodEntry];
                for (mut int32 methodOrdinal = 0;
                    methodOrdinal < memberMethodCount;
                    methodOrdinal = methodOrdinal + 1)
                {
                    int32 interfaceMethodOffset = interfaceMethodStart
                        + ((memberMethodFirst + methodOrdinal - 1) * 12);
                    init uint32 methodOwner;
                    init uint32 methodRowOrdinal;
                    init uint32 methodDefRow;
                    if (!TryReadStandaloneArtifactAbsoluteWord(
                            artifactStart, artifactLength,
                            interfaceMethodOffset, ref init methodOwner)
                        || !TryReadStandaloneArtifactAbsoluteWord(
                            artifactStart, artifactLength,
                            interfaceMethodOffset + 4,
                            ref init methodRowOrdinal)
                        || !TryReadStandaloneArtifactAbsoluteWord(
                            artifactStart, artifactLength,
                            interfaceMethodOffset + 8,
                            ref init methodDefRow)
                        || methodOwner
                            != uint32(memberInterfaceDefRow)
                        || methodRowOrdinal != uint32(methodOrdinal))
                    {
                        return false;
                    }
                    if (methodDefRow == requirementMethodDef)
                    {
                        requirementFound = true;
                    }
                }
                if (!requirementFound)
                {
                    return false;
                }
                Host.StandaloneProjectionMemberSeen[
                    int32(witnessMemberRow)] = projectionRow;
            }

            int32 selectedMethodOffset
                = Host.StandaloneSectionStarts[methodDefEntry]
                    + ((int32(selectedMethodDef) - 1) * 28);
            init uint32 selectedMethodOwnerTypeDef;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, selectedMethodOffset,
                    ref init selectedMethodOwnerTypeDef))
            {
                return false;
            }

            if (selectedOwnerTypeSpec == 0)
            {
                if (targetPolicy != 1 || sourceSelectedOwner != 0
                    || selectedMethodOwnerTypeDef != 0)
                {
                    return false;
                }
            }
            else
            {
                if (selectedMethodOwnerTypeDef == 0)
                {
                    return false;
                }
                init bool selectedOwnerIsRow;
                init int32 selectedOwnerRow;
                init int32 selectedOwnerForm;
                init int32 selectedOwnerQualifiers;
                init int32 selectedOwnerCode;
                init int32 selectedOwnerArgument;
                if (!TryGetStandaloneTypeSpecRefInfo(artifactStart,
                        artifactLength, typeSpecStart, typeSpecLength,
                        typeSpecCount, selectedOwnerTypeSpec,
                        allowInitQualifier: false, rowLimit: 0,
                        ref init selectedOwnerIsRow,
                        ref init selectedOwnerRow,
                        ref init selectedOwnerForm,
                        ref init selectedOwnerQualifiers,
                        ref init selectedOwnerCode,
                        ref init selectedOwnerArgument))
                {
                    return false;
                }
                if (targetPolicy == 1
                    && sourceSelectedOwner != selectedOwnerTypeSpec)
                {
                    return false;
                }
                if (targetPolicy == 2
                    && selectedOwnerTypeSpec != viewRequestedTypeSpec)
                {
                    return false;
                }
            }
        }

        if (hasCompleteNonGenericViewSet)
        {
            for (mut int32 sourceMemberOrdinal = 0;
                sourceMemberOrdinal < int32(witnessMemberRows);
                sourceMemberOrdinal = sourceMemberOrdinal + 1)
            {
                int32 sourceMemberRow
                    = int32(witnessMemberFirst) + sourceMemberOrdinal;
                if (Host.StandaloneProjectionMemberSeen[
                        sourceMemberRow] != projectionRow)
                {
                    return false;
                }
            }
        }
    }

    return true;
}

bool TryGetStandaloneTypeSpecRefInfo(int32 artifactStart,
    int32 artifactLength, int32 typeSpecStart, int32 typeSpecLength,
    int32 typeSpecCount, uint32 typeSpecRef, bool allowInitQualifier,
    int32 rowLimit, ref<init bool> isRowResult,
    ref<init int32> rowResult, ref<init int32> formResult,
    ref<init int32> qualifiersResult, ref<init int32> typeCodeResult,
    ref<init int32> argumentCodeResult)
    ensure return ? (*isRowResult is init && *rowResult is init
        && *formResult is init && *qualifiersResult is init
        && *typeCodeResult is init && *argumentCodeResult is init)
        : true
{
    uint32 tag = typeSpecRef & 0xFF00_0000;
    if (tag == 0)
    {
        if (typeSpecRef == 0 || typeSpecRef > uint32(typeSpecCount)
            || (rowLimit > 0 && typeSpecRef >= uint32(rowLimit)))
        {
            return false;
        }
        init int32 rowStart;
        init int32 rowLength;
        init int32 form;
        init int32 qualifiers;
        init int32 typeCode;
        init int32 argumentCode;
        if (!TryGetStandaloneVariableTableRowExtent(artifactStart,
                artifactLength, typeSpecStart, typeSpecLength,
                typeSpecCount, 2, 1, int32(typeSpecRef),
                ref init rowStart, ref init rowLength)
            || rowLength < 2
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, rowStart, ref init form)
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, rowStart + 1, ref init qualifiers))
        {
            return false;
        }

        if (rowLength < 3)
        {
            typeCode = 0;
        }
        else if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, rowStart + 2, ref init typeCode))
        {
            return false;
        }
        if (rowLength < 4)
        {
            argumentCode = 0;
        }
        else if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, rowStart + 3, ref init argumentCode))
        {
            return false;
        }
        if ((qualifiers & ~7) != 0
            || (!allowInitQualifier && (qualifiers & 4) != 0))
        {
            return false;
        }
        *isRowResult = true;
        *rowResult = int32(typeSpecRef);
        *formResult = form;
        *qualifiersResult = qualifiers;
        *typeCodeResult = typeCode;
        *argumentCodeResult = argumentCode;
        return true;
    }
    if (tag == 0xF200_0000)
    {
        int32 code = int32(typeSpecRef & 0xFF);
        if ((typeSpecRef & 0x00FF_FF00) != 0 || code > 0x1A)
        {
            return false;
        }
        *isRowResult = false;
        *rowResult = 0;
        *formResult = code == 0x1A ? 0x0F : 1;
        *qualifiersResult = 0;
        *typeCodeResult = code;
        *argumentCodeResult = 0;
        return true;
    }
    if (tag == 0xF300_0000)
    {
        int32 qualifiers = int32((typeSpecRef >> 16) & 0xFF);
        int32 familyCode = int32((typeSpecRef >> 8) & 0xFF);
        int32 argumentCode = int32(typeSpecRef & 0xFF);
        if (!IsStandaloneTypeSpecInlineFamily(familyCode)
            || argumentCode > 0x19 || (qualifiers & ~7) != 0
            || (!allowInitQualifier && (qualifiers & 4) != 0)
            || ((qualifiers & 2) != 0
                && familyCode != 0x8B && familyCode != 0x8D))
        {
            return false;
        }
        *isRowResult = false;
        *rowResult = 0;
        *formResult = 1;
        *qualifiersResult = qualifiers;
        *typeCodeResult = familyCode;
        *argumentCodeResult = argumentCode;
        return true;
    }
    return false;
}
