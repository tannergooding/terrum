namespace Terrum.CodeAnalysis;

bool TryMeasureStringRow(StringLiteral literal, int32 flags,
    ref<init int32> contentBytes, ref<init int32> unitWidth, ref<init int32> rowBytes)
{
    return TryMeasureStringRowCore(literal, flags, true, false,
        ref init *contentBytes, ref init *unitWidth, ref init *rowBytes);
}

bool TryMeasureStringTextRow(StringLiteral literal, int32 flags, bool allowEmpty,
    ref<init int32> contentBytes, ref<init int32> unitWidth, ref<init int32> rowBytes)
{
    return TryMeasureStringRowCore(literal, flags, allowEmpty, true,
        ref init *contentBytes, ref init *unitWidth, ref init *rowBytes);
}

bool TryMeasureStringRowCore(StringLiteral literal, int32 flags, bool allowEmpty,
    bool rejectEmbeddedZero, ref<init int32> contentBytes, ref<init int32> unitWidth,
    ref<init int32> rowBytes)
{
    mut int32 bytes = 0;
    mut int32 width = 1;
    if (flags == 2) { width = 2; }
    else if (flags == 3) { width = 4; }
    else if (flags != 0 && flags != 1)
    {
        return false;
    }

    if (!allowEmpty && literal.ScalarCount == 0)
    {
        return false;
    }
    mut StringLiteralCursor cursor = StringLiteralCursor.Create(literal);
    while (true)
    {
        init int32 scalar;
        init StringLiteralCursor next;
        if (!cursor.TryRead(ref init scalar, ref init next))
        {
            break;
        }

        if (rejectEmbeddedZero && scalar == 0)
        {
            return false;
        }
        mut int32 scalarBytes = 1;
        if (flags == 0)
        {
            if (scalar >= 128) { return false; }
        }
        else if (flags == 1)
        {
            if (scalar >= 65536) { scalarBytes = 4; }
            else if (scalar >= 2048) { scalarBytes = 3; }
            else if (scalar >= 128) { scalarBytes = 2; }
        }
        else if (flags == 2)
        {
            scalarBytes = scalar >= 65536 ? 4 : 2;
        }
        else
        {
            scalarBytes = 4;
        }
        if (bytes > int32.MaxValue - scalarBytes)
        {
            return false;
        }
        bytes = bytes + scalarBytes;
        cursor = next;
    }
    if (bytes / width > 16777215)
    {
        return false;
    }
    int32 extent = 4 + bytes + width;
    *contentBytes = bytes;
    *unitWidth = width;
    *rowBytes = extent + ((4 - (extent & 3)) & 3);
    return true;
}

public static bool TryGetStringRowByteLength(StringLiteral literal, int32 flags,
    ref<init int32> byteLength)
{
    init int32 contentBytes;
    init int32 unitWidth;
    init int32 rowBytes;
    if (!TryMeasureStringRow(literal, flags, ref init contentBytes, ref init unitWidth,
        ref init rowBytes))
    {
        return false;
    }
    *byteLength = rowBytes;
    return true;
}

public static bool TryGetStringNameRowByteLength(StringLiteral literal, int32 flags,
    ref<init int32> byteLength)
{
    init int32 contentBytes;
    init int32 unitWidth;
    init int32 rowBytes;
    if (!TryMeasureStringTextRow(literal, flags, false, ref init contentBytes,
            ref init unitWidth, ref init rowBytes))
    {
        return false;
    }
    *byteLength = rowBytes;
    return true;
}

public static bool TryGetStringNamespaceRowByteLength(StringLiteral literal, int32 flags,
    ref<init int32> byteLength)
{
    init int32 contentBytes;
    init int32 unitWidth;
    init int32 rowBytes;
    if (!TryMeasureStringTextRow(literal, flags, true, ref init contentBytes,
            ref init unitWidth, ref init rowBytes))
    {
        return false;
    }
    *byteLength = rowBytes;
    return true;
}

public static bool TryCompareStringNames(StringLiteral left, StringLiteral right,
    ref<init bool> equal)
{
    return TryCompareStringText(left, right, false, ref init *equal);
}

public static bool TryCompareStringNamespaces(StringLiteral left, StringLiteral right,
    ref<init bool> equal)
{
    return TryCompareStringText(left, right, true, ref init *equal);
}

bool TryCompareStringText(StringLiteral left, StringLiteral right, bool allowEmpty,
    ref<init bool> equal)
{
    if (!allowEmpty && (left.ScalarCount == 0 || right.ScalarCount == 0))
    {
        return false;
    }

    mut StringLiteralCursor leftCursor = StringLiteralCursor.Create(left);
    mut StringLiteralCursor rightCursor = StringLiteralCursor.Create(right);
    mut bool same = true;
    while (true)
    {
        init int32 leftScalar;
        init StringLiteralCursor leftNext;
        if (!leftCursor.TryRead(ref init leftScalar, ref init leftNext))
        {
            break;
        }

        if (leftScalar == 0)
        {
            return false;
        }
        init int32 rightScalar;
        init StringLiteralCursor rightNext;
        if (rightCursor.TryRead(ref init rightScalar, ref init rightNext))
        {
            if (rightScalar == 0)
            {
                return false;
            }
            if (leftScalar != rightScalar)
            {
                same = false;
            }
            rightCursor = rightNext;
        }
        else
        {
            same = false;
        }
        leftCursor = leftNext;
    }
    while (true)
    {
        init int32 remaining;
        init StringLiteralCursor following;
        if (!rightCursor.TryRead(ref init remaining, ref init following))
        {
            break;
        }

        if (remaining == 0)
        {
            return false;
        }
        same = false;
        rightCursor = following;
    }
    *equal = same;
    return true;
}

public static OwnedInt32Buffer EncodeStringRow(StringLiteral literal, int32 flags,
    OwnedInt32Buffer workspace)
{
    init int32 contentBytes;
    init int32 unitWidth;
    init int32 rowBytes;
    require TryMeasureStringRow(literal, flags, ref init contentBytes, ref init unitWidth,
        ref init rowBytes);
    return EncodeMeasuredStringRow(literal, flags, contentBytes, unitWidth, rowBytes,
        move workspace);
}

OwnedInt32Buffer EncodeMeasuredStringRow(StringLiteral literal, int32 flags,
    int32 contentBytes, int32 unitWidth, int32 rowBytes, OwnedInt32Buffer workspace)
{
    require workspace.Capacity >= rowBytes;
    mut OwnedInt32Buffer bytes = move workspace;
    if (flags == 0) { bytes = literal.EncodeAscii(move bytes); }
    else if (flags == 1) { bytes = literal.EncodeUtf8(move bytes); }
    else if (flags == 2) { bytes = literal.EncodeUtf16LeBytes(move bytes); }
    else { bytes = literal.EncodeUtf32LeBytes(move bytes); }

    while (bytes.Count < rowBytes)
    {
        require bytes.TryAppend(0);
    }
    {
        mut MutableInt32BufferView row = bytes.SliceMutable(0, rowBytes);
        // Move backward so the header can reuse the original content buffer.
        mut int32 index = contentBytes;
        while (index > 0)
        {
            index = index - 1;
            row.Set(index + 4, row.Read(index));
        }
        int32 units = contentBytes / unitWidth;
        row.Set(0, flags);
        row.Set(1, units & 255);
        row.Set(2, (units >> 8) & 255);
        row.Set(3, units >> 16);
    }
    return move bytes;
}

public static OwnedInt32Buffer EncodeStringNameRow(StringLiteral literal, int32 flags,
    OwnedInt32Buffer workspace)
{
    init int32 contentBytes;
    init int32 unitWidth;
    init int32 rowBytes;
    require TryMeasureStringTextRow(literal, flags, false, ref init contentBytes,
        ref init unitWidth, ref init rowBytes);
    return EncodeMeasuredStringRow(literal, flags, contentBytes, unitWidth, rowBytes,
        move workspace);
}

bool TryBuildStringTextRowUtf8(SourceRange spelling, bool allowEmpty,
    OwnedInt32Buffer workspace, ref<init OwnedInt32Buffer> row)
{
    init StringLiteral literal;
    init int32 contentBytes;
    init int32 unitWidth;
    init int32 rowBytes;
    if (!StringLiteral.TryCreate(spelling, ref init literal)
        || !TryMeasureStringTextRow(literal, 1, allowEmpty, ref init contentBytes,
            ref init unitWidth, ref init rowBytes)
        || workspace.Capacity < rowBytes)
    {
        return false;
    }

    OwnedInt32Buffer completed = EncodeMeasuredStringRow(literal, 1, contentBytes,
        unitWidth, rowBytes, move workspace);
    *row = move completed;
    return true;
}

public static bool TryBuildStringNameRowUtf8(SourceRange spelling,
    OwnedInt32Buffer workspace, ref<init OwnedInt32Buffer> row)
{
    return TryBuildStringTextRowUtf8(spelling, false, move workspace, ref init *row);
}

public static bool TryBuildStringNamespaceRowUtf8(SourceRange spelling,
    OwnedInt32Buffer workspace, ref<init OwnedInt32Buffer> row)
{
    return TryBuildStringTextRowUtf8(spelling, true, move workspace, ref init *row);
}

public static OwnedInt32Buffer EncodeStringNamespaceRow(StringLiteral literal, int32 flags,
    OwnedInt32Buffer workspace)
{
    init int32 contentBytes;
    init int32 unitWidth;
    init int32 rowBytes;
    require TryMeasureStringTextRow(literal, flags, true, ref init contentBytes,
        ref init unitWidth, ref init rowBytes);
    return EncodeMeasuredStringRow(literal, flags, contentBytes, unitWidth, rowBytes,
        move workspace);
}
