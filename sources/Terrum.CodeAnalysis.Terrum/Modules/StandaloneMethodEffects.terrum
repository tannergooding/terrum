namespace Terrum.CodeAnalysis;

int32 ValidateStandaloneMethodContracts(int32 artifactOrdinal,
    int32 moduleRow, int32 callableSlot, int32 artifactStart,
    int32 artifactLength, int32 methodDefRow,
    uint32 paramFirst, uint32 paramCount,
    uint32 contractFirst, uint32 contractCount)
{
    Host.StandaloneContractFactCount[0] = 0;
    int32 tableCount = GetStandaloneArtifactSectionCount(0x001B);
    if (!IsStandaloneMetadataRange(contractFirst, contractCount,
            tableCount))
    {
        return 3;
    }
    if (contractCount == 0)
    {
        Host.StandaloneCallableEffects[callableSlot] = 0;
        Host.StandaloneContractFactCount[0] = 0;
        return 0;
    }

    int32 contractEntry = FindStandaloneArtifactSection(0x001B);
    if (contractEntry == 0)
    {
        return 3;
    }
    int32 contractSectionStart
        = Host.StandaloneSectionStarts[contractEntry];
    int32 contractSectionLength
        = Host.StandaloneSectionLengths[contractEntry];
    if (!TryValidateStandaloneVariableTableIndex(artifactStart,
            artifactLength, contractSectionStart,
            contractSectionLength, tableCount, 8, 1))
    {
        return 3;
    }

    uint32 expectedOwner = 0x1600_0000
        | uint32(methodDefRow);
    mut bool effectsFound = false;
    mut uint32 effectsMask = 0;
    uint32 allowedEffects = 6;
    for (mut int32 offset = 0;
        offset < int32(contractCount);
        offset = offset + 1)
    {
        int32 row = int32(contractFirst) + offset;
        init int32 rowStart;
        init int32 rowLength;
        if (!TryGetStandaloneVariableTableRowExtent(
                artifactStart, artifactLength,
                contractSectionStart, contractSectionLength,
                tableCount, 8, 1, row,
                ref init rowStart, ref init rowLength))
        {
            return 3;
        }

        init uint32 owner;
        init uint32 clauseKind;
        init uint32 flags;
        if (rowLength < 8
            || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, rowStart, ref init owner)
            || !TryReadStandaloneArtifactAbsoluteHalfWord(
                artifactStart, artifactLength, rowStart + 4,
                ref init clauseKind)
            || !TryReadStandaloneArtifactAbsoluteHalfWord(
                artifactStart, artifactLength, rowStart + 6,
                ref init flags)
            || owner != expectedOwner || flags != 0)
        {
            return 3;
        }

        if (clauseKind == 1)
        {
            if (rowLength != 12 || effectsFound)
            {
                return 3;
            }

            init uint32 mask;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 8, ref init mask)
                || (mask & ~allowedEffects) != 0)
            {
                return 3;
            }
            effectsFound = true;
            effectsMask = mask;
            continue;
        }

        if (clauseKind == 2)
        {
            if (rowLength != 20)
            {
                return 3;
            }
            init uint32 parameterOrdinal;
            init uint32 predicateGraphRow;
            init int32 state;
            init int32 reserved0;
            init int32 reserved1;
            init int32 reserved2;
            if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 8,
                    ref init parameterOrdinal)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 12,
                    ref init predicateGraphRow)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 16, ref init state)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 17, ref init reserved0)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 18, ref init reserved1)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 19, ref init reserved2)
                || parameterOrdinal >= paramCount
                || predicateGraphRow == 0
                || predicateGraphRow
                    > uint32(GetStandaloneArtifactSectionCount(0x0037))
                || state < 0 || state > 1
                || reserved0 != 0 || reserved1 != 0 || reserved2 != 0)
            {
                return 3;
            }

            int32 parameterRow = int32(paramFirst)
                + int32(parameterOrdinal);
            int32 globalParameterRow
                = Host.StandaloneArtifactParameterStarts[artifactOrdinal]
                    + parameterRow;
            if (globalParameterRow <= 0
                || globalParameterRow
                    >= Host.StandaloneParameterTypeIds.Length)
            {
                return 3;
            }
            int32 parameterTypeId
                = Host.StandaloneParameterTypeIds[globalParameterRow];
            if (parameterTypeId <= 0
                || parameterTypeId > Host.StandaloneTypeFactCount[0]
                || Host.StandaloneTypeFacts[parameterTypeId * 3] != 1)
            {
                return 3;
            }

            int32 appendStatus = AppendStandaloneContractFact(2,
                int32(parameterOrdinal), int32(predicateGraphRow), state,
                0, 0, 0);
            if (appendStatus != 0)
            {
                return appendStatus;
            }
            continue;
        }

        if (clauseKind == 0x0B)
        {
            if (rowLength != 20)
            {
                return 3;
            }
            init int32 phaseTag;
            init int32 phaseFlags;
            init uint32 phaseReserved;
            init uint32 phaseOrdinal;
            init uint32 predicateGraphRow;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 8, ref init phaseTag)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 9, ref init phaseFlags)
                || !TryReadStandaloneArtifactAbsoluteHalfWord(
                    artifactStart, artifactLength, rowStart + 10,
                    ref init phaseReserved)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 12,
                    ref init phaseOrdinal)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 16,
                    ref init predicateGraphRow)
                || phaseFlags != 0 || phaseReserved != 0)
            {
                return 3;
            }
            if (phaseTag != 3)
            {
                return 2;
            }
            init int32 nodeKind;
            int32 graphStatus
                = TryValidateStandalonePublishedPredicateGraph(
                    artifactStart, artifactLength, moduleRow,
                    callableSlot, predicateGraphRow,
                    ref init nodeKind);
            if (graphStatus != 0)
            {
                return graphStatus;
            }

            int32 appendStatus = AppendStandaloneContractFact(11,
                phaseTag, int32(phaseOrdinal),
                int32(predicateGraphRow), nodeKind, 0, 0);
            if (appendStatus != 0)
            {
                return appendStatus;
            }
            continue;
        }

        if (clauseKind == 4)
        {
            if (rowLength != 20)
            {
                return 3;
            }
            init int32 destinationKind;
            init int32 sourceKind;
            init int32 relationship;
            init int32 phase;
            init uint32 destinationOrdinal;
            init uint32 sourceOrdinal;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 8,
                    ref init destinationKind)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 9,
                    ref init sourceKind)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 10,
                    ref init relationship)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, rowStart + 11, ref init phase)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 12,
                    ref init destinationOrdinal)
                || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                    artifactLength, rowStart + 16,
                    ref init sourceOrdinal)
                || phase < 1 || phase > 3)
            {
                return 3;
            }

            if ((destinationKind == 1 && destinationOrdinal != 0)
                || ((destinationKind == 2 || destinationKind == 3)
                    && destinationOrdinal >= paramCount)
                || (destinationKind == 4 && destinationOrdinal != 0)
                || destinationKind < 1 || destinationKind > 4)
            {
                return 3;
            }
            if ((sourceKind == 0
                    && (relationship != 0 || sourceOrdinal != 0))
                || (sourceKind == 1
                    && (relationship < 1 || relationship > 3
                        || sourceOrdinal >= paramCount))
                || (sourceKind == 2
                    && (relationship < 1 || relationship > 3
                        || sourceOrdinal != 0))
                || sourceKind < 0 || sourceKind > 2)
            {
                return 3;
            }
            if (destinationKind == 4 || sourceKind == 2)
            {
                return 3;
            }

            if (destinationKind != 2 || phase != 1)
            {
                return 2;
            }
            init int32 parameterTypeKind;
            if (!TryGetStandaloneParameterTypeKind(artifactOrdinal,
                    paramFirst, int32(destinationOrdinal),
                    ref init parameterTypeKind))
            {
                return 3;
            }
            if (parameterTypeKind != 1)
            {
                return 2;
            }
            if (sourceKind == 1)
            {
                init int32 sourceParameterTypeKind;
                if (!TryGetStandaloneParameterTypeKind(artifactOrdinal,
                        paramFirst, int32(sourceOrdinal),
                        ref init sourceParameterTypeKind))
                {
                    return 3;
                }
                if (sourceParameterTypeKind != 1)
                {
                    return 2;
                }
            }

            int32 appendStatus = AppendStandaloneContractFact(4,
                destinationKind, sourceKind, relationship, phase,
                int32(destinationOrdinal), int32(sourceOrdinal));
            if (appendStatus != 0)
            {
                return appendStatus;
            }
            continue;
        }
        return 2;
    }

    Host.StandaloneCallableEffects[callableSlot] = int32(effectsMask);
    int32 outputStateStatus = ValidateStandaloneOutputStateFacts();
    if (outputStateStatus != 0)
    {
        return outputStateStatus;
    }
    return ValidateStandaloneDependencyFacts();
}
