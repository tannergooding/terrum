namespace Terrum.CodeAnalysis;

bool TryValidateStandaloneStringTable(int32 artifactOrdinal,
    int32 sectionStart, int32 sectionLength, int32 stringCount)
{
    init int32 artifactStart;
    init int32 artifactLength;
    if (!TryGetStandaloneArtifactExtent(artifactOrdinal,
            ref init artifactStart, ref init artifactLength)
        || stringCount <= 0 || stringCount > 0xFF_FFFF
        || sectionStart < artifactStart
        || sectionLength < 0
        || sectionStart > artifactStart + artifactLength
        || sectionLength
            > artifactStart + artifactLength - sectionStart)
    {
        return false;
    }

    int32 indexLength = (stringCount + 1) * 4;
    if (indexLength > sectionLength
        || int64(stringCount) * 8 > int64(sectionLength - indexLength))
    {
        return false;
    }
    int32 dataLength = sectionLength - indexLength;
    init uint32 firstOffset;
    if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, sectionStart, ref init firstOffset)
        || firstOffset != 0)
    {
        return false;
    }

    mut uint32 previousOffset = firstOffset;
    for (mut int32 row = 1; row <= stringCount; row = row + 1)
    {
        init uint32 nextOffset;
        if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
                artifactLength, sectionStart + row * 4,
                ref init nextOffset)
            || nextOffset > uint32(dataLength)
            || previousOffset > uint32(dataLength - 8)
            || nextOffset < previousOffset + 8
            || (nextOffset & 3) != 0)
        {
            return false;
        }

        int32 rowStart = sectionStart + indexLength
            + int32(previousOffset);
        int32 rowLength = int32(nextOffset - previousOffset);
        if (!TryValidateStandaloneStringRowLayout(artifactStart,
                artifactLength, rowStart, rowLength))
        {
            return false;
        }
        previousOffset = nextOffset;
    }

    return previousOffset == uint32(dataLength);
}

bool TryGetStandaloneStringRowInfo(int32 artifactStart,
    int32 artifactLength, int32 sectionStart,
    int32 sectionLength, int32 stringCount, int32 row,
    ref<init int32> rowStartResult, ref<init int32> rowLengthResult,
    ref<init int32> encodingResult,
    ref<init int32> contentByteLengthResult)
    ensure return ? (*rowStartResult is init && *rowLengthResult is init
        && *encodingResult is init && *contentByteLengthResult is init)
        : true
{
    if (row <= 0 || row > stringCount
        || stringCount <= 0 || stringCount > 0xFF_FFFF
        || sectionStart < artifactStart
        || sectionLength < 0
        || sectionStart > artifactStart + artifactLength
        || sectionLength > artifactStart + artifactLength - sectionStart)
    {
        return false;
    }

    int32 indexLength = (stringCount + 1) * 4;
    if (indexLength > sectionLength)
    {
        return false;
    }
    int32 dataLength = sectionLength - indexLength;
    init uint32 startOffset;
    init uint32 endOffset;
    if (!TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, sectionStart + ((row - 1) * 4),
            ref init startOffset)
        || !TryReadStandaloneArtifactAbsoluteWord(artifactStart,
            artifactLength, sectionStart + (row * 4),
            ref init endOffset)
        || endOffset > uint32(dataLength)
        || startOffset > uint32(dataLength)
        || endOffset < startOffset + 8)
    {
        return false;
    }

    int32 rowStart = sectionStart + indexLength + int32(startOffset);
    int32 rowLength = int32(endOffset - startOffset);
    init int32 encoding;
    init int32 contentByteLength;
    if (!TryGetStandaloneStringRowLayout(artifactStart,
            artifactLength, rowStart, rowLength,
            ref init encoding, ref init contentByteLength))
    {
        return false;
    }

    *rowStartResult = rowStart;
    *rowLengthResult = rowLength;
    *encodingResult = encoding;
    *contentByteLengthResult = contentByteLength;
    return true;
}

bool TryValidateStandaloneStringRowLayout(int32 artifactStart,
    int32 artifactLength, int32 rowStart, int32 rowLength)
{
    init int32 unusedEncoding;
    init int32 unusedContentByteLength;
    return TryGetStandaloneStringRowLayout(artifactStart,
        artifactLength, rowStart, rowLength,
        ref init unusedEncoding, ref init unusedContentByteLength);
}

bool TryGetStandaloneStringRowLayout(int32 artifactStart,
    int32 artifactLength, int32 rowStart, int32 rowLength,
    ref<init int32> encodingResult,
    ref<init int32> contentByteLengthResult)
    ensure return ? (*encodingResult is init
        && *contentByteLengthResult is init) : true
{
    if (rowLength < 8 || rowStart < artifactStart
        || rowStart > artifactStart + artifactLength
        || rowLength > artifactStart + artifactLength - rowStart)
    {
        return false;
    }

    init int32 encoding;
    init int32 unitsLow;
    init int32 unitsMiddle;
    init int32 unitsHigh;
    if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
            artifactLength, rowStart, ref init encoding)
        || encoding < 0 || encoding > 3
        || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
            artifactLength, rowStart + 1, ref init unitsLow)
        || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
            artifactLength, rowStart + 2, ref init unitsMiddle)
        || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
            artifactLength, rowStart + 3, ref init unitsHigh))
    {
        return false;
    }

    mut int32 unitWidth = 1;
    if (encoding == 2) { unitWidth = 2; }
    else if (encoding == 3) { unitWidth = 4; }
    int32 units = unitsLow | (unitsMiddle << 8) | (unitsHigh << 16);
    int32 contentByteLength = units * unitWidth;
    int32 terminatorEnd = 4 + contentByteLength + unitWidth;
    int32 paddedLength
        = terminatorEnd + ((4 - (terminatorEnd & 3)) & 3);
    if (paddedLength != rowLength)
    {
        return false;
    }

    for (mut int32 offset = 4 + contentByteLength;
        offset < rowLength;
        offset = offset + 1)
    {
        init int32 trailing;
        if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, rowStart + offset, ref init trailing)
            || trailing != 0)
        {
            return false;
        }
    }

    *encodingResult = encoding;
    *contentByteLengthResult = contentByteLength;
    return true;
}

bool TryValidateStandaloneStringName(int32 artifactOrdinal,
    int32 artifactStart, int32 artifactLength, int32 sectionStart,
    int32 sectionLength, int32 stringCount, int32 row)
{
    init int32 rowStart;
    init int32 rowLength;
    init int32 encoding;
    init int32 contentByteLength;
    if (!TryGetStandaloneStringRowInfo(artifactStart, artifactLength,
            sectionStart, sectionLength,
            stringCount, row, ref init rowStart, ref init rowLength,
            ref init encoding, ref init contentByteLength))
    {
        return false;
    }

    mut int32 position = 0;
    mut int32 scalarCount = 0;
    while (position < contentByteLength)
    {
        init int32 scalar;
        init int32 bytesRead;
        if (!TryReadStandaloneStringScalar(
                artifactStart, artifactLength, rowStart + 4 + position,
                contentByteLength - position, encoding,
                ref init scalar, ref init bytesRead)
            || scalar == 0)
        {
            return false;
        }

        scalarCount = scalarCount + 1;
        position = position + bytesRead;
    }

    return scalarCount != 0;
}

bool TryCompareStandaloneStringRowToText(int32 artifactOrdinal,
    int32 sectionStart, int32 sectionLength, int32 stringCount,
    int32 row, int32 textStart, int32 textLength,
    ref<init int32> comparison)
    ensure return ? *comparison is init : true
{
    init int32 artifactStart;
    init int32 artifactLength;
    init int32 rowStart;
    init int32 rowLength;
    init int32 encoding;
    init int32 contentByteLength;
    if (!TryGetStandaloneArtifactExtent(artifactOrdinal,
            ref init artifactStart, ref init artifactLength)
        || !TryGetStandaloneStringRowInfo(artifactStart, artifactLength,
            sectionStart, sectionLength,
            stringCount, row, ref init rowStart, ref init rowLength,
            ref init encoding, ref init contentByteLength)
        || !IsWellFormedStandaloneIdentity(textStart, textLength))
    {
        return false;
    }

    mut int32 bytePosition = 0;
    mut int32 textPosition = textStart;
    int32 textEnd = textStart + textLength;
    while (bytePosition < contentByteLength && textPosition < textEnd)
    {
        init int32 metadataScalar;
        init int32 bytesRead;
        init int32 textScalar;
        if (!TryReadStandaloneStringScalar(
                artifactStart, artifactLength,
                rowStart + 4 + bytePosition,
                contentByteLength - bytePosition, encoding,
                ref init metadataScalar, ref init bytesRead)
            || metadataScalar == 0
            || !TryReadStandaloneTextScalar(textPosition, textEnd,
                ref init textScalar))
        {
            return false;
        }

        if (metadataScalar < textScalar)
        {
            *comparison = -1;
            return true;
        }
        if (metadataScalar > textScalar)
        {
            *comparison = 1;
            return true;
        }

        bytePosition = bytePosition + bytesRead;
        textPosition = textPosition + Utf16ScalarWidth(textScalar);
    }

    if (bytePosition == contentByteLength && textPosition == textEnd)
    {
        *comparison = 0;
    }
    else if (bytePosition == contentByteLength)
    {
        *comparison = -1;
    }
    else
    {
        *comparison = 1;
    }

    return true;
}

bool TryCompareStandaloneStringRows(int32 firstArtifactOrdinal,
    int32 firstSectionStart, int32 firstSectionLength, int32 firstStringCount,
    int32 firstRow, int32 secondArtifactOrdinal,
    int32 secondSectionStart, int32 secondSectionLength,
    int32 secondStringCount, int32 secondRow,
    ref<init int32> comparison)
    ensure return ? *comparison is init : true
{
    init int32 firstArtifactStart;
    init int32 firstArtifactLength;
    init int32 secondArtifactStart;
    init int32 secondArtifactLength;
    init int32 firstRowStart;
    init int32 firstRowLength;
    init int32 firstEncoding;
    init int32 firstContentByteLength;
    init int32 secondRowStart;
    init int32 secondRowLength;
    init int32 secondEncoding;
    init int32 secondContentByteLength;
    if (!TryGetStandaloneArtifactExtent(firstArtifactOrdinal,
            ref init firstArtifactStart, ref init firstArtifactLength)
        || !TryGetStandaloneArtifactExtent(secondArtifactOrdinal,
            ref init secondArtifactStart, ref init secondArtifactLength)
        || !TryGetStandaloneStringRowInfo(firstArtifactStart,
            firstArtifactLength, firstSectionStart,
            firstSectionLength, firstStringCount, firstRow,
            ref init firstRowStart, ref init firstRowLength,
            ref init firstEncoding, ref init firstContentByteLength)
        || !TryGetStandaloneStringRowInfo(secondArtifactStart,
            secondArtifactLength,
            secondSectionStart, secondSectionLength, secondStringCount,
            secondRow, ref init secondRowStart, ref init secondRowLength,
            ref init secondEncoding, ref init secondContentByteLength))
    {
        return false;
    }

    mut int32 firstPosition = 0;
    mut int32 secondPosition = 0;
    while (firstPosition < firstContentByteLength
        && secondPosition < secondContentByteLength)
    {
        init int32 firstScalar;
        init int32 firstBytesRead;
        init int32 secondScalar;
        init int32 secondBytesRead;
        if (!TryReadStandaloneStringScalar(firstArtifactStart,
                firstArtifactLength, firstRowStart + 4 + firstPosition,
                firstContentByteLength - firstPosition, firstEncoding,
                ref init firstScalar, ref init firstBytesRead)
            || firstScalar == 0
            || !TryReadStandaloneStringScalar(secondArtifactStart,
                secondArtifactLength, secondRowStart + 4 + secondPosition,
                secondContentByteLength - secondPosition, secondEncoding,
                ref init secondScalar, ref init secondBytesRead)
            || secondScalar == 0)
        {
            return false;
        }

        if (firstScalar < secondScalar)
        {
            *comparison = -1;
            return true;
        }
        if (firstScalar > secondScalar)
        {
            *comparison = 1;
            return true;
        }
        firstPosition = firstPosition + firstBytesRead;
        secondPosition = secondPosition + secondBytesRead;
    }

    if (firstPosition == firstContentByteLength
        && secondPosition == secondContentByteLength)
    {
        *comparison = 0;
    }
    else if (firstPosition == firstContentByteLength)
    {
        *comparison = -1;
    }
    else
    {
        *comparison = 1;
    }

    return true;
}

bool TryReadStandaloneStringScalar(int32 artifactStart,
    int32 artifactLength, int32 absoluteByteOffset,
    int32 remainingByteLength, int32 encoding,
    ref<init int32> scalar, ref<init int32> bytesRead)
    ensure return ? (*scalar is init && *bytesRead is init) : true
{
    if (absoluteByteOffset < artifactStart
        || remainingByteLength <= 0
        || absoluteByteOffset > artifactStart + artifactLength
        || remainingByteLength
            > artifactStart + artifactLength - absoluteByteOffset)
    {
        return false;
    }

    init int32 first;
    if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
            artifactLength, absoluteByteOffset, ref init first))
    {
        return false;
    }

    mut uint32 value = 0;
    mut int32 width = 0;
    if (encoding == 0)
    {
        if (first == 0 || first > 0x7F) { return false; }
        value = uint32(first);
        width = 1;
    }
    else if (encoding == 1)
    {
        if (first >= 1 && first <= 0x7F)
        {
            value = uint32(first);
            width = 1;
        }
        else if (first >= 0xC2 && first <= 0xDF)
        {
            if (remainingByteLength < 2) { return false; }
            init int32 second;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, absoluteByteOffset + 1,
                    ref init second)
                || !IsStandaloneUtf8Continuation(second))
            {
                return false;
            }
            value = uint32(((first & 0x1F) << 6)
                | (second & 0x3F));
            width = 2;
        }
        else if (first >= 0xE0 && first <= 0xEF)
        {
            if (remainingByteLength < 3) { return false; }
            init int32 second;
            init int32 third;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, absoluteByteOffset + 1,
                    ref init second)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, absoluteByteOffset + 2,
                    ref init third)
                || !IsStandaloneUtf8Continuation(second)
                || !IsStandaloneUtf8Continuation(third)
                || (first == 0xE0 && second < 0xA0)
                || (first == 0xED && second >= 0xA0))
            {
                return false;
            }
            value = uint32(((first & 0x0F) << 12)
                | ((second & 0x3F) << 6) | (third & 0x3F));
            width = 3;
        }
        else if (first >= 0xF0 && first <= 0xF4)
        {
            if (remainingByteLength < 4) { return false; }
            init int32 second;
            init int32 third;
            init int32 fourth;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, absoluteByteOffset + 1,
                    ref init second)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, absoluteByteOffset + 2,
                    ref init third)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, absoluteByteOffset + 3,
                    ref init fourth)
                || !IsStandaloneUtf8Continuation(second)
                || !IsStandaloneUtf8Continuation(third)
                || !IsStandaloneUtf8Continuation(fourth)
                || (first == 0xF0 && second < 0x90)
                || (first == 0xF4 && second > 0x8F))
            {
                return false;
            }
            value = uint32(((first & 0x07) << 18)
                | ((second & 0x3F) << 12)
                | ((third & 0x3F) << 6) | (fourth & 0x3F));
            width = 4;
        }
        else
        {
            return false;
        }
    }
    else if (encoding == 2)
    {
        if (remainingByteLength < 2) { return false; }
        init int32 second;
        if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, absoluteByteOffset + 1,
                ref init second))
        {
            return false;
        }
        int32 firstUnit = first | (second << 8);
        if (firstUnit >= 0xD800 && firstUnit <= 0xDBFF)
        {
            if (remainingByteLength < 4) { return false; }
            init int32 third;
            init int32 fourth;
            if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, absoluteByteOffset + 2,
                    ref init third)
                || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                    artifactLength, absoluteByteOffset + 3,
                    ref init fourth))
            {
                return false;
            }
            int32 secondUnit = third | (fourth << 8);
            if (secondUnit < 0xDC00 || secondUnit > 0xDFFF)
            {
                return false;
            }
            value = uint32(0x10000
                + ((firstUnit - 0xD800) << 10)
                + (secondUnit - 0xDC00));
            width = 4;
        }
        else if (firstUnit >= 0xDC00 && firstUnit <= 0xDFFF)
        {
            return false;
        }
        else
        {
            value = uint32(firstUnit);
            width = 2;
        }
    }
    else if (encoding == 3)
    {
        if (remainingByteLength < 4) { return false; }
        init int32 second;
        init int32 third;
        init int32 fourth;
        if (!TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, absoluteByteOffset + 1,
                ref init second)
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, absoluteByteOffset + 2,
                ref init third)
            || !TryReadStandaloneArtifactAbsoluteByte(artifactStart,
                artifactLength, absoluteByteOffset + 3,
                ref init fourth))
        {
            return false;
        }
        value = uint32(first) | (uint32(second) << 8)
            | (uint32(third) << 16) | (uint32(fourth) << 24);
        width = 4;
    }
    else
    {
        return false;
    }

    if (value == 0 || value > 0x10_FFFF
        || (value >= 0xD800 && value <= 0xDFFF))
    {
        return false;
    }

    *scalar = int32(value);
    *bytesRead = width;
    return true;
}

bool IsStandaloneUtf8Continuation(int32 value)
{
    return value >= 0x80 && value <= 0xBF;
}
