<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Terrum.CodeAnalysis\Terrum.CodeAnalysis.csproj" />
  </ItemGroup>

  <Target Name="BuildNativeCompilerPrimitives" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT'"
          Inputs="$(MSBuildProjectFullPath);$(TargetPath);$(TargetDir)Terrum.CodeAnalysis.dll;$(MSBuildProjectDirectory)\..\..\self-host\CharacterFacts.terrum;$(MSBuildProjectDirectory)\..\..\self-host\SourceRange.terrum;$(MSBuildProjectDirectory)\..\..\self-host\Token.terrum;$(MSBuildProjectDirectory)\..\..\self-host\Utf16CodeUnits.terrum;$(MSBuildProjectDirectory)\..\..\self-host\WideIntegerFacts.terrum"
          Outputs="$(BaseArtifactsPath)bin/self-host/$(Configuration)/terrum-compiler-primitives.dll">
    <MakeDir Directories="$(BaseArtifactsPath)bin/self-host/$(Configuration)" />
    <Exec Command="dotnet &quot;$(TargetPath)&quot; build-library &quot;$(MSBuildProjectDirectory)\..\..\self-host\CharacterFacts.terrum&quot; --source &quot;$(MSBuildProjectDirectory)\..\..\self-host\SourceRange.terrum&quot; --source &quot;$(MSBuildProjectDirectory)\..\..\self-host\Token.terrum&quot; --source &quot;$(MSBuildProjectDirectory)\..\..\self-host\Utf16CodeUnits.terrum&quot; --source &quot;$(MSBuildProjectDirectory)\..\..\self-host\WideIntegerFacts.terrum&quot; --export Terrum.CodeAnalysis.SourceRange.TryCreate --export Terrum.CodeAnalysis.IsAsciiDigit --export Terrum.CodeAnalysis.IsLineBreak --export Terrum.CodeAnalysis.GetDecimalDigit --export Terrum.CodeAnalysis.TryGetHexDigit --export Terrum.CodeAnalysis.DecodeUtf16Scalar --export Terrum.CodeAnalysis.Utf16ScalarWidth --export Terrum.CodeAnalysis.Numerics64.MagnitudeInt64 -o &quot;$(BaseArtifactsPath)bin/self-host/$(Configuration)/terrum-compiler-primitives.dll&quot; --runtime fail-fast" />
  </Target>

</Project>
