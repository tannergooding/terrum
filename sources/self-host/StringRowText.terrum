namespace Terrum.CodeAnalysis;

public static bool TryGetStringNameScalarCount(int32 rowStart, int32 rowLength,
    init ref<int32> scalarCount)
{
    return TryScanStringRowText(rowStart, rowLength, false, -1,
        init scalarCount, init var unusedScalar);
}

public static bool TryGetStringNamespaceScalarCount(int32 rowStart, int32 rowLength,
    init ref<int32> scalarCount)
{
    return TryScanStringRowText(rowStart, rowLength, true, -1,
        init scalarCount, init var unusedScalar);
}

public static bool TryReadStringNameScalarAt(int32 rowStart, int32 rowLength, int32 scalarIndex,
    init ref<int32> scalar)
{
    if (scalarIndex < 0)
    {
        return false;
    }

    return TryScanStringRowText(rowStart, rowLength, false, scalarIndex,
        init var unusedCount, init scalar);
}

public static bool TryReadStringNamespaceScalarAt(int32 rowStart, int32 rowLength, int32 scalarIndex,
    init ref<int32> scalar)
{
    if (scalarIndex < 0)
    {
        return false;
    }

    return TryScanStringRowText(rowStart, rowLength, true, scalarIndex,
        init var unusedCount, init scalar);
}

bool TryScanStringRowText(int32 rowStart, int32 rowLength, bool allowEmpty, int32 selectedIndex,
    init ref<int32> scalarCount, init ref<int32> selectedScalar)
{
    return TryAnalyzeStringRowText(rowStart, rowLength, allowEmpty, selectedIndex,
        init var unusedEncoding, init var unusedContentLength,
        init scalarCount, init selectedScalar);
}

bool TryAnalyzeStringRowText(int32 rowStart, int32 rowLength, bool allowEmpty, int32 selectedIndex,
    init ref<int32> encodingResult, init ref<int32> contentByteLengthResult,
    init ref<int32> scalarCount, init ref<int32> selectedScalar)
{
    if (selectedIndex < -1
        || !TryGetStringRowLayout(rowStart, rowLength,
            init var encoding, init var contentByteLength))
    {
        return false;
    }

    mut int32 position = 0;
    mut int32 count = 0;
    mut int32 selected = 0;
    mut bool foundSelected = false;
    while (position < contentByteLength)
    {
        if (!TryDecodeStringRowScalar(rowStart, position, contentByteLength, encoding,
            init var value, init var bytesRead))
        {
            return false;
        }

        if (value == 0)
        {
            return false;
        }

        if (count == selectedIndex)
        {
            selected = value;
            foundSelected = true;
        }

        count = count + 1;
        position = position + bytesRead;
    }

    if ((!allowEmpty && count == 0) || (selectedIndex >= 0 && !foundSelected))
    {
        return false;
    }

    encodingResult = encoding;
    contentByteLengthResult = contentByteLength;
    scalarCount = count;
    selectedScalar = selected;
    return true;
}

bool TryDecodeStringRowScalar(int32 rowStart, int32 position, int32 contentByteLength,
    int32 encoding, init ref<int32> scalar, init ref<int32> bytesRead)
{
    if (rowStart < 0 || position < 0 || position >= contentByteLength
        || rowStart > Host.Rows.Length - 4
        || contentByteLength > Host.Rows.Length - rowStart - 4)
    {
        return false;
    }

    return TryDecodeStringRowScalarAtOffset(rowStart + 4 + position,
        contentByteLength - position, encoding, init scalar, init bytesRead);
}

bool TryDecodeStringRowScalarAtOffset(int32 byteOffset, int32 remainingByteLength, int32 encoding,
    init ref<int32> scalar, init ref<int32> bytesRead)
{
    if (byteOffset < 0 || remainingByteLength <= 0 || byteOffset > Host.Rows.Length
        || remainingByteLength > Host.Rows.Length - byteOffset)
    {
        return false;
    }

    int32 first = Host.Rows[byteOffset];
    mut uint32 value = 0;
    mut int32 width = 0;

    if (encoding == 0)
    {
        if (first == 0 || first > 0x7F)
        {
            return false;
        }
        value = uint32(first);
        width = 1;
    }
    else if (encoding == 1)
    {
        if (first >= 1 && first <= 0x7F)
        {
            value = uint32(first);
            width = 1;
        }
        else if (first >= 0xC2 && first <= 0xDF)
        {
            if (remainingByteLength < 2)
            {
                return false;
            }
            int32 second = Host.Rows[byteOffset + 1];
            if (!IsUtf8Continuation(second))
            {
                return false;
            }
            value = uint32(((first & 0x1F) << 6) | (second & 0x3F));
            width = 2;
        }
        else if (first >= 0xE0 && first <= 0xEF)
        {
            if (remainingByteLength < 3)
            {
                return false;
            }
            int32 second = Host.Rows[byteOffset + 1];
            int32 third = Host.Rows[byteOffset + 2];
            if (!IsUtf8Continuation(second) || !IsUtf8Continuation(third)
                || (first == 0xE0 && second < 0xA0)
                || (first == 0xED && second >= 0xA0))
            {
                return false;
            }
            value = uint32(((first & 0x0F) << 12)
                | ((second & 0x3F) << 6) | (third & 0x3F));
            width = 3;
        }
        else if (first >= 0xF0 && first <= 0xF4)
        {
            if (remainingByteLength < 4)
            {
                return false;
            }
            int32 second = Host.Rows[byteOffset + 1];
            int32 third = Host.Rows[byteOffset + 2];
            int32 fourth = Host.Rows[byteOffset + 3];
            if (!IsUtf8Continuation(second) || !IsUtf8Continuation(third)
                || !IsUtf8Continuation(fourth)
                || (first == 0xF0 && second < 0x90)
                || (first == 0xF4 && second > 0x8F))
            {
                return false;
            }
            value = uint32(((first & 0x07) << 18)
                | ((second & 0x3F) << 12) | ((third & 0x3F) << 6) | (fourth & 0x3F));
            width = 4;
        }
        else
        {
            return false;
        }
    }
    else if (encoding == 2)
    {
        if (remainingByteLength < 2)
        {
            return false;
        }
        int32 firstUnit = first | (Host.Rows[byteOffset + 1] << 8);
        if (firstUnit >= 0xD800 && firstUnit <= 0xDBFF)
        {
            if (remainingByteLength < 4)
            {
                return false;
            }
            int32 secondUnit = Host.Rows[byteOffset + 2] | (Host.Rows[byteOffset + 3] << 8);
            if (secondUnit < 0xDC00 || secondUnit > 0xDFFF)
            {
                return false;
            }
            value = uint32(0x10000 + ((firstUnit - 0xD800) << 10) + (secondUnit - 0xDC00));
            width = 4;
        }
        else if (firstUnit >= 0xDC00 && firstUnit <= 0xDFFF)
        {
            return false;
        }
        else
        {
            value = uint32(firstUnit);
            width = 2;
        }
    }
    else
    {
        if (remainingByteLength < 4)
        {
            return false;
        }
        value = uint32(first)
            | (uint32(Host.Rows[byteOffset + 1]) << 8)
            | (uint32(Host.Rows[byteOffset + 2]) << 16)
            | (uint32(Host.Rows[byteOffset + 3]) << 24);
        width = 4;
    }

    if (value == 0 || value > 0x10FFFF
        || (value >= 0xD800 && value <= 0xDFFF))
    {
        return false;
    }

    scalar = int32(value);
    bytesRead = width;
    return true;
}

bool IsUtf8Continuation(int32 value)
{
    return value >= 0x80 && value <= 0xBF;
}
