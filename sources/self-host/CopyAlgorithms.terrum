namespace Terrum;

[NoThrow] T SelectCopy<T>(bool takeFirst, T first, T second) where T : [Copy]
{
    if (takeFirst)
    {
        return first;
    }

    return second;
}

[NoThrow] bool TrySelectCopyInit<T>(int32 index, T first, T second, init ref<T> result)
    where T : [Copy]
{
    if (index == 0)
    {
        result = first;
        return true;
    }
    if (index == 1)
    {
        result = second;
        return true;
    }

    return false;
}

[NoThrow] bool TrySelectCopy<T>(int32 index, T first, T second, out T result) where T : [Copy]
{
    if (!TrySelectCopyInit(index, first, second, init var selected))
    {
        return false;
    }

    result = selected;
    return true;
}
