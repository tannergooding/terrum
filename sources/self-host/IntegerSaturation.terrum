namespace Terrum.CodeAnalysis.Numerics64;

public static int64 SaturateInt32ToInt64(int32 value)
{
    return int64(value);
}

public static uint64 SaturateInt32ToUInt64(int32 value)
{
    if (value < 0)
    {
        return 0;
    }
    return uint64(value);
}

public static int64 SaturateUInt32ToInt64(uint32 value)
{
    return int64(value);
}

public static uint64 SaturateUInt32ToUInt64(uint32 value)
{
    return uint64(value);
}

public static int32 SaturateUInt32ToInt32(uint32 value)
{
    if (value > uint32(int32.MaxValue))
    {
        return int32.MaxValue;
    }
    return int32(value);
}

public static uint32 SaturateInt32ToUInt32(int32 value)
{
    if (value < 0)
    {
        return 0;
    }
    return uint32(value);
}

public static int32 SaturateInt64ToInt32(int64 value)
{
    if (value < int64(int32.MinValue))
    {
        return int32.MinValue;
    }
    if (value > int64(int32.MaxValue))
    {
        return int32.MaxValue;
    }
    return int32(value);
}

public static uint32 SaturateInt64ToUInt32(int64 value)
{
    if (value < 0)
    {
        return 0;
    }
    if (value > int64(uint32.MaxValue))
    {
        return uint32.MaxValue;
    }
    return uint32(value);
}

public static int32 SaturateUInt64ToInt32(uint64 value)
{
    if (value > uint64(int32.MaxValue))
    {
        return int32.MaxValue;
    }
    return int32(value);
}

public static uint32 SaturateUInt64ToUInt32(uint64 value)
{
    if (value > uint64(uint32.MaxValue))
    {
        return uint32.MaxValue;
    }
    return uint32(value);
}

public static int64 SaturateUInt64ToInt64(uint64 value)
{
    if (value > uint64(int64.MaxValue))
    {
        return int64.MaxValue;
    }
    return int64(value);
}

public static uint64 SaturateInt64ToUInt64(int64 value)
{
    if (value < 0)
    {
        return 0;
    }
    return uint64(value);
}

public static char16 SaturateInt32ToChar16(int32 value)
{
    if (value < 0)
    {
        return char16(0);
    }
    if (value > 65535)
    {
        return char16(65535);
    }
    return char16(value);
}

public static char16 SaturateUInt32ToChar16(uint32 value)
{
    if (value > 65535)
    {
        return char16(65535);
    }
    return char16(value);
}

public static char16 SaturateInt64ToChar16(int64 value)
{
    if (value < 0)
    {
        return char16(0);
    }
    if (value > 65535)
    {
        return char16(65535);
    }
    return char16(value);
}

public static char16 SaturateUInt64ToChar16(uint64 value)
{
    if (value > 65535)
    {
        return char16(65535);
    }
    return char16(value);
}

public static int32 SaturateChar16ToInt32(char16 value)
{
    return int32(value);
}

public static uint32 SaturateChar16ToUInt32(char16 value)
{
    return uint32(value);
}

public static int64 SaturateChar16ToInt64(char16 value)
{
    return int64(value);
}

public static uint64 SaturateChar16ToUInt64(char16 value)
{
    return uint64(value);
}
