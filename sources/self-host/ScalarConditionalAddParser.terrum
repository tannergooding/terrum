namespace Terrum.CodeAnalysis;

bool TryParseScalarConditionalAddReturn(TokenSnapshot tokens,
    init ref<int32> scalarType, init ref<SourceRange> name)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 32)
    {
        return false;
    }
    require tokens.TryGet(0, init var returnType);
    require tokens.TryGet(1, init var function);
    require tokens.TryGet(2, init var openParameters);
    require tokens.TryGet(3, init var conditionType);
    require tokens.TryGet(4, init var conditionParameter);
    require tokens.TryGet(5, init var firstComma);
    require tokens.TryGet(6, init var firstType);
    require tokens.TryGet(7, init var firstParameter);
    require tokens.TryGet(8, init var secondComma);
    require tokens.TryGet(9, init var secondType);
    require tokens.TryGet(10, init var secondParameter);
    require tokens.TryGet(11, init var closeParameters);
    require tokens.TryGet(12, init var openBody);
    require tokens.TryGet(13, init var branch);
    require tokens.TryGet(14, init var openCondition);
    require tokens.TryGet(15, init var conditionUse);
    require tokens.TryGet(16, init var closeCondition);
    require tokens.TryGet(17, init var openTrue);
    require tokens.TryGet(18, init var trueReturn);
    require tokens.TryGet(19, init var firstUse);
    require tokens.TryGet(20, init var add);
    require tokens.TryGet(21, init var secondUse);
    require tokens.TryGet(22, init var trueSemicolon);
    require tokens.TryGet(23, init var closeTrue);
    require tokens.TryGet(24, init var otherwise);
    require tokens.TryGet(25, init var openFalse);
    require tokens.TryGet(26, init var falseReturn);
    require tokens.TryGet(27, init var fallbackUse);
    require tokens.TryGet(28, init var falseSemicolon);
    require tokens.TryGet(29, init var closeFalse);
    require tokens.TryGet(30, init var closeBody);
    require tokens.TryGet(31, init var eof);
    if (!TryGetScalarType(returnType, init var selected)
        || !TryGetScalarType(conditionType, init var condition) || condition != 5
        || !TryGetScalarType(firstType, init var matchingFirst)
        || !TryGetScalarType(secondType, init var matchingSecond)
        || selected != matchingFirst || selected != matchingSecond || selected == 5
        || selected == 6)
    {
        return false;
    }
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    if (function.Kind != 2 || openParameters.Kind != 46
        || firstComma.Kind != 53 || secondComma.Kind != 53
        || closeParameters.Kind != 47 || openBody.Kind != 48
        || branch.Kind != 16 || openCondition.Kind != 46
        || closeCondition.Kind != 47 || openTrue.Kind != 48
        || trueReturn.Kind != 19 || add.Kind != 57 || trueSemicolon.Kind != 52
        || closeTrue.Kind != 49 || otherwise.Kind != 17
        || openFalse.Kind != 48 || falseReturn.Kind != 19
        || falseSemicolon.Kind != 52 || closeFalse.Kind != 49
        || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }
    if (!SameTokenSpelling(conditionParameter, conditionUse)
        || !SameTokenSpelling(firstParameter, firstUse)
        || !SameTokenSpelling(secondParameter, secondUse)
        || !SameTokenSpelling(firstParameter, fallbackUse)
        || SameTokenSpelling(conditionParameter, firstParameter)
        || SameTokenSpelling(conditionParameter, secondParameter)
        || SameTokenSpelling(firstParameter, secondParameter))
    {
        return false;
    }
    scalarType = selected;
    name = function.Range;
    return true;
}

bool TryEvaluateInt32ScalarConditionalAddReturn(TokenSnapshot tokens, bool condition,
    int32 first, int32 second, init ref<SourceRange> name, init ref<int32> result)
{
    if (!TryParseScalarConditionalAddReturn(move tokens, init var selected, init var foundName)
        || selected != 1)
    {
        return false;
    }
    if (condition)
    {
        if (!TryAddScalarInt32(first, second, init var sum))
        {
            return false;
        }
        result = sum;
    }
    else
    {
        result = first;
    }
    name = foundName;
    return true;
}

