struct WidePair {
    public int64 First;
    public int64 Second;
     public WidePair(int64 first, int64 second) {
        First = first;
        Second = second;
    }
}

bool TrySelectPair<TFirst, TSecond>(
    int32 index, TFirst first0, TSecond second0, TFirst first1, TSecond second1,
    ref<init TFirst> first, ref<init TSecond> second)
{
    if (index == 0) {
        *first = first0;
        *second = second0;
        return true;
    }
    if (index == 1) {
        *first = first1;
        *second = second1;
        return true;
    }
    return false;
}

bool TrySelectReversed<TFirst, TSecond>(
    int32 index, TFirst first0, TSecond second0, TFirst first1, TSecond second1,
    ref<init TSecond> second, ref<init TFirst> first)
{
    return TrySelectPair<TSecond, TFirst>(
        index, second0, first0, second1, first1,
        ref init *second, ref init *first);
}

public int32 GenericPairProbe() {
    var first = new WidePair(1, 0);
    var second = new WidePair(2, 0);
    init int32 missingNumber;
    init WidePair missingPair;
    require !TrySelectPair(2, int32(10), first, int32(40), second,
        ref init missingNumber, ref init missingPair);
    init WidePair selectedPair;
    init int32 selectedNumber;
    require TrySelectReversed(1, int32(10), first, int32(40), second,
        ref init selectedPair, ref init selectedNumber);
    return selectedNumber + int32(selectedPair.First + selectedPair.Second);
}

int32 Main() {
    return GenericPairProbe();
}
