// Compile with --runtime checked-exceptions; compact owners here have no OS resource.
unique struct Ticket {
    public int32 Id;

    public Ticket(int32 id) {
        Id = id;
    }

    [NoThrow] [Cleanup] public void Close() {
    }
}

Ticket Forward(Ticket ticket) {
    return move ticket;
}

bool Acquire(bool available, out Ticket ticket) {
    ticket = new Ticket(42);
    return available;
}

int32 Main() {
    Ticket first = new Ticket(1);
    Ticket transferred = Forward(move first);
    if (transferred.Id != 1) {
        return 0;
    }
    bool rejected = Acquire(false, out var absent);
    if (rejected) {
        return 0;
    }
    require Acquire(true, out var ticket);
    return ticket.Id;
}
