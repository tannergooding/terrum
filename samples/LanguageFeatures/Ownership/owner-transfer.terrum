// Compile with --runtime checked-exceptions; compact owners here have no OS resource.
unique struct Ticket {
    public int32 Id;

    public Ticket(int32 id) {
        Id = id;
    }

     [Cleanup] public void Close() {
    }
}

Ticket Forward(Ticket ticket) {
    return move ticket;
}

bool Acquire(bool available, ref<init Ticket> ticket) {
    if (!available) {
        return false;
    }
    *ticket = new Ticket(42);
    return true;
}

int32 Main() {
    Ticket first = new Ticket(1);
    Ticket transferred = Forward(move first);
    if (transferred.Id != 1) {
        return 0;
    }
    init Ticket absent;
    bool rejected = Acquire(false, ref init absent);
    if (rejected) {
        return 0;
    }
    init Ticket ticket;
    require Acquire(true, ref init ticket);
    return ticket.Id;
}
