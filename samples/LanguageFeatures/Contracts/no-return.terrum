[DoesNotReturn]
void Reject()
{
    require false;
}

bool TrySelect(bool success, ref<init int32> value)
{
    if (!success)
    {
        return false;
    }
    *value = 42;
    return true;
}

int32 Select(bool success)
{
    init int32 value;
    if (!TrySelect(success, ref init value))
    {
        Reject();
    }
    return value;
}

int32 Main()
{
    return Select(true);
}
