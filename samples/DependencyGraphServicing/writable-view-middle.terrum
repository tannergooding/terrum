public int32 Middle() {
    int32 leaf = Leaf();
    require OwnedInt32Buffer.TryCreate(2, out var created);
    mut OwnedInt32Buffer buffer = move created;
    require buffer.TryAppend(leaf);
    require buffer.TryAppend(1);
    mut int32 value = 0;
    {
        mut MutableInt32BufferView view = buffer.SliceMutable(0, buffer.Count);
        view.Set(1, view.Read(1));
        value = view.Read(0) + view.Read(1);
    }
    buffer.Clear();
    require buffer.TryAppend(value);
    return buffer.Read(0);
}
