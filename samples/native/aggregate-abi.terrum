public struct Pair
{
    public int32 Start;
    public int32 Length;

    public Pair(int32 start, int32 length)
    {
        Start = start;
        Length = length;
    }
}

public Pair MakePair(int32 start, int32 length)
{
    return new Pair(start, length);
}

public int32 ReadPair(Pair pair)
{
    return pair.Start + pair.Length;
}

public bool TryPair(int32 start, int32 length, out Pair pair)
{
    if (start < 0)
    {
        return false;
    }

    pair = new Pair(start, length);
    return true;
}

public bool TryInt32(out int32 value)
{
    value = -2147483648;
    return true;
}

public bool TryChar16(out char16 value)
{
    value = char16(55296);
    return true;
}

public bool TryBool(out bool value)
{
    value = true;
    return true;
}

public int32 ReadChar16(char16 value)
{
    return int32(value);
}

public int32 ReadBool(bool value)
{
    if (value == true)
    {
        return 1;
    }
    return 0;
}

int32 Main()
{
    return ReadPair(MakePair(17, 25));
}

public struct Nested
{
    public mut Pair Value;
    public Nested(int32 first, int32 second)
    {
        Value = new Pair(first, second);
    }
}

public Nested MakeNested(int32 first, int32 second)
{
    return new Nested(first, second);
}

public int32 ReadNested(Nested first, Nested second, Nested third, Nested fourth, Nested fifth)
{
    return first.Value.Start + second.Value.Length + third.Value.Start + fourth.Value.Length + fifth.Value.Length;
}

public bool TryNested(bool success, out Nested value)
{
    if (!success)
    {
        return false;
    }
    value = new Nested(1, 2);
    value.Value = new Pair(17, 25);
    return true;
}

public struct AlignedInner
{
    public char16 Unit;
    public bool Valid;
    public AlignedInner(char16 unit)
    {
        Unit = unit;
        Valid = true;
    }
}

public struct AlignedOuter
{
    public char16 Prefix;
    public AlignedInner Value;
    public char16 Suffix;
    public AlignedOuter()
    {
        Prefix = char16(1);
        Value = new AlignedInner(char16(39));
        Suffix = char16(2);
    }
}

public AlignedOuter MakeAligned()
{
    return new AlignedOuter();
}

public int32 ReadAligned(AlignedOuter value)
{
    if (!value.Value.Valid)
    {
        return -1;
    }
    return int32(value.Prefix) + int32(value.Value.Unit) + int32(value.Suffix);
}

[Layout(Sequential)] struct SequentialInner
{
    char16 Unit;
    bool Valid;
    public SequentialInner(char16 unit)
    {
        Unit = unit;
        Valid = true;
    }
    public int32 Read()
    {
        if (!Valid) { return -1; }
        return int32(Unit);
    }
}

[Layout(Sequential)] struct SequentialOuter
{
    bool Present;
    int32 Number;
    SequentialInner Inner;
    char16 Suffix;
    public SequentialOuter(int32 number)
    {
        Present = true;
        Number = number;
        Inner = new SequentialInner(char16(2));
        Suffix = char16(3);
    }
    public int32 Read()
    {
        if (!Present) { return -1; }
        return Number + Inner.Read() + int32(Suffix);
    }
}

SequentialOuter MakeSequential(int32 number)
{
    return new SequentialOuter(number);
}

int32 ReadSequential(SequentialOuter value)
{
    return value.Read();
}

bool TrySequential(bool success, out SequentialOuter value)
{
    if (!success) { return false; }
    value = MakeSequential(37);
    return true;
}

public struct Three
{
    public bool First;
    public bool Second;
    public bool Third;
    public Three(bool first, bool second, bool third)
    {
        First = first;
        Second = second;
        Third = third;
    }
}

public Three MakeThree()
{
    return new Three(true, false, true);
}

public int32 ReadThree(Three value)
{
    if (value.First && !value.Second && value.Third)
    {
        return 42;
    }
    return -1;
}

public bool TryThree(bool success, out Three value)
{
    if (!success)
    {
        return false;
    }
    value = MakeThree();
    return true;
}

public struct Six
{
    public char16 First;
    public char16 Second;
    public char16 Third;
    public Six(char16 first, char16 second, char16 third)
    {
        First = first;
        Second = second;
        Third = third;
    }
}

public Six MakeSix()
{
    return new Six(char16(4), char16(5), char16(6));
}

public int32 ReadSix(Six value)
{
    return int32(value.First) + int32(value.Second) + int32(value.Third);
}

public bool TrySix(bool success, out Six value)
{
    if (!success)
    {
        return false;
    }
    value = MakeSix();
    return true;
}

public struct Twelve
{
    public int32 First;
    public int32 Second;
    public int32 Third;
    public Twelve(int32 first, int32 second, int32 third)
    {
        First = first;
        Second = second;
        Third = third;
    }
}

public Twelve MakeTwelve(int32 first, int32 second, int32 third)
{
    return new Twelve(first, second, third);
}

public bool TryTwelve(bool success, out Twelve value)
{
    if (!success)
    {
        return false;
    }
    value = MakeTwelve(1, 2, 7);
    return true;
}

public int32 ReadMixed(Twelve first, Three second, Pair third, Six fourth, Twelve fifth, int32 sixth)
{
    if (!second.First || second.Second || !second.Third)
    {
        return -1;
    }
    return first.First + first.Second + third.Length + int32(fourth.Third) + fifth.Third + sixth;
}

public struct Wide
{
    public mut Twelve Value;
    public mut int32 Tail;
    public Wide(int32 tail)
    {
        Value = new Twelve(10, 11, 12);
        Tail = tail;
    }
}

public Wide MakeWide(int32 tail)
{
    return new Wide(tail);
}

public Wide MakeShiftedWide(int32 first, int32 second, int32 third, int32 fourth, int32 fifth)
{
    return new Wide(first + second + third + fourth + fifth);
}

public int32 ReadWide(Wide value)
{
    return value.Value.First + value.Value.Second + value.Value.Third + value.Tail;
}

public Wide EchoWide(Wide first, Wide second, Wide third, Wide fourth, Wide fifth)
{
    return fifth;
}

public Wide RecurseWide(int32 depth)
{
    if (depth == 0)
    {
        return new Wide(9);
    }
    return RecurseWide(depth - 1);
}

public bool TryWide(bool success, out Wide value)
{
    if (!success)
    {
        return false;
    }
    value = new Wide(1);
    value.Value = new Twelve(10, 11, 12);
    value.Tail = 9;
    return true;
}

public bool ForwardWide(bool success, out Wide value)
{
    return TryWide(success, out value);
}

public int64 SumInt64(int64 first, int64 second, int64 third, int64 fourth, int64 fifth, int64 sixth)
{
    return first + second + third + fourth + fifth + sixth;
}

public uint64 EchoUInt64(uint64 value)
{
    return value;
}

public struct WideIntegerPair
{
    public int64 Signed;
    public uint64 Unsigned;
    public WideIntegerPair(int64 signed, uint64 unsigned)
    {
        Signed = signed;
        Unsigned = unsigned;
    }
}

public WideIntegerPair MakeWideIntegerPair(int64 signed, uint64 unsigned)
{
    return new WideIntegerPair(signed, unsigned);
}

public int32 ReadWideIntegerPair(WideIntegerPair value, int64 second, int64 third, int64 fourth, int64 fifth)
{
    if (value.Signed == int64.MinValue && value.Unsigned == uint64.MaxValue
        && second == -2147483649 && third == 2147483648
        && fourth == 1 && fifth == 42)
    {
        return 42;
    }
    return -1;
}

public bool TryWideIntegerPair(bool success, out WideIntegerPair value)
{
    if (!success)
    {
        return false;
    }
    value = MakeWideIntegerPair(int64.MinValue, uint64.MaxValue);
    return true;
}

public unique struct SmallOwner
{
    public int32 Value;
    public SmallOwner(int32 value) { Value = value; }
    [NoThrow] public int32 Read() { return Value; }
    public WideIntegerPair Pack(int64 a, int64 b, int64 c, uint64 d, uint64 e)
    {
        return new WideIntegerPair(int64(Value) + a + b + c, d + e);
    }
}

public unique struct WordOwner
{
    public uint64 Value;
    public WordOwner(uint64 value) { Value = value; }
    [NoThrow] public uint64 Read() { return Value; }
}

public unique struct LargeOwner
{
    public int64 Signed;
    public uint64 Unsigned;
    public LargeOwner(int64 signed, uint64 unsigned)
    {
        Signed = signed;
        Unsigned = unsigned;
    }
    [NoThrow] public uint64 Read() { return Unsigned; }
}
// Transparent wrappers retain the carrier's direct argument and result ABI.
[Layout(Transparent)] public struct BoolCarrier
{
    public bool Value;
    public BoolCarrier(bool value) { Value = value; }
}
public BoolCarrier EchoBoolCarrier(BoolCarrier value) { return value; }

[Layout(Transparent)] public struct CharCarrier
{
    public char16 Value;
    public CharCarrier(char16 value) { Value = value; }
}
public CharCarrier EchoCharCarrier(CharCarrier value) { return value; }

[Layout(Transparent)] public struct IntCarrier
{
    public int32 Value;
    public IntCarrier(int32 value) { Value = value; }
}
public IntCarrier EchoIntCarrier(IntCarrier value) { return value; }

[Layout(Transparent)] public struct UIntCarrier
{
    public uint32 Value;
    public UIntCarrier(uint32 value) { Value = value; }
}
public UIntCarrier EchoUIntCarrier(UIntCarrier value) { return value; }

[Layout(Transparent)] public struct LongCarrier
{
    public int64 Value;
    public LongCarrier(int64 value) { Value = value; }
}
public LongCarrier EchoLongCarrier(LongCarrier value) { return value; }

[Layout(Transparent)] public struct ULongCarrier
{
    public uint64 Value;
    public ULongCarrier(uint64 value) { Value = value; }
}
public ULongCarrier EchoULongCarrier(ULongCarrier value) { return value; }
