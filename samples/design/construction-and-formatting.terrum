// Terrum source sketch. Target/handler registration and require are working syntax.
using Terrum;
using Terrum.Collections;

public struct Point : IFormattable
{
    public int32 X;
    public int32 Y;

    public Point(int32 x, int32 y)
    {
        X = x;
        Y = y;
    }

    public bool TryFormat<TWriter>(mut ref TWriter writer, TextSpan format)
        where TWriter : ITextWriter
    {
        require format.IsEmpty;

        return TextFormatting.TryWrite(mut ref writer, $"({X}, {Y})");
    }
}

[TextTarget(nameof(content))]
public static void Forward<TContent>(TextWriter destination, TContent content)
    where TContent : IFormattable
{
    destination.WriteLine(move content);
}

public static int32 Main()
{
    require int32.TryParse("3", out var x);

    var point = new Point(x, 4);
    Forward(Terminal.Output, $"point = {ref point}");

    using own Text saved = $"saved = {ref point}";
    Terminal.WriteLine(saved.AsSpan());

    List<int32> values = [x, 4];
    Terminal.WriteLine(values[1]);

    return 0;
}
