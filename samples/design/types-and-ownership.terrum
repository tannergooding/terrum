// Terrum source sketch.
using Terrum;

public struct Position
{
    public int32 X;
    public int32 Y;

    public Position(int32 x, int32 y)
    {
        X = x;
        Y = y;
    }
}

public class Counter
{
    public mut int32 Value;

    public Counter(int32 value)
    {
        Value = value;
    }
}

public unique class Job
{
    public int32 Id;

    public Job(int32 id)
    {
        Id = id;
    }
}

public static void Finish(Job job)
{
    Terminal.WriteLine(job.Id);
}

public static bool TryRead<T>(TextSpan text, out T value)
    where T : IParsable<T>
{
    return T.TryParse(text, out value);
}

public static int32 Main()
{
    var position = new Position(3, 4);
    var copiedPosition = position;

    Terminal.WriteLine(copiedPosition.X);

    var counter = new Counter(10);
    var alias = counter;
    alias.Value = 20;

    Terminal.WriteLine(counter.Value); // 20: a handle copy, not a payload copy.

    var job = new Job(42);
    Finish(move job);
    // Finish(job); // error: consumed owning handle

    int32? absent = null;
    // Explicit int32?? and T?? are syntax errors. Generic T? still normalizes
    // to int32? when T is instantiated with int32?.

    if (absent is null)
    {
        Terminal.WriteLine("absent");
    }

    int32? present = 5;

    if (present is some number)
    {
        Terminal.WriteLine(number);
    }

    if (!TryRead<decimal32>("0.1", out var price))
    {
        Terminal.WriteLine("Invalid decimal input.", output: TerminalOutput.Error);

        return 2;
    }

    using own Text priceText = $"{price}";
    Terminal.WriteLine(priceText.AsSpan());

    return 0;
}
