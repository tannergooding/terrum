[Terrum.Interop.NativeImport("windows-x64.system32.kernel32.GetModuleHandleW")]
[NoThrow]
extern Terrum.Interop.Windows.HINSTANCE GetModuleHandleW(
    Terrum.Interop.Windows.NativeNullPointer moduleName);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.RegisterClassExW")]
[NoThrow]
extern char16 RegisterClassExW(Terrum.Interop.Windows.ReadonlyWNDCLASSEXW windowClass);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.CreateWindowExW")]
[NoThrow]
extern Terrum.Interop.Windows.HWND CreateWindowExW(
    uint32 exStyle,
    ptr<char16> className,
    ptr<char16> windowName,
    uint32 style,
    int32 x,
    int32 y,
    int32 width,
    int32 height,
    Terrum.Interop.Windows.HWND parent,
    Terrum.Interop.Windows.HMENU menu,
    Terrum.Interop.Windows.HINSTANCE instance,
    Terrum.Interop.Windows.LPVOID parameter);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.DestroyWindow")]
[NoThrow]
extern int32 DestroyWindow(Terrum.Interop.Windows.HWND window);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.UnregisterClassW")]
[NoThrow]
extern int32 UnregisterClassW(ptr<char16> className, Terrum.Interop.Windows.HINSTANCE instance);

[Terrum.Interop.NativeImport("windows-x64.system32.d3d11.D3D11CreateDeviceAndSwapChain")]
[NoThrow]
extern int32 D3D11CreateDeviceAndSwapChain(
    Terrum.Interop.Windows.NativeNullPointer adapter,
    int32 driverType,
    Terrum.Interop.Windows.NativeNullPointer software,
    uint32 flags,
    Terrum.Interop.NativeStorageAddress featureLevels,
    uint32 featureLevelCount,
    uint32 sdkVersion,
    Terrum.Interop.NativeStorageAddress swapChainDescription,
    out Terrum.Interop.Dx11.ProvisionalSwapChainOwner swapChain,
    out Terrum.Interop.Dx11.ProvisionalDeviceOwner device,
    Terrum.Interop.NativeStorageAddress selectedFeatureLevel,
    out Terrum.Interop.Dx11.ProvisionalContextOwner immediateContext);

[Layout(Sequential)]
struct ModeDescription {
    uint32 Width;
    uint32 Height;
    uint32 RefreshNumerator;
    uint32 RefreshDenominator;
    uint32 Format;
    uint32 ScanlineOrdering;
    uint32 Scaling;

    public ModeDescription(uint32 width, uint32 height, uint32 refreshNumerator,
        uint32 refreshDenominator, uint32 format, uint32 scanlineOrdering, uint32 scaling) {
        Width = width;
        Height = height;
        RefreshNumerator = refreshNumerator;
        RefreshDenominator = refreshDenominator;
        Format = format;
        ScanlineOrdering = scanlineOrdering;
        Scaling = scaling;
    }
}

[Layout(Sequential)]
struct SampleDescription {
    uint32 Count;
    uint32 Quality;

    public SampleDescription(uint32 count, uint32 quality) {
        Count = count;
        Quality = quality;
    }
}

[Layout(Sequential)]
struct SwapChainDescription {
    ModeDescription BufferDescription;
    SampleDescription SampleDescription;
    uint32 BufferUsage;
    uint32 BufferCount;
    Terrum.Interop.Windows.HWND OutputWindow;
    int32 Windowed;
    uint32 SwapEffect;
    uint32 Flags;

    public SwapChainDescription(ModeDescription bufferDescription,
        SampleDescription sampleDescription, uint32 bufferUsage, uint32 bufferCount,
        Terrum.Interop.Windows.HWND outputWindow, int32 windowed, uint32 swapEffect,
        uint32 flags) {
        BufferDescription = bufferDescription;
        SampleDescription = sampleDescription;
        BufferUsage = bufferUsage;
        BufferCount = bufferCount;
        OutputWindow = outputWindow;
        Windowed = windowed;
        SwapEffect = swapEffect;
        Flags = flags;
    }
}

struct Host {
    int32 Value;

    [NoThrow]
    public static nint WindowProcedure(Terrum.Interop.Windows.HWND window, uint32 message,
        nuint wParam, nint lParam) {
        return message == 129 ? 1 : 0;
    }
}

int32 Main() {
    Terrum.Interop.Windows.WNDCLASSEXW windowClass = windowclassex(
        &Host.WindowProcedure, GetModuleHandleW(null), utf16z("TerrumDirectClass"));
    char16 registered = RegisterClassExW(&windowClass);
    mut int32 result = 1;
    if (registered == 0) {
        result = 2;
    } else {
        Terrum.Interop.Windows.HWND window = CreateWindowExW(
            0, utf16z("TerrumDirectClass"), utf16z(""), 0,
            0, 0, 1, 1,
            Terrum.Interop.Windows.HWND.NoOwner, null, GetModuleHandleW(null), null);
        if (window == Terrum.Interop.Windows.HWND.NoOwner) {
            result = 5;
        } else {
            {
                InlineArray<uint32, 1> featureLevels = [45056];
                mut InlineArray<uint32, 1> selectedFeatureLevel = [0];
                SwapChainDescription description = new SwapChainDescription(
                    new ModeDescription(1, 1, 0, 0, 28, 0, 0),
                    new SampleDescription(1, 0), 32, 1, window, 1, 0, 0);
                int32 status = D3D11CreateDeviceAndSwapChain(
                    null, 5, null, 0, &featureLevels[0], 1, 7, &description,
                    out var swapChain, out var device, &selectedFeatureLevel[0], out var context);
                if (status >= 0) {
                    result = 0;
                }
            }
            int32 destroyed = DestroyWindow(window);
            if (destroyed == 0) {
                result = 3;
            }
        }
        int32 unregistered = UnregisterClassW(
            utf16z("TerrumDirectClass"), GetModuleHandleW(null));
        if (unregistered == 0) {
            result = 4;
        }
    }
    return result;
}
