namespace Triangle.Interop;

[Terrum.Interop.NativeImport("windows-x64.system32.kernel32.ExitProcess")]
[NoThrow] [DoesNotReturn]
extern void ExitProcess(uint32 exitCode);

[Terrum.Interop.NativeImport("windows-x64.system32.kernel32.GetCurrentThreadId")]
[NoThrow]
extern uint32 GetCurrentThreadId();

[Terrum.Interop.NativeImport("windows-x64.system32.kernel32.GetModuleHandleW")]
[NoThrow]
extern Terrum.Interop.Windows.HINSTANCE GetModuleHandleW(
    Terrum.Interop.Windows.NativeNullPointer moduleName);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.RegisterClassExW")]
[NoThrow]
extern char16 RegisterClassExW(Terrum.Interop.Windows.ReadonlyWNDCLASSEXW windowClass);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.UnregisterClassW")]
[NoThrow]
extern int32 UnregisterClassW(
    ptr<char16> className, Terrum.Interop.Windows.HINSTANCE instance);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.CreateWindowExW")]
[NoThrow]
extern Terrum.Interop.Windows.HWND CreateWindowExW(
    uint32 exStyle,
    ptr<char16> className,
    ptr<char16> windowName,
    uint32 style,
    int32 x,
    int32 y,
    int32 width,
    int32 height,
    Terrum.Interop.Windows.HWND parent,
    Terrum.Interop.Windows.HMENU menu,
    Terrum.Interop.Windows.HINSTANCE instance,
    Terrum.Interop.Windows.LPVOID parameter);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.DestroyWindow")]
[NoThrow]
extern int32 DestroyWindow(Terrum.Interop.Windows.HWND window);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.ShowWindow")]
[NoThrow]
extern int32 ShowWindow(Terrum.Interop.Windows.HWND window, int32 command);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.GetMessageW")]
[NoThrow]
extern int32 GetMessageW(
    Terrum.Interop.Windows.MSGAddress message,
    Terrum.Interop.Windows.HWND window,
    uint32 minimum,
    uint32 maximum);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.TranslateMessage")]
[NoThrow]
extern int32 TranslateMessage(Terrum.Interop.Windows.MSGAddress message);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.DispatchMessageW")]
[NoThrow]
extern nint DispatchMessageW(Terrum.Interop.Windows.MSGAddress message);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.DefWindowProcW")]
[NoThrow]
extern nint DefWindowProcW(
    Terrum.Interop.Windows.HWND window,
    uint32 message,
    nuint wParam,
    nint lParam);

[Terrum.Interop.NativeImport("windows-x64.system32.user32.PostQuitMessage")]
[NoThrow]
extern void PostQuitMessage(int32 exitCode);

struct Host {
    int32 Value;

    [NoThrow]
    public static nint WindowProcedure(Terrum.Interop.Windows.HWND window, uint32 message,
        nuint wParam, nint lParam) {
        if (message == 16) {
            PostQuitMessage(0);
            return 0;
        }
        return DefWindowProcW(window, message, wParam, lParam);
    }
}

public unique struct WindowOwner {
    private Terrum.Interop.Windows.HWND Handle;
    private char16 Atom;
    private uint32 ThreadId;

    public WindowOwner() {
        Handle = Terrum.Interop.Windows.HWND.NoOwner;
        Atom = 0;
        ThreadId = GetCurrentThreadId();
        require ThreadId != 0;
        Terrum.Interop.Windows.WNDCLASSEXW descriptor = windowclassex(
            &Host.WindowProcedure, GetModuleHandleW(null), utf16z("TerrumOwnerClass"));
        Atom = RegisterClassExW(&descriptor);
        try {
            require Atom != 0;
            Handle = CreateWindowExW(
                0, utf16z("TerrumOwnerClass"), utf16z("Terrum DX11 Triangle"), 13238272,
                100, 100, 800, 600,
                Terrum.Interop.Windows.HWND.NoOwner, null, GetModuleHandleW(null), null);
            require Handle != Terrum.Interop.Windows.HWND.NoOwner;
        } finally {
            if (Handle == Terrum.Interop.Windows.HWND.NoOwner && Atom != 0) {
                ExitIfFalse(UnregisterClassW(
                    utf16z("TerrumOwnerClass"), GetModuleHandleW(null)) != 0);
            }
        }
    }

    [NoThrow]
    private static void ExitIfFalse(bool succeeded) {
        if (!succeeded) {
            ExitProcess(87);
        }
    }

    [NoThrow] [Cleanup]
    public void Close() {
        ExitIfFalse(ThreadId == GetCurrentThreadId());
        ExitIfFalse(DestroyWindow(Handle) != 0);
        ExitIfFalse(UnregisterClassW(
            utf16z("TerrumOwnerClass"), GetModuleHandleW(null)) != 0);
    }

    [NoThrow]
    public int32 Run() {
        ExitIfFalse(ThreadId == GetCurrentThreadId());
        if (trycreatewarpswapchain(Handle, out var device, out var swapchain, out var context)) {
            ShowWindow(Handle, 5);
            mut Terrum.Interop.Windows.MSG message = msgzero();
            mut int32 result = GetMessageW(
                &message, Terrum.Interop.Windows.HWND.NoOwner, 0, 0);
            while (result > 0) {
                TranslateMessage(&message);
                DispatchMessageW(&message);
                result = GetMessageW(
                    &message, Terrum.Interop.Windows.HWND.NoOwner, 0, 0);
            }
            return result < 0 ? 1 : 0;
        }
        return 1;
    }
}

int32 Main() {
    WindowOwner window = new WindowOwner();
    return window.Run();
}
