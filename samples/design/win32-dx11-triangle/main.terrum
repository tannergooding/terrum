[Layout(Sequential)]
struct ClientRectangle {
    int32 Left;
    int32 Top;
    int32 Right;
    int32 Bottom;

    [NoThrow]
    public ClientRectangle(int32 left, int32 top, int32 right, int32 bottom) {
        Left = left;
        Top = top;
        Right = right;
        Bottom = bottom;
    }

    [NoThrow]
    public bool TryGetDimensions(out int32 width, out int32 height) {
        width = 0;
        height = 0;
        if (Left != 0 || Top != 0 || Right < Left || Bottom < Top) {
            return false;
        }
        width = Right;
        height = Bottom;
        return true;
    }
}
