// API signatures; implementations omitted. See README.md for contracts.
using Terrum;
using Terrum.Interop.DirectX;
using Terrum.Interop.Windows;

namespace Triangle.Interop;

public unique struct ComOwner<TInterface>
    where TInterface : [NativeComInterface]
{
    public ptr<TInterface> Pointer { get; }

    public ComOwner<TInterface> Clone(); // AddRef; never an implicit handle copy.
}

// Address exposes write access to the pointer cell only, not to the COM object
// referenced by that cell. The external interface receiver/access contract
// must be supplied by checked COM metadata; this sketch leaves it unresolved.
public mut unique struct ComSlot<TInterface>
    where TInterface : [NativeComInterface]
{
    public ComSlot(); // Initializes the native pointer cell to null.

    public bool HasValue { get; }

    public ptr<TInterface> Pointer { get; }

    public mut write ptr<ptr<TInterface>> Address();

    public mut ComOwner<TInterface> Take();
}

public unique struct WindowClassOwner
{
    public static unsafe WindowClassOwner Adopt(HINSTANCE instance, ATOM atom);
}

public unique struct WindowOwner
{
    public static unsafe WindowOwner Adopt(HWND handle);

    public HWND Handle { get; }
}

public unique struct ContextBindingsGuard
{
    public unsafe ContextBindingsGuard(ptr<ID3D11DeviceContext> context);
}

public unique struct NativeUtf16Z
{
    public static NativeUtf16Z FromApplicationAsset(TextSpan filename);

    public ptr<char16> Pointer { get; }
}

public static class NativeError
{
    public static void ThrowIfFailed(HRESULT status, TextSpan operation);

    public static void RequireTrue(BOOL value, TextSpan operation);

    public static void RequireAtom(ATOM value, TextSpan operation);

    public static void RequireHandle(HMODULE value, TextSpan operation);

    public static void RequireHandle(HWND value, TextSpan operation);

    public static void RequireHandle(HDC value, TextSpan operation);
}

public static class NativeDiagnostics
{
    public static void WriteHResult(HRESULT status, TextSpan operation);

    public static unsafe void WriteCompilerOutput(ptr<ID3DBlob> blob);
}

public static class Runtime
{
    [DoesNotReturn]
    [NoThrow]
    public static void FailFastCurrentException();
}
