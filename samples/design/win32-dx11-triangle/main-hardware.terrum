namespace Triangle.Interop;

[Terrum.Interop.NativeImport("D3DCompiler_47.dll", "D3DCompileFromFile")]
[Terrum.Interop.NativeParameter(1, Read, NoEscape, 0)]
[Terrum.Interop.NativeParameter(2, Read, NoEscape, 0)]
[Terrum.Interop.NativeParameter(3, Read, NoEscape, 0)]
[Terrum.Interop.NativeParameter(4, Read, NoEscape, 0)]
[Terrum.Interop.NativeParameter(5, Read, NoEscape, 0)]
[Terrum.Interop.NativeParameter(9, Read, NoEscape, 0)]
[Terrum.Interop.NativeOutput(7, NonNegative)]
extern int32 D3DCompileFromFileRaw(
    ptr<char16> sourceFile,
    ptr<void> defines,
    ptr<void> include,
    ptr<void> entryPoint,
    ptr<void> target,
    uint32 flags1,
    uint32 flags2,
    write ptr<ptr<void>> code,
    ptr<void> diagnostics);

bool TryCompileShader(bool vertexShader, out ShaderBlobOwner code) {
    mut InlineArray<char16, 260> shaderPath = [];
    mut uint32 pathLength = 0;
    mut uint32 scan = 0;
    mut uint32 prefixLength = 0;
    mut bool pathValid = false;
    mut ptr<void> rawCode = null;
    mut int32 result = -1;
    unsafe {
        pathLength = GetModuleFileNameW(null, &shaderPath[0], 260);
        if (pathLength > 0 && pathLength < 260) {
            pathValid = true;
            scan = pathLength;
            while (scan > 0 && prefixLength == 0 && pathValid) {
                scan = scan - 1;
                if (shaderPath[scan] == 92 || shaderPath[scan] == 47) {
                    if (scan + 1 >= pathLength) {
                        pathValid = false;
                    } else {
                        prefixLength = scan + 1;
                    }
                }
            }
            if (prefixLength == 0 || prefixLength + 14 > 260) {
                pathValid = false;
            }
        }
        if (pathValid) {
            shaderPath[prefixLength + 0] = 116;
            shaderPath[prefixLength + 1] = 114;
            shaderPath[prefixLength + 2] = 105;
            shaderPath[prefixLength + 3] = 97;
            shaderPath[prefixLength + 4] = 110;
            shaderPath[prefixLength + 5] = 103;
            shaderPath[prefixLength + 6] = 108;
            shaderPath[prefixLength + 7] = 101;
            shaderPath[prefixLength + 8] = 46;
            shaderPath[prefixLength + 9] = 104;
            shaderPath[prefixLength + 10] = 108;
            shaderPath[prefixLength + 11] = 115;
            shaderPath[prefixLength + 12] = 108;
            shaderPath[prefixLength + 13] = 0;
            if (vertexShader) {
                result = D3DCompileFromFileRaw(&shaderPath[0], null, null,
                    utf8z("VertexMain"), utf8z("vs_5_0"), 0, 0, &rawCode, null);
            } else {
                result = D3DCompileFromFileRaw(&shaderPath[0], null, null,
                    utf8z("PixelMain"), utf8z("ps_5_0"), 0, 0, &rawCode, null);
            }
        }
    }
    code = unsafe(new ShaderBlobOwner(rawCode));
    return result >= 0;
}

[Blittable] [Layout(Sequential)]
struct ModeDescription {
    uint32 Width;
    uint32 Height;
    uint32 RefreshNumerator;
    uint32 RefreshDenominator;
    uint32 Format;
    uint32 ScanlineOrdering;
    uint32 Scaling;

    [NoThrow]
    public ModeDescription(uint32 width, uint32 height, uint32 refreshNumerator,
        uint32 refreshDenominator, uint32 format, uint32 scanlineOrdering, uint32 scaling) {
        Width = width;
        Height = height;
        RefreshNumerator = refreshNumerator;
        RefreshDenominator = refreshDenominator;
        Format = format;
        ScanlineOrdering = scanlineOrdering;
        Scaling = scaling;
    }
}

[Blittable] [Layout(Sequential)]
struct SampleDescription {
    uint32 Count;
    uint32 Quality;

    [NoThrow]
    public SampleDescription(uint32 count, uint32 quality) {
        Count = count;
        Quality = quality;
    }
}

[Blittable] [Layout(Sequential)]
struct SwapChainDescription {
    ModeDescription BufferDescription;
    SampleDescription SampleDescription;
    uint32 BufferUsage;
    uint32 BufferCount;
    ptr<void> OutputWindow;
    int32 Windowed;
    uint32 SwapEffect;
    uint32 Flags;

    [NoThrow]
    public unsafe SwapChainDescription(ModeDescription bufferDescription,
        SampleDescription sampleDescription, uint32 bufferUsage, uint32 bufferCount,
        ptr<void> outputWindow, int32 windowed, uint32 swapEffect, uint32 flags) {
        BufferDescription = bufferDescription;
        SampleDescription = sampleDescription;
        BufferUsage = bufferUsage;
        BufferCount = bufferCount;
        unsafe { OutputWindow = outputWindow; }
        Windowed = windowed;
        SwapEffect = swapEffect;
        Flags = flags;
    }
}

[Terrum.Interop.NativeImport("d3d11.dll", "D3D11CreateDeviceAndSwapChain")]
[Terrum.Interop.NativeParameter(1, Read, NoEscape, 0)]
[Terrum.Interop.NativeParameter(3, Read, NoEscape, 0)]
[Terrum.Interop.NativeParameter(5, Read, NoEscape, 1)]
[Terrum.Interop.NativeParameter(8, Read, NoEscape, 1)]
[Terrum.Interop.NativeOutput(8, NonNegative)]
[Terrum.Interop.NativeOutput(9, NonNegative)]
[Terrum.Interop.NativeOutput(10, NonNegative)]
[Terrum.Interop.NativeOutput(11, NonNegative)]
[NoThrow]
extern int32 D3D11CreateDeviceAndSwapChainRaw(
    ptr<void> adapter,
    int32 driverType,
    ptr<void> software,
    uint32 flags,
    ptr<uint32> featureLevels,
    uint32 featureLevelCount,
    uint32 sdkVersion,
    ptr<SwapChainDescription> description,
    write ptr<ptr<void>> swapChain,
    write ptr<ptr<void>> device,
    write ptr<uint32> selectedFeatureLevel,
    write ptr<ptr<void>> immediateContext);

[NoThrow]
unsafe bool CreateD3D11DeviceAndSwapChain(
    ptr<void> window,
    out SampleSwapChainOwner swapChain,
    out SampleDeviceOwner device,
    out SampleContextOwner immediateContext) {
    uint32 featureLevel = 45056;
    SwapChainDescription description = unsafe(new SwapChainDescription(
        new ModeDescription(1, 1, 0, 0, 28, 0, 0),
        new SampleDescription(1, 0), 32, 1, window, 1, 0, 0));
    mut ptr<void> rawSwapChain = null;
    mut ptr<void> rawDevice = null;
    mut uint32 selectedFeatureLevel = 0;
    mut ptr<void> rawContext = null;
    mut int32 status = 0;
    unsafe {
        status = D3D11CreateDeviceAndSwapChainRaw(
            null, 1, null, 0, &featureLevel, 1, 7, &description,
            &rawSwapChain, &rawDevice, &selectedFeatureLevel, &rawContext);
    }
    swapChain = unsafe(new SampleSwapChainOwner(rawSwapChain));
    device = unsafe(new SampleDeviceOwner(rawDevice));
    immediateContext = unsafe(new SampleContextOwner(rawContext));
    return status >= 0;
}

[NoThrow]
[Terrum.Interop.NativeCallable]
unsafe int64 WindowProcedure(ptr<void> window, uint32 message, uint64 wParam, int64 lParam) { unsafe {
        if (message == 5) {
            if (PostMessageW(window, 32768, wParam, 0) == 0) {
                mut WindowMessage failureQuit = new WindowMessage();
                PeekMessageW(&failureQuit, null, 18, 18, 1);
                PostQuitMessage(1);
            }
            return 0;
        }
        if (message == 16) {
            mut WindowMessage quit = new WindowMessage();
            if (PeekMessageW(&quit, null, 18, 18, 0) == 0) {
                PostQuitMessage(0);
            }
            return 0;
        }
        return DefWindowProcW(window, message, wParam, lParam);
    } }

public unique struct WindowOwner {
    private ptr<void> Handle;
    private char16 Atom;
    private uint32 ThreadId;

    public WindowOwner() { unsafe {
        Handle = null;
        Atom = 0;
        ThreadId = GetCurrentThreadId();
        require ThreadId != 0;
        mut InlineArray<char16, 17> className = [];
        className[0] = 84;
        className[1] = 101;
        className[2] = 114;
        className[3] = 114;
        className[4] = 117;
        className[5] = 109;
        className[6] = 79;
        className[7] = 119;
        className[8] = 110;
        className[9] = 101;
        className[10] = 114;
        className[11] = 67;
        className[12] = 108;
        className[13] = 97;
        className[14] = 115;
        className[15] = 115;
        className[16] = 0;
        WindowClass descriptor = new WindowClass(
            &Triangle.Interop.WindowProcedure, GetModuleHandleW(null), &className[0]);
        Atom = RegisterClassExW(&descriptor);
        try {
            require Atom != 0;
            Handle = CreateWindowExW(
                0, utf16z("TerrumOwnerClass"), utf16z("Terrum DX11 Triangle"), 13238272,
                100, 100, 800, 600,
                null, null, GetModuleHandleW(null), null);
            require Handle != null;
        } finally {
            if (Handle == null && Atom != 0) {
                ExitIfFalse(UnregisterClassW(
                    utf16z("TerrumOwnerClass"), GetModuleHandleW(null)) != 0);
            } }
        }
    }

    [NoThrow]
    private static void ExitIfFalse(bool succeeded) {
        if (!succeeded) {
            unsafe { ExitProcess(87); }
        }
    }

    [NoThrow] [Cleanup]
    public void Close() { unsafe {
        ExitIfFalse(ThreadId == GetCurrentThreadId());
        ExitIfFalse(DestroyWindow(Handle) != 0);
        ExitIfFalse(UnregisterClassW(
            utf16z("TerrumOwnerClass"), GetModuleHandleW(null)) != 0);
    } }

    public int32 Run() { unsafe {
        ExitIfFalse(ThreadId == GetCurrentThreadId());
        if (CreateD3D11DeviceAndSwapChain(
            Handle, out var swapchain, out var device, out var context)) {
            if (TryCompileShader(true, out var vertexCode)) {
                if (device.CreateVertexShader(
                    vertexCode.GetBufferPointer(), vertexCode.GetBufferSize(), out var vertexShader)) {
                    if (TryCompileShader(false, out var pixelCode)) {
                        if (device.CreatePixelShader(
                            pixelCode.GetBufferPointer(), pixelCode.GetBufferSize(), out var pixelShader)) {
                            try {
                                ShowWindow(Handle, 5);
                                mut WindowMessage message = new WindowMessage();
                                mut int32 result = 1;
                                mut uint64 exitCode = 0;
                                mut bool resizePending = true;
                                mut bool minimized = false;
                                mut bool redrawPending = true;
                                mut uint32 lastWidth = 0;
                                mut uint32 lastHeight = 0;
                                while (result > 0) {
                                    while (PeekMessageW(
                                        &message, null, 0, 0, 1) != 0) {
                                        uint32 queuedMessageId = message.Message;
                                        bool queuedWindowMessage = message.Window == Handle;
                                        if (queuedMessageId == 18) {
                                            exitCode = message.WParam;
                                            result = 0;
                                            break;
                                        }
                                        if (queuedWindowMessage && queuedMessageId == 32768) {
                                            resizePending = true;
                                            minimized = message.WParam == 1;
                                        } else {
                                            if (queuedWindowMessage && queuedMessageId == 15) {
                                                redrawPending = true;
                                            }
                                            TranslateMessage(&message);
                                            DispatchMessageW(&message);
                                        }
                                    }
                                    if (result == 0) {
                                        return exitCode == 0 ? 0 : 1;
                                    }
                                    if (resizePending || redrawPending) {
                                        resizePending = false;
                                        if (!minimized) {
                                            mut ClientRectangle clientRectangle =
                                                new ClientRectangle(0, 0, 0, 0);
                                            if (GetClientRect(Handle, &clientRectangle) == 0) {
                                                return 1;
                                            }
                                            if (!clientRectangle.TryGetDimensions(
                                                out var clientWidth, out var clientHeight)) {
                                                return 1;
                                            }
                                            if (clientWidth > 0 && clientHeight > 0) {
                                                if (uint32(clientWidth) != lastWidth
                                                    || uint32(clientHeight) != lastHeight) {
                                                    context.ClearState();
                                                    if (!swapchain.ResizeBuffers(
                                                        0, uint32(clientWidth), uint32(clientHeight), 0, 0)) {
                                                        return 1;
                                                    }
                                                    lastWidth = uint32(clientWidth);
                                                    lastHeight = uint32(clientHeight);
                                                    redrawPending = true;
                                                }
                                                if (redrawPending) {
                                                    if (swapchain.GetBuffer(out var backBuffer)) {
                                                        if (device.CreateRenderTargetView(
                                                            backBuffer.GetPointer(), out var renderTarget)) {
                                                            try {
                                                                context.ClearState();
                                                                mut Color4 clearColor =
                                                                    new Color4(float32(0.08), float32(0.12),
                                                                        float32(0.18), float32(1.0));
                                                                mut Viewport viewport = new Viewport(
                                                                    float32(0.0), float32(0.0),
                                                                    float32(clientWidth),
                                                                    float32(clientHeight),
                                                                    float32(0.0), float32(1.0));
                                                                ClearRenderTargetViewRaw(
                                                                    context.GetPointer(), renderTarget.GetPointer(), &clearColor);
                                                                context.OMSetRenderTargets(renderTarget.GetPointer());
                                                                RSSetViewportsRaw(context.GetPointer(), 1, &viewport);
                                                                context.IASetPrimitiveTopology(4);
                                                                context.VSSetShader(vertexShader.GetPointer());
                                                                context.PSSetShader(pixelShader.GetPointer());
                                                                context.Draw(3, 0);
                                                                if (!swapchain.Present()) {
                                                                    return 1;
                                                                }
                                                            } finally {
                                                                context.ClearState();
                                                            }
                                                        } else {
                                                            return 1;
                                                        }
                                                    } else {
                                                        return 1;
                                                    }
                                                }
                                            }
                                        }
                                        redrawPending = false;
                                    }
                                    result = GetMessageW(
                                        &message, null, 0, 0);
                                    if (result < 0) {
                                        return 1;
                                    }
                                    if (result == 0) {
                                        return message.WParam == 0 ? 0 : 1;
                                    }
                                    uint32 messageId = message.Message;
                                    bool isWindowMessage = message.Window == Handle;
                                    if (isWindowMessage && messageId == 32768) {
                                        resizePending = true;
                                        minimized = message.WParam == 1;
                                    } else {
                                        if (isWindowMessage && messageId == 15) {
                                            redrawPending = true;
                                        }
                                        TranslateMessage(&message);
                                        DispatchMessageW(&message);
                                    }
                                }
                                return exitCode == 0 ? 0 : 1;
                            } finally {
                                context.ClearState();
                            }
                        }
                    }
                }
            }
        }
        return 1;
    } }
}

int32 Main() {
    WindowOwner window = new WindowOwner();
    return window.Run();
}

[Blittable] [Layout(LayoutKind.Sequential)]
struct ClientRectangle {
    int32 Left;
    int32 Top;
    int32 Right;
    int32 Bottom;

    [NoThrow]
    public ClientRectangle(int32 left, int32 top, int32 right, int32 bottom) {
        Left = left;
        Top = top;
        Right = right;
        Bottom = bottom;
    }

    [NoThrow]
    public bool TryGetDimensions(out int32 width, out int32 height) {
        width = 0;
        height = 0;
        if (Left != 0 || Top != 0 || Right < Left || Bottom < Top) {
            return false;
        }
        width = Right;
        height = Bottom;
        return true;
    }
}
