namespace Triangle.Interop;

[Layout(Sequential)]
struct Vertex {
    float32 X;
    float32 Y;
    float32 Z;

    [NoThrow]
    public Vertex(float32 x, float32 y, float32 z) {
        X = x;
        Y = y;
        Z = z;
    }
}

