[Terrum.Interop.NativeImport("windows-x64.system32.user32.PostQuitMessage")]
[NoThrow]
extern void PostQuitMessage(int32 exitCode);

struct Host {
    int32 Value;

    [NoThrow]
    public static nint WindowProcedure(Terrum.Interop.Windows.HWND window, uint32 message,
        nuint wParam, nint lParam) {
        if (message == 5) {
            if (PostMessageW(window, 32768, wParam, 0) == 0) {
                mut Terrum.Interop.Windows.MSG failureQuit = msgzero();
                PeekMessageW(&failureQuit, Terrum.Interop.Windows.HWND.NoOwner, 18, 18, 1);
                PostQuitMessage(1);
            }
            return 0;
        }
        if (message == 16) {
            mut Terrum.Interop.Windows.MSG quit = msgzero();
            if (PeekMessageW(&quit, Terrum.Interop.Windows.HWND.NoOwner, 18, 18, 0) == 0) {
                PostQuitMessage(0);
            }
            return 0;
        }
        return DefWindowProcW(window, message, wParam, lParam);
    }
}

public unique struct WindowOwner {
    private Terrum.Interop.Windows.HWND Handle;
    private char16 Atom;
    private uint32 ThreadId;

    public WindowOwner() {
        Handle = Terrum.Interop.Windows.HWND.NoOwner;
        Atom = 0;
        ThreadId = GetCurrentThreadId();
        require ThreadId != 0;
        Terrum.Interop.Windows.WNDCLASSEXW descriptor = windowclassex(
            &Host.WindowProcedure, GetModuleHandleW(null), utf16z("TerrumOwnerClass"));
        Atom = RegisterClassExW(&descriptor);
        try {
            require Atom != 0;
            Handle = CreateWindowExW(
                0, utf16z("TerrumOwnerClass"), utf16z("Terrum DX11 Triangle"), 13238272,
                100, 100, 800, 600,
                Terrum.Interop.Windows.HWND.NoOwner, null, GetModuleHandleW(null), null);
            require Handle != Terrum.Interop.Windows.HWND.NoOwner;
        } finally {
            if (Handle == Terrum.Interop.Windows.HWND.NoOwner && Atom != 0) {
                ExitIfFalse(UnregisterClassW(
                    utf16z("TerrumOwnerClass"), GetModuleHandleW(null)) != 0);
            }
        }
    }

    [NoThrow]
    private static void ExitIfFalse(bool succeeded) {
        if (!succeeded) {
            ExitProcess(87);
        }
    }

    [NoThrow] [Cleanup]
    public void Close() {
        ExitIfFalse(ThreadId == GetCurrentThreadId());
        ExitIfFalse(DestroyWindow(Handle) != 0);
        ExitIfFalse(UnregisterClassW(
            utf16z("TerrumOwnerClass"), GetModuleHandleW(null)) != 0);
    }

    public int32 Run() {
        ExitIfFalse(ThreadId == GetCurrentThreadId());
        if (!tryopend3d11(out var d3d11)) {
            return 1;
        }
        if (d3d11.trycreatehardwareswapchain(Handle, out var device, out var swapchain, out var context)) {
            mut InlineArray<char16, 260> shaderPath = [];
            uint32 pathLength = GetModuleFileNameW(null, &shaderPath[0], 260);
            if (pathLength == 0) {
                uint32 pathError = GetLastError();
                return 1;
            }
            if (pathLength >= 260) {
                return 1;
            }
            mut uint32 scan = pathLength;
            mut uint32 prefixLength = 0;
            while (scan > 0 && prefixLength == 0) {
                scan = scan - 1;
                if (shaderPath[scan] == 92 || shaderPath[scan] == 47) {
                    if (scan + 1 >= pathLength) {
                        return 1;
                    }
                    prefixLength = scan + 1;
                }
            }
            if (prefixLength == 0 || prefixLength + 14 > 260) {
                return 1;
            }
            shaderPath[prefixLength + 0] = 116;
            shaderPath[prefixLength + 1] = 114;
            shaderPath[prefixLength + 2] = 105;
            shaderPath[prefixLength + 3] = 97;
            shaderPath[prefixLength + 4] = 110;
            shaderPath[prefixLength + 5] = 103;
            shaderPath[prefixLength + 6] = 108;
            shaderPath[prefixLength + 7] = 101;
            shaderPath[prefixLength + 8] = 46;
            shaderPath[prefixLength + 9] = 104;
            shaderPath[prefixLength + 10] = 108;
            shaderPath[prefixLength + 11] = 115;
            shaderPath[prefixLength + 12] = 108;
            shaderPath[prefixLength + 13] = 0;
            InlineArray<Vertex, 3> vertices = [
                new Vertex(0, 0.6, 0.5),
                new Vertex(0.6, -0.5, 0.5),
                new Vertex(-0.6, -0.5, 0.5)
            ];
            Vertex first = vertices[0];
            Vertex second = vertices[1];
            Vertex third = vertices[2];
            uint32 byteWidth = 36;
            uint32 usage = 1;
            uint32 bindFlags = 1;
            uint32 cpuAccessFlags = 0;
            uint32 miscFlags = 0;
            uint32 structureByteStride = 0;
            uint32 sysMemPitch = 0;
            uint32 sysMemSlicePitch = 0;
            if (device.TryCreateImmutableVertexBuffer(first, second, third,
                byteWidth, usage, bindFlags, cpuAccessFlags, miscFlags, structureByteStride,
                sysMemPitch, sysMemSlicePitch, out var buffer)) {
                if (tryopenshadercompiler(out var compiler)) {
                    if (compiler.D3DCompileFromFile(&shaderPath[0],
                        utf8z("VertexMain"), utf8z("vs_5_0"), out var vertexCode)) {
                        if (vertexCode.TryClone(out var inputLayoutCode)) {
                            Terrum.Interop.Dx11.InputElementDesc description =
                                inputelementdesc(utf8z("POSITION"), 0, 6, 0, 0, 0, 0);
                            if (device.TryCreateInputLayout(
                                move inputLayoutCode, &description, out var inputLayout)) {
                                if (device.TryCreateVertexShader(move vertexCode, out var vertexShader)) {
                                    if (compiler.D3DCompileFromFile(&shaderPath[0],
                                        utf8z("PixelMain"), utf8z("ps_5_0"), out var pixelCode)) {
                                        if (device.TryCreatePixelShader(move pixelCode, out var pixelShader)) {
                                            try {
                                                ShowWindow(Handle, 5);
                                                mut Terrum.Interop.Windows.MSG message = msgzero();
                                                mut int32 result = 1;
                                                mut nuint exitCode = 0;
                                                mut bool resizePending = true;
                                                mut bool minimized = false;
                                                mut bool redrawPending = true;
                                                mut uint32 lastWidth = 0;
                                                mut uint32 lastHeight = 0;
                                                while (result > 0) {
                                                    while (PeekMessageW(
                                                        &message, Terrum.Interop.Windows.HWND.NoOwner, 0, 0, 1) != 0) {
                                                        uint32 queuedMessageId = msgid(&message);
                                                        bool queuedWindowMessage = msgwindowis(&message, Handle);
                                                        if (queuedMessageId == 18) {
                                                            exitCode = msgwparam(&message);
                                                            result = 0;
                                                            break;
                                                        }
                                                        if (queuedWindowMessage && queuedMessageId == 32768) {
                                                            resizePending = true;
                                                            minimized = msgwparam(&message) == 1;
                                                        } else {
                                                            if (queuedWindowMessage && queuedMessageId == 15) {
                                                                redrawPending = true;
                                                            }
                                                            TranslateMessage(&message);
                                                            DispatchMessageW(&message);
                                                        }
                                                    }
                                                    if (result == 0) {
                                                        return exitCode == 0 ? 0 : 1;
                                                    }
                                                    if (resizePending || redrawPending) {
                                                        resizePending = false;
                                                        if (!minimized) {
                                                            mut ClientRectangle clientRectangle =
                                                                new ClientRectangle(0, 0, 0, 0);
                                                            if (GetClientRect(Handle, &clientRectangle) == 0) {
                                                                return 1;
                                                            }
                                                            if (!clientRectangle.TryGetDimensions(
                                                                out var clientWidth, out var clientHeight)) {
                                                                return 1;
                                                            }
                                                            if (clientWidth > 0 && clientHeight > 0) {
                                                                if (uint32(clientWidth) != lastWidth
                                                                    || uint32(clientHeight) != lastHeight) {
                                                                    context.ClearState();
                                                                    if (!swapchain.ResizeBuffers(
                                                                        0, uint32(clientWidth), uint32(clientHeight), 0, 0)) {
                                                                        return 1;
                                                                    }
                                                                    lastWidth = uint32(clientWidth);
                                                                    lastHeight = uint32(clientHeight);
                                                                    redrawPending = true;
                                                                }
                                                                if (redrawPending) {
                                                                    if (swapchain.TryGetBackBuffer(out var backBuffer)) {
                                                                        if (device.TryCreateRenderTargetView(
                                                                            backBuffer, out var renderTarget)) {
                                                                            try {
                                                                                context.ClearState();
                                                                                context.ClearRenderTargetView(
                                                                                    renderTarget, 0.08, 0.12, 0.18, 1.0);
                                                                                context.OMSetRenderTargets(renderTarget);
                                                                                {
                                                                                    context.RSSetViewports(
                                                                                        0.0, 0.0,
                                                                                        float32(clientWidth),
                                                                                        float32(clientHeight),
                                                                                        0.0, 1.0);
                                                                                }
                                                                                context.IASetInputLayout(inputLayout);
                                                                                context.IASetVertexBuffers(buffer, 12, 0);
                                                                                context.IASetPrimitiveTopology(4);
                                                                                context.VSSetShader(vertexShader);
                                                                                context.PSSetShader(pixelShader);
                                                                                context.Draw(3, 0);
                                                                                if (!swapchain.Present()) {
                                                                                    return 1;
                                                                                }
                                                                            } finally {
                                                                                context.ClearState();
                                                                            }
                                                                        } else {
                                                                            return 1;
                                                                        }
                                                                    } else {
                                                                        return 1;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        redrawPending = false;
                                                    }
                                                    result = GetMessageW(
                                                        &message, Terrum.Interop.Windows.HWND.NoOwner, 0, 0);
                                                    if (result < 0) {
                                                        return 1;
                                                    }
                                                    if (result == 0) {
                                                        return msgwparam(&message) == 0 ? 0 : 1;
                                                    }
                                                    uint32 messageId = msgid(&message);
                                                    bool isWindowMessage = msgwindowis(&message, Handle);
                                                    if (isWindowMessage && messageId == 32768) {
                                                        resizePending = true;
                                                        minimized = msgwparam(&message) == 1;
                                                    } else {
                                                        if (isWindowMessage && messageId == 15) {
                                                            redrawPending = true;
                                                        }
                                                        TranslateMessage(&message);
                                                        DispatchMessageW(&message);
                                                    }
                                                }
                                                return exitCode == 0 ? 0 : 1;
                                            } finally {
                                                context.ClearState();
                                            }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                }
            }
        }
        return 1;
    }
}

int32 Main() {
    WindowOwner window = new WindowOwner();
    return window.Run();
}

