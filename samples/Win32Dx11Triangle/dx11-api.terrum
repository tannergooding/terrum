public unique struct ShaderBlobOwner {
    private ptr<void> Pointer;

    [NoThrow]
    public unsafe ShaderBlobOwner(ptr<void> pointer) {
        unsafe { Pointer = pointer; }
    }

    [NoThrow]
    [Cleanup]
    public void Close() {
        unsafe {
            if (Pointer != null) {
                Release(Pointer);
            }
        }
    }

    public unsafe ptr<void> GetBufferPointer() {
        unsafe { return GetBufferPointerRaw(Pointer); }
    }

    public unsafe uint64 GetBufferSize() {
        unsafe { return GetBufferSizeRaw(Pointer); }
    }
}

public unique struct SampleSwapChainOwner {
    private ptr<void> Pointer;

    [NoThrow]
    public unsafe SampleSwapChainOwner(ptr<void> pointer) {
        unsafe { Pointer = pointer; }
    }

    [NoThrow]
    [Cleanup]
    public void Close() {
        unsafe {
            if (Pointer != null) {
                Release(Pointer);
            }
        }
    }

    [NoThrow]
    public bool GetBuffer(out BackBufferOwner backBuffer) {
        mut InterfaceId interfaceId = new InterfaceId(
            0x6F15AAF2, 0x4E89D208, 0x9C4FD3359548B49A);
        mut ptr<void> pointer = null;
        mut int32 status = -1;
        unsafe {
            status = GetBufferRaw(Pointer, 0, &interfaceId, &pointer);
        }
        if (status >= 0) {
            backBuffer = unsafe(new BackBufferOwner(pointer));
            return true;
        }
        backBuffer = unsafe(new BackBufferOwner(null));
        return false;
    }

    [NoThrow]
    public bool Present() {
        unsafe { return PresentRaw(Pointer, 1, 0) >= 0; }
    }

    [NoThrow]
    public bool ResizeBuffers(
        uint32 bufferCount, uint32 width, uint32 height, uint32 format, uint32 flags) {
        unsafe {
            return ResizeBuffersRaw(Pointer, bufferCount, width, height, format, flags) >= 0;
        }
    }
}

public unique struct SampleDeviceOwner {
    private ptr<void> Pointer;

    [NoThrow]
    public unsafe SampleDeviceOwner(ptr<void> pointer) {
        unsafe { Pointer = pointer; }
    }

    [NoThrow]
    [Cleanup]
    public void Close() {
        unsafe {
            if (Pointer != null) {
                Release(Pointer);
            }
        }
    }

    [NoThrow]
    public bool CreateRenderTargetView(ptr<void> resource, out RenderTargetViewOwner view) {
        mut ptr<void> pointer = null;
        mut int32 status = -1;
        unsafe {
            status = CreateRenderTargetViewRaw(Pointer, resource, null, &pointer);
        }
        if (status >= 0) {
            view = unsafe(new RenderTargetViewOwner(pointer));
            return true;
        }
        view = unsafe(new RenderTargetViewOwner(null));
        return false;
    }

    [NoThrow]
    public bool CreateVertexShader(
        ptr<void> bytecode, uint64 bytecodeSize, out VertexShaderOwner shader) {
        mut ptr<void> pointer = null;
        mut int32 status = -1;
        unsafe {
            status = CreateVertexShaderRaw(
                Pointer, bytecode, bytecodeSize, null, &pointer);
        }
        if (status >= 0) {
            shader = unsafe(new VertexShaderOwner(pointer));
            return true;
        }
        shader = unsafe(new VertexShaderOwner(null));
        return false;
    }

    [NoThrow]
    public bool CreatePixelShader(
        ptr<void> bytecode, uint64 bytecodeSize, out PixelShaderOwner shader) {
        mut ptr<void> pointer = null;
        mut int32 status = -1;
        unsafe {
            status = CreatePixelShaderRaw(
                Pointer, bytecode, bytecodeSize, null, &pointer);
        }
        if (status >= 0) {
            shader = unsafe(new PixelShaderOwner(pointer));
            return true;
        }
        shader = unsafe(new PixelShaderOwner(null));
        return false;
    }
}

public unique struct SampleContextOwner {
    private ptr<void> Pointer;

    [NoThrow]
    public unsafe SampleContextOwner(ptr<void> pointer) {
        unsafe { Pointer = pointer; }
    }

    [NoThrow]
    [Cleanup]
    public void Close() {
        unsafe {
            if (Pointer != null) {
                Release(Pointer);
            }
        }
    }

    [NoThrow]
    public void ClearState() {
        unsafe { ClearStateRaw(Pointer); }
    }

    [NoThrow]
    public void Draw(uint32 vertexCount, uint32 startVertexLocation) {
        unsafe { DrawRaw(Pointer, vertexCount, startVertexLocation); }
    }

    [NoThrow]
    public void IASetPrimitiveTopology(uint32 topology) {
        unsafe { IASetPrimitiveTopologyRaw(Pointer, topology); }
    }

    [NoThrow]
    public void OMSetRenderTargets(ptr<void> renderTarget) {
        mut ptr<void> pointer = renderTarget;
        unsafe { OMSetRenderTargetsRaw(Pointer, 1, &pointer, null); }
    }

    [NoThrow]
    public void PSSetShader(ptr<void> shader) {
        unsafe { PSSetShaderRaw(Pointer, shader, null, 0); }
    }

    [NoThrow]
    public void VSSetShader(ptr<void> shader) {
        unsafe { VSSetShaderRaw(Pointer, shader, null, 0); }
    }

    public unsafe ptr<void> GetPointer() {
        unsafe { return Pointer; }
    }
}

