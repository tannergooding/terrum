namespace Triangle.Interop;

[Blittable] [Layout(Sequential)]
struct Color4 {
    float32 Red;
    float32 Green;
    float32 Blue;
    float32 Alpha;

    [NoThrow]
    public Color4(float32 red, float32 green, float32 blue, float32 alpha) {
        Red = red;
        Green = green;
        Blue = blue;
        Alpha = alpha;
    }
}

[Blittable] [Layout(Sequential)]
struct Viewport {
    float32 TopLeftX;
    float32 TopLeftY;
    float32 Width;
    float32 Height;
    float32 MinDepth;
    float32 MaxDepth;

    [NoThrow]
    public Viewport(float32 topLeftX, float32 topLeftY, float32 width, float32 height,
        float32 minDepth, float32 maxDepth) {
        TopLeftX = topLeftX;
        TopLeftY = topLeftY;
        Width = width;
        Height = height;
        MinDepth = minDepth;
        MaxDepth = maxDepth;
    }
}

[Blittable] [Layout(Sequential)]
struct InterfaceId {
    uint32 Data1;
    uint32 Data2Data3;
    uint64 Data4;

    [NoThrow]
    public InterfaceId(uint32 data1, uint32 data2Data3, uint64 data4) {
        Data1 = data1;
        Data2Data3 = data2Data3;
        Data4 = data4;
    }
}

