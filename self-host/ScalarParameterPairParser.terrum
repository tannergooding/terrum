namespace Terrum.CodeAnalysis;

bool TryParseTwoParameterBinaryPrefix(TokenSnapshot tokens, int32 operatorKind,
    bool comparison,
    out int32 scalarType, out SourceRange name)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 17 && tokens.GetCount() != 19)
    {
        return false;
    }
    require tokens.TryGet(0, init var returnType);
    require tokens.TryGet(1, init var function);
    require tokens.TryGet(2, init var openParameters);
    require tokens.TryGet(3, init var firstType);
    require tokens.TryGet(4, init var firstParameter);
    require tokens.TryGet(5, init var comma);
    require tokens.TryGet(6, init var secondType);
    require tokens.TryGet(7, init var secondParameter);
    require tokens.TryGet(8, init var closeParameters);
    require tokens.TryGet(9, init var openBody);
    require tokens.TryGet(10, init var returnKeyword);
    require tokens.TryGet(11, init var firstUse);
    require tokens.TryGet(12, init var binary);
    require tokens.TryGet(13, init var secondUse);
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    if (!TryGetScalarType(returnType, out var resultType)
        || !TryGetScalarType(firstType, out var matchingFirst)
        || !TryGetScalarType(secondType, out var matchingSecond)
        || matchingFirst != matchingSecond
        || (comparison && resultType != 5)
        || (!comparison && resultType != matchingFirst)
        || matchingFirst == 5 || (!comparison && matchingFirst == 6)
        || function.Kind != 2 || openParameters.Kind != 46 || comma.Kind != 53
        || closeParameters.Kind != 47 || openBody.Kind != 48
        || returnKeyword.Kind != 19 || binary.Kind != operatorKind
        || !SameTokenSpelling(firstParameter, firstUse)
        || !SameTokenSpelling(secondParameter, secondUse)
        || SameTokenSpelling(firstParameter, secondParameter))
    {
        return false;
    }
    scalarType = matchingFirst;
    name = function.Range;
    return true;
}

bool TryParseTwoParameterAddPrefix(TokenSnapshot tokens,
    out int32 scalarType, out SourceRange name)
{
    return TryParseTwoParameterBinaryPrefix(move tokens, 57, false, out scalarType, out name);
}

bool TryParseTwoParameterAddReturn(TokenSnapshot tokens,
    out int32 scalarType, out SourceRange name)
{
    if (tokens.GetCount() != 17)
    {
        return false;
    }
    require tokens.TryGet(14, init var semicolon);
    require tokens.TryGet(15, init var closeBody);
    require tokens.TryGet(16, init var eof);
    if (semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }
    return TryParseTwoParameterAddPrefix(move tokens, out scalarType, out name);
}

bool TryParseTwoParameterSubtractReturn(TokenSnapshot tokens,
    out int32 scalarType, out SourceRange name)
{
    if (tokens.GetCount() != 17)
    {
        return false;
    }
    require tokens.TryGet(14, init var semicolon);
    require tokens.TryGet(15, init var closeBody);
    require tokens.TryGet(16, init var eof);
    if (semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }
    return TryParseTwoParameterBinaryPrefix(move tokens, 58, false, out scalarType, out name);
}

bool TryParseTwoParameterComparisonReturn(TokenSnapshot tokens,
    out int32 scalarType, out int32 operation, out SourceRange name)
{
    if (tokens.GetCount() != 17)
    {
        return false;
    }
    require tokens.TryGet(12, init var comparison);
    require tokens.TryGet(14, init var semicolon);
    require tokens.TryGet(15, init var closeBody);
    require tokens.TryGet(16, init var eof);
    if (comparison.Kind < 65 || comparison.Kind > 70
        || semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0
        || !TryParseTwoParameterBinaryPrefix(move tokens, comparison.Kind, true,
            out var selected, out var foundName))
    {
        return false;
    }
    scalarType = selected;
    operation = comparison.Kind;
    name = foundName;
    return true;
}

bool TryParseTwoParameterAddAndLiteralReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, out int32 scalarType, out SourceRange name,
    out uint64 magnitude, out bool based)
{
    if (tokens.GetCount() != 19)
    {
        return false;
    }
    require tokens.TryGet(14, init var add);
    require tokens.TryGet(15, init var literal);
    require tokens.TryGet(16, init var semicolon);
    require tokens.TryGet(17, init var closeBody);
    require tokens.TryGet(18, init var eof);
    if (add.Kind != 57 || literal.Kind != 3 || semicolon.Kind != 52
        || closeBody.Kind != 49 || eof.Kind != 0
        || !TryParseTwoParameterAddPrefix(move tokens, out var selected,
            out var foundName)
        || !integers.TryFind(15, out var overflow, out var low, out var high)
        || overflow)
    {
        return false;
    }
    scalarType = selected;
    name = foundName;
    magnitude = DecodeScannerMagnitude(low, high);
    based = IsBasedInteger(literal);
    return true;
}

bool TryEvaluateInt32TwoParameterAddAndLiteralReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, int32 first, int32 second,
    out SourceRange name, out int32 result)
{
    if (!TryParseTwoParameterAddAndLiteralReturn(move tokens, move integers,
            out var selected, out var foundName, out var magnitude, out var based)
        || selected != 1
        || magnitude > uint64(uint32.MaxValue)
        || (!based && magnitude > uint64(int32.MaxValue)))
    {
        return false;
    }
    int64 firstSum = int64(first) + int64(second);
    if (firstSum < int64(int32.MinValue) || firstSum > int64(int32.MaxValue))
    {
        return false;
    }
    mut int64 literal = int64(magnitude);
    if (magnitude > uint64(int32.MaxValue))
    {
        literal = literal - 4294967296;
    }
    int64 finalSum = firstSum + literal;
    if (finalSum < int64(int32.MinValue) || finalSum > int64(int32.MaxValue))
    {
        return false;
    }
    name = foundName;
    result = int32(finalSum);
    return true;
}

bool TryEvaluateUInt32TwoParameterAddAndLiteralReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, uint32 first, uint32 second,
    out SourceRange name, out uint32 result)
{
    if (!TryParseTwoParameterAddAndLiteralReturn(move tokens, move integers,
            out var selected, out var foundName, out var magnitude, out var based)
        || selected != 2 || magnitude > uint64(uint32.MaxValue))
    {
        return false;
    }
    uint64 firstSum = uint64(first) + uint64(second);
    uint64 finalSum = firstSum + magnitude;
    if (firstSum > uint64(uint32.MaxValue) || finalSum > uint64(uint32.MaxValue))
    {
        return false;
    }
    name = foundName;
    result = uint32(finalSum);
    return true;
}

bool TryEvaluateInt64TwoParameterAddAndLiteralReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, int64 first, int64 second,
    out SourceRange name, out int64 result)
{
    if (!TryParseTwoParameterAddAndLiteralReturn(move tokens, move integers,
            out var selected, out var foundName, out var magnitude, out var based)
        || selected != 3 || !TryDecodeSigned64Scalar(magnitude, based, out var literal)
        || (second > 0 && first > int64.MaxValue - second)
        || (second < 0 && first < int64.MinValue - second))
    {
        return false;
    }
    int64 firstSum = first + second;
    if ((literal > 0 && firstSum > int64.MaxValue - literal)
        || (literal < 0 && firstSum < int64.MinValue - literal))
    {
        return false;
    }
    name = foundName;
    result = firstSum + literal;
    return true;
}

bool TryEvaluateUInt64TwoParameterAddAndLiteralReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, uint64 first, uint64 second,
    out SourceRange name, out uint64 result)
{
    if (!TryParseTwoParameterAddAndLiteralReturn(move tokens, move integers,
            out var selected, out var foundName, out var magnitude, out var based)
        || selected != 4 || first > uint64.MaxValue - second)
    {
        return false;
    }
    uint64 firstSum = first + second;
    if (firstSum > uint64.MaxValue - magnitude)
    {
        return false;
    }
    name = foundName;
    result = firstSum + magnitude;
    return true;
}

bool TryEvaluateInt32TwoParameterAddReturn(TokenSnapshot tokens, int32 first, int32 second,
    out SourceRange name, out int32 result)
{
    if (!TryParseTwoParameterAddReturn(move tokens, out var selected, out var foundName)
        || selected != 1 || !TryAddScalarInt32(first, second, out var sum))
    {
        return false;
    }
    name = foundName;
    result = sum;
    return true;
}

