{
    if (!TryParseTwoParameterAddReturn(move tokens, out var selected, out var foundName)
        || selected != 2 || !TryAddScalarUInt32(first, second, out var sum))
    {
        return false;
    }
    name = foundName;
    result = sum;
    return true;
}

