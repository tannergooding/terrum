    private bool TreeBodyReturns(int32 start, int32 end)
    {
        mut bool completes = true;
        mut int32 cursor = start;
        while (cursor < end)
        {
            int32 header = cursor;
            int32 kind = TreeStatementKind(cursor);
            mut bool returns = kind == 8 || kind == 6 || kind == 7 || kind == 22;
            if (kind == 21) { returns = TreeLiteralBoolean(TreeStatementWord(cursor, 2)) == 0; }
            if (kind == 14)
            {
                int32 blockEnd = TreeStatementWord(cursor, 1);
                returns = TreeBodyReturns(cursor + 1, blockEnd);
                cursor = blockEnd;
            }
            else if (kind == 3 || kind == 4 || kind == 11 || kind == 12)
            {
                int32 armEnd = TreeStatementWord(cursor, 1);
                int32 bodyStart = kind == 12 ? cursor + 3 : cursor + 1;
                bool whenTrue = TreeBodyReturns(bodyStart, armEnd);
                cursor = armEnd;
                if (kind == 3 || kind == 11 || kind == 12)
                {
                    int32 conditionRoot = TreeStatementWord(header, 2);
                    mut int32 condition = 1;
                    if (conditionRoot != -1)
                    {
                        condition = TreeLiteralBoolean(conditionRoot);
                    }
                    returns = (kind == 11 && whenTrue
                            && !TreeBodyHasTransfer(bodyStart, armEnd, header, 7)
                        || condition == 1)
                        && !TreeBodyHasTransfer(bodyStart, armEnd, header, 6);
                }
                else
                {
                    mut bool whenFalse = false;
                    if (cursor < end && IsTreeElseMarker(cursor))
                    {
                        int32 elseEnd = TreeStatementWord(cursor, 1);
                        whenFalse = TreeBodyReturns(cursor + 1, elseEnd);
                        cursor = elseEnd;
                    }
                    int32 condition = TreeLiteralBoolean(TreeStatementWord(header, 2));
                    returns = condition == 1 ? whenTrue
                        : condition == 0 ? whenFalse : whenTrue && whenFalse;
                }
            }
            else
            {
                cursor = cursor + 1;
            }
            if (completes && returns) { completes = false; }
        }
        return !completes;
    }

    private int32 TreeLiteralBoolean(int32 root)
    {
        mut int32 selected = root;
        mut int32 operation = TreeWord(selected, 0);
        while (operation == 46)
        {
            selected = TreeWord(selected, 4);
            operation = TreeWord(selected, 0);
        }
        if (operation == 20) { return 1; }
        if (operation == 21) { return 0; }
        if (operation == 62)
        {
            int32 operand = TreeLiteralBoolean(TreeWord(selected, 4));
            if (operand != -1) { return 1 - operand; }
        }
        if (operation == 72 || operation == 74)
        {
            int32 left = TreeLiteralBoolean(TreeWord(selected, 4));
            int32 right = TreeLiteralBoolean(TreeWord(selected, 5));
            if (operation == 72)
            {
                if (left == 0 || right == 0) { return 0; }
                if (left == 1 && right == 1) { return 1; }
            }
            else
            {
                if (left == 1 || right == 1) { return 1; }
                if (left == 0 && right == 0) { return 0; }
            }
        }
        if (operation == 84)
        {
            int32 condition = TreeLiteralBoolean(TreeWord(selected, 4));
            int32 whenTrue = TreeLiteralBoolean(TreeWord(selected, 5));
            int32 whenFalse = TreeLiteralBoolean(TreeWord(selected, 6));
            if (condition == 1) { return whenTrue; }
            if (condition == 0) { return whenFalse; }
            if (whenTrue == whenFalse) { return whenTrue; }
        }
        return -1;
    }

    private bool TreeBodyHasTransfer(int32 start, int32 end, int32 loop, int32 transfer)
    {
        mut int32 cursor = start;
        while (cursor < end)
        {
            int32 header = cursor;
            int32 kind = TreeStatementKind(cursor);
            if (kind == transfer && TreeStatementWord(cursor, 1) == loop)
            {
                return true;
            }
            if (kind == 6) { return false; }
            if (kind == 8 || kind == 7) { return false; }
            if (kind == 14)
            {
                int32 blockEnd = TreeStatementWord(cursor, 1);
                if (TreeBodyHasTransfer(cursor + 1, blockEnd, loop, transfer))
                {
                    return true;
                }
                cursor = blockEnd;
            }
            else if (kind == 3 || kind == 11 || kind == 12)
            {
                int32 bodyEnd = TreeStatementWord(cursor, 1);
                int32 root = TreeStatementWord(cursor, 2);
                if ((kind == 11 || root == -1 || TreeLiteralBoolean(root) != 0)
                    && TreeBodyHasTransfer(kind == 12 ? cursor + 3 : cursor + 1,
                        bodyEnd, loop, transfer))
                {
                    return true;
                }
                cursor = bodyEnd;
            }
            else if (kind == 4)
            {
                int32 condition = TreeLiteralBoolean(TreeStatementWord(cursor, 2));
                int32 armEnd = TreeStatementWord(cursor, 1);
                if (condition != 0
                    && TreeBodyHasTransfer(cursor + 1, armEnd, loop, transfer))
                {
                    return true;
                }
                cursor = armEnd;
                if (cursor < end && IsTreeElseMarker(cursor))
                {
                    int32 elseEnd = TreeStatementWord(cursor, 1);
                    if (condition != 1
                        && TreeBodyHasTransfer(cursor + 1, elseEnd, loop, transfer))
                    {
                        return true;
                    }
                    cursor = elseEnd;
                }
            }
            else
            {
                cursor = cursor + 1;
            }
            if (TreeBodyReturns(header, cursor)) { return false; }
        }
        return false;
    }

    public mut bool TryParseStructuredReturns(out ScalarFrontendResult result)
    {
        require SourceRange.TryCreate(0, 0, out var empty);
        require ScalarFrontendExpression.TryCreate(0, 0, 0, 0, empty, out var absent);
        mut SourceRange name = empty;
        mut int32 returnType = 0;
