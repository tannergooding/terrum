            mut bool hasTerminatingStatement = false;
            for (mut int32 index = 0; index < _statementCount; index = index + 1)
            {
                int32 kind = TreeStatementKind(index);
                if (kind == 11 || kind == 12 || kind == 21) { hasTerminatingStatement = true; }
            }
            if (_error == 0 && !HasStructuredCompletion(returnType, hasTerminatingStatement))
            {
