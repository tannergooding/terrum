            || first.Kind == 2 && _tokens.TryGet(_at + 1, out var postfix)
                && (postfix.Kind == 86 || postfix.Kind == 87))
        {
            if (!ParseTreeExpression(0, 1, 0, out var update))
            {
                return false;
            }
            if (_tokens.TryGet(_at, out var compound)
                && compound.Kind >= 91 && compound.Kind <= 101)
            {
                if (!TryTreeUpdatePlace(update))
                {
                    return false;
                }
                int32 type = TreeWord(update, 1);
                int32 rightType = compound.Kind >= 99 ? 1 : type;
                _at = _at + 1;
                if (!ParseTreeExpression(rightType, 1, 0, out var value)
                    || !ResolveTreeLiteral(value, rightType, false)
                    || semicolon && !Take(52, out var end))
                {
                    return false;
                }
                if (!AddTreeNode(compound.Kind, type, first.Range.Start,
                    TreeWord(value, 2) + TreeWord(value, 3),
                    update, value, 0, 0, out var root))
                {
                    return false;
                }
                int32 slot = TreeWord(UngroupTree(update), 4);
                return AddTreeStatement(9, slot, root, first.Range.Start, TreeStatementEnd());
            }
            int32 operation = TreeWord(update, 0);
            if ((operation != 86 && operation != 87)
                || semicolon && !Take(52, out var endUpdate))
            {
                return false;
            }
            return AddTreeStatement(10, 0, update, first.Range.Start, TreeStatementEnd());
        }

        return ParseTreeDeclaration(first, semicolon);
    }

    private mut bool ParseTreeDeclaration(Token first, bool semicolon)
    {
        mut bool mutable = false;
        mut bool initialization = false;
        mut bool inferredInitialization = false;
        mut bool constant = false;
        if (IsConstKeyword(first))
        {
            constant = true;
            _at = _at + 1;
        }
        else if (IsInitKeyword(first))
        {
            initialization = true;
            _at = _at + 1;
        }
        else if (first.Kind == 13)
        {
            mutable = true;
            _at = _at + 1;
        }
        require _tokens.TryGet(_at, out var declaredType);
        mut int32 type = 0;
        if (constant && declaredType.Kind == 12)
        {
            FailAt(2, declaredType.Range);
            return false;
        }
        else if (initialization && declaredType.Kind == 12)
        {
            inferredInitialization = true;
            _at = _at + 1;
        }
        else if (!initialization && declaredType.Kind == 12)
        {
            _at = _at + 1;
        }
        else if (declaredType.Kind != 2)
        {
            FailAt(1, declaredType.Range);
            return false;
        }
        else if (!TryGetScalarType(declaredType, out type))
        {
            FailAt(2, declaredType.Range);
            return false;
        }
        else
        {
            _at = _at + 1;
        }
        if (!Take(2, out var name))
        {
            return false;
        }
        if (IsParameterName(name))
        {
            FailAt(4, name.Range);
            return false;
        }
        for (mut int32 local = 0; local < _localCount; local = local + 1)
        {
            if (!IsActiveLocal(local)) { continue; }
            int32 offset = 300 + local * 4;
            require SourceRange.TryCreate(Host.Frontend[offset + 2],
                Host.Frontend[offset + 3], out var oldName);
            Token previous = new Token(2, oldName);
            if (SameTokenSpelling(previous, name))
            {
                FailAt(4, name.Range);
                return false;
            }
        }
        return initialization
            ? ParseTreeVacantLocal(first, name, type, inferredInitialization, semicolon)
            : ParseTreeLocalInitializer(first, name, type, mutable, constant, semicolon);
    }

    private bool IsConstKeyword(Token token)
    {
        int32 at = token.Range.Start;
        return token.Kind == 2 && token.Range.Length == 5
            && Host.Source[at] == char16(99) && Host.Source[at + 1] == char16(111)
            && Host.Source[at + 2] == char16(110) && Host.Source[at + 3] == char16(115)
            && Host.Source[at + 4] == char16(116);
    }

    private bool IsInitKeyword(Token token)
    {
        int32 at = token.Range.Start;
        return token.Kind == 2 && token.Range.Length == 4
            && Host.Source[at] == char16(105) && Host.Source[at + 1] == char16(110)
            && Host.Source[at + 2] == char16(105) && Host.Source[at + 3] == char16(116);
    }

    private bool IsEnsureKeyword(Token token)
    {
        int32 at = token.Range.Start;
        return token.Kind == 2 && token.Range.Length == 6
            && Host.Source[at] == char16(101) && Host.Source[at + 1] == char16(110)
            && Host.Source[at + 2] == char16(115) && Host.Source[at + 3] == char16(117)
            && Host.Source[at + 4] == char16(114) && Host.Source[at + 5] == char16(101);
    }

    private bool IsParameterName(Token name)
