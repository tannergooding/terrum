    private int32 TreeStatementKind(int32 index)
    {
        int32 kind = TreeStatementWord(index, 0);
        if (kind == 16) { return 3; }
        if (kind >= 17 && kind <= 18) { return kind - 6; }
        if (kind >= 19 && kind <= 20) { return kind - 13; }
        return kind;
