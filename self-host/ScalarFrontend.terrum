                }
                require _tokens.TryGet(_at - 1, out var close);
                end = close.Range.End;
            }
            else
            {
                if (!Take(48, out var openFalse)
                    || !AddTreeStatement(5, 0, -1, otherwise.Range.Start, openFalse.Range.End)
                    || !ParseTreeStructuredBody(depth + 1, nearestLoop)
                    || !Take(49, out var endFalse))
                {
                    return false;
                }
                end = endFalse.Range.End;
            }
            FinishTreeBody(marker, enclosingLocals, end);
        }
        Host.Frontend[332 + header * 5 + 4] = end - keyword.Range.Start;
        return true;
    }

    private mut bool ParseTreeTryFinally(int32 depth, int32 nearestLoop)
    {
        if (depth >= 6 || _statementCount >= 12)
        {
            Fail(1);
            return false;
        }
        if (!Take(42, out var keyword) || !Take(48, out var openBody))
        {
            return false;
        }
        int32 header = _statementCount;
        int32 enclosingLocals = _activeLocals;
        if (!AddTreeStatement(29, 0, -1, keyword.Range.Start, openBody.Range.End)
            || !ParseTreeStructuredBody(depth + 1, nearestLoop)
            || !Take(49, out var endBody))
        {
            return false;
        }
        FinishTreeBody(header, enclosingLocals, endBody.Range.End);
        if (_tokens.TryGet(_at, out var following) && following.Kind == 43)
        {
            Host.Frontend[332 + header * 5] = 32;
            int32 marker = _statementCount;
            if (_statementCount >= 12 || !Take(43, out var catchKeyword)
                || !Take(48, out var openCatch))
            {
                return false;
            }
            if (!AddTreeStatement(33, 0, -1, catchKeyword.Range.Start, openCatch.Range.End)
                || !ParseTreeStructuredBody(depth + 1, nearestLoop)
                || !Take(49, out var endCatch))
            {
                return false;
            }
            FinishTreeBody(marker, enclosingLocals, endCatch.Range.End);
            if (_tokens.TryGet(_at, out var followingCleanup) && followingCleanup.Kind == 44)
            {
                if (_statementCount >= 12
                    || !Take(44, out var finallyKeyword)
                    || !Take(48, out var openCleanup))
                {
                    return false;
                }
                int32 cleanup = _statementCount;
                if (!AddTreeStatement(34, 0, -1, finallyKeyword.Range.Start, openCleanup.Range.End)
                    || !ParseTreeStructuredBody(depth + 1, nearestLoop)
                    || !Take(49, out var endCleanup))
                {
                    return false;
                }
                FinishTreeBody(cleanup, enclosingLocals, endCleanup.Range.End);
                Host.Frontend[332 + header * 5 + 4] = endCleanup.Range.End - keyword.Range.Start;
                return true;
            }
            Host.Frontend[332 + header * 5 + 4] = endCatch.Range.End - keyword.Range.Start;
            return true;
        }
        if (_statementCount >= 12
            || !Take(44, out var finallyKeyword)
            || !Take(48, out var openCleanup))
        {
            return false;
        }
        int32 cleanup = _statementCount;
        if (!AddTreeStatement(30, 0, -1, finallyKeyword.Range.Start, openCleanup.Range.End)
            || !ParseTreeStructuredBody(depth + 1, nearestLoop)
            || !Take(49, out var endCleanup))
        {
            return false;
        }
        FinishTreeBody(cleanup, enclosingLocals, endCleanup.Range.End);
        Host.Frontend[332 + header * 5 + 4] = endCleanup.Range.End - keyword.Range.Start;
        return true;
    }

    private mut bool ParseTreeUnsafe(int32 depth, int32 nearestLoop)
    {
        if (depth >= 6 || _statementCount >= 12)
        {
            Fail(1);
            return false;
        }
        if (!Take(76, out var keyword) || !Take(48, out var openBody))
        {
            return false;
        }
        int32 header = _statementCount;
        int32 enclosingLocals = _activeLocals;
        if (!AddTreeStatement(31, 0, -1, keyword.Range.Start, openBody.Range.End)
            || !ParseTreeStructuredBody(depth + 1, nearestLoop)
            || !Take(49, out var endBody))
        {
            return false;
        }
        FinishTreeBody(header, enclosingLocals, endBody.Range.End);
        Host.Frontend[332 + header * 5 + 4] = endBody.Range.End - keyword.Range.Start;
        return true;
    }

    private mut bool ParseTreeWhile(int32 depth, int32 label)
    {
        if (depth >= 6 || _statementCount >= 12)
        {
            Fail(1);
            return false;
        }
        if (!Take(18, out var keyword) || !ParseTreeCondition(out var condition)
            || !Take(48, out var body))
        {
            return false;
        }
        int32 header = _statementCount;
        int32 enclosingLocals = _activeLocals;
        int32 start = label == -1 ? keyword.Range.Start : label;
        if (!AddTreeStatement(label == -1 ? 3 : 16, 0, condition, start, body.Range.End))
        {
            return false;
        }
        if (!ParseTreeStructuredBody(depth + 1, header) || !Take(49, out var end))
        {
            return false;
        }
        FinishTreeBody(header, enclosingLocals, end.Range.End);
        return true;
    }

    private mut bool ParseTreeStaticProof(int32 depth)
    {
        if (!Take(10, out var keyword) || !_tokens.TryGet(_at, out var proofKeyword))
        {
            return false;
        }
        mut int32 kind = 35;
        if (proofKeyword.Kind == 41)
        {
            _at = _at + 1;
        }
        else if (IsEnsureKeyword(proofKeyword))
        {
            if (depth != 0)
            {
                FailAt(1, proofKeyword.Range);
                return false;
            }
            kind = 36;
            _at = _at + 1;
        }
        else
        {
            FailAt(1, proofKeyword.Range);
            return false;
        }
        if (!ParseTreeExpression(5, 1, 0, out var condition)
            || TreeWord(condition, 1) != 5
            || !Take(52, out var semicolon))
        {
            return false;
        }
        _hasStructuredStatement = true;
        return AddTreeStatement(kind, 0, condition, keyword.Range.Start, semicolon.Range.End);
    }

    private mut bool ParseTreeDo(int32 depth, int32 label)
    {
        if (depth >= 6 || _statementCount >= 12)
        {
            Fail(1);
            return false;
        }
        if (!Take(83, out var keyword) || !Take(48, out var body))
        {
            return false;
        }
        int32 header = _statementCount;
        int32 enclosingLocals = _activeLocals;
        int32 start = label == -1 ? keyword.Range.Start : label;
        if (!AddTreeStatement(label == -1 ? 11 : 17, 0, -1, start, body.Range.End)
            || !ParseTreeStructuredBody(depth + 1, header)
            || !Take(49, out var closeBody))
        {
            return false;
        }
        FinishTreeBody(header, enclosingLocals, closeBody.Range.End);
        if (!Take(18, out var keywordWhile) || !ParseTreeCondition(out var condition)
            || !Take(52, out var semicolon))
        {
            return false;
        }
        Host.Frontend[332 + header * 5 + 2] = condition;
        Host.Frontend[332 + header * 5 + 4] = semicolon.Range.End - start;
        return true;
    }

    private mut bool ParseTreeCondition(out int32 condition)
    {
        condition = -1;
        if (!Take(46, out var open) || !ParseTreeExpression(5, 1, 0, out condition))
        {
            return false;
        }
        if (TreeWord(condition, 1) != 5)
        {
            return FailTreeType(condition);
        }
        return Take(47, out var close);
    }

    private mut bool ParseTreeFor(int32 depth, int32 label)
    {
        if (depth >= 6 || _statementCount + 3 > 12)
        {
            Fail(1);
            return false;
        }
        if (!Take(31, out var keyword) || !Take(46, out var open))
        {
            return false;
        }
        int32 header = _statementCount;
        int32 enclosingLocals = _activeLocals;
        int32 start = label == -1 ? keyword.Range.Start : label;
        if (!AddTreeStatement(label == -1 ? 12 : 18, 0, -1, start, open.Range.End)
            || !ParseTreeForClause(true) || !Take(52, out var firstEnd))
        {
            return false;
        }
        require _tokens.TryGet(_at, out var next);
        if (next.Kind != 52)
        {
            if (!ParseTreeExpression(5, 1, 0, out var condition))
            {
                return false;
            }
            if (TreeWord(condition, 1) != 5)
            {
                return FailTreeType(condition);
            }
            Host.Frontend[332 + header * 5 + 2] = condition;
        }
        if (!Take(52, out var secondEnd) || !ParseTreeForClause(false)
            || !Take(47, out var close) || !Take(48, out var body)
            || !ParseTreeStructuredBody(depth + 1, header)
            || !Take(49, out var end))
        {
            return false;
        }
        FinishTreeBody(header, enclosingLocals, end.Range.End);
        return true;
    }

    private mut void FinishTreeBody(int32 header, int32 enclosingLocals, int32 end)
    {
        _activeLocals = enclosingLocals;
        int32 offset = 332 + header * 5;
        Host.Frontend[offset + 1] = _statementCount;
        Host.Frontend[offset + 4] = end - Host.Frontend[offset + 3];
    }

    private int32 TreePrecedence(int32 kind)
    {
        if (kind >= 59 && kind <= 61) { return 10; }
        if (kind >= 88 && kind <= 90) { return 8; }
        if (kind == 57 || kind == 58) { return 9; }
        if (kind >= 67 && kind <= 70) { return 7; }
        if (kind == 65 || kind == 66) { return 6; }
        if (kind == 71) { return 5; }
        if (kind == 75) { return 4; }
        if (kind == 73) { return 3; }
        if (kind == 72) { return 2; }
        if (kind == 74) { return 1; }
        return 0;
    }

    private mut bool ResolveTreeLiteral(int32 node, int32 type, bool minimum)
    {
        int32 offset = 42 + node * 8;
        int32 operation = TreeWord(node, 0);
        if (operation == 84 && TreeWord(node, 1) == 0)
        {
            if (!ResolveTreeLiteral(TreeWord(node, 5), type, false)
                || !ResolveTreeLiteral(TreeWord(node, 6), type, false))
            {
                return false;
            }
            Host.Frontend[offset + 1] = type;
            return true;
        }
        if (operation == 3)
        {
            int32 start = TreeWord(node, 2);
            mut int32 tokenIndex = 0;
            while (_tokens.TryGet(tokenIndex, out var token)
                && token.Range.Start != start)
            {
                tokenIndex = tokenIndex + 1;
            }
            if (!_tokens.TryGet(tokenIndex, out var literal)
                || literal.Kind != 3
                || !TryReadMagnitude(literal, tokenIndex, type, minimum,
                    literal.Range, out var low, out var high))
            {
                return false;
            }
            Host.Frontend[offset + 1] = type;
            Host.Frontend[offset + 6] = low;
            Host.Frontend[offset + 7] = high;
            return true;
        }
        if (operation == 46 && TreeWord(node, 1) == 0)
        {
            if (!ResolveTreeLiteral(TreeWord(node, 4), type, false))
            {
                return false;
            }
            Host.Frontend[offset + 1] = type;
            return true;
        }
        if ((operation >= 57 && operation <= 61
                || operation >= 88 && operation <= 90
                || operation == 71 || operation == 73 || operation == 75)
            && TreeWord(node, 5) >= 0 && TreeWord(node, 1) == 0)
        {
            if (type < 1 || type > 4)
            {
                return FailTreeType(node);
            }
            if (!ResolveTreeLiteral(TreeWord(node, 4), type, false)
                || !ResolveTreeLiteral(TreeWord(node, 5),
                    operation >= 88 && operation <= 90 ? 1 : type, false))
            {
                return false;
            }
            Host.Frontend[offset + 1] = type;
            return true;
        }
        if ((operation == 57 || operation == 58 || operation == 63)
            && TreeWord(node, 1) == 0)
        {
            if (operation == 58 && type != 1 && type != 3)
            {
                require SourceRange.TryCreate(TreeWord(node, 2), 1, out var sign);
                FailAt(2, sign);
                return false;
            }
            if (!ResolveTreeLiteral(TreeWord(node, 4), type,
                operation == 58 && TreeWord(TreeWord(node, 4), 0) == 3))
            {
                return false;
            }
            Host.Frontend[offset + 1] = type;
            return true;
        }
        if (TreeWord(node, 1) != type)
        {
            return FailTreeType(node);
        }
        return true;
    }

    private mut bool FailTreeType(int32 node)
    {
        require SourceRange.TryCreate(TreeWord(node, 2),
            TreeWord(node, 3), out var span);
        FailAt(2, span);
        return false;
    }

    private mut bool ParseTreeSelfCall(Token functionName, int32 depth, out int32 node)
    {
        if (_functionReturnType == 0 || !SameTokenSpelling(_function, functionName)
            || IsParameterName(functionName))
        {
            FailAt(1, functionName.Range);
            return false;
        }
        for (mut int32 local = 0; local < _localCount; local = local + 1)
        {
            if (!IsActiveLocal(local)) { continue; }
            int32 offset = 300 + local * 4;
            require SourceRange.TryCreate(Host.Frontend[offset + 2],
                Host.Frontend[offset + 3], out var localName);
            if (SameTokenSpelling(new Token(2, localName), functionName))
            {
                FailAt(1, functionName.Range);
                return false;
            }
        }
        require _tokens.TryGet(_at + 1, out var opening);
        if (!TokensAttach(functionName, opening))
        {
            FailAt(1, opening.Range);
            return false;
        }
        _at = _at + 2;
        mut int32 first = -1;
        mut int32 second = -1;
        mut int32 third = -1;
        for (mut int32 ordinal = 0; ordinal < _parameterCount; ordinal = ordinal + 1)
        {
            if (ordinal != 0 && !Take(53, out var comma))
            {
                return false;
            }
            mut int32 expectedType = _firstType;
            if (ordinal == 1) { expectedType = _secondType; }
            if (ordinal == 2) { expectedType = _thirdType; }
            mut int32 argument = -1;
            if (IsOutParameter(ordinal + 1))
            {
                if (!Take(15, out var outputKeyword)
                    || !_tokens.TryGet(_at, out var outputTarget))
                {
                    return false;
                }
                mut int32 operation = 103;
                mut int32 slot = -1;
                mut int32 type = 0;
                mut SourceRange outputRange = outputTarget.Range;
                mut bool writable = false;
                if (outputTarget.Kind == 12)
                {
                    if (!Take(12, out var variableKeyword)
                        || !Take(2, out var outputName)
                        || !ParseTreeOutLocal(outputName, expectedType, out slot))
                    {
                        return false;
                    }
                    operation = 104;
                    type = expectedType;
                    outputRange = outputName.Range;
                    writable = true;
                }
                else
                {
                    if (!Take(2, out var outputName)
                        || !TryResolveParameter(outputName, out slot, out type))
                    {
                        return false;
                    }
                    outputRange = outputName.Range;
                    if (slot <= _parameterCount)
                    {
                        writable = IsOutParameter(slot);
                    }
                    else
                    {
                        int32 flags = Host.Frontend[300 + (slot - _parameterCount - 1) * 4 + 1];
                        writable = (flags & 1) != 0;
                    }
                }
                if (type != expectedType || !writable)
                {
                    FailAt(2, outputRange);
                    return false;
                }
                if (!AddTreeNode(operation, expectedType, outputKeyword.Range.Start,
                    outputRange.End,
                    slot, -1, 0, 0, out argument))
                {
                    return false;
                }
            }
            else if (!ParseTreeExpression(expectedType, 1, depth + 1, out argument))
            {
                return false;
            }
            else if (TreeWord(argument, 1) != expectedType)
            {
                node = -1;
                FailTreeType(argument);
                return false;
            }
            if (ordinal == 0) { first = argument; }
            else if (ordinal == 1) { second = argument; }
            else { third = argument; }
        }
        if (!Take(47, out var close))
        {
            return false;
        }
        return AddTreeNode(102, _functionReturnType, functionName.Range.Start,
            close.Range.End, first, second, third, _parameterCount, out node);
    }

    private mut bool ParseTreeOutLocal(Token name, int32 type, out int32 slot)
    {
        slot = -1;
        if (_localCount >= 8 || IsParameterName(name))
        {
            FailAt(1, name.Range);
            return false;
        }
        for (mut int32 local = 0; local < _localCount; local = local + 1)
        {
            if (!IsActiveLocal(local)) { continue; }
            int32 offset = 300 + local * 4;
            require SourceRange.TryCreate(Host.Frontend[offset + 2],
                Host.Frontend[offset + 3], out var localName);
            if (SameTokenSpelling(new Token(2, localName), name))
            {
                FailAt(1, name.Range);
                return false;
            }
        }
        int32 index = _localCount;
        int32 offset = 300 + index * 4;
        Host.Frontend[offset] = type;
        Host.Frontend[offset + 1] = 0;
        Host.Frontend[offset + 2] = name.Range.Start;
        Host.Frontend[offset + 3] = name.Range.Length;
        _localCount = index + 1;
        Host.Frontend[299] = _localCount;
        mut int32 bit = 1;
        for (mut int32 local = 0; local < index; local = local + 1)
        {
            bit = bit * 2;
        }
        _activeLocals = _activeLocals | bit;
        slot = _parameterCount + index + 1;
        return true;
    }

    private mut bool ParseTreePrefix(int32 expected, int32 depth, out int32 node)
    {
        if (depth >= 16)
        {
            Fail(1);
            return false;
        }
        require _tokens.TryGet(_at, out var token);
        if (token.Kind == 2
            && _tokens.TryGet(_at + 1, out var opening)
            && opening.Kind == 46)
        {
            if (!TokensAttach(token, opening))
            {
                FailAt(1, opening.Range);
                return false;
            }
            if (!TryGetScalarType(token, out var target)
                || target == 5)
            {
                if (SameTokenSpelling(_function, token))
                {
                    return ParseTreeSelfCall(token, depth, out node);
                }
                FailAt(1, token.Range);
                return false;
            }
            if (SameTokenSpelling(_function, token) || IsParameterName(token))
            {
                FailAt(1, token.Range);
                return false;
            }
            for (mut int32 local = 0; local < _localCount; local = local + 1)
            {
                if (!IsActiveLocal(local)) { continue; }
                int32 offset = 300 + local * 4;
                require SourceRange.TryCreate(Host.Frontend[offset + 2],
                    Host.Frontend[offset + 3], out var name);
                if (SameTokenSpelling(new Token(2, name), token))
                {
                    FailAt(1, token.Range);
                    return false;
                }
            }
            _at = _at + 2;
            // Resolve destination context only after the operand's own type is known.
            // A conditional predicate does not establish the type of its result arms.
            if (!ParseTreeExpression(0, 1, depth + 1, out var operand)
                || (TreeWord(operand, 1) == 0
                    && !ResolveTreeLiteral(operand, target, false))
                || !Take(47, out var close))
            {
                return false;
            }
            int32 sourceType = TreeWord(operand, 1);
            if (sourceType == 5 || sourceType == 0)
            {
                FailTreeType(operand);
                return false;
            }
            return AddTreeNode(83, target, token.Range.Start, close.Range.End,
                operand, -1, 0, 0, out node);
        }
        if (token.Kind == 46)
        {
            _at = _at + 1;
            if (!ParseTreeExpression(expected, 1, depth + 1, out var inner)
                || !Take(47, out var close))
            {
                return false;
            }
            if (!AddTreeNode(46, TreeWord(inner, 1), token.Range.Start,
                close.Range.End, inner, -1, 0, 0, out var grouped))
            {
                return false;
            }
            if (_tokens.TryGet(_at, out var update)
                && (update.Kind == 86 || update.Kind == 87))
            {
                _at = _at + 1;
                if (!TryTreeUpdatePlace(grouped))
                {
                    return false;
                }
                return AddTreeNode(update.Kind, TreeWord(grouped, 1),
                    token.Range.Start, update.Range.End,
                    grouped, -1, 0, 0, out node);
            }
            node = grouped;
            return true;
        }
        if (token.Kind == 86 || token.Kind == 87)
        {
            _at = _at + 1;
            if (!ParseTreePrefix(0, depth + 1, out var place)
                || !TryTreeUpdatePlace(place))
            {
                return false;
            }
            return AddTreeNode(token.Kind, TreeWord(place, 1), token.Range.Start,
                TreeWord(place, 2) + TreeWord(place, 3), place, -1, 1, 0, out node);
        }
        if (token.Kind == 57 || token.Kind == 58 || token.Kind == 62
            || token.Kind == 63)
        {
            _at = _at + 1;
            mut int32 operandExpected = expected;
            if (token.Kind == 62) { operandExpected = 5; }
            if (token.Kind != 62 && expected == 5)
            {
                operandExpected = 0;
            }
            if (token.Kind == 58
                && _tokens.TryGet(_at, out var directlySigned)
                && directlySigned.Kind == 3)
            {
                operandExpected = 0;
            }
            if (!ParseTreePrefix(operandExpected, depth + 1, out var operand))
            {
                return false;
            }
            mut int32 type = TreeWord(operand, 1);
            if (type == 0 && expected != 0 && expected != 5)
            {
                if (!ResolveTreeLiteral(operand, expected,
                    token.Kind == 58 && TreeWord(operand, 0) == 3))
                {
                    return false;
                }
                type = expected;
            }
            if ((token.Kind == 62 && type != 5)
                || (token.Kind == 63 && type != 0 && (type < 1 || type > 4))
                || ((token.Kind == 57 || token.Kind == 58)
                    && type != 0 && (type < 1 || type > 4
                        || (token.Kind == 58 && type != 1 && type != 3))))
            {
                FailAt(2, token.Range);
                return false;
            }
            return AddTreeNode(token.Kind, type, token.Range.Start,
                TreeWord(operand, 2) + TreeWord(operand, 3),
                operand, -1, 0, 0, out node);
        }
        _at = _at + 1;
        if (token.Kind == 2)
        {
            if (!TryResolveParameter(token, out var parameter, out var type))
            {
                return false;
            }
            if (type == 0)
            {
                FailAt(2, token.Range);
                return false;
            }
            if (!AddTreeNode(0, type, token.Range.Start, token.Range.End,
                parameter, -1, 0, 0, out var read))
            {
                return false;
            }
            if (_tokens.TryGet(_at, out var update)
                && (update.Kind == 86 || update.Kind == 87))
            {
                _at = _at + 1;
                if (!TryTreeUpdatePlace(read))
                {
                    return false;
                }
                return AddTreeNode(update.Kind, type, token.Range.Start,
                    update.Range.End, read, -1, 0, 0, out node);
            }
            node = read;
            return true;
        }
        if (token.Kind == 20 || token.Kind == 21)
        {
            return AddTreeNode(token.Kind, 5, token.Range.Start, token.Range.End,
                -1, -1, 0, 0, out node);
        }
        if (token.Kind == 3)
        {
            mut int32 type = expected;
            mut int32 low = 0;
            mut int32 high = 0;
            if (type != 0 && type != 5
                && !TryReadMagnitude(token, _at - 1, type, false,
                    token.Range, out low, out high))
            {
                return false;
            }
            if (type == 5) { type = 0; }
            return AddTreeNode(3, type, token.Range.Start, token.Range.End,
                -1, -1, low, high, out node);
        }
        FailAt(1, token.Range);
        return false;
    }

    private mut bool ParseTreeExpression(int32 expected, int32 precedence,
        int32 depth, out int32 node)
    {
        mut int32 left = 0;
        if (!ParseTreePrefix(expected, depth, out left))
        {
            return false;
        }
        while (_tokens.TryGet(_at, out var operation)
            && TreePrecedence(operation.Kind) >= precedence
            && TreePrecedence(operation.Kind) != 0)
        {
            int32 rank = TreePrecedence(operation.Kind);
            _at = _at + 1;
            mut int32 leftType = TreeWord(left, 1);
            bool shift = operation.Kind >= 88 && operation.Kind <= 90;
            mut int32 rightContext = shift ? 1 : leftType;
            if (operation.Kind >= 65 && operation.Kind <= 70
                && leftType == 0)
            {
                rightContext = 0;
            }
            if (!ParseTreeExpression(rightContext, rank + 1, depth + 1, out var right))
            {
                return false;
            }
            mut int32 rightType = TreeWord(right, 1);
            if (!shift && leftType == 0 && rightType != 0
                && !ResolveTreeLiteral(left, rightType, false))
            {
                return false;
            }
            if (rightType == 0 && (shift || leftType != 0)
                && !ResolveTreeLiteral(right, shift ? 1 : leftType, false))
            {
                return false;
            }
            if (leftType == 0) { leftType = TreeWord(left, 1); }
            if (rightType == 0) { rightType = TreeWord(right, 1); }
            if (leftType == 0 && rightType == 0 && !shift)
            {
                mut int32 context = expected;
                if (context == 5 || context == 0)
                {
                    if (operation.Kind >= 57 && operation.Kind <= 61
                        || operation.Kind == 71 || operation.Kind == 73
                        || operation.Kind == 75)
                    {
                        context = 0;
                    }
                    else
                    {
                        FailAt(2, operation.Range);
                        return false;
                    }
                }
                if (context != 0 && (!ResolveTreeLiteral(left, context, false)
                    || !ResolveTreeLiteral(right, context, false)))
                {
                    return false;
                }
                leftType = context;
                rightType = context;
            }
            bool comparison = operation.Kind >= 65 && operation.Kind <= 70;
            bool logical = operation.Kind == 72 || operation.Kind == 74;
            bool bitwise = operation.Kind == 71 || operation.Kind == 73
                || operation.Kind == 75;
            if ((shift ? (leftType != 0 && (leftType < 1 || leftType > 4)
                    || rightType != 1) : leftType != rightType)
                || (logical && leftType != 5)
                || (comparison && leftType == 6 && operation.Kind >= 67)
                || (comparison && leftType == 5 && operation.Kind >= 67)
                || (bitwise && leftType == 6)
                || (!logical && !bitwise && !comparison
                    && leftType != 0 && (leftType < 1 || leftType > 4)))
            {
                FailAt(2, operation.Range);
                return false;
            }
            mut int32 type = leftType;
            if (comparison) { type = 5; }
            if (!AddTreeNode(operation.Kind, type, TreeWord(left, 2),
                TreeWord(right, 2) + TreeWord(right, 3),
                left, right, 0, 0, out var binary))
            {
                return false;
            }
            left = binary;
        }
        if (precedence == 1 && _tokens.TryGet(_at, out var question)
            && question.Kind == 56)
        {
            if (TreeWord(left, 1) != 5)
            {
                FailTreeType(left);
                return false;
            }
            _at = _at + 1;
            mut int32 armContext = expected;
            if (armContext == 5) { armContext = 0; }
            if (!ParseTreeExpression(armContext, 1, depth + 1, out var whenTrue)
                || !Take(55, out var colon))
            {
                return false;
            }
            int32 trueType = TreeWord(whenTrue, 1);
            mut int32 falseContext = armContext;
            if (falseContext == 0) { falseContext = trueType; }
            if (!ParseTreeExpression(falseContext, 1, depth + 1, out var whenFalse))
            {
                return false;
            }
            int32 falseType = TreeWord(whenFalse, 1);
            mut int32 resultType = armContext;
            if (resultType == 0)
            {
                if (trueType != 0 && falseType != 0 && trueType != falseType)
                {
                    FailTreeType(whenFalse);
                    return false;
                }
                if (trueType != 0) { resultType = trueType; }
                else { resultType = falseType; }
            }
            if (resultType != 0
                && (!ResolveTreeLiteral(whenTrue, resultType, false)
                    || !ResolveTreeLiteral(whenFalse, resultType, false)))
            {
                return false;
            }
            if (!AddTreeNode(84, resultType, TreeWord(left, 2),
                TreeWord(whenFalse, 2) + TreeWord(whenFalse, 3),
                left, whenTrue, whenFalse, 0, out var conditional))
            {
                return false;
            }
            left = conditional;
        }
        node = left;
        return true;
    }

    private int32 UngroupTree(int32 node)
    {
        mut int32 read = node;
        while (TreeWord(read, 0) == 46) { read = TreeWord(read, 4); }
        return read;
    }

    private mut bool TryTreeUpdatePlace(int32 node)
    {
        int32 read = UngroupTree(node);
        int32 slot = TreeWord(read, 4);
        if (TreeWord(read, 0) != 0
            || (slot <= _parameterCount
                ? !IsOutParameter(slot)
                : Host.Frontend[300 + (slot - _parameterCount - 1) * 4 + 1] != 1)
            || TreeWord(read, 1) < 1 || TreeWord(read, 1) > 4
            )
        {
            return FailTreeType(node);
        }
        return true;
    }

    private mut bool ParseTreeTerminatedExpression(int32 kind, int32 type, out int32 root)
    {
        if (!Take(kind, out var keyword)
            || !ParseTreeExpression(type, 1, 0, out var expression))
        {
            return false;
        }
        if (!ResolveTreeLiteral(expression, type, false))
        {
            root = -1;
            return FailTreeType(expression);
        }
        if (!Take(52, out var semicolon))
        {
            return false;
        }
        root = expression;
        return true;
    }

    public mut bool TryParseTree(out ScalarFrontendResult result)
    {
        require SourceRange.TryCreate(0, 0, out var empty);
        require ScalarFrontendExpression.TryCreate(0, 0, 0, 0, empty, out var absent);
        mut SourceRange name = empty;
        mut int32 returnType = 0;
        mut bool hasCondition = false;
        mut bool hasFallthrough = false;
        mut int32 condition = -1;
        mut int32 whenTrue = -1;
        mut int32 whenFalse = -1;
        mut bool expressionBody = false;
        if (ParseHeader(out var selected, out var foundName))
        {
            returnType = selected;
            name = foundName;
            require _tokens.TryGet(_at, out var body);
            if (body.Kind == 82)
            {
                expressionBody = true;
                _at = _at + 1;
                if (ParseTreeExpression(returnType, 1, 0, out var root))
                {
                    if (!ResolveTreeLiteral(root, returnType, false))
                    {
                        require SourceRange.TryCreate(TreeWord(root, 2),
                            TreeWord(root, 3), out var mismatch);
                        FailAt(2, mismatch);
                    }
                    whenTrue = root;
                }
                if (_error == 0) { Take(52, out var semicolon); }
            }
            else if (Take(48, out var openBody))
            {
                require _tokens.TryGet(_at, out var firstStatement);
                mut Token next = firstStatement;
                while ((next.Kind == 12 || next.Kind == 13
                    || next.Kind == 2 || next.Kind == 18 || next.Kind == 16)
                    && _error == 0)
                {
                    if (next.Kind == 16)
                    {
                        mut int32 cursor = _at + 1;
                        require _tokens.TryGet(cursor, out var firstProbe);
                        mut Token probe = firstProbe;
                        while (probe.Kind != 0 && probe.Kind != 48)
                        {
                            cursor = cursor + 1;
                            require _tokens.TryGet(cursor, out probe);
                        }
                        if (probe.Kind == 48
                            && _tokens.TryGet(cursor + 1, out var arm)
                            && arm.Kind == 19)
                        {
                            break;
                        }
                    }
                    mut bool parsed = false;
                    if (next.Kind == 18) { parsed = ParseTreeWhile(0, -1); }
                    else if (next.Kind == 16) { parsed = ParseTreeIf(0, -1); }
                    else { parsed = ParseTreeStatement(); }
                    if (!parsed)
                    {
                        break;
                    }
                    require _tokens.TryGet(_at, out next);
                }
                if (_error == 0 && next.Kind == 16)
                {
                    hasCondition = true;
                    _at = _at + 1;
                    if (Take(46, out var openCondition)
                        && ParseTreeExpression(5, 1, 0, out var predicate))
                    {
                        if (TreeWord(predicate, 1) != 5)
                        {
                            require SourceRange.TryCreate(TreeWord(predicate, 2),
                                TreeWord(predicate, 3), out var mismatch);
                            FailAt(2, mismatch);
                        }
                        condition = predicate;
                    }
                    if (_error == 0 && Take(47, out var closeCondition)
                        && Take(48, out var openTrue)
                        && ParseTreeTerminatedExpression(19, returnType, out var first)
                        && Take(49, out var closeTrue))
                    {
                        whenTrue = first;
                        require _tokens.TryGet(_at, out var following);
                        if (following.Kind == 17)
                        {
                            _at = _at + 1;
                            if (Take(48, out var openFalse)
                                && ParseTreeTerminatedExpression(19, returnType, out var second)
                                && Take(49, out var closeFalse))
                            {
                                whenFalse = second;
                            }
                        }
                        else if (ParseTreeTerminatedExpression(19, returnType, out var trailing))
                        {
                            whenFalse = trailing;
                            hasFallthrough = true;
                        }
                    }
                }
                else if (_error == 0 && ParseTreeTerminatedExpression(19, returnType, out var found))
                {
                    whenTrue = found;
                }
                if (_error == 0) { Take(49, out var closeBody); }
            }
            if (_error == 0 && Take(0, out var eof)
                && _at != _tokens.GetCount())
            {
                Fail(1);
            }
        }
        if (_error == 0)
        {
            for (mut int32 local = 0; local < _localCount; local = local + 1)
            {
                if (Host.Frontend[300 + local * 4] == 0)
                {
                    require SourceRange.TryCreate(Host.Frontend[302 + local * 4],
                        Host.Frontend[303 + local * 4], out var unresolved);
                    FailAt(2, unresolved);
                    break;
                }
            }
        }
        if (_error != 0)
        {
            for (mut int32 index = 37; index < Host.Frontend.Length; index = index + 1)
            {
                Host.Frontend[index] = 0;
            }
            return TryCreateScalarFrontendError(_error, _errorSpan, out result);
        }
        Host.Frontend[38] = condition;
        Host.Frontend[39] = whenTrue;
        Host.Frontend[40] = whenFalse;
        if (expressionBody) { Host.Frontend[41] = 1; }
        return ScalarFrontendResult.TryCreate(true, _isPublic, 0, empty,
            returnType, _parameterCount, _firstType, _secondType, _thirdType, _outParameterMask,
            name, _first.Range, _second.Range, _third.Range,
            hasCondition, hasFallthrough, absent, absent, absent, out result);
    }

    public mut bool TryParse(out ScalarFrontendResult result)
    {
        require SourceRange.TryCreate(0, 0, out var empty);
        require ScalarFrontendExpression.TryCreate(0, 0, 0, 0, empty, out var absent);
        mut SourceRange name = empty;
        mut int32 returnType = 0;
        mut bool hasCondition = false;
        mut bool hasFallthrough = false;
        mut ScalarFrontendExpression condition = absent;
        mut ScalarFrontendExpression whenTrue = absent;
        mut ScalarFrontendExpression whenFalse = absent;

        if (_tokens.GetCount() > 64)
        {
            Fail(1);
        }
        else if (ParseHeader(out var selectedReturnType, out var foundName)
            && Take(48, out var openBody))
        {
            returnType = selectedReturnType;
            name = foundName;
            require _tokens.TryGet(_at, out var bodyNext);
            if (bodyNext.Kind == 16)
            {
                hasCondition = true;
                _at = _at + 1;
                if (Take(46, out var openCondition)
                    && ParseExpression(5, out var predicate))
                {
                    if (predicate.Type != 5)
                    {
                        FailAt(2, predicate.Span);
                    }
                    else
                    {
                        condition = predicate;
                    }
                }
                if (_error == 0 && Take(47, out var closeCondition)
                    && Take(48, out var openTrue)
                    && ParseReturn(returnType, out var firstReturn)
                    && Take(49, out var closeTrue))
                {
                    whenTrue = firstReturn;
                    require _tokens.TryGet(_at, out var followingTrue);
                    if (followingTrue.Kind == 17)
                    {
                        _at = _at + 1;
                        if (Take(48, out var openFalse)
                            && ParseReturn(returnType, out var secondReturn)
                            && Take(49, out var closeFalse))
                        {
                            whenFalse = secondReturn;
                        }
                    }
                    else if (ParseReturn(returnType, out var trailingReturn))
                    {
                        whenFalse = trailingReturn;
                        hasFallthrough = true;
                    }
                }
            }
            else if (ParseReturn(returnType, out var found))
            {
                whenTrue = found;
            }
            if (_error == 0 && Take(49, out var closeBody)
                && Take(0, out var eof) && _at != _tokens.GetCount())
            {
                Fail(1);
            }
        }
        if (_error != 0)
        {
            return TryCreateScalarFrontendError(_error, _errorSpan, out result);
        }
        return ScalarFrontendResult.TryCreate(true, _isPublic, 0, empty, returnType, _parameterCount,
            _firstType, _secondType, _thirdType, _outParameterMask, name, _first.Range, _second.Range, _third.Range,
            hasCondition, hasFallthrough, condition, whenTrue, whenFalse, out result);
    }
}

bool TryCreateScalarFrontendError(int32 code, SourceRange span, out ScalarFrontendResult result)
{
    require SourceRange.TryCreate(0, 0, out var empty);
    require ScalarFrontendExpression.TryCreate(0, 0, 0, 0, empty, out var absent);
    return ScalarFrontendResult.TryCreate(false, false, code, span, 0, 0, 0, 0, 0,
        0, empty, empty, empty, empty, false, false, absent, absent, absent, out result);
}

bool TryParseScalarFrontend(TokenSnapshot tokens, out ScalarFrontendResult result)
{
    require SourceRange.TryCreate(0, 0, out var empty);
    int32 count = tokens.GetCount();
    if (count > 64)
    {
        require tokens.TryGet(64, out var excess);
        return TryCreateScalarFrontendError(1, excess.Range, out result);
    }
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return TryCreateScalarFrontendError(1, spacing, out result);
    }
    if (count < 1 || !ManagedTokenChain.TryCreate(out var chain))
    {
        return false;
    }
    // Validate numeric records only when present; scalar functions without
    // literals do not need a second owned snapshot.
    if (Host.IntegerValues[0] != 0
        && !TokenIntegerSnapshot.TryBuild(count, init var integers))
    {
        return false;
    }
    // Managed classes cannot own a unique snapshot; copy only validated token values
    // into the existing bounded chain, without rescanning source or integer text.
    for (mut int32 at = 0; at < count; at = at + 1)
    {
        require tokens.TryGet(at, out var token);
        require chain.TryAppend(token.Kind, token.Range.Start, token.Range.Length);
    }
    if (!ScalarFrontendState.TryCreate(chain, empty, out var state))
    {
        return false;
    }
    if (!state.TryParse(out var legacy))
    {
        return false;
    }
    if (legacy.IsValid && legacy.OutParameterMask == 0 && Host.Frontend[2] == 0)
    {
        result = legacy;
        return true;
    }
    if (!ScalarFrontendState.TryCreate(chain, empty, out var tree)
        || !tree.TryParseTree(out var modern))
    {
        return false;
    }
    if (modern.IsValid && CanPublishScalarFrontendTreeEnvelope())
    {
        result = modern;
        return true;
    }
    if (modern.IsValid)
    {
        for (mut int32 index = 37; index < Host.Frontend.Length; index = index + 1)
        {
            Host.Frontend[index] = 0;
        }
    }
    if (ScalarFrontendState.TryCreate(chain, empty, out var structured)
        && structured.TryParseStructuredReturns(out var completed))
    {
        if (completed.IsValid)
        {
            result = completed;
            return true;
        }
        if (structured.HasStructuredStatements())
        {
            result = completed;
            return true;
        }
        mut int32 bodyDepth = 0;
        mut int32 returnCount = 0;
        for (mut int32 index = 0; index < count; index = index + 1)
        {
            require chain.TryGet(index, out var token);
            if (token.Kind == 48) { bodyDepth = bodyDepth + 1; }
            if (token.Kind == 49) { bodyDepth = bodyDepth - 1; }
            if (token.Kind == 19)
            {
                returnCount = returnCount + 1;
                if (bodyDepth > 1 || returnCount > 1)
                {
                    result = completed;
                    return true;
                }
            }
        }
    }
    for (mut int32 index = 0; index < count; index = index + 1)
    {
        require chain.TryGet(index, out var token);
        if (IsScalarFrontendTreeMarker(token.Kind)
            || (token.Kind == 2 && chain.TryGet(index + 1, out var opener)
                && opener.Kind == 46 && TryGetScalarType(token, out var conversionType)))
        {
            result = modern;
            return true;
        }
    }
    result = legacy;
    return true;
}

bool IsScalarFrontendTreeMarker(int32 kind)
{
    if (kind == 82) { return true; }
    if (kind == 12) { return true; }
    if (kind == 13) { return true; }
    if (kind == 18) { return true; }
    if (kind == 16) { return true; }
    if (kind == 64) { return true; }
    return kind == 56;
}

bool CanPublishScalarFrontendTreeEnvelope()
{
    return Host.Frontend[2] == 0 || Host.Frontend[41] == 1;
}

// Isolate this legacy predicate to avoid repeated Boolean-tree walks within the
// unchanged shared source-verification budget.
bool IsScalarFrontendNegatableBinary(ScalarFrontendExpression expression, int32 operation,
    int32 group, int32 kind, int32 comparison)
{
    if (expression.Type != 5 || operation >= 2000) { return false; }
    if (operation >= 65 && operation <= 75
        && expression.LeftParameter >= 1 && expression.RightParameter >= 1)
    {
        return true;
    }
    if ((group == 7 || group == 9 || group == 11)
        && (kind == 65 || kind == 66 || (kind >= 71 && kind <= 75)))
    {
        return true;
    }
    return comparison / 100 >= 1 && comparison / 100 <= 4
        && comparison % 100 >= 65 && comparison % 100 <= 70;
}

bool TryScanScalarFrontend(out ScalarFrontendResult result)
{
    if (!TokenSnapshot.TryScan(init var tokens))
    {
        return false;
    }
    return TryParseScalarFrontend(move tokens, out result);
}

// Pack at most four validated UTF16 source units, first unit in the low16bits.
// Fixed caller lengths keep every read in the token and every shift below64.
uint64 ScalarFrontendSourceUnits(int32 start, int32 count)
{
    mut uint64 units = 0;
    for (mut int32 index = 0; index < count; index = index + 1)
    {
        units = units | (uint64(Host.Source[start + index]) << (index * 16));
    }
    return units;
}

// Exact UTF16 packing retains case and rejects escapes; these are not name identities.
int32 ScalarFrontendEffect(Token token)
{
    int32 at = token.Range.Start;
    if (token.Range.Length == 7)
    {
        // "NoTh", "row".
        if (ScalarFrontendSourceUnits(at, 4) != uint64(0x00680054006F004E)) { return 0; }
        if (ScalarFrontendSourceUnits(at + 4, 3) != uint64(0x0077006F0072)) { return 0; }
        return 2;
    }
    if (token.Range.Length == 13)
    {
        // "Does", "NotR", "etur", "n".
        if (ScalarFrontendSourceUnits(at, 4) != uint64(0x00730065006F0044)) { return 0; }
        if (ScalarFrontendSourceUnits(at + 4, 4) != uint64(0x00520074006F004E)) { return 0; }
        if (ScalarFrontendSourceUnits(at + 8, 4) != uint64(0x0072007500740065)) { return 0; }
        if (Host.Source[at + 12] != char16(110)) { return 0; }
        return 4;
    }
    return 0;
}
