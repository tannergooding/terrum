    private int32 TreeWord(int32 node, int32 field)
    {
        return Host.Frontend[42 + node * 8 + field];
    }

    private mut bool AddTreeNode(int32 operation, int32 type, int32 start, int32 end,
        int32 left, int32 right, int32 low, int32 high, out int32 node)
    {
        int32 count = Host.Frontend[37];
        if (count >= 32)
        {
            Fail(1);
            return false;
        }
        node = count;
        int32 offset = 42 + count * 8;
        Host.Frontend[offset] = operation;
        Host.Frontend[offset + 1] = type;
        Host.Frontend[offset + 2] = start;
        Host.Frontend[offset + 3] = end - start;
        Host.Frontend[offset + 4] = left;
        Host.Frontend[offset + 5] = right;
        Host.Frontend[offset + 6] = low;
        Host.Frontend[offset + 7] = high;
        Host.Frontend[37] = count + 1;
        return true;
    }

    private mut bool AddTreeStatement(int32 kind, int32 slot, int32 root,
        int32 start, int32 end)
    {
        if (_statementCount >= 12)
        {
            Fail(1);
            return false;
        }
        int32 offset = 332 + _statementCount * 5;
        Host.Frontend[offset] = kind;
        Host.Frontend[offset + 1] = slot;
        Host.Frontend[offset + 2] = root;
        Host.Frontend[offset + 3] = start;
        Host.Frontend[offset + 4] = end - start;
        _statementCount = _statementCount + 1;
        Host.Frontend[298] = _statementCount;
        return true;
    }

    private mut bool ParseTreeStatement()
    {
        require _tokens.TryGet(_at, out var first);
        if (first.Kind == 2
            && _tokens.TryGet(_at + 1, out var equals)
            && equals.Kind == 64)
        {
            if (!TryResolveParameter(first, out var slot, out var type))
            {
                return false;
            }
            if (slot <= _parameterCount
                || Host.Frontend[300 + (slot - _parameterCount - 1) * 4 + 1] == 0)
            {
                FailAt(2, first.Range);
                return false;
            }
            _at = _at + 2;
            if (!ParseTreeExpression(type, 1, 0, out var value)
                || !ResolveTreeLiteral(value, type, false)
                || !Take(52, out var end))
            {
                return false;
            }
            return AddTreeStatement(2, slot, value, first.Range.Start, end.Range.End);
        }

        mut bool mutable = false;
        if (first.Kind == 13)
        {
            mutable = true;
            _at = _at + 1;
        }
        require _tokens.TryGet(_at, out var declaredType);
        mut int32 type = 0;
        if (declaredType.Kind == 12)
        {
            _at = _at + 1;
        }
        else if (declaredType.Kind != 2)
        {
            FailAt(1, declaredType.Range);
            return false;
        }
        else if (!TryGetScalarType(declaredType, out type))
        {
            FailAt(2, declaredType.Range);
            return false;
        }
        else
        {
            _at = _at + 1;
        }
        if (!Take(2, out var name))
        {
            return false;
        }
        if (_parameterCount > 0 && SameTokenSpelling(_first, name)
            || _parameterCount > 1 && SameTokenSpelling(_second, name)
            || _parameterCount > 2 && SameTokenSpelling(_third, name))
        {
            FailAt(4, name.Range);
            return false;
        }
        for (mut int32 local = 0; local < _localCount; local = local + 1)
        {
            int32 offset = 300 + local * 4;
            require SourceRange.TryCreate(Host.Frontend[offset + 2],
                Host.Frontend[offset + 3], out var oldName);
            Token previous = new Token(2, oldName);
            if (SameTokenSpelling(previous, name))
            {
                FailAt(4, name.Range);
                return false;
            }
        }
        if (_localCount >= 8)
        {
            FailAt(1, name.Range);
            return false;
        }
        if (!Take(64, out var assignment)
            || !ParseTreeExpression(type, 1, 0, out var initializer))
        {
            return false;
        }
        if (type == 0) { type = TreeWord(initializer, 1); }
        if (type == 0)
        {
            return FailTreeType(initializer);
        }
        if (!ResolveTreeLiteral(initializer, type, false)
            || !Take(52, out var endDeclaration))
        {
