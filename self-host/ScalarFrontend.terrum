        if (keyword.Kind == 18) { return ParseTreeWhile(depth, name.Range.Start); }
        if (keyword.Kind == 83) { return ParseTreeDo(depth, name.Range.Start); }
        if (keyword.Kind == 31) { return ParseTreeFor(depth, name.Range.Start); }
        FailAt(1, keyword.Range);
        return false;
    }

    private mut bool ParseTreeTransfer(Token keyword, int32 nearest)
    {
        _at = _at + 1;
