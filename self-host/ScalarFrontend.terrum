namespace Terrum.CodeAnalysis;

// Scanner-5 token ordinals. Invalid results publish no partial artifact:
// 1 = unsupported syntax/bound, 2 = type, 3 = unresolved name, 4 = duplicate name.
// Expressions preserve operator identities; later lowering must retain checked arithmetic.
// This in-process contract uses UTF-16 SourceRange values against the input source.
// Parameter slots are 1-based (0 means absent); Operation is 0 for a parameter
// reference or the scanner TokenKind ordinal for one binary operator or
// true/false literal (with no parameter slots). For a numeric literal,
// the parameter slots carry the low/high 32-bit words of its contextual
// magnitude; a leading minus is included in the expression span.
// Version-3 binary parameter/literal expressions add 100/200 to the operator
// for a parameter on the left, or 300/400 for one on the right (parameter 1/2).
// The two slots hold the literal's low/high magnitude words.
// Version-5 unary minus on that literal adds another 1200 to the operation.
// Version-6 unary plus on that literal adds another 1600.
// Version-7 grouped unary minus on a standalone literal uses operation 658.
// Boolean parameter/literal pairs add 700 for a parameter on the left or
// 900 for a literal on the left; slots hold the parameter index and literal kind.
// Boolean literal pairs add 1100; both slots hold literal kinds.
// An invalid
// result has only ErrorCode/ErrorSpan; all other fields, including visibility,
// are empty. A valid result is public only for an explicit public keyword. Lexical errors
// prevent snapshot publication and remain in TokenDiagnosticSnapshot.
public class ScalarFrontendExpression
{
    public int32 Type;
    public int32 Operation;
    public int32 LeftParameter;
    public int32 RightParameter;
    public SourceRange Span;

    public ScalarFrontendExpression(int32 type, int32 operation, int32 left,
        int32 right, SourceRange span)
    {
        Type = type;
        Operation = operation;
        LeftParameter = left;
        RightParameter = right;
        Span = span;
    }
}

public class ScalarFrontendResult
{
    public bool IsValid;
    public bool IsPublic;
    public int32 ErrorCode;
    public SourceRange ErrorSpan;
    public int32 ReturnType;
    public int32 ParameterCount;
    public int32 FirstType;
    public int32 SecondType;
    public SourceRange Name;
    public SourceRange FirstName;
    public SourceRange SecondName;
    public bool HasCondition;
    public bool HasFallthrough;
    public ScalarFrontendExpression Condition;
    public ScalarFrontendExpression WhenTrue;
    public ScalarFrontendExpression WhenFalse;

    public ScalarFrontendResult(bool valid, bool isPublic, int32 errorCode, SourceRange errorSpan,
        int32 returnType, int32 parameterCount, int32 firstType, int32 secondType,
        SourceRange name, SourceRange firstName, SourceRange secondName,
        bool hasCondition, bool hasFallthrough, ScalarFrontendExpression condition,
        ScalarFrontendExpression whenTrue, ScalarFrontendExpression whenFalse)
    {
        IsValid = valid;
        IsPublic = isPublic;
        ErrorCode = errorCode;
        ErrorSpan = errorSpan;
        ReturnType = returnType;
        ParameterCount = parameterCount;
        FirstType = firstType;
        SecondType = secondType;
        Name = name;
        FirstName = firstName;
        SecondName = secondName;
        HasCondition = hasCondition;
        HasFallthrough = hasFallthrough;
        Condition = condition;
        WhenTrue = whenTrue;
        WhenFalse = whenFalse;
    }
}

mut class ScalarFrontendState
{
    private ManagedTokenChain _tokens;
    private mut int32 _at;
    private mut int32 _error;
    private mut SourceRange _errorSpan;
    private mut Token _first;
    private mut Token _second;
    private mut int32 _firstType;
    private mut int32 _secondType;
    private mut int32 _parameterCount;
    private mut bool _isPublic;

    public ScalarFrontendState(ManagedTokenChain tokens, SourceRange empty)
    {
        _tokens = tokens;
        _at = 0;
        _error = 0;
        _errorSpan = empty;
        _first = new Token(2, empty);
        _second = new Token(2, empty);
        _firstType = 0;
        _secondType = 0;
        _parameterCount = 0;
        _isPublic = false;
    }

    private mut void FailAt(int32 code, SourceRange span)
    {
        if (_error == 0)
        {
            _error = code;
            _errorSpan = span;
        }
    }

    private mut void Fail(int32 code)
    {
        if (_tokens.TryGet(_at, out var token))
        {
            FailAt(code, token.Range);
        }
        else
        {
            require SourceRange.TryCreate(Host.Source.Length, 0, out var end);
            FailAt(code, end);
        }
    }

    private mut bool Take(int32 kind, out Token token)
    {
        if (!_tokens.TryGet(_at, out var current) || current.Kind != kind)
        {
            Fail(1);
            return false;
        }
        _at = _at + 1;
        token = current;
        return true;
    }

    private mut bool ParseParameter(out int32 type, out Token name)
    {
        if (!Take(2, out var typeToken))
        {
            return false;
        }
        if (!TryGetScalarType(typeToken, out var selected))
        {
            FailAt(2, typeToken.Range);
            return false;
        }
        if (!Take(2, out var parameter))
        {
            return false;
        }
        if (_parameterCount > 0 && SameTokenSpelling(_first, parameter))
        {
            FailAt(4, parameter.Range);
            return false;
        }
        type = selected;
        name = parameter;
        return true;
    }

    private mut bool TryReadMagnitude(Token token, int32 tokenIndex, int32 type,
        bool negative, SourceRange errorSpan, out int32 low, out int32 high)
    {
        mut int32 first = 0;
        mut int32 end = Host.IntegerValues[0];
        while (first < end)
        {
            int32 middle = first + (end - first) / 2;
            if (Host.IntegerValues[middle * 5 + 1] < tokenIndex)
            {
                first = middle + 1;
            }
            else
            {
                end = middle;
            }
        }
        if (first >= Host.IntegerValues[0]
            || Host.IntegerValues[first * 5 + 1] != tokenIndex
            || Host.IntegerValues[first * 5 + 2] != 0)
        {
            FailAt(2, errorSpan);
            return false;
        }
        int32 foundLow = Host.IntegerValues[first * 5 + 3];
        int32 foundHigh = Host.IntegerValues[first * 5 + 4];
        uint64 magnitude = DecodeScannerMagnitude(foundLow, foundHigh);
        bool based = IsBasedInteger(token);
        if ((type == 1 && (foundHigh != 0
            || (!based && magnitude > uint64(int32.MaxValue)
                && (!negative || magnitude != uint64(int32.MaxValue) + 1))))
            || (type == 2 && foundHigh != 0)
            || (type == 3 && !based
                && magnitude > uint64(int64.MaxValue)
                && (!negative || magnitude != uint64(int64.MaxValue) + 1))
            || (type == 6 && (foundHigh != 0 || magnitude > 65535))
            || (type != 1 && type != 2 && type != 3 && type != 4 && type != 6)
            || (negative && type != 1 && type != 3))
        {
            FailAt(2, errorSpan);
            return false;
        }
        low = foundLow;
        high = foundHigh;
        return true;
    }

    private mut bool TryResolveParameter(Token token, out int32 index, out int32 type)
    {
        if (_parameterCount > 0 && SameTokenSpelling(_first, token))
        {
            index = 1;
            type = _firstType;
            return true;
        }
        if (_parameterCount > 1 && SameTokenSpelling(_second, token))
        {
            index = 2;
            type = _secondType;
            return true;
        }
        FailAt(3, token.Range);
        return false;
    }

    private mut bool BeginUnaryOperand(out Token operand, out int32 groups)
    {
        require _tokens.TryGet(_at, out var first);
        mut Token current = first;
        groups = 0;
        while (current.Kind == 46)
        {
            _at = _at + 1;
            groups = groups + 1;
            require _tokens.TryGet(_at, out var nested);
            current = nested;
        }
        operand = current;
        return true;
    }

    private mut bool FinishUnaryOperand(Token operand, int32 groups, out int32 end)
    {
        _at = _at + 1;
        end = operand.Range.End;
        for (mut int32 index = 0; index < groups; index = index + 1)
        {
            if (!Take(47, out var close))
            {
                return false;
            }
            end = close.Range.End;
        }
        return true;
    }

    private mut bool ParseExpression(int32 expectedType, out ScalarFrontendExpression expression)
    {
        mut int32 depth = 0;
        require _tokens.TryGet(_at, out var first);
        mut Token next = first;
        while (next.Kind == 46 && !StartsGroupedBinary())
        {
            _at = _at + 1;
            depth = depth + 1;
            require _tokens.TryGet(_at, out var afterOpen);
            next = afterOpen;
        }
        if (!ParseExpressionCore(expectedType, out var inner))
        {
            return false;
        }
        for (mut int32 index = 0; index < depth; index = index + 1)
        {
            if (!Take(47, out var close))
            {
                return false;
            }
        }
        expression = inner;
        return true;
    }

    private bool StartsGroupedBinary()
    {
        mut int32 cursor = _at;
        mut int32 groups = 0;
        while (_tokens.TryGet(cursor, out var open) && open.Kind == 46)
        {
            groups = groups + 1;
            cursor = cursor + 1;
        }
        if (_tokens.TryGet(cursor, out var sign) && (sign.Kind == 57 || sign.Kind == 58))
        {
            cursor = cursor + 1;
            while (_tokens.TryGet(cursor, out var signedOpen) && signedOpen.Kind == 46)
            {
                groups = groups + 1;
                cursor = cursor + 1;
            }
        }
        if (!_tokens.TryGet(cursor, out var atom)
            || (atom.Kind != 2 && atom.Kind != 3
                && atom.Kind != 20 && atom.Kind != 21))
        {
            return false;
        }
        cursor = cursor + 1;
        for (mut int32 index = 0; index < groups; index = index + 1)
        {
            if (!_tokens.TryGet(cursor, out var close) || close.Kind != 47)
            {
                return false;
            }
            cursor = cursor + 1;
        }
        if (!_tokens.TryGet(cursor, out var operation))
        {
            return false;
        }
        return (operation.Kind >= 57 && operation.Kind <= 61)
            || (operation.Kind >= 65 && operation.Kind <= 75);
    }

    private bool HasOperandKind(int32 index, int32 kind)
    {
        mut int32 cursor = index;
        while (_tokens.TryGet(cursor, out var token) && token.Kind == 46)
        {
            cursor = cursor + 1;
        }
        return _tokens.TryGet(cursor, out var operand) && operand.Kind == kind;
    }

    private bool IsScalarBinaryOperator(int32 kind)
    {
        return (kind >= 57 && kind <= 61)
            || (kind >= 65 && kind <= 70)
            || kind == 71 || kind == 73 || kind == 75;
    }

    private bool HasBinaryAfterOperand(int32 cursor, int32 groups)
    {
        mut int32 at = cursor;
        for (mut int32 index = 0; index < groups; index = index + 1)
        {
            if (!_tokens.TryGet(at, out var close) || close.Kind != 47)
            {
                return false;
            }
            at = at + 1;
        }
        return _tokens.TryGet(at, out var following)
            && IsScalarBinaryOperator(following.Kind);
    }

    private bool StartsSignedGroupedBinary(int32 outerGroups)
    {
        mut int32 cursor = _at + 1;
        mut int32 groups = 0;
        while (_tokens.TryGet(cursor, out var open) && open.Kind == 46)
        {
            cursor = cursor + 1;
            groups = groups + 1;
        }
        return groups > 0 && _tokens.TryGet(cursor, out var number)
            && number.Kind == 3 && HasBinaryAfterOperand(cursor + 1,
                groups + outerGroups);
    }

    private mut bool ParseExpressionCore(int32 expectedType, out ScalarFrontendExpression expression)
    {
        require _tokens.TryGet(_at, out var first);
        mut Token literal = first;
        mut int32 prefixGroups = 0;
        if (first.Kind == 46)
        {
            require BeginUnaryOperand(out var grouped, out prefixGroups);
            literal = grouped;
        }
        if (literal.Kind == 62)
        {
            _at = _at + 1;
            require BeginUnaryOperand(out var operand, out var groups);
            mut int32 parameter = 0;
            mut int32 booleanKind = 0;
            if (operand.Kind == 20 || operand.Kind == 21)
            {
                booleanKind = operand.Kind;
            }
            else if (operand.Kind == 2)
            {
                if (_parameterCount > 0 && SameTokenSpelling(_first, operand))
                {
                    parameter = 1;
                    if (_firstType != 5)
                    {
                        FailAt(2, operand.Range);
                        return false;
                    }
                }
                else if (_parameterCount > 1 && SameTokenSpelling(_second, operand))
                {
                    parameter = 2;
                    if (_secondType != 5)
                    {
                        FailAt(2, operand.Range);
                        return false;
                    }
                }
                else
                {
                    FailAt(3, operand.Range);
                    return false;
                }
            }
            else
            {
                FailAt(1, operand.Range);
                return false;
            }
            if (!FinishUnaryOperand(operand, groups, out var end))
            {
                return false;
            }
            require SourceRange.TryCreate(literal.Range.Start,
                end - literal.Range.Start, out var span);
            require ScalarFrontendExpression.TryCreate(5, 62, parameter, booleanKind,
                span, out var negated);
            expression = negated;
            return true;
        }
        if (literal.Kind == 63)
        {
            _at = _at + 1;
            require BeginUnaryOperand(out var operand, out var groups);
            if (expectedType < 1 || expectedType > 4)
            {
                FailAt(2, literal.Range);
                return false;
            }
            mut int32 operation = 63;
            mut int32 left = 0;
            mut int32 right = 0;
            if (operand.Kind == 3)
            {
                if (!TryReadMagnitude(operand, _at, expectedType, false,
                    operand.Range, out left, out right))
                {
                    return false;
                }
                operation = 163;
            }
            else if (operand.Kind == 2)
            {
                if (!TryResolveParameter(operand, out left, out var parameterType))
                {
                    return false;
                }
                if (parameterType != expectedType)
                {
                    FailAt(2, operand.Range);
                    return false;
                }
            }
            else
            {
                FailAt(1, operand.Range);
                return false;
            }
            if (!FinishUnaryOperand(operand, groups, out var end))
            {
                return false;
            }
            require SourceRange.TryCreate(literal.Range.Start,
                end - literal.Range.Start, out var span);
            require ScalarFrontendExpression.TryCreate(expectedType, operation, left, right,
                span, out var inverted);
            expression = inverted;
            return true;
        }
        if ((literal.Kind == 57 || literal.Kind == 58)
            && _tokens.TryGet(_at + 1, out var unaryFirst)
            && (unaryFirst.Kind == 2
                || (unaryFirst.Kind == 46
                    && !StartsSignedGroupedBinary(prefixGroups))))
        {
            _at = _at + 1;
            require BeginUnaryOperand(out var unaryOperand, out var groups);
            if (unaryOperand.Kind == 3
                && (literal.Kind == 57 || literal.Kind == 58))
            {
                if (expectedType < 1 || expectedType > 4
                    || (literal.Kind == 58 && expectedType != 1 && expectedType != 3))
                {
                    FailAt(2, literal.Range);
                    return false;
                }
                if (!TryReadMagnitude(unaryOperand, _at, expectedType, false,
                    unaryOperand.Range, out var low, out var high)
                    || !FinishUnaryOperand(unaryOperand, groups, out var signedEnd))
                {
                    return false;
                }
                require SourceRange.TryCreate(literal.Range.Start,
                    signedEnd - literal.Range.Start, out var signedSpan);
                mut int32 operation = 657;
                if (literal.Kind == 58)
                {
                    operation = 658;
                }
                require ScalarFrontendExpression.TryCreate(expectedType, operation,
                    low, high, signedSpan, out var signedLiteral);
                expression = signedLiteral;
                return true;
            }
            if (unaryOperand.Kind != 2)
            {
                FailAt(1, unaryOperand.Range);
                return false;
            }
            if (!TryResolveParameter(unaryOperand, out var parameter, out var parameterType))
            {
                return false;
            }
            if (parameterType != expectedType
                || (literal.Kind == 58 && expectedType != 1 && expectedType != 3)
                || (literal.Kind == 57 && (expectedType < 1 || expectedType > 4)))
            {
                FailAt(2, literal.Range);
                return false;
            }
            if (!FinishUnaryOperand(unaryOperand, groups, out var end))
            {
                return false;
            }
            require SourceRange.TryCreate(literal.Range.Start,
                end - literal.Range.Start, out var span);
            require ScalarFrontendExpression.TryCreate(expectedType, literal.Kind, parameter,
                0, span, out var unary);
            expression = unary;
            return true;
        }
        if (literal.Kind == 57
            && _tokens.TryGet(_at + 1, out var plusOperand) && plusOperand.Kind == 3
            && !HasBinaryAfterOperand(_at + 2, prefixGroups))
        {
            if (expectedType < 1 || expectedType > 4)
            {
                FailAt(2, literal.Range);
                return false;
            }
            if (!TryReadMagnitude(plusOperand, _at + 1, expectedType, false,
                plusOperand.Range, out var plusLow, out var plusHigh))
            {
                return false;
            }
            _at = _at + 2;
            require SourceRange.TryCreate(literal.Range.Start,
                plusOperand.Range.End - literal.Range.Start, out var plusSpan);
            require ScalarFrontendExpression.TryCreate(expectedType, 657,
                plusLow, plusHigh, plusSpan, out var plusLiteral);
            expression = plusLiteral;
            return true;
        }
        mut Token numberToken = literal;
        bool negative = literal.Kind == 58;
        bool positive = literal.Kind == 57;
        mut bool signedGrouped = false;
        if ((negative || positive) && _tokens.TryGet(_at + 1, out var nextNumber)
            && nextNumber.Kind == 3)
        {
            numberToken = nextNumber;
        }
        else if ((negative || positive) && StartsSignedGroupedBinary(prefixGroups))
        {
            _at = _at + 1;
            require BeginUnaryOperand(out var groupedNumber, out var signedGroups);
            numberToken = groupedNumber;
            prefixGroups = prefixGroups + signedGroups;
            signedGrouped = true;
        }
        if (numberToken.Kind == 3)
        {
            mut int32 tokenIndex = _at;
            if ((negative || positive) && !signedGrouped)
            {
                tokenIndex = tokenIndex + 1;
            }
            _at = tokenIndex;
            if (!FinishUnaryOperand(numberToken, prefixGroups, out var leftEnd))
            {
                return false;
            }
            require _tokens.TryGet(_at, out var following);
            if (expectedType == 5
                && following.Kind >= 65 && following.Kind <= 70)
            {
                _at = _at + 1;
                require BeginUnaryOperand(out var right, out var groups);
                if (right.Kind != 2)
                {
                    FailAt(1, right.Range);
                    return false;
                }
                if (!TryResolveParameter(right, out var parameter, out var parameterType))
                {
                    return false;
                }
                if (negative && signedGrouped && parameterType != 1 && parameterType != 3)
                {
                    FailAt(2, numberToken.Range);
                    return false;
                }
                if (!TryReadMagnitude(numberToken, tokenIndex, parameterType,
                    negative && !signedGrouped,
                    numberToken.Range, out var low, out var high))
                {
                    return false;
                }
                if (!FinishUnaryOperand(right, groups, out var end))
                {
                    return false;
                }
                require SourceRange.TryCreate(first.Range.Start,
                    end - first.Range.Start, out var comparisonSpan);
                mut int32 signedOffset = 0;
                if (negative)
                {
                    signedOffset = 1200;
                }
                else if (positive)
                {
                    signedOffset = 1600;
                }
                require ScalarFrontendExpression.TryCreate(5,
                    following.Kind + (parameter + 2) * 100 + signedOffset,
                    low, high,
                    comparisonSpan, out var comparison);
                expression = comparison;
                return true;
            }
            require SourceRange.TryCreate(literal.Range.Start,
                numberToken.Range.End - literal.Range.Start, out var numberSpan);
            if (negative && signedGrouped && expectedType != 1 && expectedType != 3)
            {
                FailAt(2, numberToken.Range);
                return false;
            }
            if (!TryReadMagnitude(numberToken, tokenIndex, expectedType,
                negative && !signedGrouped,
                numberSpan, out var low, out var high))
            {
                return false;
            }
            if (!negative && expectedType >= 1 && expectedType <= 2
                && _tokens.TryGet(_at, out var pairOperator)
                && ((pairOperator.Kind >= 57 && pairOperator.Kind <= 61)
                    || pairOperator.Kind == 71 || pairOperator.Kind == 73 || pairOperator.Kind == 75)
                && HasOperandKind(_at + 1, 3))
            {
                _at = _at + 1;
                require BeginUnaryOperand(out var secondLiteral, out var groups);
                if (!TryReadMagnitude(secondLiteral, _at, expectedType, false,
                    secondLiteral.Range, out var secondLow, out var secondHigh)
                    || !FinishUnaryOperand(secondLiteral, groups, out var end))
                {
                    return false;
                }
                require SourceRange.TryCreate(first.Range.Start,
                    end - first.Range.Start, out var pairSpan);
                require ScalarFrontendExpression.TryCreate(expectedType,
                    pairOperator.Kind + 500, low, secondLow, pairSpan, out var foldedPair);
                expression = foldedPair;
                return true;
            }
            if (_tokens.TryGet(_at, out var next)
                && ((next.Kind >= 57 && next.Kind <= 61)
                    || next.Kind == 71 || next.Kind == 73 || next.Kind == 75))
            {
                if (expectedType < 1 || expectedType > 4)
                {
                    FailAt(2, next.Range);
                    return false;
                }
                _at = _at + 1;
                require BeginUnaryOperand(out var right, out var groups);
                if (right.Kind != 2)
                {
                    FailAt(1, right.Range);
                    return false;
                }
                if (!TryResolveParameter(right, out var parameter, out var parameterType))
                {
                    return false;
                }
                if (parameterType != expectedType)
                {
                    FailAt(2, next.Range);
                    return false;
                }
                if (!FinishUnaryOperand(right, groups, out var end))
                {
                    return false;
                }
                require SourceRange.TryCreate(first.Range.Start,
                    end - first.Range.Start, out var binarySpan);
                mut int32 signedOffset = 0;
                if (negative)
                {
                    signedOffset = 1200;
                }
                else if (positive)
                {
                    signedOffset = 1600;
                }
                require ScalarFrontendExpression.TryCreate(expectedType,
                    next.Kind + (parameter + 2) * 100 + signedOffset,
                    low, high, binarySpan, out var binary);
                expression = binary;
                return true;
            }
            require ScalarFrontendExpression.TryCreate(expectedType, 3, low, high,
                numberSpan, out var number);
            expression = number;
            return true;
        }
        if (literal.Kind == 20 || literal.Kind == 21)
        {
            if (!FinishUnaryOperand(literal, prefixGroups, out var leftEnd))
            {
                return false;
            }
            if (_tokens.TryGet(_at, out var booleanOperator)
                && ((booleanOperator.Kind >= 71 && booleanOperator.Kind <= 75)
                    || booleanOperator.Kind == 65 || booleanOperator.Kind == 66))
            {
                _at = _at + 1;
                require BeginUnaryOperand(out var booleanRight, out var groups);
                if (booleanRight.Kind == 20 || booleanRight.Kind == 21)
                {
                    if (!FinishUnaryOperand(booleanRight, groups, out var end))
                    {
                        return false;
                    }
                    require SourceRange.TryCreate(first.Range.Start,
                        end - first.Range.Start, out var literalSpan);
                    require ScalarFrontendExpression.TryCreate(5,
                        booleanOperator.Kind + 1100, literal.Kind, booleanRight.Kind,
                        literalSpan, out var literals);
                    expression = literals;
                    return true;
                }
                if (booleanRight.Kind != 2)
                {
                    FailAt(1, booleanRight.Range);
                    return false;
                }
                if (!TryResolveParameter(booleanRight, out var parameter, out var parameterType))
                {
                    return false;
                }
                if (parameterType != 5)
                {
                    FailAt(2, booleanRight.Range);
                    return false;
                }
                if (!FinishUnaryOperand(booleanRight, groups, out var end))
                {
                    return false;
                }
                require SourceRange.TryCreate(first.Range.Start,
                    end - first.Range.Start, out var span);
                require ScalarFrontendExpression.TryCreate(5,
                    booleanOperator.Kind + 900, parameter, literal.Kind,
                    span, out var withLiteral);
                expression = withLiteral;
                return true;
            }
            require ScalarFrontendExpression.TryCreate(5, literal.Kind, 0, 0,
                literal.Range, out var found);
            expression = found;
            return true;
        }
        Token left = literal;
        int32 leftGroups = prefixGroups;
        if (left.Kind != 2)
        {
            FailAt(1, left.Range);
            return false;
        }
        if (!FinishUnaryOperand(left, leftGroups, out var leftEnd))
        {
            return false;
        }
        mut int32 leftIndex = 0;
        mut int32 selected = 0;
        if (_parameterCount > 0 && SameTokenSpelling(_first, left))
        {
            leftIndex = 1;
            selected = _firstType;
        }
        else if (_parameterCount > 1 && SameTokenSpelling(_second, left))
        {
            leftIndex = 2;
            selected = _secondType;
        }
        if (selected == 0)
        {
            FailAt(3, left.Range);
            return false;
        }

        mut int32 operation = 0;
        mut int32 rightIndex = 0;
        mut int32 end = leftEnd;
        require _tokens.TryGet(_at, out var next);
        if ((next.Kind >= 57 && next.Kind <= 61)
            || (next.Kind >= 65 && next.Kind <= 70)
            || (next.Kind >= 71 && next.Kind <= 75))
        {
            operation = next.Kind;
            _at = _at + 1;
            require BeginUnaryOperand(out var right, out var groups);
            mut Token number = right;
            mut int32 unaryKind = 0;
            mut bool rightSignedGrouped = false;
            mut int32 numericGroups = groups;
            if (right.Kind == 57 || right.Kind == 58)
            {
                if (_tokens.TryGet(_at + 1, out var signedNumber)
                    && signedNumber.Kind == 3)
                {
                    number = signedNumber;
                    unaryKind = right.Kind;
                }
                else if (_tokens.TryGet(_at + 1, out var open) && open.Kind == 46)
                {
                    _at = _at + 1;
                    require BeginUnaryOperand(out var groupedNumber, out var signedGroups);
                    if (groupedNumber.Kind == 3)
                    {
                        number = groupedNumber;
                        unaryKind = right.Kind;
                        numericGroups = numericGroups + signedGroups;
                        rightSignedGrouped = true;
                    }
                }
            }
            if (((operation >= 71 && operation <= 75)
                    || operation == 65 || operation == 66)
                && (right.Kind == 20 || right.Kind == 21))
            {
                if (selected != 5)
                {
                    FailAt(2, next.Range);
                    return false;
                }
                if (!FinishUnaryOperand(right, groups, out end))
                {
                    return false;
                }
                require SourceRange.TryCreate(first.Range.Start,
                    end - first.Range.Start, out var span);
                require ScalarFrontendExpression.TryCreate(5,
                    operation + 700, leftIndex, right.Kind,
                    span, out var withLiteral);
                expression = withLiteral;
                return true;
            }
            if (((operation >= 57 && operation <= 61)
                || (operation >= 65 && operation <= 70)
                || operation == 71 || operation == 73 || operation == 75)
                && number.Kind == 3)
            {
                if (unaryKind != 0 && !rightSignedGrouped)
                {
                    _at = _at + 1;
                }
                if ((operation >= 65 && operation <= 70 && selected == 5)
                    || ((operation < 65 || operation > 70) && (selected == 5 || selected == 6)))
                {
                    FailAt(2, next.Range);
                    return false;
                }
                int32 index = _at;
                if (unaryKind == 58 && rightSignedGrouped && selected != 1 && selected != 3)
                {
                    FailAt(2, number.Range);
                    return false;
                }
                if (!TryReadMagnitude(number, index, selected,
                    unaryKind == 58 && !rightSignedGrouped,
                    number.Range, out var low, out var high)
                    || !FinishUnaryOperand(number, numericGroups, out end))
                {
                    return false;
                }
                require SourceRange.TryCreate(first.Range.Start,
                    end - first.Range.Start, out var literalSpan);
                mut int32 resultType = selected;
                if (operation >= 65 && operation <= 70)
                {
                    resultType = 5;
                }
                mut int32 signedOffset = 0;
                if (unaryKind == 58)
                {
                    signedOffset = 1200;
                }
                else if (unaryKind == 57)
                {
                    signedOffset = 1600;
                }
                require ScalarFrontendExpression.TryCreate(resultType,
                    operation + leftIndex * 100 + signedOffset,
                    low, high, literalSpan, out var withLiteral);
                expression = withLiteral;
                return true;
            }
            if (right.Kind != 2)
            {
                FailAt(1, right.Range);
                return false;
            }
            if (_parameterCount > 0 && SameTokenSpelling(_first, right))
            {
                rightIndex = 1;
            }
            else if (_parameterCount > 1 && SameTokenSpelling(_second, right))
            {
                rightIndex = 2;
            }
            if (rightIndex == 0)
            {
                FailAt(3, right.Range);
                return false;
            }
            mut int32 rightType = _firstType;
            if (rightIndex == 2)
            {
                rightType = _secondType;
            }
            if (selected != rightType || ((operation >= 57 && operation <= 61)
                && (selected == 5 || selected == 6))
                || (operation >= 67 && operation <= 70 && selected == 5)
                || (operation >= 71 && operation <= 75 && selected == 6)
                || ((operation == 72 || operation == 74) && selected != 5))
            {
                FailAt(2, next.Range);
                return false;
            }
            if (!FinishUnaryOperand(right, groups, out end))
            {
                return false;
            }
        }
        require SourceRange.TryCreate(first.Range.Start, end - first.Range.Start, out var span);
        if (operation >= 65 && operation <= 70)
        {
            selected = 5;
        }
        require ScalarFrontendExpression.TryCreate(selected, operation, leftIndex,
            rightIndex, span, out var created);
        expression = created;
        return true;
    }

    private mut bool ParseReturn(int32 returnType, out ScalarFrontendExpression expression)
    {
        if (!Take(19, out var keyword) || !ParseExpression(returnType, out var found))
        {
            return false;
        }
        if (found.Type != returnType)
        {
            FailAt(2, found.Span);
            return false;
        }
        if (!Take(52, out var semicolon))
        {
            return false;
        }
        expression = found;
        return true;
    }

    private mut bool ParseHeader(out int32 returnType, out SourceRange name)
    {
        require _tokens.TryGet(_at, out var visibility);
        if (visibility.Kind == 7)
        {
            _isPublic = true;
            _at = _at + 1;
        }
        else if (visibility.Kind == 8)
        {
            _at = _at + 1;
        }
        if (!Take(2, out var typeToken))
        {
            return false;
        }
        if (!TryGetScalarType(typeToken, out var selected))
        {
            FailAt(2, typeToken.Range);
            return false;
        }
        if (!Take(2, out var function) || !Take(46, out var openParameters))
        {
            return false;
        }
        require _tokens.TryGet(_at, out var next);
        if (next.Kind != 47)
        {
            if (!ParseParameter(out var firstType, out var first))
            {
                return false;
            }
            _firstType = firstType;
            _first = first;
            _parameterCount = 1;
            require _tokens.TryGet(_at, out var comma);
            if (comma.Kind == 53)
            {
                _at = _at + 1;
                if (!ParseParameter(out var secondType, out var second))
                {
                    return false;
                }
                _secondType = secondType;
                _second = second;
                _parameterCount = 2;
            }
        }
        if (!Take(47, out var closeParameters) || !Take(48, out var openBody))
        {
            return false;
        }
        returnType = selected;
        name = function.Range;
        return true;
    }

    public mut bool TryParse(out ScalarFrontendResult result)
    {
        require SourceRange.TryCreate(0, 0, out var empty);
        require ScalarFrontendExpression.TryCreate(0, 0, 0, 0, empty, out var absent);
        mut SourceRange name = empty;
        mut int32 returnType = 0;
        mut bool hasCondition = false;
        mut bool hasFallthrough = false;
        mut ScalarFrontendExpression condition = absent;
        mut ScalarFrontendExpression whenTrue = absent;
        mut ScalarFrontendExpression whenFalse = absent;

        if (_tokens.GetCount() > 64)
        {
            Fail(1);
        }
        else if (ParseHeader(out var selectedReturnType, out var foundName))
        {
            returnType = selectedReturnType;
            name = foundName;
            require _tokens.TryGet(_at, out var bodyNext);
            if (bodyNext.Kind == 16)
            {
                hasCondition = true;
                _at = _at + 1;
                if (Take(46, out var openCondition)
                    && ParseExpression(5, out var predicate))
                {
                    if (predicate.Type != 5)
                    {
                        FailAt(2, predicate.Span);
                    }
                    else
                    {
                        condition = predicate;
                    }
                }
                if (_error == 0 && Take(47, out var closeCondition)
                    && Take(48, out var openTrue)
                    && ParseReturn(returnType, out var firstReturn)
                    && Take(49, out var closeTrue))
                {
                    whenTrue = firstReturn;
                    require _tokens.TryGet(_at, out var followingTrue);
                    if (followingTrue.Kind == 17)
                    {
                        _at = _at + 1;
                        if (Take(48, out var openFalse)
                            && ParseReturn(returnType, out var secondReturn)
                            && Take(49, out var closeFalse))
                        {
                            whenFalse = secondReturn;
                        }
                    }
                    else if (ParseReturn(returnType, out var trailingReturn))
                    {
                        whenFalse = trailingReturn;
                        hasFallthrough = true;
                    }
                }
            }
            else if (ParseReturn(returnType, out var found))
            {
                whenTrue = found;
            }
            if (_error == 0 && Take(49, out var closeBody)
                && Take(0, out var eof) && _at != _tokens.GetCount())
            {
                Fail(1);
            }
        }
        if (_error != 0)
        {
            return ScalarFrontendResult.TryCreate(false, false, _error, _errorSpan, 0, 0,
                0, 0, empty, empty, empty, false, false, absent, absent, absent, out result);
        }
        return ScalarFrontendResult.TryCreate(true, _isPublic, 0, empty, returnType, _parameterCount,
            _firstType, _secondType, name, _first.Range, _second.Range,
            hasCondition, hasFallthrough, condition, whenTrue, whenFalse, out result);
    }
}

bool TryParseScalarFrontend(TokenSnapshot tokens, out ScalarFrontendResult result)
{
    require SourceRange.TryCreate(0, 0, out var empty);
    int32 count = tokens.GetCount();
    if (count > 64)
    {
        require tokens.TryGet(64, out var excess);
        require ScalarFrontendExpression.TryCreate(0, 0, 0, 0, empty, out var absent);
        return ScalarFrontendResult.TryCreate(false, false, 1, excess.Range, 0, 0, 0, 0,
            empty, empty, empty, false, false, absent, absent, absent, out result);
    }
    if (count < 1 || !ManagedTokenChain.TryCreate(out var chain))
    {
        return false;
    }
    // Validate numeric records only when present; scalar functions without
    // literals do not need a second owned snapshot.
    if (Host.IntegerValues[0] != 0
        && !TokenIntegerSnapshot.TryBuild(count, init var integers))
    {
        return false;
    }
    // Managed classes cannot own a unique snapshot; copy only validated token values
    // into the existing bounded chain, without rescanning source or integer text.
    for (mut int32 at = 0; at < count; at = at + 1)
    {
        require tokens.TryGet(at, out var token);
        require chain.TryAppend(token.Kind, token.Range.Start, token.Range.Length);
    }
    if (!ScalarFrontendState.TryCreate(chain, empty, out var state))
    {
        return false;
    }
    return state.TryParse(out result);
}

bool TryScanScalarFrontend(out ScalarFrontendResult result)
{
    if (!TokenSnapshot.TryScan(init var tokens))
    {
        return false;
    }
    return TryParseScalarFrontend(move tokens, out result);
}
