        if (_error != 0)
        {
            for (mut int32 index = 37; index < Host.Frontend.Length; index = index + 1)
            {
                Host.Frontend[index] = 0;
            }
            return TryCreateScalarFrontendError(_error, _errorSpan, out result);
        }
        Host.Frontend[38] = -1;
        Host.Frontend[39] = -1;
        Host.Frontend[40] = -1;
        return ScalarFrontendResult.TryCreate(true, _isPublic, 0, empty,
            returnType, _parameterCount, _firstType, _secondType, _thirdType, _outParameterMask,
            name, _first.Range, _second.Range, _third.Range,
            false, false, absent, absent, absent, out result);
    }

    private bool HasStructuredCompletion(int32 returnType, bool hasTerminatingStatement)
    {
        if (returnType == 0 || Host.Frontend[2] != 0) { return true; }
        if (_structuredReturnCount == 0 && !hasTerminatingStatement) { return false; }
        return TreeBodyReturns(0, _statementCount);
