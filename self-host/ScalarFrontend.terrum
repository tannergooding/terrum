        mut int32 statementKind = first.Kind == 81 ? 15 : 1;
        if (constant)
        {
            statementKind = TreeWord(initializer, 0) == 3
                || TreeWord(initializer, 0) == 20 || TreeWord(initializer, 0) == 21 ? 27 : 28;
        }
        return AddTreeStatement(statementKind, _parameterCount + index + 1, initializer,
            first.Range.Start, TreeStatementEnd());
