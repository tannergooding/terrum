            if (kind < 16 || kind > 18 || Host.Frontend[offset + 1] != 0) { continue; }
            mut int32 index = 0;
            while (_tokens.TryGet(index, out var token))
            {
                if (token.Range.Start == Host.Frontend[offset + 3])
                {
                    if (SameTokenSpelling(token, name)) { return header; }
                    break;
