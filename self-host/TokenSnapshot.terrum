namespace Terrum.CodeAnalysis;

public unique struct TokenSnapshot
{
    private OwnedInt32Buffer _records;
    private int32 _count;

    private TokenSnapshot(OwnedInt32Buffer records, int32 count)
    {
        _records = move records;
        _count = count;
    }

    public int32 GetCount()
    {
        return _count;
    }

    public bool TryGet(int32 index, out Token token)
    {
        if (index < 0 || index >= _count)
        {
            return false;
        }

        int32 offset = index * 3;
        require SourceRange.TryCreate(_records.Read(offset + 1), _records.Read(offset + 2),
            out var range);
        token = new Token(_records.Read(offset), range);
        return true;
    }

    public bool TryGetInit(int32 index, init ref<Token> token)
    {
        if (!TryGet(index, out var found))
        {
            return false;
        }
        token = found;
        return true;
    }

    // Scalar input has no generic lists or operator declarations. Its operand-ending
    // token kinds determine unary versus binary/update roles without name lookup.
    // A colon attached to an identifier before a loop keyword introduces its label.
    public SourceRange GetScalarOperatorSpacingError()
    {
        var run = GetScalarPunctuationRunError();
        if (run.Length != 0)
        {
            return run;
        }
        require TryGet(0, out var first);
        mut Token previous = first;
        for (mut int32 index = 1; index < _count - 1; index = index + 1)
        {
            require TryGet(index, out var op);
            require TryGet(index + 1, out var next);
            int32 kind = op.Kind;
            bool operandEnd = IsScalarOperandEnd(previous.Kind);
            mut bool prefix = kind == 62 || kind == 63;
            mut bool postfix = false;
            mut bool separated = false;
            if (kind == 57 || kind == 58)
            {
                if (operandEnd) { separated = true; }
                else { prefix = true; }
            }
            if (kind == 86 || kind == 87)
            {
                if (operandEnd) { postfix = true; }
                else { prefix = true; }
            }
            if (kind >= 59 && kind <= 61) { separated = true; }
            if (kind == 55 || kind == 56) { separated = true; }
            if (kind >= 64 && kind <= 75) { separated = true; }
            if (kind == 82 || kind == 84 || kind == 85) { separated = true; }
            if (kind >= 88 && kind <= 101) { separated = true; }
            if (kind == 55 && (next.Kind == 18 || next.Kind == 83 || next.Kind == 31))
            {
                if (previous.Kind != 2 || previous.Range.End != op.Range.Start)
                {
                    return op.Range;
                }
                separated = false;
            }
            if (prefix && op.Range.End != next.Range.Start)
            {
                return op.Range;
            }
            if (postfix && previous.Range.End != op.Range.Start)
            {
                return op.Range;
            }
            if (separated && (previous.Range.End == op.Range.Start
                || op.Range.End == next.Range.Start))
            {
                return op.Range;
            }
            previous = op;
        }
        require SourceRange.TryCreate(0, 0, out var empty);
        return empty;
    }

    private SourceRange GetScalarPunctuationRunError()
    {
        mut int32 index = 0;
        while (index < _count - 1)
        {
            require TryGet(index, out var first);
            if (!IsPunctuationGlyph(PeekUnit(first.Range.Start)))
            {
                index = index + 1;
                continue;
            }
            int32 start = first.Range.Start;
            mut int32 end = first.Range.End;
            mut int32 records = 1;
            index = index + 1;
            while (index < _count - 1)
            {
                require TryGet(index, out var next);
                if (next.Range.Start != end
                    || !IsPunctuationGlyph(PeekUnit(next.Range.Start)))
                {
                    break;
                }
                end = next.Range.End;
                records = records + 1;
                index = index + 1;
            }
            int32 matched = OperatorMatch(start);
            if (records != 1 || matched == -1 || matched % 8 != end - start
                || matched / 8 != first.Kind)
            {
                require SourceRange.TryCreate(start, end - start, out var error);
                return error;
            }
        }
        require SourceRange.TryCreate(0, 0, out var empty);
        return empty;
    }

    private static bool IsScalarOperandEnd(int32 kind)
    {
        if (kind == 2 || kind == 3) { return true; }
        if (kind == 20 || kind == 21) { return true; }
        if (kind == 47) { return true; }
        return kind == 86 || kind == 87;
    }

    public static bool TryBuild(int32 count, init ref<TokenSnapshot> result)
    {
        if (Host.Diagnostics[0] != 0 || count < 1
            || count > int32.MaxValue / 3 || count > Host.Tokens.Length / 3)
        {
            return false;
        }

        if (!OwnedInt32Buffer.TryCreate(count * 3, out var created))
        {
            return false;
        }

        mut OwnedInt32Buffer records = move created;
        mut int32 previousEnd = 0;
        for (mut int32 index = 0; index < count; index = index + 1)
        {
            int32 offset = index * 3;
            int32 kind = Host.Tokens[offset];
            int32 start = Host.Tokens[offset + 1];
            int32 length = Host.Tokens[offset + 2];
            if (!IsValidScannerToken(index, count, previousEnd, kind, start, length))
            {
                return false;
            }

            require records.TryAppend(kind);
            require records.TryAppend(start);
            require records.TryAppend(length);
            previousEnd = start + length;
        }

        result = new TokenSnapshot(move records, count);
        return true;
    }

    public static bool TryScan(init ref<TokenSnapshot> result)
    {
        return TryBuild(Scan(), init result);
    }
}
