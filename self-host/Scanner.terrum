namespace Terrum.CodeAnalysis;

// This component scans source token boundaries and lexical diagnostics.
// Host buffers are bounded capabilities, not source-constructible pointers.
int32 ReadScalar(int32 at)
{
    int32 first = (int32)Host.Source[at];
    if (first >= 55296 && first <= 56319)
    {
        if (at + 1 < Host.Source.Length)
        {
            int32 second = (int32)Host.Source[at + 1];
            if (second >= 56320 && second <= 57343)
            {
                return 65536 + (first - 55296) * 1024 + second - 56320;
            }
        }

        return -1;
    }

    if (first >= 56320 && first <= 57343)
    {
        return -1;
    }

    return first;
}

int32 ScalarWidth(int32 scalar)
{
    if (scalar >= 65536)
    {
        return 2;
    }

    return 1;
}

bool IsIdentifierStart(int32 scalar)
{
    if (scalar == 95)
    {
        return true;
    }

    mut int32 low = 0;
    mut int32 high = Host.XidStart.Length / 2;
    while (low < high)
    {
        int32 middle = low + (high - low) / 2;
        if (scalar < Host.XidStart[middle * 2])
        {
            high = middle;
        }
        else if (scalar > Host.XidStart[middle * 2 + 1])
        {
            low = middle + 1;
        }
        else
        {
            return true;
        }
    }

    return false;
}

bool IsIdentifierContinue(int32 scalar)
{
    if (scalar == 95)
    {
        return true;
    }

    mut int32 low = 0;
    mut int32 high = Host.XidContinue.Length / 2;
    while (low < high)
    {
        int32 middle = low + (high - low) / 2;
        if (scalar < Host.XidContinue[middle * 2])
        {
            high = middle;
        }
        else if (scalar > Host.XidContinue[middle * 2 + 1])
        {
            low = middle + 1;
        }
        else
        {
            return true;
        }
    }

    return false;
}

bool IsSourceWhitespace(int32 unit)
{
    return unit == 9 || unit == 10 || unit == 11 || unit == 12 || unit == 13
        || unit == 32 || unit == 133 || unit == 160 || unit == 5760
        || (unit >= 8192 && unit <= 8202) || unit == 8232 || unit == 8233
        || unit == 8239 || unit == 8287 || unit == 12288;
}

bool IsPunctuation(int32 unit)
{
    return unit == 40 || unit == 41 || unit == 123 || unit == 125
        || unit == 91 || unit == 93 || unit == 59 || unit == 44
        || unit == 46 || unit == 58 || unit == 63 || unit == 43
        || unit == 45 || unit == 42 || unit == 47 || unit == 37
        || unit == 126 || unit == 94 || unit == 33 || unit == 61
        || unit == 60 || unit == 62 || unit == 38 || unit == 124;
}

int32 PeekUnit(int32 at)
{
    if (at >= Host.Source.Length)
    {
        return -1;
    }

    return (int32)Host.Source[at];
}

bool IsDigit(int32 unit)
{
    return unit >= 48 && unit <= 57;
}

bool IsHex(int32 unit)
{
    return IsDigit(unit) || (unit >= 65 && unit <= 70)
        || (unit >= 97 && unit <= 102);
}

bool IsNewline(int32 unit)
{
    return unit == 10 || unit == 13 || unit == 133 || unit == 8232 || unit == 8233;
}

void Report(int32 code, int32 start, int32 length)
{
    int32 count = Host.Diagnostics[0];
    require count * 3 + 4 <= Host.Diagnostics.Length;
    Host.Diagnostics[count * 3 + 1] = code;
    Host.Diagnostics[count * 3 + 2] = start;
    Host.Diagnostics[count * 3 + 3] = length;
    Host.Diagnostics[0] = count + 1;
}

void AdvanceCommentScalar(int32 at)
{
    if (ReadScalar(at) == -1)
    {
        Report(1, at, 1);
    }
}

int32 SkipTrivia(int32 initial)
{
    mut int32 at = initial;
    mut bool scanning = true;
    while (at < Host.Source.Length && scanning)
    {
        int32 current = PeekUnit(at);
        if (IsSourceWhitespace(current))
        {
            at = at + 1;
        }
        else if (current == 47 && PeekUnit(at + 1) == 47)
        {
            at = at + 2;
            while (at < Host.Source.Length && !IsNewline(PeekUnit(at)))
            {
                AdvanceCommentScalar(at);
                at = at + ScalarWidth(ReadScalar(at));
            }
        }
        else if (current == 47 && PeekUnit(at + 1) == 42)
        {
            int32 start = at;
            at = at + 2;
            while (at < Host.Source.Length
                && !(PeekUnit(at) == 42 && PeekUnit(at + 1) == 47))
            {
                AdvanceCommentScalar(at);
                at = at + ScalarWidth(ReadScalar(at));
            }

            if (at == Host.Source.Length)
            {
                Report(3, start, at - start);
            }
            else
            {
                at = at + 2;
            }
        }
        else
        {
            scanning = false;
        }
    }

    return at;
}

int32 ReadNumericTag(int32 at)
{
    int32 first = PeekUnit(at);
    if (first != 105 && first != 117 && first != 102)
    {
        return 0;
    }

    int32 second = PeekUnit(at + 1);
    mut int32 length = 0;
    if (second == 56 && first != 102)
    {
        length = 2;
    }
    else if (second == 49 && PeekUnit(at + 2) == 50 && PeekUnit(at + 3) == 56)
    {
        length = 4;
    }
    else if ((second == 49 && PeekUnit(at + 2) == 54)
        || (second == 51 && PeekUnit(at + 2) == 50)
        || (second == 54 && PeekUnit(at + 2) == 52))
    {
        length = 3;
    }

    if (length != 0 && at + length < Host.Source.Length)
    {
        int32 next = ReadScalar(at + length);
        if (next == 95 || IsIdentifierContinue(next))
        {
            return 0;
        }
    }

    return length;
}

int32 ScanNumber(int32 initial)
{
    mut int32 at = initial;
    int32 start = at;
    while (IsDigit(PeekUnit(at)))
    {
        at = at + 1;
    }

    if (PeekUnit(at) == 46 && IsDigit(PeekUnit(at + 1)))
    {
        at = at + 1;
        while (IsDigit(PeekUnit(at)))
        {
            at = at + 1;
        }
    }

    mut bool malformedExponent = false;
    int32 exponent = PeekUnit(at);
    if (exponent == 101 || exponent == 69)
    {
        int32 following = at + 1;
        bool signedExponent = PeekUnit(following) == 43 || PeekUnit(following) == 45;
        mut bool nextStartsIdentifier = false;
        if (following < Host.Source.Length)
        {
            int32 scalar = ReadScalar(following);
            nextStartsIdentifier = scalar == 95 || IsIdentifierContinue(scalar);
        }

        mut int32 exponentDigits = following;
        if (signedExponent)
        {
            exponentDigits = exponentDigits + 1;
        }

        if (IsDigit(PeekUnit(exponentDigits))
            || signedExponent || !nextStartsIdentifier)
        {
            at = following;
            if (signedExponent)
            {
                at = at + 1;
            }

            if (!IsDigit(PeekUnit(at)))
            {
                malformedExponent = true;
                Report(4, start, at - start);
            }
            else
            {
                while (IsDigit(PeekUnit(at)))
                {
                    at = at + 1;
                }
            }
        }
    }

    if (!malformedExponent)
    {
        at = at + ReadNumericTag(at);
    }

    return at;
}

int32 HexValue(int32 unit)
{
    if (IsDigit(unit))
    {
        return unit - 48;
    }

    if (unit >= 65 && unit <= 70)
    {
        return unit - 65 + 10;
    }

    return unit - 97 + 10;
}

int32 ScanString(int32 initial)
{
    mut int32 at = initial;
    int32 start = at;
    at = at + 1;
    mut bool terminated = false;
    mut bool scanning = true;
    while (at < Host.Source.Length && !IsNewline(PeekUnit(at)) && scanning)
    {
        int32 current = PeekUnit(at);
        if (current == 34)
        {
            at = at + 1;
            terminated = true;
            scanning = false;
        }
        else if (current != 92)
        {
            int32 scalar = ReadScalar(at);
            if (scalar == -1)
            {
                Report(1, at, 1);
            }

            at = at + ScalarWidth(scalar);
        }
        else
        {
            int32 escapeStart = at;
            at = at + 1;
            if (at == Host.Source.Length || IsNewline(PeekUnit(at)))
            {
                Report(5, escapeStart, 1);
                scanning = false;
            }
            else
            {
                int32 escape = PeekUnit(at);
                int32 scalar = ReadScalar(at);
                if (scalar == -1)
                {
                    Report(1, at, 1);
                }

                at = at + ScalarWidth(scalar);
                if (escape == 117 || escape == 85)
                {
                    mut int32 required = 8;
                    if (escape == 117)
                    {
                        required = 4;
                    }

                    mut int32 digits = 0;
                    mut int32 value = 0;
                    while (digits < required && IsHex(PeekUnit(at)))
                    {
                        if (value <= 1114111)
                        {
                            value = value * 16 + HexValue(PeekUnit(at));
                        }

                        at = at + 1;
                        digits = digits + 1;
                    }

                    if (digits != required || value > 1114111
                        || (value >= 55296 && value <= 57343))
                    {
                        Report(5, escapeStart, at - escapeStart);
                    }
                }
                else if (escape != 110 && escape != 114 && escape != 116
                    && escape != 92 && escape != 34 && escape != 48)
                {
                    Report(5, escapeStart, at - escapeStart);
                }
            }
        }
    }

    if (!terminated)
    {
        Report(2, start, at - start);
    }

    return at;
}

// Records are (kind, UTF-16 start, UTF-16 length). Kind 0 is EOF, 1 is an
// identifier/keyword spelling, 2 is a numeric literal, 3 punctuation,
// 4 invalid and 5 a raw string literal. Diagnostics have a separate buffer.
int32 Scan()
{
    Host.Diagnostics[0] = 0;
    mut int32 position = 0;
    mut int32 count = 0;
    while (position < Host.Source.Length)
    {
        position = SkipTrivia(position);
        if (position < Host.Source.Length)
        {
            int32 start = position;
            int32 scalar = ReadScalar(position);
            mut int32 kind = 4;
            position = position + ScalarWidth(scalar);
            if (IsIdentifierStart(scalar))
            {
                kind = 1;
                mut bool scanning = true;
                while (position < Host.Source.Length && scanning)
                {
                    int32 next = ReadScalar(position);
                    if (IsIdentifierContinue(next))
                    {
                        position = position + ScalarWidth(next);
                    }
                    else
                    {
                        scanning = false;
                    }
                }
            }
            else if (scalar >= 48 && scalar <= 57)
            {
                kind = 2;
                position = ScanNumber(start);
            }
            else if (scalar == 34)
            {
                kind = 5;
                position = ScanString(start);
            }
            else if (IsPunctuation(scalar))
            {
                kind = 3;
                if (position < Host.Source.Length)
                {
                    int32 next = (int32)Host.Source[position];
                    if (((scalar == 33 || scalar == 61 || scalar == 60 || scalar == 62) && next == 61)
                        || (scalar == 38 && next == 38) || (scalar == 124 && next == 124))
                    {
                        position = position + 1;
                    }
                }
            }
            else
            {
                Report(1, start, position - start);
            }

            require count * 3 + 3 <= Host.Tokens.Length;
            Host.Tokens[count * 3] = kind;
            Host.Tokens[count * 3 + 1] = start;
            Host.Tokens[count * 3 + 2] = position - start;
            count = count + 1;
        }
    }

    require count * 3 + 3 <= Host.Tokens.Length;
    Host.Tokens[count * 3] = 0;
    Host.Tokens[count * 3 + 1] = position;
    Host.Tokens[count * 3 + 2] = 0;

    return count + 1;
}
