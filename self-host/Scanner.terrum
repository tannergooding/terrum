namespace Terrum.CodeAnalysis;

// This component scans identifiers, untagged decimal integers and punctuation.
// Host buffers are bounded capabilities, not source-constructible pointers.
int32 ReadScalar(int32 at)
{
    int32 first = (int32)Host.Source[at];
    if (first >= 55296 && first <= 56319)
    {
        if (at + 1 < Host.Source.Length)
        {
            int32 second = (int32)Host.Source[at + 1];
            if (second >= 56320 && second <= 57343)
            {
                return 65536 + (first - 55296) * 1024 + second - 56320;
            }
        }

        return -1;
    }

    if (first >= 56320 && first <= 57343)
    {
        return -1;
    }

    return first;
}

int32 ScalarWidth(int32 scalar)
{
    if (scalar >= 65536)
    {
        return 2;
    }

    return 1;
}

bool IsIdentifierStart(int32 scalar)
{
    if (scalar == 95)
    {
        return true;
    }

    mut int32 low = 0;
    mut int32 high = Host.XidStart.Length / 2;
    while (low < high)
    {
        int32 middle = low + (high - low) / 2;
        if (scalar < Host.XidStart[middle * 2])
        {
            high = middle;
        }
        else if (scalar > Host.XidStart[middle * 2 + 1])
        {
            low = middle + 1;
        }
        else
        {
            return true;
        }
    }

    return false;
}

bool IsIdentifierContinue(int32 scalar)
{
    if (scalar == 95)
    {
        return true;
    }

    mut int32 low = 0;
    mut int32 high = Host.XidContinue.Length / 2;
    while (low < high)
    {
        int32 middle = low + (high - low) / 2;
        if (scalar < Host.XidContinue[middle * 2])
        {
            high = middle;
        }
        else if (scalar > Host.XidContinue[middle * 2 + 1])
        {
            low = middle + 1;
        }
        else
        {
            return true;
        }
    }

    return false;
}

bool IsSourceWhitespace(int32 unit)
{
    return unit == 9 || unit == 10 || unit == 11 || unit == 12 || unit == 13
        || unit == 32 || unit == 133 || unit == 160 || unit == 5760
        || (unit >= 8192 && unit <= 8202) || unit == 8232 || unit == 8233
        || unit == 8239 || unit == 8287 || unit == 12288;
}

bool IsPunctuation(int32 unit)
{
    return unit == 40 || unit == 41 || unit == 123 || unit == 125
        || unit == 91 || unit == 93 || unit == 59 || unit == 44
        || unit == 46 || unit == 58 || unit == 63 || unit == 43
        || unit == 45 || unit == 42 || unit == 47 || unit == 37
        || unit == 126 || unit == 94 || unit == 33 || unit == 61
        || unit == 60 || unit == 62 || unit == 38 || unit == 124;
}

// Records are (kind, UTF-16 start, UTF-16 length). Kind 0 is EOF, 1 is an
// identifier/keyword spelling, 2 is a decimal integer, 3 punctuation, 4 invalid.
int32 Scan()
{
    mut int32 position = 0;
    mut int32 count = 0;
    while (position < Host.Source.Length)
    {
        int32 scalar = ReadScalar(position);
        if (IsSourceWhitespace(scalar))
        {
            position = position + 1;
        }
        else
        {
            int32 start = position;
            mut int32 kind = 4;
            position = position + ScalarWidth(scalar);
            if (IsIdentifierStart(scalar))
            {
                kind = 1;
                mut bool scanning = true;
                while (position < Host.Source.Length && scanning)
                {
                    int32 next = ReadScalar(position);
                    if (IsIdentifierContinue(next))
                    {
                        position = position + ScalarWidth(next);
                    }
                    else
                    {
                        scanning = false;
                    }
                }
            }
            else if (scalar >= 48 && scalar <= 57)
            {
                kind = 2;
                mut bool scanning = true;
                while (position < Host.Source.Length && scanning)
                {
                    int32 next = (int32)Host.Source[position];
                    if (next >= 48 && next <= 57)
                    {
                        position = position + 1;
                    }
                    else
                    {
                        scanning = false;
                    }
                }
            }
            else if (IsPunctuation(scalar))
            {
                kind = 3;
                if (position < Host.Source.Length)
                {
                    int32 next = (int32)Host.Source[position];
                    if (((scalar == 33 || scalar == 61 || scalar == 60 || scalar == 62) && next == 61)
                        || (scalar == 38 && next == 38) || (scalar == 124 && next == 124))
                    {
                        position = position + 1;
                    }
                }
            }

            require count * 3 + 3 <= Host.Tokens.Length;
            Host.Tokens[count * 3] = kind;
            Host.Tokens[count * 3 + 1] = start;
            Host.Tokens[count * 3 + 2] = position - start;
            count = count + 1;
        }
    }

    require count * 3 + 3 <= Host.Tokens.Length;
    Host.Tokens[count * 3] = 0;
    Host.Tokens[count * 3 + 1] = position;
    Host.Tokens[count * 3 + 2] = 0;

    return count + 1;
}
