namespace Terrum.CodeAnalysis.Numerics64;

public static bool TryAddInt32(int32 left, int32 right, init ref<int32> result)
{
    int64 value = int64(left) + int64(right);
    if (value < int64(int32.MinValue) || value > int64(int32.MaxValue))
    {
        return false;
    }

    result = int32(value);
    return true;
}

public static bool TrySubtractInt32(int32 left, int32 right, init ref<int32> result)
{
    int64 value = int64(left) - int64(right);
    if (value < int64(int32.MinValue) || value > int64(int32.MaxValue))
    {
        return false;
    }

    result = int32(value);
    return true;
}

public static bool TryMultiplyInt32(int32 left, int32 right, init ref<int32> result)
{
    int64 value = int64(left) * int64(right);
    if (value < int64(int32.MinValue) || value > int64(int32.MaxValue))
    {
        return false;
    }

    result = int32(value);
    return true;
}

public static bool TryAddUInt32(uint32 left, uint32 right, init ref<uint32> result)
{
    uint64 value = uint64(left) + uint64(right);
    if (value > uint64(uint32.MaxValue))
    {
        return false;
    }

    result = uint32(value);
    return true;
}

public static bool TrySubtractUInt32(uint32 left, uint32 right, init ref<uint32> result)
{
    if (left < right)
    {
        return false;
    }

    result = left - right;
    return true;
}

public static bool TryMultiplyUInt32(uint32 left, uint32 right, init ref<uint32> result)
{
    uint64 value = uint64(left) * uint64(right);
    if (value > uint64(uint32.MaxValue))
    {
        return false;
    }

    result = uint32(value);
    return true;
}

public static bool TryDivideInt32(int32 left, int32 right, init ref<int32> result)
{
    if (right == 0 || (left == int32.MinValue && right == -1))
    {
        return false;
    }

    result = left / right;
    return true;
}

public static bool TryRemainderInt32(int32 left, int32 right, init ref<int32> result)
{
    if (right == 0)
    {
        return false;
    }

    if (left == int32.MinValue && right == -1)
    {
        result = 0;
        return true;
    }

    result = left % right;
    return true;
}

public static bool TryDivideUInt32(uint32 left, uint32 right, init ref<uint32> result)
{
    if (right == 0)
    {
        return false;
    }

    result = left / right;
    return true;
}

public static bool TryRemainderUInt32(uint32 left, uint32 right, init ref<uint32> result)
{
    if (right == 0)
    {
        return false;
    }

    result = left % right;
    return true;
}
