namespace Terrum.CodeAnalysis;

public unique struct SourceLineIndex
{
    private OwnedInt32Buffer _starts;
    private int32 _lineCount;
    private int32 _length;

    private SourceLineIndex(OwnedInt32Buffer starts, int32 lineCount, int32 length)
    {
        _starts = move starts;
        _lineCount = lineCount;
        _length = length;
    }

    public static bool TryCreate(init ref<SourceLineIndex> index)
    {
        mut int32 lineCount = 0;
        mut int32 position = 0;
        mut bool hasCrLf = false;
        while (true)
        {
            require TryReadSourceLine(position, init var content, init var includingBreak);
            hasCrLf = hasCrLf || includingBreak.Length - content.Length == 2;
            if (lineCount == int32.MaxValue)
            {
                return false;
            }
            lineCount = lineCount + 1;
            if (content.Length == includingBreak.Length)
            {
                break;
            }
            position = includingBreak.End;
        }

        int32 finalStart = position;
        // No code can modify the source between counting and filling the starts.
        mut int32 breakWordCount = 0;
        if (hasCrLf)
        {
            breakWordCount = (lineCount - 1) / 32;
            if ((lineCount - 1) % 32 != 0)
            {
                breakWordCount = breakWordCount + 1;
            }
        }
        if (lineCount > int32.MaxValue - breakWordCount
            || !OwnedInt32Buffer.TryCreate(lineCount + breakWordCount, out var created))
        {
            return false;
        }

        mut OwnedInt32Buffer starts = move created;
        require starts.TryAppend(0);
        mut int32 filled = 1;
        if (lineCount - 1 == Host.Source.Length)
        {
            // Each non-final line consumes at least one unit, so every unit is a break here.
            while (filled < lineCount)
            {
                require starts.TryAppend(filled);
                filled = filled + 1;
            }
        }
        else
        {
            position = 0;
            while (filled < lineCount - 1)
            {
                require TryReadSourceLine(position, init var content, init var includingBreak);
                position = includingBreak.End;
                require starts.TryAppend(position);
                filled = filled + 1;
            }
            if (filled < lineCount)
            {
                require starts.TryAppend(finalStart);
            }
        }
        // One packed bit per non-final line preserves whether its break was CRLF.
        if (hasCrLf)
        {
            mut int32 packedBreaks = 0;
            mut int32 bit = 0;
            mut int32 line = 0;
            while (line + 1 < lineCount)
            {
                int32 next = starts.Read(line + 1);
                if (next >= 2 && Host.Source[next - 2] == 13 && Host.Source[next - 1] == 10)
                {
                    packedBreaks = packedBreaks | (1 << bit);
                }
                bit = bit + 1;
                if (bit == 32)
                {
                    require starts.TryAppend(packedBreaks);
                    packedBreaks = 0;
                    bit = 0;
                }
                line = line + 1;
            }
            if (bit != 0)
            {
                require starts.TryAppend(packedBreaks);
            }
        }
        index = new SourceLineIndex(move starts, lineCount, Host.Source.Length);
        return true;
    }

    [NoThrow]
    public int32 GetLineCount()
    {
        return _lineCount;
    }

    public bool TryGetPosition(int32 position, init ref<int32> line, init ref<int32> character)
    {
        if (position < 0 || position > _length)
        {
            return false;
        }

        ReadonlyInt32BufferView starts = _starts.Slice(0, _lineCount);
        // The first start is zero; find the last start not greater than the position.
        mut int32 low = 0;
        mut int32 high = starts.Length;
        while (low + 1 < high)
        {
            int32 middle = low + (high - low) / 2;
            if (starts.Read(middle) <= position)
            {
                low = middle;
            }
            else
            {
                high = middle;
            }
        }

        line = low;
        character = position - starts.Read(low);
        return true;
    }

    public bool TryGetOffset(int32 line, int32 character, init ref<int32> offset)
    {
        if (line < 0 || line >= _lineCount || character < 0)
        {
            return false;
        }

        ReadonlyInt32BufferView starts = _starts.Slice(0, _lineCount);
        int32 start = starts.Read(line);
        if (line + 1 < starts.Length)
        {
            if (character >= starts.Read(line + 1) - start)
            {
                return false;
            }
        }
        else if (character > _length - start)
        {
            return false;
        }

        offset = start + character;
        return true;
    }

    public bool TryGetLineExtent(int32 line, init ref<SourceRange> includingBreak)
    {
        if (line < 0 || line >= _lineCount)
        {
            return false;
        }

        ReadonlyInt32BufferView starts = _starts.Slice(0, _lineCount);
        int32 start = starts.Read(line);
        mut int32 end = _length;
        if (line + 1 < starts.Length)
        {
            end = starts.Read(line + 1);
        }
        require SourceRange.TryCreate(start, end - start, init includingBreak);
        return true;
    }

    public bool TryGetLineContentExtent(int32 line, init ref<SourceRange> content)
    {
        if (!TryGetLineExtent(line, init var includingBreak))
        {
            return false;
        }

        int32 start = includingBreak.Start;
        mut int32 breakWidth = 0;
        if (line + 1 < _lineCount)
        {
            breakWidth = 1;
            if (_starts.Count > _lineCount)
            {
                int32 packedBreaks = _starts.Read(_lineCount + line / 32);
                breakWidth = breakWidth + ((packedBreaks >> (line % 32)) & 1);
            }
        }

        require SourceRange.TryCreate(start, includingBreak.Length - breakWidth, init content);
        return true;
    }

}
