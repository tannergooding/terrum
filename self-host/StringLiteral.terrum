namespace Terrum.CodeAnalysis;

public struct StringLiteral
{
    public SourceRange Spelling;
    public int32 ScalarCount;

    private StringLiteral(SourceRange spelling, int32 scalarCount)
    {
        Spelling = spelling;
        ScalarCount = scalarCount;
    }

    public static bool TryCreate(SourceRange spelling, out StringLiteral literal)
    {
        if (spelling.Length < 2 || spelling.Start > Host.Source.Length
            || spelling.Length > Host.Source.Length - spelling.Start)
        {
            return false;
        }

        int32 end = spelling.End - 1;
        if (Host.Source[spelling.Start] != 34 || Host.Source[end] != 34)
        {
            return false;
        }

        mut int32 at = spelling.Start + 1;
        mut int32 count = 0;
        while (at < end)
        {
            if (!TryReadLiteralScalarAt(at, end, out var scalar, out var next))
            {
                return false;
            }
            at = next;
            count = count + 1;
        }

        literal = new StringLiteral(spelling, count);
        return true;
    }

    public static bool TryCreateInit(SourceRange spelling, init ref<StringLiteral> literal)
    {
        if (!TryCreate(spelling, out var created))
        {
            return false;
        }
        literal = created;
        return true;
    }

    public bool TryReadScalar(int32 position, out int32 scalar, out int32 next)
    {
        int32 end = Spelling.End - 1;
        if (position <= Spelling.Start || position >= end)
        {
            return false;
        }

        // Rescan the prefix so an arbitrary offset cannot split an escape or pair.
        mut int32 at = Spelling.Start + 1;
        while (at <= position)
        {
            if (!TryReadLiteralScalarAt(at, end, out var value, out var following))
            {
                return false;
            }
            if (at == position)
            {
                scalar = value;
                next = following;
                return true;
            }
            at = following;
        }
        return false;
    }

    public bool TryReadScalarInit(int32 position, init ref<int32> scalar, init ref<int32> next)
    {
        if (!TryReadScalar(position, out var value, out var following))
        {
            return false;
        }
        scalar = value;
        next = following;
        return true;
    }

    public bool TryGetUtf8Length(init ref<int32> byteLength)
    {
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        mut int32 count = 0;
        while (cursor.TryRead(out var scalar, out var next))
        {
            mut int32 width = 1;
            if (scalar >= 65536) { width = 4; }
            else if (scalar >= 2048) { width = 3; }
            else if (scalar >= 128) { width = 2; }
            if (count > int32.MaxValue - width)
            {
                return false;
            }
            count = count + width;
            cursor = next;
        }
        byteLength = count;
        return true;
    }

    public OwnedInt32Buffer EncodeUtf8(OwnedInt32Buffer workspace)
    {
        mut OwnedInt32Buffer bytes = move workspace;
        bytes.Clear();
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        while (cursor.TryRead(out var scalar, out var next))
        {
            if (scalar < 128)
            {
                require bytes.TryAppend(scalar);
            }
            else if (scalar < 2048)
            {
                require bytes.TryAppend(192 + scalar / 64);
                require bytes.TryAppend(128 + scalar % 64);
            }
            else if (scalar < 65536)
            {
                require bytes.TryAppend(224 + scalar / 4096);
                require bytes.TryAppend(128 + (scalar / 64) % 64);
                require bytes.TryAppend(128 + scalar % 64);
            }
            else
            {
                require bytes.TryAppend(240 + scalar / 262144);
                require bytes.TryAppend(128 + (scalar / 4096) % 64);
                require bytes.TryAppend(128 + (scalar / 64) % 64);
                require bytes.TryAppend(128 + scalar % 64);
            }
            cursor = next;
        }
        return move bytes;
    }

    public bool TryGetUtf16Length(init ref<int32> unitLength)
    {
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        mut int32 count = 0;
        while (cursor.TryRead(out var scalar, out var next))
        {
            mut int32 width = 1;
            if (scalar >= 65536) { width = 2; }
            if (count > int32.MaxValue - width)
            {
                return false;
            }
            count = count + width;
            cursor = next;
        }
        unitLength = count;
        return true;
    }

    public OwnedInt32Buffer EncodeUtf16(OwnedInt32Buffer workspace)
    {
        mut OwnedInt32Buffer units = move workspace;
        units.Clear();
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        while (cursor.TryRead(out var scalar, out var next))
        {
            if (scalar >= 65536)
            {
                int32 supplementary = scalar - 65536;
                require units.TryAppend(55296 + supplementary / 1024);
                require units.TryAppend(56320 + supplementary % 1024);
            }
            else
            {
                require units.TryAppend(scalar);
            }
            cursor = next;
        }
        return move units;
    }

    public bool TryGetAsciiLength(init ref<int32> byteLength)
    {
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        mut int32 count = 0;
        while (cursor.TryRead(out var scalar, out var next))
        {
            if (scalar >= 128 || count == int32.MaxValue)
            {
                return false;
            }
            count = count + 1;
            cursor = next;
        }
        byteLength = count;
        return true;
    }

    public OwnedInt32Buffer EncodeAscii(OwnedInt32Buffer workspace)
    {
        mut OwnedInt32Buffer bytes = move workspace;
        bytes.Clear();
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        while (cursor.TryRead(out var scalar, out var next))
        {
            require scalar < 128;
            require bytes.TryAppend(scalar);
            cursor = next;
        }
        return move bytes;
    }

    public bool TryGetUtf32ByteLength(init ref<int32> byteLength)
    {
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        mut int32 count = 0;
        while (cursor.TryRead(out var scalar, out var next))
        {
            if (count > int32.MaxValue - 4)
            {
                return false;
            }
            count = count + 4;
            cursor = next;
        }
        byteLength = count;
        return true;
    }

    public OwnedInt32Buffer EncodeUtf32LeBytes(OwnedInt32Buffer workspace)
    {
        mut OwnedInt32Buffer bytes = move workspace;
        bytes.Clear();
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        while (cursor.TryRead(out var scalar, out var next))
        {
            require bytes.TryAppend(scalar % 256);
            require bytes.TryAppend((scalar / 256) % 256);
            require bytes.TryAppend((scalar / 65536) % 256);
            require bytes.TryAppend(scalar / 16777216);
            cursor = next;
        }
        return move bytes;
    }
}

public struct StringLiteralCursor
{
    private StringLiteral Literal;
    public int32 Position;

    private StringLiteralCursor(StringLiteral literal, int32 position)
    {
        Literal = literal;
        Position = position;
    }

    public static StringLiteralCursor Create(StringLiteral literal)
    {
        return new StringLiteralCursor(literal, literal.Spelling.Start + 1);
    }

    public bool TryRead(out int32 scalar, out StringLiteralCursor next)
    {
        int32 end = Literal.Spelling.End - 1;
        if (Position >= end)
        {
            return false;
        }
        require TryReadLiteralScalarAt(Position, end, out var value, out var following);
        scalar = value;
        next = new StringLiteralCursor(Literal, following);
        return true;
    }

    public bool TryReadInit(init ref<int32> scalar, init ref<StringLiteralCursor> next)
    {
        if (!TryRead(out var value, out var following))
        {
            return false;
        }
        scalar = value;
        next = following;
        return true;
    }
}

bool TryReadLiteralScalarAt(int32 at, int32 end, out int32 scalar, out int32 next)
{
    int32 first = int32(Host.Source[at]);
    if (first == 34 || IsLineBreak(Host.Source[at]))
    {
        return false;
    }

    if (first == 92)
    {
        if (end - at < 2)
        {
            return false;
        }
        int32 escape = int32(Host.Source[at + 1]);
        mut int32 value = 0;
        if (escape == 110) { value = 10; }
        else if (escape == 114) { value = 13; }
        else if (escape == 116) { value = 9; }
        else if (escape == 92) { value = 92; }
        else if (escape == 34) { value = 34; }
        else if (escape == 48) { value = 0; }
        else if (escape == 117 || escape == 85)
        {
            mut int32 digits = 4;
            if (escape == 85) { digits = 8; }
            if (end - at - 2 < digits)
            {
                return false;
            }
            mut uint32 decoded = 0;
            mut int32 index = 0;
            while (index < digits)
            {
                if (!TryGetLiteralHexDigit(Host.Source[at + 2 + index], out var digit))
                {
                    return false;
                }
                decoded = decoded * 16 + digit;
                index = index + 1;
            }
            if (decoded > 1114111 || (decoded >= 55296 && decoded <= 57343))
            {
                return false;
            }
            scalar = int32(decoded);
            next = at + 2 + digits;
            return true;
        }
        else
        {
            return false;
        }
        scalar = value;
        next = at + 2;
        return true;
    }

    if (first >= 55296 && first <= 56319)
    {
        if (end - at < 2)
        {
            return false;
        }
        int32 second = int32(Host.Source[at + 1]);
        if (second < 56320 || second > 57343)
        {
            return false;
        }
        scalar = 65536 + (first - 55296) * 1024 + second - 56320;
        next = at + 2;
        return true;
    }
    if (first >= 56320 && first <= 57343)
    {
        return false;
    }
    scalar = first;
    next = at + 1;
    return true;
}

bool TryGetLiteralHexDigit(char16 unit, out uint32 digit)
{
    if (IsAsciiDigit(unit))
    {
        digit = uint32(GetDecimalDigit(unit));
        return true;
    }
    if (unit >= 65 && unit <= 70)
    {
        digit = uint32(int32(unit) - 55);
        return true;
    }
    if (unit >= 97 && unit <= 102)
    {
        digit = uint32(int32(unit) - 87);
        return true;
    }
    return false;
}
