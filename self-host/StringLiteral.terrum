namespace Terrum.CodeAnalysis;

[Blittable]
[Layout(LayoutKind.Sequential)]
public struct StringLiteral
{
    public SourceRange Spelling;
    public int32 ScalarCount;

    private StringLiteral(SourceRange spelling, int32 scalarCount)
    {
        Spelling = spelling;
        ScalarCount = scalarCount;
    }

    public static bool TryCreate(SourceRange spelling, init ref<StringLiteral> literal)
    {
        if (spelling.Length < 2 || spelling.Start > Host.Source.Length
            || spelling.Length > Host.Source.Length - spelling.Start)
        {
            return false;
        }

        int32 end = spelling.End - 1;
        if (Host.Source[spelling.Start] != 34 || Host.Source[end] != 34)
        {
            return false;
        }

        mut int32 at = spelling.Start + 1;
        mut int32 count = 0;
        while (at < end)
        {
            if (!TryReadLiteralScalarAt(at, end, init var scalar, init var next))
            {
                return false;
            }
            at = next;
            count = count + 1;
        }

        literal = new StringLiteral(spelling, count);
        return true;
    }

    public bool TryReadScalar(int32 position, init ref<int32> scalar, init ref<int32> next)
    {
        int32 end = Spelling.End - 1;
        if (position <= Spelling.Start || position >= end)
        {
            return false;
        }

        // Rescan the prefix so an arbitrary offset cannot split an escape or pair.
        mut int32 at = Spelling.Start + 1;
        while (at <= position)
        {
            if (!TryReadLiteralScalarAt(at, end, init var value, init var following))
            {
                return false;
            }
            if (at == position)
            {
                scalar = value;
                next = following;
                return true;
            }
            at = following;
        }
        return false;
    }

    public bool TryGetUtf8Length(init ref<int32> byteLength)
    {
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        mut int32 count = 0;
        while (cursor.TryRead(init var scalar, init var next))
        {
            mut int32 width = 1;
            if (scalar >= 65536) { width = 4; }
            else if (scalar >= 2048) { width = 3; }
            else if (scalar >= 128) { width = 2; }
            if (count > int32.MaxValue - width)
            {
                return false;
            }
            count = count + width;
            cursor = next;
        }
        byteLength = count;
        return true;
    }

    public OwnedInt32Buffer EncodeUtf8(OwnedInt32Buffer workspace)
    {
        mut OwnedInt32Buffer bytes = move workspace;
        bytes.Clear();
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        while (cursor.TryRead(init var scalar, init var next))
        {
            if (scalar < 128)
            {
                require bytes.TryAppend(scalar);
            }
            else if (scalar < 2048)
            {
                require bytes.TryAppend(192 + (scalar >> 6));
                require bytes.TryAppend(128 + (scalar & 63));
            }
            else if (scalar < 65536)
            {
                require bytes.TryAppend(224 + (scalar >> 12));
                require bytes.TryAppend(128 + ((scalar >> 6) & 63));
                require bytes.TryAppend(128 + (scalar & 63));
            }
            else
            {
                require bytes.TryAppend(240 + (scalar >> 18));
                require bytes.TryAppend(128 + ((scalar >> 12) & 63));
                require bytes.TryAppend(128 + ((scalar >> 6) & 63));
                require bytes.TryAppend(128 + (scalar & 63));
            }
            cursor = next;
        }
        return move bytes;
    }

    public bool TryGetUtf16Length(init ref<int32> unitLength)
    {
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        mut int32 count = 0;
        while (cursor.TryRead(init var scalar, init var next))
        {
            mut int32 width = 1;
            if (scalar >= 65536) { width = 2; }
            if (count > int32.MaxValue - width)
            {
                return false;
            }
            count = count + width;
            cursor = next;
        }
        unitLength = count;
        return true;
    }

    public OwnedInt32Buffer EncodeUtf16(OwnedInt32Buffer workspace)
    {
        mut OwnedInt32Buffer units = move workspace;
        units.Clear();
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        while (cursor.TryRead(init var scalar, init var next))
        {
            if (scalar >= 65536)
            {
                int32 supplementary = scalar - 65536;
                require units.TryAppend(55296 + (supplementary >> 10));
                require units.TryAppend(56320 + (supplementary & 1023));
            }
            else
            {
                require units.TryAppend(scalar);
            }
            cursor = next;
        }
        return move units;
    }

    public bool TryGetUtf16ByteLength(init ref<int32> byteLength)
    {
        if (!TryGetUtf16Length(init var unitLength) || unitLength > int32.MaxValue / 2)
        {
            return false;
        }
        byteLength = unitLength * 2;
        return true;
    }

    public OwnedInt32Buffer EncodeUtf16LeBytes(OwnedInt32Buffer workspace)
    {
        mut OwnedInt32Buffer bytes = move workspace;
        bytes.Clear();
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        while (cursor.TryRead(init var scalar, init var next))
        {
            mut int32 first = scalar;
            if (scalar >= 65536)
            {
                int32 supplementary = scalar - 65536;
                first = 55296 + (supplementary >> 10);
                int32 second = 56320 + (supplementary & 1023);
                require bytes.TryAppend(first & 255);
                require bytes.TryAppend(first >> 8);
                require bytes.TryAppend(second & 255);
                require bytes.TryAppend(second >> 8);
            }
            else
            {
                require bytes.TryAppend(first & 255);
                require bytes.TryAppend(first >> 8);
            }
            cursor = next;
        }
        return move bytes;
    }

    public OwnedInt32Buffer EncodeUtf16BeBytes(OwnedInt32Buffer workspace)
    {
        mut OwnedInt32Buffer bytes = move workspace;
        bytes.Clear();
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        while (cursor.TryRead(init var scalar, init var next))
        {
            mut int32 first = scalar;
            if (scalar >= 65536)
            {
                int32 supplementary = scalar - 65536;
                first = 55296 + (supplementary >> 10);
                int32 second = 56320 + (supplementary & 1023);
                require bytes.TryAppend(first >> 8);
                require bytes.TryAppend(first & 255);
                require bytes.TryAppend(second >> 8);
                require bytes.TryAppend(second & 255);
            }
            else
            {
                require bytes.TryAppend(first >> 8);
                require bytes.TryAppend(first & 255);
            }
            cursor = next;
        }
        return move bytes;
    }

    public bool TryGetAsciiLength(init ref<int32> byteLength)
    {
        return TryGetSingleByteLength(128, init byteLength);
    }

    public bool TryGetLatin1Length(init ref<int32> byteLength)
    {
        return TryGetSingleByteLength(256, init byteLength);
    }

    private bool TryGetSingleByteLength(int32 limit, init ref<int32> byteLength)
    {
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        mut int32 count = 0;
        while (cursor.TryRead(init var scalar, init var next))
        {
            if (scalar >= limit || count == int32.MaxValue)
            {
                return false;
            }
            count = count + 1;
            cursor = next;
        }
        byteLength = count;
        return true;
    }

    public OwnedInt32Buffer EncodeAscii(OwnedInt32Buffer workspace)
    {
        return EncodeSingleByte(128, move workspace);
    }

    public OwnedInt32Buffer EncodeLatin1(OwnedInt32Buffer workspace)
    {
        return EncodeSingleByte(256, move workspace);
    }

    private OwnedInt32Buffer EncodeSingleByte(int32 limit, OwnedInt32Buffer workspace)
    {
        mut OwnedInt32Buffer bytes = move workspace;
        bytes.Clear();
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        while (cursor.TryRead(init var scalar, init var next))
        {
            require scalar < limit;
            require bytes.TryAppend(scalar);
            cursor = next;
        }
        return move bytes;
    }

    public bool TryGetUtf32ByteLength(init ref<int32> byteLength)
    {
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        mut int32 count = 0;
        while (cursor.TryRead(init var scalar, init var next))
        {
            if (count > int32.MaxValue - 4)
            {
                return false;
            }
            count = count + 4;
            cursor = next;
        }
        byteLength = count;
        return true;
    }

    public OwnedInt32Buffer EncodeUtf32LeBytes(OwnedInt32Buffer workspace)
    {
        mut OwnedInt32Buffer bytes = move workspace;
        bytes.Clear();
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        while (cursor.TryRead(init var scalar, init var next))
        {
            require bytes.TryAppend(scalar & 255);
            require bytes.TryAppend((scalar >> 8) & 255);
            require bytes.TryAppend((scalar >> 16) & 255);
            require bytes.TryAppend(scalar >> 24);
            cursor = next;
        }
        return move bytes;
    }

    public OwnedInt32Buffer EncodeUtf32BeBytes(OwnedInt32Buffer workspace)
    {
        mut OwnedInt32Buffer bytes = move workspace;
        bytes.Clear();
        mut StringLiteralCursor cursor = StringLiteralCursor.Create(this);
        while (cursor.TryRead(init var scalar, init var next))
        {
            require bytes.TryAppend(scalar >> 24);
            require bytes.TryAppend((scalar >> 16) & 255);
            require bytes.TryAppend((scalar >> 8) & 255);
            require bytes.TryAppend(scalar & 255);
            cursor = next;
        }
        return move bytes;
    }
}

[Blittable]
[Layout(LayoutKind.Sequential)]
public struct StringLiteralCursor
{
    private StringLiteral Literal;
    public int32 Position;

    private StringLiteralCursor(StringLiteral literal, int32 position)
    {
        Literal = literal;
        Position = position;
    }

    public static StringLiteralCursor Create(StringLiteral literal)
    {
        return new StringLiteralCursor(literal, literal.Spelling.Start + 1);
    }

    public bool TryRead(init ref<int32> scalar, init ref<StringLiteralCursor> next)
    {
        int32 end = Literal.Spelling.End - 1;
        if (Position >= end)
        {
            return false;
        }
        require TryReadLiteralScalarAt(Position, end, init var value, init var following);
        scalar = value;
        next = new StringLiteralCursor(Literal, following);
        return true;
    }

}

bool TryReadLiteralScalarAt(int32 at, int32 end, init ref<int32> scalar, init ref<int32> next)
{
    int32 first = int32(Host.Source[at]);
    if (first == 34 || IsLineBreak(Host.Source[at]))
    {
        return false;
    }

    if (first == 92)
    {
        require SourceRange.TryCreate(at, end - at, init var spelling);
        if (!StringEscapeDecodeResult.TryAnalyze(spelling, init var decoded)
            || decoded.ErrorCode != 0)
        {
            return false;
        }
        scalar = decoded.Scalar;
        next = at + decoded.ConsumedLength;
        return true;
    }

    if (first < 55296 || first > 57343)
    {
        scalar = first;
        next = at + 1;
        return true;
    }

    int32 decodedScalar = ReadUtf16Scalar(at, end);
    if (decodedScalar < 0)
    {
        return false;
    }
    scalar = decodedScalar;
    next = at + Utf16ScalarWidth(decodedScalar);
    return true;
}
