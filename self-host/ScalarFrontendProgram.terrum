namespace Terrum.CodeAnalysis;

// A snapshot still has at most 64 tokens including EOF. Even an empty void
// declaration needs six tokens, so ten frames cover the existing source bound.
// Each frame contains token bounds, a source span, 392 body words, and 32
// zero-based target identities (-1 for nodes other than operation 105).
// V85 is the only published program and frame tag. Operation 105 retains
// source-order call argument mappings; callable flags are source-audited.
int32 FindScalarProgramFunction(Token name)
{
    for (mut int32 index = 0; index < Host.FrontendProgram[2]; index = index + 1)
    {
        int32 header = 8 + index * 428;
        require SourceRange.TryCreate(Host.FrontendProgram[header + 9],
            Host.FrontendProgram[header + 10], init var span);
        if (SameTokenSpelling(new Token(2, span), name)) { return index; }
    }
    return -1;
}

bool ScalarProgramDefersCompletion()
{
    mut bool hasNonReturningFunction = false;
    for (mut int32 index = 0; index < Host.FrontendProgram[2]; index = index + 1)
    {
        int32 header = 8 + index * 428;
        int32 flags = Host.FrontendProgram[header + 2];
        if ((flags & 8) != 0 || Host.FrontendProgram[header + 16] != 0
            || Host.FrontendProgram[header + 17] != 0)
        {
            return false;
        }
        if ((flags & 4) != 0) { hasNonReturningFunction = true; }
    }
    return hasNonReturningFunction;
}

bool ScalarProgramError(int32 code, SourceRange span, init ref<bool> handled)
{
    for (mut int32 index = 0; index < Host.FrontendProgram.Length; index = index + 1)
    {
        Host.FrontendProgram[index] = 0;
    }
    for (mut int32 index = 0; index < Host.Frontend.Length; index = index + 1)
    {
        Host.Frontend[index] = 0;
    }
    Host.Frontend[0] = 85;
    Host.Frontend[1] = 2;
    Host.Frontend[2] = code;
    Host.Frontend[3] = span.Start;
    Host.Frontend[4] = span.Length;
    handled = true;
    return true;
}

void ClearScalarAliasTable(int32 count)
{
    for (mut int32 word = 0; word <= count * 5; word = word + 1)
    {
        Host.FrontendProgram[Host.FrontendProgram.Length - 1 - word] = 0;
    }
}

// The 64-token bound leaves at most nine function frames when aliases are present.
// An empty returned span means the alias table was built successfully.
SourceRange BuildScalarAliasTable(Span<Token> tokenView, int32 count,
    init ref<int32> aliasCount)
{
    aliasCount = 0;
    Host.FrontendProgram[Host.FrontendProgram.Length - 1] = 0;
    mut int32 at = 0;
    while (at < count - 1)
    {
        int32 declarationStart = at;
        mut bool hasAttributes = false;
        while (at < count - 1
            && TryGetScalarWindowToken(tokenView, 0, count, false, at, init var attribute)
            && attribute.Kind == 50)
        {
            hasAttributes = true;
            at = at + 1;
            while (at < count - 1
                && TryGetScalarWindowToken(tokenView, 0, count, false, at, init var part)
                && part.Kind != 51)
            {
                at = at + 1;
            }
            if (at >= count - 1
                || !TryGetScalarWindowToken(tokenView, 0, count, false, at, init var closeAttribute)
                || closeAttribute.Kind != 51)
            {
                require TryGetScalarWindowToken(tokenView, 0, count, false,
                    declarationStart, init var startToken);
                return startToken.Range;
            }
            at = at + 1;
        }

        mut int32 visibility = 0;
        while (at < count - 1
            && TryGetScalarWindowToken(tokenView, 0, count, false, at, init var modifier)
            && (modifier.Kind == 7 || modifier.Kind == 8))
        {
            if (visibility != 0)
            {
                return modifier.Range;
            }
            visibility = modifier.Kind;
            at = at + 1;
        }

        if (at < count - 1
            && TryGetScalarWindowToken(tokenView, 0, count, false, at, init var aliasToken)
            && aliasToken.Kind == 102)
        {
            if (hasAttributes || visibility == 7)
            {
                return aliasToken.Range;
            }
            if (aliasCount == 12)
            {
                return aliasToken.Range;
            }
            at = at + 1;
            if (!TryGetScalarWindowToken(tokenView, 0, count, false, at, init var name)
                || name.Kind != 2
                || !TryGetScalarWindowToken(tokenView, 0, count, false, at + 1, init var equals)
                || equals.Kind != 64
                || !TryGetScalarWindowToken(tokenView, 0, count, false, at + 2, init var target)
                || target.Kind != 2
                || !TryGetScalarWindowToken(tokenView, 0, count, false, at + 3, init var semicolon)
                || semicolon.Kind != 52)
            {
                return aliasToken.Range;
            }
            for (mut int32 index = 0; index < aliasCount; index = index + 1)
            {
                int32 entry = Host.FrontendProgram.Length - 1 - (index + 1) * 5;
                require SourceRange.TryCreate(Host.FrontendProgram[entry],
                    Host.FrontendProgram[entry + 1], init var priorName);
                if (SameTokenSpelling(name, new Token(2, priorName)))
                {
                    return name.Range;
                }
            }
            int32 entry = Host.FrontendProgram.Length - 1 - (aliasCount + 1) * 5;
            Host.FrontendProgram[entry] = name.Range.Start;
            Host.FrontendProgram[entry + 1] = name.Range.Length;
            Host.FrontendProgram[entry + 2] = target.Range.Start;
            Host.FrontendProgram[entry + 3] = target.Range.Length;
            Host.FrontendProgram[entry + 4] = 0;
            aliasCount = aliasCount + 1;
            at = at + 4;
            continue;
        }

        at = declarationStart;
        mut int32 body = at;
        while (body < count - 1
            && TryGetScalarWindowToken(tokenView, 0, count, false, body, init var headerToken)
            && headerToken.Kind != 82 && headerToken.Kind != 48)
        {
            body = body + 1;
        }
        if (body >= count - 1)
        {
            require TryGetScalarWindowToken(tokenView, 0, count, false, at,
                init var startToken);
            return startToken.Range;
        }
        require TryGetScalarWindowToken(tokenView, 0, count, false, body, init var opening);
        if (opening.Kind == 82)
        {
            at = body + 1;
            while (at < count - 1
                && TryGetScalarWindowToken(tokenView, 0, count, false, at, init var arrowToken)
                && arrowToken.Kind != 52)
            {
                at = at + 1;
            }
            if (at >= count - 1)
            {
                return opening.Range;
            }
            at = at + 1;
        }
        else
        {
            mut int32 depth = 1;
            at = body + 1;
            while (at < count - 1 && depth != 0)
            {
                require TryGetScalarWindowToken(tokenView, 0, count, false, at, init var blockToken);
                if (blockToken.Kind == 48) { depth = depth + 1; }
                if (blockToken.Kind == 49) { depth = depth - 1; }
                at = at + 1;
            }
            if (depth != 0)
            {
                return opening.Range;
            }
        }
    }

    Host.FrontendProgram[Host.FrontendProgram.Length - 1] = aliasCount;
    return ResolveScalarAliases(aliasCount);
}

SourceRange ResolveScalarAliases(int32 aliasCount)
{
    require SourceRange.TryCreate(0, 0, init var empty);
    require Host.FrontendProgram.Length == 4284 && aliasCount >= 0 && aliasCount <= 12;
    for (mut int32 index = 0; index < aliasCount; index = index + 1)
    {
        var errorSpan = ResolveScalarAlias(index, 0, aliasCount);
        if (errorSpan.Length != 0)
        {
            return errorSpan;
        }
    }
    return empty;
}

SourceRange ResolveScalarAlias(int32 index, int32 depth, int32 aliasCount)
{
    require SourceRange.TryCreate(0, 0, init var empty);
    require Host.FrontendProgram.Length == 4284 && aliasCount >= 0 && aliasCount <= 12
        && index >= 0 && index < aliasCount;
    int32 entry = Host.FrontendProgram.Length - 1 - (index + 1) * 5;
    require entry >= 0 && entry + 4 < Host.FrontendProgram.Length;
    int32 selected = Host.FrontendProgram[entry + 4];
    if (selected > 0 && selected <= 8)
    {
        return empty;
    }
    require SourceRange.TryCreate(Host.FrontendProgram[entry],
        Host.FrontendProgram[entry + 1], init var nameSpan);
    if (selected != 0 || depth >= 12)
    {
        return nameSpan;
    }
    Host.FrontendProgram[entry + 4] = -1;
    require SourceRange.TryCreate(Host.FrontendProgram[entry + 2],
        Host.FrontendProgram[entry + 3], init var targetSpan);
    var target = new Token(2, targetSpan);
    if (TryGetPrimitiveScalarType(target, init var primitive))
    {
        Host.FrontendProgram[entry + 4] = primitive;
        return empty;
    }
    for (mut int32 candidate = 0; candidate < aliasCount; candidate = candidate + 1)
    {
        int32 candidateEntry = Host.FrontendProgram.Length - 1 - (candidate + 1) * 5;
        require candidateEntry >= 0 && candidateEntry + 4 < Host.FrontendProgram.Length;
        require SourceRange.TryCreate(Host.FrontendProgram[candidateEntry],
            Host.FrontendProgram[candidateEntry + 1], init var candidateName);
        if (SameTokenSpelling(target, new Token(2, candidateName)))
        {
            var errorSpan = ResolveScalarAlias(candidate, depth + 1, aliasCount);
            if (errorSpan.Length != 0)
            {
                return errorSpan;
            }
            Host.FrontendProgram[entry + 4] =
                Host.FrontendProgram[candidateEntry + 4];
            return empty;
        }
    }
    return targetSpan;
}

bool TrySkipScalarAlias(Span<Token> tokenView, int32 count, int32 start, init ref<int32> end)
{
    mut int32 at = start;
    while (at < count - 1
        && TryGetScalarWindowToken(tokenView, 0, count, false, at, init var modifier)
        && (modifier.Kind == 7 || modifier.Kind == 8))
    {
        at = at + 1;
    }
    if (at >= count - 1
        || !TryGetScalarWindowToken(tokenView, 0, count, false, at, init var aliasToken)
        || aliasToken.Kind != 102)
    {
        return false;
    }
    while (at < count - 1
        && TryGetScalarWindowToken(tokenView, 0, count, false, at, init var token)
        && token.Kind != 52)
    {
        at = at + 1;
    }
    if (at >= count - 1)
    {
        return false;
    }
    at = at + 1;
    end = at;
    return true;
}

bool TryPublishScalarFrontendProgram(Span<Token> tokenView, int32 count,
    SourceRange spacingError, init ref<bool> handled)
{
    for (mut int32 word = 0; word < Host.FrontendProgram.Length; word = word + 1)
    {
        Host.FrontendProgram[word] = 0;
    }
    if (count > 64)
    {
        require TryGetScalarWindowToken(tokenView, 0, count, false, 64, init var excess);
        return ScalarProgramError(1, excess.Range, init handled);
    }
    if (spacingError.Length != 0) { return ScalarProgramError(1, spacingError, init handled); }
    require SourceRange.TryCreate(0, 0, init var empty);
    var aliasError = BuildScalarAliasTable(tokenView, count, init var aliasCount);
    if (aliasError.Length != 0)
    {
        return ScalarProgramError(1, aliasError, init handled);
    }
    mut int32 start = 0;
    mut int32 functions = 0;
    while (start < count - 1)
    {
        if (TrySkipScalarAlias(tokenView, count, start, init var afterAlias))
        {
            start = afterAlias;
            continue;
        }
        if (!ScalarFrontendState.TryCreate(start, count - 1, true, empty, out var probe)
            || !probe.TryInventoryHeader(init var header, init var headerEnd, tokenView))
        {
            return false;
        }
        if (!header.IsValid)
        {
            // A single declaration retains the legacy parser's diagnostics.
            if (functions == 0 && aliasCount == 0)
            {
                for (mut int32 word = 0; word < 392; word = word + 1) { Host.Frontend[word] = 0; }
                handled = false;
                return true;
            }
            return ScalarProgramError(header.ErrorCode, header.ErrorSpan, init handled);
        }
        int32 body = start + headerEnd;
        require TryGetScalarWindowToken(tokenView, 0, count, false, body, init var opening);
        mut int32 end = body;
        if (opening.Kind == 82)
        {
            while (end < count - 1)
            {
                require TryGetScalarWindowToken(tokenView, 0, count, false, end, init var token);
                end = end + 1;
                if (token.Kind == 52) { break; }
            }
        }
        else if (opening.Kind == 48)
        {
            mut int32 depth = 1;
            end = body + 1;
            while (end < count - 1 && depth != 0)
            {
                require TryGetScalarWindowToken(tokenView, 0, count, false, end, init var token);
                if (token.Kind == 48) { depth = depth + 1; }
                if (token.Kind == 49) { depth = depth - 1; }
                end = end + 1;
            }
            if (depth != 0) { return ScalarProgramError(1, opening.Range, init handled); }
        }
        else
        {
            return ScalarProgramError(1, opening.Range, init handled);
        }
        if (functions == 10) { return ScalarProgramError(1, header.Name, init handled); }
        int32 frame = 4 + functions * 428;
        require TryGetScalarWindowToken(tokenView, 0, count, false, start, init var first);
        require TryGetScalarWindowToken(tokenView, 0, count, false, end - 1, init var last);
        Host.FrontendProgram[frame] = start;
        Host.FrontendProgram[frame + 1] = end;
        Host.FrontendProgram[frame + 2] = first.Range.Start;
        Host.FrontendProgram[frame + 3] = last.Range.End - first.Range.Start;
        WriteScalarFrontendHeader(header);
        Host.Frontend[5] = header.ReturnType;
        for (mut int32 word = 0; word < 37; word = word + 1)
        {
            Host.FrontendProgram[frame + 4 + word] = Host.Frontend[word];
            Host.Frontend[word] = 0;
        }
        functions = functions + 1;
        start = end;
    }
    mut bool hasSwitch = false;
    for (mut int32 index = 0; index < count - 1; index = index + 1)
    {
        require TryGetScalarWindowToken(tokenView, 0, count, false, index, init var token);
        if (token.Kind == 35) { hasSwitch = true; }
    }
    if (functions == 0 || functions < 2 && aliasCount == 0 && !hasSwitch)
    {
        for (mut int32 word = 0; word < Host.FrontendProgram.Length; word = word + 1)
        {
            Host.FrontendProgram[word] = 0;
        }
        handled = false;
        return true;
    }
    Host.FrontendProgram[0] = 85;
    Host.FrontendProgram[2] = functions;
    for (mut int32 index = 0; index < functions; index = index + 1)
    {
        for (mut int32 node = 0; node < 32; node = node + 1)
        {
            Host.FrontendProgram[4 + index * 428 + 396 + node] = -1;
        }
    }
    for (mut int32 index = 0; index < functions; index = index + 1)
    {
        int32 header = 8 + index * 428;
        require SourceRange.TryCreate(Host.FrontendProgram[header + 9],
            Host.FrontendProgram[header + 10], init var name);
        if ((Host.FrontendProgram[header + 2] & 4) != 0
                && Host.FrontendProgram[header + 5] != 0)
        {
            return ScalarProgramError(1, name, init handled);
        }
        if (FindScalarProgramFunction(new Token(2, name)) != index)
        {
            return ScalarProgramError(4, name, init handled);
        }
    }
    if (!TokenIntegerSnapshot.TryValidate(count))
    {
        return false;
    }
    for (mut int32 index = 0; index < functions; index = index + 1)
    {
        int32 frame = 4 + index * 428;
        Host.FrontendProgram[3] = index;
        for (mut int32 word = 0; word < 392; word = word + 1) { Host.Frontend[word] = 0; }
        int32 tokenStart = Host.FrontendProgram[frame];
        int32 tokenEnd = Host.FrontendProgram[frame + 1];
        if (!ScalarFrontendState.TryCreate(tokenStart, tokenEnd, true, empty, out var tree)
            || !tree.TryParseTree(init var treeResult, tokenView))
        {
            return false;
        }
        mut ScalarFrontendResult result = treeResult;
        if (!result.IsValid)
        {
            for (mut int32 word = 0; word < 392; word = word + 1) { Host.Frontend[word] = 0; }
            for (mut int32 node = 0; node < 32; node = node + 1)
            {
                Host.FrontendProgram[frame + 396 + node] = -1;
            }
            if (!ScalarFrontendState.TryCreate(tokenStart, tokenEnd, true, empty, out var structured)
                || !structured.TryParseStructuredReturns(init var completed, tokenView))
            {
                return false;
            }
            result = completed;
        }
        if (!result.IsValid)
        {
            return ScalarProgramError(result.ErrorCode, result.ErrorSpan, init handled);
        }
        WriteScalarFrontendHeader(result);
        Host.Frontend[0] = 85;
        Host.Frontend[1] = 1;
        Host.Frontend[5] = result.ReturnType;
        Host.Frontend[15] = result.HasCondition ? (result.HasFallthrough ? 2 : 1) : 0;
        for (mut int32 word = 0; word < 392; word = word + 1)
        {
            Host.FrontendProgram[frame + 4 + word] = Host.Frontend[word];
        }
    }
    for (mut int32 word = 0; word < 392; word = word + 1) { Host.Frontend[word] = 0; }
    // Without aliases, word 4283 may be the tenth frame's final call-target slot.
    if (aliasCount != 0) { ClearScalarAliasTable(aliasCount); }
    Host.FrontendProgram[1] = 1;
    Host.FrontendProgram[3] = 0;
    handled = true;
    return true;
}
