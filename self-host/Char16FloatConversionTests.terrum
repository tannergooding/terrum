namespace Terrum.CodeAnalysis.Tests;

public bool CheckChar16FloatConversion()
{
    // Every unsigned 16-bit code unit is exactly representable in both formats.
    mut uint32 codeUnit = 0;
    while (codeUnit <= 65535)
    {
        char16 value = char16(codeUnit);
        if (Char16ToFloat32Bits(value) != ExpectedFloat32Bits(codeUnit)
            || Char16ToFloat64Bits(value) != ExpectedFloat64Bits(codeUnit))
        {
            return false;
        }

        codeUnit = codeUnit + 1;
    }

    return true;
}

uint32 ExpectedFloat32Bits(uint32 value)
{
    if (value == 0)
    {
        return 0;
    }

    mut uint32 leadingBit = 1;
    mut int32 exponent = 0;
    while (leadingBit <= (value >> 1))
    {
        leadingBit = leadingBit << 1;
        exponent = exponent + 1;
    }

    uint32 fraction = (value - leadingBit) << (23 - exponent);
    return (uint32(exponent + 127) << 23) | fraction;
}

uint64 ExpectedFloat64Bits(uint32 value)
{
    if (value == 0)
    {
        return 0;
    }

    mut uint32 leadingBit = 1;
    mut int32 exponent = 0;
    while (leadingBit <= (value >> 1))
    {
        leadingBit = leadingBit << 1;
        exponent = exponent + 1;
    }

    uint64 fraction = uint64(value - leadingBit) << (52 - exponent);
    return (uint64(exponent + 1023) << 52) | fraction;
}
