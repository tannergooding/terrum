namespace Terrum.CodeAnalysis;

bool TokensAttach(Token receiver, Token opener)
{
    return receiver.Range.End == opener.Range.Start;
}

// Scalar type codes: 1=int32, 2=uint32, 3=int64, 4=uint64, 5=bool,
// 6=char16, 7=float32, 8=float64.
bool TryGetScalarType(Token type, out int32 scalarType)
{
    if (type.Kind != 2)
    {
        return false;
    }

    int32 at = type.Range.Start;
    mut int32 selected = 0;
    if (type.Range.Length == 4 && Host.Source[at] == char16(98)
        && Host.Source[at + 1] == char16(111)
        && Host.Source[at + 2] == char16(111)
        && Host.Source[at + 3] == char16(108))
    {
        selected = 5;
    }
    else if (type.Range.Length == 5 && Host.Source[at] == char16(105)
        && Host.Source[at + 1] == char16(110) && Host.Source[at + 2] == char16(116))
    {
        if (Host.Source[at + 3] == char16(51) && Host.Source[at + 4] == char16(50))
        {
            selected = 1;
        }
        else if (Host.Source[at + 3] == char16(54) && Host.Source[at + 4] == char16(52))
        {
            selected = 3;
        }
    }
    else if (type.Range.Length == 6 && Host.Source[at] == char16(117)
        && Host.Source[at + 1] == char16(105) && Host.Source[at + 2] == char16(110)
        && Host.Source[at + 3] == char16(116))
    {
        if (Host.Source[at + 4] == char16(51) && Host.Source[at + 5] == char16(50))
        {
            selected = 2;
        }
        else if (Host.Source[at + 4] == char16(54) && Host.Source[at + 5] == char16(52))
        {
            selected = 4;
        }
    }
    else if (type.Range.Length == 6 && Host.Source[at] == char16(99)
        && Host.Source[at + 1] == char16(104) && Host.Source[at + 2] == char16(97)
        && Host.Source[at + 3] == char16(114) && Host.Source[at + 4] == char16(49)
        && Host.Source[at + 5] == char16(54))
    {
        selected = 6;
    }
    else if (type.Range.Length == 7 && Host.Source[at] == char16(102)
        && Host.Source[at + 1] == char16(108) && Host.Source[at + 2] == char16(111)
        && Host.Source[at + 3] == char16(97) && Host.Source[at + 4] == char16(116))
    {
        if (Host.Source[at + 5] == char16(51) && Host.Source[at + 6] == char16(50))
        {
            selected = 7;
        }
        else if (Host.Source[at + 5] == char16(54) && Host.Source[at + 6] == char16(52))
        {
            selected = 8;
        }
    }
    if (selected == 0)
    {
        return false;
    }
    scalarType = selected;
    return true;
}

bool SameTokenSpelling(Token first, Token second)
{
    // Snapshot validation already establishes valid escapes. Compare identity
    // without changing the source-owned token ranges used by the projection.
    if (first.Kind != 2 || second.Kind != 2)
    {
        return false;
    }
    mut int32 firstStart = first.Range.Start;
    mut int32 secondStart = second.Range.Start;
    if (first.Range.Length > 0 && Host.Source[firstStart] == char16(64))
    {
        firstStart = firstStart + 1;
    }
    if (second.Range.Length > 0 && Host.Source[secondStart] == char16(64))
    {
        secondStart = secondStart + 1;
    }
    int32 length = first.Range.End - firstStart;
    if (length != second.Range.End - secondStart)
    {
        return false;
    }
    for (mut int32 index = 0; index < length; index = index + 1)
    {
        if (Host.Source[firstStart + index] != Host.Source[secondStart + index])
        {
            return false;
        }
    }
    return true;
}

bool IsBasedInteger(Token literal)
{
    int32 start = literal.Range.Start;
    return literal.Range.Length >= 2 && Host.Source[start] == char16(48)
        && (Host.Source[start + 1] == char16(120)
            || Host.Source[start + 1] == char16(88)
            || Host.Source[start + 1] == char16(98)
            || Host.Source[start + 1] == char16(66));
}

uint64 DecodeScannerMagnitude(int32 low, int32 high)
{
    // Restore each unsigned half before combining it at the 2^32 place value.
    mut int64 lowBits = int64(low);
    mut int64 highBits = int64(high);
    if (low < 0)
    {
        lowBits = lowBits + 4294967296;
    }
    if (high < 0)
    {
        highBits = highBits + 4294967296;
    }
    return uint64(highBits) * 4294967296 + uint64(lowBits);
}

bool TryDecodeSigned64Scalar(uint64 magnitude, bool based, out int64 value)
{
    uint64 signBit = uint64(int64.MaxValue) + 1;
    if (!based && magnitude > uint64(int64.MaxValue))
    {
        return false;
    }
    if (magnitude >= signBit)
    {
        value = int64(magnitude - signBit) + int64.MinValue;
    }
    else
    {
        value = int64(magnitude);
    }
    return true;
}

bool EvaluateScalarComparison(int32 operation, bool equal, bool less, bool greater)
{
    return operation == 65 && equal
        || operation == 66 && !equal
        || operation == 67 && less
        || operation == 68 && !greater
        || operation == 69 && greater
        || operation == 70 && !less;
}

bool TryAddScalarInt32(int32 first, int32 second, out int32 sum)
{
    int64 wide = int64(first) + int64(second);
    if (wide < int64(int32.MinValue) || wide > int64(int32.MaxValue))
    {
        return false;
    }
    sum = int32(wide);
    return true;
}

bool TryAddScalarUInt32(uint32 first, uint32 second, out uint32 sum)
{
    uint64 wide = uint64(first) + uint64(second);
    if (wide > uint64(uint32.MaxValue))
    {
        return false;
    }
    sum = uint32(wide);
    return true;
}

bool TryAddScalarInt64(int64 first, int64 second, out int64 sum)
{
    if ((second > 0 && first > int64.MaxValue - second)
        || (second < 0 && first < int64.MinValue - second))
    {
        return false;
    }
    sum = first + second;
    return true;
}

bool TryAddScalarUInt64(uint64 first, uint64 second, out uint64 sum)
{
    if (first > uint64.MaxValue - second)
    {
        return false;
    }
    sum = first + second;
    return true;
}
