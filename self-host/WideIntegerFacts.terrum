namespace Terrum.CodeAnalysis.Numerics64;

public static bool TryAdd(int64 left, int64 right, out int64 result)
{
    if (right > 0 && left > int64.MaxValue - right)
    {
        return false;
    }

    if (right < 0 && left < int64.MinValue - right)
    {
        return false;
    }

    result = left + right;

    return true;
}

public static bool TrySubtract(int64 left, int64 right, out int64 result)
{
    if (right < 0 && left > int64.MaxValue + right)
    {
        return false;
    }

    if (right > 0 && left < int64.MinValue + right)
    {
        return false;
    }

    result = left - right;
    return true;
}

public static bool TryMultiply(int64 left, int64 right, out int64 result)
{
    if (left > 0)
    {
        if (right > 0 && left > int64.MaxValue / right)
        {
            return false;
        }
        if (right < 0 && right < int64.MinValue / left)
        {
            return false;
        }
    }
    else if (left < 0)
    {
        if (right > 0 && left < int64.MinValue / right)
        {
            return false;
        }
        if (right < 0 && left < int64.MaxValue / right)
        {
            return false;
        }
    }

    result = left * right;
    return true;
}

public static bool TryAddInt64(int64 left, int64 right, init ref<int64> result)
{
    if (!TryAdd(left, right, out var value))
    {
        return false;
    }

    result = value;
    return true;
}

public static bool TrySubtractInt64(int64 left, int64 right, init ref<int64> result)
{
    if (!TrySubtract(left, right, out var value))
    {
        return false;
    }

    result = value;
    return true;
}

public static bool TryNegateInt64(int64 value, init ref<int64> result)
{
    return TrySubtractInt64(0, value, init result);
}

public static bool TryAbsoluteInt64(int64 value, init ref<int64> result)
{
    if (value >= 0)
    {
        result = value;
        return true;
    }

    return TryNegateInt64(value, init result);
}

public static uint64 MagnitudeInt64(int64 value)
{
    if (value < 0)
    {
        return uint64(-(value + 1)) + 1;
    }

    return uint64(value);
}

public static bool TryMultiplyInt64(int64 left, int64 right, init ref<int64> result)
{
    if (!TryMultiply(left, right, out var value))
    {
        return false;
    }

    result = value;
    return true;
}

public static bool TryAddUInt64(uint64 left, uint64 right, init ref<uint64> result)
{
    if (left > uint64.MaxValue - right)
    {
        return false;
    }

    result = left + right;
    return true;
}

public static bool TrySubtractUInt64(uint64 left, uint64 right, init ref<uint64> result)
{
    if (left < right)
    {
        return false;
    }

    result = left - right;
    return true;
}

public static bool TryMultiplyUInt64(uint64 left, uint64 right, init ref<uint64> result)
{
    if (right != 0 && left > uint64.MaxValue / right)
    {
        return false;
    }

    result = left * right;
    return true;
}

public static bool TryDivideInt64(int64 left, int64 right, init ref<int64> result)
{
    if (right == 0 || (left == int64.MinValue && right == -1))
    {
        return false;
    }

    result = left / right;
    return true;
}

public static bool TryRemainderInt64(int64 left, int64 right, init ref<int64> result)
{
    if (right == 0)
    {
        return false;
    }

    if (left == int64.MinValue && right == -1)
    {
        result = 0;
        return true;
    }

    result = left % right;
    return true;
}

public static bool TryDivideUInt64(uint64 left, uint64 right, init ref<uint64> result)
{
    if (right == 0)
    {
        return false;
    }

    result = left / right;
    return true;
}

public static bool TryRemainderUInt64(uint64 left, uint64 right, init ref<uint64> result)
{
    if (right == 0)
    {
        return false;
    }

    result = left % right;
    return true;
}

public static bool TryAccumulateDecimal(uint64 value, uint32 digit, uint64 maximum,
    init ref<uint64> result)
{
    uint64 widenedDigit = uint64(digit);
    if (digit > 9 || maximum < widenedDigit)
    {
        return false;
    }

    // Rearranging the bound keeps both the check and the accepted update in range.
    if (value > (maximum - widenedDigit) / 10)
    {
        return false;
    }

    result = value * 10 + widenedDigit;

    return true;
}

public static bool TryAccumulateBase(uint64 value, uint32 digit, uint32 radix, uint64 maximum,
    init ref<uint64> result)
{
    if (radix < 2 || radix > 36 || digit >= radix)
    {
        return false;
    }

    if (radix == 10)
    {
        if (!TryAccumulateDecimal(value, digit, maximum, init var decimalResult))
        {
            return false;
        }
        result = decimalResult;
        return true;
    }

    uint64 widenedDigit = uint64(digit);
    if (maximum < widenedDigit || value > (maximum - widenedDigit) / uint64(radix))
    {
        return false;
    }

    result = value * uint64(radix) + widenedDigit;
    return true;
}
