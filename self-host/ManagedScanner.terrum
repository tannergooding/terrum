namespace Terrum.CodeAnalysis;

// Only a complete, validated snapshot of the fixed host records escapes.
bool TryBuildManagedTokenChain(int32 count, init ref<write ManagedTokenChain> result)
{
    if (Host.Diagnostics[0] != 0 || count < 1 || count > 64
        || count * 3 > Host.Tokens.Length)
    {
        return false;
    }
    if (!ManagedTokenChain.TryCreate(out var chain))
    {
        return false;
    }

    mut int32 previousEnd = 0;
    for (mut int32 index = 0; index < count; index = index + 1)
    {
        int32 kind = Host.Tokens[index * 3];
        int32 start = Host.Tokens[index * 3 + 1];
        int32 length = Host.Tokens[index * 3 + 2];
        if (start < previousEnd || start > Host.Source.Length
            || length < 0 || length > Host.Source.Length - start)
        {
            return false;
        }
        if (index == count - 1)
        {
            if (kind != 0 || start != Host.Source.Length || length != 0)
            {
                return false;
            }
        }
        else if (kind <= 0)
        {
            return false;
        }
        if (!chain.TryAppend(kind, start, length))
        {
            return false;
        }
        previousEnd = start + length;
    }

    result = chain;
    return true;
}

bool TryScanManaged(init ref<write ManagedTokenChain> result)
{
    int32 count = Scan();
    if (!TryBuildManagedTokenChain(count, init var chain))
    {
        return false;
    }
    result = chain;
    return true;
}

bool TryScanManagedCursor(init ref<write ManagedTokenCursor> result)
{
    if (!TryScanManaged(init var chain))
    {
        return false;
    }
    return chain.TryCreateCursorInit(init result);
}
