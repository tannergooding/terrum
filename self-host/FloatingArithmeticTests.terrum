namespace Terrum.CodeAnalysis.Tests;

bool IsFloat32NaNBits(uint32 bits)
{
    return (bits & 0x7F800000) == 0x7F800000
        && (bits & 0x007FFFFF) != 0;
}

bool IsFloat64NaNBits(uint64 bits)
{
    return (bits & 0x7FF0000000000000) == 0x7FF0000000000000
        && (bits & 0x000FFFFFFFFFFFFF) != 0;
}

public bool CheckFloatingArithmetic()
{
    if (Float32AddBits(0x3FC00000, 0x40100000) != 0x40700000
        || Float32MultiplyBits(0x3FC00000, 0x3FA00000) != 0x3FF00000
        || Float32MultiplyBits(0x3F800001, 0x3FC00000) != 0x3FC00002
        || Float32MultiplyBits(0x3F800003, 0x3FC00000) != 0x3FC00004
        || Float32MultiplyBits(0x3F800001, 0x3FFFFFFE) != 0x40000000
        || Float32DivideBits(0x40C00000, 0x40000000) != 0x40400000
        || Float32DivideBits(0x3F800000, 0x40400000) != 0x3EAAAAAB
        || Float32DivideBits(0x3FCDA5E7, 0x3FFA0242) != 0x3F529381
        || Float32SubtractBits(0x40800000, 0x3FC00000) != 0x40200000
        || Float32AddBits(0x3F800000, 0x33800000) != 0x3F800000
        || Float32AddBits(0x3F800001, 0x33800000) != 0x3F800002
        || Float32MultiplyBits(0x00000001, 0x3F000000) != 0
        || Float32MultiplyBits(0x00000002, 0x3F000000) != 0x00000001
        || Float32MultiplyBits(0x00000003, 0x3F000000) != 0x00000002
        || Float32MultiplyBits(0x00000004, 0x3F000000) != 0x00000002
        || Float32MultiplyBits(0x00000005, 0x3F000000) != 0x00000002
        || Float32DivideBits(0x00000001, 0x40000000) != 0
        || Float32DivideBits(0x00000002, 0x40000000) != 0x00000001
        || Float32DivideBits(0x00000003, 0x40000000) != 0x00000002
        || Float32DivideBits(0x00000005, 0x40000000) != 0x00000002
        || Float32DivideBits(0x00000001, 0x3FFFFFFF) != 0x00000001
        || Float32DivideBits(0x00000001, 0x40000001) != 0
        || Float32DivideBits(0x00000001, 0x00800000) != 0x34000000
        || Float32DivideBits(0x00800000, 0x00000001) != 0x4B000000
        || Float32DivideBits(0x007FFFFF, 0x00000001) != 0x4AFFFFFE
        || Float32SubtractBits(0x00800000, 0x007FFFFF) != 0x00000001
        || Float32AddBits(0x007FFFFF, 0x00000001) != 0x00800000
        || Float32MultiplyBits(0x00FFFFFF, 0x3F000000) != 0x00800000
        || Float32MultiplyBits(0x00000001, 0x7F000000) != 0x34800000
        || Float32DivideBits(0x00FFFFFF, 0x40000000) != 0x00800000
        || Float32DivideBits(0x00FFFFFE, 0x40000000) != 0x007FFFFF
        || Float32DivideBits(0x00000001, 0x7F000000) != 0
        || Float32DivideBits(0x7F7FFFFF, 0x00000001) != 0x7F800000
        || Float32MultiplyBits(0x00800000, 0x3F7FFFFF) != 0x00800000
        || Float32MultiplyBits(0x00800000, 0x3F7FFFFE) != 0x007FFFFF
        || Float32MultiplyBits(0x7F7FFFFF, 0x40000000) != 0x7F800000
        || Float32AddBits(0x80000000, 0x80000000) != 0x80000000
        || Float32SubtractBits(0x80000000, 0x00000000) != 0x80000000
        || Float32MultiplyBits(0x80000000, 0xC0000000) != 0
        || !IsFloat32NaNBits(Float32MultiplyBits(0x00000000, 0x7F800000))
        || Float32MultiplyBits(0x7F800000, 0xC0000000) != 0xFF800000
        || Float32MultiplyBits(0x7FC12345, 0x3F800000) != 0x7FC12345
        || Float32DivideBits(0x80000000, 0xBF800000) != 0
        || Float32DivideBits(0x3F800000, 0) != 0x7F800000
        || Float32DivideBits(0xBF800000, 0) != 0xFF800000
        || !IsFloat32NaNBits(Float32DivideBits(0, 0))
        || !IsFloat32NaNBits(Float32DivideBits(0x7F800000, 0x7F800000))
        || Float32DivideBits(0x7F800000, 0xBF800000) != 0xFF800000
        || Float32DivideBits(0x3F800000, 0xFF800000) != 0x80000000
        || Float32SubtractBits(0x3F800000, 0x3F800000) != 0
        || Float32AddBits(0x7F800000, 0xBF800000) != 0x7F800000
        || Float32SubtractBits(0xFF800000, 0x3F800000) != 0xFF800000
        || !IsFloat32NaNBits(Float32AddBits(0x7F800000, 0xFF800000))
        || Float32AddBits(0x7F800001, 0x3F800000) != 0x7FC00001
        || Float32AddBits(0x7F7FFFFF, 0x72FFFFFF) != 0x7F7FFFFF
        || Float32AddBits(0x7F7FFFFF, 0x73000000) != 0x7F800000
        || Float32AddBits(0x7F7FFFFF, 0x73000001) != 0x7F800000)
    {
        return false;
    }

    if (Float64AddBits(0x3FF8000000000000, 0x4002000000000000) != 0x400E000000000000
        || Float64MultiplyBits(0x3FF8000000000000, 0x3FF4000000000000) != 0x3FFE000000000000
        || Float64MultiplyBits(0x3FF0000000000001, 0x3FF8000000000000) != 0x3FF8000000000002
        || Float64MultiplyBits(0x3FF0000000000003, 0x3FF8000000000000) != 0x3FF8000000000004
        || Float64MultiplyBits(0x3FF0000000000001, 0x3FFFFFFFFFFFFFFE) != 0x4000000000000000
        || Float64DivideBits(0x4018000000000000, 0x4000000000000000) != 0x4008000000000000
        || Float64DivideBits(0x3FF0000000000000, 0x4008000000000000) != 0x3FD5555555555555
        || Float64DivideBits(0x3FF63A160589F877, 0x3FFF55E11FB797FA) != 0x3FE6B2C19085DE11
        || Float64SubtractBits(0x4010000000000000, 0x3FF8000000000000) != 0x4004000000000000
        || Float64AddBits(0x3FF0000000000000, 0x3CA0000000000000) != 0x3FF0000000000000
        || Float64AddBits(0x3FF0000000000001, 0x3CA0000000000000) != 0x3FF0000000000002
        || Float64MultiplyBits(0x0000000000000001, 0x3FE0000000000000) != 0
        || Float64MultiplyBits(0x0000000000000002, 0x3FE0000000000000) != 0x0000000000000001
        || Float64MultiplyBits(0x0000000000000003, 0x3FE0000000000000) != 0x0000000000000002
        || Float64MultiplyBits(0x0000000000000004, 0x3FE0000000000000) != 0x0000000000000002
        || Float64MultiplyBits(0x0000000000000005, 0x3FE0000000000000) != 0x0000000000000002
        || Float64DivideBits(0x0000000000000001, 0x4000000000000000) != 0
        || Float64DivideBits(0x0000000000000002, 0x4000000000000000) != 0x0000000000000001
        || Float64DivideBits(0x0000000000000003, 0x4000000000000000) != 0x0000000000000002
        || Float64DivideBits(0x0000000000000005, 0x4000000000000000) != 0x0000000000000002
        || Float64DivideBits(0x0000000000000001, 0x3FFFFFFFFFFFFFFF) != 0x0000000000000001
        || Float64DivideBits(0x0000000000000001, 0x4000000000000000) != 0
        || Float64DivideBits(0x0000000000000001, 0x4000000000000001) != 0
        || Float64DivideBits(0x0000000000000001, 0x0010000000000000) != 0x3CB0000000000000
        || Float64DivideBits(0x0010000000000000, 0x0000000000000001) != 0x4330000000000000
        || Float64DivideBits(0x000FFFFFFFFFFFFF, 0x0000000000000001) != 0x432FFFFFFFFFFFFE
        || Float64SubtractBits(0x0010000000000000, 0x000FFFFFFFFFFFFF) != 0x0000000000000001
        || Float64AddBits(0x000FFFFFFFFFFFFF, 0x0000000000000001) != 0x0010000000000000
        || Float64MultiplyBits(0x0010000000000000, 0x3FEFFFFFFFFFFFFF) != 0x0010000000000000
        || Float64MultiplyBits(0x0010000000000000, 0x3FEFFFFFFFFFFFFE) != 0x000FFFFFFFFFFFFF
        || Float64MultiplyBits(0x001FFFFFFFFFFFFF, 0x3FE0000000000000) != 0x0010000000000000
        || Float64MultiplyBits(0x0000000000000001, 0x7FE0000000000000) != 0x3CC0000000000000
        || Float64DivideBits(0x001FFFFFFFFFFFFF, 0x4000000000000000) != 0x0010000000000000
        || Float64DivideBits(0x001FFFFFFFFFFFFE, 0x4000000000000000) != 0x000FFFFFFFFFFFFF
        || Float64DivideBits(0x0000000000000001, 0x7FE0000000000000) != 0
        || Float64DivideBits(0x7FEFFFFFFFFFFFFF, 0x0000000000000001) != 0x7FF0000000000000
        || Float64MultiplyBits(0x7FEFFFFFFFFFFFFF, 0x4000000000000000) != 0x7FF0000000000000
        || Float64AddBits(0x8000000000000000, 0x8000000000000000) != 0x8000000000000000
        || Float64SubtractBits(0x8000000000000000, 0) != 0x8000000000000000
        || Float64MultiplyBits(0x8000000000000000, 0xC000000000000000) != 0
        || !IsFloat64NaNBits(Float64MultiplyBits(0, 0x7FF0000000000000))
        || Float64MultiplyBits(0x7FF0000000000000, 0xC000000000000000) != 0xFFF0000000000000
        || Float64MultiplyBits(0x7FF8000000001234, 0x3FF0000000000000) != 0x7FF8000000001234
        || Float64DivideBits(0x8000000000000000, 0xBFF0000000000000) != 0
        || Float64DivideBits(0x3FF0000000000000, 0) != 0x7FF0000000000000
        || Float64DivideBits(0xBFF0000000000000, 0) != 0xFFF0000000000000
        || !IsFloat64NaNBits(Float64DivideBits(0, 0))
        || !IsFloat64NaNBits(Float64DivideBits(0x7FF0000000000000, 0x7FF0000000000000))
        || Float64DivideBits(0x7FF0000000000000, 0xBFF0000000000000) != 0xFFF0000000000000
        || Float64DivideBits(0x3FF0000000000000, 0xFFF0000000000000) != 0x8000000000000000
        || Float64SubtractBits(0x3FF0000000000000, 0x3FF0000000000000) != 0
        || Float64AddBits(0x7FF0000000000000, 0xBFF0000000000000) != 0x7FF0000000000000
        || Float64SubtractBits(0xFFF0000000000000, 0x3FF0000000000000) != 0xFFF0000000000000
        || !IsFloat64NaNBits(Float64AddBits(0x7FF0000000000000, 0xFFF0000000000000))
        || Float64AddBits(0xFFF0000000000001, 0x3FF0000000000000) != 0xFFF8000000000001
        || Float64AddBits(0x7FEFFFFFFFFFFFFF, 0x7C8FFFFFFFFFFFFF) != 0x7FEFFFFFFFFFFFFF
        || Float64AddBits(0x7FEFFFFFFFFFFFFF, 0x7C90000000000000) != 0x7FF0000000000000
        || Float64AddBits(0x7FEFFFFFFFFFFFFF, 0x7C90000000000001) != 0x7FF0000000000000)
    {
        return false;
    }

    return true;
}

public bool CheckFloat32Division()
{
    return Float32DivideBits(0x40C00000, 0x40000000) == 0x40400000
        && Float32DivideBits(0x3F800000, 0x40400000) == 0x3EAAAAAB
        && Float32DivideBits(0x3FCDA5E7, 0x3FFA0242) == 0x3F529381
        && Float32DivideBits(0x00000001, 0x40000000) == 0
        && Float32DivideBits(0x00000002, 0x40000000) == 0x00000001
        && Float32DivideBits(0x00000003, 0x40000000) == 0x00000002
        && Float32DivideBits(0x00000005, 0x40000000) == 0x00000002
        && Float32DivideBits(0x00000001, 0x3FFFFFFF) == 0x00000001
        && Float32DivideBits(0x00000001, 0x40000001) == 0
        && Float32DivideBits(0x00000001, 0x00800000) == 0x34000000
        && Float32DivideBits(0x00800000, 0x00000001) == 0x4B000000
        && Float32DivideBits(0x007FFFFF, 0x00000001) == 0x4AFFFFFE
        && Float32DivideBits(0x00FFFFFF, 0x40000000) == 0x00800000
        && Float32DivideBits(0x00FFFFFE, 0x40000000) == 0x007FFFFF
        && Float32DivideBits(0x00000001, 0x7F000000) == 0
        && Float32DivideBits(0x7F7FFFFF, 0x00000001) == 0x7F800000
        && Float32DivideBits(0x80000000, 0xBF800000) == 0
        && Float32DivideBits(0x3F800000, 0) == 0x7F800000
        && Float32DivideBits(0xBF800000, 0) == 0xFF800000
        && IsFloat32NaNBits(Float32DivideBits(0, 0))
        && IsFloat32NaNBits(Float32DivideBits(0x7F800000, 0x7F800000))
        && Float32DivideBits(0x7F800000, 0xBF800000) == 0xFF800000
        && Float32DivideBits(0x3F800000, 0xFF800000) == 0x80000000;
}

public bool CheckFloat64DivisionA()
{
    return Float64DivideBits(0x4018000000000000, 0x4000000000000000) == 0x4008000000000000
        && Float64DivideBits(0x3FF0000000000000, 0x4008000000000000) == 0x3FD5555555555555
        && Float64DivideBits(0x3FF63A160589F877, 0x3FFF55E11FB797FA) == 0x3FE6B2C19085DE11
        && Float64DivideBits(0x0000000000000001, 0x4000000000000000) == 0
        && Float64DivideBits(0x0000000000000002, 0x4000000000000000) == 0x0000000000000001
        && Float64DivideBits(0x0000000000000003, 0x4000000000000000) == 0x0000000000000002
        && Float64DivideBits(0x0000000000000005, 0x4000000000000000) == 0x0000000000000002
        && Float64DivideBits(0x0000000000000001, 0x3FFFFFFFFFFFFFFF) == 0x0000000000000001
        && Float64DivideBits(0x0000000000000001, 0x4000000000000001) == 0;
}

public bool CheckFloat64DivisionA2()
{
    return Float64DivideBits(0x0000000000000001, 0x0010000000000000) == 0x3CB0000000000000
        && Float64DivideBits(0x0010000000000000, 0x0000000000000001) == 0x4330000000000000
        && Float64DivideBits(0x000FFFFFFFFFFFFF, 0x0000000000000001) == 0x432FFFFFFFFFFFFE;
}

public bool CheckFloat64DivisionB()
{
    return Float64DivideBits(0x001FFFFFFFFFFFFF, 0x4000000000000000) == 0x0010000000000000
        && Float64DivideBits(0x001FFFFFFFFFFFFE, 0x4000000000000000) == 0x000FFFFFFFFFFFFF
        && Float64DivideBits(0x0000000000000001, 0x7FE0000000000000) == 0
        && Float64DivideBits(0x7FEFFFFFFFFFFFFF, 0x0000000000000001) == 0x7FF0000000000000
        && Float64DivideBits(0x8000000000000000, 0xBFF0000000000000) == 0
        && Float64DivideBits(0x3FF0000000000000, 0) == 0x7FF0000000000000
        && Float64DivideBits(0xBFF0000000000000, 0) == 0xFFF0000000000000
        && IsFloat64NaNBits(Float64DivideBits(0, 0))
        && IsFloat64NaNBits(Float64DivideBits(0x7FF0000000000000, 0x7FF0000000000000))
        && Float64DivideBits(0x7FF0000000000000, 0xBFF0000000000000) == 0xFFF0000000000000
        && Float64DivideBits(0x3FF0000000000000, 0xFFF0000000000000) == 0x8000000000000000;
}
