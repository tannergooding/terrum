namespace Terrum.CodeAnalysis;

bool TryMeasureStringRow(StringLiteral literal, int32 flags,
    init ref<int32> contentBytes, init ref<int32> unitWidth, init ref<int32> rowBytes)
{
    return TryMeasureStringRowCore(literal, flags, true, false, init contentBytes,
        init unitWidth, init rowBytes);
}

bool TryMeasureStringTextRow(StringLiteral literal, int32 flags, bool allowEmpty,
    init ref<int32> contentBytes, init ref<int32> unitWidth, init ref<int32> rowBytes)
{
    return TryMeasureStringRowCore(literal, flags, allowEmpty, true, init contentBytes,
        init unitWidth, init rowBytes);
}

bool TryMeasureStringRowCore(StringLiteral literal, int32 flags, bool allowEmpty,
    bool rejectEmbeddedZero, init ref<int32> contentBytes, init ref<int32> unitWidth,
    init ref<int32> rowBytes)
{
    mut int32 bytes = 0;
    mut int32 width = 1;
    if (flags == 2) { width = 2; }
    else if (flags == 3) { width = 4; }
    else if (flags != 0 && flags != 1)
    {
        return false;
    }

    if (!allowEmpty && literal.ScalarCount == 0)
    {
        return false;
    }
    mut StringLiteralCursor cursor = StringLiteralCursor.Create(literal);
    while (cursor.TryRead(init var scalar, init var next))
    {
        if (rejectEmbeddedZero && scalar == 0)
        {
            return false;
        }
        mut int32 scalarBytes = 1;
        if (flags == 0)
        {
            if (scalar >= 128) { return false; }
        }
        else if (flags == 1)
        {
            if (scalar >= 65536) { scalarBytes = 4; }
            else if (scalar >= 2048) { scalarBytes = 3; }
            else if (scalar >= 128) { scalarBytes = 2; }
        }
        else if (flags == 2)
        {
            scalarBytes = scalar >= 65536 ? 4 : 2;
        }
        else
        {
            scalarBytes = 4;
        }
        if (bytes > int32.MaxValue - scalarBytes)
        {
            return false;
        }
        bytes = bytes + scalarBytes;
        cursor = next;
    }
    if (bytes / width > 16777215)
    {
        return false;
    }
    int32 extent = 4 + bytes + width;
    contentBytes = bytes;
    unitWidth = width;
    rowBytes = extent + ((4 - (extent & 3)) & 3);
    return true;
}

public static bool TryGetStringRowByteLength(StringLiteral literal, int32 flags,
    init ref<int32> byteLength)
{
    if (!TryMeasureStringRow(literal, flags, init var contentBytes, init var unitWidth,
        init var rowBytes))
    {
        return false;
    }
    byteLength = rowBytes;
    return true;
}

public static bool TryGetStringNameRowByteLength(StringLiteral literal, int32 flags,
    init ref<int32> byteLength)
{
    if (!TryMeasureStringTextRow(literal, flags, false, init var contentBytes,
            init var unitWidth, init var rowBytes))
    {
        return false;
    }
    byteLength = rowBytes;
    return true;
}

public static bool TryGetStringNamespaceRowByteLength(StringLiteral literal, int32 flags,
    init ref<int32> byteLength)
{
    if (!TryMeasureStringTextRow(literal, flags, true, init var contentBytes,
            init var unitWidth, init var rowBytes))
    {
        return false;
    }
    byteLength = rowBytes;
    return true;
}

public static bool TryCompareStringNames(StringLiteral left, StringLiteral right,
    init ref<bool> equal)
{
    return TryCompareStringText(left, right, false, init equal);
}

public static bool TryCompareStringNamespaces(StringLiteral left, StringLiteral right,
    init ref<bool> equal)
{
    return TryCompareStringText(left, right, true, init equal);
}

bool TryCompareStringText(StringLiteral left, StringLiteral right, bool allowEmpty,
    init ref<bool> equal)
{
    if (!allowEmpty && (left.ScalarCount == 0 || right.ScalarCount == 0))
    {
        return false;
    }

    mut StringLiteralCursor leftCursor = StringLiteralCursor.Create(left);
    mut StringLiteralCursor rightCursor = StringLiteralCursor.Create(right);
    mut bool same = true;
    while (leftCursor.TryRead(init var leftScalar, init var leftNext))
    {
        if (leftScalar == 0)
        {
            return false;
        }
        if (rightCursor.TryRead(init var rightScalar, init var rightNext))
        {
            if (rightScalar == 0)
            {
                return false;
            }
            if (leftScalar != rightScalar)
            {
                same = false;
            }
            rightCursor = rightNext;
        }
        else
        {
            same = false;
        }
        leftCursor = leftNext;
    }
    while (rightCursor.TryRead(init var remaining, init var following))
    {
        if (remaining == 0)
        {
            return false;
        }
        same = false;
        rightCursor = following;
    }
    equal = same;
    return true;
}

public static OwnedInt32Buffer EncodeStringRow(StringLiteral literal, int32 flags,
    OwnedInt32Buffer workspace)
{
    require TryMeasureStringRow(literal, flags, init var contentBytes, init var unitWidth,
        init var rowBytes);
    return EncodeMeasuredStringRow(literal, flags, contentBytes, unitWidth, rowBytes,
        move workspace);
}

OwnedInt32Buffer EncodeMeasuredStringRow(StringLiteral literal, int32 flags,
    int32 contentBytes, int32 unitWidth, int32 rowBytes, OwnedInt32Buffer workspace)
{
    require workspace.Capacity >= rowBytes;
    mut OwnedInt32Buffer bytes = move workspace;
    if (flags == 0) { bytes = literal.EncodeAscii(move bytes); }
    else if (flags == 1) { bytes = literal.EncodeUtf8(move bytes); }
    else if (flags == 2) { bytes = literal.EncodeUtf16LeBytes(move bytes); }
    else { bytes = literal.EncodeUtf32LeBytes(move bytes); }

    while (bytes.Count < rowBytes)
    {
        require bytes.TryAppend(0);
    }
    {
        mut MutableInt32BufferView row = bytes.SliceMutable(0, rowBytes);
        // Move backward so the header can reuse the original content buffer.
        mut int32 index = contentBytes;
        while (index > 0)
        {
            index = index - 1;
            row.Set(index + 4, row.Read(index));
        }
        int32 units = contentBytes / unitWidth;
        row.Set(0, flags);
        row.Set(1, units & 255);
        row.Set(2, (units >> 8) & 255);
        row.Set(3, units >> 16);
    }
    return move bytes;
}

public static OwnedInt32Buffer EncodeStringNameRow(StringLiteral literal, int32 flags,
    OwnedInt32Buffer workspace)
{
    require TryMeasureStringTextRow(literal, flags, false, init var contentBytes,
        init var unitWidth, init var rowBytes);
    return EncodeMeasuredStringRow(literal, flags, contentBytes, unitWidth, rowBytes,
        move workspace);
}

public static OwnedInt32Buffer EncodeStringNamespaceRow(StringLiteral literal, int32 flags,
    OwnedInt32Buffer workspace)
{
    require TryMeasureStringTextRow(literal, flags, true, init var contentBytes,
        init var unitWidth, init var rowBytes);
    return EncodeMeasuredStringRow(literal, flags, contentBytes, unitWidth, rowBytes,
        move workspace);
}
