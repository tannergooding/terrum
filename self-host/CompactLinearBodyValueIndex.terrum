namespace Terrum.CodeAnalysis;

// Candidate single-block value indexing for supported compact-linear operations.
// Type compatibility, call semantics, effects, and control flow remain hosted checks.
public static bool TryBuildCompactLinearBodyValueIndex(
    int32 recordCount, int32 row, int32 parameterCount, int32 typeSpecCount)
{
    if (Host.BodyValueIndexComplete.Length != 1)
    {
        return false;
    }

    Host.BodyValueIndexComplete[0] = 0;
    if (!TryValidateBodyTableIndex(recordCount))
    {
        return false;
    }

    return TryBuildValidatedCompactLinearBodyValueIndex(
        recordCount, row, parameterCount, typeSpecCount);
}

// Use after validating this exact Body index with TryValidateBodyTableIndex.
bool TryBuildValidatedCompactLinearBodyValueIndex(
    int32 recordCount, int32 row, int32 parameterCount, int32 typeSpecCount)
{
    if (Host.BodyValueIndexComplete.Length != 1)
    {
        return false;
    }

    Host.BodyValueIndexComplete[0] = 0;
    if (parameterCount < 0 || parameterCount > 16777215
        || !TryGetValidatedCompactLinearBodyFrame(recordCount, row, typeSpecCount,
            init var blockCount, init var operationCount)
        || blockCount != 1
        || operationCount > 2147483646 - parameterCount
        || !TryGetValidatedBodyTableRowExtent(recordCount, row,
            init var bodyDataStart, init var bodyLength))
    {
        return false;
    }

    int32 bodyIndexLength = (recordCount + 1) * 4;
    int32 bodyStart = bodyIndexLength + bodyDataStart;
    mut int32 position = bodyStart;
    int32 end = bodyStart + bodyLength;
    if (!TryReadCompactLinearByte(position, end, init var bodyLayout)
        || (bodyLayout & 0xFC) != 0x04 || (bodyLayout & 3) == 3)
    {
        return false;
    }

    position = position + 1;
    int32 bodyWidth = (bodyLayout & 3) == 0 ? 1
        : (bodyLayout & 3) == 1 ? 2 : 4;
    if (!TryReadCompactLinearWord(position, end, bodyWidth,
            init var afterTypeCount, init var encodedTypeCount)
        || encodedTypeCount > uint32((end - afterTypeCount) / 4))
    {
        return false;
    }

    position = afterTypeCount + int32(encodedTypeCount) * 4;
    if (!TryReadCompactLinearWord(position, end, bodyWidth,
            init var afterOperationCount, init var encodedOperationCount)
        || encodedOperationCount != uint32(operationCount))
    {
        return false;
    }

    position = afterOperationCount;
    int32 operationsStart = position;
    mut int32 extraResultCount = 0;
    mut int32 voidCallCount = 0;
    mut int32 preflightPosition = operationsStart;
    for (mut int32 ordinal = 0; ordinal < operationCount; ordinal = ordinal + 1)
    {
        if (!TryReadCompactLinearInstruction(preflightPosition, end,
                init var afterInstruction, init var opcode,
                init var referenceWidth, init var countWidth, init var dataWidth)
            || !TrySkipCompactLinearOperation(afterInstruction, end, opcode,
                referenceWidth, countWidth, dataWidth,
                init var afterOperation))
        {
            return false;
        }

        if (opcode == 0x18)
        {
            extraResultCount = extraResultCount + 1;
        }
        else if (opcode == 0x12)
        {
            if (!TryReadCompactLinearWord(afterInstruction, end, referenceWidth,
                    init var afterResult, init var encodedResult))
            {
                return false;
            }

            if (encodedResult == 0)
            {
                voidCallCount = voidCallCount + 1;
            }
        }
        preflightPosition = afterOperation;
    }

    if (extraResultCount > 2147483646 - parameterCount - operationCount)
    {
        return false;
    }

    int32 valueCount = parameterCount + operationCount + extraResultCount - voidCallCount;
    if (Host.BodyValueDefinitions.Length != valueCount
        || Host.BodyValueLastUses.Length != valueCount
        || Host.BodyValueUseBlocks.Length != valueCount)
    {
        return false;
    }

    for (mut int32 value = 0; value < valueCount; value = value + 1)
    {
        Host.BodyValueDefinitions[value] = -1;
        Host.BodyValueLastUses[value] = 0;
        Host.BodyValueUseBlocks[value] = 0;
    }

    position = operationsStart;
    mut int32 nextValue = parameterCount + 1;
    for (mut int32 ordinal = 0; ordinal < operationCount; ordinal = ordinal + 1)
    {
        int32 operationStart = position;
        if (!TryReadCompactLinearInstruction(position, end,
                init var afterInstruction, init var opcode,
                init var referenceWidth, init var countWidth, init var dataWidth)
            || (opcode != 1 && opcode != 2 && opcode != 3
                && opcode != 4 && opcode != 5 && opcode != 6 && opcode != 7
                && opcode != 8 && opcode != 9 && opcode != 0x0A
                && opcode != 0x12 && opcode != 0x15 && opcode != 0x16
                && opcode != 0x17 && opcode != 0x18
                && opcode != 0x19 && opcode != 0x1A && opcode != 0x1B
                && opcode != 0x1C && opcode != 0x1D && opcode != 0x1E
                && opcode != 0x1F))
        {
            return false;
        }

        if (!TryReadCompactLinearWord(afterInstruction, end, referenceWidth,
                init var afterResult, init var encodedResult)
            || (opcode == 0x12
                ? encodedResult != 0 && encodedResult != uint32(nextValue)
                : encodedResult != uint32(nextValue)))
        {
            return false;
        }

        mut int32 operationUsesStart = afterResult;
        if (opcode == 0x18)
        {
            if (nextValue >= valueCount
                || !TryReadCompactLinearWord(afterResult, end, referenceWidth,
                    init var afterSecondResult, init var encodedSecondResult)
                || encodedSecondResult != uint32(nextValue + 1))
            {
                return false;
            }

            operationUsesStart = afterSecondResult;
        }

        if (!TrySkipCompactLinearOperation(afterInstruction, end, opcode,
                referenceWidth, countWidth, dataWidth, init var afterOperation)
            || !TryIndexCompactLinearOperationUses(operationUsesStart, afterOperation, end,
                opcode, referenceWidth, countWidth, dataWidth, int32(encodedTypeCount),
                nextValue - 1, ordinal))
        {
            return false;
        }

        if (opcode != 0x12 || encodedResult != 0)
        {
            Host.BodyValueDefinitions[nextValue - 1] = operationStart - bodyStart;
            if (opcode == 0x18)
            {
                Host.BodyValueDefinitions[nextValue] = operationStart - bodyStart;
                nextValue = nextValue + 2;
            }
            else
            {
                nextValue = nextValue + 1;
            }
        }
        position = afterOperation;
    }

    if (nextValue != valueCount + 1
        || !TryReadCompactLinearInstruction(position, end,
            init var afterTerminator, init var terminator,
            init var terminatorReferenceWidth, init var terminatorCountWidth,
            init var terminatorDataWidth)
        || terminatorCountWidth != 1 || terminatorDataWidth != 0)
    {
        return false;
    }

    if (terminator == 0x83)
    {
        if (!TryReadCompactLinearWord(afterTerminator, end, terminatorReferenceWidth,
                init var afterReturn, init var encodedReturn)
            || encodedReturn > uint32(nextValue - 1))
        {
            return false;
        }

        if (encodedReturn != 0)
        {
            int32 result = int32(encodedReturn) - 1;
            Host.BodyValueLastUses[result] = operationCount;
            Host.BodyValueUseBlocks[result] = 1;
        }
        position = afterReturn;
    }
    else if (terminator == 0x87)
    {
        if (terminatorReferenceWidth != 1
            || !TryReadCompactLinearByte(afterTerminator, end, init var failureReason)
            || failureReason < 1 || failureReason > 4)
        {
            return false;
        }

        position = afterTerminator + 1;
    }
    else
    {
        return false;
    }

    if (position != end)
    {
        return false;
    }

    Host.BodyValueIndexComplete[0] = 1;
    return true;
}

bool TryIndexCompactLinearOperationUses(int32 start, int32 operationEnd, int32 end,
    uint32 opcode, int32 referenceWidth, int32 countWidth, int32 dataWidth, int32 typeCount,
    int32 valueCount, int32 ordinal)
{
    mut int32 position = start;
    if (opcode == 1 || opcode == 2)
    {
        if (dataWidth == 0
            || !TryReadCompactLinearTypeReference(position, end, referenceWidth,
                typeCount, init var afterType)
            || !TrySkipCompactLinearBytes(afterType, end, dataWidth,
                init var afterData))
        {
            return false;
        }
        position = afterData;
    }
    else if (opcode == 3 || opcode == 0x0A || opcode == 0x17 || opcode == 0x1C)
    {
        if (!TryReadCompactLinearValueUse(position, end, referenceWidth,
                valueCount, ordinal, init var afterUse))
        {
            return false;
        }
        position = afterUse;
    }
    else if (opcode == 0x12)
    {
        if (!TryReadCompactLinearWord(position, operationEnd, referenceWidth,
                init var afterMethod, init var method))
        {
            return false;
        }

        mut int32 argumentCountStart = afterMethod;
        if (method == 0)
        {
            if (!TrySkipCompactLinearBytes(argumentCountStart, operationEnd, 4,
                    init var afterDefinition))
            {
                return false;
            }
            argumentCountStart = afterDefinition;
        }

        if (!TryReadCompactLinearWord(argumentCountStart, operationEnd, countWidth,
                init var afterArgumentCount, init var argumentCount)
            || argumentCount > uint32((operationEnd - afterArgumentCount) / referenceWidth))
        {
            return false;
        }

        position = afterArgumentCount;
        for (mut int32 argument = 0; argument < int32(argumentCount); argument = argument + 1)
        {
            if (!TryReadCompactLinearValueUse(position, operationEnd, referenceWidth,
                    valueCount, ordinal, init var afterArgument))
            {
                return false;
            }
            position = afterArgument;
        }
    }
    else if (opcode == 4)
    {
        if (!TryReadCompactLinearByte(position, end, init var kind)
            || kind < 1 || kind > 3
            || !TryReadCompactLinearValueUse(position + 1, end, referenceWidth,
                valueCount, ordinal, init var afterUse))
        {
            return false;
        }
        position = afterUse;
    }
    else if (opcode == 5 || opcode == 0x15 || opcode == 0x19 || opcode == 0x1D)
    {
        if (!TryReadCompactLinearByte(position, end, init var kind)
            || (opcode == 5 && (kind < 1 || kind > 12))
            || (opcode == 0x15 && (kind < 1 || kind > 7))
            || (opcode == 0x19 && (kind < 1 || kind > 6))
            || (opcode == 0x1D && (kind < 1 || kind > 4))
            || !TryReadCompactLinearValueUse(position + 1, end, referenceWidth,
                valueCount, ordinal, init var afterLeft)
            || !TryReadCompactLinearValueUse(afterLeft, end, referenceWidth,
                valueCount, ordinal, init var afterRight))
        {
            return false;
        }
        position = afterRight;
    }
    else if (opcode == 0x18)
    {
        if (!TryReadCompactLinearValueUse(position, end, referenceWidth,
                valueCount, ordinal, init var afterLeft)
            || !TryReadCompactLinearValueUse(afterLeft, end, referenceWidth,
                valueCount, ordinal, init var afterRight))
        {
            return false;
        }
        position = afterRight;
    }
    else if (opcode == 6)
    {
        if (!TryReadCompactLinearTypeReference(position, end, referenceWidth,
                typeCount, init var afterType)
            || !TryReadCompactLinearByte(afterType, end, init var policy)
            || policy < 1 || policy > 3
            || !TryReadCompactLinearValueUse(afterType + 1, end, referenceWidth,
                valueCount, ordinal, init var afterUse))
        {
            return false;
        }
        position = afterUse;
    }
    else if (opcode == 7)
    {
        if (!TryReadCompactLinearValueUse(position, end, referenceWidth,
                valueCount, ordinal, init var afterCondition)
            || !TryReadCompactLinearValueUse(afterCondition, end, referenceWidth,
                valueCount, ordinal, init var afterTrue)
            || !TryReadCompactLinearValueUse(afterTrue, end, referenceWidth,
                valueCount, ordinal, init var afterFalse))
        {
            return false;
        }
        position = afterFalse;
    }
    else if (opcode == 8)
    {
        if (!TryReadCompactLinearTypeReference(position, end, referenceWidth,
                typeCount, init var afterType)
            || !TryReadCompactLinearValueUse(afterType, end, referenceWidth,
                valueCount, ordinal, init var afterUse))
        {
            return false;
        }
        position = afterUse;
    }
    else if (opcode == 9)
    {
        if (!TryReadCompactLinearTypeReference(position, end, referenceWidth,
                typeCount, init var afterType))
        {
            return false;
        }
        position = afterType;
    }
    else if (opcode == 0x16 || opcode == 0x1A || opcode == 0x1B
        || opcode == 0x1E || opcode == 0x1F)
    {
        if (!TryReadCompactLinearTypeReference(position, end, referenceWidth,
                typeCount, init var afterType)
            || !TryReadCompactLinearValueUse(afterType, end, referenceWidth,
                valueCount, ordinal, init var afterUse))
        {
            return false;
        }
        position = afterUse;
    }
    else
    {
        return false;
    }

    return position == operationEnd;
}

bool TryReadCompactLinearTypeReference(int32 start, int32 end, int32 width,
    int32 typeCount, init ref<int32> nextPosition)
{
    if (!TryReadCompactLinearWord(start, end, width,
            init var afterReference, init var reference)
        || reference == 0 || reference > uint32(typeCount))
    {
        return false;
    }

    nextPosition = afterReference;
    return true;
}

bool TryReadCompactLinearValueUse(int32 start, int32 end, int32 width,
    int32 valueCount, int32 ordinal, init ref<int32> nextPosition)
{
    if (!TryReadCompactLinearWord(start, end, width,
            init var afterValue, init var value)
        || !TryRecordCompactLinearValueUse(value, valueCount, ordinal))
    {
        return false;
    }

    nextPosition = afterValue;
    return true;
}

bool TryRecordCompactLinearValueUse(uint32 value, int32 valueCount, int32 ordinal)
{
    if (value == 0 || value > uint32(valueCount))
    {
        return false;
    }

    int32 index = int32(value) - 1;
    Host.BodyValueLastUses[index] = ordinal;
    Host.BodyValueUseBlocks[index] = 1;
    return true;
}
