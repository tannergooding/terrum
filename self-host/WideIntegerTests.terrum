using Terrum.CodeAnalysis.Numerics64;
namespace Terrum.CodeAnalysis.Tests;

public static bool CheckWideAddition()
{
    if (TryAdd(int64.MaxValue, 1, out var tooLarge)
        || TryAdd(int64.MinValue, -1, out var tooSmall))
    {
        return false;
    }

    require TryAdd(int64.MinValue, int64.MaxValue, out var negative);
    require TryAdd(int64.MaxValue, 0, out var maximum);
    require TryAdd(int64.MinValue, 0, out var minimum);

    return negative == -1 && maximum == int64.MaxValue && minimum == int64.MinValue;
}

public static bool CheckWideSubtraction()
{
    if (TrySubtract(int64.MaxValue, -1, out var tooLarge)
        || TrySubtract(int64.MinValue, 1, out var tooSmall))
    {
        return false;
    }

    require TrySubtract(int64.MinValue, int64.MinValue, out var zero);
    require TrySubtract(-1, int64.MinValue, out var maximum);
    require TrySubtract(0, int64.MaxValue, out var negative);
    require TrySubtract(int64.MaxValue, 0, out var unchanged);
    return zero == 0 && maximum == int64.MaxValue
        && negative == -int64.MaxValue && unchanged == int64.MaxValue;
}

public static bool CheckWideMultiplication()
{
    if (TryMultiply(int64.MaxValue, 2, out var positiveOverflow)
        || TryMultiply(int64.MinValue, -1, out var negativeTimesNegativeOverflow)
        || TryMultiply(int64.MinValue, 2, out var negativeOverflow)
        || TryMultiply(-2, int64.MinValue, out var negativeTimesNegativeOverflow2)
        || TryMultiply(2, int64.MaxValue, out var reversedPositiveOverflow))
    {
        return false;
    }

    require TryMultiply(int64.MinValue, 1, out var minimum);
    require TryMultiply(int64.MinValue, 0, out var zero);
    require TryMultiply(-1, int64.MaxValue, out var negative);
    require TryMultiply(-1, -int64.MaxValue, out var positive);
    require TryMultiply(int64.MinValue / 2, 2, out var boundary);
    require TryMultiply(3037000499, 3037000499, out var square);
    return minimum == int64.MinValue && zero == 0
        && negative == -int64.MaxValue && positive == int64.MaxValue
        && boundary == int64.MinValue && square == 9223372030926249001;
}

public static bool CheckWideDecimalAccumulation()
{
    mut uint64 value = 1844674407370955161;
    require TryAccumulateDecimal(value, 5, uint64.MaxValue, out value);
    require value == uint64.MaxValue;

    if (TryAccumulateDecimal(value, 0, uint64.MaxValue, out value))
    {
        return false;
    }

    if (TryAccumulateDecimal(0, 10, uint64.MaxValue, out var notADigit)
        || TryAccumulateDecimal(0, 1, 0, out var exceedsLimit)
        || TryAccumulateDecimal(922337203685477580, 8, uint64(int64.MaxValue), out var signedOverflow))
    {
        return false;
    }

    require TryAccumulateDecimal(922337203685477580, 7, uint64(int64.MaxValue), out var maximumSigned);
    require TryAccumulateDecimal(0, 0, 0, out value);
    require TryAccumulateDecimalInit(1844674407370955161, 5, uint64.MaxValue, init var maximumInit);
    if (TryAccumulateDecimalInit(uint64.MaxValue, 0, uint64.MaxValue, init var overflowInit)
        || TryAccumulateDecimalInit(0, 10, uint64.MaxValue, init var invalidInit))
    {
        return false;
    }

    return maximumSigned == uint64(int64.MaxValue) && maximumInit == uint64.MaxValue && value == 0;
}

public static bool CheckWideBaseAccumulation()
{
    mut uint64 binary = 0;
    for (mut int32 bit = 0; bit < 64; bit = bit + 1)
    {
        require TryAccumulateBase(binary, 1, 2, uint64.MaxValue, out binary);
    }
    if (binary != uint64.MaxValue
        || TryAccumulateBase(binary, 0, 2, uint64.MaxValue, out var overflow)
        || TryAccumulateBase(0, 36, 36, uint64.MaxValue, out var invalidDigit)
        || TryAccumulateBase(0, 1, 1, uint64.MaxValue, out var lowBase)
        || TryAccumulateBase(0, 1, 37, uint64.MaxValue, out var highBase)
        || TryAccumulateBase(0, 1, 16, 0, out var overLimit))
    {
        return false;
    }

    require TryAccumulateBase(0, 35, 36, 35, out var lastDigit);
    require TryAccumulateBase(0, 15, 16, 15, out var hexDigit);
    require TryAccumulateBase(1844674407370955161, 5, 10, uint64.MaxValue, out var decimalValue);
    require TryAccumulateBase(0, 0, 2, 0, out var zero);
    if (lastDigit != 35 || hexDigit != 15
        || decimalValue != uint64.MaxValue || zero != 0
        || TryAccumulateBaseInit(0, 1, 1, uint64.MaxValue, init var lowBaseInit)
        || TryAccumulateBaseInit(0, 1, 37, uint64.MaxValue, init var highBaseInit)
        || TryAccumulateBaseInit(0, 1, 16, 0, init var overLimitInit))
    {
        return false;
    }

    for (mut uint32 radix = 2; radix <= 36; radix = radix + 1)
    {
        uint64 divisor = uint64(radix);
        uint64 prefix = uint64.MaxValue / divisor;
        uint32 finalDigit = uint32(uint64.MaxValue % divisor);
        require TryAccumulateBase(prefix, finalDigit, radix, uint64.MaxValue, out var maximum);
        require TryAccumulateBaseInit(prefix, finalDigit, radix, uint64.MaxValue, init var maximumInit);
        if (maximum != uint64.MaxValue
            || maximumInit != maximum
            || TryAccumulateBase(prefix + 1, finalDigit, radix, uint64.MaxValue, out var tooLarge)
            || TryAccumulateBase(0, radix, radix, uint64.MaxValue, out var tooWide)
            || TryAccumulateBaseInit(prefix + 1, finalDigit, radix, uint64.MaxValue, init var largeInit)
            || TryAccumulateBaseInit(0, radix, radix, uint64.MaxValue, init var wideInit))
        {
            return false;
        }

        uint64 signedPrefix = uint64(int64.MaxValue) / divisor;
        uint32 signedDigit = uint32(uint64(int64.MaxValue) % divisor);
        require TryAccumulateBase(signedPrefix, signedDigit, radix, uint64(int64.MaxValue), out var signedMaximum);
        require TryAccumulateBaseInit(signedPrefix, signedDigit, radix,
            uint64(int64.MaxValue), init var signedMaximumInit);
        if (signedMaximum != uint64(int64.MaxValue)
            || signedMaximumInit != signedMaximum
            || TryAccumulateBase(signedPrefix + 1, signedDigit, radix,
                uint64(int64.MaxValue), out var signedOverflow)
            || TryAccumulateBaseInit(signedPrefix + 1, signedDigit, radix,
                uint64(int64.MaxValue), init var signedOverflowInit))
        {
            return false;
        }
    }
    return true;
}
