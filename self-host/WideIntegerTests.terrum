using Terrum.CodeAnalysis.Numerics64;
namespace Terrum.CodeAnalysis.Tests;

public static bool CheckWideAddition()
{
    if (TryAddInt64(int64.MaxValue, 1, init var tooLarge)
        || TryAddInt64(int64.MinValue, -1, init var tooSmall))
    {
        return false;
    }

    require TryAddInt64(int64.MinValue, int64.MaxValue, init var negative);
    require TryAddInt64(int64.MaxValue, 0, init var maximum);
    require TryAddInt64(int64.MinValue, 0, init var minimum);

    return negative == -1 && maximum == int64.MaxValue && minimum == int64.MinValue;
}

public static bool CheckWideSubtraction()
{
    if (TrySubtractInt64(int64.MaxValue, -1, init var tooLarge)
        || TrySubtractInt64(int64.MinValue, 1, init var tooSmall))
    {
        return false;
    }

    require TrySubtractInt64(int64.MinValue, int64.MinValue, init var zero);
    require TrySubtractInt64(-1, int64.MinValue, init var maximum);
    require TrySubtractInt64(0, int64.MaxValue, init var negative);
    require TrySubtractInt64(int64.MaxValue, 0, init var unchanged);
    return zero == 0 && maximum == int64.MaxValue
        && negative == -int64.MaxValue && unchanged == int64.MaxValue;
}

public static bool CheckWideMultiplication()
{
    if (TryMultiplyInt64(int64.MaxValue, 2, init var positiveOverflow)
        || TryMultiplyInt64(int64.MinValue, -1, init var negativeTimesNegativeOverflow)
        || TryMultiplyInt64(int64.MinValue, 2, init var negativeOverflow)
        || TryMultiplyInt64(-2, int64.MinValue, init var negativeTimesNegativeOverflow2)
        || TryMultiplyInt64(2, int64.MaxValue, init var reversedPositiveOverflow))
    {
        return false;
    }

    require TryMultiplyInt64(int64.MinValue, 1, init var minimum);
    require TryMultiplyInt64(int64.MinValue, 0, init var zero);
    require TryMultiplyInt64(-1, int64.MaxValue, init var negative);
    require TryMultiplyInt64(-1, -int64.MaxValue, init var positive);
    require TryMultiplyInt64(int64.MinValue / 2, 2, init var boundary);
    require TryMultiplyInt64(3037000499, 3037000499, init var square);
    return minimum == int64.MinValue && zero == 0
        && negative == -int64.MaxValue && positive == int64.MaxValue
        && boundary == int64.MinValue && square == 9223372030926249001;
}

public static bool CheckWideDecimalAccumulation()
{
    mut uint64 value = 1844674407370955161;
    require TryAccumulateDecimal(value, 5, uint64.MaxValue, init var accumulated);
    value = accumulated;
    require value == uint64.MaxValue;

    if (TryAccumulateDecimal(value, 0, uint64.MaxValue, init var overflow))
    {
        return false;
    }

    if (TryAccumulateDecimal(0, 10, uint64.MaxValue, init var notADigit)
        || TryAccumulateDecimal(0, 1, 0, init var exceedsLimit)
        || TryAccumulateDecimal(922337203685477580, 8,
            uint64(int64.MaxValue), init var signedOverflow))
    {
        return false;
    }

    require TryAccumulateDecimal(922337203685477580, 7,
        uint64(int64.MaxValue), init var maximumSigned);
    require TryAccumulateDecimal(0, 0, 0, init var zero);
    value = zero;
    if (TryAccumulateDecimal(0, 10, uint64.MaxValue, init var reusable))
    {
        return false;
    }
    require TryAccumulateDecimal(1844674407370955161, 5, uint64.MaxValue, init reusable);

    return maximumSigned == uint64(int64.MaxValue)
        && reusable == uint64.MaxValue && value == 0;
}

public static bool CheckWideBaseAccumulation()
{
    mut uint64 binary = 0;
    for (mut int32 bit = 0; bit < 64; bit = bit + 1)
    {
        require TryAccumulateBase(binary, 1, 2, uint64.MaxValue, init var accumulated);
        binary = accumulated;
    }
    if (binary != uint64.MaxValue
        || TryAccumulateBase(binary, 0, 2, uint64.MaxValue, init var overflow)
        || TryAccumulateBase(0, 36, 36, uint64.MaxValue, init var invalidDigit)
        || TryAccumulateBase(0, 1, 1, uint64.MaxValue, init var lowBase)
        || TryAccumulateBase(0, 1, 37, uint64.MaxValue, init var highBase)
        || TryAccumulateBase(0, 1, 16, 0, init var overLimit))
    {
        return false;
    }

    require TryAccumulateBase(0, 35, 36, 35, init var lastDigit);
    require TryAccumulateBase(0, 15, 16, 15, init var hexDigit);
    require TryAccumulateBase(1844674407370955161, 5, 10,
        uint64.MaxValue, init var decimalValue);
    require TryAccumulateBase(0, 0, 2, 0, init var zero);
    if (lastDigit != 35 || hexDigit != 15
        || decimalValue != uint64.MaxValue || zero != 0)
    {
        return false;
    }

    if (TryAccumulateBase(0, 1, 1, uint64.MaxValue, init var reusable))
    {
        return false;
    }
    require TryAccumulateBase(0, 15, 16, 15, init reusable);
    if (reusable != 15)
    {
        return false;
    }

    for (mut uint32 radix = 2; radix <= 36; radix = radix + 1)
    {
        uint64 divisor = uint64(radix);
        uint64 prefix = uint64.MaxValue / divisor;
        uint32 finalDigit = uint32(uint64.MaxValue % divisor);
        require TryAccumulateBase(prefix, finalDigit, radix,
            uint64.MaxValue, init var maximum);
        if (maximum != uint64.MaxValue
            || TryAccumulateBase(prefix + 1, finalDigit, radix,
                uint64.MaxValue, init var tooLarge)
            || TryAccumulateBase(0, radix, radix, uint64.MaxValue,
                init var tooWide))
        {
            return false;
        }

        uint64 signedPrefix = uint64(int64.MaxValue) / divisor;
        uint32 signedDigit = uint32(uint64(int64.MaxValue) % divisor);
        require TryAccumulateBase(signedPrefix, signedDigit, radix,
            uint64(int64.MaxValue), init var signedMaximum);
        if (signedMaximum != uint64(int64.MaxValue)
            || TryAccumulateBase(signedPrefix + 1, signedDigit, radix,
                uint64(int64.MaxValue), init var signedOverflow))
        {
            return false;
        }
    }
    return true;
}
