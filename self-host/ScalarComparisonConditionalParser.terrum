namespace Terrum.CodeAnalysis;

bool TryParseScalarComparisonConditionalReturn(TokenSnapshot tokens,
    out int32 scalarType, out int32 operation, out SourceRange name)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 29)
    {
        return false;
    }
    require tokens.TryGet(0, out var returnType);
    require tokens.TryGet(1, out var function);
    require tokens.TryGet(2, out var openParameters);
    require tokens.TryGet(3, out var firstType);
    require tokens.TryGet(4, out var firstParameter);
    require tokens.TryGet(5, out var comma);
    require tokens.TryGet(6, out var secondType);
    require tokens.TryGet(7, out var secondParameter);
    require tokens.TryGet(8, out var closeParameters);
    require tokens.TryGet(9, out var openBody);
    require tokens.TryGet(10, out var branch);
    require tokens.TryGet(11, out var openCondition);
    require tokens.TryGet(12, out var firstCondition);
    require tokens.TryGet(13, out var comparison);
    require tokens.TryGet(14, out var secondCondition);
    require tokens.TryGet(15, out var closeCondition);
    require tokens.TryGet(16, out var openTrue);
    require tokens.TryGet(17, out var trueReturn);
    require tokens.TryGet(18, out var firstUse);
    require tokens.TryGet(19, out var trueSemicolon);
    require tokens.TryGet(20, out var closeTrue);
    require tokens.TryGet(21, out var otherwise);
    require tokens.TryGet(22, out var openFalse);
    require tokens.TryGet(23, out var falseReturn);
    require tokens.TryGet(24, out var secondUse);
    require tokens.TryGet(25, out var falseSemicolon);
    require tokens.TryGet(26, out var closeFalse);
    require tokens.TryGet(27, out var closeBody);
    require tokens.TryGet(28, out var eof);
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    if (!TryGetScalarType(returnType, out var selected)
        || !TryGetScalarType(firstType, out var matchingFirst)
        || !TryGetScalarType(secondType, out var matchingSecond)
        || selected != matchingFirst || selected != matchingSecond || selected == 5
        || function.Kind != 2 || openParameters.Kind != 46 || comma.Kind != 53
        || closeParameters.Kind != 47 || openBody.Kind != 48
        || branch.Kind != 16 || openCondition.Kind != 46
        || comparison.Kind < 65 || comparison.Kind > 70
        || closeCondition.Kind != 47 || openTrue.Kind != 48
        || trueReturn.Kind != 19 || trueSemicolon.Kind != 52
        || closeTrue.Kind != 49 || otherwise.Kind != 17
        || openFalse.Kind != 48 || falseReturn.Kind != 19
        || falseSemicolon.Kind != 52 || closeFalse.Kind != 49
        || closeBody.Kind != 49 || eof.Kind != 0
        || !SameTokenSpelling(firstParameter, firstCondition)
        || !SameTokenSpelling(secondParameter, secondCondition)
        || !SameTokenSpelling(firstParameter, firstUse)
        || !SameTokenSpelling(secondParameter, secondUse)
        || SameTokenSpelling(firstParameter, secondParameter))
    {
        return false;
    }
    scalarType = selected;
    operation = comparison.Kind;
    name = function.Range;
    return true;
}

bool TryEvaluateInt32ComparisonConditionalReturn(TokenSnapshot tokens,
    int32 first, int32 second, out SourceRange name, out int32 result)
{
    if (!TryParseScalarComparisonConditionalReturn(move tokens,
            out var selected, out var operation, out var foundName)
        || selected != 1)
    {
        return false;
    }
    name = foundName;
    if (EvaluateScalarComparison(operation, first == second, first < second, first > second))
    {
        result = first;
    }
    else
    {
        result = second;
    }
    return true;
}

