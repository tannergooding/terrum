using Terrum;
namespace Terrum.CodeAnalysis.Tests;

public static bool CheckSourceRange()
{
    if (!SourceRange.TryCreate(2, 3, init var range))
    {
        return false;
    }

    if (range.End != 5 || range.GetEnd() != range.End)
    {
        return false;
    }

    if (!SourceRange.TryCreate(2, 3, init var initialized)
        || initialized.Start != range.Start || initialized.Length != range.Length
        || initialized.End != range.End)
    {
        return false;
    }

    if (SourceRange.TryCreate(-1, 0, init var negative))
    {
        return false;
    }

    if (SourceRange.TryCreate(int32.MaxValue, 1, init var overflowing))
    {
        return false;
    }

    if (SourceRange.TryCreate(-1, 0, init var negativeInit)
        || SourceRange.TryCreate(int32.MaxValue, 1, init var overflowingInit))
    {
        return false;
    }

    if (!SourceRange.TryCreate(int32.MaxValue, 0, init var end))
    {
        return false;
    }

    return end.End == int32.MaxValue
        && SourceRange.TryCreate(int32.MaxValue, 0, init var final)
        && final.End == end.End;
}
