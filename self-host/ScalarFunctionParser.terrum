namespace Terrum.CodeAnalysis;

// This bounded syntax-27 probe uses scanner-5 TokenKind ordinals, not source characters
// to classify punctuation; the host parser's recovery remains a separate phase.
// Scalar type codes: 1=int32, 2=uint32, 3=int64, 4=uint64.
bool TryParseScalarReturnFunctionTyped(TokenSnapshot tokens,
    out int32 scalarType, out SourceRange name, out SourceRange expression)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11)
    {
        return false;
    }

    require tokens.TryGet(0, out var type);
    if (type.Kind != 2)
    {
        return false;
    }

    int32 at = type.Range.Start;
    mut int32 selected = 0;
    if (type.Range.Length == 5 && Host.Source[at] == char16(105)
        && Host.Source[at + 1] == char16(110) && Host.Source[at + 2] == char16(116))
    {
        if (Host.Source[at + 3] == char16(51) && Host.Source[at + 4] == char16(50))
        {
            selected = 1;
        }
        else if (Host.Source[at + 3] == char16(54) && Host.Source[at + 4] == char16(52))
        {
            selected = 3;
        }
    }
    else if (type.Range.Length == 6 && Host.Source[at] == char16(117)
        && Host.Source[at + 1] == char16(105) && Host.Source[at + 2] == char16(110)
        && Host.Source[at + 3] == char16(116))
    {
        if (Host.Source[at + 4] == char16(51) && Host.Source[at + 5] == char16(50))
        {
            selected = 2;
        }
        else if (Host.Source[at + 4] == char16(54) && Host.Source[at + 5] == char16(52))
        {
            selected = 4;
        }
    }
    if (selected == 0)
    {
        return false;
    }

    require tokens.TryGet(1, out var function);
    require tokens.TryGet(2, out var openParameters);
    require tokens.TryGet(3, out var closeParameters);
    require tokens.TryGet(4, out var openBody);
    require tokens.TryGet(5, out var returnKeyword);
    if (function.Kind != 2 || openParameters.Kind != 46 || closeParameters.Kind != 47
        || openBody.Kind != 48 || returnKeyword.Kind != 19)
    {
        return false;
    }

    mut int32 first = 6;
    require tokens.TryGet(first, out var initial);
    mut Token value = initial;
    if (count == 11)
    {
        if (value.Kind != 58)
        {
            return false;
        }
        first = first + 1;
        require tokens.TryGet(first, out value);
    }
    if (value.Kind != 3)
    {
        return false;
    }

    require tokens.TryGet(first + 1, out var semicolon);
    require tokens.TryGet(first + 2, out var closeBody);
    require tokens.TryGet(first + 3, out var eof);
    if (semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }

    mut int32 start = value.Range.Start;
    if (count == 11)
    {
        require tokens.TryGet(6, out var minus);
        start = minus.Range.Start;
    }
    require SourceRange.TryCreate(start, value.Range.End - start, out var scalar);
    scalarType = selected;
    name = function.Range;
    expression = scalar;
    return true;
}

bool TryParseScalarReturnFunction(TokenSnapshot tokens,
    out SourceRange name, out SourceRange expression)
{
    if (!TryParseScalarReturnFunctionTyped(move tokens, out var scalarType,
            out var foundName, out var foundExpression)
        || scalarType != 1)
    {
        return false;
    }

    name = foundName;
    expression = foundExpression;
    return true;
}

bool TryParseScalarReturnInteger(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out SourceRange expression, out int32 low, out int32 high)
{
    mut int32 valueIndex = 6;
    if (tokens.GetCount() == 11)
    {
        valueIndex = 7;
    }

    if (!integers.TryFind(valueIndex, out var overflow, out var magnitudeLow,
            out var magnitudeHigh)
        || overflow
        || !TryParseScalarReturnFunction(move tokens, out var foundName,
            out var foundExpression))
    {
        return false;
    }

    name = foundName;
    expression = foundExpression;
    low = magnitudeLow;
    high = magnitudeHigh;
    return true;
}

bool TryEvaluateInt32ScalarReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out int32 result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11)
    {
        return false;
    }

    mut int32 valueIndex = 6;
    if (count == 11)
    {
        valueIndex = 7;
    }
    require tokens.TryGet(valueIndex, out var literal);
    if (!TryParseScalarReturnInteger(move tokens, move integers, out var foundName,
            out var expression, out var low, out var high)
        || high != 0)
    {
        return false;
    }

    bool negative = count == 11;
    int32 start = literal.Range.Start;
    bool based = literal.Range.Length >= 2 && Host.Source[start] == char16(48)
        && (Host.Source[start + 1] == char16(120)
            || Host.Source[start + 1] == char16(88)
            || Host.Source[start + 1] == char16(98)
            || Host.Source[start + 1] == char16(66));
    // Decimal signed minimum needs unary minus; based literals first form int32 bits.
    if (low < 0)
    {
        if (!based)
        {
            if (!negative || low != int32.MinValue)
            {
                return false;
            }
            name = foundName;
            result = int32.MinValue;
            return true;
        }
        if (negative && low == int32.MinValue)
        {
            return false;
        }
    }

    name = foundName;
    mut int32 bound = low;
    if (negative)
    {
        bound = -low;
    }
    result = bound;
    return true;
}
