    out SourceRange name, out int64 result)
{
    return TryEvaluateInt64BinaryReturn(move tokens, move integers, 60, out name, out result);
}

bool TryEvaluateInt64RemainderReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out int64 result)
{
    return TryEvaluateInt64BinaryReturn(move tokens, move integers, 61, out name, out result);
}

bool TryEvaluateInt64BinaryReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    int32 expectedOperation, out SourceRange name, out int64 result)
{
    if (!TryParseScalarBinaryReturn(move tokens, move integers,
            out var scalarType, out var operation, out var foundName,
            out var leftLow, out var leftHigh, out var leftBased,
            out var rightLow, out var rightHigh, out var rightBased)
        || scalarType != 3 || operation != expectedOperation
        || !TryDecodeSigned64Scalar(DecodeScannerMagnitude(leftLow, leftHigh),
            leftBased, out var left)
        || !TryDecodeSigned64Scalar(DecodeScannerMagnitude(rightLow, rightHigh),
            rightBased, out var right))
    {
        return false;
    }

    if (operation == 60 || operation == 61)
    {
        if (right == 0)
        {
            return false;
        }
        if (left == int64.MinValue && right == -1)
        {
            if (operation == 60)
            {
                return false;
            }
            name = foundName;
            result = 0;
            return true;
        }
        name = foundName;
        if (operation == 60)
        {
            result = left / right;
        }
        else
        {
            result = left % right;
        }
        return true;
    }
    if (operation == 59)
    {
        if ((left > 0 && ((right > 0 && left > int64.MaxValue / right)
            || (right < 0 && right < int64.MinValue / left)))
            || (left < 0 && ((right > 0 && left < int64.MinValue / right)
                || (right < 0 && left < int64.MaxValue / right))))
        {
            return false;
        }
        name = foundName;
        result = left * right;
        return true;
    }
    if (operation == 58)
    {
        if ((right < 0 && left > int64.MaxValue + right)
            || (right > 0 && left < int64.MinValue + right))
        {
            return false;
        }
        name = foundName;
        result = left - right;
        return true;
    }
    if ((right > 0 && left > int64.MaxValue - right)
        || (right < 0 && left < int64.MinValue - right))
    {
        return false;
    }
    name = foundName;
    result = left + right;
    return true;
}

bool TryEvaluateUInt64AddReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint64 result)
{
    return TryEvaluateUInt64BinaryReturn(move tokens, move integers, 57, out name, out result);
}

bool TryEvaluateUInt64SubtractReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint64 result)
{
    return TryEvaluateUInt64BinaryReturn(move tokens, move integers, 58, out name, out result);
}

bool TryEvaluateUInt64MultiplyReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint64 result)
{
    return TryEvaluateUInt64BinaryReturn(move tokens, move integers, 59, out name, out result);
}

bool TryEvaluateUInt64DivideReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint64 result)
{
    return TryEvaluateUInt64BinaryReturn(move tokens, move integers, 60, out name, out result);
}

bool TryEvaluateUInt64RemainderReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint64 result)
{
    return TryEvaluateUInt64BinaryReturn(move tokens, move integers, 61, out name, out result);
}

bool TryEvaluateUInt64BinaryReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    int32 expectedOperation, out SourceRange name, out uint64 result)
{
    if (!TryParseScalarBinaryReturn(move tokens, move integers,
            out var scalarType, out var operation, out var foundName,
            out var leftLow, out var leftHigh, out var leftBased,
            out var rightLow, out var rightHigh, out var rightBased)
        || scalarType != 4 || operation != expectedOperation)
    {
        return false;
    }
    uint64 left = DecodeScannerMagnitude(leftLow, leftHigh);
    uint64 right = DecodeScannerMagnitude(rightLow, rightHigh);
    if (operation == 60 || operation == 61)
    {
        if (right == 0)
        {
            return false;
        }
        name = foundName;
        if (operation == 60)
        {
            result = left / right;
        }
        else
        {
            result = left % right;
        }
        return true;
    }
    if (operation == 58)
    {
        if (left < right)
        {
            return false;
        }
        name = foundName;
        result = left - right;
        return true;
    }
    if (operation == 59)
    {
        if (right != 0 && left > uint64.MaxValue / right)
        {
            return false;
        }
        name = foundName;
        result = left * right;
        return true;
    }
    if (left > uint64.MaxValue - right)
    {
        return false;
    }

    name = foundName;
    result = left + right;
    return true;
}
