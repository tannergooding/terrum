}

bool TryEvaluateChar16ParameterComparisonReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, char16 parameter, out SourceRange name, out bool result)
{
    if (!TryParseParameterComparisonReturn(move tokens, move integers,
            out var selected, out var operation, out var foundName, out var magnitude,
