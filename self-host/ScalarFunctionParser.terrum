namespace Terrum.CodeAnalysis;

// This bounded syntax-27 probe uses scanner-5 TokenKind ordinals, not source characters
// to classify punctuation; the host parser's recovery remains a separate phase.
// Scalar type codes: 1=int32, 2=uint32, 3=int64, 4=uint64, 5=bool.
bool TryGetScalarType(Token type, out int32 scalarType)
{
    if (type.Kind != 2)
    {
        return false;
    }

    int32 at = type.Range.Start;
    mut int32 selected = 0;
    if (type.Range.Length == 4 && Host.Source[at] == char16(98)
        && Host.Source[at + 1] == char16(111)
        && Host.Source[at + 2] == char16(111)
        && Host.Source[at + 3] == char16(108))
    {
        selected = 5;
    }
    else if (type.Range.Length == 5 && Host.Source[at] == char16(105)
        && Host.Source[at + 1] == char16(110) && Host.Source[at + 2] == char16(116))
    {
        if (Host.Source[at + 3] == char16(51) && Host.Source[at + 4] == char16(50))
        {
            selected = 1;
        }
        else if (Host.Source[at + 3] == char16(54) && Host.Source[at + 4] == char16(52))
        {
            selected = 3;
        }
    }
    else if (type.Range.Length == 6 && Host.Source[at] == char16(117)
        && Host.Source[at + 1] == char16(105) && Host.Source[at + 2] == char16(110)
        && Host.Source[at + 3] == char16(116))
    {
        if (Host.Source[at + 4] == char16(51) && Host.Source[at + 5] == char16(50))
        {
            selected = 2;
        }
        else if (Host.Source[at + 4] == char16(54) && Host.Source[at + 5] == char16(52))
        {
            selected = 4;
        }
    }
    if (selected == 0)
    {
        return false;
    }
    scalarType = selected;
    return true;
}

bool TryParseScalarReturnFunctionTyped(TokenSnapshot tokens,
    out int32 scalarType, out SourceRange name, out SourceRange expression)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }

    require tokens.TryGet(0, out var type);
    if (!TryGetScalarType(type, out var selected))
    {
        return false;
    }
    require tokens.TryGet(1, out var function);
    require tokens.TryGet(2, out var openParameters);
    require tokens.TryGet(3, out var closeParameters);
    require tokens.TryGet(4, out var openBody);
    require tokens.TryGet(5, out var returnKeyword);
    if (function.Kind != 2 || openParameters.Kind != 46 || closeParameters.Kind != 47
        || openBody.Kind != 48 || returnKeyword.Kind != 19)
    {
        return false;
    }

    mut int32 first = 6;
    require tokens.TryGet(first, out var initial);
    mut Token value = initial;
    bool grouped = count == 12 || count == 13;
    bool outerSign = count == 13 && ((selected == 5 && initial.Kind == 62)
        || (selected != 5 && (initial.Kind == 57 || initial.Kind == 58
            || initial.Kind == 63)));
    mut Token group = initial;
    if (outerSign)
    {
        first = first + 1;
        require tokens.TryGet(first, out group);
        value = group;
    }
    if (grouped)
    {
        if (value.Kind != 46)
        {
            return false;
        }
        first = first + 1;
        require tokens.TryGet(first, out value);
    }
    if (count == 11 || (count == 13 && !outerSign))
    {
        if ((selected == 5 && value.Kind != 62)
            || (selected != 5 && value.Kind != 57 && value.Kind != 58
                && value.Kind != 63))
        {
            return false;
        }
        first = first + 1;
        require tokens.TryGet(first, out value);
    }
    if ((selected == 5 && value.Kind != 20 && value.Kind != 21)
        || (selected != 5 && value.Kind != 3))
    {
        return false;
    }

    mut int32 afterValue = first + 1;
    mut int32 end = value.Range.End;
    if (grouped)
    {
        require tokens.TryGet(afterValue, out var closeGroup);
        if (closeGroup.Kind != 47)
        {
            return false;
        }
        end = closeGroup.Range.End;
        afterValue = afterValue + 1;
    }
    require tokens.TryGet(afterValue, out var semicolon);
    require tokens.TryGet(afterValue + 1, out var closeBody);
    require tokens.TryGet(afterValue + 2, out var eof);
    if (semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }

    mut int32 start = value.Range.Start;
    if (grouped)
    {
        start = group.Range.Start;
    }
    if (count == 11 || outerSign)
    {
        require tokens.TryGet(6, out var prefix);
        start = prefix.Range.Start;
    }
    require SourceRange.TryCreate(start, end - start, out var scalar);
    scalarType = selected;
    name = function.Range;
    expression = scalar;
    return true;
}

bool TryEvaluateBoolScalarReturn(TokenSnapshot tokens,
    out SourceRange name, out bool result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }
    mut int32 valueIndex = 6;
    if (count == 11 || count == 12)
    {
        valueIndex = 7;
    }
    else if (count == 13)
    {
        valueIndex = 8;
    }
    require tokens.TryGet(valueIndex, out var literal);
    bool negate = count == 11 || count == 13;
    if (!TryParseScalarReturnFunctionTyped(move tokens, out var scalarType,
            out var foundName, out var expression)
        || scalarType != 5)
    {
        return false;
    }

    name = foundName;
    result = literal.Kind == 20;
    if (negate)
    {
        result = !result;
    }
    return true;
}

bool TryParseScalarReturnFunction(TokenSnapshot tokens,
    out SourceRange name, out SourceRange expression)
{
    if (!TryParseScalarReturnFunctionTyped(move tokens, out var scalarType,
            out var foundName, out var foundExpression)
        || scalarType != 1)
    {
        return false;
    }

    name = foundName;
    expression = foundExpression;
    return true;
}

bool TryParseScalarReturnIntegerTyped(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out int32 scalarType, out SourceRange name, out SourceRange expression,
    out int32 low, out int32 high)
{
    mut int32 valueIndex = 6;
    if (tokens.GetCount() == 11 || tokens.GetCount() == 12)
    {
        valueIndex = 7;
    }
    else if (tokens.GetCount() == 13)
    {
        valueIndex = 8;
    }

    if (!integers.TryFind(valueIndex, out var overflow, out var magnitudeLow,
            out var magnitudeHigh)
        || overflow
        || !TryParseScalarReturnFunctionTyped(move tokens, out var foundType,
            out var foundName, out var foundExpression))
    {
        return false;
    }

    scalarType = foundType;
    name = foundName;
    expression = foundExpression;
    low = magnitudeLow;
    high = magnitudeHigh;
    return true;
}

bool TryParseScalarReturnInteger(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out SourceRange expression, out int32 low, out int32 high)
{
    if (!TryParseScalarReturnIntegerTyped(move tokens, move integers, out var scalarType,
            out var foundName, out var foundExpression, out var foundLow, out var foundHigh)
        || scalarType != 1)
    {
        return false;
    }

    name = foundName;
    expression = foundExpression;
    low = foundLow;
    high = foundHigh;
    return true;
}

bool IsBasedInteger(Token literal)
{
    int32 start = literal.Range.Start;
    return literal.Range.Length >= 2 && Host.Source[start] == char16(48)
        && (Host.Source[start + 1] == char16(120)
            || Host.Source[start + 1] == char16(88)
            || Host.Source[start + 1] == char16(98)
            || Host.Source[start + 1] == char16(66));
}

bool TryEvaluateInt32ScalarReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out int32 result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }

    mut int32 valueIndex = 6;
    if (count != 10)
    {
        valueIndex = 7;
    }
    if (count == 13)
    {
        valueIndex = 8;
    }
    require tokens.TryGet(valueIndex, out var literal);
    mut bool negative = false;
    mut bool invert = false;
    mut bool outerSign = false;
    if (count == 11 || count == 13)
    {
        mut int32 prefixIndex = 6;
        if (count == 13)
        {
            require tokens.TryGet(6, out var firstToken);
            if (firstToken.Kind == 46)
            {
                prefixIndex = 7;
            }
            else
            {
                outerSign = true;
            }
        }
        require tokens.TryGet(prefixIndex, out var prefix);
        negative = prefix.Kind == 58;
        invert = prefix.Kind == 63;
    }
    if (!TryParseScalarReturnInteger(move tokens, move integers, out var foundName,
            out var expression, out var low, out var high)
        || high != 0)
    {
        return false;
    }

    bool based = IsBasedInteger(literal);
    // Decimal signed minimum needs minus directly on the literal, not outside parentheses.
    // Based literals first form int32 bits.
    if (low < 0)
    {
        if (!based)
        {
            if (!negative || outerSign || low != int32.MinValue)
            {
                return false;
            }
            name = foundName;
            result = int32.MinValue;
            return true;
        }
        if (negative && low == int32.MinValue)
        {
            return false;
        }
    }

    name = foundName;
    mut int32 bound = low;
    if (negative)
    {
        bound = -low;
    }
    if (invert)
    {
        bound = ~bound;
    }
    result = bound;
    return true;
}

bool TryEvaluateUInt32ScalarReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint32 result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }
    mut bool invert = false;
    if (count == 11 || count == 13)
    {
        mut int32 prefixIndex = 6;
        if (count == 13)
        {
            require tokens.TryGet(6, out var firstToken);
            if (firstToken.Kind == 46)
            {
                prefixIndex = 7;
            }
        }
        require tokens.TryGet(prefixIndex, out var prefix);
        if (prefix.Kind != 57 && prefix.Kind != 63)
        {
            return false;
        }
        invert = prefix.Kind == 63;
    }
    if (!TryParseScalarReturnIntegerTyped(move tokens, move integers,
            out var scalarType, out var foundName, out var expression,
            out var low, out var high)
        || scalarType != 2 || high != 0)
    {
        return false;
    }

    name = foundName;
    if (low < 0)
    {
        result = uint32(int64(low) + 4294967296);
    }
    else
    {
        result = uint32(low);
    }
    if (invert)
    {
        result = ~result;
    }
    return true;
}

uint64 DecodeScannerMagnitude(int32 low, int32 high)
{
    // Restore each unsigned half before combining it at the 2^32 place value.
    mut int64 lowBits = int64(low);
    mut int64 highBits = int64(high);
    if (low < 0)
    {
        lowBits = lowBits + 4294967296;
    }
    if (high < 0)
    {
        highBits = highBits + 4294967296;
    }
    return uint64(highBits) * 4294967296 + uint64(lowBits);
}

bool TryDecodeSigned64Scalar(uint64 magnitude, bool based, out int64 value)
{
    uint64 signBit = uint64(int64.MaxValue) + 1;
    if (!based && magnitude > uint64(int64.MaxValue))
    {
        return false;
    }
    if (magnitude >= signBit)
    {
        value = int64(magnitude - signBit) + int64.MinValue;
    }
    else
    {
        value = int64(magnitude);
    }
    return true;
}

bool TryEvaluateUInt64ScalarReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint64 result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }
    mut bool invert = false;
    if (count == 11 || count == 13)
    {
        mut int32 prefixIndex = 6;
        if (count == 13)
        {
            require tokens.TryGet(6, out var firstToken);
            if (firstToken.Kind == 46)
            {
                prefixIndex = 7;
            }
        }
        require tokens.TryGet(prefixIndex, out var prefix);
        if (prefix.Kind != 57 && prefix.Kind != 63)
        {
            return false;
        }
        invert = prefix.Kind == 63;
    }
    if (!TryParseScalarReturnIntegerTyped(move tokens, move integers,
            out var scalarType, out var foundName, out var expression,
            out var low, out var high)
        || scalarType != 4)
    {
        return false;
    }

    name = foundName;
    result = DecodeScannerMagnitude(low, high);
    if (invert)
    {
        result = ~result;
    }
    return true;
}

bool TryEvaluateInt64ScalarReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out int64 result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }
    mut int32 valueIndex = 6;
    if (count != 10)
    {
        valueIndex = 7;
    }
    if (count == 13)
    {
        valueIndex = 8;
    }
    require tokens.TryGet(valueIndex, out var literal);
    mut bool negative = false;
    mut bool invert = false;
    mut bool outerSign = false;
    if (count == 11 || count == 13)
    {
        mut int32 prefixIndex = 6;
        if (count == 13)
        {
            require tokens.TryGet(6, out var firstToken);
            if (firstToken.Kind == 46)
            {
                prefixIndex = 7;
            }
            else
            {
                outerSign = true;
            }
        }
        require tokens.TryGet(prefixIndex, out var prefix);
        negative = prefix.Kind == 58;
        invert = prefix.Kind == 63;
    }
    if (!TryParseScalarReturnIntegerTyped(move tokens, move integers,
            out var scalarType, out var foundName, out var expression,
            out var low, out var high)
        || scalarType != 3)
    {
        return false;
    }

    uint64 magnitude = DecodeScannerMagnitude(low, high);
    uint64 signBit = uint64(int64.MaxValue) + 1;
    bool based = IsBasedInteger(literal);
    if (!based && magnitude > uint64(int64.MaxValue))
    {
        if (!negative || outerSign || magnitude != signBit)
        {
            return false;
        }
        name = foundName;
        result = int64.MinValue;
        return true;
    }

    if (!TryDecodeSigned64Scalar(magnitude, based, out var decoded))
    {
        return false;
    }
    mut int64 bound = decoded;
    if (negative)
    {
        if (bound == int64.MinValue)
        {
            return false;
        }
        bound = -bound;
    }
    if (invert)
    {
        bound = ~bound;
    }

    name = foundName;
    result = bound;
    return true;
}

bool TryParseScalarBinaryReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out int32 scalarType, out int32 operation, out SourceRange name,
    out int32 firstLow, out int32 firstHigh, out bool firstBased,
    out int32 secondLow, out int32 secondHigh, out bool secondBased)
{
    if (tokens.GetCount() != 12)
    {
        return false;
    }
    require tokens.TryGet(0, out var type);
    if (!TryGetScalarType(type, out var selected) || selected == 5)
    {
        return false;
    }
    require tokens.TryGet(1, out var function);
    require tokens.TryGet(2, out var openParameters);
    require tokens.TryGet(3, out var closeParameters);
    require tokens.TryGet(4, out var openBody);
    require tokens.TryGet(5, out var returnKeyword);
    require tokens.TryGet(6, out var left);
    require tokens.TryGet(7, out var binary);
    require tokens.TryGet(8, out var right);
    require tokens.TryGet(9, out var semicolon);
    require tokens.TryGet(10, out var closeBody);
    require tokens.TryGet(11, out var eof);
    if (function.Kind != 2 || openParameters.Kind != 46 || closeParameters.Kind != 47
        || openBody.Kind != 48 || returnKeyword.Kind != 19
        || left.Kind != 3 || (binary.Kind < 57 || binary.Kind > 61)
        || right.Kind != 3
        || semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }
    if (!integers.TryFind(6, out var leftOverflow, out var leftLow, out var leftHigh)
        || !integers.TryFind(8, out var rightOverflow, out var rightLow, out var rightHigh)
        || leftOverflow || rightOverflow)
    {
        return false;
    }

    scalarType = selected;
    operation = binary.Kind;
    name = function.Range;
    firstLow = leftLow;
    firstHigh = leftHigh;
    firstBased = IsBasedInteger(left);
    secondLow = rightLow;
    secondHigh = rightHigh;
    secondBased = IsBasedInteger(right);
    return true;
}

bool TryEvaluateInt32AddReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out int32 result)
{
    return TryEvaluateInt32BinaryReturn(move tokens, move integers, 57, out name, out result);
}

bool TryEvaluateInt32SubtractReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out int32 result)
{
    return TryEvaluateInt32BinaryReturn(move tokens, move integers, 58, out name, out result);
}

bool TryEvaluateInt32MultiplyReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out int32 result)
{
    return TryEvaluateInt32BinaryReturn(move tokens, move integers, 59, out name, out result);
}

bool TryEvaluateInt32DivideReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out int32 result)
{
    return TryEvaluateInt32BinaryReturn(move tokens, move integers, 60, out name, out result);
}

bool TryEvaluateInt32RemainderReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out int32 result)
{
    return TryEvaluateInt32BinaryReturn(move tokens, move integers, 61, out name, out result);
}

bool TryEvaluateInt32BinaryReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    int32 expectedOperation, out SourceRange name, out int32 result)
{
    if (!TryParseScalarBinaryReturn(move tokens, move integers,
            out var scalarType, out var operation, out var foundName,
            out var leftLow, out var leftHigh, out var leftBased,
            out var rightLow, out var rightHigh, out var rightBased)
        || scalarType != 1 || operation != expectedOperation
        || leftHigh != 0 || rightHigh != 0
        || (leftLow < 0 && !leftBased) || (rightLow < 0 && !rightBased))
    {
        return false;
    }
    mut int64 value = int64(leftLow) + int64(rightLow);
    if (operation == 58)
    {
        value = int64(leftLow) - int64(rightLow);
    }
    if (operation == 59)
    {
        value = int64(leftLow) * int64(rightLow);
    }
    if (operation == 60 || operation == 61)
    {
        if (rightLow == 0)
        {
            return false;
        }
        if (leftLow == int32.MinValue && rightLow == -1)
        {
            if (operation == 60)
            {
                return false;
            }
            name = foundName;
            result = 0;
            return true;
        }
        if (operation == 60)
        {
            value = int64(leftLow) / int64(rightLow);
        }
        else
        {
            value = int64(leftLow) % int64(rightLow);
        }
    }
    if (value < int64(int32.MinValue) || value > int64(int32.MaxValue))
    {
        return false;
    }

    name = foundName;
    result = int32(value);
    return true;
}

bool TryEvaluateUInt32AddReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint32 result)
{
    return TryEvaluateUInt32BinaryReturn(move tokens, move integers, 57, out name, out result);
}

bool TryEvaluateUInt32SubtractReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint32 result)
{
    return TryEvaluateUInt32BinaryReturn(move tokens, move integers, 58, out name, out result);
}

bool TryEvaluateUInt32MultiplyReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint32 result)
{
    return TryEvaluateUInt32BinaryReturn(move tokens, move integers, 59, out name, out result);
}

bool TryEvaluateUInt32DivideReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint32 result)
{
    return TryEvaluateUInt32BinaryReturn(move tokens, move integers, 60, out name, out result);
}

bool TryEvaluateUInt32RemainderReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint32 result)
{
    return TryEvaluateUInt32BinaryReturn(move tokens, move integers, 61, out name, out result);
}

bool TryEvaluateUInt32BinaryReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    int32 expectedOperation, out SourceRange name, out uint32 result)
{
    if (!TryParseScalarBinaryReturn(move tokens, move integers,
            out var scalarType, out var operation, out var foundName,
            out var leftLow, out var leftHigh, out var leftBased,
            out var rightLow, out var rightHigh, out var rightBased)
        || scalarType != 2 || operation != expectedOperation
        || leftHigh != 0 || rightHigh != 0)
    {
        return false;
    }
    uint64 left = DecodeScannerMagnitude(leftLow, leftHigh);
    uint64 right = DecodeScannerMagnitude(rightLow, rightHigh);
    if (operation == 60 || operation == 61)
    {
        if (right == 0)
        {
            return false;
        }
        name = foundName;
        if (operation == 60)
        {
            result = uint32(left / right);
        }
        else
        {
            result = uint32(left % right);
        }
        return true;
    }
    if (operation == 58)
    {
        if (left < right)
        {
            return false;
        }
        name = foundName;
        result = uint32(left - right);
        return true;
    }
    mut uint64 value = left + right;
    if (operation == 59)
    {
        value = left * right;
    }
    if (value > uint64(uint32.MaxValue))
    {
        return false;
    }

    name = foundName;
    result = uint32(value);
    return true;
}

