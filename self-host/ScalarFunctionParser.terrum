            out var scalarType, out var operation, out var foundName,
            out var leftLow, out var leftHigh, out var leftBased,
            out var rightLow, out var rightHigh, out var rightBased)
        || scalarType != 2 || operation != expectedOperation
        || leftHigh != 0 || rightHigh != 0)
    {
        return false;
    }
    uint64 left = DecodeScannerMagnitude(leftLow, leftHigh);
    uint64 right = DecodeScannerMagnitude(rightLow, rightHigh);
    if (operation == 71 || operation == 73 || operation == 75)
    {
        name = foundName;
        if (operation == 71)
        {
            result = uint32(left & right);
        }
        else if (operation == 73)
        {
            result = uint32(left | right);
        }
        else
        {
            result = uint32(left ^ right);
        }
        return true;
    }
    if (operation == 60 || operation == 61)
    {
        if (right == 0)
        {
            return false;
        }
        name = foundName;
        if (operation == 60)
        {
            result = uint32(left / right);
        }
        else
        {
            result = uint32(left % right);
        }
        return true;
    }
    if (operation == 58)
    {
        if (left < right)
        {
            return false;
        }
        name = foundName;
        result = uint32(left - right);
        return true;
    }
    mut uint64 value = left + right;
    if (operation == 59)
    {
        value = left * right;
    }
    if (value > uint64(uint32.MaxValue))
    {
        return false;
    }

    name = foundName;
    result = uint32(value);
    return true;
}

