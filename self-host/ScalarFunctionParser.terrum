bool TryEvaluateInt32BinaryReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    int32 expectedOperation, out SourceRange name, out int32 result)
{
    if (!TryParseScalarBinaryReturn(move tokens, move integers,
            out var scalarType, out var operation, out var foundName,
            out var leftLow, out var leftHigh, out var leftBased,
            out var rightLow, out var rightHigh, out var rightBased)
        || scalarType != 1 || operation != expectedOperation
        || leftHigh != 0 || rightHigh != 0
        || (leftLow < 0 && !leftBased) || (rightLow < 0 && !rightBased))
    {
        return false;
    }
    mut int64 value = int64(leftLow) + int64(rightLow);
    if (operation == 58)
    {
        value = int64(leftLow) - int64(rightLow);
    }
    if (operation == 59)
    {
        value = int64(leftLow) * int64(rightLow);
    }
    if (operation == 60 || operation == 61)
    {
        if (rightLow == 0)
        {
            return false;
        }
        if (leftLow == int32.MinValue && rightLow == -1)
        {
            if (operation == 60)
            {
                return false;
            }
            name = foundName;
            result = 0;
            return true;
        }
        if (operation == 60)
        {
            value = int64(leftLow) / int64(rightLow);
        }
        else
        {
            value = int64(leftLow) % int64(rightLow);
        }
    }
    if (operation == 71)
    {
        value = int64(leftLow & rightLow);
    }
    if (operation == 73)
    {
        value = int64(leftLow | rightLow);
    }
    if (operation == 75)
    {
        value = int64(leftLow ^ rightLow);
    }
    if (value < int64(int32.MinValue) || value > int64(int32.MaxValue))
    {
        return false;
    }

    name = foundName;
    result = int32(value);
    return true;
}

