namespace Terrum.CodeAnalysis;

// This bounded syntax-27 probe uses scanner-5 TokenKind ordinals, not source characters
// to classify punctuation; the host parser's recovery remains a separate phase.
bool TryParseScalarReturnFunctionTyped(TokenSnapshot tokens,
    out int32 scalarType, out SourceRange name, out SourceRange expression)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }

    require tokens.TryGet(0, out var type);
    if (!TryGetScalarType(type, out var selected) || selected == 6)
    {
        return false;
    }
    require tokens.TryGet(1, out var function);
    require tokens.TryGet(2, out var openParameters);
    require tokens.TryGet(3, out var closeParameters);
    require tokens.TryGet(4, out var openBody);
    require tokens.TryGet(5, out var returnKeyword);
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    if (function.Kind != 2 || openParameters.Kind != 46 || closeParameters.Kind != 47
        || openBody.Kind != 48 || returnKeyword.Kind != 19)
    {
        return false;
    }

    mut int32 first = 6;
    require tokens.TryGet(first, out var initial);
    mut Token value = initial;
    bool grouped = count == 12 || count == 13;
    bool outerSign = count == 13 && ((selected == 5 && initial.Kind == 62)
        || (selected != 5 && (initial.Kind == 57 || initial.Kind == 58
            || initial.Kind == 63)));
    mut Token group = initial;
    if (outerSign)
    {
        first = first + 1;
        require tokens.TryGet(first, out group);
        value = group;
    }
    if (grouped)
    {
        if (value.Kind != 46)
        {
            return false;
        }
        first = first + 1;
        require tokens.TryGet(first, out value);
    }
    if (count == 11 || (count == 13 && !outerSign))
    {
        if ((selected == 5 && value.Kind != 62)
            || (selected != 5 && value.Kind != 57 && value.Kind != 58
                && value.Kind != 63))
        {
            return false;
        }
        first = first + 1;
        require tokens.TryGet(first, out value);
    }
    if ((selected == 5 && value.Kind != 20 && value.Kind != 21)
        || (selected != 5 && value.Kind != 3))
    {
        return false;
    }

    mut int32 afterValue = first + 1;
    mut int32 end = value.Range.End;
    if (grouped)
    {
        require tokens.TryGet(afterValue, out var closeGroup);
        if (closeGroup.Kind != 47)
        {
            return false;
        }
        end = closeGroup.Range.End;
        afterValue = afterValue + 1;
    }
    require tokens.TryGet(afterValue, out var semicolon);
    require tokens.TryGet(afterValue + 1, out var closeBody);
    require tokens.TryGet(afterValue + 2, out var eof);
    if (semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }

    mut int32 start = value.Range.Start;
    if (grouped)
    {
        start = group.Range.Start;
    }
    if (count == 11 || outerSign)
    {
        require tokens.TryGet(6, out var prefix);
        start = prefix.Range.Start;
    }
    require SourceRange.TryCreate(start, end - start, out var scalar);
    scalarType = selected;
    name = function.Range;
    expression = scalar;
    return true;
}

bool TryEvaluateBoolScalarReturn(TokenSnapshot tokens,
    out SourceRange name, out bool result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }
    mut int32 valueIndex = 6;
    if (count == 11 || count == 12)
    {
        valueIndex = 7;
    }
    else if (count == 13)
    {
        valueIndex = 8;
    }
    require tokens.TryGet(valueIndex, out var literal);
    bool negate = count == 11 || count == 13;
    if (!TryParseScalarReturnFunctionTyped(move tokens, out var scalarType,
            out var foundName, out var expression)
        || scalarType != 5)
    {
        return false;
    }

    name = foundName;
    result = literal.Kind == 20;
    if (negate)
    {
        result = !result;
    }
    return true;
}

bool TryParseScalarReturnFunction(TokenSnapshot tokens,
    out SourceRange name, out SourceRange expression)
{
    if (!TryParseScalarReturnFunctionTyped(move tokens, out var scalarType,
            out var foundName, out var foundExpression)
        || scalarType != 1)
    {
        return false;
    }

    name = foundName;
    expression = foundExpression;
    return true;
}

bool TryParseScalarReturnIntegerTyped(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out int32 scalarType, out SourceRange name, out SourceRange expression,
    out int32 low, out int32 high)
{
    mut int32 valueIndex = 6;
    if (tokens.GetCount() == 11 || tokens.GetCount() == 12)
    {
        valueIndex = 7;
    }
    else if (tokens.GetCount() == 13)
    {
        valueIndex = 8;
    }

    if (!integers.TryFind(valueIndex, out var overflow, out var magnitudeLow,
            out var magnitudeHigh)
        || overflow
        || !TryParseScalarReturnFunctionTyped(move tokens, out var foundType,
            out var foundName, out var foundExpression))
    {
        return false;
    }

    scalarType = foundType;
    name = foundName;
    expression = foundExpression;
    low = magnitudeLow;
    high = magnitudeHigh;
    return true;
}

bool TryParseScalarReturnInteger(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out SourceRange expression, out int32 low, out int32 high)
{
    if (!TryParseScalarReturnIntegerTyped(move tokens, move integers, out var scalarType,
            out var foundName, out var foundExpression, out var foundLow, out var foundHigh)
        || scalarType != 1)
    {
        return false;
    }

    name = foundName;
    expression = foundExpression;
    low = foundLow;
    high = foundHigh;
    return true;
}

bool TryEvaluateInt32ScalarReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out int32 result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }

    mut int32 valueIndex = 6;
    if (count != 10)
    {
        valueIndex = 7;
    }
    if (count == 13)
    {
        valueIndex = 8;
    }
    require tokens.TryGet(valueIndex, out var literal);
    mut bool negative = false;
    mut bool invert = false;
    mut bool outerSign = false;
    if (count == 11 || count == 13)
    {
        mut int32 prefixIndex = 6;
        if (count == 13)
        {
            require tokens.TryGet(6, out var firstToken);
            if (firstToken.Kind == 46)
            {
                prefixIndex = 7;
            }
            else
            {
                outerSign = true;
            }
        }
        require tokens.TryGet(prefixIndex, out var prefix);
        negative = prefix.Kind == 58;
        invert = prefix.Kind == 63;
    }
    if (!TryParseScalarReturnInteger(move tokens, move integers, out var foundName,
            out var expression, out var low, out var high)
        || high != 0)
    {
        return false;
    }

    bool based = IsBasedInteger(literal);
    // Decimal signed minimum needs minus directly on the literal, not outside parentheses.
    // Based literals first form int32 bits.
    if (low < 0)
    {
        if (!based)
        {
            if (!negative || outerSign || low != int32.MinValue)
            {
                return false;
            }
            name = foundName;
            result = int32.MinValue;
            return true;
        }
        if (negative && low == int32.MinValue)
        {
            return false;
        }
    }

    name = foundName;
    mut int32 bound = low;
    if (negative)
    {
        bound = -low;
    }
    if (invert)
    {
        bound = ~bound;
    }
    result = bound;
    return true;
}

bool TryEvaluateUInt32ScalarReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint32 result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }
    mut bool invert = false;
    if (count == 11 || count == 13)
    {
        mut int32 prefixIndex = 6;
        if (count == 13)
        {
            require tokens.TryGet(6, out var firstToken);
            if (firstToken.Kind == 46)
            {
                prefixIndex = 7;
            }
        }
        require tokens.TryGet(prefixIndex, out var prefix);
        if (prefix.Kind != 57 && prefix.Kind != 63)
        {
            return false;
        }
        invert = prefix.Kind == 63;
    }
    if (!TryParseScalarReturnIntegerTyped(move tokens, move integers,
            out var scalarType, out var foundName, out var expression,
            out var low, out var high)
        || scalarType != 2 || high != 0)
    {
        return false;
    }

    name = foundName;
    if (low < 0)
    {
        result = uint32(int64(low) + 4294967296);
    }
    else
    {
        result = uint32(low);
    }
    if (invert)
    {
        result = ~result;
    }
    return true;
}

bool TryEvaluateUInt64ScalarReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out uint64 result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }
    mut bool invert = false;
    if (count == 11 || count == 13)
    {
        mut int32 prefixIndex = 6;
        if (count == 13)
        {
            require tokens.TryGet(6, out var firstToken);
            if (firstToken.Kind == 46)
            {
                prefixIndex = 7;
            }
        }
        require tokens.TryGet(prefixIndex, out var prefix);
        if (prefix.Kind != 57 && prefix.Kind != 63)
        {
            return false;
        }
        invert = prefix.Kind == 63;
    }
    if (!TryParseScalarReturnIntegerTyped(move tokens, move integers,
            out var scalarType, out var foundName, out var expression,
            out var low, out var high)
        || scalarType != 4)
    {
        return false;
    }

    name = foundName;
    result = DecodeScannerMagnitude(low, high);
    if (invert)
    {
        result = ~result;
    }
    return true;
}

bool TryEvaluateInt64ScalarReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out int64 result)
{
    int32 count = tokens.GetCount();
    if (count != 10 && count != 11 && count != 12 && count != 13)
    {
        return false;
    }
    mut int32 valueIndex = 6;
    if (count != 10)
    {
        valueIndex = 7;
    }
    if (count == 13)
    {
        valueIndex = 8;
    }
    require tokens.TryGet(valueIndex, out var literal);
    mut bool negative = false;
    mut bool invert = false;
    mut bool outerSign = false;
    if (count == 11 || count == 13)
    {
        mut int32 prefixIndex = 6;
        if (count == 13)
        {
            require tokens.TryGet(6, out var firstToken);
            if (firstToken.Kind == 46)
            {
                prefixIndex = 7;
            }
            else
            {
                outerSign = true;
            }
        }
        require tokens.TryGet(prefixIndex, out var prefix);
        negative = prefix.Kind == 58;
        invert = prefix.Kind == 63;
    }
    if (!TryParseScalarReturnIntegerTyped(move tokens, move integers,
            out var scalarType, out var foundName, out var expression,
            out var low, out var high)
        || scalarType != 3)
    {
        return false;
    }

    uint64 magnitude = DecodeScannerMagnitude(low, high);
    uint64 signBit = uint64(int64.MaxValue) + 1;
    bool based = IsBasedInteger(literal);
    if (!based && magnitude > uint64(int64.MaxValue))
    {
        if (!negative || outerSign || magnitude != signBit)
        {
            return false;
        }
        name = foundName;
        result = int64.MinValue;
        return true;
    }

    if (!TryDecodeSigned64Scalar(magnitude, based, out var decoded))
    {
        return false;
    }
    mut int64 bound = decoded;
    if (negative)
    {
        if (bound == int64.MinValue)
        {
            return false;
        }
        bound = -bound;
    }
    if (invert)
    {
        bound = ~bound;
    }

    name = foundName;
    result = bound;
    return true;
}

bool TryParseScalarBinaryReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out int32 scalarType, out int32 operation, out SourceRange name,
    out int32 firstLow, out int32 firstHigh, out bool firstBased,
    out int32 secondLow, out int32 secondHigh, out bool secondBased)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 12)
    {
        return false;
    }
    require tokens.TryGet(0, out var type);
    if (!TryGetScalarType(type, out var selected) || selected == 5 || selected == 6)
    {
        return false;
    }
    require tokens.TryGet(1, out var function);
    require tokens.TryGet(2, out var openParameters);
    require tokens.TryGet(3, out var closeParameters);
    require tokens.TryGet(4, out var openBody);
    require tokens.TryGet(5, out var returnKeyword);
    require tokens.TryGet(6, out var left);
    require tokens.TryGet(7, out var binary);
    require tokens.TryGet(8, out var right);
    require tokens.TryGet(9, out var semicolon);
    require tokens.TryGet(10, out var closeBody);
    require tokens.TryGet(11, out var eof);
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    if (function.Kind != 2 || openParameters.Kind != 46 || closeParameters.Kind != 47
        || openBody.Kind != 48 || returnKeyword.Kind != 19
        || left.Kind != 3 || ((binary.Kind < 57 || binary.Kind > 61)
            && binary.Kind != 71 && binary.Kind != 73 && binary.Kind != 75)
        || right.Kind != 3
        || semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }
    if (!integers.TryFind(6, out var leftOverflow, out var leftLow, out var leftHigh)
        || !integers.TryFind(8, out var rightOverflow, out var rightLow, out var rightHigh)
        || leftOverflow || rightOverflow)
    {
        return false;
    }

    scalarType = selected;
    operation = binary.Kind;
    name = function.Range;
    firstLow = leftLow;
    firstHigh = leftHigh;
    firstBased = IsBasedInteger(left);
    secondLow = rightLow;
    secondHigh = rightHigh;
    secondBased = IsBasedInteger(right);
    return true;
}

bool TryEvaluateTypedScalarComparisonReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out SourceRange name, out bool result)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 18)
    {
        return false;
    }
    require tokens.TryGet(0, out var returnType);
    require tokens.TryGet(1, out var function);
    require tokens.TryGet(2, out var openParameters);
    require tokens.TryGet(3, out var closeParameters);
    require tokens.TryGet(4, out var openBody);
    require tokens.TryGet(5, out var returnKeyword);
    require tokens.TryGet(6, out var leftType);
    require tokens.TryGet(7, out var leftOpen);
    require tokens.TryGet(8, out var leftLiteral);
    require tokens.TryGet(9, out var leftClose);
    require tokens.TryGet(10, out var comparison);
    require tokens.TryGet(11, out var rightType);
    require tokens.TryGet(12, out var rightOpen);
    require tokens.TryGet(13, out var rightLiteral);
    require tokens.TryGet(14, out var rightClose);
    require tokens.TryGet(15, out var semicolon);
    require tokens.TryGet(16, out var closeBody);
    require tokens.TryGet(17, out var eof);
    if (!TokensAttach(function, openParameters)
        || !TokensAttach(leftType, leftOpen) || !TokensAttach(rightType, rightOpen))
    {
        return false;
    }
    if (!TryGetScalarType(returnType, out var selectedReturn) || selectedReturn != 5
        || !TryGetScalarType(leftType, out var selected)
        || !TryGetScalarType(rightType, out var matching) || selected != matching
        || selected == 5 || function.Kind != 2
        || openParameters.Kind != 46 || closeParameters.Kind != 47
        || openBody.Kind != 48 || returnKeyword.Kind != 19
        || leftOpen.Kind != 46 || leftLiteral.Kind != 3 || leftClose.Kind != 47
        || comparison.Kind < 65 || comparison.Kind > 70
        || rightOpen.Kind != 46 || rightLiteral.Kind != 3 || rightClose.Kind != 47
        || semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0)
    {
        return false;
    }
    if (!integers.TryFind(8, out var leftOverflow, out var leftLow, out var leftHigh)
        || !integers.TryFind(13, out var rightOverflow, out var rightLow, out var rightHigh)
        || leftOverflow || rightOverflow)
    {
        return false;
    }
    uint64 left = DecodeScannerMagnitude(leftLow, leftHigh);
    uint64 right = DecodeScannerMagnitude(rightLow, rightHigh);
    mut bool less = left < right;
    mut bool greater = left > right;
    if (selected == 1)
    {
        if (leftHigh != 0 || rightHigh != 0
            || (leftLow < 0 && !IsBasedInteger(leftLiteral))
            || (rightLow < 0 && !IsBasedInteger(rightLiteral)))
        {
            return false;
        }
        less = leftLow < rightLow;
        greater = leftLow > rightLow;
    }
    else if (selected == 2)
    {
        if (leftHigh != 0 || rightHigh != 0)
        {
            return false;
        }
    }
    else if (selected == 6)
    {
        if (leftHigh != 0 || rightHigh != 0
            || leftLow < 0 || rightLow < 0
            || leftLow > 65535 || rightLow > 65535)
        {
            return false;
        }
    }
    else if (selected == 3)
    {
        if (!TryDecodeSigned64Scalar(left, IsBasedInteger(leftLiteral), out var signedLeft)
            || !TryDecodeSigned64Scalar(right, IsBasedInteger(rightLiteral), out var signedRight))
        {
            return false;
        }
        less = signedLeft < signedRight;
        greater = signedLeft > signedRight;
    }

    name = function.Range;
    result = EvaluateScalarComparison(comparison.Kind, left == right, less, greater);
    return true;
}

bool TryParseParameterComparisonReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    out int32 scalarType, out int32 operation, out SourceRange name,
    out uint64 magnitude, out bool based)
{
    var spacing = tokens.GetScalarOperatorSpacingError();
    if (spacing.Length != 0)
    {
        return false;
    }
    if (tokens.GetCount() != 14)
    {
        return false;
    }
    require tokens.TryGet(0, out var returnType);
    require tokens.TryGet(1, out var function);
    require tokens.TryGet(2, out var openParameters);
    require tokens.TryGet(3, out var parameterType);
    require tokens.TryGet(4, out var parameter);
    require tokens.TryGet(5, out var closeParameters);
    require tokens.TryGet(6, out var openBody);
    require tokens.TryGet(7, out var returnKeyword);
    require tokens.TryGet(8, out var parameterUse);
    require tokens.TryGet(9, out var comparison);
    require tokens.TryGet(10, out var literal);
    require tokens.TryGet(11, out var semicolon);
    require tokens.TryGet(12, out var closeBody);
    require tokens.TryGet(13, out var eof);
    if (!TokensAttach(function, openParameters))
    {
        return false;
    }
    if (!TryGetScalarType(returnType, out var selectedReturn) || selectedReturn != 5
        || !TryGetScalarType(parameterType, out var selected) || selected == 5
        || function.Kind != 2 || openParameters.Kind != 46 || parameter.Kind != 2
        || closeParameters.Kind != 47 || openBody.Kind != 48
        || returnKeyword.Kind != 19 || parameterUse.Kind != 2
        || comparison.Kind < 65 || comparison.Kind > 70 || literal.Kind != 3
        || semicolon.Kind != 52 || closeBody.Kind != 49 || eof.Kind != 0
        || !SameTokenSpelling(parameter, parameterUse))
    {
        return false;
    }
    if (!integers.TryFind(10, out var overflow, out var low, out var high) || overflow)
    {
        return false;
    }

    scalarType = selected;
    operation = comparison.Kind;
    name = function.Range;
    magnitude = DecodeScannerMagnitude(low, high);
    based = IsBasedInteger(literal);
    return true;
}

bool TryEvaluateInt32ParameterComparisonReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, int32 parameter, out SourceRange name, out bool result)
{
    if (!TryParseParameterComparisonReturn(move tokens, move integers,
            out var selected, out var operation, out var foundName, out var magnitude,
            out var based)
        || selected != 1 || magnitude > uint64(uint32.MaxValue)
        || (!based && magnitude > uint64(int32.MaxValue)))
    {
        return false;
    }
    mut int64 literal = int64(magnitude);
    if (magnitude > uint64(int32.MaxValue))
    {
        literal = literal - 4294967296;
    }
    name = foundName;
    result = EvaluateScalarComparison(operation, int64(parameter) == literal,
        int64(parameter) < literal, int64(parameter) > literal);
    return true;
}

bool TryEvaluateUInt32ParameterComparisonReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, uint32 parameter, out SourceRange name, out bool result)
{
    if (!TryParseParameterComparisonReturn(move tokens, move integers,
            out var selected, out var operation, out var foundName, out var magnitude,
            out var based)
        || selected != 2 || magnitude > uint64(uint32.MaxValue))
    {
        return false;
    }
    uint64 value = uint64(parameter);
    name = foundName;
    result = EvaluateScalarComparison(operation, value == magnitude,
        value < magnitude, value > magnitude);
    return true;
}

bool TryEvaluateInt64ParameterComparisonReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, int64 parameter, out SourceRange name, out bool result)
{
    if (!TryParseParameterComparisonReturn(move tokens, move integers,
            out var selected, out var operation, out var foundName, out var magnitude,
            out var based)
        || selected != 3 || !TryDecodeSigned64Scalar(magnitude, based, out var literal))
    {
        return false;
    }
    name = foundName;
    result = EvaluateScalarComparison(operation, parameter == literal,
        parameter < literal, parameter > literal);
    return true;
}

bool TryEvaluateUInt64ParameterComparisonReturn(TokenSnapshot tokens,
    TokenIntegerSnapshot integers, uint64 parameter, out SourceRange name, out bool result)
{
    if (!TryParseParameterComparisonReturn(move tokens, move integers,
            out var selected, out var operation, out var foundName, out var magnitude,
            out var based)
        || selected != 4)
