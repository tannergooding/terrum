bool TryEvaluateInt32ParameterAddReturn(TokenSnapshot tokens, TokenIntegerSnapshot integers,
    int32 parameter, out SourceRange name, out int32 result)
{
    if (!TryParseParameterAddReturn(move tokens, move integers,
            out var selected, out var foundName, out var magnitude, out var based)
        || selected != 1 || magnitude > uint64(uint32.MaxValue)
        || (!based && magnitude > uint64(int32.MaxValue)))
    {
