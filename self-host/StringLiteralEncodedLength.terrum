namespace Terrum.CodeAnalysis;

public static int32 GetStringLiteralEncodedLengthOrMinusOne(int32 start, int32 length, int32 encoding)
{
    if (encoding < 0 || encoding > 5)
    {
        return -1;
    }

    int32 scalarCount = GetStringLiteralScalarCountOrMinusOne(start, length);
    if (scalarCount < 0)
    {
        return -1;
    }
    if (encoding == 5)
    {
        if (scalarCount > int32.MaxValue / 4)
        {
            return -1;
        }
        return scalarCount * 4;
    }

    int32 end = start + length - 1;
    mut int32 at = start + 1;
    mut int32 encodedLength = 0;
    while (at < end)
    {
        char16 character = Host.Source[at];
        mut int32 scalar = 0;
        mut int32 sourceWidth = 1;
        if (character == char16(92))
        {
            uint32 packed = AnalyzeStringEscapePacked(at, end - at);
            if (packed == 0 || (packed & 1) != 0)
            {
                return -1;
            }
            scalar = int32((packed >> 5) & 0x1FFFFF) - 1;
            sourceWidth = int32((packed >> 1) & 15);
        }
        else if (character >= char16(55296) && character <= char16(57343))
        {
            scalar = ReadUtf16Scalar(at, end);
            if (scalar < 0)
            {
                return -1;
            }
            sourceWidth = Utf16ScalarWidth(scalar);
        }
        else
        {
            scalar = int32(character);
        }

        mut int32 encodedWidth = 0;
        if (encoding == 0)
        {
            if (scalar >= 128)
            {
                return -1;
            }
            encodedWidth = 1;
        }
        else if (encoding == 1)
        {
            if (scalar >= 256)
            {
                return -1;
            }
            encodedWidth = 1;
        }
        else if (encoding == 2)
        {
            encodedWidth = 1;
            if (scalar >= 65536) { encodedWidth = 4; }
            else if (scalar >= 2048) { encodedWidth = 3; }
            else if (scalar >= 128) { encodedWidth = 2; }
        }
        else if (encoding == 3)
        {
            encodedWidth = 1;
            if (scalar >= 65536) { encodedWidth = 2; }
        }
        else
        {
            encodedWidth = 2;
            if (scalar >= 65536) { encodedWidth = 4; }
        }

        if (encodedLength > int32.MaxValue - encodedWidth)
        {
            return -1;
        }
        encodedLength = encodedLength + encodedWidth;
        at = at + sourceWidth;
    }
    return encodedLength;
}
