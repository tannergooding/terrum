namespace Terrum.CodeAnalysis;

// The caller bounds at/end; -1 marks an unpaired surrogate.
int32 ReadUtf16Scalar(int32 at, int32 end)
{
    char16 first = Host.Source[at];
    mut char16 second = char16(0);
    int32 firstValue = int32(first);
    if (firstValue >= 55296 && firstValue <= 56319 && at + 1 < end)
    {
        second = Host.Source[at + 1];
    }

    return DecodeUtf16Scalar(first, second);
}

public int32 ReadUtf16ScalarChecked(int32 at, int32 end)
{
    require at >= 0 && at < end && end <= Host.Source.Length;
    return ReadUtf16Scalar(at, end);
}
