namespace Terrum.CodeAnalysis.Numerics64;

OwnedInt32Buffer ReverseDigits(OwnedInt32Buffer workspace)
{
    mut OwnedInt32Buffer buffer = move workspace;
    {
        mut MutableInt32BufferView digits = buffer.SliceMutable(0, buffer.Count);
        mut int32 first = 0;
        mut int32 last = digits.Length - 1;
        while (first < last)
        {
            int32 saved = digits.Read(first);
            digits.Set(first, digits.Read(last));
            digits.Set(last, saved);
            first = first + 1;
            last = last - 1;
        }
    }

    return move buffer;
}

OwnedInt32Buffer PrefixMinus(OwnedInt32Buffer workspace)
{
    mut OwnedInt32Buffer buffer = move workspace;
    require buffer.TryAppend(0);
    {
        mut MutableInt32BufferView digits = buffer.SliceMutable(0, buffer.Count);
        mut int32 index = digits.Length - 1;
        while (index > 0)
        {
            digits.Set(index, digits.Read(index - 1));
            index = index - 1;
        }
        digits.Set(0, 45);
    }

    return move buffer;
}

uint64 FormattingMagnitude(int64 value)
{
    if (value < 0)
    {
        return uint64(-(value + 1)) + 1;
    }

    return uint64(value);
}

public static OwnedInt32Buffer FormatUInt64(uint64 value, OwnedInt32Buffer workspace)
{
    mut OwnedInt32Buffer buffer = move workspace;
    buffer.Clear();

    mut uint64 remaining = value;
    while (remaining >= 10)
    {
        uint64 quotient = remaining / 10;
        require buffer.TryAppend(int32(remaining - quotient * 10) + 48);
        remaining = quotient;
    }
    require buffer.TryAppend(int32(remaining) + 48);
    return ReverseDigits(move buffer);
}

public static OwnedInt32Buffer FormatInt64(int64 value, OwnedInt32Buffer workspace)
{
    if (value >= 0)
    {
        return FormatUInt64(uint64(value), move workspace);
    }

    OwnedInt32Buffer buffer = FormatUInt64(FormattingMagnitude(value), move workspace);
    return PrefixMinus(move buffer);
}

public static OwnedInt32Buffer FormatUInt32(uint32 value, OwnedInt32Buffer workspace)
{
    return FormatUInt64(uint64(value), move workspace);
}

public static OwnedInt32Buffer FormatInt32(int32 value, OwnedInt32Buffer workspace)
{
    return FormatInt64(int64(value), move workspace);
}

public static OwnedInt32Buffer FormatChar16(char16 value, OwnedInt32Buffer workspace)
{
    return FormatUInt32(uint32(value), move workspace);
}

public static OwnedInt32Buffer FormatUInt64Base(uint64 value, uint32 radix, OwnedInt32Buffer workspace)
{
    require radix >= 2 && radix <= 36;
    if (radix == 10)
    {
        return FormatUInt64(value, move workspace);
    }
    mut OwnedInt32Buffer buffer = move workspace;
    buffer.Clear();

    uint64 divisor = uint64(radix);
    mut uint64 remaining = value;
    while (remaining >= divisor)
    {
        uint64 quotient = remaining / divisor;
        int32 digit = int32(remaining - quotient * divisor);
        if (digit < 10)
        {
            require buffer.TryAppend(digit + 48);
        }
        else
        {
            require buffer.TryAppend(digit + 87);
        }
        remaining = quotient;
    }
    int32 lastDigit = int32(remaining);
    if (lastDigit < 10)
    {
        require buffer.TryAppend(lastDigit + 48);
    }
    else
    {
        require buffer.TryAppend(lastDigit + 87);
    }

    return ReverseDigits(move buffer);
}

public static OwnedInt32Buffer FormatInt64Base(int64 value, uint32 radix, OwnedInt32Buffer workspace)
{
    if (value >= 0)
    {
        return FormatUInt64Base(uint64(value), radix, move workspace);
    }

    OwnedInt32Buffer buffer = FormatUInt64Base(FormattingMagnitude(value), radix, move workspace);
    return PrefixMinus(move buffer);
}

public static OwnedInt32Buffer FormatUInt32Base(uint32 value, uint32 radix, OwnedInt32Buffer workspace)
{
    return FormatUInt64Base(uint64(value), radix, move workspace);
}

public static OwnedInt32Buffer FormatInt32Base(int32 value, uint32 radix, OwnedInt32Buffer workspace)
{
    return FormatInt64Base(int64(value), radix, move workspace);
}

public static OwnedInt32Buffer FormatChar16Base(char16 value, uint32 radix, OwnedInt32Buffer workspace)
{
    return FormatUInt32Base(uint32(value), radix, move workspace);
}

public static bool TryGetUInt64BaseLength(uint64 value, uint32 radix, init ref<int32> length)
{
    if (radix < 2 || radix > 36)
    {
        return false;
    }

    uint64 divisor = uint64(radix);
    mut uint64 remaining = value;
    mut int32 count = 1;
    while (remaining >= divisor)
    {
        remaining = remaining / divisor;
        count = count + 1;
    }
    length = count;
    return true;
}

public static bool TryGetInt64BaseLength(int64 value, uint32 radix, init ref<int32> length)
{
    if (!TryGetUInt64BaseLength(FormattingMagnitude(value), radix, init var digits))
    {
        return false;
    }
    mut int32 count = digits;
    if (value < 0)
    {
        count = count + 1;
    }
    length = count;
    return true;
}

public static bool TryGetUInt32BaseLength(uint32 value, uint32 radix, init ref<int32> length)
{
    return TryGetUInt64BaseLength(uint64(value), radix, init length);
}

public static bool TryGetInt32BaseLength(int32 value, uint32 radix, init ref<int32> length)
{
    return TryGetInt64BaseLength(int64(value), radix, init length);
}

public static bool TryGetChar16BaseLength(char16 value, uint32 radix, init ref<int32> length)
{
    return TryGetUInt32BaseLength(uint32(value), radix, init length);
}
