namespace Terrum.CodeAnalysis;

public static bool TryValidateTypeSpecTable(int32 recordCount, int32 typeDefCount,
    int32 importCount, int32 genericParamCount, int32 typeArgCount)
{
    if (!IsValidTypeSpecCount(typeDefCount) || !IsValidTypeSpecCount(importCount)
        || !IsValidTypeSpecCount(genericParamCount) || !IsValidTypeSpecCount(typeArgCount)
        || !TryGetVariableTableRowExtent(recordCount, 3, 1, recordCount,
            init var finalRowStart, init var finalRowLength))
    {
        return false;
    }

    int32 indexByteLength = (recordCount + 1) * 4;
    for (mut int32 row = 1; row <= recordCount; row = row + 1)
    {
        if (!TryReadVariableTableOffset(row - 1, init var startOffset)
            || !TryReadVariableTableOffset(row, init var endOffset))
        {
            return false;
        }

        int32 rowStart = indexByteLength + int32(startOffset);
        int32 rowLength = int32(endOffset - startOffset);
        if (!TryValidateTypeSpecRow(row, indexByteLength, rowStart, rowLength, typeDefCount,
            importCount, genericParamCount, typeArgCount))
        {
            return false;
        }
    }

    return true;
}

bool TryValidateTypeSpecRow(int32 row, int32 indexByteLength,
    int32 rowStart, int32 rowLength,
    int32 typeDefCount, int32 importCount, int32 genericParamCount, int32 typeArgCount)
{
    if (rowLength < 3
        || !TryReadTypeSpecByte(rowStart, rowLength, 0, init var form)
        || !TryReadTypeSpecByte(rowStart, rowLength, 1, init var qualifiers)
        || qualifiers > 1)
    {
        return false;
    }

    if (form == 1)
    {
        if (!TryReadTypeSpecByte(rowStart, rowLength, 2, init var code))
        {
            return false;
        }

        if (code <= 0x19)
        {
            return rowLength == 3;
        }
        if (code < 0x80 || code > 0x8F || rowLength != 4
            || !TryReadTypeSpecByte(rowStart, rowLength, 3, init var argumentCode))
        {
            return false;
        }

        return argumentCode <= 0x19;
    }

    if (form >= 2 && form <= 4)
    {
        if (rowLength != 6
            || !TryReadTypeSpecWord(rowStart, rowLength, 2, init var reference))
        {
            return false;
        }

        mut int32 tableCount = typeDefCount;
        if (form == 3) { tableCount = importCount; }
        else if (form == 4) { tableCount = genericParamCount; }
        return reference != 0 && reference <= uint32(tableCount);
    }

    if (form == 5)
    {
        if (rowLength != 14
            || !TryReadTypeSpecWord(rowStart, rowLength, 2, init var generic)
            || !IsEarlierTypeSpecRow(generic, row)
            || !TryGetTypeSpecForm(indexByteLength, int32(generic), init var genericForm)
            || (genericForm != 2 && genericForm != 3)
            || !TryReadTypeSpecWord(rowStart, rowLength, 6, init var first)
            || !TryReadTypeSpecWord(rowStart, rowLength, 10, init var count)
            || first == 0 || first > uint32(typeArgCount) || count == 0
            || count > uint32(typeArgCount) - first + 1)
        {
            return false;
        }

        return true;
    }

    if (form >= 6 && form <= 0x0B)
    {
        if (rowLength != 6
            || !TryReadTypeSpecWord(rowStart, rowLength, 2, init var inner)
            || !IsEarlierTypeSpecRow(inner, row))
        {
            return false;
        }

        if (form != 6 && IsNoncanonicalInlineTypeSpec(indexByteLength, inner))
        {
            return false;
        }

        return true;
    }

    if (form == 0x0C)
    {
        if (rowLength != 7
            || !TryReadTypeSpecByte(rowStart, rowLength, 2, init var familyCode)
            || familyCode < 0x80 || familyCode > 0x8A
            || !TryReadTypeSpecWord(rowStart, rowLength, 3, init var argument)
            || !IsEarlierTypeSpecRow(argument, row)
            || IsNoncanonicalInlineTypeSpec(indexByteLength, argument))
        {
            return false;
        }

        return true;
    }

    return false;
}

bool IsEarlierTypeSpecRow(uint32 reference, int32 row)
{
    return reference != 0 && reference < uint32(row);
}

bool TryGetTypeSpecForm(int32 indexByteLength, int32 row,
    init ref<int32> form)
{
    if (!TryReadVariableTableOffset(row - 1, init var startOffset)
        || !TryReadVariableTableOffset(row, init var endOffset))
    {
        return false;
    }

    int32 rowStart = indexByteLength + int32(startOffset);
    int32 rowLength = int32(endOffset - startOffset);
    return TryReadTypeSpecByte(rowStart, rowLength, 0, init form);
}

bool TryGetTypeSpecConstructedArgumentRange(int32 typeSpecCount, int32 indexByteLength,
    int32 row, init ref<uint32> first, init ref<uint32> count)
{
    if (row < 1 || row > typeSpecCount
        || !TryReadVariableTableOffset(row - 1, init var startOffset)
        || !TryReadVariableTableOffset(row, init var endOffset))
    {
        return false;
    }

    int32 rowStart = indexByteLength + int32(startOffset);
    int32 rowLength = int32(endOffset - startOffset);
    return rowLength == 14
        && TryReadTypeSpecByte(rowStart, rowLength, 0, init var form)
        && form == 5
        && TryReadTypeSpecWord(rowStart, rowLength, 6, init first)
        && TryReadTypeSpecWord(rowStart, rowLength, 10, init count);
}

bool IsNoncanonicalInlineTypeSpec(int32 indexByteLength, uint32 reference)
{
    if (!TryGetTypeSpecForm(indexByteLength, int32(reference), init var form))
    {
        return true;
    }
    if (form != 1)
    {
        return false;
    }
    if (!TryReadVariableTableOffset(int32(reference) - 1, init var startOffset)
        || !TryReadVariableTableOffset(int32(reference), init var endOffset))
    {
        return true;
    }

    int32 rowStart = indexByteLength + int32(startOffset);
    int32 rowLength = int32(endOffset - startOffset);
    if (rowLength != 3)
    {
        return false;
    }

    return !TryReadTypeSpecByte(rowStart, rowLength, 1, init var qualifiers)
        || qualifiers == 0;
}

bool TryReadTypeSpecByte(int32 rowStart, int32 rowLength, int32 offset,
    init ref<int32> value)
{
    if (rowStart < 0 || rowLength < 0 || offset < 0 || offset >= rowLength
        || rowStart > Host.Rows.Length - rowLength)
    {
        return false;
    }

    int32 part = Host.Rows[rowStart + offset];
    if (part < 0 || part > 255)
    {
        return false;
    }

    value = part;
    return true;
}

bool TryReadTypeSpecWord(int32 rowStart, int32 rowLength, int32 offset,
    init ref<uint32> value)
{
    if (offset < 0 || offset > rowLength - 4
        || !TryReadTypeSpecByte(rowStart, rowLength, offset, init var first)
        || !TryReadTypeSpecByte(rowStart, rowLength, offset + 1, init var second)
        || !TryReadTypeSpecByte(rowStart, rowLength, offset + 2, init var third)
        || !TryReadTypeSpecByte(rowStart, rowLength, offset + 3, init var fourth))
    {
        return false;
    }

    value = uint32(first) | (uint32(second) << 8)
        | (uint32(third) << 16) | (uint32(fourth) << 24);
    return true;
}

bool IsValidTypeSpecCount(int32 count)
{
    return count >= 0 && count <= 16777215;
}
