using Terrum;
namespace Terrum.CodeAnalysis.Tests;

int32 Main()
{
    mut int32 iteration = 0;
    while (iteration < 3)
    {
        require CheckSourceRange();
        require CheckToken();
        require IsAsciiDigit(char16(48)) && !IsAsciiDigit(char16(47));
        require IsLineBreak(char16(8232)) && !IsLineBreak(char16(32));
        require GetDecimalDigit(char16(57)) == 9;
        require CheckWideAddition();
        require CheckWideSubtraction();
        require CheckWideMultiplication();
        require CheckWideDecimalAccumulation();
        require CheckWideBaseAccumulation();
        require CheckCheckedInt32Arithmetic();
        require CheckCheckedUInt32Arithmetic();
        require CheckIntegerMath();
        require CheckBitOperations();
        iteration = iteration + 1;
    }

    return 0;
}
