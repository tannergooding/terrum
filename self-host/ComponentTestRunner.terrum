using Terrum;
using Terrum.CodeAnalysis.Numerics64;
namespace Terrum.CodeAnalysis.Tests;

int32 Main()
{
    mut int32 iteration = 0;
    while (iteration < 3)
    {
        require CheckSourceRange();
        require CheckToken();
        require CheckCharacterFacts();
        require CheckUtf16CodeUnits();
        require CheckWideAddition();
        require CheckWideSubtraction();
        require CheckWideMultiplication();
        require CheckWideDivision();
        require CheckWideRemainder();
        require CheckWideDecimalAccumulation();
        require CheckWideBaseAccumulation();
        require CheckCheckedInt32Arithmetic();
        require CheckCheckedUInt32Arithmetic();
        require CheckIntegerFacts();
        require CheckIntegerFormatting();
        require CheckIntegerFloatConversion();
        require CheckChar16FloatConversion();
        require CheckFloatingNegation();
        require CheckFloatingFormatConversion();
        require CheckFloatingIntegerConversion();
        require CheckCopyAlgorithms();
        require CheckFiniteFloatMathSelections();
        require CheckManagedTokenChain();
        require CheckIntegerMath();
        require CheckBitOperations();
        require CheckIntegerSaturation();
        require CheckIntegerWrapping();
        require CheckIntegerCheckedConversions();
        iteration = iteration + 1;
    }

    return 0;
}
