namespace Terrum.CodeAnalysis;

int32 CheckStringLiterals()
{
    mut int32 fixture = 0;
    while (fixture < Host.ExpectedLiterals.Length / 4)
    {
        int32 start = Host.ExpectedLiterals[fixture * 4];
        int32 length = Host.ExpectedLiterals[fixture * 4 + 1];
        int32 count = Host.ExpectedLiterals[fixture * 4 + 2];
        int32 firstScalar = Host.ExpectedLiterals[fixture * 4 + 3];
        require SourceRange.TryCreate(start, length, init var spelling);
        if (StringLiteral.TryCreateInit(spelling, init var created))
        {
            require StringLiteral.TryCreate(spelling, out var literal);
            if (count < 0 || literal.ScalarCount != count
                || literal.Spelling.Start != start || literal.Spelling.Length != length
                || created.ScalarCount != count || created.Spelling.Start != start
                || created.Spelling.Length != length)
            {
                return 1;
            }
            require literal.TryGetUtf8Length(init var byteLength);
            int32 expectedStart = Host.ExpectedUtf8Records[fixture * 2];
            int32 expectedLength = Host.ExpectedUtf8Records[fixture * 2 + 1];
            if (byteLength != expectedLength) { return 16; }
            require OwnedInt32Buffer.TryCreate(byteLength, out var workspace);
            mut OwnedInt32Buffer encoded = literal.EncodeUtf8(move workspace);
            if (encoded.Count != byteLength || encoded.Capacity != byteLength) { return 17; }
            for (mut int32 byteIndex = 0; byteIndex < byteLength; byteIndex = byteIndex + 1)
            {
                if (encoded.Read(byteIndex) != Host.ExpectedUtf8Bytes[expectedStart + byteIndex])
                {
                    return 18;
                }
            }
            encoded = literal.EncodeUtf8(move encoded);
            if (encoded.Count != byteLength || encoded.Capacity != byteLength) { return 19; }
            require literal.TryGetUtf16Length(init var unitLength);
            int32 expectedUnitStart = Host.ExpectedUtf16Records[fixture * 2];
            int32 expectedUnitLength = Host.ExpectedUtf16Records[fixture * 2 + 1];
            if (unitLength != expectedUnitLength) { return 20; }
            require OwnedInt32Buffer.TryCreate(unitLength, out var unitWorkspace);
            mut OwnedInt32Buffer encodedUnits = literal.EncodeUtf16(move unitWorkspace);
            if (encodedUnits.Count != unitLength || encodedUnits.Capacity != unitLength) { return 21; }
            for (mut int32 unitIndex = 0; unitIndex < unitLength; unitIndex = unitIndex + 1)
            {
                if (encodedUnits.Read(unitIndex) != Host.ExpectedUtf16Units[expectedUnitStart + unitIndex])
                {
                    return 22;
                }
            }
            encodedUnits = literal.EncodeUtf16(move encodedUnits);
            if (encodedUnits.Count != unitLength || encodedUnits.Capacity != unitLength) { return 23; }
            require literal.TryGetUtf16ByteLength(init var utf16ByteLength);
            int32 expectedUtf16ByteStart = Host.ExpectedUtf16ByteRecords[fixture * 2];
            int32 expectedUtf16ByteLength = Host.ExpectedUtf16ByteRecords[fixture * 2 + 1];
            if (utf16ByteLength != expectedUtf16ByteLength) { return 33; }
            require OwnedInt32Buffer.TryCreate(utf16ByteLength, out var utf16ByteWorkspace);
            mut OwnedInt32Buffer encodedUtf16Bytes = literal.EncodeUtf16LeBytes(move utf16ByteWorkspace);
            if (encodedUtf16Bytes.Count != utf16ByteLength
                || encodedUtf16Bytes.Capacity != utf16ByteLength) { return 34; }
            for (mut int32 index = 0; index < utf16ByteLength; index = index + 1)
            {
                if (encodedUtf16Bytes.Read(index) != Host.ExpectedUtf16Bytes[expectedUtf16ByteStart + index])
                {
                    return 35;
                }
            }
            encodedUtf16Bytes = literal.EncodeUtf16LeBytes(move encodedUtf16Bytes);
            if (encodedUtf16Bytes.Count != utf16ByteLength
                || encodedUtf16Bytes.Capacity != utf16ByteLength) { return 36; }
            int32 expectedUtf16BeStart = Host.ExpectedUtf16BeRecords[fixture * 2];
            int32 expectedUtf16BeLength = Host.ExpectedUtf16BeRecords[fixture * 2 + 1];
            if (utf16ByteLength != expectedUtf16BeLength) { return 42; }
            require OwnedInt32Buffer.TryCreate(utf16ByteLength, out var utf16BeWorkspace);
            mut OwnedInt32Buffer encodedUtf16Be = literal.EncodeUtf16BeBytes(move utf16BeWorkspace);
            if (encodedUtf16Be.Count != utf16ByteLength
                || encodedUtf16Be.Capacity != utf16ByteLength) { return 43; }
            for (mut int32 index = 0; index < utf16ByteLength; index = index + 1)
            {
                if (encodedUtf16Be.Read(index) != Host.ExpectedUtf16BeBytes[expectedUtf16BeStart + index])
                {
                    return 44;
                }
            }
            encodedUtf16Be = literal.EncodeUtf16BeBytes(move encodedUtf16Be);
            if (encodedUtf16Be.Count != utf16ByteLength
                || encodedUtf16Be.Capacity != utf16ByteLength) { return 45; }
            int32 expectedAsciiStart = Host.ExpectedAsciiRecords[fixture * 2];
            int32 expectedAsciiLength = Host.ExpectedAsciiRecords[fixture * 2 + 1];
            if (literal.TryGetAsciiLength(init var asciiLength))
            {
                if (expectedAsciiLength < 0 || asciiLength != expectedAsciiLength) { return 24; }
                require OwnedInt32Buffer.TryCreate(asciiLength, out var asciiWorkspace);
                mut OwnedInt32Buffer ascii = literal.EncodeAscii(move asciiWorkspace);
                if (ascii.Count != asciiLength || ascii.Capacity != asciiLength) { return 25; }
                for (mut int32 asciiIndex = 0; asciiIndex < asciiLength; asciiIndex = asciiIndex + 1)
                {
                    if (ascii.Read(asciiIndex) != Host.ExpectedAsciiBytes[expectedAsciiStart + asciiIndex])
                    {
                        return 26;
                    }
                }
                ascii = literal.EncodeAscii(move ascii);
                if (ascii.Count != asciiLength || ascii.Capacity != asciiLength) { return 27; }
            }
            else if (expectedAsciiLength >= 0)
            {
                return 28;
            }
            int32 expectedLatin1Start = Host.ExpectedLatin1Records[fixture * 2];
            int32 expectedLatin1Length = Host.ExpectedLatin1Records[fixture * 2 + 1];
            if (literal.TryGetLatin1Length(init var latin1Length))
            {
                if (expectedLatin1Length < 0 || latin1Length != expectedLatin1Length) { return 37; }
                require OwnedInt32Buffer.TryCreate(latin1Length, out var latin1Workspace);
                mut OwnedInt32Buffer latin1 = literal.EncodeLatin1(move latin1Workspace);
                if (latin1.Count != latin1Length || latin1.Capacity != latin1Length) { return 38; }
                for (mut int32 index = 0; index < latin1Length; index = index + 1)
                {
                    if (latin1.Read(index) != Host.ExpectedLatin1Bytes[expectedLatin1Start + index])
                    {
                        return 39;
                    }
                }
                latin1 = literal.EncodeLatin1(move latin1);
                if (latin1.Count != latin1Length || latin1.Capacity != latin1Length) { return 40; }
            }
            else if (expectedLatin1Length >= 0)
            {
                return 41;
            }
            require literal.TryGetUtf32ByteLength(init var utf32Length);
            int32 expectedUtf32Start = Host.ExpectedUtf32Records[fixture * 2];
            int32 expectedUtf32Length = Host.ExpectedUtf32Records[fixture * 2 + 1];
            if (utf32Length != expectedUtf32Length) { return 29; }
            require OwnedInt32Buffer.TryCreate(utf32Length, out var utf32Workspace);
            mut OwnedInt32Buffer utf32 = literal.EncodeUtf32LeBytes(move utf32Workspace);
            if (utf32.Count != utf32Length || utf32.Capacity != utf32Length) { return 30; }
            for (mut int32 utf32Index = 0; utf32Index < utf32Length; utf32Index = utf32Index + 1)
            {
                if (utf32.Read(utf32Index) != Host.ExpectedUtf32Bytes[expectedUtf32Start + utf32Index])
                {
                    return 31;
                }
            }
            utf32 = literal.EncodeUtf32LeBytes(move utf32);
            if (utf32.Count != utf32Length || utf32.Capacity != utf32Length) { return 32; }
            int32 expectedUtf32BeStart = Host.ExpectedUtf32BeRecords[fixture * 2];
            int32 expectedUtf32BeLength = Host.ExpectedUtf32BeRecords[fixture * 2 + 1];
            if (utf32Length != expectedUtf32BeLength) { return 46; }
            require OwnedInt32Buffer.TryCreate(utf32Length, out var utf32BeWorkspace);
            mut OwnedInt32Buffer utf32Be = literal.EncodeUtf32BeBytes(move utf32BeWorkspace);
            if (utf32Be.Count != utf32Length || utf32Be.Capacity != utf32Length) { return 47; }
            for (mut int32 index = 0; index < utf32Length; index = index + 1)
            {
                if (utf32Be.Read(index) != Host.ExpectedUtf32BeBytes[expectedUtf32BeStart + index])
                {
                    return 48;
                }
            }
            utf32Be = literal.EncodeUtf32BeBytes(move utf32Be);
            if (utf32Be.Count != utf32Length || utf32Be.Capacity != utf32Length) { return 49; }
            mut int32 seen = 0;
            mut int32 at = start - 1;
            while (at <= spelling.End)
            {
                if (literal.TryReadScalar(at, out var scalar, out var next))
                {
                    require literal.TryReadScalarInit(at, init var initScalar, init var initNext);
                    if (seen >= count) { return 2; }
                    int32 record = (firstScalar + seen) * 3;
                    if (at != Host.ExpectedScalars[record]
                        || scalar != Host.ExpectedScalars[record + 1]
                        || next != Host.ExpectedScalars[record + 2]
                        || initScalar != scalar || initNext != next)
                    {
                        return 3;
                    }
                    seen = seen + 1;
                }
                else if (literal.TryReadScalarInit(at, init var unexpectedScalar, init var unexpectedNext))
                {
                    return 15;
                }
                at = at + 1;
            }
            if (seen != count) { return 4; }
            if (literal.TryReadScalar(int32.MinValue, out var before, out var beforeNext)
                || literal.TryReadScalar(int32.MaxValue, out var after, out var afterNext))
            {
                return 5;
            }
            mut StringLiteralCursor cursor = StringLiteralCursor.Create(literal);
            mut int32 streamed = 0;
            while (cursor.TryRead(out var scalar, out var next))
            {
                if (streamed >= count) { return 8; }
                int32 record = (firstScalar + streamed) * 3;
                if (cursor.Position != Host.ExpectedScalars[record]
                    || scalar != Host.ExpectedScalars[record + 1]
                    || next.Position != Host.ExpectedScalars[record + 2])
                {
                    return 9;
                }
                cursor = next;
                streamed = streamed + 1;
            }
            if (streamed != count || cursor.Position != spelling.End - 1)
            {
                return 10;
            }
            cursor = StringLiteralCursor.Create(literal);
            streamed = 0;
            while (cursor.TryReadInit(init var streamScalar, init var streamNext))
            {
                if (streamed >= count) { return 12; }
                int32 record = (firstScalar + streamed) * 3;
                if (cursor.Position != Host.ExpectedScalars[record]
                    || streamScalar != Host.ExpectedScalars[record + 1]
                    || streamNext.Position != Host.ExpectedScalars[record + 2])
                {
                    return 13;
                }
                cursor = streamNext;
                streamed = streamed + 1;
            }
            if (streamed != count || cursor.Position != spelling.End - 1)
            {
                return 14;
            }
        }
        else if (count >= 0 || StringLiteral.TryCreate(spelling, out var unexpected))
        {
            return 6;
        }
        fixture = fixture + 1;
    }

    require SourceRange.TryCreate(int32.MaxValue, 0, init var distant);
    require SourceRange.TryCreate(0, int32.MaxValue, init var excessive);
    require SourceRange.TryCreate(Host.Source.Length, 2, init var past);
    if (StringLiteral.TryCreate(distant, out var distantLiteral)
        || StringLiteral.TryCreate(excessive, out var excessiveLiteral)
        || StringLiteral.TryCreate(past, out var pastLiteral)
        || StringLiteral.TryCreateInit(distant, init var distantInit)
        || StringLiteral.TryCreateInit(excessive, init var excessiveInit)
        || StringLiteral.TryCreateInit(past, init var pastInit))
    {
        return 7;
    }
    return 0;
}
