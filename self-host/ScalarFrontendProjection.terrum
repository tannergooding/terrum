namespace Terrum.CodeAnalysis;

// Version 20 retains the 37-word header. Words 37..41 hold node count,
// condition/true/false roots (-1 when absent), and expression-body flag.
// Each of 32 postorder nodes uses eight words: opcode, type, span start/length,
// child/parameter, right child, and contextual magnitude low/high.
// Version 21 adds 12 ordered statement records and eight local declarations:
// words 298/299 count statements/locals; 300..331 hold (type, mut, name start,
// name length); 332..391 hold (kind, slot, root, span start, span length).
// Versions 22/23 add unary operation 83 for checked numeric conversion,
// respectively without/with local records; its type is the destination.
// Versions 24/25 add conditional operation 84 without/with local records;
// its left and right are condition and true-arm nodes, and its low word is
// the false-arm node index. Versions 26/27 combine it with operation 83.
// Versions 28..31 require local records and at least one while header (kind 3).
// Its slot is the exclusive body-end statement index, root is its Boolean
// condition and span covers the entire loop; +1 selects conversion, +2
// selects conditional expressions. Nested bodies follow headers in preorder;
// the parser admits at most six nested loop headers.
// Versions 32..35 require kind-4 branch headers: slot is the exclusive
// true-arm end, root the Boolean predicate, span the whole if. An optional
// kind-5 else marker at that index has slot at the exclusive else-arm end,
// root -1, and span covering the else keyword and braced body. Versions
// 36..39 additionally require kind-3 loops; +1/+2 select conversion/?:.
// Versions 40..43 require a loop and a kind-6 break or kind-7 continue;
// versions 44..47 additionally require a branch. Transfer slot names the
// nearest enclosing kind-3 header record; root is -1 and span is the keyword
// through semicolon. +1/+2 select conversion/?:.
// Version 48 uses the same 392 words and tree/statement capacities, with
// kind-8 source-ordered returns (slot 0, typed root, keyword-to-semicolon
// span). Header roots 38..40 are -1 and word 15 is 0: there is no terminal
// envelope. Version 48 admits the existing conversion, conditional, loop,
// branch and nearest-loop transfer features without a cross-product version.
// Version 49 selects shifts (operations 88..90), local updates (86/87,
// low=1 prefix or 0 postfix), and compound statements (kind 9, root
// operation 91..101), plus update expression statements (kind 10).
// The existing node/statement and source-order capacities remain unchanged.
// Version 50 selects declarations inside existing braced branches/loops.
// Slots remain monotonic across scopes; the eight-local limit counts all
// declaration identities, not only simultaneously visible names.
// Version 51 selects kind-11 post-tested do and kind-12 for headers. Both
// slots end the body, with a Boolean root (for may use -1 for an omitted
// condition). For has exactly two following clause records before the body:
// initializer and iterator, each a normal statement without a semicolon or
// kind-13 empty marker anchored to its delimiter. Do's trailing condition
// root belongs to the header after the body, not to the body lexical scope.
// Header roots remain -1 without return records when verified non-fallthrough;
// an omitted-condition infinite for may need no expression nodes at all.
void WriteScalarFrontendExpression(int32 offset, ScalarFrontendExpression expression)
{
    Host.Frontend[offset] = expression.Type;
    Host.Frontend[offset + 1] = expression.Operation;
    Host.Frontend[offset + 2] = expression.LeftParameter;
    Host.Frontend[offset + 3] = expression.RightParameter;
    Host.Frontend[offset + 4] = expression.Span.Start;
    Host.Frontend[offset + 5] = expression.Span.Length;
}

bool TryPublishScalarFrontend()
{
    if (Host.Frontend.Length != 392 || !TryScanScalarFrontend(out var result))
    {
        return false;
    }

    Host.Frontend[0] = 3;
    if (!result.IsValid)
    {
        Host.Frontend[2] = result.ErrorCode;
        Host.Frontend[3] = result.ErrorSpan.Start;
        Host.Frontend[4] = result.ErrorSpan.Length;
        Host.Frontend[1] = 2;
        return true;
    }

    Host.Frontend[5] = result.ReturnType;
    if (Host.Frontend[37] != 0 || Host.Frontend[298] != 0)
    {
        Host.Frontend[0] = 20;
        if (Host.Frontend[298] != 0) { Host.Frontend[0] = 21; }
        for (mut int32 node = 0; node < Host.Frontend[37]; node = node + 1)
        {
            if (Host.Frontend[42 + node * 8] == 83)
            {
                if (Host.Frontend[298] == 0) { Host.Frontend[0] = 22; }
                else { Host.Frontend[0] = 23; }
            }
        }
        mut bool conditional = false;
        for (mut int32 node = 0; node < Host.Frontend[37]; node = node + 1)
        {
            if (Host.Frontend[42 + node * 8] == 84) { conditional = true; }
        }
        if (conditional) { Host.Frontend[0] = Host.Frontend[0] + 4; }
        mut bool hasWhile = false;
        for (mut int32 statement = 0; statement < Host.Frontend[298]; statement = statement + 1)
        {
            if (Host.Frontend[332 + statement * 5] == 3) { hasWhile = true; }
        }
        if (hasWhile)
        {
            Host.Frontend[0] = 28;
            mut bool conversion = false;
            for (mut int32 node = 0; node < Host.Frontend[37]; node = node + 1)
            {
                if (Host.Frontend[42 + node * 8] == 83) { conversion = true; }
            }
            if (conversion) { Host.Frontend[0] = Host.Frontend[0] + 1; }
            if (conditional) { Host.Frontend[0] = Host.Frontend[0] + 2; }
        }
        mut bool hasBranch = false;
        for (mut int32 statement = 0; statement < Host.Frontend[298]; statement = statement + 1)
        {
            if (Host.Frontend[332 + statement * 5] == 4) { hasBranch = true; }
        }
        if (hasBranch)
        {
            Host.Frontend[0] = 32;
            if (hasWhile) { Host.Frontend[0] = 36; }
            for (mut int32 node = 0; node < Host.Frontend[37]; node = node + 1)
            {
                if (Host.Frontend[42 + node * 8] == 83)
                {
                    Host.Frontend[0] = Host.Frontend[0] + 1;
                    break;
                }
            }
            if (conditional) { Host.Frontend[0] = Host.Frontend[0] + 2; }
        }
        mut bool hasTransfer = false;
        for (mut int32 statement = 0; statement < Host.Frontend[298]; statement = statement + 1)
        {
            int32 kind = Host.Frontend[332 + statement * 5];
            if (kind == 6 || kind == 7) { hasTransfer = true; }
        }
        if (hasTransfer)
        {
            Host.Frontend[0] = 40;
            if (hasBranch) { Host.Frontend[0] = 44; }
            for (mut int32 node = 0; node < Host.Frontend[37]; node = node + 1)
            {
                if (Host.Frontend[42 + node * 8] == 83)
                {
                    Host.Frontend[0] = Host.Frontend[0] + 1;
                    break;
                }
            }
            if (conditional) { Host.Frontend[0] = Host.Frontend[0] + 2; }
        }
        for (mut int32 statement = 0; statement < Host.Frontend[298]; statement = statement + 1)
        {
            if (Host.Frontend[332 + statement * 5] == 8)
            {
                Host.Frontend[0] = 48;
                break;
            }
        }
        for (mut int32 node = 0; node < Host.Frontend[37]; node = node + 1)
        {
            int32 operation = Host.Frontend[42 + node * 8];
            if (operation == 86 || operation == 87
                || operation >= 88 && operation <= 101)
            {
                Host.Frontend[0] = 49;
                break;
            }
        }
        for (mut int32 statement = 0; statement < Host.Frontend[298]; statement = statement + 1)
        {
            if (Host.Frontend[332 + statement * 5] != 1) { continue; }
            for (mut int32 header = 0; header < statement; header = header + 1)
            {
                int32 kind = Host.Frontend[332 + header * 5];
                if ((kind == 3 || kind == 4 || kind == 5)
                    && Host.Frontend[332 + header * 5 + 1] > statement)
                {
                    Host.Frontend[0] = 50;
                    break;
                }
            }
        }
        for (mut int32 statement = 0; statement < Host.Frontend[298]; statement = statement + 1)
        {
            int32 kind = Host.Frontend[332 + statement * 5];
            if (kind == 11 || kind == 12)
            {
                Host.Frontend[0] = 51;
                break;
            }
        }
        Host.Frontend[15] = 0;
        if (result.HasCondition)
        {
            Host.Frontend[15] = 1;
            if (result.HasFallthrough) { Host.Frontend[15] = 2; }
        }
        if (result.IsPublic) { Host.Frontend[2] = 1; }
        Host.Frontend[6] = result.ParameterCount;
        Host.Frontend[7] = result.FirstType;
        Host.Frontend[8] = result.SecondType;
        Host.Frontend[9] = result.Name.Start;
        Host.Frontend[10] = result.Name.Length;
        Host.Frontend[11] = result.FirstName.Start;
        Host.Frontend[12] = result.FirstName.Length;
        Host.Frontend[13] = result.SecondName.Start;
        Host.Frontend[14] = result.SecondName.Length;
        Host.Frontend[34] = result.ThirdType;
        Host.Frontend[35] = result.ThirdName.Start;
        Host.Frontend[36] = result.ThirdName.Length;
        Host.Frontend[1] = 1;
        return true;
    }
    if (result.IsPublic)
    {
        Host.Frontend[2] = 1;
    }
    Host.Frontend[6] = result.ParameterCount;
    Host.Frontend[7] = result.FirstType;
    Host.Frontend[8] = result.SecondType;
    Host.Frontend[9] = result.Name.Start;
    Host.Frontend[10] = result.Name.Length;
    Host.Frontend[11] = result.FirstName.Start;
    Host.Frontend[12] = result.FirstName.Length;
    Host.Frontend[13] = result.SecondName.Start;
    Host.Frontend[14] = result.SecondName.Length;
    Host.Frontend[34] = result.ThirdType;
    Host.Frontend[35] = result.ThirdName.Start;
    Host.Frontend[36] = result.ThirdName.Length;
    if (result.HasCondition)
    {
        if (result.HasFallthrough)
        {
            Host.Frontend[0] = 4;
            Host.Frontend[15] = 2;
        }
        else
        {
            Host.Frontend[15] = 1;
        }
        WriteScalarFrontendExpression(16, result.Condition);
        WriteScalarFrontendExpression(28, result.WhenFalse);
    }
    WriteScalarFrontendExpression(22, result.WhenTrue);
    if (result.WhenTrue.Operation >= 1200
        || (result.HasCondition && (result.Condition.Operation >= 1200
            || result.WhenFalse.Operation >= 1200)))
    {
        Host.Frontend[0] = 5;
    }
    if (result.WhenTrue.Operation >= 1600
        || (result.HasCondition && (result.Condition.Operation >= 1600
            || result.WhenFalse.Operation >= 1600)))
    {
        Host.Frontend[0] = 6;
    }
    if (result.WhenTrue.Operation == 658
        || (result.HasCondition && (result.Condition.Operation == 658
            || result.WhenFalse.Operation == 658)))
    {
        Host.Frontend[0] = 7;
    }
    if (result.WhenTrue.Operation >= 2000
        || (result.HasCondition && (result.Condition.Operation >= 2000
            || result.WhenFalse.Operation >= 2000)))
    {
        Host.Frontend[0] = 8;
    }
    if (result.WhenTrue.Operation >= 2700
        || (result.HasCondition && (result.Condition.Operation >= 2700
            || result.WhenFalse.Operation >= 2700)))
    {
        Host.Frontend[0] = 9;
    }
    if ((result.WhenTrue.Operation >= 2100 && result.WhenTrue.Operation < 2700)
        || result.WhenTrue.Operation >= 3200
        || (result.HasCondition
            && ((result.Condition.Operation >= 2100
                    && result.Condition.Operation < 2700)
                || result.Condition.Operation >= 3200
                || (result.WhenFalse.Operation >= 2100
                    && result.WhenFalse.Operation < 2700)
                || result.WhenFalse.Operation >= 3200)))
    {
        Host.Frontend[0] = 10;
    }
    if (result.WhenTrue.Operation >= 4000
        || (result.HasCondition && (result.Condition.Operation >= 4000
            || result.WhenFalse.Operation >= 4000)))
    {
        Host.Frontend[0] = 11;
    }
    if (result.WhenTrue.Operation >= 6000
        || (result.HasCondition && (result.Condition.Operation >= 6000
            || result.WhenFalse.Operation >= 6000)))
    {
        Host.Frontend[0] = 12;
    }
    if (result.WhenTrue.Operation >= 10000
        || (result.HasCondition && (result.Condition.Operation >= 10000
            || result.WhenFalse.Operation >= 10000)))
    {
        Host.Frontend[0] = 13;
    }
    if (result.WhenTrue.Operation >= 12000
        || (result.HasCondition && (result.Condition.Operation >= 12000
            || result.WhenFalse.Operation >= 12000)))
    {
        Host.Frontend[0] = 14;
    }
    if (result.WhenTrue.Operation >= 16000
        || (result.HasCondition && (result.Condition.Operation >= 16000
            || result.WhenFalse.Operation >= 16000)))
    {
        Host.Frontend[0] = 15;
    }
    if (result.WhenTrue.Operation >= 22000
        || (result.HasCondition && (result.Condition.Operation >= 22000
            || result.WhenFalse.Operation >= 22000)))
    {
        Host.Frontend[0] = 16;
    }
    if (result.WhenTrue.Operation >= 30000
        || (result.HasCondition && (result.Condition.Operation >= 30000
            || result.WhenFalse.Operation >= 30000)))
    {
        Host.Frontend[0] = 17;
    }
    if (result.WhenTrue.Operation >= 38000
        || (result.HasCondition && (result.Condition.Operation >= 38000
            || result.WhenFalse.Operation >= 38000)))
    {
        Host.Frontend[0] = 18;
    }
    if (result.ParameterCount == 3)
    {
        Host.Frontend[0] = 19;
    }
    Host.Frontend[1] = 1;
    return true;
}
