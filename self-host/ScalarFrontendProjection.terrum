namespace Terrum.CodeAnalysis;

// Version 20 retains the 37-word header. Words 37..41 hold node count,
// condition/true/false roots (-1 when absent), and expression-body flag.
// Each of 32 postorder nodes uses eight words: opcode, type, span start/length,
// child/parameter, right child, and contextual magnitude low/high.
// Version 21 adds 12 ordered statement records and eight local declarations:
// words 298/299 count statements/locals; 300..331 hold (type, mut, name start,
// name length); 332..391 hold (kind, slot, root, span start, span length).
// Versions 22/23 add unary operation 83 for checked numeric conversion,
// respectively without/with local records; its type is the destination.
// Versions 24/25 add conditional operation 84 without/with local records;
// its left and right are condition and true-arm nodes, and its low word is
// the false-arm node index. Versions 26/27 combine it with operation 83.
// Versions 28..31 require local records and at least one while header (kind 3).
// Its slot is the exclusive body-end statement index, root is its Boolean
// condition and span covers the entire loop; +1 selects conversion, +2
// selects conditional expressions. Nested bodies follow headers in preorder;
// the parser admits at most six nested loop headers.
// Versions 32..35 require kind-4 branch headers: slot is the exclusive
// true-arm end, root the Boolean predicate, span the whole if. An optional
// kind-5 else marker at that index has slot at the exclusive else-arm end,
// root -1, and span covering the else keyword and braced body. Versions
// 36..39 additionally require kind-3 loops; +1/+2 select conversion/?:.
// Versions 40..43 require a loop and a kind-6 break or kind-7 continue;
// versions 44..47 additionally require a branch. Transfer slot names the
// nearest enclosing kind-3 header record; root is -1 and span is the keyword
// through semicolon. +1/+2 select conversion/?:.
// Version 48 uses the same 392 words and tree/statement capacities, with
// kind-8 source-ordered returns (slot 0, typed root, keyword-to-semicolon
// span). Header roots 38..40 are -1 and word 15 is 0: there is no terminal
// envelope. Version 48 admits the existing conversion, conditional, loop,
// branch and nearest-loop transfer features without a cross-product version.
// Version 49 selects shifts (operations 88..90), local updates (86/87,
// low=1 prefix or 0 postfix), and compound statements (kind 9, root
// operation 91..101), plus update expression statements (kind 10).
// The existing node/statement and source-order capacities remain unchanged.
// Version 50 selects declarations inside existing braced branches/loops.
// Slots remain monotonic across scopes; the eight-local limit counts all
// declaration identities, not only simultaneously visible names.
// Version 51 selects kind-11 post-tested do and kind-12 for headers. Both
// slots end the body, with a Boolean root (for may use -1 for an omitted
// condition). For has exactly two following clause records before the body:
// initializer and iterator, each a normal statement without a semicolon or
// kind-13 empty marker anchored to its delimiter. Do's trailing condition
// root belongs to the header after the body, not to the body lexical scope.
// Header roots remain -1 without return records when verified non-fallthrough;
// an omitted-condition infinite for may need no expression nodes at all.
// Version 52 adds kind-14 standalone lexical blocks: slot is the exclusive body end,
// root is -1, and the span covers both braces. Each header counts as one record.
// Version 53 adds kind-15 non-void scalar discards. Slot identifies a readonly
// hidden local anchored to '_'; root is self-typed and span ends at the semicolon.
// Version 54 adds labeled while/do/for headers (16/17/18), whose spans include
// the label, and named break/continue (19/20), whose slots select enclosing headers.
// Version 55 adds kind-21 standalone requirements: slot zero, Boolean root,
// and an exact keyword-through-semicolon span, without a local or source scope.
// Version 56 admits void headers (return type zero) and kind-22 null returns.
// Bare and parenthesized unit-literal returns have root -1 and no expression node.
// Version 57 admits a void arrow body: flag 41 is one, envelope roots are -1,
// and exactly one existing kind-15 discard or kind-21 requirement record owns it.
// Version 58 adds kind-23 else-if markers: root -1, slot exclusive nested-if end,
// and raw span from else through the direct nested if, without a lexical block.
// Version 59 adds exact parameterless declaration effects in header word2:
// bit0 public, bit1 NoThrow, bit2 DoesNotReturn. Existing body layouts are retained.
// Version 60 adds kind 24 for ending a visible named local; slot is its identity,
// root is -1, and the span includes the semicolon outside for-clause records.
// Version 61 adds kind 25 for an explicitly typed vacant local; local flag bit 1
// marks initialization authority and the declaration record has root -1.
bool HasScalarFrontendStatement(int32 kind)
{
    for (mut int32 statement = 0; statement < Host.Frontend[298]; statement = statement + 1)
    {
        if (Host.Frontend[332 + statement * 5] == kind)
        {
            return true;
        }
    }
    return false;
}

void WriteScalarFrontendExpression(int32 offset, ScalarFrontendExpression expression)
{
    Host.Frontend[offset] = expression.Type;
    Host.Frontend[offset + 1] = expression.Operation;
    Host.Frontend[offset + 2] = expression.LeftParameter;
    Host.Frontend[offset + 3] = expression.RightParameter;
    Host.Frontend[offset + 4] = expression.Span.Start;
    Host.Frontend[offset + 5] = expression.Span.Length;
}

int32 GetScalarFrontendStatementVersion()
{
    mut int32 version = 0;
    mut int32 maximumKind = 0;
    for (mut int32 statement = 0; statement < Host.Frontend[298]; statement = statement + 1)
    {
        int32 kind = Host.Frontend[332 + statement * 5];
        if (kind > maximumKind) { maximumKind = kind; }
        if (kind == 8 && version < 48) { version = 48; }
        if (kind != 1 || version >= 50) { continue; }
        for (mut int32 header = 0; header < statement; header = header + 1)
        {
            int32 headerKind = Host.Frontend[332 + header * 5];
            if ((headerKind == 3 || headerKind == 4 || headerKind == 5)
                && Host.Frontend[332 + header * 5 + 1] > statement)
            {
                version = 50;
                break;
            }
        }
    }
    if (maximumKind == 25) { return 61; }
    if (maximumKind == 24) { return 60; }
    if (maximumKind == 23) { return 58; }
    if (maximumKind == 21) { return 55; }
    if (maximumKind >= 16) { return 54; }
    if (maximumKind >= 14) { return maximumKind + 38; }
    if (maximumKind >= 11) { return 51; }
    return version;
}

bool TryPublishScalarFrontend()
{
    if (Host.Frontend.Length != 392 || !TryScanScalarFrontend(out var result))
    {
        return false;
    }

    Host.Frontend[0] = 3;
    if (!result.IsValid)
    {
        Host.Frontend[2] = result.ErrorCode;
        Host.Frontend[3] = result.ErrorSpan.Start;
        Host.Frontend[4] = result.ErrorSpan.Length;
        Host.Frontend[1] = 2;
        return true;
    }

    WriteScalarFrontendHeader(result);
    Host.Frontend[5] = result.ReturnType;
    if (result.ReturnType == 0 || Host.Frontend[37] != 0 || Host.Frontend[298] != 0)
    {
        Host.Frontend[0] = result.ReturnType == 0
            ? (Host.Frontend[41] == 1 ? 57 : 56) : GetScalarFrontendTreeVersion();
        if (HasScalarFrontendStatement(23)) { Host.Frontend[0] = 58; }
        if ((Host.Frontend[2] & 6) != 0) { Host.Frontend[0] = 59; }
        if (HasScalarFrontendStatement(24)) { Host.Frontend[0] = 60; }
        if (HasScalarFrontendStatement(25)) { Host.Frontend[0] = 61; }
        Host.Frontend[15] = 0;
        if (result.HasCondition)
        {
            Host.Frontend[15] = 1;
            if (result.HasFallthrough) { Host.Frontend[15] = 2; }
        }
        Host.Frontend[1] = 1;
        return true;
    }
    if (result.HasCondition)
    {
        if (result.HasFallthrough)
        {
            Host.Frontend[0] = 4;
            Host.Frontend[15] = 2;
        }
        else
        {
            Host.Frontend[15] = 1;
        }
        WriteScalarFrontendExpression(16, result.Condition);
        WriteScalarFrontendExpression(28, result.WhenFalse);
    }
    WriteScalarFrontendExpression(22, result.WhenTrue);
    Host.Frontend[0] = GetScalarFrontendLegacyVersion(result);
    Host.Frontend[1] = 1;
    return true;
}

int32 GetScalarFrontendTreeVersion()
{
    mut int32 version = Host.Frontend[298] == 0 ? 20 : 21;
    bool conversion = HasScalarFrontendOperation(83);
    bool conditional = HasScalarFrontendOperation(84);
    if (conversion) { version = version + 2; }
    if (conditional) { version = version + 4; }
    bool hasWhile = HasScalarFrontendStatement(3);
    bool hasBranch = HasScalarFrontendStatement(4);
    bool hasTransfer = HasScalarFrontendStatement(6) || HasScalarFrontendStatement(7);
    if (hasWhile || hasBranch || hasTransfer)
    {
        version = GetScalarFrontendControlVersion(hasWhile, hasBranch, hasTransfer);
        if (conversion) { version = version + 1; }
        if (conditional) { version = version + 2; }
    }
    for (mut int32 node = 0; node < Host.Frontend[37]; node = node + 1)
    {
        int32 operation = Host.Frontend[42 + node * 8];
        if (operation >= 86 && operation <= 101)
        {
            version = 49;
            break;
        }
    }
    int32 statementVersion = GetScalarFrontendStatementVersion();
    return statementVersion > version ? statementVersion : version;
}

int32 GetScalarFrontendLegacyVersion(ScalarFrontendResult result)
{
    if (result.ParameterCount == 3) { return 19; }
    int32 maximum = GetScalarFrontendMaximumOperation(result);
    if (maximum >= 4000) { return GetScalarFrontendExtendedVersion(maximum); }
    if (HasScalarFrontendNumericUnary(result)) { return 10; }
    if (maximum >= 2700) { return 9; }
    if (maximum >= 2000) { return 8; }
    if (HasScalarFrontendLegacyOperation(result, 658)) { return 7; }
    if (maximum >= 1600) { return 6; }
    if (maximum >= 1200) { return 5; }
    return result.HasCondition && result.HasFallthrough ? 4 : 3;
}

bool HasScalarFrontendNumericUnary(ScalarFrontendResult result)
{
    if (IsScalarFrontendNumericUnary(result.WhenTrue.Operation)) { return true; }
    if (!result.HasCondition) { return false; }
    if (IsScalarFrontendNumericUnary(result.Condition.Operation)) { return true; }
    return IsScalarFrontendNumericUnary(result.WhenFalse.Operation);
}

bool HasScalarFrontendLegacyOperation(ScalarFrontendResult result, int32 operation)
{
    if (result.WhenTrue.Operation == operation) { return true; }
    if (!result.HasCondition) { return false; }
    if (result.Condition.Operation == operation) { return true; }
    return result.WhenFalse.Operation == operation;
}

void WriteScalarFrontendHeader(ScalarFrontendResult result)
{
    if (result.IsPublic) { Host.Frontend[2] = Host.Frontend[2] | 1; }
    Host.Frontend[6] = result.ParameterCount;
    Host.Frontend[7] = result.FirstType;
    Host.Frontend[8] = result.SecondType;
    Host.Frontend[9] = result.Name.Start;
    Host.Frontend[10] = result.Name.Length;
    Host.Frontend[11] = result.FirstName.Start;
    Host.Frontend[12] = result.FirstName.Length;
    Host.Frontend[13] = result.SecondName.Start;
    Host.Frontend[14] = result.SecondName.Length;
    Host.Frontend[34] = result.ThirdType;
    Host.Frontend[35] = result.ThirdName.Start;
    Host.Frontend[36] = result.ThirdName.Length;
}

int32 GetScalarFrontendControlVersion(bool hasWhile, bool hasBranch, bool hasTransfer)
{
    if (hasTransfer) { return hasBranch ? 44 : 40; }
    if (hasBranch) { return hasWhile ? 36 : 32; }
    return 28;
}

// Factor threshold classification to keep publication within the shared
// whole-program verification work bound without changing legacy identities.
int32 GetScalarFrontendExtendedVersion(int32 maximum)
{
    if (maximum >= 38000) { return 18; }
    if (maximum >= 30000) { return 17; }
    if (maximum >= 22000) { return 16; }
    if (maximum >= 16000) { return 15; }
    if (maximum >= 12000) { return 14; }
    if (maximum >= 10000) { return 13; }
    if (maximum >= 6000) { return 12; }
    return 11;
}

int32 GetScalarFrontendMaximumOperation(ScalarFrontendResult result)
{
    mut int32 maximum = result.WhenTrue.Operation;
    if (result.HasCondition)
    {
        if (result.Condition.Operation > maximum) { maximum = result.Condition.Operation; }
        if (result.WhenFalse.Operation > maximum) { maximum = result.WhenFalse.Operation; }
    }
    return maximum;
}

bool IsScalarFrontendNumericUnary(int32 operation)
{
    if (operation >= 3200) { return true; }
    if (operation < 2100) { return false; }
    return operation < 2700;
}

bool HasScalarFrontendOperation(int32 operation)
{
    for (mut int32 node = 0; node < Host.Frontend[37]; node = node + 1)
    {
        if (Host.Frontend[42 + node * 8] == operation)
        {
            return true;
        }
    }
    return false;
}
