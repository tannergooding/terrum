namespace Terrum.CodeAnalysis.Numerics64;

bool TryParseMagnitude(int32 start, int32 length, uint32 radix, uint64 maximum, init ref<uint64> result)
{
    if (start < 0 || length <= 0 || start > Host.Source.Length
        || length > Host.Source.Length - start || radix < 2 || radix > 36)
    {
        return false;
    }

    mut uint64 value = 0;
    uint64 divisor = uint64(radix);
    // Bound each prefix before multiplication, without dividing per digit.
    uint64 cutoff = maximum / divisor;
    uint64 finalDigit = maximum - cutoff * divisor;
    int32 end = start + length;
    for (mut int32 index = start; index < end; index = index + 1)
    {
        int32 codeUnit = int32(Host.Source[index]);
        if (codeUnit == 95)
        {
            if ((radix != 2 && radix != 10 && radix != 16)
                || (radix == 10 && index == start))
            {
                return false;
            }

            mut int32 next = index + 1;
            while (next < end && Host.Source[next] == char16(95))
            {
                next = next + 1;
            }
            if (next == end)
            {
                return false;
            }
            index = next - 1;
            continue;
        }

        mut uint32 digit = 0;
        if (codeUnit >= 48 && codeUnit <= 57)
        {
            digit = uint32(codeUnit - 48);
        }
        else if (codeUnit >= 65 && codeUnit <= 90)
        {
            digit = uint32(codeUnit - 65 + 10);
        }
        else if (codeUnit >= 97 && codeUnit <= 122)
        {
            digit = uint32(codeUnit - 97 + 10);
        }
        else
        {
            return false;
        }

        if (digit >= radix || value > cutoff
            || (value == cutoff && uint64(digit) > finalDigit))
        {
            return false;
        }
        value = value * divisor + uint64(digit);
    }

    result = value;
    return true;
}

public static bool TryParseUInt64Base(int32 start, int32 length, uint32 radix, init ref<uint64> result)
{
    if (!TryParseMagnitude(start, length, radix, uint64.MaxValue, init var parsed))
    {
        return false;
    }
    result = parsed;
    return true;
}

public static bool TryParseUInt32Base(int32 start, int32 length, uint32 radix, init ref<uint32> result)
{
    if (!TryParseMagnitude(start, length, radix, uint64(uint32.MaxValue), init var parsed))
    {
        return false;
    }
    result = uint32(parsed);
    return true;
}

public static bool TryParseChar16Base(int32 start, int32 length, uint32 radix, init ref<char16> result)
{
    if (!TryParseMagnitude(start, length, radix, 65535, init var parsed))
    {
        return false;
    }
    result = char16(parsed);
    return true;
}

bool TryParseSignedBase(int32 start, int32 length, uint32 radix,
    int64 minimum, int64 maximum, init ref<int64> result)
{
    if (start < 0 || length <= 0 || start >= Host.Source.Length)
    {
        return false;
    }

    bool negative = Host.Source[start] == char16(45);
    mut int32 digitStart = start;
    mut int32 digitLength = length;
    if (negative)
    {
        digitStart = digitStart + 1;
        digitLength = digitLength - 1;
    }

    mut uint64 magnitudeLimit = uint64(maximum);
    if (negative)
    {
        // Compute the negative limit without negating int64.MinValue.
        magnitudeLimit = MagnitudeInt64(minimum);
    }

    if (!TryParseMagnitude(digitStart, digitLength, radix, magnitudeLimit, init var magnitude))
    {
        return false;
    }

    if (negative && magnitude == magnitudeLimit)
    {
        result = minimum;
    }
    else if (negative)
    {
        result = -int64(magnitude);
    }
    else
    {
        result = int64(magnitude);
    }
    return true;
}

public static bool TryParseInt64Base(int32 start, int32 length, uint32 radix, init ref<int64> result)
{
    if (!TryParseSignedBase(start, length, radix,
        int64.MinValue, int64.MaxValue, init var parsed))
    {
        return false;
    }
    result = parsed;
    return true;
}

public static bool TryParseInt32Base(int32 start, int32 length, uint32 radix, init ref<int32> result)
{
    if (!TryParseSignedBase(start, length, radix,
        int64(int32.MinValue), int64(int32.MaxValue), init var parsed))
    {
        return false;
    }
    result = int32(parsed);
    return true;
}
