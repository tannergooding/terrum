namespace Terrum.CodeAnalysis;

public static bool TryGetStringTableRowLayout(int32 recordCount, int32 row,
    init ref<int32> rowStart, init ref<int32> rowLength,
    init ref<int32> encoding, init ref<int32> contentByteLength)
{
    if (!TryGetVariableTableRowExtent(recordCount, 8, 4, row,
        init var selectedStart, init var selectedLength))
    {
        return false;
    }

    int32 indexByteLength = (recordCount + 1) * 4;
    mut int32 selectedEncoding = 0;
    mut int32 selectedContentLength = 0;
    mut uint32 previous = 0;
    for (mut int32 currentRow = 1; currentRow <= recordCount; currentRow = currentRow + 1)
    {
        if (!TryReadVariableTableOffset(currentRow, init var next))
        {
            return false;
        }

        int32 start = int32(previous);
        int32 length = int32(next - previous);
        if (!TryGetStringRowLayout(indexByteLength + start, length,
            init var rowEncoding, init var rowContentLength))
        {
            return false;
        }

        if (currentRow == row)
        {
            selectedEncoding = rowEncoding;
            selectedContentLength = rowContentLength;
        }
        previous = next;
    }

    rowStart = selectedStart;
    rowLength = selectedLength;
    encoding = selectedEncoding;
    contentByteLength = selectedContentLength;
    return true;
}
